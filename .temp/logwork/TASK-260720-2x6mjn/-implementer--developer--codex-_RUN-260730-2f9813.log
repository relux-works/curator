+def test_plan_builds_reports_concurrent_state_change_after_retry_limit(
+    tmp_path: Path,
+) -> None:
+    snapshot_root = tmp_path / "snapshot"
+    snapshot_root.mkdir()
+    (snapshot_root / "source.txt").write_text("source", encoding="utf-8")
