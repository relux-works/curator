+            {"shared": "sha256:" + "0" * 64},
+            {"shared": "sha256:" + "1" * 64},
+            {"shared": "sha256:" + "2" * 64},
+            {"shared": "sha256:" + "3" * 64},
+        ]
+    )
+
+    with source.freeze_snapshot(snapshot_root) as frozen:
+        with pytest.raises(planner.BuildPlanningError) as error:
