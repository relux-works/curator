+        project.path / ".claude" / "settings.json",
+        project.path / ".claude" / "settings.local.json",
+        user_home / ".claude.json",
+        user_home / ".cursor" / "mcp.json",
+        user_home / ".codex" / "config.toml",
+        user_home / ".gemini" / "settings.json",
