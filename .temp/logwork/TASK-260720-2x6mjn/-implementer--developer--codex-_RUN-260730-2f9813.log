class BuildSourceError(Exception):
    pass


class InvalidSnapshotError(BuildSourceError):
    pass


class SnapshotMutationError(BuildSourceError):
    pass


@dataclass(frozen=True)
class BuildSourceIdentity:
    algorithm: str
    content_sha256: str


@dataclass(frozen=True)
class _DiscoveredFile:
    path: str
    path_bytes: bytes
