+
+    unavailable, warnings = audit_registry.check_snapshots(
+        (registry,),
+        state_dir,
+        fetch_snapshot=lambda _url: snapshot,
+        now=now,
+        read_only=True,
+    )
+
+    assert unavailable == set()
+    assert warnings == []
+    assert not state_dir.exists()
+
