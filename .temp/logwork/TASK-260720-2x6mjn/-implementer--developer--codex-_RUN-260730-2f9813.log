+        try:
+            descriptor = os.open(path, flags)
+        except OSError as exc:
+            noatime = getattr(os, "O_NOATIME", 0)
+            if (
+                not noatime
+                or not flags & noatime
+                or exc.errno
+                not in {errno.EPERM, errno.EACCES, errno.EINVAL, errno.ENOTSUP}
+            ):
