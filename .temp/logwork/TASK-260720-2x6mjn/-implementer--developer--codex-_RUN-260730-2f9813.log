+
+    def freeze(path):
+        events.append("freeze")
+        return original_freeze(path)
+
+    def available(plans, result):
+        events.append("system")
+        return original_available(plans, result)
+
+    def mcp(plans, project_root, agents, *, alias=""):
+        events.append("mcp")
