+    values = iter(
+        [
+            {"shared": "sha256:" + "0" * 64},
+            {"shared": "sha256:" + "1" * 64},
+            {"shared": "sha256:" + "1" * 64},
+            {"shared": "sha256:" + "1" * 64},
+        ]
+    )
+    audit_calls = 0
+
+    class Generation:
+        def capture(self):
+            return next(values)
+
+    def audit(*args, **kwargs):
+        nonlocal audit_calls
+        audit_calls += 1
+        return audit_pipeline.GateResult(reports=())
+
+    monkeypatch.setattr(
+        installer,
+        "_project_generation_probe",
+        lambda _config, _project: Generation(),
