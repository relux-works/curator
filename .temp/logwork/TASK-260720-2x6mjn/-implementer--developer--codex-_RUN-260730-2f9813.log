+def test_http_fetch_read_only_uses_network_without_creating_cache(
+    tmp_path, monkeypatch
+):
+    cache_dir = tmp_path / "missing-cache"
+    private, _ = _make_key()
+    record = _sign_record(private, _record_body())
+    monkeypatch.setattr(
+        audit_registry,
