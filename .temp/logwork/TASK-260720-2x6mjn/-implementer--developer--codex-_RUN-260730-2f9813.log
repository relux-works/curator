+    write_skillfile(project, {"schema_version": 1, "skills": []})
+    cfg = make_config(csk_home, skills_root, project)
+    generation = 0
+
+    class Generation:
+        def capture(self):
+            nonlocal generation
+            generation += 1
+            return {"shared": f"sha256:{generation:064x}"}
