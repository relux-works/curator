+        now=now,
+        read_only=True,
+    )
+
+    after = {
+        path.relative_to(state_dir).as_posix(): (
+            path.read_bytes(),
+            path.stat().st_mode,
+            path.stat().st_mtime_ns,
+        )
+        for path in state_dir.rglob("*")
+        if path.is_file()
+    }
+    assert unavailable == set()
+    assert warnings == []
+    assert after == before
