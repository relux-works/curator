+    events: list[str] = []
+    cache = _FakeCache(
+        manager_home,
+        {"tool": CacheEntryStatus.MISS},
+        events,
+    )
+    generation = _SequenceGeneration(
+        [
+            {"shared": "sha256:" + "0" * 64},
+            {"shared": "sha256:" + "1" * 64},
+            {"shared": "sha256:" + "1" * 64},
+            {"shared": "sha256:" + "1" * 64},
+        ]
