+    )
+
+    fetch = audit_registry.make_http_fetch(
+        cache_dir,
+        ttl_seconds=0,
+        grace_seconds=1000,
+        now=1000.0,
+        read_only=True,
+    )
+
+    assert fetch("https://r.example", "s", "c", "h") == [record]
+    assert not cache_dir.exists()
+
+
