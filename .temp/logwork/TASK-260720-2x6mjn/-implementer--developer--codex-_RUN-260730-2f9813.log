+        },
+    )
+    observed_argv: list[tuple[str, ...]] = []
+
+    class FakeSession:
+        target = build_toolchain.NativeTarget(
+            goos="darwin",
+            goarch="arm64",
+            tuning={"GOARM64": "v8.0"},
