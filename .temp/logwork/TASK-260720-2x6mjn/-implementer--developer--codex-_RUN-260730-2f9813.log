+def test_compiled_dry_run_preserves_every_persistent_surface(
+    monkeypatch, tmp_path, skills_root, csk_home
+):
+    project = make_project(tmp_path)
+    make_skill_repo(
+        skills_root,
+        "skill-build",
+        {
+            "agent-skill.json": json.dumps(
+                {
+                    "schema_version": 6,
