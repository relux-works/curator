+def test_plan_builds_retries_a_changed_generation(tmp_path: Path) -> None:
+    snapshot_root = tmp_path / "snapshot"
+    snapshot_root.mkdir()
+    (snapshot_root / "source.txt").write_text("source", encoding="utf-8")
+    manager_home = tmp_path / "manager"
