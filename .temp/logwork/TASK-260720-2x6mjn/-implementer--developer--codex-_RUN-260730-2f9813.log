+    result = installer.install(
+        cfg,
+        options=installer.InstallOptions(dry_run=True),
+    )[0]
+
+    assert result.errors
+    assert result.errors == [
+        "concurrent_state_change: shared planning state changed during "
+        "the read-only build plan"
+    ]
