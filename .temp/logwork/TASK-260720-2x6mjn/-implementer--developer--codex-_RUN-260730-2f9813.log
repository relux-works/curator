+
+    assert read_only("https://r.example", "s", "c", "h") == [second]
+    after = {
+        path.relative_to(cache_dir).as_posix(): path.read_bytes()
+        for path in cache_dir.rglob("*")
+        if path.is_file()
+    }
+    assert after == before
