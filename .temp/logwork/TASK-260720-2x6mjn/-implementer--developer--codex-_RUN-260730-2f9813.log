+    manager_home.mkdir()
+
+    def unexpected_toolchain(_config: toolchain.ToolchainConfig) -> _FakeToolchainSession:
+        raise AssertionError("no build commands must not probe Go")
+
+    assert planner.plan_builds(
+        (),
+        manager_home=manager_home,
