+    generation = _SequenceGeneration(
+        [
+            {"shared": "sha256:" + "0" * 64},
+            {"shared": "sha256:" + "1" * 64},
+            {"shared": "sha256:" + "2" * 64},
+            {"shared": "sha256:" + "3" * 64},
+        ]
