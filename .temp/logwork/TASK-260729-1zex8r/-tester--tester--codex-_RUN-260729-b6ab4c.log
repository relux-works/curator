-		scopedRecords, scopedCollectErr := collectToolchainRecords(ctx, handle)
-		if legacyCollectErr != nil || scopedCollectErr != nil {
-			t.Fatalf("collection failed before cancellation: %v / %v", legacyCollectErr, scopedCollectErr)
-		}
