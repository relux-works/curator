-				var lengthErr error
-				if written != opened.Size() {
-					lengthErr = errors.New("file length changed")
-				}
-				return "", nil, diagnosticErr("toolchain_mutated", errors.Join(copyErr, closeErr, lengthErr), "toolchain file %q changed while reading", record.path)
