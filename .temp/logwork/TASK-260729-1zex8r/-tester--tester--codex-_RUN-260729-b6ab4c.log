-func writeTree(t *testing.T, root string, files map[string]string) {
-	t.Helper()
-	for name, payload := range files {
-		writeTestFile(t, filepath.Join(root, filepath.FromSlash(name)), []byte(payload), 0o644)
-	}
-}
