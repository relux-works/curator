func (fixture *workerFixture) sourceAwareCalls() []stubCall {
	var result []stubCall
	for _, call := range fixture.calls() {
		if len(call.Argv) != 0 && (call.Argv[0] == "list" || call.Argv[0] == "build") {
			result = append(result, call)
		}
	}
	return result
