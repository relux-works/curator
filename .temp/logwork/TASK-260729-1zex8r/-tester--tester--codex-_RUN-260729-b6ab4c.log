+func BenchmarkFingerprintToolchainCycle3(b *testing.B) {
+	root := build.Default.GOROOT
+	if root == "" {
+		b.Skip("no GOROOT available")
+	}
+	if _, err := os.Stat(root); err != nil {
+		b.Skipf("GOROOT %s unreadable: %v", root, err)
+	}
+	for b.Loop() {
+		if _, _, err := fingerprintToolchain(context.Background(), root, equivalenceVersionCycle3); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+const equivalenceVersionCycle3 = "go version go1.25.5 darwin/arm64"
