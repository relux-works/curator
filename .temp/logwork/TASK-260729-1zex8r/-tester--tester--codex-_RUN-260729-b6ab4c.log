  wait "$sampler" 2>/dev/null

  note "$label: command = go test -count=1 $* ./cmd/curator"
  note "$label: real exit=$code wall=$((end - start))s"
  note "$label: $(tail -2 "$LOGS/${label}-cmdcurator.log" | tr '\n' ' ')"
  note "$label: load after = $(uptime)"
  note "$label: Go processes sampled every 5s during the run:"
  if [ -s "$sample" ]; then
    sort -u "$sample" | while read -r seen; do note "    $seen"; done
  else
    note "    (none observed)"
  fi
  note ""
}

