-				symlinkOrSkip(t, "second", filepath.Join(root, "first"))
-				symlinkOrSkip(t, "first", filepath.Join(root, "second"))
-			},
-			code: "toolchain_link_dangling",
-		},
-	}
-
-	for name, testCase := range cases {
