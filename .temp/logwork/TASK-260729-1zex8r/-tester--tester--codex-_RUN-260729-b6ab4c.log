-	writeTree(t, root, map[string]string{"a/b/c": "after"})
-	after, _, err := fingerprintToolchain(context.Background(), root, equivalenceVersion)
-	if err != nil {
-		t.Fatal(err)
-	}
-	if before == after {
-		t.Fatal("content change did not move the digest")
-	}
-	assertEquivalent(t, root)
