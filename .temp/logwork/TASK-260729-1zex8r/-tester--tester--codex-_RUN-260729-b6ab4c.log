-			root := t.TempDir()
-			build(t, root)
-			assertEquivalent(t, root)
-			if _, _, err := fingerprintToolchain(context.Background(), root, equivalenceVersion); err == nil {
-				t.Fatal("tree with violations was accepted")
-			}
-		})
-	}
-}
