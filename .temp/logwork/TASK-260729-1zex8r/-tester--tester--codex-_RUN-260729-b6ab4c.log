-				symlinkOrSkip(t, "../../outside", filepath.Join(root, "pkg", "link"))
-			},
-			code: "toolchain_link_escape",
-		},
-		"dangling link": {
-			build: func(t *testing.T, root string) {
-				symlinkOrSkip(t, "missing", filepath.Join(root, "link"))
