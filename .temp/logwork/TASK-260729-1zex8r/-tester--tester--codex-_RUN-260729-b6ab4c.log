done
note "waited a further ${settled}s for the 1-minute load average to fall below 6.0 (cap 900s)"
note ""
note "host at start: $(uptime)"
note "top CPU consumers at start:"
ps -eo %cpu,comm 2>/dev/null | sort -rn | head -3 | while read -r line; do note "    $line"; done
note ""

run_one() {
  local label=$1 tree=$2
  shift 2
  cd "$tree" || return 1
  # Warm compilation so the timed run measures test execution, not the build.
