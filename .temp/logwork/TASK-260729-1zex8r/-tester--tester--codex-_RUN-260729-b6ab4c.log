-	err := assertPhaseBoundaryEquivalent(t, build, mutate)
-	if DiagnosticCode(err) != "toolchain_mutated" {
-		t.Fatalf("code = %q (%v), want toolchain_mutated", DiagnosticCode(err), err)
-	}
-}
