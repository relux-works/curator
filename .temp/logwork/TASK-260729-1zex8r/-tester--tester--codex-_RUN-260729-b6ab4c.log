-	_, state, err := fingerprintToolchain(context.Background(), root, equivalenceVersion)
-	if err != nil {
-		t.Fatal(err)
-	}
-	seen := map[string]byte{}
-	for _, item := range state {
-		seen[item.path] = item.kind
