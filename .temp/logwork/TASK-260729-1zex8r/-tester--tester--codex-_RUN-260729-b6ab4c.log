# Before/after measurement of `go test -count=1 ./cmd/curator`.
# BEFORE = .temp/TASK-260729-1zex8r/before-worktree (unmodified traversal)
# AFTER  = .temp/TASK-260729-1zex8r/worktree (scoped collection phase)
