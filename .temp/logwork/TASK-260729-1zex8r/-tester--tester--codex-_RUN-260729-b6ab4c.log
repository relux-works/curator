-	for _, item := range state {
-		seen[item.path] = item.kind
-	}
-	if seen["alias"] != 'L' {
-		t.Fatalf("alias kind = %q, want 'L'", seen["alias"])
-	}
-	if _, descended := seen["alias/secret"]; descended {
