-				"b/c":   "in dir",
-				"b-x":   "dash sorts before slash",
-				"b.y":   "dot sorts before slash",
-				"b!z":   "bang sorts before slash",
-				"b0":    "digit sorts after slash",
-				"bb":    "letter sorts after slash",
