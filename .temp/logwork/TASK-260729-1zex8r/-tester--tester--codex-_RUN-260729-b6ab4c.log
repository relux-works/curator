-			build: func(t *testing.T, dir string) {
-				writeTree(t, dir, map[string]string{"target": "x"})
-				symlinkOrSkip(t, "target", filepath.Join(dir, "entry"))
-			},
-			code: "toolchain_link_dangling",
-		},
-	}
-
-	for name, testCase := range cases {
