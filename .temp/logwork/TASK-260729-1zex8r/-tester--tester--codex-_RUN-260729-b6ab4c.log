-		_, _, scopedErr := fingerprintToolchain(ctx, root, equivalenceVersion)
-		if DiagnosticCode(legacyErr) != "toolchain_timeout" || DiagnosticCode(scopedErr) != "toolchain_timeout" {
-			t.Fatalf("legacy %v, scoped %v", legacyErr, scopedErr)
