-				writeTree(t, dir, map[string]string{"entry": "x"})
-			},
-		},
-		"directory metadata is taken through the root": {
-			build: func(t *testing.T, dir string) {
-				if err := os.MkdirAll(filepath.Join(dir, "entry"), 0o755); err != nil {
-					t.Fatal(err)
