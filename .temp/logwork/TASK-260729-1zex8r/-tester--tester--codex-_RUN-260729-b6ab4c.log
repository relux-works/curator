LOGS=$BASE/TASK-260729-1zex8r/logs
BEFORE_TREE=$BASE/TASK-260729-1zex8r/before-worktree
AFTER_TREE=$BASE/TASK-260729-1zex8r/worktree
mkdir -p "$LOGS"
REPORT=$LOGS/cmdcurator-measurement.txt
: > "$REPORT"

note() { print -r -- "$*" >> "$REPORT"; }

# Every Go toolchain process that indicates someone is compiling or running Go
# on this host: test binaries under the build cache, and the compile/link steps.
#
# The snapshot is taken into a variable first, on purpose: piping ps straight
# into grep puts grep's own command line — which contains these patterns — into
# ps's output, and the detector then reports itself on every sample.
# The patterns are anchored to the real shapes the Go toolchain produces
# (pkg/tool/<goos>_<goarch>/<step>, go-buildNNN/bNNN/<pkg>.test) rather than to
# bare words like "/compile ", so that a shell wrapper that merely quotes this
# script's own text is not mistaken for a compiler. Wrapper processes are
# dropped outright for the same reason.
go_procs() {
  local snapshot
  snapshot=$(ps -eo args 2>/dev/null)
  print -r -- "$snapshot" \
    | grep -v 'shell-snapshots' \
    | grep -oE 'go-build[0-9]+/b[0-9]+/[A-Za-z0-9_.-]+\.test|pkg/tool/[a-z0-9_]+/(compile|link|vet)' \
    | sort -u
}
go_proc_count() { go_procs | grep -c . | tr -d ' '; }
