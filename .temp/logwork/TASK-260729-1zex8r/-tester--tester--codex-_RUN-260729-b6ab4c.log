-		_, _, err := fingerprintToolchain(ctx, root, equivalenceVersion)
-		if err != nil && DiagnosticCode(err) != "toolchain_timeout" {
-			t.Fatalf("error = %v, want nil or toolchain_timeout", err)
-		}
