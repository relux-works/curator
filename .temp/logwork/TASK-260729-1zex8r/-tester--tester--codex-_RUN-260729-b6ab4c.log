-			code:   "toolchain_unreadable",
-			detail: `cannot inspect toolchain path "entry"`,
-		},
-	}
-
-	for name, testCase := range cases {
-		t.Run(name, func(t *testing.T) {
-			listed := t.TempDir()
-			testCase.listed(t, listed)
