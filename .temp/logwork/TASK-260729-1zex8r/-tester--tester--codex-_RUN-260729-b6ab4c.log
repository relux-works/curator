-			if err != nil {
-				t.Fatal(err)
-			}
-			defer func() { _ = anchorHandle.Close() }()
-
-			walk := toolchainWalk{root: anchorHandle, encoded: make(map[string]struct{})}
-			walkErr := walk.descend(context.Background(), listedHandle, "")
