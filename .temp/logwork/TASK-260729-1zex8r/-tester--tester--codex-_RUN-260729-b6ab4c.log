-		empty := t.TempDir()
-		ctx, cancel := context.WithCancel(context.Background())
-		cancel()
-		if _, _, err := fingerprintToolchain(ctx, empty, equivalenceVersion); DiagnosticCode(err) != "toolchain_timeout" {
-			t.Fatalf("error = %v, want toolchain_timeout", err)
-		}
