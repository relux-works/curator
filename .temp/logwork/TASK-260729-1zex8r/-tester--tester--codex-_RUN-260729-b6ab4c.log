-			listed: func(t *testing.T, dir string) {
-				writeTree(t, dir, map[string]string{"entry/child": "old"})
-			},
-			anchor: func(t *testing.T, dir string) {
-				writeTree(t, dir, map[string]string{"entry": "replacement"})
