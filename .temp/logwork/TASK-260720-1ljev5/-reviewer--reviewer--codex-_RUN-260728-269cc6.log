   185	// decodeRegistryVersion reads schema_version as an exact JSON integer. A
   186	// fractional or exponent spelling is refused rather than rounded, because a
   187	// registry Curator did not write is a registry it cannot reason about.
   188	func decodeRegistryVersion(decoder *json.Decoder) (int, error) {
   189		token, err := decoder.Token()
   190		if err != nil {
   191			return 0, err
   192		}
   193		number, ok := token.(json.Number)
   194		if !ok {
   195			return 0, fmt.Errorf("schema_version is not a number")
   196		}
   197		value, err := strconv.Atoi(number.String())
   198		if err != nil {
   199			return 0, fmt.Errorf("schema_version %s is not an integer", number.String())
   200		}
   201		return value, nil
   202	}
