   226	// Only a plain directory is traversed. A skills root or member that is a
   227	// symbolic link or a reparse point could redirect the traversal away from the
   228	// installation whose marker holds the live build reference, so it is refused
   229	// and reported instead of followed. Every metadata failure that is not a plain
   230	// absence is likewise an uncertainty: a marker that cannot be inspected may
   231	// name a build key that must not be swept.
   232	func readScope(skillsDir string) scopeMarks {
   233		var scope scopeMarks
   234		info, err := os.Lstat(skillsDir)
   235		switch {
   236		case errors.Is(err, os.ErrNotExist):
   237			return scope
   238		case err != nil:
   239			scope.uncertain = append(scope.uncertain, fmt.Sprintf(
   240				"skill directory %s cannot be inspected: %v", skillsDir, err))
   241			return scope
   242		case isRedirect(info):
   243			scope.uncertain = append(scope.uncertain, fmt.Sprintf(
   244				"skill directory %s is a symbolic link or reparse point; maintenance cannot prove which installations it holds",
   245				skillsDir))
   246			return scope
   247		case !info.Mode().IsDir():
   248			scope.uncertain = append(scope.uncertain, fmt.Sprintf(
   249				"skill directory %s is not a directory; repair or remove it", skillsDir))
   250			return scope
   251		}
   252	
   253		entries, err := os.ReadDir(skillsDir)
   254		if err != nil {
   255			scope.uncertain = append(scope.uncertain, fmt.Sprintf(
   256				"skill directory %s is unreadable: %v", skillsDir, err))
   257			return scope
   258		}
   259		for _, entry := range entries {
   260			installedDir := filepath.Join(skillsDir, entry.Name())
   261			member, err := entry.Info()
   262			switch {
   263			case errors.Is(err, os.ErrNotExist):
   264				continue // removed while the directory was being read
   265			case err != nil:
   266				scope.uncertain = append(scope.uncertain, fmt.Sprintf(
   267					"installed skill %s cannot be inspected: %v", installedDir, err))
   268				continue
   269			case isRedirect(member):
   270				scope.uncertain = append(scope.uncertain, fmt.Sprintf(
   271					"installed skill %s is a symbolic link or reparse point; maintenance cannot prove what it installs",
   272					installedDir))
   273				continue
   274			case !member.Mode().IsDir():
   275				// A non-directory member cannot hold an install marker, so it hides
   276				// no reference; it is reported so an operator can clean it up.
   277				scope.notes = append(scope.notes, fmt.Sprintf(
   278					"ignored non-directory member %s of skill directory %s", entry.Name(), skillsDir))
   279				continue
   280			}
   281			if installed := marker.Read(installedDir); installed != nil {
   282				scope.markers = append(scope.markers, installed)
   283				continue
   284			}
   285			scope.uncertain = append(scope.uncertain, unreadableMarker(installedDir)...)
   286		}
   287		return scope
   288	}
   289	
   290	// unreadableMarker classifies why an installed directory produced no valid
   291	// marker. Only a plainly absent marker means "not an installation".
   292	func unreadableMarker(installedDir string) []string {
   293		markerPath := filepath.Join(installedDir, marker.Name)
   294		info, err := os.Lstat(markerPath)
   295		switch {
   296		case errors.Is(err, os.ErrNotExist):
   297			return nil
   298		case err != nil:
   299			return []string{fmt.Sprintf(
   300				"install marker %s cannot be inspected: %v; repair or remove that installation", markerPath, err)}
   301		case isRedirect(info) || !info.Mode().IsRegular():
   302			return []string{fmt.Sprintf(
   303				"install marker %s is not a regular file; repair or remove that installation", markerPath)}
   304		default:
   305			return []string{fmt.Sprintf(
   306				"install marker %s is unreadable or invalid; repair or remove that installation", markerPath)}
   307		}
   308	}
   309	
   310	func sweepRuntime(home string, referenced map[string]bool) ([]string, error) {
   311		runtimeRoot := filepath.Join(home, "runtime")
   312		skills, err := os.ReadDir(runtimeRoot)
   313		if os.IsNotExist(err) {
   314			return nil, nil
   315		}
   316		if err != nil {
   317			return nil, err
   318		}
   319		var removed []string
   320		for _, skill := range skills {
   321			if !skill.IsDir() {
   322				continue
   323			}
   324			commits, err := os.ReadDir(filepath.Join(runtimeRoot, skill.Name()))
   325			if err != nil {
   326				continue
   327			}
   328			for _, commit := range commits {
   329				if !commit.IsDir() {
   330					continue
   331				}
   332				key := skill.Name() + "/" + commit.Name()
   333				if !referenced[key] {
   334					if err := os.RemoveAll(filepath.Join(runtimeRoot, skill.Name(), commit.Name())); err != nil {
   335						return removed, err
   336					}
   337					removed = append(removed, key)
   338				}
   339			}
   340			remaining, _ := os.ReadDir(filepath.Join(runtimeRoot, skill.Name()))
   341			if len(remaining) == 0 {
   342				_ = os.Remove(filepath.Join(runtimeRoot, skill.Name()))
   343			}
   344		}
   345		return removed, nil
   346	}
