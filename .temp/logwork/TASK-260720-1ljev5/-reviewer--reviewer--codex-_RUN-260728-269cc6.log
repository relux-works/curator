   341	func ensureProtectedBase(home, base string) error {
   342		root, err := openWindowsProtected(home, true, false)
   343		if err != nil {
   344			return err
   345		}
   346		defer root.Close()
   347		rel, err := filepath.Rel(home, base)
   348		if err != nil || rel == "." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
   349			return untrustedf("cache root crosses the manager-home boundary")
   350		}
   351		current := home
   352		var opened []*os.File
   353		defer func() {
   354			for index := len(opened) - 1; index >= 0; index-- {
   355				_ = opened[index].Close()
   356			}
   357		}()
   358		for _, part := range strings.Split(rel, string(filepath.Separator)) {
   359			current = filepath.Join(current, part)
   360			dir, openErr := openWindowsProtected(current, true, false)
   361			if openErr != nil && errors.Is(openErr, os.ErrNotExist) {
   362				if err := os.Mkdir(current, 0o700); err != nil && !errors.Is(err, os.ErrExist) {
   363					return err
   364				}
   365				if err := protectWindowsPath(current); err != nil {
   366					return err
   367				}
   368				dir, openErr = openWindowsProtected(current, true, false)
   369			}
   370			if openErr != nil {
   371				return openErr
   372			}
   373			opened = append(opened, dir)
   374		}
   375		return nil
   376	}
