   268	func ensureProtectedBase(home, base string) error {
   269		rel, err := filepath.Rel(home, base)
   270		if err != nil || rel == "." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
   271			return untrustedf("cache root crosses the manager-home boundary")
   272		}
   273		rootFD, err := unix.Open(home, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
   274		if err != nil {
   275			return untrustedf("open manager home without following links: %v", err)
   276		}
   277		defer func() { _ = unix.Close(rootFD) }()
   278		if err := validateUnixDir(rootFD, "manager home"); err != nil {
   279			return err
   280		}
   281		currentFD := rootFD
   282		var opened []int
   283		defer func() {
   284			for index := len(opened) - 1; index >= 0; index-- {
   285				_ = unix.Close(opened[index])
   286			}
   287		}()
   288		for _, part := range strings.Split(rel, string(filepath.Separator)) {
   289			fd, openErr := unix.Openat(currentFD, part, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
   290			if errors.Is(openErr, unix.ENOENT) {
   291				if err := unix.Mkdirat(currentFD, part, 0o700); err != nil && !errors.Is(err, unix.EEXIST) {
   292					return fmt.Errorf("create protected cache directory %q: %w", part, err)
   293				}
   294				fd, openErr = unix.Openat(currentFD, part, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
   295			}
   296			if openErr != nil {
   297				return untrustedf("open protected cache directory %q: %v", part, openErr)
   298			}
   299			if err := validateUnixDir(fd, part); err != nil {
   300				_ = unix.Close(fd)
   301				return err
   302			}
   303			opened = append(opened, fd)
   304			currentFD = fd
   305		}
   306		return nil
   307	}
