   111	// parseConsumers accepts only the exact registry shape Curator writes.
   112	//
   113	// Leniency here is unsafe: a registry that is JSON but not this shape would
   114	// otherwise read as "no consumers registered", which is indistinguishable from
   115	// a machine where every project was legitimately removed — and that reading is
   116	// what would let maintenance prune live checkouts and then collect the build
   117	// artifacts they still reference.
   118	//
   119	// The document is therefore read as a token stream instead of being decoded
   120	// into a struct. Struct decoding silently accepts a repeated object member and
   121	// keeps the last one, so {"schema_version":1,"consumers":["/live"],"consumers":[]}
   122	// would read as an empty but *trusted* registry: maintenance would rewrite it
   123	// empty, and the next pass would no longer visit the checkout whose marker
   124	// protects a build artifact. An ambiguous document is not a registry, so it is
   125	// refused here, before any writer can normalize the ambiguity away.
   126	//
   127	// Repetition inside the consumers array is a different matter and stays
   128	// accepted: deduplicating it cannot drop a checkout, so it carries none of the
   129	// ambiguity that makes a repeated member unsafe.
   130	func parseConsumers(payload []byte) ([]string, error) {
   131		decoder := json.NewDecoder(bytes.NewReader(payload))
   132		decoder.UseNumber()
   133		if err := expectDelim(decoder, '{', "registry"); err != nil {
   134			return nil, err
   135		}
   136		var (
   137			version   *int
   138			consumers []string
   139			seen      = map[string]bool{}
   140		)
   141		for decoder.More() {
   142			name, err := memberName(decoder)
   143			if err != nil {
   144				return nil, err
   145			}
   146			if seen[name] {
   147				return nil, fmt.Errorf("registry repeats the %q member", name)
   148			}
   149			seen[name] = true
   150			switch name {
   151			case "schema_version":
   152				value, err := decodeRegistryVersion(decoder)
   153				if err != nil {
   154					return nil, err
   155				}
   156				version = &value
   157			case "consumers":
   158				list, err := decodeConsumerPaths(decoder)
   159				if err != nil {
   160					return nil, err
   161				}
   162				consumers = list
   163			default:
   164				return nil, fmt.Errorf("registry holds the unsupported member %q", name)
   165			}
   166		}
   167		if err := expectDelim(decoder, '}', "registry"); err != nil {
   168			return nil, err
   169		}
   170		if _, err := decoder.Token(); !errors.Is(err, io.EOF) {
   171			return nil, fmt.Errorf("trailing content after the registry object")
   172		}
   173		if version == nil {
   174			return nil, fmt.Errorf("schema_version is missing")
   175		}
   176		if *version != consumersSchemaVersion {
   177			return nil, fmt.Errorf("unsupported registry schema_version %d", *version)
   178		}
   179		if consumers == nil {
   180			return nil, fmt.Errorf("consumers is missing or null")
   181		}
   182		return consumers, nil
   183	}
