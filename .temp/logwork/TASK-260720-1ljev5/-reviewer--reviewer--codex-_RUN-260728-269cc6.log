   228	func validateUnixDir(fd int, label string) error {
   229		var stat unix.Stat_t
   230		if err := unix.Fstat(fd, &stat); err != nil {
   231			return untrustedf("stat %s: %v", label, err)
   232		}
   233		if stat.Mode&unix.S_IFMT != unix.S_IFDIR {
   234			return untrustedf("%s is not a directory", label)
   235		}
   236		if int(stat.Uid) != os.Geteuid() {
   237			return untrustedf("%s owner does not match the effective user", label)
   238		}
   239		if stat.Mode&0o022 != 0 {
   240			return untrustedf("%s is writable by group or other", label)
   241		}
   242		return nil
   243	}
   244	
   245	func validateUnixFile(fd int, label string, executable bool) error {
   246		var stat unix.Stat_t
   247		if err := unix.Fstat(fd, &stat); err != nil {
   248			return untrustedf("stat %s: %v", label, err)
   249		}
   250		if stat.Mode&unix.S_IFMT != unix.S_IFREG {
   251			return untrustedf("%s is not a regular file", label)
   252		}
   253		if stat.Nlink != 1 {
   254			return untrustedf("%s has multiple hard links", label)
   255		}
   256		if int(stat.Uid) != os.Geteuid() {
   257			return untrustedf("%s owner does not match the effective user", label)
   258		}
   259		if stat.Mode&0o022 != 0 {
   260			return untrustedf("%s is writable by group or other", label)
   261		}
   262		if executable && stat.Mode&0o100 == 0 {
   263			return untrustedf("artifact is not executable by its owner")
   264		}
   265		return nil
   266	}
