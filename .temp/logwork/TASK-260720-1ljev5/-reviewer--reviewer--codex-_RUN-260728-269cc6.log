    16	
    17	// DefaultGrace is Curator's documented build-cache grace period. An
    18	// unreferenced protected entry younger than this is always retained.
    19	//
    20	// A swept entry costs a rebuild, never correctness, so the window only has to
    21	// exceed any operation that could still be publishing while holding no journal
    22	// — a crash between publication and journal preparation is the only such case.
    23	// One day is far beyond that and still bounds how long orphaned artifacts
    24	// occupy disk.
    25	const DefaultGrace = 24 * time.Hour
    26	
    27	// sweepPrefix names a cache entry this collector already retired. The rename
    28	// is the atomic removal; the tree deletion behind it is resumable cleanup.
    29	const sweepPrefix = ".sweep-"
    30	
    31	var entryNameRE = regexp.MustCompile(`^[0-9a-f]{64}$`)
    32	
    33	// beforeRetireForTests runs immediately before the first retirement of a pass.
    34	// It is the seam an adversarial test uses to exchange the cache-root pathname
    35	// after validation and prove that the removal still cannot leave the directory
    36	// object this sweep proved. It is nil in every production build.
    37	var beforeRetireForTests func()
    38	
    39	// beforeClassifyForTests runs after a candidate's boundary and receipt have
    40	// been proven and immediately before the decisive classification of that same
    41	// candidate. It is the seam an adversarial test uses to exchange the cache-root
    42	// pathname in exactly the window where a pathname-based inspection would
    43	// validate the replacement instead of the entry it is about to remove. It is
    44	// nil in every production build.
    45	var beforeClassifyForTests func()
    46	
    47	// SweepRequest describes one locked maintenance sweep of the protected cache.
    48	// The caller owns the mark phase: this package never reads a marker, a journal,
    49	// or a consumer, and never treats receipt content as a live reference.
    50	type SweepRequest struct {
    51		// Referenced holds every logical build key a valid marker v2 or an
    52		// in-flight transaction journal names, as "sha256:" + 64 lowercase hex.
    53		Referenced []string
    54		// Now is the maintenance clock; the zero value means time.Now().
    55		Now time.Time
    56		// Grace retains an unreferenced entry published less than this long ago.
    57		// The zero value means DefaultGrace.
    58		Grace time.Duration
    59	}
    60	
    61	// SweepResult reports the removed logical keys and every uncertainty an
    62	// operator has to resolve. A warning always means something was retained.
    63	type SweepResult struct {
    64		Removed  []string
    65		Warnings []string
    66	}
    67	
    68	// Sweep removes unreferenced protected cache entries older than the grace
    69	// period while the caller holds the manager-home mutation lock.
    70	//
    71	// Every decision fails safe. The cache root is revalidated as protected state
    72	// before traversal; an entry is removed only when it is itself protected,
    73	// structurally exact, and self-consistent with the logical key its directory
    74	// name encodes; anything unprovable is retained and reported. Entry content is
    75	// never executed, adopted, or permission-repaired.
    76	func (store *Store) Sweep(request SweepRequest, lock HomeLock) (SweepResult, error) {
    77		if err := requireHomeLock(lock); err != nil {
    78			return SweepResult{}, err
    79		}
    80		if request.Grace < 0 {
    81			return SweepResult{}, fmt.Errorf("build cache grace period must not be negative")
    82		}
    83		if store == nil || store.supported == nil || !store.supported() {
    84			return SweepResult{Warnings: []string{
    85				"build cache sweep skipped: platform protection is unavailable, so no entry can be proven safe to remove",
    86			}}, nil
    87		}
    88		grace := request.Grace
    89		if grace == 0 {
    90			grace = DefaultGrace
    91		}
    92		now := request.Now
    93		if now.IsZero() {
    94			now = time.Now()
    95		}
    96	
    97		result := SweepResult{}
    98		referenced := make(map[string]bool, len(request.Referenced))
    99		for _, key := range request.Referenced {
   100			name, ok := entryName(key)
   101			if !ok {
   102				result.Warnings = append(result.Warnings, fmt.Sprintf(
   103					"build cache sweep: ignored malformed referenced build key %q; repair the marker or journal that names it", key))
   104				continue
   105			}
   106			referenced[name] = true
   107		}
   108	
   109		base := filepath.Join(store.home, "cache", "build", buildmeta.DriverGoV1)
   110		if !pathWithin(store.home, base) {
   111			return result, fmt.Errorf("cache path crosses the manager-home boundary")
   112		}
   113		root, err := openSweepRoot(store.home, base)
   114		if err != nil {
   115			if errors.Is(err, os.ErrNotExist) {
   116				return result, nil
   117			}
   118			result.Warnings = append(result.Warnings, fmt.Sprintf(
   119				"build cache sweep skipped: %v; no entry was traversed or removed", err))
   120			return result, nil
   121		}
   122		// The proven root stays open, and every mutation below goes through the
   123		// handle-relative mutator bound to it, so no removal can follow a pathname
   124		// that was exchanged after the boundary was proven.
   125		defer root.close()
   126	
   127		names, err := directoryNames(root.validated.dir)
   128		if err != nil {
   129			result.Warnings = append(result.Warnings, fmt.Sprintf(
   130				"build cache sweep skipped: list protected cache root: %v", err))
   131			return result, nil
   132		}
   133		for _, name := range names {
   134			switch {
   135			case entryNameRE.MatchString(name):
   136				if referenced[name] {
   137					continue
   138				}
   139				store.sweepUnreferenced(root, name, now, grace, &result)
   140			case strings.HasPrefix(name, sweepPrefix):
   141				// Manager-private wreckage of an interrupted removal: the entry is
   142				// already unreachable by key, so finishing the deletion is safe.
   143				if err := root.mutator.RemoveAll(name); err != nil {
   144					result.Warnings = append(result.Warnings, fmt.Sprintf(
   145						"build cache sweep: could not finish removing retired entry %q: %v", name, err))
   146				}
   147			default:
   148				result.Warnings = append(result.Warnings, fmt.Sprintf(
   149					"build cache sweep: retained unrecognized cache root member %q; inspect it and remove it manually", name))
   150			}
   151		}
   152		return result, nil
   153	}
   154	
   155	// sweepUnreferenced classifies one unreferenced candidate and removes it only
   156	// when every safety property holds.
   157	func (store *Store) sweepUnreferenced(root *sweepRoot, name string, now time.Time, grace time.Duration, result *SweepResult) {
   158		key := buildmeta.CacheKey("sha256:" + name)
   159		published, inspected, err := store.inspectUnexpected(root, name, key)
   160		if err != nil {
   161			result.Warnings = append(result.Warnings, fmt.Sprintf(
   162				"build cache sweep: retained %s: %v", key, err))
   163			return
   164		}
   165		if inspected.Status != Hit {
   166			result.Warnings = append(result.Warnings, fmt.Sprintf(
   167				"build cache sweep: retained %s (%s): %s", key, inspected.Status, inspected.Reason))
   168			return
   169		}
   170		if published.After(now) {
   171			result.Warnings = append(result.Warnings, fmt.Sprintf(
   172				"build cache sweep: retained %s: its publication time %s is in the future; check the system clock",
   173				key, published.UTC().Format(time.RFC3339)))
   174			return
   175		}
   176		if now.Sub(published) <= grace {
   177			return
   178		}
   179		if hook := beforeRetireForTests; hook != nil {
   180			hook()
   181		}
   182		if err := retireEntry(root, name); err != nil {
   183			result.Warnings = append(result.Warnings, fmt.Sprintf(
   184				"build cache sweep: could not remove %s: %v", key, err))
   185			return
   186		}
   187		result.Removed = append(result.Removed, string(key))
   188	}
   189	
   190	// inspectUnexpected validates an entry whose logical input maintenance does not
   191	// know in advance, and reports when it was published.
   192	//
   193	// Provenance stays with the protected boundary. The entry is re-resolved
   194	// without following a link at any component, its parent has to be the very
   195	// directory object this sweep proved, the receipt is read only to name the
   196	// input the entry claims, and that input is then independently re-derived into
   197	// a cache key which must equal the directory name. The full read-only
   198	// inspection re-checks the exact structure, receipt, artifact hash, and size,
   199	// so a receipt that is merely internally consistent proves nothing.
   200	//
   201	// The decisive inspection runs on the descriptor proved here, never on the
   202	// pathname it came from. That is what makes the classification and the removal
   203	// speak about the same directory object: an exchange of the cache-root pathname
   204	// in this window can no longer let a planted replacement validate while the
   205	// unproven original is the one that gets retired.
   206	func (store *Store) inspectUnexpected(root *sweepRoot, name string, key buildmeta.CacheKey) (time.Time, Result, error) {
   207		entryPath := filepath.Join(root.path, name)
   208		opened, err := openProtectedDir(store.home, entryPath)
   209		if err != nil {
   210			return time.Time{}, Result{}, err
   211		}
   212		defer opened.close()
   213		if err := root.assertParentOf(opened); err != nil {
   214			return time.Time{}, Result{}, err
   215		}
   216		info, err := opened.dir.Stat()
   217		if err != nil {
   218			return time.Time{}, Result{}, fmt.Errorf("stat cache entry: %w", err)
   219		}
   220		receiptBytes, err := readProtectedChild(opened.dir, ReceiptFilename)
   221		if err != nil {
   222			return time.Time{}, Result{}, err
   223		}
   224		receipt, err := buildmeta.DecodeReceipt(receiptBytes)
   225		if err != nil {
   226			return time.Time{}, Result{}, fmt.Errorf("invalid receipt: %w", err)
   227		}
   228		if receipt.CacheKey != key {
   229			return time.Time{}, Result{}, fmt.Errorf("receipt cache key does not match the entry key")
   230		}
   231		if hook := beforeClassifyForTests; hook != nil {
   232			hook()
   233		}
   234		return info.ModTime(), inspectProvenEntry(opened, entryPath, Expectation{Input: receipt.Input}, key), nil
   235	}
   236	
   237	func readProtectedChild(dir *os.File, name string) ([]byte, error) {
   238		file, err := openProtectedChildFile(dir, name)
   239		if err != nil {
   240			return nil, err
   241		}
   242		defer func() { _ = file.Close() }()
   243		payload, err := readExactFile(file)
   244		if err != nil {
   245			return nil, fmt.Errorf("read %s: %w", name, err)
   246		}
   247		return payload, nil
   248	}
   249	
   250	// retireEntry removes one direct child of the proven cache root through the
   251	// mutator bound to that root. The rename is the atomic removal: afterwards no
   252	// reader can reach the entry by its key, and because both names are resolved
   253	// relative to the proven directory object rather than by pathname, neither the
   254	// rename nor the deletion behind it can act on a directory that replaced the
   255	// cache root after it was validated.
   256	func retireEntry(root *sweepRoot, name string) error {
   257		if root == nil || root.mutator == nil {
   258			return fmt.Errorf("the protected cache root is not open for mutation")
   259		}
   260		if !isDirectChildName(name) {
   261			return fmt.Errorf("cache entry name is not a direct root child")
   262		}
   263		retired, err := reserveRetiredName(root.mutator, name)
   264		if err != nil {
   265			return err
   266		}
   267		if err := root.mutator.Rename(name, retired); err != nil {
   268			return fmt.Errorf("retire cache entry: %w", err)
   269		}
   270		if err := syncDirHandle(root.validated.dir); err != nil {
   271			return fmt.Errorf("sync cache root: %w", err)
   272		}
   273		if err := root.mutator.RemoveAll(retired); err != nil {
   274			// The entry is already unreachable by key. The leftover is named for
   275			// the next sweep to finish, so this is reported, not failed.
   276			return fmt.Errorf("remove retired cache entry %q: %w", retired, err)
   277		}
   278		return syncDirHandle(root.validated.dir)
   279	}
   280	
   281	// isDirectChildName reports whether name addresses one member of a directory
   282	// and nothing else — no traversal, no separator, no self or parent reference.
   283	func isDirectChildName(name string) bool {
   284		if name == "" || name == "." || name == ".." {
   285			return false
   286		}
   287		return !strings.ContainsRune(name, '/') && !strings.ContainsRune(name, filepath.Separator)
   288	}
   289	
   290	// reserveRetiredName picks a private name that does not exist inside the proven
   291	// root. The name is only ever resolved through the root handle, so it cannot
   292	// collide with anything outside the boundary.
   293	func reserveRetiredName(root *os.Root, name string) (string, error) {
   294		for attempt := 0; attempt < 16; attempt++ {
   295			var suffix [8]byte
   296			if _, err := rand.Read(suffix[:]); err != nil {
   297				return "", fmt.Errorf("reserve a private cache name: %w", err)
   298			}
   299			candidate := sweepPrefix + name + "-" + hex.EncodeToString(suffix[:])
   300			_, err := root.Lstat(candidate)
   301			if errors.Is(err, os.ErrNotExist) {
   302				return candidate, nil
   303			}
   304			if err != nil {
   305				return "", fmt.Errorf("reserve a private cache name: %w", err)
   306			}
   307		}
   308		return "", fmt.Errorf("could not reserve a private cache name")
   309	}
   310	
   311	// entryName maps a logical build key to its cache directory name.
   312	func entryName(key string) (string, bool) {
   313		name, found := strings.CutPrefix(key, "sha256:")
   314		if !found || !entryNameRE.MatchString(name) {
   315			return "", false
   316		}
   317		return name, true
   318	}
   319	
   320	// sweepRoot binds one proven protected cache root to the handle-relative
   321	// mutator that every removal of the same pass has to go through.
   322	//
   323	// The validated handles prove the boundary — type, owner, and mode or DACL of
   324	// every component, resolved without following a link. The mutator is opened on
   325	// the same directory and accepted only when it names the very same directory
   326	// object, so an exchange of the cache-root pathname between validation and
   327	// mutation is refused rather than followed.
   328	type sweepRoot struct {
   329		path      string
   330		validated *protectedDir
   331		identity  os.FileInfo
   332		mutator   *os.Root
   333	}
   334	
   335	func openSweepRoot(home, base string) (*sweepRoot, error) {
   336		validated, err := openProtectedDir(home, base)
   337		if err != nil {
   338			return nil, err
   339		}
   340		identity, err := validated.dir.Stat()
   341		if err != nil {
   342			validated.close()
   343			return nil, untrustedf("stat the protected cache root: %v", err)
   344		}
   345		mutator, err := os.OpenRoot(base)
   346		if err != nil {
   347			validated.close()
   348			if errors.Is(err, os.ErrNotExist) {
   349				return nil, err
   350			}
   351			return nil, untrustedf("open the protected cache root for mutation: %v", err)
   352		}
   353		mutatorInfo, err := mutator.Stat(".")
   354		if err != nil {
   355			_ = mutator.Close()
   356			validated.close()
   357			return nil, untrustedf("stat the protected cache root for mutation: %v", err)
   358		}
   359		if !os.SameFile(identity, mutatorInfo) {
   360			_ = mutator.Close()
   361			validated.close()
   362			return nil, untrustedf("the protected cache root changed identity between validation and mutation")
   363		}
   364		return &sweepRoot{path: base, validated: validated, identity: identity, mutator: mutator}, nil
   365	}
   366	
   367	// assertParentOf refuses an entry whose parent is not the directory object this
   368	// sweep proved, which is what a cache root exchanged mid-pass looks like.
   369	func (root *sweepRoot) assertParentOf(entry *protectedDir) error {
   370		parent := entry.parent()
   371		if parent == nil {
   372			return untrustedf("cache entry has no proven parent directory")
   373		}
   374		info, err := parent.Stat()
   375		if err != nil {
   376			return untrustedf("stat the parent of a cache entry: %v", err)
   377		}
   378		if !os.SameFile(info, root.identity) {
   379			return untrustedf("cache entry no longer lives in the proven cache root")
   380		}
   381		return nil
   382	}
   383	
   384	func (root *sweepRoot) close() {
   385		if root == nil {
   386			return
   387		}
   388		if root.mutator != nil {
   389			_ = root.mutator.Close()
   390		}
   391		root.validated.close()
   392	}
   393	
   394	// protectedDir is a validated directory handle together with the parent handles
   395	// that prove the path was resolved without following a link at any component.
   396	type protectedDir struct {
   397		dir     *os.File
   398		parents []*os.File
   399	}
   400	
   401	// parent returns the handle of the directory that directly contains dir.
   402	func (opened *protectedDir) parent() *os.File {
   403		if opened == nil || len(opened.parents) == 0 {
   404			return nil
   405		}
   406		return opened.parents[len(opened.parents)-1]
   407	}
   408	
   409	func (opened *protectedDir) close() {
   410		if opened == nil {
   411			return
   412		}
   413		if opened.dir != nil {
   414			_ = opened.dir.Close()
   415		}
   416		for index := len(opened.parents) - 1; index >= 0; index-- {
   417			if opened.parents[index] != nil {
   418				_ = opened.parents[index].Close()
   419			}
   420		}
   421	}

