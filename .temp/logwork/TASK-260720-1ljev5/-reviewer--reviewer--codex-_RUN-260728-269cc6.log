    28		}
    29		opened.extra = append(opened.extra, root)
    30		current := home
    31		parts := strings.Split(rel, string(filepath.Separator))
    32		for index, part := range parts {
    33			if part == "" || part == "." || part == ".." {
    34				opened.close()
    35				return nil, untrustedf("cache entry contains an invalid path component")
    36			}
    37			current = filepath.Join(current, part)
    38			dir, openErr := openWindowsProtected(current, true, false)
    39			if openErr != nil {
    40				opened.close()
    41				if errors.Is(openErr, os.ErrNotExist) {
    42					return nil, fmt.Errorf("cache entry is incomplete: %w", openErr)
    43				}
    44				return nil, openErr
    45			}
    46			if index == len(parts)-1 {
    47				opened.entryDir = dir
    48			} else {
    49				opened.extra = append(opened.extra, dir)
    50			}
    51		}
    52		receipt, err := openWindowsProtected(filepath.Join(entryPath, ReceiptFilename), false, false)
    53		if err != nil {
    54			opened.close()
    55			return nil, err
    56		}
    57		opened.receipt = receipt
    58		binDir, err := openWindowsProtected(filepath.Join(entryPath, "bin"), true, false)
    59		if err != nil {
    60			opened.close()
    61			return nil, err
    62		}
    63		opened.binDir = binDir
    64	
    65		artifactName, err := artifactChildName(artifactRel)
    66		if err != nil {
    67			opened.close()
    68			return nil, err
    69		}
    70		artifact, err := openWindowsProtected(filepath.Join(entryPath, "bin", artifactName), false, true)
    71		if err != nil {
    72			opened.close()
    73			return nil, err
    74		}
