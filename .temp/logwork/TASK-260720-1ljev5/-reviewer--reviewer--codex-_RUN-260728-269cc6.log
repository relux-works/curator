   191		}
   192		for _, scopeDir := range []string{
   193			filepath.Join(home, "global", "skills"),
   194			filepath.Join(home, "hybrid", "skills"),
   195		} {
   196			scope := readScope(scopeDir)
   197			marked.uncertain = append(marked.uncertain, scope.uncertain...)
   198			marked.notes = append(marked.notes, scope.notes...)
