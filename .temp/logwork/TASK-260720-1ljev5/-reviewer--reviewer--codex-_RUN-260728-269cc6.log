   235	func memberName(decoder *json.Decoder) (string, error) {
   236		token, err := decoder.Token()
   237		if err != nil {
   238			return "", err
   239		}
   240		name, ok := token.(string)
   241		if !ok {
   242			return "", fmt.Errorf("registry holds a member name that is not a string")
   243		}
   244		return name, nil
   245	}
