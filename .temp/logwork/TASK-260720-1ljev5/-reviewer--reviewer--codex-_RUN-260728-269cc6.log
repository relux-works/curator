     1	package scopes
     2	
     3	import (
     4		"fmt"
     5		"os"
     6		"path/filepath"
     7	
     8		"github.com/relux-works/curator/internal/staging"
     9	)
    10	
    11	// StageConsumer renders the machine-wide consumer registry that must exist
    12	// after this checkout is installed, and returns it as the last commit target.
    13	//
    14	// The merge deliberately reads the live registry: the caller runs this while
    15	// holding the manager-home mutation lock, so a checkout registered by another
    16	// project that committed first is folded in rather than overwritten. Staging it
    17	// before the lock would let the later of two concurrent installs erase the
    18	// earlier one's consumer.
    19	func StageConsumer(stageRoot, home, projectRoot string) (staging.Plan, error) {
    20		resolved, err := filepath.Abs(projectRoot)
    21		if err != nil {
    22			resolved = projectRoot
    23		}
    24		set := map[string]bool{resolved: true}
    25		existing, err := readConsumers(home)
    26		if err != nil {
    27			return staging.Plan{}, fmt.Errorf("read the consumer registry %s: %w", filepath.Join(home, ConsumersName), err)
    28		}
    29		for _, entry := range existing {
    30			set[entry] = true
    31		}
    32		payload, err := ConsumersPayload(set)
    33		if err != nil {
    34			return staging.Plan{}, fmt.Errorf("render consumer registry: %w", err)
    35		}
    36		staged := filepath.Join(stageRoot, "consumers")
    37		if err := os.MkdirAll(staged, 0o700); err != nil {
    38			return staging.Plan{}, fmt.Errorf("stage consumer registry: %w", err)
    39		}
    40		stagedPath := filepath.Join(staged, ConsumersName)
    41		if err := os.WriteFile(stagedPath, payload, 0o644); err != nil {
    42			return staging.Plan{}, fmt.Errorf("stage consumer registry: %w", err)
    43		}
    44		var plan staging.Plan
    45		plan.Replace(staging.ClassConsumer, ConsumersName, filepath.Join(home, ConsumersName), stagedPath)
    46		return plan, nil
    47	}

