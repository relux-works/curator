   148	// marks is one complete traversal of every live install scope.
   149	type marks struct {
   150		consumers []string
   151		runtime   map[string]bool
   152		builds    []string
   153		// uncertain describes state that exists but could not be trusted, so the
   154		// reference set derived from it is incomplete. Any entry here blocks the
   155		// build sweep and protects every consumer it came from.
   156		uncertain []string
   157		// notes describe state that was ignored but cannot hide a reference, so
   158		// they are reported without blocking maintenance.
   159		notes []string
   160		// registryUnknown records that the consumer registry exists but could not
   161		// be trusted, so it must not be rewritten.
   162		registryUnknown bool
   163	}
   164	
   165	func (marked marks) warnings() []string {
   166		warnings := append([]string(nil), marked.uncertain...)
   167		return append(warnings, marked.notes...)
   168	}
