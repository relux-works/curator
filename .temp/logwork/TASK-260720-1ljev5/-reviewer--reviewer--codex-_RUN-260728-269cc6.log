    78	
    79	// openProtectedEntryFrom opens the receipt, artifact directory, and artifact of
    80	// an already-proven cache entry below that entry's own open handle.
    81	//
    82	// Windows answers the exchange threat one layer lower than Unix does. Every
    83	// component from the manager home down to this entry is held open without
    84	// FILE_SHARE_DELETE, so none of them can be renamed or deleted while the sweep
    85	// runs and the entry pathname cannot be made to resolve elsewhere. The identity
    86	// assertion below refuses even a hypothetical exchange rather than trusting the
    87	// share mode alone, and the decisive listing of the entry's members still comes
    88	// from the caller's handle, which no pathname can redirect.
    89	func openProtectedEntryFrom(entry *protectedDir, artifactRel string) (*openedEntry, error) {
    90		if entry == nil || entry.dir == nil {
    91			return nil, untrustedf("protected cache entry handle is missing")
    92		}
    93		base := entry.dir.Name()
    94		if err := validateWindowsHandle(windows.Handle(entry.dir.Fd()), base, true, false); err != nil {
    95			return nil, err
    96		}
    97		held, err := entry.dir.Stat()
    98		if err != nil {
    99			return nil, untrustedf("stat the proven cache entry: %v", err)
   100		}
   101		current, err := os.Lstat(base)
   102		if err != nil || !os.SameFile(held, current) {
   103			return nil, untrustedf("the cache entry pathname no longer names the proven entry")
   104		}
   105		artifactName, err := artifactChildName(artifactRel)
   106		if err != nil {
   107			return nil, err
   108		}
   109	
   110		opened := &openedEntry{entryDir: entry.dir, borrowedEntryDir: true}
   111		receipt, err := openWindowsProtected(filepath.Join(base, ReceiptFilename), false, false)
   112		if err != nil {
   113			opened.close()
   114			return nil, err
   115		}
   116		opened.receipt = receipt
   117		binDir, err := openWindowsProtected(filepath.Join(base, "bin"), true, false)
   118		if err != nil {
   119			opened.close()
   120			return nil, err
   121		}
   122		opened.binDir = binDir
   123		artifact, err := openWindowsProtected(filepath.Join(base, "bin", artifactName), false, true)
   124		if err != nil {
   125			opened.close()
   126			return nil, err
   127		}
   128		opened.artifact = artifact
   129		return opened, nil
   130	}
   131	
   132	// openProtectedDir resolves dirPath below home without following a reparse
   133	// point at any component and validates the type, owner, and protected DACL of
   134	// each one. It is the traversal boundary maintenance revalidates before reading
   135	// the cache root or classifying one entry, and it never creates or repairs
   136	// anything.
   137	func openProtectedDir(home, dirPath string) (*protectedDir, error) {
   138		rel, err := filepath.Rel(home, dirPath)
   139		if err != nil || rel == "." || rel == ".." ||
   140			strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
   141			return nil, untrustedf("protected directory crosses the manager-home boundary")
   142		}
   143		root, err := openWindowsProtected(home, true, false)
   144		if err != nil {
   145			return nil, err
   146		}
   147		opened := &protectedDir{parents: []*os.File{root}}
   148		current := home
   149		parts := strings.Split(rel, string(filepath.Separator))
   150		for index, part := range parts {
   151			if part == "" || part == "." || part == ".." {
   152				opened.close()
   153				return nil, untrustedf("protected directory contains an invalid path component")
   154			}
   155			current = filepath.Join(current, part)
   156			dir, openErr := openWindowsProtected(current, true, false)
   157			if openErr != nil {
   158				opened.close()
   159				return nil, openErr
   160			}
   161			if index == len(parts)-1 {
   162				opened.dir = dir
   163			} else {
   164				opened.parents = append(opened.parents, dir)
   165			}
   166		}
   167		return opened, nil
   168	}
