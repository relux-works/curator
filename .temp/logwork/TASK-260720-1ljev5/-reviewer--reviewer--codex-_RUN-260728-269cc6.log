    19	func openProtectedEntry(home, entryPath, artifactRel string) (*openedEntry, error) {
    20		rel, err := filepath.Rel(home, entryPath)
    21		if err != nil || rel == "." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
    22			return nil, untrustedf("cache entry crosses the manager-home boundary")
    23		}
    24		opened := &openedEntry{}
    25		root, err := openWindowsProtected(home, true, false)
    26		if err != nil {
