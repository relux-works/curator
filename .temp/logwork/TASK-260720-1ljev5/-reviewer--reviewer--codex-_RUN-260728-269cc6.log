   170	// openProtectedChildFile opens one regular file inside an already-validated
   171	// protected directory handle, without following a reparse point.
   172	func openProtectedChildFile(dir *os.File, name string) (*os.File, error) {
   173		if dir == nil {
   174			return nil, untrustedf("protected directory handle is missing")
   175		}
   176		return openWindowsProtected(filepath.Join(dir.Name(), name), false, false)
   177	}
   178	
   179	func openWindowsProtected(path string, directory, executable bool) (*os.File, error) {
   180		path16, err := windows.UTF16PtrFromString(path)
   181		if err != nil {
   182			return nil, untrustedf("encode protected path: %v", err)
   183		}
   184		flags := uint32(windows.FILE_FLAG_OPEN_REPARSE_POINT)
   185		if directory {
   186			flags |= windows.FILE_FLAG_BACKUP_SEMANTICS
   187		}
   188		handle, err := windows.CreateFile(
   189			path16,
   190			windows.GENERIC_READ|windows.READ_CONTROL,
   191			windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE,
   192			nil,
   193			windows.OPEN_EXISTING,
   194			flags,
   195			0,
   196		)
   197		if err != nil {
   198			if errors.Is(err, windows.ERROR_FILE_NOT_FOUND) || errors.Is(err, windows.ERROR_PATH_NOT_FOUND) {
   199				return nil, fmt.Errorf("cache entry is incomplete: %w", os.ErrNotExist)
   200			}
   201			return nil, untrustedf("open protected path without following reparse points: %v", err)
   202		}
   203		if err := validateWindowsHandle(handle, path, directory, executable); err != nil {
   204			_ = windows.CloseHandle(handle)
   205			return nil, err
   206		}
   207		return os.NewFile(uintptr(handle), path), nil
   208	}
   209	
   210	func validateWindowsHandle(handle windows.Handle, label string, directory, _ bool) error {
   211		var info windows.ByHandleFileInformation
   212		if err := windows.GetFileInformationByHandle(handle, &info); err != nil {
   213			return untrustedf("inspect %s: %v", label, err)
   214		}
   215		if info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 {
   216			return untrustedf("%s is a reparse point", label)
   217		}
   218		isDirectory := info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0
   219		if isDirectory != directory {
   220			return untrustedf("%s has the wrong file type", label)
   221		}
   222		if !directory && info.NumberOfLinks != 1 {
   223			return untrustedf("%s has multiple hard links", label)
   224		}
   225		if err := validateWindowsSecurity(handle, label); err != nil {
   226			return err
   227		}
   228		return nil
   229	}
   230	
   231	func validateWindowsSecurity(handle windows.Handle, label string) error {
   232		descriptor, err := windows.GetSecurityInfo(
   233			handle,
   234			windows.SE_FILE_OBJECT,
   235			windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION,
   236		)
   237		if err != nil {
   238			return untrustedf("read %s owner and DACL: %v", label, err)
   239		}
   240		owner, _, err := descriptor.Owner()
   241		if err != nil || owner == nil || !owner.IsValid() {
   242			return untrustedf("%s has no valid owner", label)
   243		}
   244		user, err := windows.GetCurrentProcessToken().GetTokenUser()
   245		if err != nil {
   246			return untrustedf("resolve effective Windows user: %v", err)
   247		}
   248		if err := validateWindowsOwner(owner, user.User.Sid, label); err != nil {
   249			return err
   250		}
   251		control, _, err := descriptor.Control()
   252		if err != nil || control&windows.SE_DACL_PROTECTED == 0 {
   253			return untrustedf("%s DACL is not protected from inheritance", label)
   254		}
   255		dacl, _, err := descriptor.DACL()
   256		if err != nil || dacl == nil {
   257			return untrustedf("%s has no protected DACL", label)
   258		}
   259		return validateWindowsDACL(dacl, owner, label)
   260	}
   261	
   262	func validateWindowsOwner(owner, effectiveUser *windows.SID, label string) error {
   263		if owner == nil || !owner.IsValid() || effectiveUser == nil || !effectiveUser.IsValid() || !owner.Equals(effectiveUser) {
   264			return untrustedf("%s owner does not match the effective user", label)
   265		}
   266		return nil
   267	}
   268	
   269	// validateWindowsDACL deliberately accepts only an unambiguous owner-only ACL.
   270	// Curator creates this shape itself. Rejecting deny, inherited, inherit-only,
   271	// and non-owner entries avoids treating the ACL text as an access check while
   272	// still proving that the owner has every right needed to replace the entry.
   273	func validateWindowsDACL(dacl *windows.ACL, owner *windows.SID, label string) error {
   274		if dacl == nil || owner == nil || !owner.IsValid() {
   275			return untrustedf("%s has no valid owner-only DACL", label)
   276		}
   277		var ownerRights windows.ACCESS_MASK
   278		for index := uint32(0); index < uint32(dacl.AceCount); index++ {
   279			var ace *windows.ACCESS_ALLOWED_ACE
   280			if err := windows.GetAce(dacl, index, &ace); err != nil || ace == nil {
   281				return untrustedf("read %s DACL entry: %v", label, err)
   282			}
   283			if ace.Header.AceType != windows.ACCESS_ALLOWED_ACE_TYPE {
   284				return untrustedf("%s DACL contains a deny or unsupported entry", label)
   285			}
   286			if ace.Header.AceFlags != 0 {
   287				return untrustedf("%s DACL contains an inherited or inheritable entry", label)
   288			}
   289			sid := (*windows.SID)(unsafe.Pointer(&ace.SidStart))
   290			if sid == nil || !sid.IsValid() {
   291				return untrustedf("%s DACL contains an invalid SID", label)
   292			}
   293			if !owner.Equals(sid) {
   294				return untrustedf("%s DACL grants access to another principal", label)
   295			}
   296			ownerRights |= ace.Mask
   297		}
   298		if ownerRights&windows.GENERIC_ALL == 0 && ownerRights&windowsConcreteMutationRights != windowsConcreteMutationRights {
   299			return untrustedf("%s owner lacks required mutation rights", label)
   300		}
   301		return nil
   302	}
   303	
   304	const (
   305		windowsFileDeleteChild        windows.ACCESS_MASK = 0x00000040
   306		windowsConcreteMutationRights windows.ACCESS_MASK = windows.FILE_WRITE_DATA | windows.FILE_APPEND_DATA |
   307			windows.FILE_WRITE_EA | windows.FILE_WRITE_ATTRIBUTES | windowsFileDeleteChild |
   308			windows.WRITE_DAC | windows.WRITE_OWNER | windows.DELETE
   309	)
   310	
   311	func protectWindowsPath(path string) error {
   312		user, err := windows.GetCurrentProcessToken().GetTokenUser()
   313		if err != nil {
   314			return err
   315		}
   316		access := []windows.EXPLICIT_ACCESS{{
   317			AccessPermissions: windows.GENERIC_ALL,
   318			AccessMode:        windows.SET_ACCESS,
   319			Inheritance:       windows.NO_INHERITANCE,
   320			Trustee: windows.TRUSTEE{
   321				TrusteeForm:  windows.TRUSTEE_IS_SID,
   322				TrusteeType:  windows.TRUSTEE_IS_USER,
   323				TrusteeValue: windows.TrusteeValueFromSID(user.User.Sid),
   324			},
   325		}}
   326		acl, err := windows.ACLFromEntries(access, nil)
   327		if err != nil {
   328			return err
   329		}
   330		return windows.SetNamedSecurityInfo(
   331			path,
   332			windows.SE_FILE_OBJECT,
   333			windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION,
   334			nil,
   335			nil,
   336			acl,
   337			nil,
   338		)
   339	}
