   309	func makeProtectedTempDir(parent, pattern string) (string, error) {
   310		path, err := os.MkdirTemp(parent, pattern)
   311		if err != nil {
   312			return "", err
   313		}
   314		// #nosec G302 -- a protected cache directory is owner-only by design; the
   315		// linter's 0600 ceiling is for files and would make the directory
   316		// unenterable.
   317		if err := os.Chmod(path, 0o700); err != nil {
   318			_ = os.RemoveAll(path)
   319			return "", err
   320		}
   321		return path, nil
   322	}
   323	
   324	func createProtectedDir(path string) error {
   325		if err := os.Mkdir(path, 0o700); err != nil {
   326			return err
   327		}
   328		// #nosec G302 -- owner-only directory; see makeProtectedTempDir.
   329		return os.Chmod(path, 0o700)
   330	}
