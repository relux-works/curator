   204	// decodeConsumerPaths reads the checkout array. An empty array is a registry
   205	// with no consumers; anything that is not an array of absolute paths is an
   206	// unknown registry.
   207	func decodeConsumerPaths(decoder *json.Decoder) ([]string, error) {
   208		if err := expectDelim(decoder, '[', "consumers"); err != nil {
   209			return nil, err
   210		}
   211		list := []string{}
   212		for decoder.More() {
   213			token, err := decoder.Token()
   214			if err != nil {
   215				return nil, err
   216			}
