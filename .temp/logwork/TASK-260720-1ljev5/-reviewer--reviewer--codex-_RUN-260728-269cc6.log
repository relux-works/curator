   170	func markScopes(home string) marks {
   171		marked := marks{runtime: map[string]bool{}}
   172		consumers, err := readConsumers(home)
   173		if err != nil {
   174			marked.registryUnknown = true
   175			marked.uncertain = append(marked.uncertain, fmt.Sprintf(
   176				"consumer registry %s cannot be trusted: %v; no consumer was pruned and no build entry was swept",
   177				filepath.Join(home, ConsumersName), err))
   178		}
   179		for _, projectRoot := range consumers {
   180			scope := readScope(filepath.Join(projectRoot, ".agents", "skills"))
   181			marked.uncertain = append(marked.uncertain, scope.uncertain...)
   182			marked.notes = append(marked.notes, scope.notes...)
   183			// A consumer is dropped only once its scope is proven absent or valid
   184			// and empty. While anything about it is uncertain it stays registered,
   185			// so a later pass still visits the markers that may name a build key.
   186			if len(scope.markers) == 0 && len(scope.uncertain) == 0 {
