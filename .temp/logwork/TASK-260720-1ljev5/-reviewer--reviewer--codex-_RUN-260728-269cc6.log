    11		"io"
    12		"os"
    13		"path/filepath"
    14		"reflect"
    15		"sort"
    16		"strings"
    17	
    18		"github.com/relux-works/curator/internal/buildmeta"
    19	)
    20	
    21	const (
    22		// ReceiptFilename is deliberately Curator-local. It is not part of the
    23		// portable receipt schema or logical cache identity.
    24		ReceiptFilename = "curator-receipt.ccj.json"
    25		maxReceiptBytes = 1 << 20
    26	)
    27	
    28	// Status is the reusable-cache outcome. Every non-Hit value fails closed.
    29	type Status string
    30	
    31	// Reusable-cache outcomes. Only Hit permits reuse.
    32	const (
    33		Hit                 Status = "hit"
    34		Miss                Status = "miss"
    35		Corrupt             Status = "corrupt"
    36		UntrustedProvenance Status = "untrusted-provenance"
    37		Unsupported         Status = "unsupported"
    38	)
    39	
    40	// Expectation is the independently derived logical state required for reuse.
    41	// ReceiptHash may be empty during a cold cache lookup. Marker/currentness
    42	// callers set it to require an exact previously recorded receipt identity.
    43	type Expectation struct {
    44		Input       buildmeta.Input
    45		ReceiptHash buildmeta.ReceiptHash
    46	}
    47	
    48	// Result describes a read-only cache inspection. ArtifactPath is returned only
    49	// for a protected, exact Hit and is never executed by this package.
    50	type Result struct {
    51		Status       Status
    52		Reason       string
    53		Receipt      buildmeta.Receipt
    54		ReceiptBytes []byte
    55		ReceiptHash  buildmeta.ReceiptHash
    56		ArtifactPath string
    57	}
    58	
    59	// DryRunOutcome maps a read-only inspection to the stable planner vocabulary.
    60	// It performs no I/O and, in particular, never repairs untrusted state.
    61	func (result Result) DryRunOutcome() string {
    62		switch result.Status {
    63		case Hit:
    64			return "cache-hit"
    65		case Miss:
    66			return "would-preflight-and-build"
    67		case UntrustedProvenance:
    68			return "would-rebuild-untrusted-cache"
    69		case Corrupt:
    70			return "corrupt"
    71		default:
    72			return "unsupported"
    73		}
    74	}
    75	
    76	// Store addresses the Curator-local go-v1 cache below one manager home.
    77	type Store struct {
    78		home      string
    79		supported func() bool
    80	}
    81	
    82	// New constructs a store without creating or changing any filesystem state.
    83	func New(home string) (*Store, error) {
    84		if home == "" {
    85			return nil, fmt.Errorf("manager home is empty")
    86		}
    87		abs, err := filepath.Abs(home)
    88		if err != nil {
    89			return nil, fmt.Errorf("resolve manager home: %w", err)
    90		}
    91		if filepath.Clean(home) != home && filepath.IsAbs(home) {
    92			return nil, fmt.Errorf("manager home must be a clean absolute path")
    93		}
    94		return &Store{home: abs, supported: protectionSupported}, nil
    95	}
    96	
    97	// Home returns the clean absolute manager home used by this store.
    98	func (store *Store) Home() string { return store.home }
    99	
   100	// Inspect is strictly read-only. It validates the complete protected boundary,
   101	// exact canonical receipt, complete expected input, optional receipt hash, and
   102	// artifact path, bytes, size, and hash.
   103	func (store *Store) Inspect(expect Expectation) Result {
   104		if store == nil || store.supported == nil || !store.supported() {
   105			return Result{Status: Unsupported, Reason: "platform protection is unavailable"}
   106		}
   107		key, err := expect.Input.CacheKey()
   108		if err != nil {
   109			return Result{Status: Corrupt, Reason: "invalid expected input: " + err.Error()}
   110		}
   111		entryPath, _, err := store.paths(key)
   112		if err != nil {
   113			return Result{Status: Corrupt, Reason: err.Error()}
   114		}
   115		if _, err := os.Lstat(entryPath); err != nil {
   116			if errors.Is(err, os.ErrNotExist) {
   117				return Result{Status: Miss, Reason: "cache entry is absent"}
   118			}
   119			return Result{Status: UntrustedProvenance, Reason: "inspect cache boundary: " + err.Error()}
   120		}
   121	
   122		return store.inspectEntry(entryPath, expect, key)
   123	}
   124	
   125	func (store *Store) inspectEntry(entryPath string, expect Expectation, key buildmeta.CacheKey) Result {
   126		artifactRel, err := buildmeta.ArtifactPath(expect.Input.Command, expect.Input.Target.GOOS)
   127		if err != nil {
   128			return Result{Status: Corrupt, Reason: "derive artifact path: " + err.Error()}
   129		}
   130		opened, err := openProtectedEntry(store.home, entryPath, artifactRel)
   131		if err != nil {
   132			return openFailure(err)
   133		}
   134		defer opened.close()
   135		return classifyEntry(opened, artifactRel, entryPath, expect, key)
   136	}
   137	
   138	// inspectProvenEntry classifies the entry a maintenance sweep already resolved
   139	// and proved, using only the handles of that proof.
   140	//
   141	// Every decisive check — the exact entry members, the receipt bytes and their
   142	// identity, the artifact bytes and size — is read through the directory object
   143	// the sweep proved rather than by resolving the cache pathname a second time.
   144	// On Unix an open descriptor does not pin later pathname resolution, so a cache
   145	// root exchanged between the boundary proof and the classification would
   146	// otherwise let a planted replacement answer for the candidate that is about to
   147	// be removed: the sweep would validate one entry and retire another.
   148	func inspectProvenEntry(entry *protectedDir, entryPath string, expect Expectation, key buildmeta.CacheKey) Result {
   149		artifactRel, err := buildmeta.ArtifactPath(expect.Input.Command, expect.Input.Target.GOOS)
   150		if err != nil {
   151			return Result{Status: Corrupt, Reason: "derive artifact path: " + err.Error()}
   152		}
   153		opened, err := openProtectedEntryFrom(entry, artifactRel)
   154		if err != nil {
   155			return openFailure(err)
   156		}
   157		defer opened.close()
   158		return classifyEntry(opened, artifactRel, entryPath, expect, key)
   159	}
   160	
   161	func openFailure(err error) Result {
   162		status := Corrupt
   163		if errors.Is(err, errUntrusted) {
   164			status = UntrustedProvenance
   165		}
   166		return Result{Status: status, Reason: err.Error()}
   167	}
   168	
   169	// classifyEntry is the one read-only decision procedure both entry points
   170	// share. It reads exclusively through the handles it is given; entryPath only
   171	// names the result for a caller that wants to launch the artifact later.
   172	func classifyEntry(opened *openedEntry, artifactRel, entryPath string, expect Expectation, key buildmeta.CacheKey) Result {
   173		if err := exactEntryContents(opened, artifactRel); err != nil {
   174			return Result{Status: Corrupt, Reason: err.Error()}
   175		}
   176		receiptBytes, err := readExactFile(opened.receipt)
   177		if err != nil {
   178			return Result{Status: Corrupt, Reason: "read receipt: " + err.Error()}
   179		}
   180		receipt, err := buildmeta.DecodeExpectedReceipt(receiptBytes, expect.Input)
   181		if err != nil {
   182			return Result{Status: Corrupt, Reason: "invalid receipt: " + err.Error()}
   183		}
   184		if receipt.CacheKey != key {
   185			return Result{Status: Corrupt, Reason: "receipt cache key does not match entry key"}
   186		}
   187		receiptHash, err := buildmeta.HashReceiptBytes(receiptBytes)
   188		if err != nil {
   189			return Result{Status: Corrupt, Reason: "hash receipt: " + err.Error()}
   190		}
   191		if expect.ReceiptHash != "" && receiptHash != expect.ReceiptHash {
   192			return Result{Status: Corrupt, Reason: "receipt hash mismatch"}
   193		}
   194	
   195		artifactHash, artifactSize, err := hashOpenFile(opened.artifact)
   196		if err != nil {
   197			return Result{Status: Corrupt, Reason: "read artifact: " + err.Error()}
   198		}
   199		if artifactSize != receipt.Artifact.Size {
   200			return Result{Status: Corrupt, Reason: "artifact size mismatch"}
   201		}
   202		if artifactHash != receipt.Artifact.SHA256 {
   203			return Result{Status: Corrupt, Reason: "artifact hash mismatch"}
   204		}
   205		return Result{
   206			Status:       Hit,
   207			Receipt:      receipt,
   208			ReceiptBytes: append([]byte(nil), receiptBytes...),
   209			ReceiptHash:  receiptHash,
   210			ArtifactPath: filepath.Join(entryPath, filepath.FromSlash(artifactRel)),
   211		}
   212	}
   213	
   214	func (store *Store) paths(key buildmeta.CacheKey) (entry, base string, err error) {
   215		keyText := string(key)
   216		if !strings.HasPrefix(keyText, "sha256:") || len(keyText) != len("sha256:")+64 {
   217			return "", "", fmt.Errorf("cache key is malformed")
   218		}
   219		hexKey := strings.TrimPrefix(keyText, "sha256:")
   220		if _, err := hex.DecodeString(hexKey); err != nil || strings.ToLower(hexKey) != hexKey {
   221			return "", "", fmt.Errorf("cache key is malformed")
   222		}
   223		base = filepath.Join(store.home, "cache", "build", buildmeta.DriverGoV1)
   224		entry = filepath.Join(base, hexKey)
   225		if !pathWithin(store.home, base) || !pathWithin(base, entry) {
   226			return "", "", fmt.Errorf("cache path crosses the manager-home boundary")
   227		}
   228		return entry, base, nil
   229	}
   230	
   231	func pathWithin(root, path string) bool {
   232		rel, err := filepath.Rel(root, path)
   233		return err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && !filepath.IsAbs(rel)
   234	}
   235	
   236	type openedEntry struct {
   237		entryDir *os.File
   238		binDir   *os.File
   239		receipt  *os.File
   240		artifact *os.File
   241		extra    []io.Closer
   242		// borrowedEntryDir marks entryDir as owned by the caller. A maintenance
   243		// sweep classifies through the entry handle it already proved, and closing
   244		// that handle here would drop the very proof the caller still relies on for
   245		// the removal that follows.
   246		borrowedEntryDir bool
   247	}
   248	
   249	func (opened *openedEntry) close() {
   250		if opened == nil {
   251			return
   252		}
   253		closers := []io.Closer{opened.artifact, opened.receipt, opened.binDir}
   254		if !opened.borrowedEntryDir {
   255			closers = append(closers, opened.entryDir)
   256		}
   257		for _, closer := range closers {
   258			if !isNilCloser(closer) {
   259				_ = closer.Close()
   260			}
   261		}
   262		for i := len(opened.extra) - 1; i >= 0; i-- {
   263			if opened.extra[i] != nil {
   264				_ = opened.extra[i].Close()
   265			}
   266		}
   267	}
   268	
   269	func isNilCloser(closer io.Closer) bool {
   270		if closer == nil {
   271			return true
   272		}
   273		value := reflect.ValueOf(closer)
   274		return value.Kind() == reflect.Pointer && value.IsNil()
   275	}
   276	
   277	func exactEntryContents(opened *openedEntry, artifactRel string) error {
   278		entryNames, err := directoryNames(opened.entryDir)
   279		if err != nil {
   280			return fmt.Errorf("list cache entry: %w", err)
   281		}
   282		if len(entryNames) != 2 || entryNames[0] != "bin" || entryNames[1] != ReceiptFilename {
   283			return fmt.Errorf("cache entry has unexpected contents")
   284		}
   285		binNames, err := directoryNames(opened.binDir)
   286		if err != nil {
   287			return fmt.Errorf("list artifact directory: %w", err)
   288		}
   289		wantName := filepath.Base(filepath.FromSlash(artifactRel))
   290		if len(binNames) != 1 || binNames[0] != wantName {
   291			return fmt.Errorf("artifact directory has unexpected contents")
   292		}
   293		return nil
   294	}
   295	
   296	// artifactChildName validates that the derived artifact path names exactly one
   297	// direct child of the entry's bin directory, and returns that name.
   298	func artifactChildName(artifactRel string) (string, error) {
   299		parts := strings.Split(filepath.Clean(filepath.FromSlash(artifactRel)), string(filepath.Separator))
   300		if len(parts) != 2 || parts[0] != "bin" || parts[1] == "" || parts[1] == "." || parts[1] == ".." {
   301			return "", untrustedf("artifact path is not a direct bin child")
   302		}
   303		return parts[1], nil
   304	}
   305	
   306	func directoryNames(dir *os.File) ([]string, error) {
   307		if _, err := dir.Seek(0, io.SeekStart); err != nil {
   308			return nil, err
   309		}
   310		entries, err := dir.ReadDir(-1)
   311		if err != nil {
   312			return nil, err
   313		}
   314		names := make([]string, len(entries))
   315		for i, entry := range entries {
   316			names[i] = entry.Name()
   317		}
   318		sort.Strings(names)
   319		return names, nil
   320	}
   321	
   322	func readExactFile(file *os.File) ([]byte, error) {
   323		if _, err := file.Seek(0, io.SeekStart); err != nil {
   324			return nil, err
   325		}
   326		info, err := file.Stat()
   327		if err != nil {
   328			return nil, err
   329		}
   330		if info.Size() < 0 || info.Size() > maxReceiptBytes {
   331			return nil, fmt.Errorf("file size is outside the supported range")
   332		}
   333		payload, err := io.ReadAll(io.LimitReader(file, info.Size()+1))
   334		if err != nil {
   335			return nil, err
   336		}
   337		if int64(len(payload)) != info.Size() {
   338			return nil, fmt.Errorf("file changed while reading")
   339		}
   340		return payload, nil
   341	}
   342	
   343	func hashOpenFile(file *os.File) (string, int64, error) {
   344		if _, err := file.Seek(0, io.SeekStart); err != nil {
   345			return "", 0, err
   346		}
   347		hash := sha256.New()
   348		size, err := io.Copy(hash, file)
   349		if err != nil {
   350			return "", 0, err
   351		}
   352		return "sha256:" + hex.EncodeToString(hash.Sum(nil)), size, nil
   353	}
   354	
   355	var errUntrusted = errors.New("untrusted cache provenance")
   356	
   357	func untrustedf(format string, args ...any) error {
   358		return fmt.Errorf("%w: %s", errUntrusted, fmt.Sprintf(format, args...))
   359	}
     1	//go:build unix
     2	
     3	package buildcache
     4	
     5	import (
     6		"errors"
     7		"fmt"
     8		"io"
     9		"os"
    10		"path/filepath"
    11		"strings"
    12	
    13		"golang.org/x/sys/unix"
    14	)
    15	
    16	func protectionSupported() bool { return true }
    17	
    18	func openProtectedEntry(home, entryPath, artifactRel string) (*openedEntry, error) {
    19		rel, err := filepath.Rel(home, entryPath)
    20		if err != nil || rel == "." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
    21			return nil, untrustedf("cache entry crosses the manager-home boundary")
    22		}
    23		rootFD, err := unix.Open(home, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
    24		if err != nil {
    25			return nil, untrustedf("open manager home without following links: %v", err)
    26		}
    27		root := os.NewFile(uintptr(rootFD), home)
    28		if err := validateUnixDir(rootFD, "manager home"); err != nil {
    29			_ = root.Close()
    30			return nil, err
    31		}
    32	
    33		opened := &openedEntry{extra: []io.Closer{root}}
    34		currentFD := rootFD
    35		parts := strings.Split(rel, string(filepath.Separator))
    36		for index, part := range parts {
    37			if part == "" || part == "." || part == ".." {
    38				opened.close()
    39				return nil, untrustedf("cache entry contains an invalid path component")
    40			}
    41			fd, openErr := unix.Openat(currentFD, part, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
    42			if openErr != nil {
    43				opened.close()
    44				if errors.Is(openErr, unix.ENOENT) {
    45					return nil, fmt.Errorf("cache entry is incomplete: %w", openErr)
    46				}
    47				return nil, untrustedf("open cache directory %q without following links: %v", part, openErr)
    48			}
    49			if err := validateUnixDir(fd, part); err != nil {
    50				_ = unix.Close(fd)
    51				opened.close()
    52				return nil, err
    53			}
    54			file := os.NewFile(uintptr(fd), filepath.Join(home, filepath.Join(parts[:index+1]...)))
    55			if index == len(parts)-1 {
    56				opened.entryDir = file
    57			} else {
    58				opened.extra = append(opened.extra, file)
    59			}
    60			currentFD = fd
    61		}
    62	
    63		receipt, err := openUnixProtectedFile(currentFD, ReceiptFilename, false)
    64		if err != nil {
    65			opened.close()
    66			return nil, err
    67		}
    68		opened.receipt = receipt
    69	
    70		binFD, err := unix.Openat(currentFD, "bin", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
    71		if err != nil {
    72			opened.close()
    73			if errors.Is(err, unix.ENOENT) {
    74				return nil, fmt.Errorf("cache entry is incomplete: artifact directory is absent")
    75			}
    76			return nil, untrustedf("open artifact directory without following links: %v", err)
    77		}
    78		if err := validateUnixDir(binFD, "artifact directory"); err != nil {
    79			_ = unix.Close(binFD)
    80			opened.close()
    81			return nil, err
    82		}
    83		opened.binDir = os.NewFile(uintptr(binFD), filepath.Join(entryPath, "bin"))
    84	
    85		artifactName, err := artifactChildName(artifactRel)
    86		if err != nil {
    87			opened.close()
    88			return nil, err
    89		}
    90		artifact, err := openUnixProtectedFile(binFD, artifactName, true)
    91		if err != nil {
    92			opened.close()
    93			return nil, err
    94		}
    95		opened.artifact = artifact
    96		return opened, nil
    97	}
    98	
    99	// openProtectedEntryFrom opens the receipt, artifact directory, and artifact of
   100	// an already-proven cache entry relative to that entry's own descriptor.
   101	//
   102	// Nothing here resolves a pathname. Every child is opened with openat from the
   103	// directory the caller proved, without following a link, so an exchange of the
   104	// cache-root or entry pathname cannot substitute a different tree for the one
   105	// being classified. The entry descriptor stays owned by the caller.
   106	func openProtectedEntryFrom(entry *protectedDir, artifactRel string) (*openedEntry, error) {
   107		if entry == nil || entry.dir == nil {
   108			return nil, untrustedf("protected cache entry handle is missing")
   109		}
   110		entryFD := int(entry.dir.Fd())
   111		if err := validateUnixDir(entryFD, "cache entry"); err != nil {
   112			return nil, err
   113		}
   114		artifactName, err := artifactChildName(artifactRel)
   115		if err != nil {
   116			return nil, err
   117		}
   118	
   119		opened := &openedEntry{entryDir: entry.dir, borrowedEntryDir: true}
   120		receipt, err := openUnixProtectedFile(entryFD, ReceiptFilename, false)
   121		if err != nil {
   122			opened.close()
   123			return nil, err
   124		}
   125		opened.receipt = receipt
   126	
   127		binFD, err := unix.Openat(entryFD, "bin", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
   128		if err != nil {
   129			opened.close()
   130			if errors.Is(err, unix.ENOENT) {
   131				return nil, fmt.Errorf("cache entry is incomplete: artifact directory is absent")
   132			}
   133			return nil, untrustedf("open artifact directory without following links: %v", err)
   134		}
   135		if err := validateUnixDir(binFD, "artifact directory"); err != nil {
   136			_ = unix.Close(binFD)
   137			opened.close()
   138			return nil, err
   139		}
   140		opened.binDir = os.NewFile(uintptr(binFD), filepath.Join(entry.dir.Name(), "bin"))
   141	
   142		artifact, err := openUnixProtectedFile(binFD, artifactName, true)
   143		if err != nil {
   144			opened.close()
   145			return nil, err
   146		}
   147		opened.artifact = artifact
   148		return opened, nil
   149	}
   150	
   151	// openProtectedDir resolves dirPath below home without following a link at any
   152	// component and validates the type, owner, and permissions of each one. It is
   153	// the traversal boundary maintenance revalidates before reading the cache root
   154	// or classifying one entry, and it never creates or repairs anything.
   155	func openProtectedDir(home, dirPath string) (*protectedDir, error) {
   156		rel, err := filepath.Rel(home, dirPath)
   157		if err != nil || rel == "." || rel == ".." ||
   158			strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
   159			return nil, untrustedf("protected directory crosses the manager-home boundary")
   160		}
   161		rootFD, err := unix.Open(home, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
   162		if err != nil {
   163			if errors.Is(err, unix.ENOENT) {
   164				return nil, fmt.Errorf("open manager home: %w", os.ErrNotExist)
   165			}
   166			return nil, untrustedf("open manager home without following links: %v", err)
   167		}
   168		opened := &protectedDir{parents: []*os.File{os.NewFile(uintptr(rootFD), home)}}
   169		if err := validateUnixDir(rootFD, "manager home"); err != nil {
   170			opened.close()
   171			return nil, err
   172		}
   173		currentFD := rootFD
   174		parts := strings.Split(rel, string(filepath.Separator))
   175		for index, part := range parts {
   176			if part == "" || part == "." || part == ".." {
   177				opened.close()
   178				return nil, untrustedf("protected directory contains an invalid path component")
   179			}
   180			fd, openErr := unix.Openat(currentFD, part, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
   181			if openErr != nil {
   182				opened.close()
   183				if errors.Is(openErr, unix.ENOENT) {
   184					return nil, fmt.Errorf("open protected directory %q: %w", part, os.ErrNotExist)
   185				}
   186				return nil, untrustedf("open protected directory %q without following links: %v", part, openErr)
   187			}
   188			if err := validateUnixDir(fd, part); err != nil {
   189				_ = unix.Close(fd)
   190				opened.close()
   191				return nil, err
   192			}
   193			file := os.NewFile(uintptr(fd), filepath.Join(home, filepath.Join(parts[:index+1]...)))
   194			if index == len(parts)-1 {
   195				opened.dir = file
   196			} else {
   197				opened.parents = append(opened.parents, file)
   198			}
   199			currentFD = fd
   200		}
   201		return opened, nil
   202	}
