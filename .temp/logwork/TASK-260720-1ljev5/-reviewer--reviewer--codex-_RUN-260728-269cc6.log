    13	
    14	// CollectRuntime removes runtime store entries referenced by no marker of
    15	// any registered consumer, the global store, or the hybrid store, and prunes
    16	// consumer entries whose checkout disappeared or holds no markers
    17	// (Spec §8.7). Returns the removed runtime entries as skill/commit pairs.
    18	//
    19	// It collects the runtime store only. Collect is the locked maintenance entry
    20	// point that also sweeps the protected build cache.
    21	func CollectRuntime(home string) ([]string, error) {
    22		marked := markScopes(home)
    23		if err := pruneConsumers(home, marked); err != nil {
    24			return nil, err
    25		}
    26		return sweepRuntime(home, marked.runtime)
    27	}
    28	
    29	// HomeLock witnesses the caller-held manager-home mutation lock. Maintenance
    30	// never acquires it: install, rollback, recovery, and standalone `curator gc`
    31	// all serialize on the one lock their caller already holds, so a consumer
    32	// update can neither be lost nor be observed half-written.
    33	type HomeLock = buildcache.HomeLock
    34	
    35	// BuildCache is the protected immutable build-cache boundary a sweep uses.
    36	type BuildCache interface {
    37		Sweep(request buildcache.SweepRequest, lock buildcache.HomeLock) (buildcache.SweepResult, error)
    38	}
    39	
    40	// MaintenanceRequest is one serialized maintenance pass over a manager home.
    41	type MaintenanceRequest struct {
    42		Home string
    43		// Lock is the already-held manager-home mutation lock.
    44		Lock HomeLock
    45		// JournalKeys are the build keys named by every recoverable transaction
    46		// journal, so an in-flight installation keeps the artifacts it depends on.
    47		JournalKeys []string
    48		// Cache overrides the protected build cache; nil resolves the real store.
    49		Cache BuildCache
    50		// Now and Grace override the sweep clock and retention window. Their zero
    51		// values mean "now" and buildcache.DefaultGrace.
    52		Now   time.Time
    53		Grace time.Duration
    54	}
    55	
    56	// MaintenanceResult reports what one pass removed and what it could not prove.
    57	type MaintenanceResult struct {
    58		RemovedRuntime []string
    59		RemovedBuilds  []string
    60		Warnings       []string
    61	}
    62	
    63	// Collect runs one serialized maintenance pass: it marks every live reference
    64	// once, prunes provably dead consumers, sweeps the runtime store, and sweeps
    65	// the protected build cache.
    66	//
    67	// Marking reads every supported marker schema. Runtime entries are marked from
    68	// marker v1 and marker v2 alike, because a valid schema-1 installation stays
    69	// current; logical build keys come only from marker v2 entries that carry them
    70	// and from in-flight journals.
    71	//
    72	// Uncertainty fails safe, and it stays that way across passes. A consumer
    73	// registry, skill scope, or marker that exists but cannot be trusted leaves the
    74	// reference set unprovable, so the build cache is not swept at all. Crucially,
    75	// nothing that could still hold a reference is forgotten either: an unreadable
    76	// registry is never rewritten, and a consumer whose scope could not be proven
    77	// empty stays registered. A second pass therefore sees the same uncertainty and
    78	// refuses the same sweep, instead of inheriting a registry that was quietly
    79	// emptied by the first.
    80	func Collect(request MaintenanceRequest) (MaintenanceResult, error) {
    81		if request.Home == "" {
    82			return MaintenanceResult{}, fmt.Errorf("manager home is empty")
    83		}
    84		if err := requireHomeLock(request.Lock); err != nil {
    85			return MaintenanceResult{}, err
    86		}
    87		marked := markScopes(request.Home)
    88		result := MaintenanceResult{Warnings: marked.warnings()}
    89	
    90		// Consumer pruning stays inside this pass, under the caller's lock.
    91		if err := pruneConsumers(request.Home, marked); err != nil {
    92			return result, err
    93		}
    94		removedRuntime, err := sweepRuntime(request.Home, marked.runtime)
    95		result.RemovedRuntime = removedRuntime
    96		if err != nil {
    97			return result, err
    98		}
    99	
   100		if len(marked.uncertain) > 0 {
   101			result.Warnings = append(result.Warnings,
   102				"build cache sweep skipped: the live reference set could not be proven complete")
   103			return result, nil
   104		}
   105		cache := request.Cache
   106		if cache == nil {
   107			store, storeErr := buildcache.New(request.Home)
   108			if storeErr != nil {
   109				return result, fmt.Errorf("open the protected build cache: %w", storeErr)
   110			}
   111			cache = store
   112		}
   113		referenced := append(append([]string(nil), marked.builds...), request.JournalKeys...)
   114		sweep, err := cache.Sweep(buildcache.SweepRequest{
   115			Referenced: referenced,
   116			Now:        request.Now,
   117			Grace:      request.Grace,
   118		}, request.Lock)
   119		result.RemovedBuilds = sweep.Removed
   120		result.Warnings = append(result.Warnings, sweep.Warnings...)
   121		if err != nil {
   122			return result, fmt.Errorf("sweep the protected build cache: %w", err)
   123		}
   124		return result, nil
   125	}
