   127	// pruneConsumers rewrites the registry with the consumers one pass proved are
   128	// still worth keeping. A registry that could not be trusted is left exactly as
   129	// it is: overwriting it would destroy the only record of which checkouts may
   130	// still reference a build artifact.
   131	func pruneConsumers(home string, marked marks) error {
   132		if marked.registryUnknown {
   133			return nil
   134		}
   135		return ReplaceConsumers(home, marked.consumers)
   136	}
   137	
   138	func requireHomeLock(lock HomeLock) error {
   139		if lock == nil {
   140			return fmt.Errorf("caller-held manager-home lock is required")
   141		}
   142		if err := lock.AssertHeld(); err != nil {
   143			return fmt.Errorf("manager-home lock is not held: %w", err)
   144		}
   145		return nil
   146	}
