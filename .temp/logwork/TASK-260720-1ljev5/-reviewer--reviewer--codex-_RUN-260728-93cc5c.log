// retireEntry removes one direct child of the validated cache root. The rename
// is the atomic removal: after it no reader can reach the entry by its key, and
// both names are direct children of the same proven root, so a deletion cannot
// escape the Curator cache root even if the entry contains links.
func retireEntry(base, name string) error {
	if name == "" || name == "." || name == ".." ||
		strings.ContainsRune(name, '/') || strings.ContainsRune(name, filepath.Separator) {
		return fmt.Errorf("cache entry name is not a direct root child")
	}
	entryPath := filepath.Join(base, name)
	if filepath.Dir(entryPath) != filepath.Clean(base) || !pathWithin(base, entryPath) {
		return fmt.Errorf("cache entry escapes the protected cache root")
	}
	retiredPath, err := reserveName(base, sweepPrefix+name+"-")
	if err != nil {
		return err
	}
	if err := os.Rename(entryPath, retiredPath); err != nil {
		return fmt.Errorf("retire cache entry: %w", err)
	}
	if err := syncDirectory(base); err != nil {
		return fmt.Errorf("sync cache root: %w", err)
	}
	if err := os.RemoveAll(retiredPath); err != nil {
		// The entry is already unreachable by key. The leftover is named for
		// the next sweep to finish, so this is reported, not failed.
		return fmt.Errorf("remove retired cache entry %q: %w", filepath.Base(retiredPath), err)
	}
	return syncDirectory(base)
}

// reserveName claims one unused private name inside dir without leaving a
// placeholder behind.
func reserveName(dir, pattern string) (string, error) {
	placeholder, err := os.CreateTemp(dir, pattern)
	if err != nil {
		return "", fmt.Errorf("reserve a private cache name: %w", err)
	}
	path := placeholder.Name()
	if err := placeholder.Close(); err != nil {
		_ = os.Remove(path)
		return "", err
	}
	if err := os.Remove(path); err != nil {
		return "", err
	}
	return path, nil
}

// entryName maps a logical build key to its cache directory name.
func entryName(key string) (string, bool) {
	name, found := strings.CutPrefix(key, "sha256:")
	if !found || !entryNameRE.MatchString(name) {
		return "", false
	}
	return name, true
}

// protectedDir is a validated directory handle together with the parent handles
// that prove the path was resolved without following a link at any component.
type protectedDir struct {
	dir     *os.File
	parents []io.Closer
}

func (opened *protectedDir) close() {
	if opened == nil {
		return
	}
	if !isNilCloser(opened.dir) {
		_ = opened.dir.Close()
	}
	for index := len(opened.parents) - 1; index >= 0; index-- {
		if !isNilCloser(opened.parents[index]) {
			_ = opened.parents[index].Close()
		}
	}
}
