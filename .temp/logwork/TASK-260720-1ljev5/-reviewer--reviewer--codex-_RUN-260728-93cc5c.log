   139	// sweepUnreferenced classifies one unreferenced candidate and removes it only
   140	// when every safety property holds.
   141	func (store *Store) sweepUnreferenced(base, name string, now time.Time, grace time.Duration, result *SweepResult) {
   142		key := buildmeta.CacheKey("sha256:" + name)
   143		entryPath := filepath.Join(base, name)
   144		published, inspected, err := store.inspectUnexpected(entryPath, key)
   145		if err != nil {
   146			result.Warnings = append(result.Warnings, fmt.Sprintf(
   147				"build cache sweep: retained %s: %v", key, err))
   148			return
   149		}
   150		if inspected.Status != Hit {
   151			result.Warnings = append(result.Warnings, fmt.Sprintf(
   152				"build cache sweep: retained %s (%s): %s", key, inspected.Status, inspected.Reason))
   153			return
   154		}
   155		if published.After(now) {
   156			result.Warnings = append(result.Warnings, fmt.Sprintf(
   157				"build cache sweep: retained %s: its publication time %s is in the future; check the system clock",
   158				key, published.UTC().Format(time.RFC3339)))
   159			return
   160		}
   161		if now.Sub(published) <= grace {
