   172	// inspectUnexpected validates an entry whose logical input maintenance does not
   173	// know in advance, and reports when it was published.
   174	//
   175	// Provenance stays with the protected boundary. The receipt is read only to
   176	// name the input the entry claims; that input is then independently re-derived
   177	// into a cache key which must equal the directory name, and the full read-only
   178	// inspection re-checks the exact structure, receipt, artifact hash, and size.
   179	// A receipt that is merely internally consistent therefore proves nothing.
   180	func (store *Store) inspectUnexpected(entryPath string, key buildmeta.CacheKey) (time.Time, Result, error) {
   181		opened, err := openProtectedDir(store.home, entryPath)
   182		if err != nil {
