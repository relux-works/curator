   189			return time.Time{}, Result{}, fmt.Errorf("stat cache entry: %w", statErr)
   190		}
   191		if receiptErr != nil {
   192			return time.Time{}, Result{}, receiptErr
   193		}
   194		receipt, err := buildmeta.DecodeReceipt(receiptBytes)
