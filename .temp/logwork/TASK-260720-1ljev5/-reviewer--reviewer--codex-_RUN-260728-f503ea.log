   182	// inspectUnexpected validates an entry whose logical input maintenance does not
   183	// know in advance, and reports when it was published.
   184	//
   185	// Provenance stays with the protected boundary. The entry is re-resolved
   186	// without following a link at any component, its parent has to be the very
   187	// directory object this sweep proved, the receipt is read only to name the
   188	// input the entry claims, and that input is then independently re-derived into
   189	// a cache key which must equal the directory name. The full read-only
   190	// inspection re-checks the exact structure, receipt, artifact hash, and size,
   191	// so a receipt that is merely internally consistent proves nothing.
   192	func (store *Store) inspectUnexpected(root *sweepRoot, name string, key buildmeta.CacheKey) (time.Time, Result, error) {
   193		entryPath := filepath.Join(root.path, name)
   194		opened, err := openProtectedDir(store.home, entryPath)
   195		if err != nil {
   196			return time.Time{}, Result{}, err
   197		}
   198		defer opened.close()
   199		if err := root.assertParentOf(opened); err != nil {
   200			return time.Time{}, Result{}, err
   201		}
   202		info, err := opened.dir.Stat()
   203		if err != nil {
   204			return time.Time{}, Result{}, fmt.Errorf("stat cache entry: %w", err)
   205		}
   206		receiptBytes, err := readProtectedChild(opened.dir, ReceiptFilename)
   207		if err != nil {
   208			return time.Time{}, Result{}, err
   209		}
   210		receipt, err := buildmeta.DecodeReceipt(receiptBytes)
   211		if err != nil {
   212			return time.Time{}, Result{}, fmt.Errorf("invalid receipt: %w", err)
   213		}
   214		if receipt.CacheKey != key {
   215			return time.Time{}, Result{}, fmt.Errorf("receipt cache key does not match the entry key")
   216		}
   217		return info.ModTime(), store.inspectEntry(entryPath, Expectation{Input: receipt.Input}, key), nil
   218	}
   219	
   220	func readProtectedChild(dir *os.File, name string) ([]byte, error) {
   221		file, err := openProtectedChildFile(dir, name)
   222		if err != nil {
   223			return nil, err
   224		}
   225		defer func() { _ = file.Close() }()
   226		payload, err := readExactFile(file)
   227		if err != nil {
   228			return nil, fmt.Errorf("read %s: %w", name, err)
   229		}
   230		return payload, nil
   231	}
