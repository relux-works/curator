   233	// retireEntry removes one direct child of the proven cache root through the
   234	// mutator bound to that root. The rename is the atomic removal: afterwards no
   235	// reader can reach the entry by its key, and because both names are resolved
   115		if _, err := os.Lstat(entryPath); err != nil {
   116			if errors.Is(err, os.ErrNotExist) {
   117				return Result{Status: Miss, Reason: "cache entry is absent"}
   118			}
   119			return Result{Status: UntrustedProvenance, Reason: "inspect cache boundary: " + err.Error()}
   120		}
   121	
   122		return store.inspectEntry(entryPath, expect, key)
   123	}
   124	
   125	func (store *Store) inspectEntry(entryPath string, expect Expectation, key buildmeta.CacheKey) Result {
   126		artifactRel, err := buildmeta.ArtifactPath(expect.Input.Command, expect.Input.Target.GOOS)
   127		if err != nil {
   128			return Result{Status: Corrupt, Reason: "derive artifact path: " + err.Error()}
   129		}
   130		opened, err := openProtectedEntry(store.home, entryPath, artifactRel)
   131		if err != nil {
   132			status := Corrupt
   133			if errors.Is(err, errUntrusted) {
   134				status = UntrustedProvenance
   135			}
   136			return Result{Status: status, Reason: err.Error()}
   137		}
   138		defer opened.close()
   139	
   140		if err := exactEntryContents(opened, artifactRel); err != nil {
   141			return Result{Status: Corrupt, Reason: err.Error()}
   142		}
   143		receiptBytes, err := readExactFile(opened.receipt)
   144		if err != nil {
   145			return Result{Status: Corrupt, Reason: "read receipt: " + err.Error()}
   146		}
   147		receipt, err := buildmeta.DecodeExpectedReceipt(receiptBytes, expect.Input)
   148		if err != nil {
   149			return Result{Status: Corrupt, Reason: "invalid receipt: " + err.Error()}
   150		}
   151		if receipt.CacheKey != key {
   152			return Result{Status: Corrupt, Reason: "receipt cache key does not match entry key"}
   153		}
   154		receiptHash, err := buildmeta.HashReceiptBytes(receiptBytes)
   155		if err != nil {
   156			return Result{Status: Corrupt, Reason: "hash receipt: " + err.Error()}
   157		}
   158		if expect.ReceiptHash != "" && receiptHash != expect.ReceiptHash {
   159			return Result{Status: Corrupt, Reason: "receipt hash mismatch"}
   160		}
   161	
   162		artifactHash, artifactSize, err := hashOpenFile(opened.artifact)
   163		if err != nil {
   164			return Result{Status: Corrupt, Reason: "read artifact: " + err.Error()}
   165		}
   166		if artifactSize != receipt.Artifact.Size {
   167			return Result{Status: Corrupt, Reason: "artifact size mismatch"}
   168		}
   169		if artifactHash != receipt.Artifact.SHA256 {
   170			return Result{Status: Corrupt, Reason: "artifact hash mismatch"}
   171		}
   172		return Result{
   173			Status:       Hit,
   174			Receipt:      receipt,
   175			ReceiptBytes: append([]byte(nil), receiptBytes...),
   176			ReceiptHash:  receiptHash,
   177			ArtifactPath: filepath.Join(entryPath, filepath.FromSlash(artifactRel)),
   178		}
   179	}
