   479	// TestAQuarantineThatCannotPutTheEntryBackHandsItsCallerTheRecord covers the
   480	// last exit of the helper: the sync failed, the entry could not be returned to
   481	// the live slot either, and the only thing that keeps the move recoverable is
   482	// the quarantine path it reports alongside the error.
   483	//
   484	// The fixture takes the slot with an unremovable directory so the return rename
   485	// really fails, then Publish has to use the reported path to put the predecessor
   486	// back — which is the whole reason the path is returned with an error at all.
   487	func TestAQuarantineThatCannotPutTheEntryBackHandsItsCallerTheRecord(t *testing.T) {
   488		store := newTestStore(t)
   489		publication, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   490		key, err := publication.Input.CacheKey()
   491		if err != nil {
   492			t.Fatal(err)
   493		}
   494		corruptPredecessor(t, store, publication)
   495		before := entryFingerprint(t, store, key)
   496		entryPath, _, err := store.paths(key)
   497		if err != nil {
   498			t.Fatal(err)
   499		}
   500	
   501		// Fire once: the compensation quarantines this squatter and restores the
   502		// predecessor over it, and a second firing would only re-take the slot.
   503		fired := false
   504		store.faults = func(point faultPoint) error {
   505			if point != faultQuarantineSync || fired {
   506				return nil
   507			}
   508			fired = true
   509			if err := os.MkdirAll(filepath.Join(entryPath, "bin"), 0o700); err != nil {
   510				return err
   511			}
   512			return fmt.Errorf("injected quarantine sync failure")
   513		}
   514		replacement, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   515		result, publishErr := store.Publish(replacement, testHomeLock{})
   516		store.faults = nil
   517	
   518		if publishErr == nil {
   519			t.Fatalf("a publication whose quarantine could not be undone succeeded: %+v", result)
   520		}
   521		if !fired {
   522			t.Fatal("the interior quarantine fault never ran, so the case proves nothing")
   523		}
   524		if StateChanged(publishErr) {
   525			t.Fatalf("a publication that put the cache back reported a changed cache: %v", publishErr)
   526		}
   527		if live := store.Inspect(Expectation{Input: publication.Input}); live.Status != Corrupt {
   528			t.Fatalf("live verdict = %s, want the corrupt predecessor restored", live.Status)
   529		}
   530		if after := entryFingerprint(t, store, key); after != before {
   531			t.Fatalf("a failed publication changed the live entry\nbefore:\n%s\nafter:\n%s", before, after)
   532		}
   533	}
