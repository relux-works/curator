   535	// TestAPublicationThatCannotRestoreReportsAChangedCache covers the one case the
   536	// compensation cannot fix: a fault inside the compensation itself.
   537	//
   538	// Silence here would be the worst outcome of all, because the caller would read
   539	// an ordinary failure and go on telling the operator the live build cache is
   540	// unchanged. Each case asserts the error says otherwise, and asserts exactly
   541	// which entry is live — a usable one in every case, never an empty slot a live
   542	// launcher would resolve to nothing.
   543	func TestAPublicationThatCannotRestoreReportsAChangedCache(t *testing.T) {
   544		for name, testCase := range map[string]struct {
   545			at []faultPoint
   546			// wantLive is the verdict left behind. Hit means the replacement this
   547			// publication selected is still what the slot holds; Corrupt means the
   548			// predecessor was restored but the restoration is not durable.
   549			wantLive Status
   550		}{
   551			"the withdrawal of the replacement fails": {
   552				at: []faultPoint{faultValidate, faultWithdraw}, wantLive: Hit,
   553			},
   554			"the predecessor cannot be put back": {
   555				at: []faultPoint{faultValidate, faultRestore}, wantLive: Hit,
   556			},
   557			"the restoration cannot be synced": {
   558				at: []faultPoint{faultValidate, faultRestoreSync}, wantLive: Corrupt,
   559			},
   560		} {
   561			t.Run(name, func(t *testing.T) {
   562				store := newTestStore(t)
   563				publication, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   564				key, err := publication.Input.CacheKey()
   565				if err != nil {
   566					t.Fatal(err)
   567				}
   568				corruptPredecessor(t, store, publication)
   569	
   570				replacement, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   571				store.faults = failAt(testCase.at...)
   572				_, publishErr := store.Publish(replacement, testHomeLock{})
   573				store.faults = nil
   574	
   575				if publishErr == nil {
   576					t.Fatal("a publication faulted through its own compensation succeeded")
   577				}
   578				if !StateChanged(publishErr) {
   579					t.Fatalf("a publication that could not restore did not say so: %v", publishErr)
   580				}
   581				if live := store.Inspect(Expectation{Input: publication.Input}); live.Status != testCase.wantLive {
   582					t.Fatalf("live verdict = %s, want %s", live.Status, testCase.wantLive)
   583				}
   584				// A slot a launcher already points at must never be left empty, so the
   585				// compensation returns the entry it withdrew when it cannot do better.
   586				if entryFingerprint(t, store, key) == "absent" {
   587					t.Fatal("a failed compensation left the live slot empty")
   588				}
   589			})
   590		}
   591	}
