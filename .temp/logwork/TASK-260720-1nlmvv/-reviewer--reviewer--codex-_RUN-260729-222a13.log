    17	// failAt hooks the named mutation boundaries. Every listed point fails, every
    18	// other one runs for real, so a case exercises the production path right up to
    19	// the exact step it is about.
    20	func failAt(points ...faultPoint) func(faultPoint) error {
    21		selected := map[faultPoint]bool{}
    22		for _, point := range points {
    23			selected[point] = true
    24		}
    25		return func(point faultPoint) error {
