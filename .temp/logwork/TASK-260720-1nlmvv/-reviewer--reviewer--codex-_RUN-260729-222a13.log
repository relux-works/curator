    97			// A cold cache has no root yet, which is the same thing as an empty one.
    98			return 0, 0, 0
    99		}
   100		if err != nil {
   101			t.Fatal(err)
   102		}
   103		for _, entry := range entries {
   104			switch {
   105			case strings.HasPrefix(entry.Name(), ".quarantine-"):
   106				quarantined++
   107			case strings.HasPrefix(entry.Name(), ".stage-"):
   108				staged++
   109			default:
   110				live++
   111			}
   112		}
   113		return live, quarantined, staged
   114	}
