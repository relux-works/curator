   608		result := e.install(Options{Build: deps, Commit: CommitDeps{
   609			Journal:     &stubJournal{commitErr: fmt.Errorf("injected commit failure")},
   610			MaxRestarts: 1,
   611		}})
   612		if result.Status != "failed" {
   613			t.Fatalf("install status = %q, want failed: %+v", result.Status, result)
   614		}
   615		// The case only proves anything if the run really did publish and then try
   616		// to put the cache back.
   617		if len(builder.calls) != 1 || len(cache.published) != 1 {
   618			t.Fatalf("the run did not rebuild and publish before failing: built %v published %v",
   619				builder.calls, cache.published)
