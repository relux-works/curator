   593	// TestAFailedReversalIsFailClosedAndReportsAChangedCache is the mirror image
   594	// for the caller-driven half.
   595	//
   596	// Reversal withdraws the published winner and renames the predecessor back, and
   597	// a fault between those two renames would otherwise leave the slot empty while
   598	// a perfectly usable entry sat in quarantine — strictly worse than either end
   599	// state. Every failing path reports a changed cache, because every one of them
   600	// leaves the cache holding something other than what the run found.
   601	func TestAFailedReversalIsFailClosedAndReportsAChangedCache(t *testing.T) {
   602		for name, testCase := range map[string]struct {
   603			at faultPoint
   604			// wantLive is the verdict left behind, and wantBytes the artifact bytes
   605			// that go with it.
   606			wantLive  Status
   607			wantBytes string
   608		}{
   609			"the withdrawal fails": {at: faultWithdraw, wantLive: Hit, wantBytes: "artifact"},
   610			"the predecessor cannot be put back": {
   611				at: faultRestore, wantLive: Hit, wantBytes: "artifact",
   612			},
   613			"the restoration cannot be synced": {
   614				at: faultRestoreSync, wantLive: Corrupt, wantBytes: "corrupt predecessor bytes",
   615			},
   616		} {
   617			t.Run(name, func(t *testing.T) {
   618				store := newTestStore(t)
   619				publication, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   620				key, err := publication.Input.CacheKey()
   621				if err != nil {
   622					t.Fatal(err)
   623				}
   624				corruptPredecessor(t, store, publication)
   625	
   626				replacement, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   627				replaced, err := store.Publish(replacement, testHomeLock{})
   628				if err != nil {
   629					t.Fatal(err)
   630				}
   631				if replaced.Status != Published || replaced.Quarantined == "" {
   632					t.Fatalf("publication = %+v, want a published winner reporting its quarantine", replaced)
   633				}
   634	
   635				store.faults = failAt(testCase.at)
   636				revertErr := store.Revert(key, replaced, testHomeLock{})
   637				store.faults = nil
   638				if revertErr == nil {
   639					t.Fatalf("a reversal faulted at %s succeeded", testCase.at)
   640				}
   641				if !StateChanged(revertErr) {
   642					t.Fatalf("a reversal that did not complete did not report a changed cache: %v", revertErr)
   643				}
   644	
   645				live := store.Inspect(Expectation{Input: publication.Input})
   646				if live.Status != testCase.wantLive {
   647					t.Fatalf("live verdict = %s, want %s", live.Status, testCase.wantLive)
   648				}
   649				entryPath, _, err := store.paths(key)
   650				if err != nil {
   651					t.Fatal(err)
   652				}
   653				relative, err := buildmeta.ArtifactPath(publication.Input.Command, publication.Input.Target.GOOS)
   654				if err != nil {
   655					t.Fatal(err)
   656				}
   657				artifact := filepath.Join(entryPath, filepath.FromSlash(relative))
   658				if got := readFile(t, artifact); got != testCase.wantBytes {
   659					t.Fatalf("live artifact = %q, want %q", got, testCase.wantBytes)
   660				}
   661			})
   662		}
   663	}
   664	
   665	// TestAFailedReversalReturnsTheWinnerMovedBeforeWithdrawError pins the mirror
   666	// interior failure. restoreDisplaced asks quarantinePath to withdraw the
   667	// published winner. If the rename succeeds and the following parent sync
   668	// fails, quarantinePath returns no moved path, so the reversal must still put
   669	// the winner back or return a complete recovery record. Leaving the slot empty
   670	// is not fail-closed for launchers that already resolve through it.
   671	func TestAFailedReversalReturnsTheWinnerMovedBeforeWithdrawError(t *testing.T) {
   672		store := newTestStore(t)
   673		publication, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   674		key, err := publication.Input.CacheKey()
   675		if err != nil {
   676			t.Fatal(err)
   677		}
   678		corruptPredecessor(t, store, publication)
   679		replacement, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   680		replaced, err := store.Publish(replacement, testHomeLock{})
   681		if err != nil {
   682			t.Fatal(err)
   683		}
   684		if replaced.Status != Published || replaced.Quarantined == "" {
   685			t.Fatalf("publication = %+v, want a published winner reporting its quarantine", replaced)
   686		}
   687		before := entryFingerprint(t, store, key)
   688		entryPath, _, err := store.paths(key)
   689		if err != nil {
   690			t.Fatal(err)
   691		}
   692	
   693		store.faults = func(point faultPoint) error {
   694			if point != faultWithdraw {
   695				return nil
   696			}
   697			moved, moveErr := store.quarantinePath(entryPath, testHomeLock{})
   698			if moveErr != nil {
   699				return moveErr
   700			}
   701			if moved == "" {
   702				return fmt.Errorf("the post-mutation withdrawal fixture moved nothing")
   703			}
   704			return fmt.Errorf("injected sync quarantined cache root failure")
   705		}
   706		revertErr := store.Revert(key, replaced, testHomeLock{})
   707		store.faults = nil
   708	
   709		if revertErr == nil {
   710			t.Fatal("a withdrawal that failed after moving the winner succeeded")
   711		}
   712		if !StateChanged(revertErr) {
   713			t.Fatalf("a reversal that did not restore the winner did not report changed state: %v", revertErr)
   714		}
   715		if live := store.Inspect(Expectation{Input: publication.Input}); live.Status != Hit {
   716			t.Fatalf("live verdict = %s, want the published winner returned", live.Status)
   717		}
   718		if after := entryFingerprint(t, store, key); after != before {
   719			t.Fatalf("a withdrawal error changed the live entry\nbefore:\n%s\nafter:\n%s", before, after)
   720		}
   721	}
   722	
   723	// TestAQuarantineReportsChangedStateOnlyWhenItsRollbackIsNotDurable pins the
   724	// discrimination the typed failure is worth anything for.
   725	//
   726	// A quarantine that puts the entry back and syncs it has compensated its own
   727	// mutation completely, and an untyped error is the guarantee the caller reads
   728	// off that. Typing every failed quarantine as changed state would satisfy the
   729	// changed-state case above while telling the install layer to retain the cache
   730	// after a rollback that fully succeeded — so the two outcomes are asserted
   731	// against each other, on the same production path, in the same shape.
   732	func TestAQuarantineReportsChangedStateOnlyWhenItsRollbackIsNotDurable(t *testing.T) {
   733		for name, testCase := range map[string]struct {
   734			faults      []faultPoint
   735			wantChanged bool
   736		}{
   737			"a durable rollback owes the caller nothing": {
   738				faults:      []faultPoint{faultQuarantineSync},
   739				wantChanged: false,
   740			},
   741			"a rollback that is not durable reports changed state": {
   742				faults:      []faultPoint{faultQuarantineSync, faultQuarantineRollbackSync},
   743				wantChanged: true,
   744			},
   745		} {
   746			t.Run(name, func(t *testing.T) {
   747				store := newTestStore(t)
   748				publication, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   749				key, err := publication.Input.CacheKey()
   750				if err != nil {
   751					t.Fatal(err)
   752				}
   753				if _, err := store.Publish(publication, testHomeLock{}); err != nil {
   754					t.Fatal(err)
   755				}
   756				before := entryFingerprint(t, store, key)
   757	
   758				store.faults = failAt(testCase.faults...)
   759				moved, quarantineErr := store.Quarantine(key, testHomeLock{})
   760				store.faults = nil
   761	
   762				if quarantineErr == nil {
   763					t.Fatalf("a quarantine whose sync failed succeeded: %q", moved)
   764				}
   765				// The path stays empty in both outcomes: the caller owns nothing
   766				// either way, because the entry is back in the live slot.
   767				if moved != "" {
   768					t.Fatalf("a quarantine that put the entry back reported it as moved to %q", moved)
   769				}
   770				if StateChanged(quarantineErr) != testCase.wantChanged {
   771					t.Fatalf("StateChanged = %v, want %v: %v",
   772						StateChanged(quarantineErr), testCase.wantChanged, quarantineErr)
   773				}
   774				if testCase.wantChanged {
   775					var changed *StateChangedError
   776					if !errors.As(quarantineErr, &changed) {
   777						t.Fatal("a changed-state quarantine did not carry a *StateChangedError")
   778					}
   779					if changed.Key != key {
   780						t.Fatalf("changed state reported key %s, want %s", changed.Key, key)
   781					}
   782				}
   783				// The bytes are live and unchanged on both paths. Only the promise
   784				// about them differs, which is the whole point of the typing.
   785				if live := store.Inspect(Expectation{Input: publication.Input}); live.Status != Hit {
   786					t.Fatalf("live verdict = %s, want the entry put back", live.Status)
   787				}
   788				if after := entryFingerprint(t, store, key); after != before {
   789					t.Fatalf("a failed quarantine changed the live entry\nbefore:\n%s\nafter:\n%s", before, after)
   790				}
   791				live, quarantined, staged := cacheRootMembers(t, store, key)
   792				if live != 1 || quarantined != 0 {
