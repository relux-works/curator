   288	// TestAQuarantineThatCannotBeMadeDurablePutsTheEntryBack covers the production
   289	// helper's own interior window: quarantinePath renames the live entry aside and
   290	// then syncs the cache root, and only that sync can fail with the slot already
   291	// empty.
   292	//
   293	// This is the boundary the two seam-driven cases above model, exercised here on
   294	// the real helper. Every caller of it reads the same guarantee — an error with
   295	// no reported path means the slot is untouched — so the case asserts both halves
   296	// of that claim rather than only the surviving bytes.
   297	func TestAQuarantineThatCannotBeMadeDurablePutsTheEntryBack(t *testing.T) {
   298		store := newTestStore(t)
   299		publication, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   300		key, err := publication.Input.CacheKey()
   301		if err != nil {
   302			t.Fatal(err)
   303		}
   304		if _, err := store.Publish(publication, testHomeLock{}); err != nil {
   305			t.Fatal(err)
   306		}
   307		before := entryFingerprint(t, store, key)
   308	
   309		store.faults = failAt(faultQuarantineSync)
   310		moved, quarantineErr := store.Quarantine(key, testHomeLock{})
   311		store.faults = nil
   312	
   313		if quarantineErr == nil {
   314			t.Fatalf("a quarantine whose sync failed succeeded: %q", moved)
   315		}
   316		if moved != "" {
   317			t.Fatalf("a quarantine that put the entry back reported it as moved to %q", moved)
   318		}
   319		if live := store.Inspect(Expectation{Input: publication.Input}); live.Status != Hit {
   320			t.Fatalf("live verdict = %s, want the entry put back", live.Status)
   321		}
   322		if after := entryFingerprint(t, store, key); after != before {
   323			t.Fatalf("a failed quarantine changed the live entry\nbefore:\n%s\nafter:\n%s", before, after)
   324		}
   325	}
