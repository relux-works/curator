    33	// entryFingerprint digests the live protected entry of one key exactly as it
    34	// is: every member, its mode, and its bytes. A slot with no entry is a distinct
    35	// value rather than an error, because "nothing is live" is one of the states a
    36	// compensation has to be able to restore.
    37	func entryFingerprint(t *testing.T, store *Store, key buildmeta.CacheKey) string {
    38		t.Helper()
    39		entryPath, _, err := store.paths(key)
    40		if err != nil {
    41			t.Fatal(err)
    42		}
    43		if _, err := os.Lstat(entryPath); err != nil {
    44			if os.IsNotExist(err) {
    45				return "absent"
    46			}
    47			t.Fatal(err)
    48		}
    49		var records []string
    50		walkErr := filepath.WalkDir(entryPath, func(path string, _ os.DirEntry, walkErr error) error {
    51			if walkErr != nil {
    52				return walkErr
    53			}
    54			rel, err := filepath.Rel(entryPath, path)
    55			if err != nil {
    56				return err
    57			}
    58			info, err := os.Lstat(path)
    59			if err != nil {
    60				return err
    61			}
    62			record := fmt.Sprintf("%s:%s:%d", filepath.ToSlash(rel), info.Mode().String(), info.Size())
    63			if info.Mode().IsRegular() {
    64				payload, err := os.ReadFile(path) // #nosec G304 -- test fixture tree
    65				if err != nil {
    66					return err
    67				}
    68				digest := sha256.Sum256(payload)
    69				record += ":" + hex.EncodeToString(digest[:])
    70			}
    71			records = append(records, record)
    72			return nil
    73		})
    74		if walkErr != nil {
    75			t.Fatal(walkErr)
    76		}
    77		sort.Strings(records)
    78		return strings.Join(records, "\n")
    79	}
