   327	// TestAQuarantineRollbackThatCannotBeMadeDurableReportsChangedState covers the
   328	// second durability boundary in a failed quarantine. Returning the entry to
   329	// the live pathname repairs the visible namespace, but that compensating rename
   330	// must itself be synced before Publish can promise that the cache is unchanged.
   331	//
   332	// If the compensating sync also fails, the predecessor bytes remain recoverable
   333	// and live, while the error must truthfully report uncertain/changed durable
   334	// state so install can set BuildCacheRetained instead of claiming a clean
   335	// rollback.
   336	func TestAQuarantineRollbackThatCannotBeMadeDurableReportsChangedState(t *testing.T) {
   337		store := newTestStore(t)
   338		publication, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   339		key, err := publication.Input.CacheKey()
   340		if err != nil {
   341			t.Fatal(err)
   342		}
   343		corruptPredecessor(t, store, publication)
   344		before := entryFingerprint(t, store, key)
   345	
   346		initialSyncFaulted := false
   347		rollbackSyncFaulted := false
   348		store.faults = func(point faultPoint) error {
   349			switch point {
   350			case faultQuarantineSync:
   351				initialSyncFaulted = true
   352				return fmt.Errorf("injected quarantine sync failure")
   353			case faultPoint("quarantine-rollback-sync"):
   354				rollbackSyncFaulted = true
   355				return fmt.Errorf("injected quarantine rollback sync failure")
   356			default:
   357				return nil
   358			}
   359		}
   360		replacement, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   361		result, publishErr := store.Publish(replacement, testHomeLock{})
   362		store.faults = nil
   363	
   364		if publishErr == nil {
   365			t.Fatalf("a quarantine with two failed durability boundaries succeeded: %+v", result)
   366		}
   367		if !initialSyncFaulted {
   368			t.Fatal("the initial post-rename sync fault never ran")
   369		}
   370		if !rollbackSyncFaulted {
   371			t.Fatal("the compensating rename was not followed by a faultable durability sync")
   372		}
   373		if !StateChanged(publishErr) {
   374			t.Fatalf("a failed compensating sync did not report changed durable state: %v", publishErr)
   375		}
   376		if result != (PublicationResult{}) {
   377			t.Fatalf("a failed publication returned a usable result: %+v", result)
   378		}
   379		if live := store.Inspect(Expectation{Input: publication.Input}); live.Status != Corrupt {
   380			t.Fatalf("live verdict = %s, want the recoverable corrupt predecessor", live.Status)
   381		}
   382		if after := entryFingerprint(t, store, key); after != before {
   383			t.Fatalf("a failed compensating sync changed the live entry\nbefore:\n%s\nafter:\n%s", before, after)
   384		}
   385		live, _, staged := cacheRootMembers(t, store, key)
   386		if live != 1 {
   387			t.Fatalf("live cache entries = %d, want one recoverable predecessor", live)
   388		}
   389		if staged != 0 {
   390			t.Fatalf("a failed publication left %d private staging directories in the shared root", staged)
   391		}
   392	}
