   119	// failBuild records a failure of the build phase.
   120	//
   121	// Everything the planning and staging phases can fail on carries untrusted or
   122	// manager-private detail: cache reasons and receipt bytes are filesystem
   123	// controlled, compiler and driver text is toolchain controlled, and probe,
   124	// staging, and cache locations are operation-private. The rendered message
   125	// therefore goes through the one bounded, path-redacted rendering before it
   126	// reaches an operator or a machine-readable field. The stable boundary code is
   127	// carried separately in BuildDiagnostic and is never redacted.
   128	func (r *Result) failBuild(err error) {
   129		r.Status = "failed"
   130		r.Errors = append(r.Errors, RedactDiagnostic(err.Error()))
   131	}
