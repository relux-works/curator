   394	// TestADurabilityFaultInsideAQuarantineIsCompensatedByItsCaller runs the same
   395	// interior fault underneath a publication and a reversal, on the production
   396	// path, with no seam standing in for the rename.
   397	//
   398	// The two paths answer it differently on purpose. A publication that never
   399	// records a displaced predecessor has nothing to unwind and leaves the entry
   400	// the helper put back; a reversal reports a changed cache whatever happens,
   401	// because the entry this run published is still live and a caller reading an
   402	// ordinary failure would go on claiming otherwise.
   403	func TestADurabilityFaultInsideAQuarantineIsCompensatedByItsCaller(t *testing.T) {
   404		for name, testCase := range map[string]struct {
   405			// revert runs the fault under Revert instead of under Publish.
   406			revert       bool
   407			wantLive     Status
   408			wantChanged  bool
   409			wantArtifact string
   410		}{
   411			"a publication cannot quarantine its predecessor durably": {
   412				wantLive: Corrupt, wantArtifact: "corrupt predecessor bytes",
   413			},
   414			"a reversal cannot withdraw its winner durably": {
   415				revert: true, wantLive: Hit, wantChanged: true, wantArtifact: "artifact",
   416			},
   417		} {
   418			t.Run(name, func(t *testing.T) {
   419				store := newTestStore(t)
   420				publication, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   421				key, err := publication.Input.CacheKey()
   422				if err != nil {
   423					t.Fatal(err)
   424				}
   425				corruptPredecessor(t, store, publication)
   426	
   427				replacement, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
   428				var published PublicationResult
   429				if testCase.revert {
   430					if published, err = store.Publish(replacement, testHomeLock{}); err != nil {
   431						t.Fatal(err)
   432					}
   433					if published.Status != Published || published.Quarantined == "" {
   434						t.Fatalf("publication = %+v, want a published winner reporting its quarantine", published)
   435					}
   436				}
   437				before := entryFingerprint(t, store, key)
   438	
   439				store.faults = failAt(faultQuarantineSync)
   440				var faultErr error
   441				if testCase.revert {
   442					faultErr = store.Revert(key, published, testHomeLock{})
   443				} else {
   444					_, faultErr = store.Publish(replacement, testHomeLock{})
   445				}
   446				store.faults = nil
   447	
   448				if faultErr == nil {
   449					t.Fatal("an operation whose quarantine could not be made durable succeeded")
   450				}
   451				if StateChanged(faultErr) != testCase.wantChanged {
   452					t.Fatalf("changed-cache report = %t, want %t: %v",
   453						StateChanged(faultErr), testCase.wantChanged, faultErr)
   454				}
   455				if live := store.Inspect(Expectation{Input: publication.Input}); live.Status != testCase.wantLive {
   456					t.Fatalf("live verdict = %s, want %s", live.Status, testCase.wantLive)
   457				}
   458				if after := entryFingerprint(t, store, key); after != before {
   459					t.Fatalf("a failed quarantine changed the live entry\nbefore:\n%s\nafter:\n%s", before, after)
   460				}
   461				entryPath, _, err := store.paths(key)
   462				if err != nil {
   463					t.Fatal(err)
   464				}
   465				relative, err := buildmeta.ArtifactPath(publication.Input.Command, publication.Input.Target.GOOS)
   466				if err != nil {
   467					t.Fatal(err)
   468				}
   469				if got := readFile(t, filepath.Join(entryPath, filepath.FromSlash(relative))); got != testCase.wantArtifact {
   470					t.Fatalf("live artifact = %q, want %q", got, testCase.wantArtifact)
   471				}
   472				if _, _, staged := cacheRootMembers(t, store, key); staged != 0 {
   473					t.Fatalf("a failed operation left %d private staging directories in the shared root", staged)
   474				}
   475			})
   476		}
   477	}
