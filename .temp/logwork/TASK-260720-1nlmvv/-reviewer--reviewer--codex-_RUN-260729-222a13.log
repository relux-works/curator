    14	// CollectRuntime removes runtime store entries referenced by no marker of
    15	// any registered consumer, the global store, or the hybrid store, and prunes
    16	// consumer entries whose checkout disappeared or holds no markers
    17	// (Spec §8.7). Returns the removed runtime entries as skill/commit pairs.
    18	//
    19	// It collects the runtime store only. Collect is the locked maintenance entry
    20	// point that also sweeps the protected build cache.
    21	func CollectRuntime(home string) ([]string, error) {
    22		marked := markScopes(home)
    23		if err := pruneConsumers(home, marked); err != nil {
    24			return nil, err
    25		}
    26		return sweepRuntime(home, marked.runtime)
    27	}
