                    raise BuildCacheError(
                        "cache_publication_invalid",
                        "publication artifact grew while staging",
                    )
                os.fsync(artifact_fd)
                os.fchmod(artifact_fd, _ARTIFACT_MODE)
                os.fsync(artifact_fd)
