    ) as quarantine_fd:
        _require_guard(guard)
        with _open_or_create_private_directory(
            home_fd,
            LIVE_ROOT_NAME,
            replacement_parent_fd=quarantine_fd,
            replacement_prefix="boundary-builds",
        ) as builds_fd:
