+        "effective_uid",
+        "home_group_writable",
+        "manager_home_symlink",
+        "builds_symlink",
+        "entry_symlink",
+        "entry_owner_writable",
+        "receipt_owner_writable",
+        "artifact_not_executable",
+        "receipt_hard_link",
