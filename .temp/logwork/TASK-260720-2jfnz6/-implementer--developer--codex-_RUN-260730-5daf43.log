+from dataclasses import replace
+from pathlib import Path
+from typing import cast
+
+import pytest
+
+from csk import protocol_json
+from csk.builds.cache import (
+    BuildCacheBackend,
+    BuildCacheError,
+    CacheConflictError,
+    CacheEntryStatus,
+    CacheExpectation,
+    CacheMutationGuard,
+    CachePublication,
