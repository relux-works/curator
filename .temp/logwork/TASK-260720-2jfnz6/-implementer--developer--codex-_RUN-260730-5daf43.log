+def test_publication_requires_guard_and_invalid_inputs_leave_no_cache_state(
+    tmp_path: Path,
+) -> None:
+    home, store = _new_store(tmp_path)
+    build_input = _build_input()
+    publication, _ = _publication(tmp_path, build_input, b"artifact")
+
+    for guard in (
