+    assert dry_run.dry_run_outcome == "would-rebuild-untrusted-cache"
+    assert _tree_state(home) == before
+
+    rebuilt = store.publish(publication, guard=_HeldGuard())
+    assert rebuilt.status is CachePublicationStatus.PUBLISHED
+    hit = store.inspect(
