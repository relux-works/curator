                source,
                destination_dir_fd,
                destination,
                _RENAME_EXCL_DARWIN,
            )
        elif sys.platform.startswith("linux"):
            rename = library.renameat2
            rename.argtypes = [
                ctypes.c_int,
                ctypes.c_char_p,
                ctypes.c_int,
                ctypes.c_char_p,
