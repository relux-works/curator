+    elif case == "missing_receipt":
+        entry.chmod(0o700)
+        receipt.unlink()
+        entry.chmod(0o500)
+    elif case == "unexpected_entry":
+        entry.chmod(0o700)
+        _write_immutable(entry / "unexpected", b"x", 0o400)
+        entry.chmod(0o500)
+    elif case == "recorded_receipt_hash":
