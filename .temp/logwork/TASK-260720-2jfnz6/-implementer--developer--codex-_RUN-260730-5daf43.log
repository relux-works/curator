+def _build_input(command: str = "golden-tool") -> GoBuildInput:
+    goos, goarch, tuning = _go_target()
+    return GoBuildInput(
+        build_source=BuildSourceIdentity(
+            algorithm="curator-build-source-v1",
+            content_sha256="sha256:" + "b" * 64,
+        ),
+        build_root="build",
+        command=command,
