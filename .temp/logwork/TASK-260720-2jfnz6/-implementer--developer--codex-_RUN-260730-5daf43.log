+                                    os.fsync(staging_fd)
+                                    published = _inspect_entry_at(
+                                        driver_fd,
+                                        _key_component(key),
+                                        CacheExpectation(
+                                            input=publication.input,
+                                            receipt_sha256=receipt_hash,
+                                        ),
+                                        key,
+                                        artifact_name,
+                                    )
+                                    if (
+                                        published.receipt_bytes
