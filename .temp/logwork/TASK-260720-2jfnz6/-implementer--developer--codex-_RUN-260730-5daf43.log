+        entry.chmod(0o700)
+        bin_dir.chmod(0o700)
+        bin_dir.rename(moved)
+        bin_dir.symlink_to(moved, target_is_directory=True)
+        entry.chmod(0o500)
+    elif case == "receipt_fifo":
+        entry.chmod(0o700)
+        receipt.unlink()
+        os.mkfifo(receipt, 0o400)
+        entry.chmod(0o500)
+    else:
+        raise AssertionError(f"unhandled case: {case}")
+
+    result = store.inspect(
