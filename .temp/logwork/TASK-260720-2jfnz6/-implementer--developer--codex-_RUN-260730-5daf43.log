+pytestmark = pytest.mark.skipif(os.name != "posix", reason="POSIX cache tests")
+
+
+class _HeldGuard:
+    def assert_held(self) -> None:
+        pass
+
+
+class _ReleasedGuard:
+    def assert_held(self) -> None:
+        raise RuntimeError("released")
