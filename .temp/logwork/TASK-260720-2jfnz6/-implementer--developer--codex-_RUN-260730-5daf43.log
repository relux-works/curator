+        _replace_immutable_file(receipt, protocol_json.canonical_bytes(payload), 0o400)
+    elif case == "artifact_hash":
+        _replace_immutable_file(artifact, b"ArtifacT", 0o500)
+    elif case == "missing_receipt":
+        entry.chmod(0o700)
+        receipt.unlink()
+        entry.chmod(0o500)
+    elif case == "unexpected_entry":
+        entry.chmod(0o700)
