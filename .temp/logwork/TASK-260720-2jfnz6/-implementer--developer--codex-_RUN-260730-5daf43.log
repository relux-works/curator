+def test_self_consistent_untrusted_candidate_is_read_only_then_rebuilt_fresh(
+    tmp_path: Path,
+) -> None:
+    home, store = _new_store(tmp_path)
+    build_input = _build_input()
+    publication, receipt_hash = _publication(
