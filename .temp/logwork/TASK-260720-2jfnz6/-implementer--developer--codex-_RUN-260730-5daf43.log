+    assert moved.parent == home / cache_posix.QUARANTINE_ROOT_NAME
+    assert moved.exists()
+    assert store.inspect(CacheExpectation(input=build_input)).status is CacheEntryStatus.MISS
+    assert store.quarantine(key, guard=_HeldGuard()) is None
