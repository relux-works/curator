+def _write_immutable(path: Path, raw: bytes, mode: int) -> None:
+    path.write_bytes(raw)
+    path.chmod(mode)
+
+
+def _replace_immutable_file(path: Path, raw: bytes, mode: int) -> None:
+    path.chmod(0o600)
+    path.write_bytes(raw)
+    path.chmod(mode)
+
