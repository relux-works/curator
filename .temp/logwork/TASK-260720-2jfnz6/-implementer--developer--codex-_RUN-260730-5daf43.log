+    def verify(*args: object, **kwargs: object) -> object:
+        nonlocal verification_count
+        verification_count += 1
+        return original_verify(*args, **kwargs)
+
+    def rename_noreplace(
+        source_dir_fd: int,
+        source_name: str,
+        destination_dir_fd: int,
+        destination_name: str,
+    ) -> None:
