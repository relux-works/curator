+def _new_store(tmp_path: Path) -> tuple[Path, PosixBuildCache]:
+    home = tmp_path / ".cocoaskills"
+    home.mkdir(mode=0o700)
+    home.chmod(0o700)
+    return home, PosixBuildCache(home)
