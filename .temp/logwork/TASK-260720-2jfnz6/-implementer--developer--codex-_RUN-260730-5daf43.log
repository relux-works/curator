+        target=NativeTarget(goos=goos, goarch=goarch, tuning=tuning),
+        toolchain=ToolchainIdentity(
+            algorithm=TOOLCHAIN_ALGORITHM,
+            content_sha256="sha256:" + "c" * 64,
