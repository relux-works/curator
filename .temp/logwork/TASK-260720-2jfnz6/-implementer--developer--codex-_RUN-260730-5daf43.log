+@pytest.mark.parametrize(
+    "case",
+    [
+        "noncanonical_receipt",
+        "wrong_artifact_path",
+        "artifact_size",
+        "artifact_hash",
+        "missing_receipt",
+        "unexpected_entry",
+        "recorded_receipt_hash",
