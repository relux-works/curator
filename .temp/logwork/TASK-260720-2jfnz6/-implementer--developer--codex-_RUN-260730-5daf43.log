+
+    def quarantine(
+        self,
+        cache_key: str,
+        *,
+        guard: CacheMutationGuard,
+    ) -> Path | None:
+        """Atomically move a live entry outside ``builds`` without traversing it."""
+
+        _require_guard(guard)
