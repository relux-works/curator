+        statuses = list(executor.map(lambda _: publish(), range(publishers)))
+
+    assert statuses.count(CachePublicationStatus.PUBLISHED) == 1
+    assert statuses.count(CachePublicationStatus.REUSED_WINNER) == publishers - 1
+    hit = store.inspect(
