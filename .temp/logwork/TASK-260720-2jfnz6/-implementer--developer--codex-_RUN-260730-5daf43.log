+    receipt = entry / cache_posix.RECEIPT_FILENAME
+    artifact = entry / build_input.artifact_path
+    if case == "effective_uid":
+        monkeypatch.setattr(cache_posix, "_effective_uid", lambda: os.geteuid() + 1)
+    elif case == "home_group_writable":
