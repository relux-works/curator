+    (home / "builds" / "go-v1").chmod(0o700)
+    _write_immutable(entry / cache_posix.RECEIPT_FILENAME, publication.receipt_bytes, 0o400)
+    _write_immutable(entry / build_input.artifact_path, b"attacker-chosen-artifact", 0o500)
+    bin_dir.chmod(0o500)
