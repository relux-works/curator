+        bin_dir.symlink_to(moved, target_is_directory=True)
+        entry.chmod(0o500)
+    elif case == "receipt_fifo":
+        entry.chmod(0o700)
+        receipt.unlink()
+        os.mkfifo(receipt, 0o400)
