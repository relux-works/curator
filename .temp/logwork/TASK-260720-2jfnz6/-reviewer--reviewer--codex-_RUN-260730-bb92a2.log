   925	
   926	def _hash_file(
   927	    descriptor: int,
   928	    *,
   929	    expected_size: int,
   930	    label: str,
   931	    error_factory: Callable[[str], Exception],
   932	) -> tuple[str, int]:
   933	    before = os.fstat(descriptor)
   934	    if before.st_size != expected_size:
   935	        raise error_factory(f"{label} size does not match the receipt")
   936	    os.lseek(descriptor, 0, os.SEEK_SET)
   937	    remaining = expected_size
   938	    digest = hashlib.sha256()
   939	    while remaining:
   940	        chunk = os.read(descriptor, min(_READ_CHUNK, remaining))
   941	        if not chunk:
   942	            raise error_factory(f"{label} changed while reading")
   943	        digest.update(chunk)
   944	        remaining -= len(chunk)
   945	    if os.read(descriptor, 1):
   946	        raise error_factory(f"{label} grew while reading")
   947	    after = os.fstat(descriptor)
   948	    if not _stable_file_state(before, after):
   949	        raise error_factory(f"{label} changed while reading")
   950	    return f"sha256:{digest.hexdigest()}", expected_size
