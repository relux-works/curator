   206	def _pause_first_seal(
   207	    monkeypatch: pytest.MonkeyPatch,
   208	) -> tuple[threading.Event, threading.Event, list[int]]:
   209	    first_renamed = threading.Event()
   210	    release_first = threading.Event()
   211	    seal_identities: list[int] = []
   212	    seal_lock = threading.Lock()
   213	    original_seal = cache_posix._seal_published_entry
   214	
   215	    def pause_first(entry_fd: int) -> None:
   216	        with seal_lock:
   217	            seal_identities.append(os.fstat(entry_fd).st_ino)
   218	            call_number = len(seal_identities)
   219	        if call_number == 1:
   220	            first_renamed.set()
   221	            if not release_first.wait(timeout=5):
   222	                raise AssertionError("timed out waiting to resume first publisher")
   223	        original_seal(entry_fd)
   224	
   225	    monkeypatch.setattr(cache_posix, "_seal_published_entry", pause_first)
   226	    return first_renamed, release_first, seal_identities
