   991	        path_state = os.lstat(path)
   992	    except OSError as exc:
   993	        raise BuildCacheError(
   994	            "cache_publication_invalid",
   995	            f"cannot inspect publication artifact source: {exc}",
   996	        ) from exc
   997	    if stat.S_ISLNK(path_state.st_mode) or not stat.S_ISREG(path_state.st_mode):
   998	        raise BuildCacheError(
   999	            "cache_publication_invalid",
  1000	            "publication artifact source must be a regular non-link file",
  1001	        )
