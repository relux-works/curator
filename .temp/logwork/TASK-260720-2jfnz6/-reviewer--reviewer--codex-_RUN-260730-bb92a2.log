   901	def _read_bounded_file(
   902	    descriptor: int,
   903	    limit: int,
   904	    label: str,
   905	) -> bytes:
   906	    before = os.fstat(descriptor)
   907	    if before.st_size < 0 or before.st_size > limit:
   908	        raise _CorruptState(f"{label} size is outside the supported range")
   909	    os.lseek(descriptor, 0, os.SEEK_SET)
   910	    remaining = before.st_size
   911	    chunks: list[bytes] = []
   912	    while remaining:
   913	        chunk = os.read(descriptor, min(_READ_CHUNK, remaining))
   914	        if not chunk:
   915	            raise _CorruptState(f"{label} changed while reading")
   916	        chunks.append(chunk)
   917	        remaining -= len(chunk)
   918	    if os.read(descriptor, 1):
   919	        raise _CorruptState(f"{label} grew while reading")
   920	    after = os.fstat(descriptor)
   921	    if not _stable_file_state(before, after):
   922	        raise _CorruptState(f"{label} changed while reading")
   923	    return b"".join(chunks)
