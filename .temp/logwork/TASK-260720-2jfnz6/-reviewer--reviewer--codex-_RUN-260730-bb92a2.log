  1018	            not stat.S_ISREG(opened.st_mode)
  1019	            or path_state.st_dev != opened.st_dev
  1020	            or path_state.st_ino != opened.st_ino
  1021	            or opened.st_nlink != 1
  1022	            or opened.st_uid != _effective_uid()
