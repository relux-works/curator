   125	def _publication(
   126	    tmp_path: Path,
   127	    build_input: GoBuildInput,
   128	    artifact_bytes: bytes,
   129	) -> tuple[CachePublication, str]:
   130	    digest = hashlib.sha256(artifact_bytes).hexdigest()
   131	    source_root = tmp_path / "private-builds"
   132	    source_root.mkdir(mode=0o700, exist_ok=True)
   133	    source_root.chmod(0o700)
   134	    source = source_root / f"{build_input.command}-{digest[:12]}"
   135	    source.write_bytes(artifact_bytes)
   136	    source.chmod(0o700)
   137	    receipt = build_receipt(
   138	        build_input,
   139	        BuildArtifact(
   140	            path=build_input.artifact_path,
   141	            sha256=f"sha256:{digest}",
   142	            size=len(artifact_bytes),
   143	        ),
   144	    )
   145	    raw = canonical_receipt_bytes(receipt)
   146	    return (
   147	        CachePublication(
   148	            input=build_input,
   149	            receipt_bytes=raw,
   150	            artifact_source=source,
   151	        ),
   152	        receipt_sha256(raw),
   153	    )
