   555	def _protection_supported() -> bool:
   556	    if os.name != "posix":
   557	        return False
   558	    required_flags = all(
   559	        hasattr(os, name)
   560	        for name in (
   561	            "O_CLOEXEC",
   562	            "O_DIRECTORY",
   563	            "O_NOFOLLOW",
   564	        )
   565	    )
   566	    required_calls = (
   567	        os.open in os.supports_dir_fd
   568	        and os.mkdir in os.supports_dir_fd
   569	        and os.rename in os.supports_dir_fd
   570	        and os.listdir in os.supports_fd
   571	    )
   572	    return (
   573	        required_flags
   574	        and required_calls
   575	        and hasattr(os, "geteuid")
   576	        and _rename_noreplace_available()
   577	    )
   578	
   579	
   580	def _rename_noreplace_available() -> bool:
   581	    library = ctypes.CDLL(None)
   582	    if sys.platform == "darwin":
   583	        return hasattr(library, "renameatx_np")
   584	    if sys.platform.startswith("linux"):
   585	        return hasattr(library, "renameat2")
   586	    return False
