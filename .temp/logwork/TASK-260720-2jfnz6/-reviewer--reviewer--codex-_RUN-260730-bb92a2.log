  1295	def _resolve_atomic_winner(
  1296	    driver_fd: int,
  1297	    entry_name: str,
  1298	    published_entry_fd: int,
  1299	    published: _VerifiedEntry,
  1300	    expectation: CacheExpectation,
  1301	    key: str,
  1302	    artifact_name: str,
  1303	    guard: CacheMutationGuard,
  1304	) -> tuple[CachePublicationStatus, _VerifiedEntry]:
  1305	    """Resolve the live name without ever mutating through that name.
  1306	
  1307	    A competing publisher may quarantine the private-mode directory after its
  1308	    atomic rename but before this publisher seals it. The retained descriptor
  1309	    keeps this publisher's identity stable. If the live name now selects a
  1310	    different complete entry, compare that pinned winner byte-for-byte.
  1311	    """
  1312	
  1313	    published_state = os.fstat(published_entry_fd)
  1314	    for attempt in range(8):
  1315	        _require_guard(guard)
  1316	        try:
  1317	            with _open_private_directory_at(
  1318	                driver_fd,
  1319	                entry_name,
  1320	                "selected cache winner",
  1321	                missing=_MissingState("published cache winner is absent"),
  1322	                immutable=True,
  1323	            ) as selected_entry_fd:
  1324	                selected = _inspect_open_entry(
  1325	                    selected_entry_fd,
  1326	                    CacheExpectation(input=expectation.input),
  1327	                    key,
  1328	                    artifact_name,
  1329	                )
  1330	                if _same_directory_identity(
  1331	                    published_state,
  1332	                    os.fstat(selected_entry_fd),
  1333	                ):
  1334	                    if (
  1335	                        selected.receipt_bytes != published.receipt_bytes
  1336	                        or selected.artifact_sha256
  1337	                        != published.artifact_sha256
  1338	                        or selected.artifact_size != published.artifact_size
  1339	                    ):
  1340	                        raise _CorruptState(
  1341	                            "selected published entry changed after sealing"
  1342	                        )
  1343	                    return CachePublicationStatus.PUBLISHED, selected
  1344	                if (
  1345	                    selected.receipt_bytes == published.receipt_bytes
  1346	                    and _artifact_open_entries_equal(
  1347	                        published_entry_fd,
  1348	                        selected_entry_fd,
  1349	                        artifact_name,
  1350	                    )
  1351	                ):
  1352	                    return CachePublicationStatus.REUSED_WINNER, selected
  1353	                raise CacheConflictError(key)
  1354	        except (_MissingState, _UntrustedState):
  1355	            if attempt == 7:
  1356	                raise
  1357	            time.sleep(0.005)
  1358	    raise AssertionError("unreachable atomic winner resolution")
