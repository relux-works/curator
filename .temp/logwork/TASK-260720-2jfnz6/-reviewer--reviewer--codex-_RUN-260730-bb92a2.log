   598	def _artifact_name(build_input: _metadata.GoBuildInput) -> str:
   599	    parts = build_input.artifact_path.split("/")
   600	    if len(parts) != 2 or parts[0] != "bin" or not parts[1]:
   601	        raise ValueError("manager-derived artifact path is not a direct bin child")
   602	    if parts[1] in {".", ".."} or "/" in parts[1] or os.sep in parts[1]:
   603	        raise ValueError("manager-derived artifact filename is unsafe")
   604	    return parts[1]
