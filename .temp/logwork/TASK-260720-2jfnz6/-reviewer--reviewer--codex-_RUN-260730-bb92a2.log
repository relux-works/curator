  1269	def _write_all(descriptor: int, raw: bytes) -> None:
  1270	    view = memoryview(raw)
  1271	    while view:
  1272	        written = os.write(descriptor, view)
  1273	        if written <= 0:
  1274	            raise OSError(errno.EIO, "short write")
  1275	        view = view[written:]
