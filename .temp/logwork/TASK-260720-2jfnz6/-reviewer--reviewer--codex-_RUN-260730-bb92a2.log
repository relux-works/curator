  1003	        try:
  1004	            descriptor = os.open(path, _file_flags())
  1005	        except PermissionError:
  1006	            no_atime = getattr(os, "O_NOATIME", 0)
  1007	            if not no_atime:
  1008	                raise
  1009	            descriptor = os.open(path, _file_flags() & ~no_atime)
  1010	    except OSError as exc:
  1011	        raise BuildCacheError(
  1012	            "cache_publication_invalid",
  1013	            f"cannot open publication artifact source: {exc}",
  1014	        ) from exc
  1015	    try:
  1016	        opened = os.fstat(descriptor)
