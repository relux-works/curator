   607	def _key_component(cache_key: str) -> str:
   608	    prefix = "sha256:"
   609	    if (
   610	        not isinstance(cache_key, str)
   611	        or not cache_key.startswith(prefix)
   612	        or len(cache_key) != len(prefix) + 64
   613	    ):
   614	        raise BuildCacheError("cache_key_invalid", "logical cache key is malformed")
   615	    component = cache_key.removeprefix(prefix)
   616	    if any(character not in "0123456789abcdef" for character in component):
   617	        raise BuildCacheError("cache_key_invalid", "logical cache key is malformed")
   618	    return component
