   957	def _stable_file_state(
   958	    before: os.stat_result,
   959	    after: os.stat_result,
   960	) -> bool:
   961	    return (
   962	        before.st_dev,
   963	        before.st_ino,
   964	        before.st_mode,
   965	        before.st_uid,
   966	        before.st_nlink,
   967	        before.st_size,
   968	        before.st_mtime_ns,
   969	        before.st_ctime_ns,
   970	    ) == (
   971	        after.st_dev,
   972	        after.st_ino,
   973	        after.st_mode,
   974	        after.st_uid,
   975	        after.st_nlink,
   976	        after.st_size,
   977	        after.st_mtime_ns,
   978	        after.st_ctime_ns,
   979	    )
