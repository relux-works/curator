   749	    if not stat.S_ISDIR(info.st_mode):
   750	        raise _UntrustedState("manager home is not a directory")
   751	    if info.st_uid != _effective_uid():
   752	        raise _UntrustedState(
   753	            "manager home owner does not match the effective user"
   754	        )
   755	    mode = stat.S_IMODE(info.st_mode)
   756	    if mode & 0o022:
   757	        raise _UntrustedState("manager home is writable by group or other")
   758	    if mode & 0o700 != 0o700:
   759	        raise _UntrustedState("manager home does not grant owner control")
