func validateRemovalStart(path, expectedDigest string) (bool, error) {
	if expectedDigest == "" {
		expectedDigest = DigestAbsent
	}
	if !validDigest(expectedDigest) {
		return false, corruptionf("durable removal for %s has invalid expected digest", path)
