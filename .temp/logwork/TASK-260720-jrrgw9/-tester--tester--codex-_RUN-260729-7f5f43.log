		if code != exitOK {
			t.Fatalf("%v = %d, want %d\nstderr:\n%s", args, code, exitOK, stderr)
		}
		if stdout != "" {
			t.Fatalf("%v printed a report for a scope that declares nothing:\n%q", args, stdout)
		}
	}
}

