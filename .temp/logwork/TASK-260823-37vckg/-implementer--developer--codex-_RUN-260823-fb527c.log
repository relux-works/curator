 	t.Helper()
+	var visible []string
 	for _, path := range paths {
-		if _, err := os.Lstat(path); !os.IsNotExist(err) {
-			t.Fatalf("the dry run produced the forbidden persistent effect %q at %s: %v", effect, path, err)
+		_, err := os.Lstat(path)
