+		Options{Platform: "unix", Fetch: true}); result.Status != "ok" {
+		t.Fatalf("the real project install failed: %+v", result)
+	}
+	if _, err := GlobalInit(e.home); err != nil {
+		t.Fatal(err)
+	}
