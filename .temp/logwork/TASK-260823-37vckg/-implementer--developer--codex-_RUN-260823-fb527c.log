+
+// pathsSuffixed is pathsNamed for a reserved extension.
+func pathsSuffixed(t *testing.T, suffixes []string, roots []string) []string {
+	t.Helper()
+	return pathsMatching(t, roots, func(name string) bool {
+		for _, suffix := range suffixes {
