    if sys.platform == "darwin":
        goos = "darwin"
    elif os.name == "nt":
        goos = "windows"
    elif sys.platform.startswith("linux"):
        goos = "linux"
    elif sys.platform.startswith("freebsd"):
        goos = "freebsd"
    elif sys.platform.startswith("openbsd"):
        goos = "openbsd"
    elif sys.platform.startswith("netbsd"):
