    \"GOAMD64\": \"v1\",
    \"GOARM\": \"7\",
    \"GOARM64\": \"v8.0\",
    \"GOMIPS\": \"hardfloat\",
    \"GOMIPS64\": \"hardfloat\",
    \"GOPPC64\": \"power8\",
    \"GORISCV64\": \"rva20u64\",
    \"GOWASM\": \"satconv,signext\",
}

class RepointingRunner:
    def __init__(self, goroot: Path, outside_config: Path):
        self.goroot = goroot
        self.outside_config = outside_config
        self.host = toolchain._native_host()
        self.operation_root: Path | None = None

    def run(
        self,
        argv: tuple[str, ...],
        *,
        cwd: Path,
        environment: Mapping[str, str],
        timeout: float,
        output_limit: int,
    ) -> toolchain.ProbeResult:
        del timeout, output_limit
        self.operation_root = cwd.parent
        args = argv[1:]
        if self.host.windows:
            config = Path(environment[\"APPDATA\"])
        elif self.host.goos == \"darwin\":
            config = Path(environment[\"HOME\"]) / \"Library\" / \"Application Support\"
        else:
            config = Path(environment[\"XDG_CONFIG_HOME\"])
        if args == (\"telemetry\", \"off\"):
            shutil.rmtree(config)
            self.outside_config.mkdir(parents=True)
            config.symlink_to(self.outside_config, target_is_directory=True)
            (self.outside_config / \"go\" / \"telemetry\").mkdir(parents=True)
            return toolchain.ProbeResult()
        if args == (\"version\",):
            return toolchain.ProbeResult(
                stdout=(
                    f\"go version go1.25.5 {self.host.goos}/{self.host.goarch}\\n\"
                ).encode()
            )
        if args == (\"env\", \"-json\", *toolchain.GO_ENV_FIELDS):
            values = {name: \"\" for name in toolchain.GO_ENV_FIELDS}
            values.update(
                {
                    \"GOROOT\": str(self.goroot),
                    \"GOHOSTOS\": self.host.goos,
                    \"GOHOSTARCH\": self.host.goarch,
                    \"GOOS\": self.host.goos,
                    \"GOARCH\": self.host.goarch,
                    toolchain.TUNING_VARIABLES[self.host.goarch]: TUNING[
                        toolchain.TUNING_VARIABLES[self.host.goarch]
                    ],
                    \"GOTELEMETRY\": \"off\",
                    \"GOTELEMETRYDIR\": str(
                        self.outside_config / \"go\" / \"telemetry\"
                    ),
                }
            )
            return toolchain.ProbeResult(stdout=json.dumps(values).encode())
        raise AssertionError(args)

