def _digest_file(
    record: _TreeRecord,
    digest: hashlib._Hash,
    deadline: float,
) -> tuple[int, bytes]:
    flags = os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_CLOEXEC", 0)
