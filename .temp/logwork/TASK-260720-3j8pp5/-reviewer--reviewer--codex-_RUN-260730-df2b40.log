   162	def _make_goroot(path: Path) -> Path:
   163	    host = toolchain._native_host()
   164	    executable = path / "bin" / ("go.exe" if host.windows else "go")
   165	    executable.parent.mkdir(parents=True)
   166	    executable.write_bytes(_native_header(host) + b"fake-go")
   167	    executable.chmod(0o755)
   168	    (path / "VERSION").write_text("go1.25.5\n", encoding="utf-8")
   169	    return path
