   123	def _telemetry_dir(environment: dict[str, str], host: toolchain._Host) -> Path:
   124	    if host.windows:
   125	        config = Path(environment["APPDATA"])
   126	    elif host.goos == "darwin":
   127	        config = Path(environment["HOME"]) / "Library" / "Application Support"
   128	    else:
   129	        config = Path(environment["XDG_CONFIG_HOME"])
   130	    return config / "go" / "telemetry"
