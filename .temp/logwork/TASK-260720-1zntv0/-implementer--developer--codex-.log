package godriver

import (
	"context"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"reflect"
	"strings"
)

// HostExecution is the complete policy input for one direct Go child. The
// policy owns OS isolation and process-resource enforcement; it must not add a
// launcher, shell, helper, response file, or other executable.
type HostExecution struct {
	Process            Process
	ReadOnlyRoots      []string
	WritableRoots      []string
	AllowedExecutables []string
	NetworkDenied      bool
	Limits             ResourceLimits
}

// HostPolicy is the build-tagged platform isolation boundary. Implementations
// execute Process.Executable directly and fail closed if a requested supported
// control cannot be applied.
type HostPolicy interface {
	Run(context.Context, HostExecution) (Output, error)
}

type guardedHostPolicy struct{ executor Executor }

// NewHostPolicy returns the native direct-execution adapter. Passing nil uses
// OSExecutor. The adapter verifies the closed environment, read-only source,
// private writable roots, executable graph roots, and bounded request before
// every direct child.
func NewHostPolicy(executor Executor) HostPolicy {
	if executor == nil {
		executor = OSExecutor{}
	}
	return guardedHostPolicy{executor: executor}
}

func (policy guardedHostPolicy) Run(ctx context.Context, execution HostExecution) (Output, error) {
	if err := validateHostExecution(execution); err != nil {
		return Output{}, err
	}
	if err := platformValidateHostExecution(execution); err != nil {
		return Output{}, err
	}
	return policy.executor.Run(ctx, execution.Process)
}

func validateHostExecution(execution HostExecution) error {
	process := execution.Process
	if len(execution.ReadOnlyRoots) != 2 || len(execution.WritableRoots) == 0 || len(execution.AllowedExecutables) != 2 || !execution.NetworkDenied {
		return diagnostic("host_policy_invalid", "go-v1 isolation roots, executable graph, and network denial must be explicit")
	}
	if process.Executable == "" || process.Executable != execution.AllowedExecutables[0] || !filepath.IsAbs(process.Executable) {
		return diagnostic("unexpected_child_process", "direct executable is not the fingerprinted Go launcher")
	}
	if !filepath.IsAbs(process.Directory) || process.Directory == execution.ReadOnlyRoots[0] || !strictlyBelow(process.Directory, execution.ReadOnlyRoots[0]) {
		return diagnostic("host_policy_invalid", "Go child cwd is not the canonical source directory")
	}
	if process.Timeout != execution.Limits.Timeout || process.OutputLimit != execution.Limits.OutputBytes {
		return diagnostic("host_policy_invalid", "process bounds differ from the normalized host policy limits")
	}
	if err := validateBuildEnvironment(process.Environment, execution); err != nil {
		return err
	}
	for _, root := range execution.ReadOnlyRoots {
		if !filepath.IsAbs(root) {
			return diagnostic("host_policy_invalid", "read-only roots must be absolute")
		}
	}
	for _, root := range execution.WritableRoots {
		if !filepath.IsAbs(root) || root == execution.ReadOnlyRoots[0] || root == execution.ReadOnlyRoots[1] || isWithin(root, execution.ReadOnlyRoots[0]) || isWithin(root, execution.ReadOnlyRoots[1]) {
			return diagnostic("host_policy_invalid", "writable root overlaps source or toolchain")
		}
	}
	toolDir := execution.AllowedExecutables[1]
	if !filepath.IsAbs(toolDir) || !strictlyBelow(toolDir, execution.ReadOnlyRoots[1]) {
		return diagnostic("unexpected_child_process", "allowed Go tool directory escapes fingerprinted GOROOT")
	}
	if err := verifyReadOnlyTree(execution.ReadOnlyRoots[0]); err != nil {
		return diagnosticErr("source_not_readonly", err, "frozen source is writable by build children")
	}
	if err := validateFixedBuildArguments(process.Arguments, execution.WritableRoots); err != nil {
		return err
	}
	return nil
}

func validateBuildEnvironment(environment []string, execution HostExecution) error {
	values := make(map[string]string, len(environment))
	for _, item := range environment {
		key, value, present := strings.Cut(item, "=")
		if !present || key == "" {
			return diagnostic("process_environment_poisoned", "build environment contains a malformed entry")
		}
		if _, duplicate := values[key]; duplicate {
			return diagnostic("process_environment_poisoned", "build environment repeats %s", key)
		}
		values[key] = value
	}
	required := map[string]string{
		"GOENV": "off", "GOTOOLCHAIN": "local", "LC_ALL": "C", "LANG": "C",
		"GO111MODULE": "on", "GOFLAGS": "", "GOPROXY": "off", "GOSUMDB": "off", "GOPRIVATE": "",
		"GONOPROXY": "none", "GONOSUMDB": "none", "GOVCS": "*:off", "GOWORK": "off",
		"CGO_ENABLED": "0", "GO_EXTLINK_ENABLED": "0", "GOEXPERIMENT": "",
		"GOROOT": execution.ReadOnlyRoots[1],
	}
	for key, want := range required {
		if got, present := values[key]; !present || got != want {
			return diagnostic("process_environment_poisoned", "build environment has unexpected %s", key)
		}
	}
	for _, key := range []string{"GOPATH", "GOMODCACHE", "GOCACHE", "GOTMPDIR", "HOME", "XDG_CONFIG_HOME", "PATH", "TMPDIR"} {
		value, present := values[key]
		if !present || !containsExact(execution.WritableRoots, value) && key != "PATH" {
			return diagnostic("process_environment_poisoned", "build environment %s is not operation-private", key)
		}
		if key == "PATH" && (value == "" || !containsExact(execution.WritableRoots, filepath.Dir(value)) && !isSiblingPrivateRoot(value, execution.WritableRoots)) {
			return diagnostic("process_environment_poisoned", "build PATH is not an operation-private empty directory")
		}
	}
	for _, forbidden := range []string{"CC", "CXX", "FC", "AR", "PKG_CONFIG", "GOFLAGS_FILE", "GOAUTH", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY", "SSH_AUTH_SOCK", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM"} {
		if _, present := values[forbidden]; present {
			return diagnostic("process_environment_poisoned", "build environment contains forbidden %s", forbidden)
		}
	}
	if values["GOOS"] == "" || values["GOARCH"] == "" {
		return diagnostic("process_environment_poisoned", "build environment is missing the native target")
	}
	allowed := make(map[string]bool, len(required)+16)
	for key := range required {
		allowed[key] = true
	}
	for _, key := range []string{"GOOS", "GOARCH", "GOPATH", "GOMODCACHE", "GOCACHE", "GOTMPDIR", "HOME", "XDG_CONFIG_HOME", "PATH", "TMPDIR"} {
		allowed[key] = true
	}
	if tuning := tuningVariable(values["GOARCH"]); tuning != "" {
		if values[tuning] == "" {
			return diagnostic("process_environment_poisoned", "build environment is missing %s", tuning)
		}
		allowed[tuning] = true
	}
	for _, key := range platformEnvironmentNames() {
		allowed[key] = true
	}
	for key := range values {
		if !allowed[key] {
			return diagnostic("process_environment_poisoned", "build environment contains non-protocol variable %s", key)
		}
	}
	pathEntries, err := os.ReadDir(values["PATH"])
	if err != nil || len(pathEntries) != 0 {
		return diagnosticErr("process_environment_poisoned", err, "build PATH is not an empty manager directory")
	}
	return nil
}

func validateFixedBuildArguments(arguments, writableRoots []string) error {
	if reflect.DeepEqual(arguments, listArguments) {
		return nil
	}
	if len(arguments) != 11 || !reflect.DeepEqual(arguments[:9], []string{
		"build", "-mod=vendor", "-trimpath", "-buildvcs=false", "-buildmode=exe", "-compiler=gc", "-pgo=off", "-ldflags=-linkmode=internal -libgcc=none", "-o",
	}) || arguments[10] != "." {
		return diagnostic("unexpected_go_arguments", "host policy rejected a non-protocol Go argument vector")
	}
	output := arguments[9]
	if !filepath.IsAbs(output) {
		return diagnostic("artifact_path_mismatch", "Go output path is not manager-derived absolute staging")
	}
	for _, root := range writableRoots {
		if strictlyBelow(output, root) {
			return nil
		}
	}
	return diagnostic("artifact_path_mismatch", "Go output path escapes operation-private staging")
}

func containsExact(values []string, want string) bool {
	for _, value := range values {
		if value == want {
			return true
		}
	}
	return false
}

func isSiblingPrivateRoot(path string, writable []string) bool {
	for _, root := range writable {
		if filepath.Dir(root) == filepath.Dir(path) {
			return true
		}
	}
	return false
}

func verifyReadOnlyTree(root string) error {
	return filepath.WalkDir(root, func(path string, entry os.DirEntry, walkErr error) error {
		if walkErr != nil {
			return walkErr
		}
		info, err := os.Lstat(path)
		if err != nil {
			return err
		}
		if info.Mode().Perm()&0o222 != 0 {
			return fmt.Errorf("%s has write permission bits %o", path, info.Mode().Perm())
		}
		return nil
	})
}

func copyHostExecution(execution HostExecution) HostExecution {
	execution.Process.Arguments = append([]string(nil), execution.Process.Arguments...)
	execution.Process.Environment = append([]string(nil), execution.Process.Environment...)
	execution.ReadOnlyRoots = append([]string(nil), execution.ReadOnlyRoots...)
	execution.WritableRoots = append([]string(nil), execution.WritableRoots...)
	execution.AllowedExecutables = append([]string(nil), execution.AllowedExecutables...)
	return execution
}

func sameHostExecution(left, right HostExecution) bool { return reflect.DeepEqual(left, right) }

var errHostControlUnavailable = errors.New("host control unavailable")
