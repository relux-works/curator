		}
	})

	t.Run("entry is regular file", func(t *testing.T) {
		store := newTestStore(t)
		publication, _ := testPublication(t, store.Home(), testInput("tool"), []byte("artifact"))
		result, err := store.Publish(publication, testHomeLock{})
		if err != nil {
			t.Fatal(err)
