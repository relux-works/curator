docs/build-https.md-25-    },
docs/build-https.md-26-    "git.example.com/portals": {
docs/build-https.md:27:      "token_env": "PORTALS_TOKEN",
docs/build-https.md-28-      "username": "oauth2"
docs/build-https.md-29-    },
docs/build-https.md-30-    "code.example.net/tools": {
docs/build-https.md:31:      "token": "keyring"
docs/build-https.md-32-    }
docs/build-https.md-33-  }
docs/build-https.md-34-}
docs/build-https.md-35-```
