.github/ci/no-broad-suppression.sh:66:				echo 'lint: a new blanket gosec exemption needs a recorded reason, not a quiet addition.'
.github/ci/no-broad-suppression.sh-67-				rc=1
.github/ci/no-broad-suppression.sh-68-				;;
.github/ci/no-broad-suppression.sh-69-		esac

