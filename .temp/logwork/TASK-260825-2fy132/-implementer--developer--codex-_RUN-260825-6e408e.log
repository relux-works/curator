+  "build_https": {
+    "git.example.com": {
+      "token": "git-credentials"
+    },
+    "git.example.com/portals": {
+      "token_env": "PORTALS_TOKEN",
+      "username": "oauth2"
+    },
+    "code.example.net/tools": {
