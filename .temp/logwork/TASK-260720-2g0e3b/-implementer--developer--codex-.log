+func buildFiles() map[string]string {
+	return map[string]string{
+		"build/go.mod":           "module example.com/tool\n\ngo 1.23\n",
+		"build/cmd/tool/main.go": "package main\n",
+		"scripts/helper":         "#!/bin/sh\n",
+	}
