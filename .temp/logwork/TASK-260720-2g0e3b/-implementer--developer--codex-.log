   134	func TestSchemaVersionValidation(t *testing.T) {
   135		mustFail(t, writeSkill(t, `{"schema_version": "3"}`, nil), "schema_version")
   136		mustFail(t, writeSkill(t, `{"schema_version": 3.5}`, nil), "schema_version")
   137		mustFail(t, writeSkill(t, `{"schema_version": 6}`, nil), "schema_version")
   138		mustFail(t, writeSkill(t, `{"schema_version": true}`, nil), "schema_version")
   139		mustFail(t, writeSkill(t, `{}`, nil), "schema_version")
   140	}
