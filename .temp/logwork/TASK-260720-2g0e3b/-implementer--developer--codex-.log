    10	func TestPortablePathConformanceVectors(t *testing.T) {
    11		root := os.Getenv("CURATOR_CONFORMANCE_ROOT")
    12		if root == "" {
    13			t.Skip("CURATOR_CONFORMANCE_ROOT is not set")
    14		}
    15		payload, err := os.ReadFile(filepath.Join(root, "vectors", "portable-paths.json"))
    16		if err != nil {
    17			t.Fatal(err)
    18		}
    19		var cases []struct {
    20			Input string `json:"input"`
    21			Valid bool   `json:"valid"`
    22		}
    23		if err := json.Unmarshal(payload, &cases); err != nil {
    24			t.Fatal(err)
    25		}
    26		for _, testCase := range cases {
    27			_, err := validateRelativePath(testCase.Input, "path", true)
    28			if (err == nil) != testCase.Valid {
    29				t.Errorf("path %q valid=%v, error=%v", testCase.Input, testCase.Valid, err)
    30			}
    31		}
    32	}
