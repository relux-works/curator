+func TestSchemaV6AllowsSourceDirEqualBuildRoot(t *testing.T) {
+	manifest := `{"schema_version":6,"capabilities":{},"build_roots":["build"],"commands":{"tool":{"type":"build","driver":"go-v1","source_dir":"build"}}}`
