   142	func TestUnknownTopLevelFieldsRejectedFromV2(t *testing.T) {
   143		// v1 tolerates unknown fields.
   144		dir := writeSkill(t, `{"schema_version": 1, "install": "curl | sh"}`, nil)
   145		if _, err := Load(dir); err != nil {
   146			t.Fatalf("v1 unknown fields must be tolerated: %v", err)
   147		}
   148		// v2 rejects them: no install hooks (Spec 5.9).
   149		mustFail(t, writeSkill(t, `{"schema_version": 2, "install": "curl | sh"}`, nil), "csk-skill.json")
   150		mustFail(t, writeSkill(t, `{"schema_version": 2, "capabilities": {}}`, nil), "csk-skill.json")
   151	}
   152	
   153	func TestCapabilitiesRequiredFromV3(t *testing.T) {
   154		mustFail(t, writeSkill(t, `{"schema_version": 3}`, nil), "capabilities")
