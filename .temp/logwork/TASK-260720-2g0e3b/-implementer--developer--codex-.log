   188	func TestScriptCommands(t *testing.T) {
   189		files := map[string]string{"scripts/ytx": "", "scripts/ytx.cmd": ""}
   190		manifest := `{"schema_version": 2, "runtime_roots": ["scripts"],
   191			"commands": {"ytx": {"type": "script", "unix_path": "scripts/ytx", "win_path": "scripts/ytx.cmd"}}}`
   192		spec, err := Load(writeSkill(t, manifest, files))
   193		if err != nil {
   194			t.Fatal(err)
   195		}
   196		command := spec.Commands["ytx"]
   197		if command.UnixPath != "scripts/ytx" || command.WinPath != "scripts/ytx.cmd" {
   198			t.Fatalf("command: %+v", command)
   199		}
   200	
   201		// v2 requires at least one path
   202		mustFail(t, writeSkill(t, `{"schema_version": 2, "commands": {"x": {"type": "script"}}}`, nil), "commands.x")
   203		// path must exist
   204		mustFail(t, writeSkill(t, `{"schema_version": 2, "commands": {"x": {"type": "script", "unix_path": "scripts/x"}}}`, nil), "commands.x.unix_path")
   205		// path must sit inside a runtime root when roots are declared
   206		outside := map[string]string{"scripts/tool": "", "other/x": ""}
   207		mustFail(t, writeSkill(t,
   208			`{"schema_version": 2, "runtime_roots": ["scripts"], "commands": {"x": {"type": "script", "unix_path": "other/x"}}}`,
   209			outside), "commands.x.unix_path")
   210		// absolute and escaping paths rejected
   211		mustFail(t, writeSkill(t, `{"schema_version": 2, "commands": {"x": {"type": "script", "unix_path": "/etc/passwd"}}}`, nil), "commands.x.unix_path")
   212		mustFail(t, writeSkill(t, `{"schema_version": 2, "commands": {"x": {"type": "script", "unix_path": "../up"}}}`, nil), "commands.x.unix_path")
   213		// unknown fields on the command object (v2+)
   214		mustFail(t, writeSkill(t, `{"schema_version": 2, "commands": {"x": {"type": "script", "unix_path": "s", "check": true}}}`, map[string]string{"s": ""}), "commands.x")
   215		// invalid command name
   216		mustFail(t, writeSkill(t, `{"schema_version": 1, "commands": {"-bad": {"type": "system", "command": "b"}}}`, nil), "commands.-bad")
   217		// unsupported type
   218		mustFail(t, writeSkill(t, `{"schema_version": 1, "commands": {"x": {"type": "binary"}}}`, nil), "commands.x")
   219	}
