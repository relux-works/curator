+func TestSchemaV6BuildCommandClosedShapeDiagnostics(t *testing.T) {
+	mustFailExact(t, writeSkill(t,
+		`{"schema_version":5,"capabilities":{},"commands":{"tool":{"type":"build","driver":"go-v1","source_dir":"build/cmd/tool"}}}`,
+		buildFiles()), "commands.tool")
+	mustFailExact(t, writeSkill(t,
+		`{"schema_version":5,"capabilities":{},"build_roots":[]}`,
+		buildFiles()), LegacyManifestName)
+
+	manifest := func(schema int, roots, command string) string {
+		return `{"schema_version":` + string(rune('0'+schema)) + `,"capabilities":{},"build_roots":` + roots + `,"commands":{"tool":` + command + `}}`
+	}
+	cases := []struct {
+		name     string
+		schema   int
+		roots    string
+		command  string
+		wantPath string
+	}{
+		{name: "missing driver", schema: 6, roots: `["build"]`, command: `{"type":"build","source_dir":"build/cmd/tool"}`, wantPath: "commands.tool.driver"},
+		{name: "unknown driver", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"custom-v1","source_dir":"build/cmd/tool"}`, wantPath: "commands.tool.driver"},
+		{name: "missing source dir", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"go-v1"}`, wantPath: "commands.tool.source_dir"},
+		{name: "source dir dot", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"go-v1","source_dir":"."}`, wantPath: "commands.tool.source_dir"},
+		{name: "mixed script", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"go-v1","source_dir":"build/cmd/tool","unix_path":"scripts/tool"}`, wantPath: "commands.tool.unix_path"},
+		{name: "mixed system", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"go-v1","source_dir":"build/cmd/tool","command":"tool"}`, wantPath: "commands.tool.command"},
+		{name: "args", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"go-v1","source_dir":"build/cmd/tool","args":[]}`, wantPath: "commands.tool.args"},
+		{name: "env", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"go-v1","source_dir":"build/cmd/tool","env":{}}`, wantPath: "commands.tool.env"},
+		{name: "flags", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"go-v1","source_dir":"build/cmd/tool","flags":[]}`, wantPath: "commands.tool.flags"},
+		{name: "output", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"go-v1","source_dir":"build/cmd/tool","output":"bin/tool"}`, wantPath: "commands.tool.output"},
+		{name: "toolchain", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"go-v1","source_dir":"build/cmd/tool","toolchain":"go1.25"}`, wantPath: "commands.tool.toolchain"},
+		{name: "hooks", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"go-v1","source_dir":"build/cmd/tool","hooks":[]}`, wantPath: "commands.tool.hooks"},
+		{name: "scripts", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"go-v1","source_dir":"build/cmd/tool","scripts":[]}`, wantPath: "commands.tool.scripts"},
+		{name: "tags", schema: 6, roots: `["build"]`, command: `{"type":"build","driver":"go-v1","source_dir":"build/cmd/tool","tags":[]}`, wantPath: "commands.tool.tags"},
+	}
+	for _, testCase := range cases {
+		t.Run(testCase.name, func(t *testing.T) {
+			mustFailExact(t, writeSkill(t, manifest(testCase.schema, testCase.roots, testCase.command), buildFiles()), testCase.wantPath)
+		})
+	}
+}
