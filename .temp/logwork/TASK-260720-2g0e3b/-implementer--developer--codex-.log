+		{name: "dot root", runtimeRoots: `[]`, buildRoots: `["."]`, commands: `{}`, files: buildFiles(), wantPath: "build_roots[0]"},
+		{name: "escaped root", runtimeRoots: `[]`, buildRoots: `["../build"]`, commands: `{}`, files: buildFiles(), wantPath: "build_roots[0]"},
