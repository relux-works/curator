   298		if err != nil {
   299			t.Fatal(err)
   300		}
   301		if spec.McpServers["google-sheets"].RequiredIn != "all" || spec.McpServers["google-sheets"].Transport != "http" {
   302			t.Fatalf("mcp: %+v", spec.McpServers["google-sheets"])
   303		}
   304		if spec.McpServers["tracker"].RequiredIn != "any" {
   305			t.Fatalf("required_in default: %+v", spec.McpServers["tracker"])
   306		}
   307	
   308		base := `{"schema_version": 5, "capabilities": {}, "dependencies": {"mcp_servers": {"x": %s}}}`
   309		fail := func(entry, pathPrefix string) {
   310			t.Helper()
   311			mustFail(t, writeSkill(t, strings.Replace(base, "%s", entry, 1), nil), pathPrefix)
   312		}
   313		fail(`{}`, "dependencies.mcp_servers.x")
   314		fail(`{"hint": ""}`, "dependencies.mcp_servers.x")
   315		fail(`{"hint": "h", "transport": "grpc"}`, "dependencies.mcp_servers.x.transport")
   316		fail(`{"hint": "h", "required_in": "some"}`, "dependencies.mcp_servers.x.required_in")
   317		fail(`{"hint": "h", "port": 1}`, "dependencies.mcp_servers.x")
   318	}
