   259	func TestRequirements(t *testing.T) {
   260		manifest := `{"schema_version": 4, "capabilities": {}, "dependencies": {"skills": {
   261			"skill-wiki": {"git": "git@example.com:skills/skill-wiki.git",
   262				"ref": {"kind": "tag", "value": "v1.4.2"}, "mode": "runtime", "commands": ["wk", "wk"]}}}}`
   263		spec, err := Load(writeSkill(t, manifest, nil))
   264		if err != nil {
   265			t.Fatal(err)
   266		}
   267		requirement := spec.Requirements["skill-wiki"]
   268		if requirement.RefKind != "tag" || requirement.RefValue != "v1.4.2" || requirement.Mode != "runtime" {
   269			t.Fatalf("requirement: %+v", requirement)
   270		}
   271		if len(requirement.Commands) != 1 || requirement.Commands[0] != "wk" {
   272			t.Fatalf("commands not deduplicated: %v", requirement.Commands)
   273		}
   274	
   275		base := `{"schema_version": 4, "capabilities": {}, "dependencies": {"skills": {"x": %s}}}`
   276		fail := func(entry, pathPrefix string) {
   277			t.Helper()
   278			mustFail(t, writeSkill(t, strings.Replace(base, "%s", entry, 1), nil), pathPrefix)
   279		}
   280		fail(`{"git": "u", "ref": {"kind": "branch", "value": "main"}}`, "dependencies.skills.x.ref")
   281		fail(`{"git": "u", "ref": {"kind": "semver", "value": "1"}}`, "dependencies.skills.x.ref.kind")
   282		fail(`{"git": "u", "ref": {"kind": "tag", "value": "^1.0"}}`, "dependencies.skills.x.ref.value")
   283		fail(`{"git": "u", "ref": {"kind": "tag", "value": ">= 1"}}`, "dependencies.skills.x.ref.value")
   284		fail(`{"git": "u", "ref": {"kind": "tag", "value": ""}}`, "dependencies.skills.x.ref.value")
   285		fail(`{"git": "u", "version": "1.2.3"}`, "dependencies.skills.x")
   286		fail(`{"ref": {"kind": "tag", "value": "v1"}}`, "dependencies.skills.x")
   287		fail(`{"git": "u", "ref": {"kind": "tag", "value": "v1"}, "mode": "lazy"}`, "dependencies.skills.x.mode")
   288		fail(`{"git": "u", "ref": {"kind": "tag", "value": "v1"}, "commands": ["c"]}`, "dependencies.skills.x.commands")
   289		fail(`{"git": "u", "ref": {"kind": "tag", "value": "v1"}, "mode": "runtime", "commands": []}`, "dependencies.skills.x.commands")
   290		fail(`{"git": "u", "ref": {"kind": "tag", "value": "v1", "extra": 1}}`, "dependencies.skills.x.ref")
   291	}
