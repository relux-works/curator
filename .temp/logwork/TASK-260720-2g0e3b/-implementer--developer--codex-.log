   169	func loadRuntimeFallback(filePath string) (*Spec, error) {
   170		data, err := decodeObject(filePath)
   171		if err != nil {
   172			return nil, err
   173		}
   174		rawCommands, _ := data["commands"].(map[string]any)
   175		if data["commands"] != nil && rawCommands == nil {
   176			return nil, verr.New("commands", "agents/runtime.json field 'commands' must be an object")
   177		}
   178		commands := map[string]Command{}
   179		for name, rawPath := range rawCommands {
   180			if name == "" {
   181				return nil, verr.New("commands", "runtime command names must be non-empty strings")
   182			}
   183			if !identifiers.Valid(name) {
   184				return nil, verr.New("commands."+name, "runtime command name %s", identifiers.Rule)
   185			}
   186			rel, ok := rawPath.(string)
   187			if !ok || rel == "" {
   188				return nil, verr.New("commands."+name, "path must be a non-empty string")
   189			}
   190			if _, err := validateRelativePath(rel, "commands."+name, false); err != nil {
   191				return nil, err
   192			}
   193			command := Command{Name: name, Type: "script", UnixPath: rel}
   194			if strings.HasSuffix(rel, ".cmd") {
   195				command.WinPath = rel
   196			}
   197			commands[name] = command
   198		}
   199		return &Spec{
   200			SchemaVersion: 1,
   201			SourceFile:    "agents/runtime.json",
   202			Capabilities:  capabilities.ImplicitNone(),
   203			Commands:      commands,
   204		}, nil
   205	}
   206	
   207	func parseCommands(raw any, schema int, snapshot string, runtimeRoots []string) (map[string]Command, error) {
   208		if raw == nil {
   209			return map[string]Command{}, nil
   210		}
   211		obj, ok := raw.(map[string]any)
   212		if !ok {
   213			return nil, verr.New("commands", "must be an object")
   214		}
   215		commands := map[string]Command{}
   216		for name, rawEntry := range obj {
   217			label := "commands." + name
   218			if name == "" {
   219				return nil, verr.New("commands", "command names must be non-empty strings")
   220			}
   221			if !identifiers.Valid(name) {
   222				return nil, verr.New(label, "command name %s", identifiers.Rule)
   223			}
   224			entry, ok := rawEntry.(map[string]any)
   225			if !ok {
   226				return nil, verr.New(label, "must be an object")
   227			}
   228			switch entry["type"] {
   229			case "script":
   230				if schema >= 2 {
   231					if err := rejectUnknown(entry, map[string]bool{"type": true, "unix_path": true, "win_path": true}, label); err != nil {
   232						return nil, err
   233					}
   234				}
   235				unixPath, unixSet, err := optionalPath(entry, "unix_path", label, schema >= 2)
   236				if err != nil {
   237					return nil, err
   238				}
   239				winPath, winSet, err := optionalPath(entry, "win_path", label, schema >= 2)
   240				if err != nil {
   241					return nil, err
   242				}
   243				if schema >= 2 && !unixSet && !winSet {
   244					return nil, verr.New(label, "script command requires 'unix_path' or 'win_path'")
   245				}
   246				if schema >= 2 {
   247					for field, rel := range map[string]string{"unix_path": unixPath, "win_path": winPath} {
   248						if rel == "" {
   249							continue
   250						}
   251						if err := validateScriptFile(snapshot, rel, runtimeRoots, label+"."+field); err != nil {
   252							return nil, err
   253						}
   254					}
   255				}
   256				commands[name] = Command{Name: name, Type: "script", UnixPath: unixPath, WinPath: winPath}
   257			case "system":
   258				if schema >= 2 {
   259					if err := rejectUnknown(entry, map[string]bool{"type": true, "command": true, "hint": true}, label); err != nil {
   260						return nil, err
   261					}
   262				}
   263				binary, ok := entry["command"].(string)
   264				if !ok || binary == "" {
   265					return nil, verr.New(label, "system command requires non-empty 'command'")
   266				}
   267				hint, err := optionalString(entry, "hint", label)
   268				if err != nil {
   269					return nil, err
   270				}
   271				commands[name] = Command{Name: name, Type: "system", Command: binary, Hint: hint}
   272			default:
   273				return nil, verr.New(label, "has unsupported type %v", entry["type"])
   274			}
   275		}
   276		return commands, nil
   277	}
   278	
   279	func parseDependencies(raw any, schema int) (map[string]CommandDependency, map[string]Requirement, map[string]McpServer, error) {
   280		empty := func() (map[string]CommandDependency, map[string]Requirement, map[string]McpServer, error) {
   281			return map[string]CommandDependency{}, map[string]Requirement{}, map[string]McpServer{}, nil
   282		}
   283		if raw == nil {
   284			return empty()
   285		}
   286		if schema < 2 {
   287			return nil, nil, nil, verr.New("dependencies", "requires schema_version 2 or newer")
   288		}
   289		obj, ok := raw.(map[string]any)
   290		if !ok {
   291			return nil, nil, nil, verr.New("dependencies", "must be an object")
   292		}
   293		if _, present := obj["skills"]; present && schema < 4 {
   294			return nil, nil, nil, verr.New("dependencies.skills", "requires schema_version 4")
   295		}
   296		if _, present := obj["mcp_servers"]; present && schema < 5 {
   297			return nil, nil, nil, verr.New("dependencies.mcp_servers", "requires schema_version 5")
   298		}
   299		allowed := map[string]bool{"commands": true}
   300		if schema >= 4 {
   301			allowed["skills"] = true
   302		}
   303		if schema >= 5 {
   304			allowed["mcp_servers"] = true
   305		}
   306		if err := rejectUnknown(obj, allowed, "dependencies"); err != nil {
   307			return nil, nil, nil, err
   308		}
   309	
   310		requirements, err := parseRequirements(obj["skills"])
   311		if err != nil {
   312			return nil, nil, nil, err
   313		}
   314		mcpServers, err := parseMcpServers(obj["mcp_servers"])
   315		if err != nil {
   316			return nil, nil, nil, err
   317		}
   318	
   319		dependencies := map[string]CommandDependency{}
   320		if rawCommands := obj["commands"]; rawCommands != nil {
   321			commandsObj, ok := rawCommands.(map[string]any)
   322			if !ok {
   323				return nil, nil, nil, verr.New("dependencies.commands", "must be an object")
   324			}
   325			for name, rawEntry := range commandsObj {
   326				label := "dependencies.commands." + name
   327				if name == "" {
   328					return nil, nil, nil, verr.New("dependencies.commands", "dependency command names must be non-empty strings")
   329				}
   330				if !identifiers.Valid(name) {
   331					return nil, nil, nil, verr.New(label, "dependency command name %s", identifiers.Rule)
   332				}
   333				entry, ok := rawEntry.(map[string]any)
   334				if !ok {
   335					return nil, nil, nil, verr.New(label, "must be an object")
   336				}
   337				hint, err := optionalString(entry, "hint", label)
   338				if err != nil {
   339					return nil, nil, nil, err
   340				}
   341				switch entry["type"] {
   342				case "system":
   343					if err := rejectUnknown(entry, map[string]bool{"type": true, "command": true, "hint": true}, label); err != nil {
   344						return nil, nil, nil, err
   345					}
   346					binary, ok := entry["command"].(string)
   347					if !ok || binary == "" {
   348						return nil, nil, nil, verr.New(label, "system dependency requires non-empty 'command'")
   349					}
   350					dependencies[name] = CommandDependency{Name: name, Type: "system", Command: binary, Hint: hint}
   351				case "skill":
   352					if err := rejectUnknown(entry, map[string]bool{"type": true, "skill": true, "command": true, "hint": true}, label); err != nil {
   353						return nil, nil, nil, err
   354					}
   355					skill, ok := entry["skill"].(string)
   356					if !ok || skill == "" || !identifiers.Valid(skill) {
   357						return nil, nil, nil, verr.New(label, "skill dependency requires a valid 'skill' name (%s)", identifiers.Rule)
   358					}
   359					command, ok := entry["command"].(string)
   360					if !ok || command == "" || !identifiers.Valid(command) {
   361						return nil, nil, nil, verr.New(label, "skill dependency requires a valid 'command' name (%s)", identifiers.Rule)
   362					}
   363					dependencies[name] = CommandDependency{Name: name, Type: "skill", Skill: skill, Command: command, Hint: hint}
   364				default:
   365					return nil, nil, nil, verr.New(label, "has unsupported type %v", entry["type"])
   366				}
   367			}
   368		}
   369		return dependencies, requirements, mcpServers, nil
   370	}
   371	
   372	func parseRequirements(raw any) (map[string]Requirement, error) {
   373		requirements := map[string]Requirement{}
   374		if raw == nil {
   375			return requirements, nil
   376		}
   377		obj, ok := raw.(map[string]any)
   378		if !ok {
   379			return nil, verr.New("dependencies.skills", "must be an object")
   380		}
   381		for name, rawEntry := range obj {
   382			label := "dependencies.skills." + name
   383			if name == "" {
   384				return nil, verr.New("dependencies.skills", "skill requirement names must be non-empty strings")
   385			}
   386			if !identifiers.Valid(name) {
   387				return nil, verr.New(label, "skill requirement name %s", identifiers.Rule)
   388			}
   389			entry, ok := rawEntry.(map[string]any)
   390			if !ok {
   391				return nil, verr.New(label, "must be an object")
   392			}
   393			if _, present := entry["version"]; present {
   394				return nil, verr.New(label, "declares 'version'; version ranges are not supported. Pin an exact ref: {\"kind\": \"tag\" | \"revision\", \"value\": ...}")
   395			}
   396			if err := rejectUnknown(entry, map[string]bool{"git": true, "ref": true, "mode": true, "commands": true}, label); err != nil {
   397				return nil, err
   398			}
   399	
   400			git, ok := entry["git"].(string)
   401			if !ok || git == "" {
   402				return nil, verr.New(label, "requires a non-empty 'git' source URL")
   403			}
   404	
   405			ref, ok := entry["ref"].(map[string]any)
   406			if !ok {
   407				return nil, verr.New(label, "requires a 'ref' object with 'kind' and 'value'")
   408			}
   409			if err := rejectUnknown(ref, map[string]bool{"kind": true, "value": true}, label+".ref"); err != nil {
   410				return nil, err
   411			}
   412			kind, _ := ref["kind"].(string)
   413			if kind == "branch" {
   414				return nil, verr.New(label+".ref", "pins a branch; skill requirements accept exact 'tag' or 'revision' refs only")
   415			}
   416			if !requirementRefKinds[kind] {
   417				return nil, verr.New(label+".ref.kind", "must be 'tag' or 'revision'")
   418			}
   419			value, _ := ref["value"].(string)
   420			if value == "" {
   421				return nil, verr.New(label+".ref.value", "must be a non-empty string")
   422			}
   423			for _, marker := range rangeMarkers {
   424				if strings.Contains(value, marker) {
   425					return nil, verr.New(label+".ref.value", "%q looks like a version range; skill requirements accept exact tags or revisions only", value)
   426				}
   427			}
   428	
   429			mode := "full"
   430			if rawMode, present := entry["mode"]; present {
   431				mode, _ = rawMode.(string)
   432				if !requirementModes[mode] {
   433					return nil, verr.New(label+".mode", "must be one of full, runtime, or context")
   434				}
   435			}
   436	
   437			var commands []string
   438			if rawCommands, present := entry["commands"]; present {
   439				if mode != "runtime" {
   440					return nil, verr.New(label+".commands", "applies to runtime requirements only")
   441				}
   442				list, ok := rawCommands.([]any)
   443				if !ok || len(list) == 0 {
   444					return nil, verr.New(label+".commands", "must be a non-empty list of command names")
   445				}
   446				seen := map[string]bool{}
   447				for _, item := range list {
   448					command, ok := item.(string)
   449					if !ok || command == "" {
   450						return nil, verr.New(label+".commands", "entries must be non-empty strings")
   451					}
   452					if !identifiers.Valid(command) {
   453						return nil, verr.New(label+".commands", "entry %q %s", command, identifiers.Rule)
   454					}
   455					if !seen[command] {
   456						seen[command] = true
   457						commands = append(commands, command)
   458					}
   459				}
   460			}
   461	
   462			requirements[name] = Requirement{Name: name, Git: git, RefKind: kind, RefValue: value, Mode: mode, Commands: commands}
   463		}
   464		return requirements, nil
   465	}
   466	
   467	func parseMcpServers(raw any) (map[string]McpServer, error) {
   468		servers := map[string]McpServer{}
   469		if raw == nil {
   470			return servers, nil
   471		}
   472		obj, ok := raw.(map[string]any)
   473		if !ok {
   474			return nil, verr.New("dependencies.mcp_servers", "must be an object")
   475		}
   476		for name, rawEntry := range obj {
   477			label := "dependencies.mcp_servers." + name
   478			if name == "" {
   479				return nil, verr.New("dependencies.mcp_servers", "MCP server names must be non-empty strings")
   480			}
   481			if !identifiers.Valid(name) {
   482				return nil, verr.New(label, "MCP server name %s", identifiers.Rule)
   483			}
   484			entry, ok := rawEntry.(map[string]any)
   485			if !ok {
   486				return nil, verr.New(label, "must be an object")
   487			}
   488			if err := rejectUnknown(entry, map[string]bool{"hint": true, "transport": true, "required_in": true}, label); err != nil {
   489				return nil, err
   490			}
   491			hint, ok := entry["hint"].(string)
   492			if !ok || hint == "" {
   493				return nil, verr.New(label, "requires a non-empty 'hint' describing how to connect the server")
   494			}
   495			transport := ""
   496			if rawTransport, present := entry["transport"]; present && rawTransport != nil {
   497				transport, _ = rawTransport.(string)
   498				if !mcpTransports[transport] {
   499					return nil, verr.New(label+".transport", "must be 'stdio' or 'http'")
   500				}
   501			}
   502			requiredIn := "any"
   503			if rawRequired, present := entry["required_in"]; present {
   504				requiredIn, _ = rawRequired.(string)
   505				if !mcpRequiredIn[requiredIn] {
   506					return nil, verr.New(label+".required_in", "must be 'any' or 'all'")
   507				}
   508			}
   509			servers[name] = McpServer{Name: name, Hint: hint, Transport: transport, RequiredIn: requiredIn}
   510		}
   511		return servers, nil
   512	}
   513	
   514	// parseRuntimeRoots validates runtime_roots per Spec §5.3: POSIX-relative,
   515	// existing directories, unique, pairwise disjoint.
   516	func parseRuntimeRoots(raw any, snapshot string) ([]string, error) {
   517		list, ok := raw.([]any)
   518		if !ok {
   519			return nil, verr.New("runtime_roots", "must be a list")
   520		}
   521		roots := make([]string, 0, len(list))
   522		for index, item := range list {
   523			field := fmt.Sprintf("runtime_roots[%d]", index)
   524			text, ok := item.(string)
   525			if !ok {
   526				return nil, verr.New(field, "must be a non-empty string")
   527			}
   528			root, err := validateRelativePath(text, field, true)
   529			if err != nil {
   530				return nil, err
   531			}
   532			info, statErr := os.Stat(filepath.Join(snapshot, filepath.FromSlash(root)))
   533			if statErr != nil {
   534				return nil, verr.New(field, "runtime root does not exist: %s", root)
   535			}
   536			if !info.IsDir() {
   537				return nil, verr.New(field, "runtime root must be a directory: %s", root)
   538			}
   539			roots = append(roots, root)
   540		}
   541		seen := map[string]bool{}
   542		for _, root := range roots {
   543			if seen[root] {
   544				return nil, verr.New("runtime_roots", "must be unique after normalization")
   545			}
   546			seen[root] = true
   547		}
   548		sorted := append([]string(nil), roots...)
   549		sort.Strings(sorted)
   550		for i, left := range sorted {
   551			for _, right := range sorted[i+1:] {
   552				if pathContains(left, right) || pathContains(right, left) {
   553					container, contained := left, right
   554					if pathContains(right, left) {
   555						container, contained = right, left
   556					}
   557					return nil, verr.New("runtime_roots", "must be disjoint: %s contains %s", container, contained)
   558				}
   559			}
   560		}
   561		return roots, nil
   562	}
   563	
   564	func validateScriptFile(snapshot, rel string, runtimeRoots []string, label string) error {
   565		info, err := os.Stat(filepath.Join(snapshot, filepath.FromSlash(rel)))
   566		if err != nil {
   567			return verr.New(label, "source file not found: %s", rel)
   568		}
   569		if info.IsDir() {
   570			return verr.New(label, "must point to a file: %s", rel)
   571		}
   572		if len(runtimeRoots) > 0 {
   573			for _, root := range runtimeRoots {
   574				if pathContains(root, rel) {
   575					return nil
   576				}
   577			}
   578			return verr.New(label, "command path %q is not inside any runtime_roots", rel)
   579		}
   580		return nil
   581	}
   582	
   583	// validateRelativePath enforces the relative path rules of Spec §5.4/§5.3.
   584	// strictPosix additionally rejects backslashes, doubled slashes, and "."
   585	// segments.
   586	func validateRelativePath(value, field string, strictPosix bool) (string, error) {
   587		if value == "" {
   588			return "", verr.New(field, "must be a non-empty string")
   589		}
   590		if !identifiers.PortablePath(value) {
   591			if strictPosix && (strings.Contains(value, `\`) || strings.Contains(value, "//")) {
   592				return "", verr.New(field, "must be a POSIX-style relative path inside the skill repository")
   593			}
   594			return "", verr.New(field, "must be a portable relative path inside the skill repository")
   595		}
   596		return value, nil
   597	}
   598	
   599	func pathContains(root, rel string) bool {
   600		rootParts := strings.Split(root, "/")
   601		relParts := strings.Split(rel, "/")
   602		if len(relParts) < len(rootParts) {
   603			return false
   604		}
   605		for i, part := range rootParts {
   606			if relParts[i] != part {
   607				return false
   608			}
   609		}
   610		return true
   611	}
   612	
   613	func decodeObject(filePath string) (map[string]any, error) {
   614		payload, err := os.ReadFile(filePath) // #nosec G304 -- manifest path is derived from the snapshot directory
   615		if err != nil {
   616			return nil, err
   617		}
   618		if err := protocoljson.Validate(payload); err != nil {
   619			return nil, fmt.Errorf("malformed JSON in %s: %w", filePath, err)
   620		}
   621		var raw any
   622		if err := json.Unmarshal(payload, &raw); err != nil {
   623			return nil, fmt.Errorf("malformed JSON in %s: %w", filePath, err)
   624		}
   625		obj, ok := raw.(map[string]any)
   626		if !ok {
   627			return nil, fmt.Errorf("%s must contain a JSON object", filePath)
   628		}
   629		return obj, nil
   630	}
   631	
   632	// intField extracts an integer field, rejecting booleans and fractions.
   633	func intField(obj map[string]any, key string) (int, error) {
   634		raw, present := obj[key]
   635		if !present {
   636			return 0, fmt.Errorf("missing %s", key)
   637		}
   638		number, ok := raw.(float64)
   639		if !ok || number != float64(int(number)) {
   640			return 0, fmt.Errorf("%s is not an integer", key)
   641		}
   642		return int(number), nil
   643	}
   644	
   645	func optionalString(entry map[string]any, key, label string) (string, error) {
   646		raw, present := entry[key]
   647		if !present || raw == nil {
   648			return "", nil
   649		}
   650		text, ok := raw.(string)
   651		if !ok {
   652			return "", verr.New(label+"."+key, "must be a string")
   653		}
   654		return text, nil
   655	}
   656	
   657	func optionalPath(entry map[string]any, key, label string, strictPosix bool) (string, bool, error) {
   658		raw, present := entry[key]
   659		if !present || raw == nil {
   660			return "", false, nil
   661		}
   662		text, ok := raw.(string)
   663		if !ok {
   664			return "", false, verr.New(label+"."+key, "must be a non-empty string")
   665		}
   666		clean, err := validateRelativePath(text, label+"."+key, strictPosix)
   667		if err != nil {
   668			return "", false, err
   669		}
   670		return clean, true, nil
   671	}
   672	
   673	func rejectUnknown(obj map[string]any, allowed map[string]bool, label string) error {
   674		var unknown []string
   675		for key := range obj {
   676			if !allowed[key] {
   677				unknown = append(unknown, key)
   678			}
   679		}
   680		if len(unknown) == 0 {
   681			return nil
   682		}
   683		sort.Strings(unknown)
   684		return verr.New(label, "has unsupported field(s): %s", strings.Join(unknown, ", "))
   685	}
   120							content = "{"
   121						}
   122						if err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {
   123							t.Fatal(err)
   124						}
   125					}
   126					if _, err := Load(dir); err == nil {
   127						t.Fatal("invalid peer was ignored")
   128					}
   129				})
   130			}
   131		})
   132	}
