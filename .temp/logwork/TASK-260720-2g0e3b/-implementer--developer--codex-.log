   293	func TestMcpServers(t *testing.T) {
   294		manifest := `{"schema_version": 5, "capabilities": {}, "dependencies": {"mcp_servers": {
   295			"google-sheets": {"hint": "connect it", "transport": "http", "required_in": "all"},
   296			"tracker": {"hint": "connect tracker"}}}}`
