+func TestSchemaV6RejectsLinkedGoMod(t *testing.T) {
+	dir := writeSkill(t, `{"schema_version":6,"capabilities":{},"build_roots":["build"],"commands":{`+validBuildCommand+`}}`, map[string]string{
+		"build/cmd/tool/main.go": "package main\n",
