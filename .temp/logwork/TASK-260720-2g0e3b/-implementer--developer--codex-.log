   165	func TestRuntimeRoots(t *testing.T) {
   166		files := map[string]string{"scripts/tool": "#!/bin/sh\n", "lib/util.py": ""}
   167		ok := writeSkill(t, `{"schema_version": 2, "runtime_roots": ["scripts", "lib"]}`, files)
   168		spec, err := Load(ok)
   169		if err != nil {
   170			t.Fatal(err)
   171		}
   172		if len(spec.RuntimeRoots) != 2 {
   173			t.Fatalf("runtime roots: %v", spec.RuntimeRoots)
   174		}
   175	
   176		mustFail(t, writeSkill(t, `{"schema_version": 2, "runtime_roots": ["missing"]}`, nil), "runtime_roots[0]")
   177		mustFail(t, writeSkill(t, `{"schema_version": 2, "runtime_roots": ["scripts/tool"]}`, files), "runtime_roots[0]")
   178		mustFail(t, writeSkill(t, `{"schema_version": 2, "runtime_roots": ["scripts", "scripts"]}`, files), "runtime_roots")
   179		mustFail(t, writeSkill(t, `{"schema_version": 2, "runtime_roots": ["../out"]}`, files), "runtime_roots[0]")
   180		mustFail(t, writeSkill(t, `{"schema_version": 2, "runtime_roots": ["a//b"]}`, files), "runtime_roots[0]")
   181		mustFail(t, writeSkill(t, `{"schema_version": 2, "runtime_roots": ["./scripts"]}`, files), "runtime_roots[0]")
   182		mustFail(t, writeSkill(t, `{"schema_version": 2, "runtime_roots": ["NUL"]}`, nil), "runtime_roots[0]")
   183		// nested roots are not disjoint
   184		nested := map[string]string{"scripts/tool": "", "scripts/inner/x": ""}
   185		mustFail(t, writeSkill(t, `{"schema_version": 2, "runtime_roots": ["scripts", "scripts/inner"]}`, nested), "runtime_roots")
   186	}
