   100	func loadSkillManifest(filePath, sourceFile string) (*Spec, map[string]any, error) {
   101		data, err := decodeObject(filePath)
   102		if err != nil {
   103			return nil, nil, err
   104		}
   105		snapshot := filepath.Dir(filePath)
   106	
   107		schema, err := intField(data, "schema_version")
   108		if err != nil {
   109			return nil, nil, verr.New("schema_version", "%s field must be an integer", sourceFile)
   110		}
   111		if !SupportedSchemaVersions[schema] {
   112			return nil, nil, verr.New("schema_version", "unsupported value %d in %s; this skill requires a newer tool. %s", schema, sourceFile, UpgradeHint)
   113		}
   114	
   115		if schema >= 2 {
   116			allowed := map[string]bool{"schema_version": true, "runtime_roots": true, "commands": true, "dependencies": true}
   117			if schema >= 3 {
   118				allowed["capabilities"] = true
   119			}
   120			if err := rejectUnknown(data, allowed, sourceFile); err != nil {
   121				return nil, nil, err
   122			}
   123		}
   124		if schema >= 3 {
   125			if _, present := data["capabilities"]; !present {
   126				return nil, nil, verr.New("capabilities", "%s schema v%d requires 'capabilities'", sourceFile, schema)
   127			}
   128		}
   129		caps := capabilities.ImplicitNone()
   130		if schema >= 3 {
   131			caps, err = capabilities.Parse(data["capabilities"])
   132			if err != nil {
   133				return nil, nil, err
   134			}
   135		}
   136	
   137		var runtimeRoots []string
   138		if schema >= 2 {
   139			if raw, present := data["runtime_roots"]; present {
   140				runtimeRoots, err = parseRuntimeRoots(raw, snapshot)
   141				if err != nil {
   142					return nil, nil, err
   143				}
   144			}
   145		}
   146	
   147		commands, err := parseCommands(data["commands"], schema, snapshot, runtimeRoots)
   148		if err != nil {
   149			return nil, nil, err
   150		}
   151	
   152		dependencies, requirements, mcpServers, err := parseDependencies(data["dependencies"], schema)
   153		if err != nil {
   154			return nil, nil, err
   155		}
   156	
   157		return &Spec{
   158			SchemaVersion: schema,
   159			SourceFile:    sourceFile,
   160			RuntimeRoots:  runtimeRoots,
   161			Capabilities:  caps,
   162			Commands:      commands,
   163			Dependencies:  dependencies,
   164			Requirements:  requirements,
   165			McpServers:    mcpServers,
   166		}, data, nil
   167	}
