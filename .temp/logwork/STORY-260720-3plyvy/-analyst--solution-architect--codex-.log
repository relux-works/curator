          "content_sha256": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        },
        "policy": {
          "module_mode": "vendor",
          "network": "none",
          "workspace": false,
          "cgo": false,
          "compiler_directives": "reject-nonstandard-cgo-import-dynamic-v1",
          "target_mode": "native",
