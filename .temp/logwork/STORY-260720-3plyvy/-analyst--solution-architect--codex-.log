./diagrams/artefacts/plantuml/STORY-260720-35dck7_install-lifecycle.svg:1:<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" contentStyleType="text/css" data-diagram-type="ACTIVITY" height="2227px" preserveAspectRatio="none" style="width:988px;height:2227px;background:#FFFFFF;" version="1.1" viewBox="0 0 988 2227" width="988px" zoomAndPan="magnify"><?plantuml 1.2026.6?><defs/><g><g class="title" data-source-line="3"><text fill="#000000" font-family="Verdana" font-size="22" font-weight="700" lengthAdjust="spacing" textLength="756.1104" x="114.9641" y="37.1182">Protocol schema v6 &#8212; normative install and dry-run ordering</text></g><ellipse cx="397.4961" cy="67.7373" fill="#FFFFFF" rx="10" ry="10" style="stroke:#000000;stroke-width:1;"/><rect fill="#ADD8E6" height="534.8545" style="stroke:#000000;stroke-width:1;" width="438.1914" x="178.4004" y="87.7373"/><path d="M324.4834,87.7373 L324.4834,97.752 L314.4834,107.752 L178.4004,107.752" fill="none" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="14" lengthAdjust="spacing" textLength="136.083" x="181.4004" y="102.8125">Read-only planning</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="199.7305" x="297.6309" y="124.752"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="179.7305" x="307.6309" y="146.8164">Resolve immutable snapshots</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="325.0508" x="234.9707" y="179.3359"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="305.0508" x="244.9707" y="201.4004">Parse both manifest names and validate schema 6</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="336.9453" x="229.0234" y="233.9199"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="316.9453" x="239.0234" y="255.9844">Validate link-free disjoint build_roots and source_dir</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="418.1914" x="188.4004" y="288.5039"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="398.1914" x="198.4004" y="310.5684">Exclude every build_root from agent context and runtime copying</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="347.2051" x="223.8936" y="343.0879"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="327.2051" x="233.8936" y="365.1523">Compute curator-build-source-v1 before cache lookup</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="303.7168" x="245.6377" y="397.6719"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="283.7168" x="255.6377" y="419.7363">Build provider-first closure and check collisions</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="387.8809" x="203.5557" y="452.2559"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="367.8809" x="213.5557" y="474.3203">Run source audit, registry, attestation, and moved-tag gates</text><rect fill="#FFFFFF" height="49.168" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="296.4336" x="249.2793" y="506.8398"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="276.4336" x="259.2793" y="528.9043">Probe trusted Go, disable telemetry privately,</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="171.9961" x="259.2793" y="543.4883">and fingerprint the toolchain</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="402.6289" x="196.1816" y="576.0078"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="382.6289" x="206.1816" y="598.0723">Derive fixed build inputs and inspect protected cache read-only</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="225.4355" x="284.7783" y="691.2761"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="205.4355" x="294.7783" y="713.3406">Recheck shared-state generations</text><path d="M597.0049,741.7451 L597.0049,766.4441 L577.0049,770.4441 L597.0049,774.4441 L597.0049,799.1431 A0,0 0 0 0 597.0049,799.1431 L948.0386,799.1431 A0,0 0 0 0 948.0386,799.1431 L948.0386,751.7451 L938.0386,741.7451 L597.0049,741.7451 A0,0 0 0 0 597.0049,741.7451" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M938.0386,741.7451 L938.0386,751.7451 L948.0386,751.7451 L938.0386,741.7451" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="141.2036" x="603.0049" y="759.8149">No go list or go build.</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="270.2705" x="603.0049" y="775.6143">No persistent cache, audit, registry, lock,</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="330.0337" x="603.0049" y="791.4136">journal, marker, shim, consumer, or GC mutation.</text><rect fill="#FFFFFF" height="49.168" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="359.0176" x="217.9873" y="745.8601"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="266.3613" x="227.9873" y="767.9246">Report cache-hit, would-preflight-and-build,</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="339.0176" x="227.9873" y="782.5085">would-rebuild-untrusted-cache, corrupt, or unsupported</text><ellipse cx="397.4961" cy="830.1431" fill="none" rx="11" ry="11" style="stroke:#000000;stroke-width:1;"/><ellipse cx="397.4961" cy="830.1431" fill="#FFFFFF" rx="6" ry="6" style="stroke:#000000;stroke-width:1;"/><polygon fill="#FFFFFF" points="372.8508,642.5918,422.1414,642.5918,434.1414,654.5918,422.1414,666.5918,372.8508,666.5918,360.8508,654.5918,372.8508,642.5918" style="stroke:#000000;stroke-width:1;stroke-linejoin:miter;stroke-miterlimit:10;"/><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="18.7935" x="401.4961" y="677.6509">yes</text><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="49.2905" x="372.8508" y="658.9666">Dry-run?</text><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="77.1128" x="434.1414" y="652.2822">real operation</text><rect fill="#FFFFE0" height="261.9346" style="stroke:#000000;stroke-width:1;" width="362.7461" x="216.123" y="873.1431"/><path d="M370.1289,873.1431 L370.1289,883.1577 L360.1289,893.1577 L216.123,893.1577" fill="none" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="14" lengthAdjust="spacing" textLength="144.0059" x="219.123" y="888.2183">Private build staging</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="202.7012" x="296.1455" y="910.1577"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="182.7012" x="306.1455" y="932.2222">Run fixed go list for each miss</text><rect fill="#FFFFFF" height="49.168" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="295.6016" x="249.6953" y="964.7417"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="275.6016" x="259.6953" y="986.8062">Reject escaped inputs, cgo, native files, syso,</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="238.1309" x="259.6953" y="1001.3901">assembly, and go:cgo_import_dynamic</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="206.2461" x="294.373" y="1033.9097"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="186.2461" x="304.373" y="1055.9741">Run fixed internal-link go build</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="342.7461" x="226.123" y="1088.4937"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="322.7461" x="236.123" y="1110.5581">Verify and hash artifacts; generate canonical receipts</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="168.3125" x="313.3398" y="1203.762"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="148.3125" x="323.3398" y="1225.8264">Delete operation staging</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="370.0156" x="212.4883" y="1258.3459"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="350.0156" x="222.4883" y="1280.4104">Leave installation, consumers, and live caches unchanged</text><ellipse cx="397.4961" cy="1323.9299" fill="none" rx="11" ry="11" style="stroke:#000000;stroke-width:1;"/><ellipse cx="397.4961" cy="1323.9299" fill="#FFFFFF" rx="6" ry="6" style="stroke:#000000;stroke-width:1;"/><polygon fill="#FFFFFF" points="330.6045,1155.0776,464.3877,1155.0776,476.3877,1167.0776,464.3877,1179.0776,330.6045,1179.0776,318.6045,1167.0776,330.6045,1155.0776" style="stroke:#000000;stroke-width:1;stroke-linejoin:miter;stroke-miterlimit:10;"/><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="18.7935" x="401.4961" y="1190.1367">yes</text><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="133.7832" x="330.6045" y="1171.4524">Any private build failed?</text><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="13.6372" x="476.3877" y="1164.7681">no</text><rect fill="#90EE90" height="546.5789" style="stroke:#000000;stroke-width:1;" width="391.5107" x="203.1973" y="1366.9299"/><path d="M362.7607,1366.9299 L362.7607,1376.9446 L352.7607,1386.9446 L203.1973,1386.9446" fill="none" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="14" lengthAdjust="spacing" textLength="149.5635" x="206.1973" y="1382.0051">Serialized publication</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="248.3457" x="273.3232" y="1403.9446"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="228.3457" x="283.3232" y="1426.009">Acquire manager-home mutation lock</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="368.5977" x="213.1973" y="1458.5286"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="348.5977" x="223.1973" y="1480.593">Recover journals and revalidate cache and shared targets</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="330.4238" x="232.2842" y="1561.7969"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="310.4238" x="242.2842" y="1583.8613">Release lock and restart from earliest affected read</text><ellipse cx="397.4961" cy="1635.5889" fill="none" rx="11" ry="11" style="stroke:#000000;stroke-width:1;"/><ellipse cx="397.4961" cy="1635.5889" fill="#FFFFFF" rx="6" ry="6" style="stroke:#000000;stroke-width:1;"/><polygon fill="#