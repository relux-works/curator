		}
		if got := VerifyPlanPathShapeOnly(line, pol).OK(); got != tc.retiredAdmits {
			t.Errorf("retired verifier admits %q = %v, measured %v", tc.vector, got, tc.retiredAdmits)
		}
	}
}

