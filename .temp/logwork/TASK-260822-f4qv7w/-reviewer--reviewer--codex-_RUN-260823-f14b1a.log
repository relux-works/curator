        }
        for label, mutate in mutations.items():
            with self.subTest(label=label):
                changed = copy.deepcopy(vector)
                mutate(changed)
                with self.assertRaises(validate.ValidationFailure):
                    validate.validate_script_host_execution_policy(changed)

