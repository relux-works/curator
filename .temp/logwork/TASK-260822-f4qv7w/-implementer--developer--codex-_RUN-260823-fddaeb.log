name: Specification CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: specification-${{ github.ref }}
  cancel-in-progress: true

jobs:
  validate:
    name: Specification (${{ matrix.os }})
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          fetch-depth: 0

      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6.5.0
        with:
          go-version-file: go.mod
          cache: false

      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: requirements-dev.txt

      - name: Install validation dependencies
        run: python -m pip install -r requirements-dev.txt

      - name: Validate schemas, cases, manifest, and local links
        run: python tools/validate.py

      - name: Test stable release gate
        run: python -B -m unittest discover -s tools -p 'test_*.py'

      - name: Verify generator and cryptographic vectors
        run: go test ./tools/...

      - name: Regenerate authoritative vectors
        run: go run ./tools/generate-vectors -root .

      - name: Prove deterministic regeneration
        run: git diff --exit-code -- conformance/v1 release/1.0.0-rc.5.json release/1.0.0-rc.6.json release/1.0.0-rc.7.json release/1.0.0-rc.8.json

  formatting:
    name: Formatting
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - name: Check Go formatting
        run: |
          files="$(gofmt -l tools)"
          test -z "$files" || { echo "$files"; exit 1; }
      - name: Check whitespace
        run: git diff --check

  links:
    name: Links
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - uses: lycheeverse/lychee-action@e7477775783ea5526144ba13e8db5eec57747ce8 # v2.9.0
        with:
          args: >-
            --no-progress
            --max-retries 3
            --retry-wait-time 2
            --accept 200,206,429
            '**/*.md'
          fail: true

  release-provenance:
    name: Release target provenance
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    env:
      PYTHONDONTWRITEBYTECODE: "1"
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          fetch-depth: 0
      - name: Reject unsigned main-branch release targets
        env:
          GITHUB_DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
          GITHUB_TOKEN: ${{ github.token }}
        run: |
          git config gpg.format ssh
          git config gpg.ssh.allowedSignersFile "$PWD/maintainers.allowed_signers"
          git fetch --no-tags origin "$GITHUB_DEFAULT_BRANCH:refs/remotes/origin/$GITHUB_DEFAULT_BRANCH"
          python -B tools/verify_release_commit.py --commit "$GITHUB_SHA"
name: Implementation conformance

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: implementations-${{ github.ref }}
  cancel-in-progress: true

jobs:
  conformance:
    name: Implementations (${{ matrix.os }})
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    env:
      CURATOR_CONFORMANCE_ROOT: ${{ github.workspace }}/conformance/v1
    steps:
      - name: Checkout specification
        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0

      - name: Checkout Go manager
        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          repository: relux-works/curator
          # relux-works/curator PR 9 head. Its interop gate reads the lifecycle
          # vector by case name, so it accepts the rc.6 dry-run case
          # `compiled-cache-miss-is-read-only` that 17804ce rejected on length.
          ref: bd6ba08acda3dc801512c408c759ac0ac6f79f26
          path: implementations/go
          submodules: true

      - name: Checkout Python manager
        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          repository: ivanopcode/cocoaskills
          ref: 6fc2fd97dbdf40f5b0e46f846eaa0d78a1b33d12
          path: implementations/manager

      - name: Checkout registry service
        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          repository: relux-works/curator-skill-registry
          ref: d690bea6fab1c8e6392e05d3a3cdfcf1168bc914
          path: implementations/registry

      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6.5.0
        with:
          go-version-file: implementations/go/go.mod
          cache: false

      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: "3.12"

      - name: Install Python implementations
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e "./implementations/manager[dev]" -e "./implementations/registry[dev]"

      - name: Go manager shared suite
        working-directory: implementations/go
        run: go test -count=1 -v ./internal/interop ./internal/closure ./internal/skillspec

      - name: Python manager shared suite
        run: >-
          python tools/run_pytest_no_skips.py -q
          implementations/manager/tests/test_protocol_conformance.py

      - name: Python manager lifecycle behavior
        run: >-
          python -m pytest -q
          implementations/manager/tests/test_cli.py::test_cli_bootstrap_if_missing_keeps_existing_config
          implementations/manager/tests/test_cli.py::test_cli_bootstrap_if_missing_creates_absent_config
          implementations/manager/tests/test_cli.py::test_cli_bootstrap_if_missing_and_force_are_mutually_exclusive
          implementations/manager/tests/test_cli.py::test_cli_upgrade_dry_run_does_not_create_or_fetch_skills_root
          implementations/manager/tests/test_cli.py::test_cli_upgrade_fetches_only_selected_project_skill_repositories
          implementations/manager/tests/test_closure_install.py::test_upgrade_fetches_transitive_dependency_closure
          implementations/manager/tests/test_global_install.py::test_global_upgrade_dry_run_does_not_create_or_fetch_skills_root
          implementations/manager/tests/test_install.py::test_runtime_shim_resolves_project_skill_command_dependency_without_shell_hook
          implementations/manager/tests/test_install.py::test_runtime_shim_captures_declared_system_dependency_path
          implementations/manager/tests/test_shims.py::test_unix_wrapper_prepends_runtime_path_entries
          implementations/manager/tests/test_shims.py::test_windows_wrapper_prepends_runtime_path_entries

      - name: Registry service shared suite
        run: >-
          python tools/run_pytest_no_skips.py -q
          implementations/registry/tests/test_protocol_conformance.py

