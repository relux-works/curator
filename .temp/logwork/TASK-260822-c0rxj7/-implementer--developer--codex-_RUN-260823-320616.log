diff --git a/.temp/TASK-260822-c0rxj7/curator-spec-candidate/schemas/v1/conformance-claim-v5.schema.json b/.temp/TASK-260822-c0rxj7/curator-spec-candidate/schemas/v1/conformance-claim-v5.schema.json
