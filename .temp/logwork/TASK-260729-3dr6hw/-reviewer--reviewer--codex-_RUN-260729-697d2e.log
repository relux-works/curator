    15	// A one-way mutation of a declaration document is not the whole race. Every
    16	// supported writer rewrites its manifest in place, so a declaration can also go
    17	// A -> B -> A *around* the read: the closure is resolved from the transient B
    18	// while both the state before and the state at commit time are byte-identical A.
    19	// A generation taken from the path as a separate operation cannot see that — both
    20	// samples are A — and the run commits context, shims, adapters, and consumer
    21	// state for a declaration set that exists nowhere.
    22	//
    23	// Each case below drives exactly that sequence through the real writer of its
    24	// document: the transient generation is applied inside the single read that feeds
    25	// the parser, and the byte-identical restoration lands at the pre-home-lock
    26	// boundary, where OnStaged fires after every private build succeeded and before
    27	// the commit phase acquires the manager-home lock. Each then requires a closure
    28	// restart and proves the transient declaration reached no shared state.
    29	
    30	// duringDocumentRead applies change inside the one read of target that binds a
    31	// generation to the bytes the parser consumes. It fires once, so the restarted
    32	// attempt reads the settled document, and it fails the test if the window never
    33	// opened — a case whose mutation missed the read would assert nothing.
    34	func duringDocumentRead(t *testing.T, target string, change func() error) {
    35		t.Helper()
    36		fired := false
    37		afterDocumentOpen = func(path string) {
    38			if fired || path != target {
    39				return
    40			}
    41			fired = true
    42			if err := change(); err != nil {
    43				t.Errorf("apply the transient generation of %s: %v", path, err)
    44			}
    45		}
    46		t.Cleanup(func() {
    47			afterDocumentOpen = nil
    48			if !fired {
    49				t.Errorf("the read window never opened for %s, so no transient generation was parsed", target)
    50			}
    51		})
    52	}
    53	
    54	// settledBytes records the document a case starts from, after canonicalizing it
    55	// through its real writer, so the restoration can be proven byte-identical
    56	// instead of merely equivalent.
    57	func settledBytes(t *testing.T, path string) []byte {
    58		t.Helper()
    59		payload, err := os.ReadFile(path)
    60		if err != nil {
    61			t.Fatal(err)
    62		}
    63		return payload
    64	}
    65	
    66	// assertRestoredByteIdentically proves the case really exercised the ABA window
    67	// rather than the one-way mutation the earlier cases already cover: if the
    68	// restoration changed a single byte, the recheck would catch the difference for
    69	// the wrong reason.
    70	func assertRestoredByteIdentically(t *testing.T, path string, settled []byte) {
    71		t.Helper()
    72		current, err := os.ReadFile(path)
    73		if err != nil {
    74			t.Fatal(err)
    75		}
    76		if !bytes.Equal(current, settled) {
    77			t.Fatalf("the exercise did not restore %s byte-identically:\nsettled = %q\ncurrent = %q",
    78				path, settled, current)
    79		}
    80	}
