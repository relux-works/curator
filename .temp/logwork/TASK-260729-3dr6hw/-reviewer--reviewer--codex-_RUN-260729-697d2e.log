   177	// TestHybridActivationABAAroundTheReadRestartsClosure covers machine-home
   178	// activation through `curator hybrid add`'s writer. The declaration exists in
   179	// every state here — only its target list moves, and it moves back — so nothing
   180	// short of re-evaluating activation against the bytes the closure was built from
   181	// can drop the transiently activated skill.
   182	func TestHybridActivationABAAroundTheReadRestartsClosure(t *testing.T) {
   183		e := newEnv(t)
   184		e.skill("skill-a")
   185		e.skill("skill-h")
   186		e.declare("skill-a")
   187		if err := scopes.AddHybridDecl(e.home, "skill-h", "tag", "v1", "", []string{"some-other-project"}); err != nil {
   188			t.Fatal(err)
   189		}
   190		hybridPath := scopes.HybridManifestPath(e.home)
   191		settled := settledBytes(t, hybridPath)
   192	
   193		duringDocumentRead(t, hybridPath, func() error {
   194			return scopes.AddHybridDecl(e.home, "skill-h", "tag", "v1", "", []string{"test"})
   195		})
   196		result := e.install(Options{OnStaged: onStagedOnce(func() error {
   197			return scopes.AddHybridDecl(e.home, "skill-h", "tag", "v1", "", []string{"some-other-project"})
   198		})})
   199	
   200		assertRestoredByteIdentically(t, hybridPath, settled)
   201		assertClosureRestart(t, result, hybridActivationKey)
   202		assertEntriesAbsent(t, "hybrid state of a transiently activated skill",
   203			filepath.Join(scopes.HybridSkillsRoot(e.home), "skill-h"),
   204			filepath.Join(e.project, filepath.FromSlash(adapters.AgentPaths["claude_code"]), "skill-h"))
   205		assertEntriesPresent(t, "project state of the declared skill", projectEntries(e, "skill-a")...)
   206		assertNoJournalRemains(t, e.home)
   207	}
   208	
   209	// TestByteIdenticalRewriteDuringTheReadDoesNotRestart is the control every case
   210	// above needs in the other direction. Binding the generation to the parsed bytes
   211	// must not turn every concurrent save into a restart: a writer that rewrites a
   212	// document with the same content selects nothing new, and the run has to commit
   213	// its planned closure instead of looping until MaxRestarts.
   214	func TestByteIdenticalRewriteDuringTheReadDoesNotRestart(t *testing.T) {
   215		e := newEnv(t)
   216		e.skill("skill-a")
   217		e.declare("skill-a")
   218		manifestPath := manifestpkg.PathIn(e.project)
   219		settled := settledBytes(t, manifestPath)
   220	
   221		duringDocumentRead(t, manifestPath, func() error {
   222			return os.WriteFile(manifestPath, settled, 0o644)
   223		})
   224		result := e.install(Options{})
   225	
   226		assertRestoredByteIdentically(t, manifestPath, settled)
   227		if result.Status != "ok" {
   228			t.Fatalf("install failed: %+v", result)
   229		}
   230		if hasMessageContaining(result.Messages, "restarting from") {
   231			t.Fatalf("a rewrite that changed no byte restarted the run; messages = %v", result.Messages)
   232		}
   233		assertEntriesPresent(t, "project state of the declared skill", projectEntries(e, "skill-a")...)
   234		assertNoJournalRemains(t, e.home)
   235	}
