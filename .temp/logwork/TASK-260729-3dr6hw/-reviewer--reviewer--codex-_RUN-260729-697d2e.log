   107	// declareWithAgents writes a project Skillfile for one explicit agent set. The
   108	// selected agents reach both the install marker and the adapter roots, so a
   109	// change to them is the cheapest way to force a genuine context replacement.
   110	func (e *env) declareWithAgents(agents []string, names ...string) {
   111		e.t.Helper()
   112		skills := []map[string]any{}
   113		for _, name := range names {
   114			skills = append(skills, map[string]any{"name": name, "tag": "v1"})
   115		}
   116		payload, _ := json.MarshalIndent(map[string]any{
   117			"schema_version": 1,
   118			"agents":         agents,
   119			"skills":         skills,
   120		}, "", "  ")
   121		e.write(e.project, "Skillfile.json", string(payload))
   122		ignored := ".agents/\nSkillfile.dev.json\n"
   123		for _, agent := range agents {
   124			ignored += adapters.AgentPaths[agent] + "/\n"
   125		}
   126		e.write(e.project, ".gitignore", ignored)
   127	}
