    81		e.git(dir, "init", "-q", "-b", "main")
    82		e.write(dir, "SKILL.md", "---\nname: "+name+"\ndescription: d\n---\n# "+name+"\n")
    83		e.write(dir, "references/info.md", "ref")
    84		e.write(dir, "scripts/"+name+"-tool", "#!/bin/sh\necho "+name+"\n")
