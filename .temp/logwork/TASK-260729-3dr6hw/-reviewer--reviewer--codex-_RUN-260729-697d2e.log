    96	// declareWithAgents writes a project Skillfile for one explicit agent set. The
    97	// selected agents reach both the install marker and the adapter roots, so a
    98	// change to them is the cheapest way to force a genuine context replacement.
    99	func (e *env) declareWithAgents(agents []string, names ...string) {
   100		e.t.Helper()
   101		skills := []map[string]any{}
   102		for _, name := range names {
   103			skills = append(skills, map[string]any{"name": name, "tag": "v1"})
   104		}
   105		payload, _ := json.MarshalIndent(map[string]any{
   106			"schema_version": 1,
   107			"agents":         agents,
   108			"skills":         skills,
   109		}, "", "  ")
   110		e.write(e.project, "Skillfile.json", string(payload))
   111		ignored := ".agents/\nSkillfile.dev.json\n"
   112		for _, agent := range agents {
   113			ignored += adapters.AgentPaths[agent] + "/\n"
   114		}
   115		e.write(e.project, ".gitignore", ignored)
   116	}
