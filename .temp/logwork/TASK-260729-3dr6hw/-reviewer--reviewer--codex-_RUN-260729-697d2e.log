    64	// skill creates a tagged skill repository with one exported command.
    65	func (e *env) skill(name string) {
    66		e.t.Helper()
    67		dir := filepath.Join(e.skillsRoot, name)
    68		if err := os.MkdirAll(dir, 0o755); err != nil {
    69			e.t.Fatal(err)
    70		}
    71		e.git(dir, "init", "-q", "-b", "main")
    72		e.write(dir, "SKILL.md", "---\nname: "+name+"\ndescription: d\n---\n# "+name+"\n")
    73		e.write(dir, "references/info.md", "ref")
    74		e.write(dir, "scripts/"+name+"-tool", "#!/bin/sh\necho "+name+"\n")
    75		e.write(dir, "README.md", "dev docs")
    76		spec := map[string]any{
    77			"schema_version": 4,
    78			"capabilities":   map[string]any{},
    79			"runtime_roots":  []string{"scripts"},
    80			"commands": map[string]any{
    81				name + "-tool": map[string]any{"type": "script", "unix_path": "scripts/" + name + "-tool", "win_path": "scripts/" + name + "-tool"},
    82			},
    83		}
    84		payload, _ := json.MarshalIndent(spec, "", "  ")
    85		e.write(dir, "csk-skill.json", string(payload))
    86		e.git(dir, "add", ".")
    87		e.git(dir, "commit", "-qm", "init")
    88		e.git(dir, "tag", "v1")
    89	}
