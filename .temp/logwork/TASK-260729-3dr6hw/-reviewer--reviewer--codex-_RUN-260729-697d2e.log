   100	// TestStableHybridActivationCommitsWithoutRestarting is the control the two
   101	// mutation cases below need. Observing the hybrid manifest must only restart a
   102	// run when the manifest actually moved; if every install restarted, the
   103	// mutation assertions would prove nothing about the mutation.
   104	func TestStableHybridActivationCommitsWithoutRestarting(t *testing.T) {
   105		e := newEnv(t)
   106		e.skill("skill-a")
   107		e.skill("skill-h")
   108		e.declare("skill-a")
   109		e.hybridDeclare("skill-h")
   110	
   111		result := e.install(install.Options{})
   112		if result.Status != "ok" {
   113			t.Fatalf("install failed: %+v", result)
   114		}
   115		if hasMessageContaining(result.Messages, "restarting from") {
   116			t.Fatalf("an unchanged hybrid manifest restarted the run; messages = %v", result.Messages)
   117		}
   118		assertHybridSkillInstalled(t, e, "skill-h")
   119		assertProjectSkillInstalled(t, e, "skill-a")
   120		assertNoJournalRemains(t, e.home)
   121	}
