    91					"type": "script", "unix_path": "scripts/" + name + "-tool", "win_path": "scripts/" + name + "-tool",
    92				},
    93			},
    94		}
    95		payload, _ := json.MarshalIndent(spec, "", "  ")
    96		e.write(dir, "csk-skill.json", string(payload))
    97		e.git(dir, "add", ".")
    98		e.git(dir, "commit", "-qm", "init")
    99		e.git(dir, "tag", "v1")
