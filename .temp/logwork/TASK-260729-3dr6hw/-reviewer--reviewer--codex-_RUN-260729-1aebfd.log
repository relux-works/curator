   200			"project/adapters": filepath.Join(e.project, filepath.FromSlash(adapters.AgentPaths["claude_code"])),
   201			"project/adapters-codex": filepath.Join(e.project,
   202				filepath.FromSlash(adapters.AgentPaths["codex_cli"])),
   203			"hybrid/store":   scopes.HybridSkillsRoot(e.home),
   204			"home/runtime":   filepath.Join(e.home, "runtime"),
   205			"home/consumers": filepath.Join(e.home, scopes.ConsumersName),
   206			"global/skills":  filepath.Join(e.home, "global", "skills"),
   207			"global/bin":     filepath.Join(e.home, "global", "bin"),
   208			"global/env.sh":  filepath.Join(e.home, "global", "env.sh"),
   209		}
   210		if e.userHome != "" {
   211			paths["user/adapters"] = filepath.Join(e.userHome, filepath.FromSlash(adapters.AgentPaths["claude_code"]))
   212			paths["user/adapters-codex"] = filepath.Join(e.userHome, filepath.FromSlash(adapters.AgentPaths["codex_cli"]))
   213			paths["user/bin"] = filepath.Join(e.userHome, ".local", "bin")
   214		}
   215		state := sharedState{}
   216		for key, path := range paths {
   217			state[key] = entryDigest(path)
   218		}
   219		return state
   220	}
   221	
   222	// entryDigest reads one snapshot path exactly as it is. A symbolic link is
   223	// digested by its destination rather than dereferenced, so a mirror that was
   224	// replaced, re-pointed, or removed shows up as a change instead of resolving to
   225	// the same canonical bytes.
   226	func entryDigest(path string) string {
   227		info, err := os.Lstat(path)
   228		switch {
   229		case os.IsNotExist(err):
   230			return transaction.DigestAbsent
   231		case err != nil:
   232			return "unreadable:" + err.Error()
   233		case info.Mode()&os.ModeSymlink != 0:
   234			digest, err := transaction.DigestTarget(transaction.KindEntry, path)
   235			if err != nil {
   236				return "unreadable:" + err.Error()
   237			}
   238			return digest
   239		case !info.IsDir():
   240			digest, err := transaction.DigestPath(path)
   241			if err != nil {
   242				return "unreadable:" + err.Error()
   243			}
   244			return digest
   245		}
   246		// A directory may legitimately hold mirror links, which DigestPath refuses
   247		// inside a tree, so the tree is summarized entry by entry.
   248		entries, err := os.ReadDir(path)
   249		if err != nil {
   250			return "unreadable:" + err.Error()
   251		}
   252		parts := make([]string, 0, len(entries))
   253		for _, entry := range entries {
   254			parts = append(parts, entry.Name()+"="+entryDigest(filepath.Join(path, entry.Name())))
   255		}
   256		sort.Strings(parts)
   257		return "dir[" + strings.Join(parts, ",") + "]"
   258	}
