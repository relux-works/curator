    50	func (e *env) git(dir string, args ...string) {
    51		e.t.Helper()
    52		cmd := exec.Command("git", args...)
    53		cmd.Dir = dir
    54		cmd.Env = append(os.Environ(),
    55			"GIT_AUTHOR_NAME=t", "GIT_AUTHOR_EMAIL=t@example.com",
    56			"GIT_COMMITTER_NAME=t", "GIT_COMMITTER_EMAIL=t@example.com",
    57		)
    58		if out, err := cmd.CombinedOutput(); err != nil {
