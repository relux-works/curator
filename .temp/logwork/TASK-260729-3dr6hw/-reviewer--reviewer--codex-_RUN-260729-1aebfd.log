    39		e := &env{t: t, skillsRoot: t.TempDir(), home: t.TempDir(), project: t.TempDir()}
    40		e.git(e.project, "init", "-q")
    41		e.cfg = &config.Config{
    42			Path:          filepath.Join(e.home, "config.json"),
    43			SkillsRoot:    e.skillsRoot,
