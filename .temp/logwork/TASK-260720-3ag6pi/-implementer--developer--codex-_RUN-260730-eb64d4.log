+func TestManagerLifecyclePlanningOrderAndCompiledDryRun(t *testing.T) {
+	root := repositoryRoot(t)
+	vector := readObject(t, filepath.Join(root, "conformance", "v1", "vectors", "manager-lifecycle.json"))
