+func TestManagerLifecycleGenerationIsDeterministic(t *testing.T) {
+	one := t.TempDir()
+	two := t.TempDir()
+	writeManagerLifecycleVectors(one)
+	writeManagerLifecycleVectors(two)
+	left, err := os.ReadFile(filepath.Join(one, "manager-lifecycle.json"))
+	if err != nil {
+		t.Fatal(err)
