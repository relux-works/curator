+        if isinstance(schema_id, str):
+            schemas[schema_id] = document
+    registry = Registry().with_resources(
+        (
+            schema_id,
+            Resource.from_contents(document),
+        )
+        for schema_id, document in schemas.items()
+    )
+    claim_schema = load_json(
