+func TestManagerLifecycleReusesPortableBuildDriverIdentity(t *testing.T) {
+	root := repositoryRoot(t)
+	lifecycle := readObject(t, filepath.Join(root, "conformance", "v1", "vectors", "manager-lifecycle.json"))
