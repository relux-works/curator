+    def object_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+        value: dict[str, Any] = {}
+        for key, item in pairs:
+            if key in value:
+                raise ReleaseFailure(f"{path}: duplicate JSON key {key!r}")
+            value[key] = item
