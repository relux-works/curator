-        raise ReleaseFailure(f"could not read {path.relative_to(ROOT)}: {exc}") from exc
+        try:
+            label = path.relative_to(ROOT)
+        except ValueError:
+            label = path
+        raise ReleaseFailure(f"could not read {label}: {exc}") from exc
