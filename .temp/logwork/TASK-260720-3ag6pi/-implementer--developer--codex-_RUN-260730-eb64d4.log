+            with self.subTest(label=label):
+                lifecycle, build_drivers = self.vectors()
+                mutate(lifecycle)
+                with self.assertRaises(validate.ValidationFailure):
+                    validate.validate_manager_lifecycle_vectors(
+                        lifecycle, build_drivers
+                    )
+
