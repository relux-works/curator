+        ]
+        self._write_json(path, vector)
+        self._refresh_manifest_entry(relative)
+        with self.assertRaisesRegex(release_gate.ReleaseFailure, "lifecycle"):
+            release_gate.validate_protocol_artifacts(self.VERSION)
