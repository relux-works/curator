+        with self.assertRaisesRegex(
+            release_gate.ReleaseFailure, "required artifacts are missing"
+        ):
+            release_gate.validate_protocol_artifacts(self.VERSION)
+
+    def test_rejects_missing_required_manifest_entry(self) -> None:
