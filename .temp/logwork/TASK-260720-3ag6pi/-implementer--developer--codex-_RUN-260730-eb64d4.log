+
+    def test_rejects_redefined_claim_v1_and_v2_history(self) -> None:
+        for schema_name, protocol_version in (
+            ("conformance-claim-v1.schema.json", self.VERSION),
+            ("conformance-claim-v2.schema.json", self.VERSION),
