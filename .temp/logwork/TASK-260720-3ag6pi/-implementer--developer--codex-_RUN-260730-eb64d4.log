+        "build_input": "build_input",
+        "cache_key": "cache_key",
+        "stored_receipt": "stored_receipt",
+        "receipt_sha256": "receipt_sha256",
+        "artifact": "artifact",
+    }.items():
+        if fixture.get(lifecycle_field) != identity.get(identity_field):
