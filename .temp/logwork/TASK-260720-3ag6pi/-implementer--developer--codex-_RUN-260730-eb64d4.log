+def named_cases(values: Any, label: str, required: set[str]) -> dict[str, dict[str, Any]]:
+    if not isinstance(values, list):
+        raise ReleaseFailure(f"{label} must be an array")
+    names = [
+        item.get("name") if isinstance(item, dict) else None
+        for item in values
