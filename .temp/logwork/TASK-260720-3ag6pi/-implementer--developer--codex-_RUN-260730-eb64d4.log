+        or history.get("metadata_path") != "release/1.0.0-rc.5.json"
+        or history.get("metadata_sha256") != RC5_RELEASE_METADATA_SHA256
+        or history.get("published_commit") != RC5_PUBLISHED_COMMIT
+        or history.get("immutable") is not True
