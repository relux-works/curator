+            ),
+            21,
+        )
+        self.assertIn(
+            "compiled-cache-miss-is-read-only",
+            validate.MANAGER_COMPILED_DRY_RUN_CASES,
+        )
+        validate.validate_manager_lifecycle_vectors(lifecycle, build_drivers)
+
+    def test_each_compiled_lifecycle_group_fails_closed(self) -> None:
