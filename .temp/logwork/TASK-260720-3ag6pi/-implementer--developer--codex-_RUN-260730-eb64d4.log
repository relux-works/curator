+                payload = path.read_bytes()
+                schema = json.loads(payload)
+                schema["properties"]["protocol_version"]["const"] = protocol_version
+                self._write_json(path, schema)
+                try:
+                    with self.assertRaises(release_gate.ReleaseFailure):
