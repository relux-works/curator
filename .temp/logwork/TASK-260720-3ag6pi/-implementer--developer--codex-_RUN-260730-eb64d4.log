    assert key in current_entry_keys, key
    relative = 'conformance/v1/schema-cases/' + entry['instance']
    current = (root / relative).read_bytes()
    historical = blob(baseline, relative)
    assert current == historical, relative

baseline_manifest = json.loads(blob(baseline, 'conformance/v1/manifest.json'))
current_manifest = json.loads((root / 'conformance/v1/manifest.json').read_text(encoding='utf-8'))
baseline_hashes = {entry['path']: entry['sha256'] for entry in baseline_manifest['files']}
current_hashes = {entry['path']: entry['sha256'] for entry in current_manifest['files']}
for entry in baseline_entries:
