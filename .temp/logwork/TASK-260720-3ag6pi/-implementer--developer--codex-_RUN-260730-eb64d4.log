    historical = blob(baseline, relative)
    assert current == historical, relative
    print(f'legacy_schema_sha256[{relative}]={digest(current)}')

baseline_index = json.loads(blob(baseline, 'conformance/v1/schema-cases/index.json'))
current_index = json.loads((root / 'conformance/v1/schema-cases/index.json').read_text(encoding='utf-8'))
legacy_schema_names = {Path(path).name for path in legacy_schemas}
