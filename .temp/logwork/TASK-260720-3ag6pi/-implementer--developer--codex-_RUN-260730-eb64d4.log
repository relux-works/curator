    assert current_hashes[relative] == baseline_hashes[relative]

baseline_keys = {
    (entry['schema'], entry['instance'], entry['valid']) for entry in baseline_entries
}
new_legacy_guards = [
    entry for entry in current_index
    if entry['schema'] in {
        *[f'agent-skill-v{version}.schema.json' for version in range(1, 6)],
        *[f'csk-skill-v{version}.schema.json' for version in range(1, 6)],
