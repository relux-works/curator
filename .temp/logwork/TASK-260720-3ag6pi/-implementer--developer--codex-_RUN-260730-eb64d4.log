        legacy = vector["cache_identity"]["legacy_rc4_without_execution_policy"]
        legacy["input"] = copy.deepcopy(portable)
        legacy["cache_key"] = validate.ccj1_sha256(portable)
        with self.assertRaises(validate.ValidationFailure):
