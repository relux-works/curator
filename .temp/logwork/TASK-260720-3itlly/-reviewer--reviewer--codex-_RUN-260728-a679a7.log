		return err
	}
	if !validSHA256(string(receipt.CacheKey)) || receipt.CacheKey != wantKey {
		return fmt.Errorf("receipt cache_key does not match its complete input")
	}
	return receipt.Artifact.validate(receipt.Input)
}

