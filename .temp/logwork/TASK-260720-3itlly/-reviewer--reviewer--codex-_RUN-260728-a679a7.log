		t.Fatalf("release failure was swallowed: %v", result.Errors)
	}
}

func TestDefaultToolchainProbeRemovesItsProbeRoot(t *testing.T) {
	base := t.TempDir()
	t.Setenv("TMPDIR", base)
	t.Setenv("CURATOR_GO", filepath.Join(base, "absent-go"))
	toolchain := &goToolchain{}

	if _, _, err := toolchain.Probe(context.Background()); err == nil {
		t.Fatal("probe with an absent toolchain unexpectedly succeeded")
	}
	requireNoPrivateRoots(t, base)
}

func TestDefaultToolchainEstablishRemovesItsPrivateRootOnFailure(t *testing.T) {
	base := t.TempDir()
	t.Setenv("TMPDIR", base)
	t.Setenv("CURATOR_GO", filepath.Join(base, "absent-go"))
	toolchain := &goToolchain{}

	if _, err := toolchain.Establish(context.Background()); err == nil {
		t.Fatal("establish with an absent toolchain unexpectedly succeeded")
	}
	requireNoPrivateRoots(t, base)
}

func requireNoPrivateRoots(t *testing.T, base string) {
	t.Helper()
	entries, err := os.ReadDir(base)
	if err != nil {
		t.Fatal(err)
	}
	for _, entry := range entries {
		if strings.HasPrefix(entry.Name(), "curator-go-") {
			t.Fatalf("operation-private root %s survived a failed toolchain resolution", entry.Name())
		}
	}
}

func containsLine(values []string, want string) bool {
	for _, value := range values {
		if value == want {
			return true
		}
	}
	return false
}

