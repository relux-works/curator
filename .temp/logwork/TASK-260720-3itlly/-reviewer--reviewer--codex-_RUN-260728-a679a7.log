	e.buildSkill("build-skill", "alpha")
	e.declare("build-skill")
	deps, toolchain, _, _ := newFakeDeps(t)
	toolchain.closeErr = errors.New("toolchain drifted during the build")

	result := e.install(Options{Build: deps})
	if result.Status != "failed" {
		t.Fatalf("install status = %q, want failed when releasing the session drifts", result.Status)
	}
