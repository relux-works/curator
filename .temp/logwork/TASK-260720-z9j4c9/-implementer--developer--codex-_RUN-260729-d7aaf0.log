    (tmp_path / "scripts" / "tool").write_text("#!/bin/sh\n", encoding="utf-8")
    (tmp_path / "csk-skill.json").write_text(
        json.dumps(
            {
                "schema_version": 3,
                "runtime_roots": ["scripts"],
                "capabilities": {
                    "network": ["gitlab.example.com"],
                    "filesystem": "home-config",
                    "exec": ["glab"],
