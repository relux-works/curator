ad-time = \"2025-04-22T14:54:24.164Z\" }\n849403:-    { url = \"https://files.pythonhosted.org/packages/79/7b/2c79738432f5c924bef5071f933bcc9efd0473bac3b4aa584a6f7c1c8df8/mypy_extensions-1.1.0-py3-none-any.whl\", hash = \"sha256:1be4cccdb0f2482337c4743e60421de3a356cd97508abadd57d47403e94f5505\", size = 4963, upload-time = \"2025-04-22T14:54:22.983Z\" },\n849495:-name = \"pytest\"\n849505:-sdist = { url = \"https://files.pythonhosted.org/packages/e4/47/b9efed96c114afcfa3c9d3fe98a76a1d14c74a9e266d397cf6eb64be5e01/pytest-9.1.1.tar.gz\", hash = \"sha256:1088fbde8f2b49d95a549a195707afa7a76a3ce9bcadc26b6d71f0ffda5fe313\", size = 1636369, upload-time = \"2026-06-19T10:58:32.857Z\" }\n849507:-    { url = \"https://files.pythonhosted.org/packages/24/25/1de2678b631f5a49215c6c96fff41ba892b0a34df68d6d80292b1b48aa7f/pytest-9.1.1-py3-none-any.whl\", hash = \"sha256:37a86b45efb9a47a61a36449063e8e18d0cab3161329fc099eb21783169c4f0c\", size = 386536, upload-time = \"2026-06-19T10:58:31.347Z\" },\n849649:+### 1351 — A protected Windows cache must set the manager owner explicitly and pin identities across every seal transition\n849651:+- IMPLEMENTATION: `TASK-260720-8nxlgx` adds the Windows backend for the immutable `go-v1` build cache. Manager, SYSTEM and Builtin Administrators receive exact protected DACL profiles; lookup opens reparse points themselves, proves direct-child containment and stable file IDs, rejects alternate streams and link counts other than one, revalidates receipt/artifact hashes and sizes, and publishes a fully sealed same-volume staging tree with a non-replacing `MoveFileExW`.\n849652:+- PLATFORM FINDING: an elevated Windows token can create new objects owned by Builtin Administrators rather than the current manager SID. Creation and sealing therefore set the current SID as owner explicitly. Later cleanup must be DACL-only: a sealed manager ACE retains implicit `WRITE_DAC`, but deliberately lacks `WRITE_OWNER`.\n849653:+- RACE FINDING: Windows keeps an entry dire