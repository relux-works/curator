    _validate_directory(
        entry_fd,
        "newly published cache entry",
        _DIRECTORY_PRIVATE_MODE,
    )
    os.fchmod(entry_fd, _DIRECTORY_IMMUTABLE_MODE)
    os.fsync(entry_fd)
    _validate_directory(
        entry_fd,
        "newly published cache entry",
        _DIRECTORY_IMMUTABLE_MODE,
    )


