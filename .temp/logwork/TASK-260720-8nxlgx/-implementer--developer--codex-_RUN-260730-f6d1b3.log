                if (
                    selected.receipt_bytes == published.receipt_bytes
                    and _artifact_open_entries_equal(
                        published_entry_fd,
                        selected_entry_fd,
                        artifact_name,
                    )
                ):
                    return CachePublicationStatus.REUSED_WINNER, selected
                raise CacheConflictError(key)
        except (_MissingState, _UntrustedState):
            if attempt == 7:
                raise
            time.sleep(0.005)
