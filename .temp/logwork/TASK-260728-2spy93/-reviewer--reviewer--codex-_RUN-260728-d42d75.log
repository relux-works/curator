+            validate.TOOLCHAIN_REQUIREMENT_REF["$ref"].endswith(
+                validate.TOOLCHAIN_REQUIREMENT_DEFINITION
+            )
+        )
+        self.assertEqual(
+            set(validate.EXACT_PROPERTY_SCHEMAS), set(validate.RESERVED_WIRE_SHAPES)
