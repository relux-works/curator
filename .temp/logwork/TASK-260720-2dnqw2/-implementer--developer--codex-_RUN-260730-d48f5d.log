+    )
+    assert build.receipt_sha256 == (
+        "sha256:919fbbad8e6ce95532219fd952c2309d0d7026f85209650508fd6834af4020cd"
+    )
+    assert build.artifact_path == "bin/golden-tool"
+    assert build.artifact_sha256 == "sha256:" + "d" * 64
