+def test_ccj_value_canonicalization_does_not_strip_signature_members() -> None:
+    value = {"z": 1, "sig": {"algorithm": "example"}}
+    assert protocol_json.canonical_bytes(value) == (
+        b'{"sig":{"algorithm":"example"},"z":1}'
+    )

