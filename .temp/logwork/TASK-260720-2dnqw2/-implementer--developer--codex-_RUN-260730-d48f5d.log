+    _assert_build_error("cache_key_mismatch", raised)
+
+    with pytest.raises(BuildMetadataError) as raised:
+        verify_receipt(
+            raw,
+            expected_input=build_input,
+            expected_receipt_sha256="sha256:" + "0" * 64,
