+def test_all_rc5_build_receipt_schema_negatives_are_rejected(case_name: str) -> None:
+    payload = _json(f"schema-cases/build-receipt-v1/{case_name}")
+    with pytest.raises(BuildMetadataError):
+        parse_receipt(payload)
