+
+def test_marker_v2_rejects_wrong_derived_artifact_path_and_build_name() -> None:
+    payload = _json("schema-cases/install-marker-v2/valid.json")
+    payload["builds"]["golden-tool"]["artifact_path"] = "bin/another-tool"
