+        "build_roots",
+        "commands",
+        "dependencies",
+        "files",
+        "runtime_roots",
+    ):
+        assert canonical[field] == sorted(canonical[field])
+    assert list(canonical["builds"]) == ["alpha-tool", "golden-tool"]
