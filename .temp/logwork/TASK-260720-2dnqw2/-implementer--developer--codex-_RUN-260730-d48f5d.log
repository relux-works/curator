+from csk import install_marker, protocol_json
+from csk.builds import (
+    BuildMetadataError,
+    cache_key,
+    canonical_input_bytes,
+    canonical_receipt_bytes,
+    parse_build_input,
+    parse_receipt,
+    read_receipt,
+    receipt_sha256,
+    verify_receipt,
+)
+
+
+EXPECTED_MANIFEST_SHA256 = (
+    "sha256:b6f56aacc0e37dcc6692f73f641bff761e89b645adfe20a47a06d81c6fda204c"
+)
+ROOT_TEXT = os.environ.get("CURATOR_CONFORMANCE_ROOT")
+pytestmark = pytest.mark.skipif(
+    not ROOT_TEXT,
+    reason="CURATOR_CONFORMANCE_ROOT is not set",
+)
+
