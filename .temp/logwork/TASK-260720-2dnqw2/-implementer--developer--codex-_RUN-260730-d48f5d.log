+        marker,
+        skill_schema_version=marker.skill_schema_version,
+    )
+
+
+@pytest.mark.parametrize(("schema", "case_name"), MARKER_INVALID_CASES)
+def test_all_rc5_marker_v1_and_v2_schema_negatives_are_rejected(
+    schema: str,
+    case_name: str,
+) -> None:
