+@pytest.mark.parametrize("case_name", MARKER_V2_VALID_CASES)
+def test_all_rc5_marker_v2_schema_positives_are_typed(case_name: str) -> None:
+    raw = (_root() / "schema-cases" / "install-marker-v2" / case_name).read_bytes()
