+    marker = install_marker.parse_install_marker(payload)
+    assert isinstance(marker, install_marker.InstallMarkerV2)
+    canonical = marker.to_json()
+    for field in (
+        "agents",
+        "build_roots",
+        "commands",
+        "dependencies",
+        "files",
+        "runtime_roots",
