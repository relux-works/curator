+        for path in (
+            Path(ROOT_TEXT) / "schema-cases" / "install-marker-v2"
+        ).glob("valid*.json")
+    )
+    if ROOT_TEXT
+    else []
+)
+MARKER_INVALID_CASES = (
+    [
+        (schema, path.name)
+        for schema in ("install-marker-v1", "install-marker-v2")
+        for path in sorted(
+            (Path(ROOT_TEXT) / "schema-cases" / schema).glob("invalid*.json")
