+def test_receipt_verification_rejects_lookup_key_and_receipt_hash_mismatches() -> None:
+    vector = _json("vectors/build-drivers.json")["portable_identity"]
+    raw = (_root() / "expected" / "build-driver" / "receipt.ccj.json").read_bytes()
