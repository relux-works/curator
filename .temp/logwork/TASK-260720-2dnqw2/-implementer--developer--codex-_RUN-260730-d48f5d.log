+def test_receipt_reader_rejects_unknown_versions_keys_paths_and_identities() -> None:
+    valid = _json("vectors/build-drivers.json")["portable_identity"]["stored_receipt"]
+
+    mutations: list[tuple[str, Any, str]] = [
