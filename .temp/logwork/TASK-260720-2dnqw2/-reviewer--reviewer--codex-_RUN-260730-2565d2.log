{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json",
  "title": "Curator Protocol common definitions",
  "$defs": {
    "identifier": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$",
          "maxLength": 128
        },
        {
          "not": {
            "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$)"
          }
        }
      ]
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^/\\\\:\\u0000-\\u001f\\u007f-\\u009f](?:[^\\\\:\\u0000-\\u001f\\u007f-\\u009f]*[^/ .\\\\:\\u0000-\\u001f\\u007f-\\u009f])?$",
      "not": {
        "pattern": "(?:^|/)(?:\\.{1,2}|[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$)|//"
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "projectAlias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,62}[A-Za-z0-9])?$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hex256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "stringSet": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "identifierSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "pathSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/portablePath"
      },
      "uniqueItems": true
    },
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "tag",
            "revision"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\s\\^~><*]+$"
        }
      },
      "additionalProperties": false
    },
    "devRef": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "tag",
            "revision",
            "branch"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "scriptCommand": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "script"
        },
        "unix_path": {
          "$ref": "#/$defs/portablePath"
        },
        "win_path": {
          "$ref": "#/$defs/portablePath"
        }
      },
      "anyOf": [
        {
          "required": [
            "unix_path"
          ]
        },
        {
          "required": [
            "win_path"
          ]
        }
      ],
      "additionalProperties": false
    },
    "systemCommand": {
      "type": "object",
      "required": [
        "type",
        "command"
      ],
      "properties": {
        "type": {
          "const": "system"
        },
        "command": {
          "$ref": "#/$defs/identifier"
        },
        "hint": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "command": {
      "oneOf": [
        {
          "$ref": "#/$defs/scriptCommand"
        },
        {
          "$ref": "#/$defs/systemCommand"
        }
      ]
    },
    "buildCommandV6": {
      "type": "object",
      "required": [
        "type",
        "driver",
        "source_dir"
      ],
      "properties": {
        "type": {
          "const": "build"
        },
        "driver": {
          "const": "go-v1"
        },
        "source_dir": {
          "$ref": "#/$defs/portablePath"
        }
      },
      "additionalProperties": false
    },
    "commandV6": {
      "oneOf": [
        {
          "$ref": "#/$defs/scriptCommand"
        },
        {
          "$ref": "#/$defs/systemCommand"
        },
        {
          "$ref": "#/$defs/buildCommandV6"
        }
      ]
    },
    "rootOrPortablePath": {
      "oneOf": [
        {
          "const": "."
        },
        {
          "$ref": "#/$defs/portablePath"
        }
      ]
    },
    "repositoryGit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:https://[A-Za-z0-9][A-Za-z0-9.-]*/(?!(?:\\.{1,2})(?:/|$))[^\\s%?#\\\\/:\\u0000-\\u001f\\u007f-\\u009f]+(?:/(?!(?:\\.{1,2})(?:/|$))[^\\s%?#\\\\/:\\u0000-\\u001f\\u007f-\\u009f]+)*|ssh://(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}@)?[A-Za-z0-9][A-Za-z0-9.-]*/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*|(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}@)?[A-Za-z0-9][A-Za-z0-9.-]*:(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*)$"
    },
    "gitRefName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!/)(?!.*//)(?!.*\\.\\.)(?!.*@\\{)(?!.*(?:^|/)\\.)(?!.*(?:^|/)[^/]*\\.lock(?:/|$))(?!.*[\\u0000-\\u0020\\u007f~^:?*\\[\\\\])(?!@$).*[^/.]$"
    },
    "lockedCommit": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "object_format",
            "hex"
          ],
          "properties": {
            "object_format": {
              "const": "sha1"
            },
            "hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "object_format",
            "hex"
          ],
          "properties": {
            "object_format": {
              "const": "sha256"
            },
            "hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "buildRepositoryV1": {
      "type": "object",
      "required": [
        "git",
        "locked_commit"
      ],
