echo ''
echo '=== suite-plan.sh: the plan comes from the root, not from the lane ==='
PLAN="$HERE/suite-plan.sh"
assert 'suite-plan rejects a nonexistent root'      2 bash "$PLAN" "$WORK/absent" "$WORK/planev"
