+if actual_removed:
+    fail(f"unexpected removed paths: {sorted(actual_removed)}")
+
+changed_overlay = {
+    path
+    for path in OVERLAY_PATHS
+    if pre_full.get(path) != post_full.get(path)
+}
+if changed_overlay:
+    fail(f"CI/quality overlay changed: {sorted(changed_overlay)}")
