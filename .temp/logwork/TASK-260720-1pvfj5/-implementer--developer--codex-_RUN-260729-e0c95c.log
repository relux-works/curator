+    if pre_full.get(path) != post_full.get(path)
+}
+changed_product = {
+    path
+    for path in pre_product.keys() | post_product.keys()
+    if pre_product.get(path) != post_product.get(path)
+}
+
+if changed_full != PATCH_PATHS:
