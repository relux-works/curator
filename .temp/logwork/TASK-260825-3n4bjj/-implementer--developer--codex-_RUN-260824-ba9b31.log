func TestRealGitPathResolvesLauncherWithoutWeakeningAdmission(t *testing.T) {
	if runtime.GOOS == "windows" {
		t.Skip("controlled launcher symlink is a Unix regression fixture")
	}
	realTool := realGitTool(t)
