	if err != nil {
		t.Fatal(err)
	}
	if resolved != realTool.Executable {
		t.Fatalf("resolved Git = %q, want %q", resolved, realTool.Executable)
	}
	info, err := os.Lstat(resolved)
	if err != nil || !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 {
