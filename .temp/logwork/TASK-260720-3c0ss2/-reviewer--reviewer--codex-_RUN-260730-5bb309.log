   958	def _installed_context_exposes_build_roots(
   959	    marker: dict[str, object],
   960	    target: Path,
   961	    build_roots: tuple[str, ...],
   962	) -> bool:
   963	    if not build_roots:
   964	        return False
   965	
   966	    marker_files = marker.get("files")
   967	    if not isinstance(marker_files, list):
   968	        return True
   969	    for relative in marker_files:
   970	        if not isinstance(relative, str):
   971	            return True
   972	        if whitelist.is_below_excluded_root(Path(relative), build_roots):
   973	            return True
   974	
   975	    for build_root in build_roots:
   976	        installed_root = target.joinpath(*build_root.split("/"))
