   872	        "ref": plan.resolved.ref,
   873	        "commit": plan.resolved.commit,
   874	        "content_sha256": content_hash,
   875	        "locale": effective_locale,
   876	        "agents": sorted(set(agents)),
   877	        "commands": sorted(command.name for command in plan.spec.commands.values() if command.type == "script"),
   878	        "dependencies": sorted(plan.spec.dependencies),
   879	        "skill_schema_version": plan.spec.schema_version,
   880	        "runtime_roots": sorted(set(plan.spec.runtime_roots)),
   881	        "installed_at": datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
   882	        "files": sorted(set(files)),
