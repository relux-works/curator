   226	def _rewrite_skill_frontmatter(path: Path, description: str, triggers: list[str]) -> None:
   227	    text = path.read_text(encoding="utf-8")
   228	    lines = text.splitlines()
   229	    if not lines or lines[0].strip() != "---":
   230	        return
   231	    try:
   232	        end_index = next(index for index in range(1, len(lines)) if lines[index].strip() == "---")
   233	    except StopIteration:
