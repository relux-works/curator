   193	    for root in sorted(whitelist.INCLUDE_ROOTS):
   194	        candidate = skill_dir / root
   195	        if candidate.is_file() and candidate.suffix.lower() == ".md":
   196	            if not _is_below_excluded_root(candidate, skill_dir, exclude_roots):
   197	                markdown_files.append(candidate)
   198	        elif candidate.is_dir():
   199	            markdown_files.extend(
   200	                path
   201	                for path in candidate.rglob("*.md")
   202	                if path.is_file() and not _is_below_excluded_root(path, skill_dir, exclude_roots)
   203	            )
   204	    return sorted(set(markdown_files))
   205	
   206	
   207	def _is_below_excluded_root(path: Path, skill_dir: Path, exclude_roots: tuple[str, ...]) -> bool:
   208	    relative_parts = path.relative_to(skill_dir).parts
   209	    for root in exclude_roots:
   210	        root_parts = tuple(root.split("/"))
   211	        if relative_parts[: len(root_parts)] == root_parts:
   212	            return True
   213	    return False

