   550	class _PathRegistry:
   551	    def __init__(self) -> None:
   552	        self._encoded: set[bytes] = set()
   553	        self._platform: dict[str, str] = {}
   554	
   555	    def add(self, path: str) -> bytes:
   556	        if not is_valid_portable_path(path):
   557	            raise InvalidSnapshotError(f"non-portable path in build-source snapshot: {path!r}")
   558	        try:
   559	            path_bytes = path.encode("utf-8", errors="strict")
   560	        except UnicodeEncodeError as exc:
   561	            raise InvalidSnapshotError(f"invalid Unicode in build-source path: {path!r}") from exc
   562	        if path_bytes in self._encoded:
   563	            raise InvalidSnapshotError(f"duplicate path in build-source snapshot: {path!r}")
   564	        self._encoded.add(path_bytes)
   565	        platform_key = unicodedata.normalize(
   566	            "NFD",
   567	            unicodedata.normalize("NFD", path).casefold(),
   568	        )
   569	        previous = self._platform.get(platform_key)
