   458	    directory_fd = os.dup(root_fd)
   459	    try:
   460	        for index, component in enumerate(parts[:-1]):
   461	            child_fd = _open_directory_at(directory_fd, component, "/".join(parts[: index + 1]))
   462	            os.close(directory_fd)
   463	            directory_fd = child_fd
