   911	def _marker_is_current(
   912	    marker: dict[str, object] | None,
   913	    target: Path,
   914	    plan: SkillPlan,
   915	    locale_value: str | None,
   916	    agents: list[str],
   917	    *,
   918	    activation: dict[str, object] | None = None,
   919	    substituted: str | None = None,
   920	    mcp_servers: dict[str, list[str]] | None = None,
   921	    attestation: dict[str, object] | None = None,
   922	) -> bool:
   923	    if not marker or not target.exists():
   924	        return False
   925	    if marker.get("schema_version") != 1:
   926	        raise InstallError(f"Unsupported installed marker schema in {target / '.csk-install.json'}")
   927	    if marker.get("ref_kind") != plan.resolved.kind or marker.get("ref") != plan.resolved.ref:
   928	        return False
   929	    if marker.get("commit") != plan.resolved.commit:
   930	        return False
   931	    if marker.get("locale") != locale_value:
   932	        return False
