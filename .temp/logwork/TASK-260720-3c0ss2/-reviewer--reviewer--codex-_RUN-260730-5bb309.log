   934	        return False
   935	    if activation is not None:
   936	        activation_commands = activation.get("commands", [])
   937	        if not isinstance(activation_commands, list) or not all(
   938	            isinstance(command, str) for command in activation_commands
   939	        ):
   940	            return False
   941	        expected_activation = {**activation, "commands": sorted(set(activation_commands))}
   942	        if marker.get("activation") != expected_activation:
   943	            return False
   944	    if marker.get("substituted") != substituted:
   945	        return False
   946	    if mcp_servers is not None:
   947	        expected_mcp = {name: sorted(set(found)) for name, found in sorted(mcp_servers.items())}
   948	        if marker.get("mcp_servers") != expected_mcp:
   949	            return False
   950	    if marker.get("attestation") != attestation:
   951	        return False
   952	    if _installed_context_exposes_build_roots(marker, target, plan.spec.build_roots):
   953	        return False
   954	    actual_hash = hashing.content_sha256(target)
   955	    return marker.get("content_sha256") == actual_hash
