+def _set_windows_stream_name(pointer: object, name: str) -> None:
+    data = ctypes.cast(
+        pointer,
+        ctypes.POINTER(_windows._Win32FindStreamData),
+    ).contents
+    data.stream_name = name
+
+
+def _install_windows_stream_api(
