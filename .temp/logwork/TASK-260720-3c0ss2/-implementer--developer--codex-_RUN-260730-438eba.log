+from __future__ import annotations
+
+import sys
+import tarfile
+import zipfile
+from pathlib import Path
+
+
+wheel_path = Path(sys.argv[1])
+sdist_path = Path(sys.argv[2])
+required_wheel = {"csk/builds/source.py", "csk/builds/_windows.py"}
+required_sdist = {"src/csk/builds/source.py", "src/csk/builds/_windows.py"}
+
+with zipfile.ZipFile(wheel_path) as wheel:
+    wheel_names = set(wheel.namelist())
+missing_wheel = required_wheel - wheel_names
+assert not missing_wheel, f"wheel missing: {sorted(missing_wheel)}"
+
+with tarfile.open(sdist_path, "r:gz") as sdist:
+    sdist_names = {
+        "/".join(Path(name).parts[1:])
+        for name in sdist.getnames()
+        if len(Path(name).parts) > 1
+    }
+missing_sdist = required_sdist - sdist_names
+assert not missing_sdist, f"sdist missing: {sorted(missing_sdist)}"
+
+print(f"wheel={wheel_path.name}: {sorted(required_wheel)}")
+print(f"sdist={sdist_path.name}: {sorted(required_sdist)}")
