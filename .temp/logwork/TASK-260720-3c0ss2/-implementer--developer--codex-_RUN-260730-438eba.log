+class _Win32Function:
+    def __init__(self, callback: Callable[..., Any]) -> None:
+        self._callback = callback
+        self.argtypes: object = None
+        self.restype: object = None
+
+    def __call__(self, *args: object) -> Any:
+        return self._callback(*args)
+
