+        )
+        guard.close()
+        guard = None
+        assert resource.getrlimit(resource.RLIMIT_NOFILE) == low
+    finally:
+        if guard is not None:
+            guard.close()
+        resource.setrlimit(resource.RLIMIT_NOFILE, original)
