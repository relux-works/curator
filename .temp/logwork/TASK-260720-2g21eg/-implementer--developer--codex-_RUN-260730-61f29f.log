@@ -0,0 +1,54 @@
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+from csk.builds import go_v1
+
+
+task_root = Path.cwd() / "TASK-260720-2g21eg-cycle5-61f29f"
+manager = (task_root / "venv" / "Scripts" / "csk.exe").resolve(strict=True)
+cache = task_root / "diagnostic-worker-cache-6"
+cache.mkdir()
+identity = go_v1._resolve_manager_identity(manager)
+limits = go_v1.ResourceLimits(timeout_seconds=30)
+platform, probes = go_v1.probe_native_controls(limits)
+domain = go_v1._NativeControlDomain(platform, probes, limits)
+prepared_launch = go_v1._PreparedWorkerLaunch
+
+
+class DebugPreparedWorkerLaunch(prepared_launch):
+    def __init__(self, platform: str):
+        super().__init__(platform)
+        print(
+            f"parent_launch_fd={self._read_fd} "
+            f"parent_launch_handle={self._windows_handle}",
+            flush=True,
+        )
+
+
+go_v1._PreparedWorkerLaunch = DebugPreparedWorkerLaunch
+process = None
+try:
+    print(f"argv={go_v1.worker_argv(identity)!r}", flush=True)
+    print(
+        "environment="
+        f"{go_v1._indispensable_worker_environment(platform, cache, identity.startup.site_root, identity.startup.python_home)!r}",
+        flush=True,
+    )
+    process = domain.launch(identity, cache)
+    time.sleep(1)
+    print(f"pid={process.pid} returncode={process.poll()!r}", flush=True)
+    if process.poll() is None and process.stdin is not None:
+        process.stdin.close()
+        process.wait(timeout=10)
+    stdout = process.stdout.read() if process.stdout is not None else b""
+    stderr = process.stderr.read() if process.stderr is not None else b""
+    print(f"terminal_returncode={process.poll()!r}", flush=True)
+    print(f"stdout={stdout!r}", flush=True)
+    print(f"stderr={stderr!r}", flush=True)
+finally:
+    try:
+        domain.terminate(process)
+    finally:
+        domain.close()
diff --git a/.temp/TASK-260720-2g21eg/cycle5-run-61f29f/enumerate-windows-handles.py b/.temp/TASK-260720-2g21eg/cycle5-run-61f29f/enumerate-windows-handles.py
