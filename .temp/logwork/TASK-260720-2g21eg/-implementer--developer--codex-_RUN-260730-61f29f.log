@@ -0,0 +1,25 @@
+from __future__ import annotations
+
+import runpy
+import sys
+import types
+from pathlib import Path
+
+
+task_root = Path.cwd() / "TASK-260720-2g21eg-cycle5-61f29f"
+launcher = (task_root / "venv" / "Scripts" / "csk.exe").resolve(strict=True)
+package = types.ModuleType("csk")
+package.__path__ = []  # type: ignore[attr-defined]
+module = types.ModuleType("csk.cli")
+
+
+def main() -> int:
+    print(f"sys.argv={sys.argv!r}")
+    return 0
+
+
+module.main = main  # type: ignore[attr-defined]
+sys.modules["csk"] = package
