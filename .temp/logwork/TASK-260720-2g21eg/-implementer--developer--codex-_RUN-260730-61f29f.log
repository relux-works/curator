    entries: list[_TreeEntryIdentity] = []
    total_size = 0

    def descend(directory: Path, prefix: str) -> None:
        nonlocal total_size
        try:
            with os.scandir(directory) as iterator:
                names = sorted(
                    (entry.name for entry in iterator),
