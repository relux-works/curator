+        return None
+    resource.setrlimit(resource.RLIMIT_NOFILE, (required, hard))
+    current = resource.getrlimit(resource.RLIMIT_NOFILE)
+    if current[0] < required:
+        try:
+            resource.setrlimit(resource.RLIMIT_NOFILE, previous)
+        finally:
