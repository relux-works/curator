+    )
+    assert retained == previous
+    go_v1._restore_macos_identity_descriptor_capacity(retained)
+    assert applied == [
+        (resource.RLIMIT_NOFILE, (required, previous[1])),
+        (resource.RLIMIT_NOFILE, previous),
+    ]
