+def test_macos_identity_descriptor_capacity_is_bounded_and_restored(
+    monkeypatch: pytest.MonkeyPatch,
+):
+    import resource
+
+    previous = (256, 131_072)
+    required = go_v1._MACOS_FIXED_DESCRIPTOR_CAPACITY
