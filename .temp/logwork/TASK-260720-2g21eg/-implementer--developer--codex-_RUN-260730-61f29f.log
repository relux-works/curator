+    with pytest.raises(go_v1.GoV1Error) as unavailable:
+        go_v1._windows_loaded_image(7, "runtime")
+    assert unavailable.value.code == go_v1.CODE_WORKER_IDENTITY_INVALID
+
+    get_name.implementation = (
