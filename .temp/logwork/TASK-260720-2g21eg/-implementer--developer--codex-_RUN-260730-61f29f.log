index 0000000000000000000000000000000000000000..2a6f9761bfb23899f7faa9d7ae418ef4324b0575
--- /dev/null
+++ b/.temp/TASK-260720-2g21eg/cycle5-run-61f29f/enumerate-windows-handles.py
@@ -0,0 +1,46 @@
+from __future__ import annotations
+
+import ctypes
+
+
+magic = b"csk-go-launch-v1"
+expected = len(magic) + 8 + 32 + 32
+kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+get_file_type = kernel32.GetFileType
+get_file_type.argtypes = [ctypes.c_void_p]
+get_file_type.restype = ctypes.c_uint32
+peek = kernel32.PeekNamedPipe
+peek.argtypes = [
+    ctypes.c_void_p,
+    ctypes.c_void_p,
+    ctypes.c_uint32,
+    ctypes.POINTER(ctypes.c_uint32),
+    ctypes.POINTER(ctypes.c_uint32),
+    ctypes.POINTER(ctypes.c_uint32),
+]
+peek.restype = ctypes.c_int
+
+for value in range(1, 4096):
+    handle = ctypes.c_void_p(value)
+    if get_file_type(handle) != 3:
+        continue
+    prefix = ctypes.create_string_buffer(len(magic))
+    read = ctypes.c_uint32()
+    available = ctypes.c_uint32()
+    ctypes.set_last_error(0)
+    ok = int(
+        peek(
+            handle,
+            prefix,
+            len(prefix),
+            ctypes.byref(read),
+            ctypes.byref(available),
+            None,
+        )
+    )
+    print(
+        f"pipe={value} ok={ok} error={ctypes.get_last_error()} "
+        f"available={available.value} read={read.value} "
+        f"prefix={prefix.raw[:read.value]!r} expected={expected}",
+        flush=True,
+    )
