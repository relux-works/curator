+    resource.setrlimit(resource.RLIMIT_NOFILE, low)
+    guard: go_v1._IdentityMutationGuard | None = None
+    try:
+        guard = go_v1._IdentityMutationGuard(
+            go_v1.PLATFORM_MACOS,
