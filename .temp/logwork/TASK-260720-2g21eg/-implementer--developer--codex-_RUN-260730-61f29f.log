        "PYTHONNOUSERSITE": "1",
        "PYTHONHOME": os.fspath(python_home),
        "PYTHONPATH": os.fspath(site_root),
        "PYTHONPYCACHEPREFIX": os.fspath(worker_cache),
    }
    if platform == PLATFORM_MACOS:
