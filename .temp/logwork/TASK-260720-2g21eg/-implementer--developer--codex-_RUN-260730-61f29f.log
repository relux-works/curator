+    calls = 0
+
+    def resolve(
+        _handle: object,
+        buffer: Any,
+        capacity: int,
+    ) -> int:
+        nonlocal calls
+        calls += 1
+        if calls == 1:
+            return capacity
+        buffer.value = str(image)
+        return len(buffer.value)
+
+    get_name = _FakeCFunction(resolve)
