        python_home=python_home,
        configuration=None,
        base_executable=executable,
        process_image=process_image,
        runtime_image=runtime_image,
    )


def _resolve_interpreter_runtime(
    executable: _ExecutableIdentity,
) -> _InterpreterRuntimeIdentity:
    if os.name == "nt":
