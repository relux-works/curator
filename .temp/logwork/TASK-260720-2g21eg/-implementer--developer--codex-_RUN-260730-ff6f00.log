+    read_file = kernel32.ReadFile
+    read_file.argtypes = [
+        ctypes.c_void_p,
+        ctypes.c_void_p,
+        ctypes.c_uint32,
+        ctypes.POINTER(ctypes.c_uint32),
+        ctypes.c_void_p,
+    ]
+    read_file.restype = ctypes.c_int
+    buffer = ctypes.create_string_buffer(expected)
+    read = ctypes.c_uint32()
+    try:
+        if not read_file(
