+def _read_posix_worker_launch_record() -> bytes:
+    expected = (
+        len(_WORKER_LAUNCH_MAGIC)
+        + 8
+        + _WORKER_LAUNCH_SECRET_BYTES
+        + hashlib.sha256().digest_size
+    )
+    try:
+        info = os.fstat(_WORKER_LAUNCH_FD)
+        if not stat.S_ISFIFO(info.st_mode):
+            raise OSError("launch descriptor is not an anonymous pipe")
+        os.set_blocking(_WORKER_LAUNCH_FD, False)
+        payload = bytearray()
+        while len(payload) != expected:
+            chunk = os.read(_WORKER_LAUNCH_FD, expected - len(payload))
+            if not chunk:
+                break
+            payload.extend(chunk)
+        trailing = os.read(_WORKER_LAUNCH_FD, 1)
+        if trailing:
+            raise OSError("launch descriptor contains trailing data")
+        return bytes(payload)
+    except OSError as exc:
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            "hidden mode lacks a manager-owned launch capability",
+        ) from exc
+    finally:
+        try:
+            os.close(_WORKER_LAUNCH_FD)
+        except OSError:
+            pass
+
+
+def _read_windows_worker_launch_record() -> bytes:
+    expected = (
+        len(_WORKER_LAUNCH_MAGIC)
+        + 8
+        + _WORKER_LAUNCH_SECRET_BYTES
