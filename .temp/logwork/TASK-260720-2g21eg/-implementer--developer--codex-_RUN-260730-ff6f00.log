+        [str(manager), go_v1.WORKER_MODE],
+        input=b"",
+        capture_output=True,
+        check=False,
+        env=environment,
+    )
+
+    assert completed.returncode == 2
+    assert completed.stdout == b""
+    assert b"invalid choice" in completed.stderr
+    assert not go_marker.exists()
