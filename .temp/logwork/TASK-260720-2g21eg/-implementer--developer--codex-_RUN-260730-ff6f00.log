   530	class RecordingExecutor:
   531	    def __init__(self, results: list[go_v1.ProcessResult] | None = None):
   532	        self.results = results or [
   533	            go_v1.ProcessResult(stdout=b'{"ImportPath":"x"}\n'),
   534	            go_v1.ProcessResult(),
   535	        ]
   536	        self.calls: list[go_v1.ProcessRequest] = []
   537	
   538	    def run(self, request: go_v1.ProcessRequest) -> go_v1.ProcessResult:
   539	        self.calls.append(request)
   540	        return self.results[len(self.calls) - 1]
