+    def _prepare_macos(self, record: bytes) -> None:
+        try:
+            os.fstat(_WORKER_LAUNCH_FD)
+        except OSError as exc:
+            if exc.errno != errno.EBADF:
+                raise GoV1Error(
+                    CODE_CONTROL_UNAVAILABLE,
+                    "cannot inspect the fixed worker launch descriptor",
+                ) from exc
+        else:
+            raise GoV1Error(
+                CODE_CONTROL_UNAVAILABLE,
+                "the fixed worker launch descriptor is already occupied",
+            )
+        read_fd, write_fd = os.pipe()
+        try:
+            _write_launch_record_fd(write_fd, record)
+        finally:
+            os.close(write_fd)
+        try:
+            if read_fd != _WORKER_LAUNCH_FD:
+                os.dup2(
+                    read_fd,
+                    _WORKER_LAUNCH_FD,
+                    inheritable=True,
+                )
+                os.close(read_fd)
+            else:
