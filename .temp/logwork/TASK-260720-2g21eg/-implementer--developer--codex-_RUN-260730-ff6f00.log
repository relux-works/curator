+            if selected < 0:
+                raise GoV1Error(
+                    CODE_CONTROL_UNAVAILABLE,
+                    "no fixed worker launch descriptor is available",
+                )
+            os.close(read_fd)
+            self._read_fd = selected
+        except BaseException:
+            if read_fd >= 0:
+                os.close(read_fd)
+            raise
+
+    def _prepare_windows(self, record: bytes) -> None:
