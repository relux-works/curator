+        "import sys\n"
+        "from csk.cli import main\n"
+        "if __name__ == '__main__':\n"
+        "    sys.exit(main())\n",
+        encoding="utf-8",
+    )
+    launcher.chmod(0o755)
+    return launcher.resolve(strict=True)

