+            continue
+        finally:
+            try:
+                os.close(descriptor)
+            except OSError:
+                pass
+    if len(records) != 1:
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            "hidden mode lacks one manager-owned launch capability",
+        )
+    return records[0]
