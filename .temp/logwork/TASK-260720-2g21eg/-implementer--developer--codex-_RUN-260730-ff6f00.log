+            return
+        startup_info = subprocess.STARTUPINFO()  # type: ignore[attr-defined]
+        startup_info.lpAttributeList = {  # type: ignore[attr-defined]
+            "handle_list": [self._windows_handle]
+        }
+        options["startupinfo"] = startup_info
