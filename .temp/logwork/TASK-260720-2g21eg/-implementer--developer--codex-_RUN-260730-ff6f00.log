+    poison_bin.mkdir()
+    poison_go = poison_bin / ("go.exe" if os.name == "nt" else "go")
+    poison_go.write_text(
+        "#!/bin/sh\n"
+        f"printf started > {go_marker}\n",
+        encoding="utf-8",
+    )
+    poison_go.chmod(0o755)
