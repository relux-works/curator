+def _manager_python_home(stdlib_root: Path) -> Path:
+    return stdlib_root.parent if os.name == "nt" else stdlib_root.parent.parent
+
+
+def _manager_runtime_roots(stdlib_root: Path) -> tuple[Path, ...]:
+    roots = [stdlib_root]
+    if os.name == "nt":
+        dll_root = stdlib_root.parent / "DLLs"
+        if dll_root.is_dir():
+            roots.append(dll_root)
+    return tuple(roots)
+
+
+def _resolve_runtime_archives(
+    runtime_roots: Sequence[Path],
+) -> tuple[_ExecutableIdentity, ...]:
+    archives: list[_ExecutableIdentity] = []
+    parents = tuple(dict.fromkeys(root.parent for root in runtime_roots))
+    for parent in parents:
+        try:
+            names = sorted(
+                (entry.name for entry in os.scandir(parent)),
+                key=lambda item: item.encode("utf-8", errors="strict"),
+            )
+        except (OSError, UnicodeEncodeError) as exc:
+            raise GoV1Error(
+                CODE_WORKER_IDENTITY_INVALID,
+                "cannot inspect the installed manager runtime archives",
+            ) from exc
+        for name in names:
+            folded = name.casefold()
+            if not (folded.startswith("python") and folded.endswith(".zip")):
+                continue
+            if len(archives) >= _MAX_RUNTIME_ARCHIVES:
+                raise GoV1Error(
+                    CODE_WORKER_IDENTITY_INVALID,
+                    "the installed manager runtime archive set is unbounded",
+                )
+            archives.append(
+                _resolve_file_identity(
+                    parent / name,
+                    executable=False,
+                    label=f"installed manager runtime archive {name}",
+                    max_bytes=_MAX_RUNTIME_ARCHIVE_BYTES,
+                )
+            )
+    archives.sort(key=lambda item: os.fspath(item.path).encode("utf-8"))
+    return tuple(archives)
+
