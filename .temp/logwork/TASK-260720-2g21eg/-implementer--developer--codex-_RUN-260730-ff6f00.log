+    archive.write_bytes(archive.read_bytes() + b"mutated")
+    with pytest.raises(go_v1.GoV1Error) as raised:
+        bound_archive.verify()
+    assert raised.value.code == go_v1.CODE_WORKER_IDENTITY_INVALID
+
