+def _write_launch_record_fd(descriptor: int, record: bytes) -> None:
+    offset = 0
+    while offset != len(record):
+        written = os.write(descriptor, record[offset:])
+        if written <= 0:
+            raise OSError("cannot write manager-owned launch capability")
+        offset += written
