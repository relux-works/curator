+            self._read_fd = _WORKER_LAUNCH_FD
+        except BaseException:
+            os.close(read_fd)
+            raise
+
+    def _prepare_windows(self, record: bytes) -> None:
+        import msvcrt
+
+        read_fd, write_fd = os.pipe()
+        try:
+            _write_launch_record_fd(write_fd, record)
+        finally:
+            os.close(write_fd)
