def _native_executable_header(header: bytes, platform: str) -> bool:
    if platform == PLATFORM_WINDOWS:
        return header.startswith(b"MZ")
    if len(header) < 4:
        return False
    return header in {
        b"\xfe\xed\xfa\xce",
        b"\xfe\xed\xfa\xcf",
        b"\xce\xfa\xed\xfe",
        b"\xcf\xfa\xed\xfe",

