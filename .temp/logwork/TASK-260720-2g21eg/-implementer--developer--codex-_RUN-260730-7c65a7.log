@@ -0,0 +1,139 @@
+param(
+    [Parameter(Mandatory = $true)]
+    [ValidateSet("Setup", "Hashes", "Focused", "Full", "Cleanup")]
+    [string]$Mode
+)
+
+$ErrorActionPreference = "Stop"
+$TaskName = "TASK-260720-2g21eg-cycle6-7c65a7"
+$TempRoot = [System.IO.Path]::GetTempPath().TrimEnd(
+    [System.IO.Path]::DirectorySeparatorChar,
+    [System.IO.Path]::AltDirectorySeparatorChar
+)
+$Root = Join-Path $TempRoot $TaskName
+$Repo = Join-Path $Root "repo"
+$Protocol = Join-Path $Root "protocol-spec"
+$VenvPython = Join-Path $Root "venv\Scripts\python.exe"
+$SourceArchive = Join-Path $TempRoot "$TaskName-source.zip"
+$ProtocolArchive = Join-Path $TempRoot "$TaskName-protocol.zip"
+$GoOverlay = Join-Path $TempRoot "$TaskName-go_v1.py"
+$TestOverlay = Join-Path $TempRoot "$TaskName-test_builds_go_v1.py"
+$ExpectedRoot = Join-Path $TempRoot "TASK-260720-2g21eg-cycle6-7c65a7"
+
+if ($Root -ne $ExpectedRoot) {
+    throw "refusing an unexpected task root: $Root"
+}
+
+switch ($Mode) {
+    "Setup" {
+        if (Test-Path -LiteralPath $Root) {
+            throw "task root already exists: $Root"
+        }
+        foreach ($InputPath in @(
+            $SourceArchive,
+            $ProtocolArchive,
+            $GoOverlay,
+            $TestOverlay
+        )) {
+            if (-not (Test-Path -LiteralPath $InputPath -PathType Leaf)) {
+                throw "required task input is missing: $InputPath"
+            }
+        }
+
+        New-Item -ItemType Directory -Path $Root | Out-Null
+        Expand-Archive -LiteralPath $SourceArchive -DestinationPath $Repo
+        Expand-Archive -LiteralPath $ProtocolArchive -DestinationPath $Protocol
+        Copy-Item -LiteralPath $GoOverlay `
+            -Destination (Join-Path $Repo "src\csk\builds\go_v1.py")
+        Copy-Item -LiteralPath $TestOverlay `
+            -Destination (Join-Path $Repo "tests\test_builds_go_v1.py")
+
+        & python -m venv (Join-Path $Root "venv")
+        if ($LASTEXITCODE -ne 0) {
+            exit $LASTEXITCODE
+        }
+        $env:SETUPTOOLS_SCM_PRETEND_VERSION_FOR_COCOASKILLS = "0.12.6.dev16"
+        & $VenvPython -m pip install --disable-pip-version-check -e "$Repo[dev]"
+        if ($LASTEXITCODE -ne 0) {
+            exit $LASTEXITCODE
+        }
+        & $VenvPython --version
+        if ($LASTEXITCODE -ne 0) {
+            exit $LASTEXITCODE
+        }
+        & $VenvPython -m pytest --version
+        exit $LASTEXITCODE
+    }
+    "Hashes" {
+        if (-not (Test-Path -LiteralPath $Repo -PathType Container)) {
+            throw "task repository is missing: $Repo"
+        }
+        $Pairs = @(
+            @(
+                $GoOverlay,
+                (Join-Path $Repo "src\csk\builds\go_v1.py")
+            ),
+            @(
+                $TestOverlay,
+                (Join-Path $Repo "tests\test_builds_go_v1.py")
+            )
+        )
+        foreach ($Pair in $Pairs) {
+            $InputHash = (Get-FileHash -Algorithm SHA256 `
+                -LiteralPath $Pair[0]).Hash.ToLowerInvariant()
+            $RepoHash = (Get-FileHash -Algorithm SHA256 `
+                -LiteralPath $Pair[1]).Hash.ToLowerInvariant()
+            Write-Output "$InputHash  $($Pair[0])"
+            Write-Output "$RepoHash  $($Pair[1])"
+            if ($InputHash -ne $RepoHash) {
+                throw "overlay hash mismatch: $($Pair[1])"
+            }
+        }
+        foreach ($Archive in @($SourceArchive, $ProtocolArchive)) {
+            $Hash = (Get-FileHash -Algorithm SHA256 `
+                -LiteralPath $Archive).Hash.ToLowerInvariant()
+            Write-Output "$Hash  $Archive"
+        }
+    }
+    "Focused" {
+        if (-not (Test-Path -LiteralPath $VenvPython -PathType Leaf)) {
+            throw "task virtual environment is missing: $VenvPython"
+        }
+        $env:CURATOR_CONFORMANCE_ROOT = Join-Path `
+            $Protocol "conformance\v1"
+        Set-Location -LiteralPath $Repo
+        $Junit = Join-Path $Root `
+            "TASK-260720-2g21eg_cycle6-windows-focused.xml"
+        & $VenvPython -m pytest tests\test_builds_go_v1.py -q `
+            "--junitxml=$Junit"
+        exit $LASTEXITCODE
+    }
+    "Full" {
+        if (-not (Test-Path -LiteralPath $VenvPython -PathType Leaf)) {
+            throw "task virtual environment is missing: $VenvPython"
+        }
+        $env:CURATOR_CONFORMANCE_ROOT = Join-Path `
+            $Protocol "conformance\v1"
+        Set-Location -LiteralPath $Repo
+        $Junit = Join-Path $Root `
+            "TASK-260720-2g21eg_cycle6-windows-full.xml"
+        & $VenvPython -m pytest -q "--junitxml=$Junit"
+        exit $LASTEXITCODE
+    }
+    "Cleanup" {
+        if (Test-Path -LiteralPath $Root) {
+            Remove-Item -LiteralPath $Root -Recurse -Force
+        }
+        foreach ($InputPath in @(
+            $SourceArchive,
+            $ProtocolArchive,
+            $GoOverlay,
+            $TestOverlay
+        )) {
+            if (Test-Path -LiteralPath $InputPath) {
+                Remove-Item -LiteralPath $InputPath -Force
+            }
+        }
+        Write-Output (Test-Path -LiteralPath $Root)
+    }
+}
