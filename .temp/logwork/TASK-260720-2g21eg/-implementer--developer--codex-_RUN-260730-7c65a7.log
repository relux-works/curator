def _worker_launch_record(secret: bytes, parent_pid: int) -> bytes:
    if len(secret) != _WORKER_LAUNCH_SECRET_BYTES or parent_pid <= 1:
        raise GoV1Error(
            CODE_WORKER_IDENTITY_INVALID,
            "manager-owned worker launch capability is malformed",
        )
