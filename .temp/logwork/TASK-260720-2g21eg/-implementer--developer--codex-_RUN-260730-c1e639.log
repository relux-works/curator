+            info = current.lstat()
+        except OSError as exc:
+            raise GoV1Error(
+                CODE_WORKER_IDENTITY_INVALID,
+                "manager interpreter is unavailable",
+            ) from exc
+        if not stat.S_ISLNK(info.st_mode):
