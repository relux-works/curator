+            flags |= getattr(os, "O_NOFOLLOW", 0)
+            descriptor = os.open(path, flags)
+            self._mac_fds.append(descriptor)
+            self._mac_paths[descriptor] = path
+            changes.append(
+                select.kevent(
+                    descriptor,
+                    filter=select.KQ_FILTER_VNODE,
+                    flags=(
+                        select.KQ_EV_ADD
+                        | select.KQ_EV_ENABLE
+                        | select.KQ_EV_CLEAR
+                    ),
+                    fflags=event_mask,
+                )
