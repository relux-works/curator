+    )
+    raw_entries = _require_list(value.get("entries"), f"{label} entries")
+    if not raw_entries or len(raw_entries) > max_files * 2:
+        raise GoV1Error(
+            CODE_WORKER_PROTOCOL_INVALID,
+            f"{label} entry set is not bounded",
