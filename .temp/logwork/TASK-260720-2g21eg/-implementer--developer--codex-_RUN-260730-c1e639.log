+    if (
+        not worker_cache.is_absolute()
+        or _is_link_or_reparse(cache_info)
+        or not stat.S_ISDIR(cache_info.st_mode)
+        or cache_entries
+    ):
+        raise GoV1Error(
+            CODE_CONTROL_UNAVAILABLE,
+            "worker bytecode cache is not a private empty directory",
+        )
