    snapshot_value = snapshot_fn(_TH32CS_SNAPTHREAD, 0)
    if snapshot_value == _INVALID_HANDLE_VALUE:
        raise ctypes.WinError(ctypes.get_last_error())  # type: ignore[attr-defined]
    snapshot = int(snapshot_value)
    resumed = 0
    try:
