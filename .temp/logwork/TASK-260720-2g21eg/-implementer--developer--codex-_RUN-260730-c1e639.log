+def _executable_identity_from_mapping(
+    value: Mapping[str, object],
+    label: str,
+) -> _ExecutableIdentity:
+    _require_exact_keys(
+        value,
+        {"path", "sha256", "size", "device", "inode", "mode"},
+        label,
+    )
