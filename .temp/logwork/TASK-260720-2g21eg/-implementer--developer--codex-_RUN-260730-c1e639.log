+    def _release_handles(self) -> BaseException | None:
+        failure: BaseException | None = None
+        for descriptor in self._mac_fds:
+            try:
+                os.close(descriptor)
+            except OSError as exc:
+                if failure is None:
+                    failure = exc
+        self._mac_fds.clear()
+        self._mac_paths.clear()
