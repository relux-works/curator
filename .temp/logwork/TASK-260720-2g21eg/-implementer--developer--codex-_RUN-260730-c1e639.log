+        root_inode=root_stat.st_ino,
+        root_mode=stat.S_IMODE(root_stat.st_mode),
+        entries=tuple(entries),
+        executable_files=executable_files,
+        label=label,
+        max_files=max_files,
+        max_bytes=max_bytes,
+    )
