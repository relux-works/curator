+    try:
+        streams = named_data_streams(path)
+    except OSError as exc:
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            f"{label} data streams cannot be inspected",
+        ) from exc
+    if streams:
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            f"{label} carries a named data stream",
