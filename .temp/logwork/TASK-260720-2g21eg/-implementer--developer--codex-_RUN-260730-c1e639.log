+            executable_files=True,
+            label="fingerprinted GOROOT tool directory",
+            max_files=_MAX_TOOL_EXECUTABLES,
+            max_bytes=_MAX_TOOL_TREE_BYTES,
+            ignored_names=(),
+        ),
+    )
