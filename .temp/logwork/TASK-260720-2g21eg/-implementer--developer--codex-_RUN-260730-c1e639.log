+def _manager_package_root(launcher: Path) -> Path:
+    if launcher.parent.name.lower() not in {"bin", "scripts"}:
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            "installed manager launcher is outside a fixed Python prefix",
