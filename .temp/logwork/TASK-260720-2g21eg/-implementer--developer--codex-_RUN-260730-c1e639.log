+        ctypes.c_int,
+        ctypes.c_void_p,
+        ctypes.c_uint32,
+        ctypes.c_void_p,
+    ]
+    query.restype = ctypes.c_int
+    if not terminate(handle, 3):
+        raise ctypes.WinError(ctypes.get_last_error())  # type: ignore[attr-defined]
