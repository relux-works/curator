+        self._closed = True
+        failure: BaseException | None = None
+        if self._mac_queue is not None:
+            try:
+                events = self._mac_queue.control(
+                    None,
+                    max(1, len(self._mac_fds) * 2),
+                    0,
+                )
+                if events:
+                    changed = sorted(
+                        {
+                            os.fspath(self._mac_paths.get(event.ident, Path("?")))
+                            for event in events
+                        }
+                    )
