+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            f"{label} is not a canonical link-free directory",
+        )
+    _reject_identity_named_streams(path, label)
+
+    entries: list[_TreeEntryIdentity] = []
+    total_size = 0
