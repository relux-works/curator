+            except OSError as exc:
+                raise GoV1Error(
+                    CODE_WORKER_IDENTITY_INVALID,
+                    f"{label} changed while enumerating",
+                ) from exc
+            if _is_link_or_reparse(info):
+                raise GoV1Error(
+                    CODE_WORKER_IDENTITY_INVALID,
+                    f"{label} contains a link or reparse point",
+                )
