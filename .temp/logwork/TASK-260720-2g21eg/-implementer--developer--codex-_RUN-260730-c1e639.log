+def _resolve_identity_tree(
+    path: Path,
+    *,
+    executable_files: bool,
+    label: str,
+    max_files: int,
+    max_bytes: int,
+    ignored_names: tuple[str, ...] = (),
+) -> _TreeIdentity:
+    if not path.is_absolute():
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            f"{label} path is not absolute",
+        )
