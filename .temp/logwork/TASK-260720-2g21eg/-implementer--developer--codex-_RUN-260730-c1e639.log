+    descend(path, "")
+    file_count = sum(entry.kind == "file" for entry in entries)
+    if file_count == 0 or file_count > max_files:
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            f"{label} does not contain a bounded regular-file tree",
