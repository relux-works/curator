+                    identity=identity,
+                    arguments=("0.2",),
+                    cwd=tmp_path,
+                    environment={},
+                    timeout_seconds=1,
+                    output_limit=4096,
+                )
+            )
+        except BaseException as exc:
+            failures.append(exc)
+
+    thread = threading.Thread(target=run)
+    thread.start()
