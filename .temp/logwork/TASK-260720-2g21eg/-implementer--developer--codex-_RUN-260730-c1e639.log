+            None,
+        ):
+            raise ctypes.WinError(ctypes.get_last_error())  # type: ignore[attr-defined]
+        if accounting.active_processes == 0:
+            return
+        if time.monotonic() >= deadline:
+            raise TimeoutError("Windows worker job did not become empty")
+        time.sleep(0.005)
