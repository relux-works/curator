+def _resolve_interpreter_identity(path: Path) -> _InterpreterIdentity:
+    if not path.is_absolute():
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            "manager interpreter path is not absolute",
+        )
