+    entries: list[_TreeEntryIdentity] = []
+    for raw in raw_entries:
+        entry = _require_mapping(raw, f"{label} entry")
+        _require_exact_keys(
+            entry,
+            {"path", "kind", "sha256", "size", "device", "inode", "mode"},
