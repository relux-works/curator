+    def _setup_macos(self) -> None:
+        import select
+
+        queue_value = select.kqueue()
+        self._mac_queue = queue_value
+        changes: list[Any] = []
+        event_mask = (
+            select.KQ_NOTE_DELETE
+            | select.KQ_NOTE_WRITE
+            | select.KQ_NOTE_EXTEND
+            | select.KQ_NOTE_LINK
+            | select.KQ_NOTE_RENAME
