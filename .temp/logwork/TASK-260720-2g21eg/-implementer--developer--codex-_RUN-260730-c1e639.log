+
+def _tool_process_identity_from_mapping(
+    value: Mapping[str, object],
+) -> _ToolProcessIdentity:
+    _require_exact_keys(
+        value,
+        {"go", "tools"},
+        "Go process identity",
+    )
+    return _ToolProcessIdentity(
+        go=_executable_identity_from_mapping(
+            _require_mapping(value.get("go"), "Go executable identity"),
