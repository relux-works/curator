+        {"launcher", "interpreter", "package_tree"},
+        "manager identity",
+    )
+    return _ManagerIdentity(
+        launcher=_executable_identity_from_mapping(
+            _require_mapping(value.get("launcher"), "manager launcher"),
+            "manager launcher",
+        ),
+        interpreter=_interpreter_identity_from_mapping(
