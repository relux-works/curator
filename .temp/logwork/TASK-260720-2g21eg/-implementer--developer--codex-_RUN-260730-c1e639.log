+        go_v1.SubprocessProcessExecutor().run(
+            go_v1.ProcessRequest(
+                executable=plan.go_executable,
+                identity=plan.process_identity,
+                arguments=plan.list_argv,
+                cwd=plan.directory,
+                environment=plan.environment,
+                timeout_seconds=1,
+                output_limit=4096,
