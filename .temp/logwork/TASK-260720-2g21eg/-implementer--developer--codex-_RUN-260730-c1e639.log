+def _indispensable_worker_environment(
+    platform: str,
+    worker_cache: Path,
+) -> dict[str, str]:
+    result = {
+        "PYTHONDONTWRITEBYTECODE": "1",
+        "PYTHONPYCACHEPREFIX": os.fspath(worker_cache),
     }
+    if platform == PLATFORM_MACOS:
+        return result
+    result.update(
+        {
+            name: value
+            for name in ("SYSTEMROOT", "WINDIR")
+            if (value := os.environ.get(name))
+        }
+    )
+    return result
 
 
