+                absolute,
+                executable=executable_files,
+                label=f"{label} file {relative!r}",
+                max_bytes=max_bytes,
+            )
+            total_size += identity.size
+            if len(entries) + 1 > max_files or total_size > max_bytes:
+                raise GoV1Error(
+                    CODE_WORKER_IDENTITY_INVALID,
+                    f"{label} exceeds its identity bound",
