+        max_bytes=_MAX_MANAGER_PACKAGE_BYTES,
+        ignored_names=("__pycache__",),
+    )
+    return _ManagerIdentity(
+        launcher=launcher_identity,
+        interpreter=interpreter,
+        package_tree=package_tree,
+    )
