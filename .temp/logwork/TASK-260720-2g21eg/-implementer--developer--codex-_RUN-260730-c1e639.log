+                    changed = sorted(
+                        {
+                            os.fspath(self._mac_paths.get(event.ident, Path("?")))
+                            for event in events
+                        }
+                    )
+                    failure = GoV1Error(
+                        CODE_WORKER_IDENTITY_INVALID,
+                        "an execution identity changed while the worker ran: "
+                        + ", ".join(changed[:8]),
+                    )
