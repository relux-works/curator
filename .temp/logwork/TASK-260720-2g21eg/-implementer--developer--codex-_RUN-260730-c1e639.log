+        if not is_valid_portable_path(relative):
+            raise GoV1Error(
+                CODE_WORKER_PROTOCOL_INVALID,
+                f"{label} carries a non-portable path",
+            )
+        kind = _require_string(entry.get("kind"), f"{label} entry kind")
+        if kind not in {"directory", "file"}:
