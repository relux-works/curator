+def _tree_identity_from_mapping(
+    value: Mapping[str, object],
+    *,
+    executable_files: bool,
+    label: str,
+    max_files: int,
+    max_bytes: int,
+    ignored_names: tuple[str, ...] = (),
+) -> _TreeIdentity:
+    _require_exact_keys(
+        value,
+        {
+            "path",
+            "sha256",
+            "total_size",
+            "root_device",
+            "root_inode",
+            "root_mode",
+            "entries",
+        },
