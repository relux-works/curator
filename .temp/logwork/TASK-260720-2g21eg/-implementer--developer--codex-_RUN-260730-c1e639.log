+                )
+            executable = _resolve_executable_identity(
+                current.resolve(strict=True),
+                label="manager interpreter",
+            )
+            return _InterpreterIdentity(
+                invocation_path=invocation_path,
+                links=tuple(links),
+                executable=executable,
