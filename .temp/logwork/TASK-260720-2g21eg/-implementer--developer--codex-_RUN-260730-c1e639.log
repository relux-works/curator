+        (after.st_dev, after.st_ino) != (root_stat.st_dev, root_stat.st_ino)
+        or stat.S_IMODE(after.st_mode) != stat.S_IMODE(root_stat.st_mode)
+        or _is_link_or_reparse(after)
+    ):
