+def test_macos_identity_guard_detects_tool_replacement_and_restore(
+    tmp_path: Path,
+):
+    goroot = tmp_path / "goroot"
+    go_executable = goroot / "bin" / "go"
+    go_executable.parent.mkdir(parents=True)
+    shutil.copyfile("/bin/sleep", go_executable)
