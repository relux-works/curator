+def _resolve_tool_process_identity(
+    go_executable: Path,
+    tool_directory: Path,
+) -> _ToolProcessIdentity:
+    return _ToolProcessIdentity(
+        go=_resolve_executable_identity(
+            go_executable,
+            label="fingerprinted GOROOT/bin/go",
+        ),
