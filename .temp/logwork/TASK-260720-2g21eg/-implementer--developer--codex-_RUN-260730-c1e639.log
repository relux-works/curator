+
+    class MutatingExecutor(RecordingExecutor):
+        def run(self, request: go_v1.ProcessRequest) -> go_v1.ProcessResult:
+            result = super().run(request)
+            package_file.write_bytes(
+                package_file.read_bytes() + b"# replaced in session\n"
+            )
+            return result
