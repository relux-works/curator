+    tool_directory = goroot / "pkg" / "tool" / "darwin_arm64"
+    tool_directory.mkdir(parents=True)
+    compiler = tool_directory / "compile"
+    shutil.copyfile("/usr/bin/true", compiler)
+    compiler.chmod(0o755)
