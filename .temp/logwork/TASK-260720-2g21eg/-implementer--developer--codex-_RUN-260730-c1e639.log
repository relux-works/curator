+    )
+    assert [frame["kind"] for frame in frames[:-1]] == ["ready", "failure"]
+    assert frames[-2]["failure"]["code"] == (
+        go_v1.CODE_WORKER_IDENTITY_INVALID
+    )
+    assert frames[-1] == {"worker_status": 3}
+    assert len(executor.calls) == 1
