+def _terminate_windows_job(handle: int, timeout: float) -> None:
+    kernel32 = _windows_kernel32()
+    terminate = kernel32.TerminateJobObject
+    terminate.argtypes = [ctypes.c_void_p, ctypes.c_uint32]
+    terminate.restype = ctypes.c_int
