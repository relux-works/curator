+        except OSError as exc:
+            raise GoV1Error(
+                CODE_WORKER_IDENTITY_INVALID,
+                "cannot inspect the installed manager Python prefix",
+            ) from exc
+        for child in children:
+            if not child.name.startswith("python"):
