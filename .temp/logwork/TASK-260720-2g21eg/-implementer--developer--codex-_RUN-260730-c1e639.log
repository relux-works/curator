+def test_manager_identity_binds_launcher_interpreter_and_package_tree(
+    tmp_path: Path,
+):
+    plan, _, _ = _worker_fixture(tmp_path)
+    identity = plan.executable
+    assert list(identity.to_dict()) == [
+        "launcher",
+        "interpreter",
+        "package_tree",
