+func TestCompiledInstallDriftStillRestagesContext(t *testing.T) {
+	tests := map[string]func(*testing.T, *env, *fakeToolchain, *fakeCache){
+		"build source": func(_ *testing.T, e *env, _ *fakeToolchain, cache *fakeCache) {
+			repository := filepath.Join(e.skillsRoot, "build-skill")
+			e.write(repository, "src/cmd/alpha/main.go", "package main\n\nfunc main() { println(\"changed\") }\n")
+			e.git(repository, "add", ".")
+			e.git(repository, "commit", "-qm", "change build source")
+			e.git(repository, "tag", "-f", "v1")
+			delete(cache.byCommand, "alpha")
+		},
+		"target": func(t *testing.T, _ *env, toolchain *fakeToolchain, cache *fakeCache) {
+			key := nativeTuningKey(toolchain.target.GOARCH)
+			if key == "" {
+				t.Fatalf("test target %s has no mutable native tuning input", toolchain.target.GOARCH)
+			}
+			toolchain.target.Tuning[key] = "v2"
+			delete(cache.byCommand, "alpha")
+		},
+		"toolchain": func(_ *testing.T, _ *env, toolchain *fakeToolchain, cache *fakeCache) {
+			toolchain.toolchain.GoVersion = "1.25.1"
+			delete(cache.byCommand, "alpha")
+		},
+		"cache entry": func(_ *testing.T, _ *env, _ *fakeToolchain, cache *fakeCache) {
+			result := cache.byCommand["alpha"]
+			result.Status = buildcache.UntrustedProvenance
+			result.Reason = "protected cache identity changed"
+			cache.byCommand["alpha"] = result
+		},
+		"context boundary": func(_ *testing.T, e *env, _ *fakeToolchain, cache *fakeCache) {
+			repository := filepath.Join(e.skillsRoot, "build-skill")
+			e.write(repository, "references/new.md", "new prompt context\n")
+			e.git(repository, "add", ".")
+			e.git(repository, "commit", "-qm", "change prompt context")
+			e.git(repository, "tag", "-f", "v1")
+			delete(cache.byCommand, "alpha")
+		},
+	}
+	for name, mutate := range tests {
+		t.Run(name, func(t *testing.T) {
+			e := newEnv(t)
+			e.buildSkill("build-skill", "alpha")
+			e.declare("build-skill")
+			deps, toolchain, cache, builder := newFakeDeps(t)
+			if first := e.install(Options{Build: deps}); first.Status != "ok" {
+				t.Fatalf("first install failed: %+v", first)
+			}
+			installed := filepath.Join(e.project, ".agents", "skills", "build-skill")
+			before := treeDigest(t, installed)
+			buildsBefore := len(builder.calls)
+
+			mutate(t, e, toolchain, cache)
+			deps.Clock = fixedClock{at: time.Unix(1_800_000_000, 0).UTC()}
+			second := e.install(Options{Build: deps})
+			if second.Status != "ok" {
+				t.Fatalf("drifted install failed: %+v", second)
+			}
+			if len(builder.calls) != buildsBefore+1 || len(second.Staged) != 1 {
+				t.Fatalf("drift did not stage exactly one replacement build: staged=%v calls=%v",
+					second.Staged, builder.calls)
+			}
+			if len(second.Builds) != 1 || second.Builds[0].Outcome() == BuildCacheHit {
+				t.Fatalf("drifted build plan = %+v, want a non-hit", second.Builds)
+			}
+			messages := strings.Join(second.Messages, "\n")
+			if !strings.Contains(messages, "build-skill") || !strings.Contains(messages, "installed") {
+				t.Fatalf("drifted install did not re-stage context:\n%s", messages)
+			}
+			if after := treeDigest(t, installed); after == before {
+				t.Fatal("drifted compiled context remained byte-identical")
+			}
+		})
+	}
+}
