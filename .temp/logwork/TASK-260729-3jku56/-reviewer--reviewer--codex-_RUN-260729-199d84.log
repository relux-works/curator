+func TestRepeatedUnchangedCompiledInstallIsUpToDateWithoutRestagingContext(t *testing.T) {
+	e := newEnv(t)
+	e.buildSkill("build-skill", "alpha")
+	e.declare("build-skill")
+	deps, _, _, builder := newFakeDeps(t)
+
+	first := e.install(Options{Build: deps})
+	if first.Status != "ok" {
+		t.Fatalf("first install failed: %+v", first)
+	}
+	installed := filepath.Join(e.project, ".agents", "skills", "build-skill")
+	before := treeDigest(t, installed)
+	buildsBefore := len(builder.calls)
+
+	deps.Clock = fixedClock{at: time.Unix(1_800_000_000, 0).UTC()}
+	second := e.install(Options{Build: deps})
+	if second.Status != "ok" {
+		t.Fatalf("second install failed: %+v", second)
+	}
+	if len(second.Staged) != 0 || len(builder.calls) != buildsBefore {
+		t.Fatalf("unchanged cache hit rebuilt: staged=%v builder calls=%v", second.Staged, builder.calls)
+	}
+	if len(second.Builds) != 1 || second.Builds[0].Outcome() != BuildCacheHit {
+		t.Fatalf("second build plan = %+v, want one cache hit", second.Builds)
+	}
+	messages := strings.Join(second.Messages, "\n")
+	if !strings.Contains(messages, "build-skill") || !strings.Contains(messages, "up-to-date") {
+		t.Fatalf("second install did not report the compiled skill up-to-date:\n%s", messages)
+	}
+	if after := treeDigest(t, installed); after != before {
+		t.Fatal("unchanged compiled context was re-staged")
+	}
+}
+
