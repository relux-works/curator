+func TestUnavailableCompiledCurrentnessFailsClosedAndPreservesInstalledContext(t *testing.T) {
+	e := newEnv(t)
+	e.buildSkill("build-skill", "alpha")
+	e.declare("build-skill")
+	deps, _, _, _ := newFakeDeps(t)
+	if first := e.install(Options{Build: deps}); first.Status != "ok" {
+		t.Fatalf("first install failed: %+v", first)
+	}
+	installed := filepath.Join(e.project, ".agents", "skills", "build-skill")
+	before := treeDigest(t, installed)
+
+	second := e.install(Options{Build: deps, OnStaged: func(Staged) error {
+		return os.RemoveAll(e.snapshotDir("build-skill"))
+	}})
+	if second.Status != "failed" {
+		t.Fatalf("install with unavailable raw snapshot = %+v, want failed", second)
+	}
+	if strings.Contains(strings.Join(second.Messages, "\n"), "up-to-date") {
+		t.Fatalf("unavailable currentness was promoted to up-to-date: %v", second.Messages)
+	}
+	if after := treeDigest(t, installed); after != before {
+		t.Fatal("failed currentness derivation changed the installed context")
+	}
+}
