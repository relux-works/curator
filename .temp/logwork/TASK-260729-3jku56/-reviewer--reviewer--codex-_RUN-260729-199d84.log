+func TestDerivedBuildCurrentnessUsesCompleteStaticFileSets(t *testing.T) {
+	snapshot := t.TempDir()
+	write := func(relative, content string) {
+		t.Helper()
+		path := filepath.Join(snapshot, filepath.FromSlash(relative))
+		if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("SKILL.md", "---\nname: boundaries\ndescription: d\n---\n")
+	write("assets/prompt.md", "prompt\n")
+	write("assets/build/go.mod", "module example.com/boundaries\n")
+	write("assets/build/cmd/alpha/main.go", "package main\nfunc main() {}\n")
+	write("references/info.md", "reference\n")
+	write("runtime/bin/helper", "#!/bin/sh\n")
+	write("runtime/README.md", "runtime support file\n")
+	node := &closure.Node{
+		Name:     "boundaries",
+		Snapshot: snapshot,
+		Spec: &skillspec.Spec{
+			SchemaVersion: 6,
+			RuntimeRoots:  []string{"runtime"},
+			BuildRoots:    []string{"assets/build"},
+			Commands: map[string]skillspec.Command{
+				"alpha": {
+					Name: "alpha", Type: "build", Driver: buildmeta.DriverGoV1,
+					SourceDir: "assets/build/cmd/alpha",
+				},
+				"helper": {
+					Name: "helper", Type: "script",
+					UnixPath: "runtime/bin/helper", WinPath: "runtime/bin/helper",
+				},
+			},
+		},
+		Edges: []closure.Edge{{Consumer: closure.ProjectEdge, Mode: "full"}},
+	}
+
+	contextFiles, err := desiredContextFiles(node)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantContext := []string{"SKILL.md", "assets/prompt.md", "references/info.md"}
+	if strings.Join(contextFiles, "\n") != strings.Join(wantContext, "\n") {
+		t.Fatalf("context files = %v, want %v", contextFiles, wantContext)
+	}
+	runtimeFiles, err := desiredRuntimeFiles(node, "unix")
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantRuntime := []string{"runtime/README.md", "runtime/bin/helper"}
+	if strings.Join(runtimeFiles, "\n") != strings.Join(wantRuntime, "\n") {
+		t.Fatalf("runtime files = %v, want complete set %v", runtimeFiles, wantRuntime)
+	}
+}
