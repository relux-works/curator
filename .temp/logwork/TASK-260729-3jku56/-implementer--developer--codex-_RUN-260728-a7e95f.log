+		relative := command.UnixPath
+		if platform == "windows" {
+			relative = command.WinPath
+		}
+		info, err := os.Lstat(filepath.Join(node.Snapshot, filepath.FromSlash(relative)))
+		if err != nil {
+			return nil, err
+		}
+		if !info.Mode().IsRegular() {
+			return nil, fmt.Errorf("runtime command path is not a regular file: %s", relative)
+		}
+		files = append(files, relative)
+	}
+	return normalizedFileSet(files), nil
+}
+
+// selectedSnapshotFiles returns every regular file below the named
+// protocol-relative roots, applying the same static exclusions as context
+// staging. Missing optional roots are absent; every other read failure is
+// unavailable currentness and therefore fails closed.
+func selectedSnapshotFiles(snapshot string, roots, excluded []string) ([]string, error) {
+	var files []string
+	for _, root := range normalizedFileSet(roots) {
+		source := filepath.Join(snapshot, filepath.FromSlash(root))
+		info, err := os.Stat(source)
+		if os.IsNotExist(err) {
+			continue
+		}
+		if err != nil {
+			return nil, err
+		}
+		if whitelist.PathExcluded(root, excluded) {
+			continue
+		}
+		if !info.IsDir() {
+			if !info.Mode().IsRegular() {
+				return nil, fmt.Errorf("selected snapshot path is not a regular file: %s", root)
+			}
+			files = append(files, root)
+			continue
+		}
+		err = filepath.WalkDir(source, func(path string, entry fs.DirEntry, walkErr error) error {
+			if walkErr != nil {
+				return walkErr
+			}
+			relative, err := filepath.Rel(snapshot, path)
+			if err != nil {
+				return err
+			}
+			posix := filepath.ToSlash(relative)
+			if entry.IsDir() {
+				if path != source && whitelist.PathExcluded(posix, excluded) {
+					return filepath.SkipDir
+				}
+				return nil
+			}
+			if whitelist.PathExcluded(posix, excluded) {
+				return nil
+			}
+			info, err := entry.Info()
+			if err != nil {
+				return err
+			}
+			if !info.Mode().IsRegular() {
+				return fmt.Errorf("selected snapshot path is not a regular file: %s", posix)
+			}
+			files = append(files, posix)
+			return nil
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+	return normalizedFileSet(files), nil
+}
+
+func normalizedFileSet(values []string) []string {
+	seen := make(map[string]bool, len(values))
+	normalized := make([]string, 0, len(values))
+	for _, value := range values {
+		value = filepath.ToSlash(value)
+		if value == "" || seen[value] {
+			continue
+		}
+		seen[value] = true
+		normalized = append(normalized, value)
+	}
+	sort.Strings(normalized)
+	return normalized
+}
