+   $ApprovedGo = Join-Path $ApprovedGoRoot 'bin\go.exe'
+   Get-Item -Force -LiteralPath $ApprovedGoRoot
+   Get-Item -Force -LiteralPath $ApprovedGo
+   Get-FileHash -Algorithm SHA256 -LiteralPath $ApprovedGo
