+		if err := os.WriteFile(path, []byte("present"), 0o600); err != nil {
+			tb.Fatal(err)
+		}
+		targets = append(targets, namespaceTargetRecord(index, "class", fmt.Sprintf("id-%03d", index), path))
+	}
+	return targets
+}
