  2518	        raise TransactionCorruptionError(
  2519	            f"partial staging entry is not a regular file: {path}"
  2520	        )
  2521	    if length < 0 or length > before.st_size:
  2522	        raise TransactionCorruptionError(
  2523	            f"partial staging prefix length is invalid: {path}"
