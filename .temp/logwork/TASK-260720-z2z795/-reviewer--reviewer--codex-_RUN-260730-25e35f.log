  2525	    digest = hashlib.sha256(_STAGING_PREFIX_DOMAIN)
  2526	    remaining = length
  2527	    with path.open("rb") as handle:
  2528	        while remaining:
  2529	            chunk = handle.read(min(_STAGING_COPY_CHUNK_SIZE, remaining))
