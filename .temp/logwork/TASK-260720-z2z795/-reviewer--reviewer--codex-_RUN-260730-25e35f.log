   907	    if os.name == "nt":
   908	        import ctypes
   909	
   910	        process_query_limited_information = 0x1000
   911	        still_active = 259
   912	        kernel32 = ctypes.windll.kernel32  # type: ignore[attr-defined]
   913	        handle = kernel32.OpenProcess(process_query_limited_information, False, pid)
