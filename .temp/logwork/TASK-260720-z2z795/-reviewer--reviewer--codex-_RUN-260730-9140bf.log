   181	def _canonicalize_windows_identity(
   182	    existing: str,
   183	    missing: list[str],
   184	    *,
   185	    case_sensitive: Callable[[str], bool],
   186	) -> str:
   187	    """Canonicalize each component using its parent directory's lookup rules."""
   188	    normalized = ntpath.normpath(existing)
   189	    volume, tail = ntpath.splitdrive(normalized)
   190	    if not volume or not tail.startswith(("\\", "/")):
   191	        raise ValueError("Windows physical identity has no absolute volume")
   192	    root = volume + "\\"
   193	    components = [value for value in re.split(r"[\\/]+", tail.lstrip("\\/")) if value]
   194	    lookup = root
   195	    canonical = volume.upper() + "\\"
   196	    parent_is_case_sensitive = case_sensitive(lookup)
   197	    for index, component in enumerate(components):
   198	        identity_component = (
   199	            component if parent_is_case_sensitive else component.upper()
   200	        )
   201	        canonical = ntpath.join(canonical, identity_component)
   202	        lookup = ntpath.join(lookup, component)
   203	        if index + 1 < len(components) or missing:
   204	            parent_is_case_sensitive = case_sensitive(lookup)
   205	    for component in reversed(missing):
   206	        identity_component = (
   207	            component if parent_is_case_sensitive else component.upper()
   208	        )
   209	        canonical = ntpath.join(canonical, identity_component)
   210	        parent_is_case_sensitive = False
   211	    return ntpath.normpath(canonical)
