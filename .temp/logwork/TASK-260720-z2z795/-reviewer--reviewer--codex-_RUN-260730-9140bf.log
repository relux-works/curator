   140	def _longest_existing_prefix(path: Path) -> tuple[Path, list[str]]:
   141	    current = path
   142	    missing: list[str] = []
   143	    while True:
   144	        try:
   145	            current.lstat()
   146	            return current, missing
   147	        except FileNotFoundError:
   148	            parent = current.parent
   149	            if parent == current:
   150	                raise
   151	            missing.append(current.name)
   152	            current = parent
