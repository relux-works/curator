   155	def _canonicalize_darwin_existing_path(path: Path) -> Path:
   156	    """Recover the stored spelling selected by macOS filesystem lookup."""
   157	    if not path.is_absolute():
   158	        raise ValueError("physical identity path is not absolute")
   159	    current = Path(path.anchor)
   160	    for component in path.parts[1:]:
   161	        requested = current / component
   162	        requested_info = requested.lstat()
   163	        matches: list[str] = []
   164	        with os.scandir(current) as entries:
   165	            for entry in entries:
   166	                try:
   167	                    entry_info = entry.stat(follow_symlinks=False)
   168	                except FileNotFoundError:
   169	                    continue
   170	                if os.path.samestat(requested_info, entry_info):
   171	                    matches.append(entry.name)
   172	        if not matches:
   173	            raise OSError(f"cannot recover stored path spelling for {requested}")
   174	        matches.sort(key=unsigned_utf8_key)
   175	        current /= matches[0]
   176	    if not os.path.samefile(path, current):
   177	        raise OSError(f"physical path identity changed while resolving {path}")
   178	    return current
