import json
import tempfile
from pathlib import Path

from csk.locking import ManagerHomeLock
from csk.transactions import MutableTarget, TransactionEngine, TransactionError, TransactionPlan, digest_path

class Crash(BaseException):
    pass

def write(path: Path, value: str) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(value, encoding=\"utf-8\")
    return path

with tempfile.TemporaryDirectory() as raw:
    root = Path(raw)
    home = root / \"home\"
    live = write(root / \"live\", \"old\")
    desired = write(root / \"desired\", \"new\")
    target = MutableTarget(
        target_class=\"10-context\",
        identifier=\"skill\",
        live_path=live,
        desired_path=desired,
        expected_preimage_digest=digest_path(live),
    )
    plan = TransactionPlan(
        transaction_id=\"txn-canonical-reappeared\",
        project_identity=str((root / \"project\").resolve()),
        targets=(target,),
    )

    def crash(point, target_record):
        del target_record
        if point == \"journal_tombed\":
            raise Crash(point)

    engine = TransactionEngine(home, fault_hook=crash)
    with ManagerHomeLock(home) as lock:
        engine.prepare(lock, plan)
        try:
            engine.commit(lock, plan.transaction_id)
        except Crash:
            pass
        else:
            raise AssertionError(\"journal tomb crash was not reached\")

    journal_tomb = engine.journal_root / f\"{plan.transaction_id}.json.delete\"
    record = json.loads(journal_tomb.read_text(encoding=\"utf-8\"))
    backup = next(value for value in record[\"cleanup_sidecars\"] if value[\"role\"] == \"backup\")
    assert backup[\"state\"] == \"removed\"
    reappeared = write(Path(backup[\"path\"]), \"old\")
    before = digest_path(reappeared)

    with ManagerHomeLock(home) as lock:
        try:
            TransactionEngine(home).recover(lock)
        except TransactionError as exc:
            assert \"reappeared\" in str(exc)
        else:
            raise AssertionError(\"canonical reappearance was accepted\")

    assert digest_path(reappeared) == before
    assert journal_tomb.exists()
    assert live.read_text(encoding=\"utf-8\") == \"new\"
    print(\"canonical_removed_sidecar_preserved=True\")
    print(\"journal_tomb_preserved=True\")
    print(\"committed_live_preserved=True\")
