JOURNAL_SCHEMA = "csk-install-transaction-v1"
_TRANSACTION_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
_DIGEST_DOMAIN = b"csk-transaction-target-v1\0"
