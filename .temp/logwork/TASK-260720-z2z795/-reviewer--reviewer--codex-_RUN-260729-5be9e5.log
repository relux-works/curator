   353	def _pid_alive(pid: int) -> bool:
   354	    if pid <= 0:
   355	        return False
   356	    if os.name == "nt":
   357	        import ctypes
   358	
   359	        process_query_limited_information = 0x1000
   360	        still_active = 259
   361	        kernel32 = ctypes.windll.kernel32  # type: ignore[attr-defined]
   362	        handle = kernel32.OpenProcess(process_query_limited_information, False, pid)
   363	        if not handle:
   364	            return False
   365	        try:
   366	            exit_code = ctypes.c_ulong()
   367	            if kernel32.GetExitCodeProcess(handle, ctypes.byref(exit_code)):
   368	                return exit_code.value == still_active
   369	            return True
   370	        finally:
   371	            kernel32.CloseHandle(handle)
   372	    try:
   373	        os.kill(pid, 0)
   374	    except ProcessLookupError:
   375	        return False
   376	    except PermissionError:
   377	        return True
   378	    except OSError:
   379	        return True
   380	    return True
