   646	                        f"desired target changed while planning: {source}"
   647	                    )
   648	                staged = _sidecar(live, plan.transaction_id, index, "desired")
   649	            backup = _sidecar(live, plan.transaction_id, index, "backup")
   650	            rollback = _sidecar(live, plan.transaction_id, index, "rollback")
   651	            records.append(
   652	                JournalTarget(
   653	                    target_class=target.target_class,
   654	                    identifier=target.identifier,
   655	                    live_path=str(live),
   656	                    staged_path=str(staged) if staged is not None else None,
   657	                    staged_source=str(source) if source is not None else None,
   658	                    staging_entries=staging_entries,
   659	                    backup_path=str(backup),
   660	                    rollback_path=str(rollback),
   661	                    expected_preimage_digest=target.expected_preimage_digest,
   662	                    expected_generation=target.expected_generation,
