   336	    def referenced_generation_digests(self, lock: HomeLockWitness) -> dict[str, str]:
   337	        lock.assert_held()
   338	        with self._mutex, self._witness_scope(lock):
   339	            result: dict[str, str] = {}
   340	            for transaction_id in self._journal_ids():
   341	                journal, deleting = self._load_journal_record(transaction_id)
   342	                if deleting:
   343	                    continue
   344	                for key, digest in journal.generation_digests.items():
   345	                    previous = result.setdefault(key, digest)
   346	                    if previous != digest:
   347	                        raise TransactionCorruptionError(
   348	                            f"generation {key!r} has conflicting journal digests"
   349	                        )
   350	            return dict(sorted(result.items(), key=lambda item: _utf8_key(item[0])))
