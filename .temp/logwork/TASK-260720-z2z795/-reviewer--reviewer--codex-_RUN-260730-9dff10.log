            live_path=live,
            desired_path=desired,
            expected_preimage_digest=ABSENT_DIGEST,
        ),),
    )
    with ManagerHomeLock(home, timeout=1) as lock:
        engine.prepare(lock, plan)
        real_rename = transactions._rename_no_replace
        def crash_before_install(source: Path, destination: Path) -> None:
            if destination == live:
                raise SimulatedCrash(\"crash after durable backed_up state\")
            real_rename(source, destination)
