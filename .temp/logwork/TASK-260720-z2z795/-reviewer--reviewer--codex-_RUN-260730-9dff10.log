  "Intended Audience :: Developers",
  "Operating System :: MacOS",
  "Operating System :: POSIX :: Linux",
  "Operating System :: Microsoft :: Windows",
  "Programming Language :: Python :: 3",
  "Programming Language :: Python :: 3.11",
  "Programming Language :: Python :: 3.12",
  "Programming Language :: Python :: 3.13",
  "Programming Language :: Python :: 3.14",
  "Topic :: Software Development",
  "Topic :: Software Development :: Build Tools",
  "Topic :: System :: Software Distribution",
]
dependencies = []

[project.optional-dependencies]
dev = [
  "pytest>=9",
  "build>=1.2",
  "twine>=5",
  "mypy>=1.14",
  "cryptography>=44",
]

[project.scripts]
csk = "csk.cli:main"

[project.urls]
Homepage = "https://github.com/ivanopcode/cocoaskills"
Source = "https://github.com/ivanopcode/cocoaskills"
Issues = "https://github.com/ivanopcode/cocoaskills/issues"
Changelog = "https://github.com/ivanopcode/cocoaskills/blob/main/CHANGELOG.md"
Documentation = "https://github.com/ivanopcode/cocoaskills/blob/main/docs/mvp-design.md"

[tool.setuptools]
package-dir = { "" = "src" }

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
"csk.audit" = ["prompts/*.md", "prompts/*.json"]

[tool.setuptools_scm]
version_file = "src/csk/_version.py"

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]

[tool.mypy]
strict = true
python_version = "3.11"
files = ["src/csk"]

