   152	    def __init__(self, csk_home: Path, *, fault_hook: FaultHook | None = None):
   153	        self.home = csk_home.expanduser().resolve(strict=False)
   154	        self.journal_root = self.home / "state" / "transactions" / "v1"
   155	        self._fault_hook = fault_hook
   156	        self._mutex = threading.Lock()
   157	        self._active_witness: HomeLockWitness | None = None
