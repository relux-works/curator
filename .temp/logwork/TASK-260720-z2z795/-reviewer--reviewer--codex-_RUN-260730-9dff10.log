   614	        for index, target in enumerate(targets):
   615	            _validate_text(target.target_class, "target class")
   616	            _validate_text(target.identifier, "target identifier")
   617	            key = (target.target_class, target.identifier)
   618	            if key in seen_keys:
   619	                raise TransactionError(
   620	                    f"duplicate target: {target.target_class}/{target.identifier}"
   621	                )
   622	            seen_keys.add(key)
