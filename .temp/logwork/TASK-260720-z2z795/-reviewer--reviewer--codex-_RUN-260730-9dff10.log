   314	    def commit(self, lock: HomeLockWitness, transaction_id: str) -> None:
   315	        lock.assert_held()
   316	        with self._mutex, self._witness_scope(lock):
   317	            journal = self._load_journal(transaction_id)
   318	            self._resume(journal)
