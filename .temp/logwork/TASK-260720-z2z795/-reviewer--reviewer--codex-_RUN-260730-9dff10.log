   159	    def prepare(self, lock: HomeLockWitness, plan: TransactionPlan) -> Journal:
   160	        lock.assert_held()
   161	        with self._mutex, self._witness_scope(lock):
   162	            journal, sources = self._build_journal(plan)
   163	            path = self._journal_path(journal.transaction_id)
   164	            if path.exists():
   165	                raise TransactionError(
   166	                    f"transaction already exists: {journal.transaction_id}"
   167	                )
   168	            self._save_journal(journal, create=True)
   169	            try:
   170	                for target_index, (target, source) in enumerate(
   171	                    zip(journal.targets, sources, strict=True)
   172	                ):
   173	                    if source is None:
   174	                        continue
   175	                    assert target.staged_path is not None
   176	                    self._stage_target(journal, target_index, source)
   177	                    if digest_path(Path(target.staged_path)) != target.desired_digest:
   178	                        raise TransactionCorruptionError(
   179	                            f"staged target changed while preparing: {target.target_class}/{target.identifier}"
   180	                        )
   181	                for target in journal.targets:
   182	                    target.staged_source = None
   183	                    target.staging_entries = []
   184	                    target.staging_index = 0
   185	                    self._clear_staging_progress(target)
   186	                journal.phase = "prepared"
   187	                self._save_journal(journal)
   188	                self._emit("prepared", None)
   189	                return _clone_journal(journal)
   190	            except Exception:
   191	                self._discard_prepared(journal)
   192	                raise
