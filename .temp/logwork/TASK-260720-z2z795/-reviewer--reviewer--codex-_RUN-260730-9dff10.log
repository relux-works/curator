   320	    def recover(self, lock: HomeLockWitness) -> None:
   321	        """Recover every home journal, regardless of the initiating project."""
   322	        lock.assert_held()
   323	        with self._mutex, self._witness_scope(lock):
   324	            for transaction_id in self._journal_ids():
   325	                journal, deleting = self._load_journal_record(transaction_id)
   326	                try:
   327	                    if deleting:
   328	                        self._finish_journal_removal(journal)
   329	                    else:
   330	                        self._resume(journal)
   331	                except Exception as exc:
   332	                    raise TransactionError(
   333	                        f"recover transaction {transaction_id}: {exc}"
   334	                    ) from exc
