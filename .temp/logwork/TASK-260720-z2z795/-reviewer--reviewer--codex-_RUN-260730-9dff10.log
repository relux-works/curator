   624	                target.expected_generation is None
   625	            ):
   626	                raise TransactionError(
   627	                    f"target must provide exactly one expected preimage or generation: "
   628	                    f"{target.target_class}/{target.identifier}"
   629	                )
   630	            live = target.live_path.expanduser().resolve(strict=False)
   631	            generation_path = _validate_generation_path(target.generation_path)
   632	            desired_digest = ABSENT_DIGEST
   633	            staged: Path | None = None
   634	            source: Path | None = None
   635	            staging_entries: list[StagingTreeEntry] = []
   636	            if target.desired_path is not None:
   637	                source = target.desired_path.expanduser().resolve(strict=True)
   638	                if source == live:
   639	                    raise TransactionError(f"target stages from its live path: {live}")
   640	                desired_digest = digest_path(source)
   641	                if desired_digest == ABSENT_DIGEST:
   642	                    raise TransactionError(f"desired target is absent: {source}")
   643	                staging_entries = _staging_manifest(source)
   644	                if digest_path(source) != desired_digest:
