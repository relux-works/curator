import json
import os
import tempfile
from pathlib import Path
from csk.locking import ManagerHomeLock
from csk.transactions import MutableTarget, TransactionEngine, TransactionPlan, digest_path

with tempfile.TemporaryDirectory(prefix=\"csk-review-readonly-cleanup-\") as raw:
    root = Path(raw)
    home = root / \"home\"
    parent = root / \"targets\"
    live = parent / \"live\"
    desired = root / \"desired\"
    live.mkdir(parents=True)
    (live / \"old\").write_text(\"old\", encoding=\"utf-8\")
    live.chmod(0o555)
    desired.mkdir()
    (desired / \"new\").write_text(\"new\", encoding=\"utf-8\")
    engine = TransactionEngine(home)
    plan = TransactionPlan(
        transaction_id=\"readonly-cleanup\",
        project_identity=\"/project\",
        targets=(MutableTarget(
            target_class=\"context\",
            identifier=\"directory\",
            live_path=live,
            desired_path=desired,
            expected_preimage_digest=digest_path(live),
        ),),
    )
    try:
        with ManagerHomeLock(home, timeout=1) as lock:
            engine.prepare(lock, plan)
            try:
                engine.commit(lock, \"readonly-cleanup\")
            except Exception as exc:
                error = f\"{type(exc).__name__}: {exc}\"
            else:
                error = None
            result = {
                \"commit_returned\": error is None,
                \"error\": error,
                \"live_new\": (live / \"new\").read_text(encoding=\"utf-8\") if (live / \"new\").exists() else None,
                \"journals\": sorted(p.name for p in engine.journal_root.glob(\"*.json\")),
                \"sidecars\": sorted(p.name for p in parent.glob(\".csk-txn-*\")),
            }
        print(json.dumps(result, sort_keys=True))
    finally:
        for current, directories, files in os.walk(root, topdown=False):
            for name in files:
                try:
                    (Path(current) / name).chmod(0o600)
                except FileNotFoundError:
                    pass
            for name in directories:
                try:
                    (Path(current) / name).chmod(0o700)
                except FileNotFoundError:
                    pass
        root.chmod(0o700)
