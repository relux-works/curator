+    preparation_barrier = threading.Barrier(worker_count)
+    acquired: list[int] = []
+    errors: list[Exception] = []
+    real_prepare = locking._prepare_manager_home
+
+    def synchronized_prepare(candidate: Path) -> str:
+        preparation_barrier.wait(timeout=2)
