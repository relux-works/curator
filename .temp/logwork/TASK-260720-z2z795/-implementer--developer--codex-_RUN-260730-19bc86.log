+def test_concurrent_home_preparation_avoids_canonicalization_stampede(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+):
+    home = tmp_path / "home"
+    home.mkdir()
+    worker_count = 12
