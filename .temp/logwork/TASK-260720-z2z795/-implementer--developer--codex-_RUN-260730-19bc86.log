   535	class ProjectLocks:
   536	    """Acquire a project set by canonical identity in unsigned UTF-8 order."""
   537	
   538	    def __init__(
   539	        self,
   540	        csk_home: Path,
   541	        projects: list[Path] | tuple[Path, ...],
   542	        *,
   543	        timeout: float | None = None,
   544	    ):
   545	        by_identity = {
   546	            canonical_project_identity(project): project for project in projects
   547	        }
   548	        identities = sorted(by_identity, key=unsigned_utf8_key)
   549	        self.locks = [
   550	            ProjectLock(csk_home, by_identity[identity], timeout=timeout)
   551	            for identity in identities
   552	        ]
   553	
   554	    def __enter__(self) -> Self:
   555	        acquired: list[ProjectLock] = []
   556	        try:
   557	            for lock in self.locks:
   558	                lock.__enter__()
   559	                acquired.append(lock)
   560	        except BaseException:
   561	            for lock in reversed(acquired):
   562	                lock.__exit__(None, None, None)
   563	            raise
   564	        return self
   565	
   566	    def __exit__(
   567	        self,
   568	        exc_type: type[BaseException] | None,
   569	        exc: BaseException | None,
   570	        tb: TracebackType | None,
   571	    ) -> None:
   572	        for lock in reversed(self.locks):
   573	            lock.__exit__(exc_type, exc, tb)
