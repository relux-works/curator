_LEGACY_STALE_BREAKER = """
import json
import os
import sys
import time
from pathlib import Path

lock_path = Path(sys.argv[1])
ready = Path(sys.argv[2])
move = Path(sys.argv[3])
moved = Path(sys.argv[4])
