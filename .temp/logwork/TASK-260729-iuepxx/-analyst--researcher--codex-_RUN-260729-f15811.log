+  toTask,
+  proposedParents.get(toTask) || toStory,
+  classification,
+]);
+const reparented = aggregate(reparentedLinks);
+if (hasCycle(["K", "S", "R", "T", "P", "Q"], reparented)) {
+  throw new Error("phase-aligned reparent proposal should be acyclic");
+}
+
