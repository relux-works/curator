GO ?= go
GOFMT ?= gofmt
MODULE          := github.com/relux-works/curator
GODRIVER_PKG    := $(MODULE)/internal/godriver
GODRIVER_IMPORTERS := $(MODULE)/cmd/curator $(MODULE)/internal/install
