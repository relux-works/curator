	@echo "recipe body ran: discovery did NOT fail closed"

bad-guard:
	@$(GO) list ./... | grep -q -x '$(GODRIVER_PKG)' || { echo 'guard: missing'; exit 1; }
	@echo 'bad-guard: reported ok'
MAKEEOF

# --------------------------------------------------------------------- drive
cd "$WORK" || exit 1
ABS="$WORK/root"
STUB_GOROOT="$ABS"; export STUB_GOROOT
PASS=0; FAIL=0

# run <label> <expected-exit> <command...>
# MODE / STUB_VER are set explicitly by each caller, never as a prefix
# assignment: in POSIX sh a prefix assignment before a FUNCTION call persists
# in the caller's shell, so `STUB_VER=go1.25.1 run …` would leak into the next
# case. (Observed: it silently turned case I red.)
run() {
  label="$1"; want="$2"; shift 2
  out="$("$@" 2>&1)"; got=$?
  if [ "$got" = "$want" ]; then
    PASS=$((PASS + 1)); verdict="PASS"
  else
    FAIL=$((FAIL + 1)); verdict="FAIL"
  fi
  printf '%-58s expected=%s actual=%s  %s\n' "$label" "$want" "$got" "$verdict"
  printf '%s\n' "$out" | sed 's/^/      | /'
  echo
}

export MODE STUB_VER

echo "=== revision-3 forms: the defect ==="
MODE=partialfail; STUB_VER=go1.25.5
run "A rev3 \$(shell go list|grep) on a failing go list" 0 \
  make -f Makefile.rev3 bad-discovery
run "B rev3 'go list | grep -q' guard on a failing go list" 0 \
  make -f Makefile.rev3 bad-guard

echo "=== corrected forms: healthy ==="
MODE=ok; STUB_VER=go1.25.5
run "E healthy toolchain + healthy go list" 0 \
  make test-linux GO="$ABS/bin/go" GOFMT="$ABS/bin/gofmt" PIN_ROOT="$WORK/pin"

echo "=== corrected forms: must fail closed ==="
MODE=partialfail; STUB_VER=go1.25.5
run "F go list fails mid-listing" 2 \
  make test-linux GO="$ABS/bin/go" GOFMT="$ABS/bin/gofmt" PIN_ROOT="$WORK/pin"
MODE=ok; STUB_VER=go1.25.5
run "G relative GO on a native host" 2 \
  make test-linux GO=go GOFMT=gofmt PIN_ROOT="$WORK/pin"
MODE=ok; STUB_VER=go1.25.1
run "H toolchain reports go1.25.1, go.mod needs 1.25.5" 2 \
  make require-toolchain GO="$ABS/bin/go" GOFMT="$ABS/bin/gofmt"

echo "=== documented hosted-runner exception ==="
MODE=ok; STUB_VER=go1.25.5
run "I TOOLCHAIN_ALLOW_PATH=1 with relative GOFMT" 0 \
  make linux-package-guard GO="$ABS/bin/go" GOFMT=gofmt TOOLCHAIN_ALLOW_PATH=1

echo "-----------------------------------------------------------"
if [ "$FAIL" = 0 ]; then
  echo "ALL $PASS EXPECTATIONS MET"; exit 0
else
  echo "$FAIL of $((PASS + FAIL)) EXPECTATIONS NOT MET"; exit 1
fi
