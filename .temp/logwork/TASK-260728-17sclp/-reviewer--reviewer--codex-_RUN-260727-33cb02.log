n ['Example.com/org/repo','example.com/org/../repo','example.com/org/repo.git']:\n    x=copy.deepcopy(receipt)\n    for side in ('declared','effective'): x['input']['source'][side]['identity']['value']=ident\n    print('identity invalid',ident,check('build-receipt-v2.schema.json',x))\nfor ident in ['example.com/Org/repo.GIT','example.com/组织/工具']:\n    x=copy.deepcopy(receipt)\n    for side in ('declared','effective'): x['input']['source'][side]['identity']['value']=ident\n    print('identity boundary',ident,check('build-receipt-v2.schema.json',x))\nx=copy.deepcopy(receipt); x['input']['source']['effective']['object_format']='sha1'; x['input']['source']['effective']['commit']='a'*40; x['input']['source']['effective']['substituted']=True; x['input']['source']['effective']['identity']={'kind':'network-git','value':'example.com/fork/repo'}; x['input']['source']['effective']['substitution']={'type':'network-git','ref':{'kind':'revision','value':'a'*64}}; print('wrong effective revision width',check('build-receipt-v2.schema.json',x))\nfor schema in ('agent-skill-v1.schema.json','csk-skill-v1.schema.json'):\n    base=v.load_json(root/f'conformance/v1/schema-cases/{schema.removesuffix(\\\".schema.json\\\")}/valid.json')\n    for field,value in [('repository','repo'),('target','tool'),('driver','go-repository-v1')]:\n        x=copy.deepcopy(base);x[field]=value;print('legacy reserved',schema,field,check(schema,x))\nskill=v.load_json(root/'conformance/v1/schema-cases/skillfile-dev-v2/valid.json')\nfor path in ['/absolute','', 'C:/absolute', '../sibling', 'dir/./repo', 'dir//repo', 'dir/../repo', '\\\\\\\\server\\\\\\\\share']:\n    x=copy.deepcopy(skill);x['build_repository_substitutions']['golden-skill']['golden-tools']={'path':path};print('local substitution path',repr(path),check('skillfile-dev-v2.schema.json',x))\nx=copy.deepcopy(receipt);x['artifact']['path']='bin/not-the-command';print('receipt artifact mismatch',check('build-receipt-v2.schema.json',x))\nx=copy.deepcopy