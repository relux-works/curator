stemCommand\": {\n      \"type\": \"object\",\n      \"required\": [\"type\", \"command\"],\n      \"properties\": {\n        \"type\": {\"const\": \"system\"},\n        \"command\": {\"$ref\": \"#/$defs/identifier\"},\n        \"hint\": {\"$ref\": \"#/$defs/nonEmptyString\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"command\": {\"oneOf\": [{\"$ref\": \"#/$defs/scriptCommand\"}, {\"$ref\": \"#/$defs/systemCommand\"}]},\n    \"buildCommandV6\": {\n      \"type\": \"object\",\n      \"required\": [\"type\", \"driver\", \"source_dir\"],\n      \"properties\": {\n        \"type\": {\"const\": \"build\"},\n        \"driver\": {\"const\": \"go-v1\"},\n        \"source_dir\": {\"$ref\": \"#/$defs/portablePath\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"commandV6\": {\"oneOf\": [{\"$ref\": \"#/$defs/scriptCommand\"}, {\"$ref\": \"#/$defs/systemCommand\"}, {\"$ref\": \"#/$defs/buildCommandV6\"}]},\n    \"rootOrPortablePath\": {\n      \"oneOf\": [\n        {\"const\": \".\"},\n        {\"$ref\": \"#/$defs/portablePath\"}\n      ]\n    },\n    \"repositoryGit\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"maxLength\": 4096,\n      \"pattern\": \"^(?:https://[A-Za-z0-9][A-Za-z0-9.-]*/(?!(?:\\\\.{1,2})(?:/|$))[^\\\\s%?#\\\\\\\\/:\\\\u0000-\\\\u001f\\\\u007f-\\\\u009f]+(?:/(?!(?:\\\\.{1,2})(?:/|$))[^\\\\s%?#\\\\\\\\/:\\\\u0000-\\\\u001f\\\\u007f-\\\\u009f]+)*|ssh://(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}@)?[A-Za-z0-9][A-Za-z0-9.-]*/(?!(?:\\\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*|(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}@)?[A-Za-z0-9][A-Za-z0-9.-]*:(?!(?:\\\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*)$\"\n    },\n    \"gitRefName\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"maxLength\": 255,\n      \"pattern\": \"^(?!/)(?!.*//)(?!.*\\\\.\\\\.)(?!.*@\\\\{)(?!.*(?:^|/)\\\\.)(?!.*(?:^|/)[^/]*\\\\.lock(?:/|$))(?!.*[\\\\u0000-\\\\u0020\\\\u007f~^:?*\\\\[\\\\\\\\])(?!@$).*[^/.]$\"\n    },\n    \"lockedCommit\": {\n      \"oneOf\": [\n        {\n          \"type\": \"object\",\n          \"required\": [\"object_format\", \"hex\"],\n          \"properties\": {\n            \"object_format\": {\"const\": \"sha1\"},\n            \"hex\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{40}$\"}\n          },\n          \"additionalProperties\": false\n        },\n        {\n          \"type\": \"object\",\n          \"required\": [\"object_format\", \"hex\"],\n          \"properties\": {\n            \"object_format\": {\"const\": \"sha256\"},\n            \"hex\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{64}$\"}\n          },\n          \"additionalProperties\": false\n        }\n      ]\n    },\n    \"buildRepositoryV1\": {\n      \"type\": \"object\",\n      \"required\": [\"git\", \"locked_commit\"],\n      \"properties\": {\n        \"git\": {\"$ref\": \"#/$defs/repositoryGit\"},\n        \"locked_commit\": {\"$ref\": \"#/$defs/lockedCommit\"},\n        \"tag\": {\"$ref\": \"#/$defs/gitRefName\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"repositoryBuildCommandV1\": {\n      \"type\": \"object\",\n      \"required\": [\"type\", \"driver\", \"repository\", \"target\"],\n      \"properties\": {\n        \"type\": {\"const\": \"build\"},\n        \"driver\": {\"const\": \"go-repository-v1\"},\n        \"repository\": {\"$ref\": \"#/$defs/identifier\"},\n        \"target\": {\"$ref\": \"#/$defs/identifier\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"commandV7\": {\n      \"oneOf\": [\n        {\"$ref\": \"#/$defs/scriptCommand\"},\n        {\"$ref\": \"#/$defs/systemCommand\"},\n        {\"$ref\": \"#/$defs/buildCommandV6\"},\n        {\"$ref\": \"#/$defs/repositoryBuildCommandV1\"}\n      ]\n    },\n    \"curatorBuildTargetV1\": {\n      \"type\": \"object\",\n      \"required\": [\"driver\", \"build_root\", \"source_dir\"],\n      \"properties\": {\n        \"driver\": {\"const\": \"go-repository-v1\"},\n        \"build_root\": {\"$ref\": \"#/$defs/rootOrPortablePath\"},\n        \"source_dir\": {\"$ref\": \"#/$defs/rootOrPortablePath\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"repositoryStructuredRef\": {\n      \"oneOf\": [\n        {\n          \"type\": \"object\",\n          \"required\": [\"kind\", \"value\"],\n          \"properties\": {\n            \"kind\": {\"const\": \"revision\"},\n            \"value\": {\"type\": \"string\", \"pattern\": \"^(?:[0-9a-f]{40}|[0-9a-f]{64})$\"}\n          },\n          \"additionalProperties\": false\n        },\n        {\n          \"type\": \"object\",\n          \"required\": [\"kind\", \"value\"],\n          \"properties\": {\n            \"kind\": {\"enum\": [\"tag\", \"branch\"]},\n            \"value\": {\"$ref\": \"#/$defs/gitRefName\"}\n          },\n          \"additionalProperties\": false\n        }\n      ]\n    },\n    \"buildRepositorySubstitution\": {\n      \"oneOf\": [\n        {\n          \"type\": \"object\",\n          \"required\": [\"path\"],\n          \"properties\": {\"path\": {\"$ref\": \"#/$defs/nonEmptyString\"}},\n          \"additionalProperties\": false\n        },\n        {\n          \"type\": \"object\",\n          \"required\": [\"git\", \"ref\"],\n          \"properties\": {\n            \"git\": {\"$ref\": \"#/$defs/repositoryGit\"},\n            \"ref\": {\"$ref\": \"#/$defs/repositoryStructuredRef\"}\n          },\n          \"additionalProperties\": false\n        }\n      ]\n    },\n    \"networkSourceIdentity\": {\n      \"type\": \"object\",\n      \"required\": [\"kind\", \"value\"],\n      \"properties\": {\n        \"kind\": {\"const\": \"network-git\"},\n        \"value\": {\n          \"type\": \"string\",\n          \"minLength\": 3,\n          \"maxLength\": 4096,\n          \"pattern\": \"^(?!.*\\\\.git$)[a-z0-9][a-z0-9.-]*/(?!(?:\\\\.{1,2})(?:/|$))[^\\\\s%?#\\\\\\\\/:\\\\u0000-\\\\u001f\\\\u007f-\\\\u009f]+(?:/(?!(?:\\\\.{1,2})(?:/|$))[^\\\\s%?#\\\\\\\\/:\\\\u0000-\\\\u001f\\\\u007f-\\\\u009f]+)*$\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"localSourceIdentity\": {\n      \"type\": \"object\",\n      \"required\": [\"kind\", \"value\"],\n      \"properties\": {\n        \"kind\": {\"const\": \"operator-local-git\"},\n        \"value\": {\"$ref\": \"#/$defs/sha256\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"declaredRepositorySourceV1\": {\n      \"type\": \"object\",\n      \"required\": [\"identity\", \"transport\", \"locked_commit\"],\n      \"properties\": {\n        \"identity\": {\"$ref\": \"#/$defs/networkSourceIdentity\"},\n        \"transport\": {\"enum\": [\"https\", \"ssh\"]},\n        \"locked_commit\": {\"$ref\": \"#/$defs/lockedCommit\"},\n        \"tag\": {\"$ref\": \"#/$defs/gitRefName\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"effectiveRepositorySourceV1\": {\n      \"type\": \"object\",\n      \"required\": [\"identity\", \"object_format\", \"commit\", \"substituted\", \"build_source\"],\n      \"properties\": {\n        \"identity\": {\n          \"oneOf\": [\n            {\"$ref\": \"#/$defs/networkSourceIdentity\"},\n            {\"$ref\": \"#/$defs/localSourceIdentity\"}\n          ]\n        },\n        \"transport\": {\"enum\": [\"https\", \"ssh\"]},\n        \"object_format\": {\"enum\": [\"sha1\", \"sha256\"]},\n        \"commit\": {\"$ref\": \"#/$defs/commit\"},\n        \"substituted\": {\"type\": \"boolean\"},\n        \"substitution\": {\n          \"oneOf\": [\n            {\n              \"type\": \"object\",\n              \"required\": [\"type\"],\n              \"properties\": {\"type\": {\"const\": \"local-path\"}},\n              \"additionalProperties\": false\n            },\n            {\n              \"type\": \"object\",\n              \"required\": [\"type\", \"ref\"],\n              \"properties\": {\n                \"type\": {\"const\": \"network-git\"},\n                \"ref\": {\"$ref\": \"#/$defs/repositoryStructuredRef\"}\n              },\n              \"additionalProperties\": false\n            }\n          ]\n        },\n        \"build_source\": {\"$ref\": \"#/$defs/buildSourceIdentity\"}\n      },\n      \"allOf\": [\n        {\n          \"if\": {\"properties\": {\"object_format\": {\"const\": \"sha1\"}}, \"required\": [\"object_format\"]},\n          \"then\": {\"properties\": {\"commit\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{40}$\"}}},\n          \"else\": {\"properties\": {\"commit\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{64}$\"}}}\n        },\n        {\n          \"if\": {\"properties\": {\"substituted\": {\"const\": true}}, \"required\": [\"substituted\"]},\n          \"then\": {\"required\": [\"substitution\"]},\n          \"else\": {\"not\": {\"required\": [\"substitution\"]}}\n        },\n        {\n          \"if\": {\"properties\": {\"identity\": {\"properties\": {\"kind\": {\"const\": \"network-git\"}}, \"required\": [\"kind\"]}}},\n          \"then\": {\"required\": [\"transport\"]},\n          \"else\": {\"not\": {\"required\": [\"transport\"]}}\n        }\n      ],\n      \"additionalProperties\": false\n    },\n    \"repositoryDescriptorSelectionV1\": {\n      \"type\": \"object\",\n      \"required\": [\"path\", \"target\"],\n      \"properties\": {\n        \"path\": {\"const\": \"curator-build.json\"},\n        \"target\": {\"$ref\": \"#/$defs/identifier\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"buildSourceIdentity\": {\n      \"type\": \"object\",\n      \"required\": [\"algorithm\", \"content_sha256\"],\n      \"properties\": {\n        \"algorithm\": {\"const\": \"curator-build-source-v1\"},\n        \"content_sha256\": {\"$ref\": \"#/$defs/sha256\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"goNativeTargetV1\": {\n      \"type\": \"object\",\n      \"required\": [\"goos\", \"goarch\", \"tuning\"],\n      \"properties\": {\n        \"goos\": {\"$ref\": \"#/$defs/identifier\"},\n        \"goarch\": {\"$ref\": \"#/$defs/identifier\"},\n        \"tuning\": {\n          \"type\": \"object\",\n          \"maxProperties\": 1,\n          \"propertyNames\": {\"enum\": [\"GO386\", \"GOAMD64\", \"GOARM\", \"GOARM64\", \"GOMIPS\", \"GOMIPS64\", \"GOPPC64\", \"GORISCV64\", \"GOWASM\"]},\n          \"additionalProperties\": {\"$ref\": \"#/$defs/nonEmptyString\"}\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"goToolchainIdentityV1\": {\n      \"type\": \"object\",\n      \"required\": [\"algorithm\", \"go_relpath\", \"go_version\", \"content_sha256\"],\n      \"properties\": {\n        \"algorithm\": {\"const\": \"curator-go-toolchain-v1\"},\n        \"go_relpath\": {\"const\": \"bin/go\"},\n        \"go_version\": {\"type\": \"string\", \"minLength\": 1, \"maxLength\": 4096, \"pattern\": \"^[^\\\\r\\\\n\\\\u0000]+$\"},\n        \"content_sha256\": {\"$ref\": \"#/$defs/sha256\"}\n        \"content_sha256\": {\"$ref\": \"#/$defs/sha256\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"goBuildPolicyV1\": {\n      \"type\": \"object\",\n      \"required\": [\"module_mode\", \"network\", \"workspace\", \"cgo\", \"compiler_directives\", \"target_mode\", \"link_mode\", \"libgcc\", \"package_assembly\", \"host_objects\", \"telemetry\"],\n      \"properties\": {\n        \"module_mode\": {\"const\": \"vendor\"},\n        \"network\": {\"const\": \"none\"},\n        \"workspace\": {\"const\": false},\n        \"cgo\": {\"const\": false},\n        \"compiler_directives\": {\"const\": \"reject-nonstandard-cgo-import-dynamic-v1\"},\n        \"target_mode\": {\"const\": \"native\"},\n        \"link_mode\": {\"const\": \"internal\"},\n        \"libgcc\": {\"const\": \"none\"},\n        \"package_assembly\": {\"const\": false},\n        \"host_objects\": {\"const\": false},\n        \"telemetry\": {\"const\": \"off-private\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"goRepositoryBuildPolicyV1\": {\n      \"type\": \"object\",\n      \"required\": [\"module_mode\", \"network\", \"workspace\", \"cgo\", \"compiler_directives\", \"target_mode\", \"link_mode\", \"libgcc\", \"package_assembly\", \"host_objects\", \"telemetry\", \"source_kind\"],\n      \"properties\": {\n        \"module_mode\": {\"const\": \"vendor\"},\n        \"network\": {\"const\": \"none\"},\n        \"workspace\": {\"const\": false},\n        \"cgo\": {\"const\": false},\n        \"compiler_directives\": {\"const\": \"reject-nonstandard-cgo-import-dynamic-v1\"},\n        \"target_mode\": {\"const\": \"native\"},\n        \"link_mode\": {\"const\": \"internal\"},\n        \"libgcc\": {\"const\": \"none\"},\n        \"package_assembly\": {\"const\": false},\n        \"host_objects\": {\"const\": false},\n        \"telemetry\": {\"const\": \"off-private\"},\n        \"source_kind\": {\"const\": \"locked-external-git-v1\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"goBuildInputV1\": {\n      \"type\": \"object\",\n      \"required\": [\"schema_version\", \"driver\", \"build_source\", \"build_root\", \"command\", \"source_dir\", \"target\", \"toolchain\", \"policy\"],\n      \"properties\": {\n        \"schema_version\": {\"const\": 1},\n        \"driver\": {\"const\": \"go-v1\"},\n        \"build_source\": {\"$ref\": \"#/$defs/buildSourceIdentity\"},\n        \"build_root\": {\"$ref\": \"#/$defs/portablePath\"},\n        \"command\": {\"$ref\": \"#/$defs/identifier\"},\n        \"source_dir\": {\"$ref\": \"#/$defs/portablePath\"},\n        \"target\": {\"$ref\": \"#/$defs/goNativeTargetV1\"},\n        \"toolchain\": {\"$ref\": \"#/$defs/goToolchainIdentityV1\"},\n        \"policy\": {\"$ref\": \"#/$defs/goBuildPolicyV1\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"goRepositoryBuildInputV1\": {\n      \"type\": \"object\",\n      \"required\": [\"schema_version\", \"driver\", \"source\", \"command\", \"build_root\", \"source_dir\", \"target\", \"toolchain\", \"policy\"],\n      \"properties\": {\n        \"schema_version\": {\"const\": 2},\n        \"driver\": {\"const\": \"go-repository-v1\"},\n        \"source\": {\n          \"type\": \"object\",\n          \"required\": [\"repository\", \"declared\", \"effective\", \"descriptor\"],\n          \"properties\": {\n            \"repository\": {\"$ref\": \"#/$defs/identifier\"},\n            \"declared\": {\"$ref\": \"#/$defs/declaredRepositorySourceV1\"},\n            \"effective\": {\"$ref\": \"#/$defs/effectiveRepositorySourceV1\"},\n            \"descriptor\": {\"$ref\": \"#/$defs/repositoryDescriptorSelectionV1\"}\n          },\n          \"additionalProperties\": false\n        },\n        \"command\": {\"$ref\": \"#/$defs/identifier\"},\n        \"build_root\": {\"$ref\": \"#/$defs/rootOrPortablePath\"},\n        \"source_dir\": {\"$ref\": \"#/$defs/rootOrPortablePath\"},\n        \"target\": {\"$ref\": \"#/$defs/goNativeTargetV1\"},\n        \"toolchain\": {\"$ref\": \"#/$defs/goToolchainIdentityV1\"},\n        \"policy\": {\"$ref\": \"#/$defs/goRepositoryBuildPolicyV1\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"buildArtifactV1\": {\n      \"type\": \"object\",\n      \"required\": [\"path\", \"sha256\", \"size\"],\n      \"properties\": {\n        \"path\": {\"$ref\": \"#/$defs/portablePath\"},\n        \"sha256\": {\"$ref\": \"#/$defs/sha256\"},\n        \"size\": {\"$ref\": \"#/$defs/nonNegativeSafeInteger\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"buildRecordV1\": {\n      \"type\": \"object\",\n      \"required\": [\"driver\", \"cache_key\", \"receipt_sha256\", \"artifact_sha256\", \"artifact_path\"],\n      \"properties\": {\n        \"driver\": {\"const\": \"go-v1\"},\n        \"cache_key\": {\"$ref\": \"#/$defs/sha256\"},\n        \"receipt_sha256\": {\"$ref\": \"#/$defs/sha256\"},\n        \"artifact_sha256\": {\"$ref\": \"#/$defs/sha256\"},\n        \"artifact_path\": {\"$ref\": \"#/$defs/portablePath\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"buildRecordV1WithReceiptVersion\": {\n      \"type\": \"object\",\n      \"required\": [\"driver\", \"receipt_schema_version\", \"cache_key\", \"receipt_sha256\", \"artifact_sha256\", \"artifact_path\"],\n      \"properties\": {\n        \"driver\": {\"const\": \"go-v1\"},\n        \"receipt_schema_version\": {\"const\": 1},\n        \"cache_key\": {\"$ref\": \"#/$defs/sha256\"},\n        \"receipt_sha256\": {\"$ref\": \"#/$defs/sha256\"},\n        \"artifact_sha256\": {\"$ref\": \"#/$defs/sha256\"},\n        \"artifact_path\": {\"$ref\": \"#/$defs/portablePath\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"buildRecordV2\": {\n      \"type\": \"object\",\n      \"required\": [\"driver\", \"receipt_schema_version\", \"repository\", \"declared_identity\", \"declared_locked_commit\", \"effective_identity\", \"object_format\", \"commit\", \"substituted\", \"build_source\", \"descriptor_target\", \"cache_key\", \"receipt_sha256\", \"artifact_sha256\", \"artifact_path\"],\n      \"properties\": {\n        \"driver\": {\"const\": \"go-repository-v1\"},\n        \"receipt_schema_version\": {\"const\": 2},\n        \"repository\": {\"$ref\": \"#/$defs/identifier\"},\n        \"declared_identity\": {\"$ref\": \"#/$defs/networkSourceIdentity\"},\n        \"declared_locked_commit\": {\"$ref\": \"#/$defs/lockedCommit\"},\n        \"declared_tag\": {\"$ref\": \"#/$defs/gitRefName\"},\n        \"effective_identity\": {\n          \"oneOf\": [\n            {\"$ref\": \"#/$defs/networkSourceIdentity\"},\n            {\"$ref\": \"#/$defs/localSourceIdentity\"}\n          ]\n        },\n        \"object_format\": {\"enum\": [\"sha1\", \"sha256\"]},\n        \"commit\": {\"$ref\": \"#/$defs/commit\"},\n        \"substituted\": {\"type\": \"boolean\"},\n        \"substitution\": {\n          \"oneOf\": [\n            {\n              \"type\": \"object\",\n              \"required\": [\"type\"],\n              \"properties\": {\"type\": {\"const\": \"local-path\"}},\n              \"additionalProperties\": false\n            },\n            {\n              \"type\": \"object\",\n              \"required\": [\"type\", \"ref\"],\n              \"properties\": {\n                \"type\": {\"const\": \"network-git\"},\n                \"ref\": {\"$ref\": \"#/$defs/repositoryStructuredRef\"}\n              },\n              \"additionalProperties\": false\n            }\n          ]\n        },\n        \"build_source\": {\"$ref\": \"#/$defs/buildSourceIdentity\"},\n        \"descriptor_target\": {\"$ref\": \"#/$defs/identifier\"},\n        \"cache_key\": {\"$ref\": \"#/$defs/sha256\"},\n        \"receipt_sha256\": {\"$ref\": \"#/$defs/sha256\"},\n        \"artifact_sha256\": {\"$ref\": \"#/$defs/sha256\"},\n        \"artifact_path\": {\"$ref\": \"#/$defs/portablePath\"}\n      },\n      \"allOf\": [\n        {\n          \"if\": {\"properties\": {\"object_format\": {\"const\": \"sha1\"}}, \"required\": [\"object_format\"]},\n          \"then\": {\"properties\": {\"commit\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{40}$\"}}},\n          \"else\": {\"properties\": {\"commit\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{64}$\"}}}\n        },\n        {\n          \"if\": {\"properties\": {\"substituted\": {\"const\": true}}, \"required\": [\"substituted\"]},\n          \"then\": {\"required\": [\"substitution\"]},\n          \"else\": {\"not\": {\"required\": [\"substitution\"]}}\n        }\n      ],\n      \"additionalProperties\": false\n    },\n    \"legacySkillCommand\": {\n      \"type\": \"object\",\n      \"required\": [\"type\", \"skill\", \"command\"],\n      \"properties\": {\n        \"type\": {\"const\": \"skill\"},\n        \"skill\": {\"$ref\": \"#/$defs/identifier\"},\n        \"command\": {\"$ref\": \"#/$defs/identifier\"},\n        \"hint\": {\"$ref\": \"#/$defs/nonEmptyString\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"capabilities\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"network\": {\n          \"oneOf\": [\n            {\"const\": \"none\"},\n            {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1, \"pattern\": \"^[^\\\\s/\\\\\\\\]+$\"}, \"uniqueItems\": true}\n          ],\n          \"default\": \"none\"\n        },\n        \"filesystem\": {\n          \"oneOf\": [\n            {\"enum\": [\"repo\", \"home-config\"]},\n            {\"$ref\": \"#/$defs/pathSet\"}\n          ],\n          \"default\": \"repo\"\n        },\n        \"exec\": {\n          \"oneOf\": [{\"const\": \"none\"}, {\"$ref\": \"#/$defs/identifierSet\"}],\n          \"default\": \"none\"\n        },\n        \"secrets\": {\n          \"oneOf\": [{\"const\": \"none\"}, {\"$ref\": \"#/$defs/stringSet\"}],\n          \"default\": \"none\"\n        },\n        \"env_read\": {\n          \"type\": \"array\",\n          \"items\": {\"type\": \"string\", \"pattern\": \"^[A-Za-z_][A-Za-z0-9_]*$\"},\n          \"uniqueItems\": true,\n          \"default\": []\n        },\n        \"prompt_scope\": {\"$ref\": \"#/$defs/nonEmptyString\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"skillRequirement\": {\n      \"type\": \"object\",\n      \"required\": [\"git\", \"ref\"],\n      \"properties\": {\n        \"git\": {\"$ref\": \"#/$defs/nonEmptyString\"},\n        \"ref\": {\"$ref\": \"#/$defs/ref\"},\n        \"mode\": {\"enum\": [\"full\", \"runtime\", \"context\"], \"default\": \"full\"},\n        \"commands\": {\"type\": \"array\", \"minItems\": 1, \"items\": {\"$ref\": \"#/$defs/identifier\"}, \"uniqueItems\": true}\n\nFILE schemas/v1/agent-skill-v7.schema.json\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/agent-skill-v7.schema.json\",\n  \"title\": \"agent-skill.json schema 7\",\n  \"type\": \"object\",\n  \"required\": [\"schema_version\", \"capabilities\"],\n  \"properties\": {\n    \"schema_version\": {\"const\": 7},\n    \"runtime_roots\": {\"$ref\": \"common.schema.json#/$defs/pathSet\"},\n    \"build_roots\": {\"$ref\": \"common.schema.json#/$defs/pathSet\"},\n    \"build_repositories\": {\n      \"type\": \"object\",\n      \"minProperties\": 1,\n      \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n      \"additionalProperties\": {\"$ref\": \"common.schema.json#/$defs/buildRepositoryV1\"}\n    },\n    \"commands\": {\n      \"type\": \"object\",\n      \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n      \"additionalProperties\": {\"$ref\": \"common.schema.json#/$defs/commandV7\"}\n    },\n    \"capabilities\": {\"$ref\": \"common.schema.json#/$defs/capabilities\"},\n    \"dependencies\": {\"$ref\": \"common.schema.json#/$defs/dependenciesV5\"}\n  },\n  \"additionalProperties\": false\n}\n\nFILE schemas/v1/csk-skill-v7.schema.json\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/csk-skill-v7.schema.json\",\n  \"title\": \"csk-skill.json schema 7\",\n  \"type\": \"object\",\n  \"required\": [\"schema_version\", \"capabilities\"],\n  \"properties\": {\n    \"schema_version\": {\"const\": 7},\n    \"runtime_roots\": {\"$ref\": \"common.schema.json#/$defs/pathSet\"},\n    \"build_roots\": {\"$ref\": \"common.schema.json#/$defs/pathSet\"},\n    \"build_repositories\": {\n      \"type\": \"object\",\n      \"minProperties\": 1,\n      \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n      \"additionalProperties\": {\"$ref\": \"common.schema.json#/$defs/buildRepositoryV1\"}\n    },\n    \"commands\": {\n      \"type\": \"object\",\n      \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n      \"additionalProperties\": {\"$ref\": \"common.schema.json#/$defs/commandV7\"}\n    },\n    \"capabilities\": {\"$ref\": \"common.schema.json#/$defs/capabilities\"},\n    \"dependencies\": {\"$ref\": \"common.schema.json#/$defs/dependenciesV5\"}\n  },\n  \"additionalProperties\": false\n}\n\nFILE schemas/v1/curator-build-v1.schema.json\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/curator-build-v1.schema.json\",\n  \"title\": \"curator-build.json schema 1\",\n  \"type\": \"object\",\n  \"required\": [\"schema_version\", \"targets\"],\n  \"properties\": {\n    \"schema_version\": {\"const\": 1},\n    \"targets\": {\n      \"type\": \"object\",\n      \"minProperties\": 1,\n      \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n      \"additionalProperties\": {\"$ref\": \"common.schema.json#/$defs/curatorBuildTargetV1\"}\n    }\n  },\n  \"additionalProperties\": false\n}\n\nFILE schemas/v1/skillfile-dev-v2.schema.json\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/skillfile-dev-v2.schema.json\",\n  \"title\": \"Skillfile.dev.json schema 2\",\n  \"type\": \"object\",\n  \"required\": [\"schema_version\", \"substitutions\"],\n  \"properties\": {\n    \"schema_version\": {\"const\": 2},\n    \"substitutions\": {\n      \"type\": \"object\",\n      \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n      \"additionalProperties\": {\n        \"oneOf\": [\n          {\n            \"type\": \"object\",\n            \"required\": [\"path\"],\n            \"properties\": {\"path\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"}},\n            \"additionalProperties\": false\n          },\n          {\n            \"type\": \"object\",\n            \"required\": [\"git\", \"ref\"],\n            \"properties\": {\n              \"git\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"},\n              \"ref\": {\"$ref\": \"common.schema.json#/$defs/devRef\"}\n            },\n            \"additionalProperties\": false\n          }\n        ]\n      }\n    },\n    \"build_repository_substitutions\": {\n      \"type\": \"object\",\n      \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n      \"additionalProperties\": {\n        \"type\": \"object\",\n        \"minProperties\": 1,\n        \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n        \"additionalProperties\": {\"$ref\": \"common.schema.json#/$defs/buildRepositorySubstitution\"}\n      }\n    }\n  },\n  \"additionalProperties\": false\n}\n\nFILE schemas/v1/build-receipt-v2.schema.json\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/build-receipt-v2.schema.json\",\n  \"title\": \"Curator build receipt schema 2\",\n  \"type\": \"object\",\n  \"required\": [\"schema_version\", \"cache_key\", \"input\", \"artifact\"],\n  \"properties\": {\n    \"schema_version\": {\"const\": 2},\n    \"cache_key\": {\"$ref\": \"common.schema.json#/$defs/sha256\"},\n    \"input\": {\"$ref\": \"common.schema.json#/$defs/goRepositoryBuildInputV1\"},\n    \"artifact\": {\"$ref\": \"common.schema.json#/$defs/buildArtifactV1\"}\n  },\n  \"additionalProperties\": false\n}\n\nFILE schemas/v1/install-marker-v3.schema.json\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/install-marker-v3.schema.json\",\n  \"title\": \".csk-install.json schema 3\",\n  \"type\": \"object\",\n  \"required\": [\"schema_version\", \"name\", \"source\", \"ref_kind\", \"ref\", \"commit\", \"content_sha256\", \"locale\", \"agents\", \"commands\", \"dependencies\", \"skill_schema_version\", \"runtime_roots\", \"build_roots\", \"installed_at\", \"files\", \"builds\"],\n  \"properties\": {\n    \"schema_version\": {\"const\": 3},\n    \"name\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n    \"source\": {\"$ref\": \"common.schema.json#/$defs/portablePath\"},\n    \"ref_kind\": {\"enum\": [\"tag\", \"branch\", \"revision\"]},\n    \"ref\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"},\n    \"commit\": {\"$ref\": \"common.schema.json#/$defs/commit\"},\n    \"content_sha256\": {\"$ref\": \"common.schema.json#/$defs/sha256\"},\n    \"build_source\": {\"$ref\": \"common.schema.json#/$defs/buildSourceIdentity\"},\n    \"locale\": {\"oneOf\": [{\"$ref\": \"common.schema.json#/$defs/locale\"}, {\"type\": \"null\"}]},\n    \"agents\": {\"$ref\": \"common.schema.json#/$defs/identifierSet\"},\n    \"commands\": {\"$ref\": \"common.schema.json#/$defs/identifierSet\"},\n    \"dependencies\": {\"$ref\": \"common.schema.json#/$defs/identifierSet\"},\n    \"skill_schema_version\": {\"const\": 7},\n    \"runtime_roots\": {\"$ref\": \"common.schema.json#/$defs/pathSet\"},\n    \"build_roots\": {\"$ref\": \"common.schema.json#/$defs/pathSet\"},\n    \"installed_at\": {\"$ref\": \"common.schema.json#/$defs/timestamp\"},\n    \"files\": {\"$ref\": \"common.schema.json#/$defs/pathSet\"},\n    \"builds\": {\n      \"type\": \"object\",\n      \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n      \"additionalProperties\": {\n        \"oneOf\": [\n          {\"$ref\": \"common.schema.json#/$defs/buildRecordV1WithReceiptVersion\"},\n          {\"$ref\": \"common.schema.json#/$defs/buildRecordV2\"}\n        ]\n      }\n    },\n    \"git\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"},\n    \"requirements\": {\"$ref\": \"common.schema.json#/$defs/identifierSet\"},\n    \"mcp_servers\": {\"type\": \"object\", \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"}, \"additionalProperties\": {\"$ref\": \"common.schema.json#/$defs/identifierSet\"}},\n    \"attestation\": {\n      \"type\": \"object\",\n      \"required\": [\"registry\", \"status\"],\n      \"properties\": {\n        \"registry\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"},\n        \"status\": {\"enum\": [\"audited\", \"deprecated\"]},\n        \"key_id\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{16}$\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"activation\": {\n      \"type\": \"object\",\n      \"required\": [\"context\", \"commands\"],\n      \"properties\": {\"context\": {\"type\": \"boolean\"}, \"commands\": {\"$ref\": \"common.schema.json#/$defs/identifierSet\"}},\n      \"additionalProperties\": false\n    },\n    \"requirers\": {\"$ref\": \"common.schema.json#/$defs/stringSet\"},\n    \"substituted\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"}\n  },\n  \"additionalProperties\": false\n}\n\nFILE schemas/v1/conformance-claim-v3.schema.json\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/conformance-claim-v3.schema.json\",\n  \"title\": \"Curator Protocol conformance claim schema 3\",\n  \"type\": \"object\",\n  \"required\": [\"schema_version\", \"protocol_version\", \"implementation\", \"implementation_version\", \"classes\", \"suite_sha256\", \"operating_systems\", \"build_drivers\", \"created_at\", \"result\"],\n  \"properties\": {\n    \"schema_version\": {\"const\": 3},\n    \"protocol_version\": {\"const\": \"1.0.0-rc.5\"},\n    \"implementation\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"},\n    \"implementation_version\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"},\n    \"classes\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\"enum\": [\"core\", \"manager\", \"registry-client\", \"registry-service\"]},\n      \"uniqueItems\": true\n    },\n    \"suite_sha256\": {\"$ref\": \"common.schema.json#/$defs/sha256\"},\n    \"operating_systems\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\"enum\": [\"linux\", \"macos\", \"windows\"]},\n      \"uniqueItems\": true\n    },\n    \"build_drivers\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\n        \"oneOf\": [\n          {\n            \"type\": \"object\",\n            \"required\": [\"driver\", \"language\", \"operating_systems\"],\n            \"properties\": {\n              \"driver\": {\"const\": \"go-v1\"},\n              \"language\": {\"const\": \"go\"},\n              \"operating_systems\": {\"type\": \"array\", \"minItems\": 1, \"items\": {\"enum\": [\"linux\", \"macos\", \"windows\"]}, \"uniqueItems\": true}\n            },\n            \"additionalProperties\": false\n          },\n          {\n            \"type\": \"object\",\n            \"required\": [\"driver\", \"language\", \"operating_systems\"],\n            \"properties\": {\n              \"driver\": {\"const\": \"go-repository-v1\"},\n              \"language\": {\"const\": \"go\"},\n              \"operating_systems\": {\"type\": \"array\", \"minItems\": 1, \"items\": {\"enum\": [\"linux\", \"macos\", \"windows\"]}, \"uniqueItems\": true}\n            },\n            \"additionalProperties\": false\n          }\n        ]\n      }\n    },\n    \"created_at\": {\"$ref\": \"common.schema.json#/$defs/timestamp\"},\n    \"result\": {\"const\": \"pass\"}\n  },\n  \"additionalProperties\": false\n}\n","exit_code":0,"status":"completed"}}
