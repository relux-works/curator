< // cacheEvidence is exactly the protected-cache observation a compiled verdict
< // is derived from: the reusable outcome, and — only for a hit, because nothing
< // else exposes one — the receipt identity and artifact metadata the row
< // compares with the install marker.
< //
< // Keeping it a value makes the currentness check bracketable. The planner takes
< // it once, the classification runs against that copy, and the same lookup is
< // taken again afterwards; a difference means the verdict describes state that
< // no longer exists.
< type cacheEvidence struct {
< 	Outcome     string
< 	ReceiptHash buildmeta.ReceiptHash
< 	Artifact    buildmeta.Artifact
< }
< 
< // plannedEvidence is the evidence the read-only plan recorded for one command.
< func plannedEvidence(facts buildFacts) cacheEvidence {
< 	evidence := cacheEvidence{Outcome: facts.Outcome}
< 	if install.BuildOutcome(facts.Outcome) == install.BuildCacheHit {
< 		evidence.ReceiptHash = facts.ReceiptHash
< 		evidence.Artifact = facts.Artifact
< 	}
< 	return evidence
< }
< 
< // observedEvidence projects a live read-only inspection the same way, so the
< // two are comparable without either side interpreting the other.
< func observedEvidence(result buildcache.Result) cacheEvidence {
< 	evidence := cacheEvidence{Outcome: result.DryRunOutcome()}
< 	if result.Status == buildcache.Hit {
< 		evidence.ReceiptHash = result.ReceiptHash
< 		evidence.Artifact = result.Receipt.Artifact
< 	}
< 	return evidence
< }
< 
< // recheckBuildCache re-takes every read-only cache lookup a compiled verdict
< // was derived from and names the commands whose protected evidence moved.
< //
< // Install markers are fingerprinted around the same window, but a marker is
< // only half the evidence: an entry that is removed, replaced, corrupted, or
< // loses its protected provenance changes a compiled verdict without touching a
< // single marker byte. Planning inspects the cache while no lock is held, so
< // without this second look a status run could publish a stale `current` — or a
< // stale drift code — for state that had already moved.
< //
< // It is strictly read-only and never repairs, quarantines, or adopts anything.
< // A cache boundary that cannot be opened at all makes every compiled verdict
< // unverifiable, which fails closed as changed rather than silently current.
< func recheckBuildCache(home string, builds []buildFacts) map[string]bool {
< 	moved := map[string]bool{}
< 	store, err := buildcache.New(home)
< 	if err != nil {
< 		for _, facts := range builds {
< 			moved[facts.Skill+"."+facts.Command] = true
< 		}
< 		return moved
< 	}
< 	for _, facts := range builds {
< 		// A command whose logical identity was never derived — the toolchain
< 		// boundary refused before any key existed — has no cache verdict to
< 		// recheck, and inventing a lookup for it would report a phantom change.
< 		if facts.Expectation.Input.Driver == "" {
< 			continue
< 		}
< 		if observedEvidence(store.Inspect(facts.Expectation)) != plannedEvidence(facts) {
< 			moved[facts.Skill+"."+facts.Command] = true
< 		}
< 	}
< 	return moved
< }
