"in_session_delivery\":false,\"mode\":\"tracked\",\"run_id_prefix\":\"RUN-\",\"runtime\":\"external\"}},\"version_control\":{\"acknowledgement_parameter\":\"commit_ack\",\"acknowledgement_value\":\"scope_committed\",\"config_key\":\"version_control.confirm\",\"configured\":false,\"confirm\":false,\"desired_commit_time\":null,\"enforced_types\":[\"bug\",\"story\"],\"owner_message\":\"I acknowledge that MY scope is committed; foreign uncommitted work is fine.\"},\"whoami\":{\"remote\":null,\"token_stored\":false,\"user\":null}}\n","exit_code":0,"status":"completed"}}
