ullmatch(value):\n            return None\n        priorities.add(match.group(1))\n    canonical = ending == \"'\"\\\\n\\\" and terminal and values[\\\"version\\\"] == CURRENT and keys[1:] == sorted(keys[1:])\n    return \\\"canonical\\\" if canonical else \\\"legacy-or-noncanonical\\\"\n\noid = \\\"a\\\" * 64\ncases = {\n    \\\"canonical\\\": (f\\\"version {CURRENT}\\\\noid sha256:{oid}\\\\nsize 42\\\\n\\\".encode(), \\\"canonical\\\"),\n    \\\"crlf\\\": (f\\\"version {CURRENT}\\\\r\\\\noid sha256:{oid}\\\\r\\\\nsize 42\\\\r\\\\n\\\".encode(), \\\"legacy-or-noncanonical\\\"),\n    \\\"legacy-no-final-lf\\\": (f\\\"version https://hawser.github.com/spec/v1\\\\noid sha256:{oid}\\\\nsize 42\\\".encode(), \\\"legacy-or-noncanonical\\\"),\n    \\\"extension\\\": (f\\\"version {CURRENT}\\\\next-1-crypt sha256:{oid}\\\\noid sha256:{oid}\\\\nsize 42\\\\n\\\".encode(), \\\"canonical\\\"),\n    \\\"ordinary\\\": (b\\\"package main\\\\n\\\", None),\n    \\\"empty\\\": (b\\\"\\\", None),\n}\nfor name, (blob, expected) in cases.items():\n    actual = classify(blob)\n    assert actual == expected, (name, actual, expected)\n    print(name, actual or \\\"ordinary\\\")\nPY\"","aggregated_output":"canonical canonical\ncrlf legacy-or-noncanonical\nlegacy-no-final-lf legacy-or-noncanonical\nextension canonical\nordinary ordinary\nempty ordinary\n","exit_code":0,"status":"completed"}}
