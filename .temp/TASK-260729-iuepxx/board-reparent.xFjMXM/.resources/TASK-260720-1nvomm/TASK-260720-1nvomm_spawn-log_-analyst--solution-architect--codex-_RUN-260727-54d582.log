{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport re\nCURRENT = \\\"https://git-lfs.github.com/spec/v1\\\"\nALIASES = {CURRENT, \\\"https://hawser.github.com/spec/v1\\\", \\\"http://git-media.io/v/2\\\"}\nKEY = re.compile(r\\\"[a-z0-9][a-z0-9.-]*\\\\Z\\\")\nEXT = re.compile(r\\\"ext-([0-9])-([a-z0-9][a-z0-9.-]*)\\\\Z\\\")\nOID = re.compile(r\\\"sha256:[0-9a-f]{64}\\\\Z\\\")\nSIZE = re.compile(r\\\"0|[1-9][0-9]*\\\\Z\\\")\n\ndef classify(blob):\n    if not blob or len(blob) >= 1024:\n        return None\n    try:\n        text = blob.decode(\\\"ascii\\\")\n    except UnicodeDecodeError:\n        return None\n    if \\\"\\\\x00\\\" in text:\n        return None\n    if \\\"\\\\r\\\\n\\\" in text:\n        if text.replace(\\\"\\\\r\\\\n\\\", \\\"\\\").find(\\\"\\\\r\\\") >= 0 or \\\"\\\\n\\\" in text.replace(\\\"\\\\r\\\\n\\\", \\\"\\\"):\n            return None\n        ending = \\\"\\\\r\\\\n\\\"\n    else:\n        if \\\"\\\\r\\\" in text:\n            return None\n        ending = \\\"\\\\n\\\"\n    terminal = text.endswith(ending)\n    body = text[:-len(ending)] if terminal else text\n    lines = body.split(ending)\n    if not lines or any(not line or line.count(\\\" \\\") \"'!= 1 for line in lines):\n        return None\n    pairs = [line.split(\" \", 1) for line in lines]\n    if any(not KEY.fullmatch(k) or not v for k, v in pairs):\n        return None\n    keys = [k for k, _ in pairs]\n    if len(keys) != len(set(keys)) or keys[0] != \"version\":\n        return None\n    values = dict(pairs)\n    if values.get(\"version\") not in ALIASES or not OID.fullmatch(values.get(\"oid\", \"\")) or not SIZE.fullmatch(values.get(\"size\", \"\")):\n        return None\n    priorities = set()\n    for key, value in pairs:\n        if key in {\"version\", \"oid\", \"size\"}:\n            continue\n        match = EXT.fullmatch(key)\n        if not match or match.group(1) in priorities or not OID.fullmatch(value):\n            return None\n        priorities.add(match.group(1))\n    canonical = ending == \"'\"\\\\n\\\" and terminal and values[\\\"version\\\"] == CURRENT and keys[1:] == sorted(keys[1:])\n    return \\\"canonical\\\" if canonical else \\\"legacy-or-noncanonical\\\"\n\noid = \\\"a\\\" * 64\ncases = {\n    \\\"canonical\\\": (f\\\"version {CURRENT}\\\\noid sha256:{oid}\\\\nsize 42\\\\n\\\".encode(), \\\"canonical\\\"),\n    \\\"crlf\\\": (f\\\"version {CURRENT}\\\\r\\\\noid sha256:{oid}\\\\r\\\\nsize 42\\\\r\\\\n\\\".encode(), \\\"legacy-or-noncanonical\\\"),\n    \\\"legacy-no-final-lf\\\": (f\\\"version https://hawser.github.com/spec/v1\\\\noid sha256:{oid}\\\\nsize 42\\\".encode(), \\\"legacy-or-noncanonical\\\"),\n    \\\"extension\\\": (f\\\"version {CURRENT}\\\\next-1-crypt sha256:{oid}\\\\noid sha256:{oid}\\\\nsize 42\\\\n\\\".encode(), \\\"canonical\\\"),\n    \\\"ordinary\\\": (b\\\"package main\\\\n\\\", None),\n    \\\"empty\\\": (b\\\"\\\", None),\n}\nfor name, (blob, expected) in cases.items():\n    actual = classify(blob)\n    assert actual == expected, (name, actual, expected)\n    print(name, actual or \\\"ordinary\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
