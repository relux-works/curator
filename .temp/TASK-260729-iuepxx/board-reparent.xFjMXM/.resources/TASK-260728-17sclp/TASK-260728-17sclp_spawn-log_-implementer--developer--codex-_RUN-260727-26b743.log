{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' schemas/v1/agent-skill-v1.schema.json && sed -n '1,120p' schemas/v1/agent-skill-v2.schema.json && sed -n '1,120p' schemas/v1/skillfile-dev-v2.schema.json && sed -n '1,240p' tools/test_validate.py\"","aggregated_output":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/agent-skill-v1.schema.json\",\n  \"title\": \"agent-skill.json schema 1\",\n  \"type\": \"object\",\n  \"required\": [\"schema_version\"],\n  \"properties\": {\n    \"schema_version\": {\"const\": 1},\n    \"commands\": {\"type\": \"object\", \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"}, \"additionalProperties\": {\"$ref\": \"common.schema.json#/$defs/command\"}}\n  },\n  \"allOf\": [\n    {\"not\": {\"anyOf\": [{\"required\": [\"runtime_roots\"]}, {\"required\": [\"dependencies\"]}, {\"required\": [\"capabilities\"]}]}}\n  ],\n  \"additionalProperties\": true\n}\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/agent-skill-v2.schema.json\",\n  \"title\": \"agent-skill.json schema 2\",\n  \"type\": \"object\",\n  \"required\": [\"schema_version\"],\n  \"properties\": {\n    \"schema_version\": {\"const\": 2},\n    \"runtime_roots\": {\"$ref\": \"common.schema.json#/$defs/pathSet\"},\n    \"commands\": {\"type\": \"object\", \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"}, \"additionalProperties\": {\"$ref\": \"common.schema.json#/$defs/command\"}},\n    \"dependencies\": {\"$ref\": \"common.schema.json#/$defs/dependenciesV2\"}\n  },\n  \"additionalProperties\": false\n}\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/skillfile-dev-v2.schema.json\",\n  \"title\": \"Skillfile.dev.json schema 2\",\n  \"type\": \"object\",\n  \"required\": [\"schema_version\", \"substitutions\", \"build_repository_substitutions\"],\n  \"properties\": {\n    \"schema_version\": {\"const\": 2},\n    \"substitutions\": {\n      \"type\": \"object\",\n      \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n      \"additionalProperties\": {\n        \"oneOf\": [\n          {\n            \"type\": \"object\",\n            \"required\": [\"path\"],\n            \"properties\": {\"path\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"}},\n            \"additionalProperties\": false\n          },\n          {\n            \"type\": \"object\",\n            \"required\": [\"git\", \"ref\"],\n            \"properties\": {\n              \"git\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"},\n              \"ref\": {\"$ref\": \"common.schema.json#/$defs/devRef\"}\n            },\n            \"additionalProperties\": false\n          }\n        ]\n      }\n    },\n    \"build_repository_substitutions\": {\n      \"type\": \"object\",\n      \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n      \"additionalProperties\": {\n        \"type\": \"object\",\n        \"minProperties\": 1,\n        \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n        \"additionalProperties\": {\"$ref\": \"common.schema.json#/$defs/buildRepositorySubstitution\"}\n      }\n    }\n  },\n  \"additionalProperties\": false\n}\nfrom __future__ import annotations\n\nimport copy\nimport importlib.util\nimport unittest\nfrom pathlib import Path\n\n\nMODULE_PATH = Path(__file__).with_name(\"validate.py\")\nSPEC = importlib.util.spec_from_file_location(\"curator_spec_validate\", MODULE_PATH)\nassert SPEC is not None and SPEC.loader is not None\nvalidate = importlib.util.module_from_spec(SPEC)\nSPEC.loader.exec_module(validate)\n\n\nclass WireSemanticValidationTests(unittest.TestCase):\n    def test_manifest_requires_exact_declared_repository_selection(self) -> None:\n        valid = {\n            \"schema_version\": 7,\n            \"build_repositories\": {\"repo\": {}},\n            \"commands\": {\n                \"tool\": {\n                    \"type\": \"build\",\n                    \"driver\": \"go-repository-v1\",\n                    \"repository\": \"repo\",\n                    \"target\": \"tool\",\n                }\n            },\n        }\n        self.assertIsNone(\n            validate.validate_wire_semantics(\"agent-skill-v7.schema.json\", valid)\n        )\n        missing = copy.deepcopy(valid)\n        missing[\"commands\"][\"tool\"][\"repository\"] = \"missing\"\n        self.assertIn(\n            \"undeclared\",\n            validate.validate_wire_semantics(\n                \"agent-skill-v7.schema.json\", missing\n            ),\n        )\n        unused = copy.deepcopy(valid)\n        unused[\"build_repositories\"][\"unused\"] = {}\n        self.assertIn(\n            \"must be selected\",\n            validate.validate_wire_semantics(\n                \"agent-skill-v7.schema.json\", unused\n            ),\n        )\n\n    def test_legacy_manifest_version_selection_rejects_v7_surface(self) -> None:\n        for prefix in (\"agent-skill\", \"csk-skill\"):\n            for version in range(1, 7):\n                error = validate.validate_wire_semantics(\n                    f\"{prefix}-v{version}.schema.json\",\n                    {\"schema_version\": version, \"build_repositories\": {}},\n                )\n                self.assertIn(\"only in manifest schema 7\", error)\n\n    def test_descriptor_and_receipt_containment(self) -> None:\n        descriptor = {\n            \"targets\": {\n                \"tool\": {\n                    \"build_root\": \"tools/admin\",\n                    \"source_dir\": \"tools/admin/cmd/tool\",\n                }\n            }\n        }\n        self.assertIsNone(\n            validate.validate_wire_semantics(\n                \"curator-build-v1.schema.json\", descriptor\n            )\n        )\n        descriptor[\"targets\"][\"tool\"][\"source_dir\"] = \"cmd/tool\"\n        self.assertIn(\n            \"below build_root\",\n            validate.validate_wire_semantics(\n                \"curator-build-v1.schema.json\", descriptor\n            ),\n        )\n\n    def test_unsubstituted_receipt_keeps_declared_and_effective_equal(self) -> None:\n        receipt = {\n            \"input\": {\n                \"build_root\": \".\",\n                \"source_dir\": \"cmd/tool\",\n                \"source\": {\n                    \"declared\": {\n                        \"identity\": {\"kind\": \"network-git\", \"value\": \"example/repo\"},\n                        \"transport\": \"https\",\n                        \"locked_commit\": {\n                            \"object_format\": \"sha1\",\n                            \"hex\": \"0\" * 40,\n                        },\n                    },\n                    \"effective\": {\n                        \"identity\": {\"kind\": \"network-git\", \"value\": \"example/repo\"},\n                        \"transport\": \"https\",\n                        \"object_format\": \"sha1\",\n                        \"commit\": \"0\" * 40,\n                        \"substituted\": False,\n                    },\n                },\n            }\n        }\n        self.assertIsNone(\n            validate.validate_wire_semantics(\n                \"build-receipt-v2.schema.json\", receipt\n            )\n        )\n        receipt[\"input\"][\"source\"][\"effective\"][\"commit\"] = \"1\" * 40\n        self.assertIn(\n            \"must equal declared\",\n            validate.validate_wire_semantics(\n                \"build-receipt-v2.schema.json\", receipt\n            ),\n        )\n\n    def test_marker_and_claim_conditionals(self) -> None:\n        marker = {\n            \"builds\": {\n                \"local\": {\"driver\": \"go-v1\"},\n                \"external\": {\"driver\": \"go-repository-v1\"},\n            },\n            \"build_source\": {},\n        }\n        self.assertIsNone(\n            validate.validate_wire_semantics(\n                \"install-marker-v3.schema.json\", marker\n            )\n        )\n        del marker[\"build_source\"]\n        self.assertIn(\n            \"exactly when\",\n            validate.validate_wire_semantics(\n                \"install-marker-v3.schema.json\", marker\n            ),\n        )\n\n        claim = {\n            \"operating_systems\": [\"macos\"],\n            \"build_drivers\": [\n                {\n                    \"driver\": \"go-repository-v1\",\n                    \"language\": \"go\",\n                    \"operating_systems\": [\"windows\"],\n                }\n            ],\n        }\n        self.assertIn(\n            \"subset\",\n            validate.validate_wire_semantics(\n                \"conformance-claim-v3.schema.json\", claim\n            ),\n        )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
