 false\n        },\n        {\n          \"type\": \"object\",\n          \"required\": [\"kind\", \"value\"],\n          \"properties\": {\n            \"kind\": {\"enum\": [\"tag\", \"branch\"]},\n            \"value\": {\"$ref\": \"#/$defs/gitRefName\"}\n          },\n          \"additionalProperties\": false\n        }\n      ]\n    },\n    \"buildRepositorySubstitution\": {\n      \"oneOf\": [\n        {\n          \"type\": \"object\",\n          \"required\": [\"path\"],\n          \"properties\": {\"path\": {\"$ref\": \"#/$defs/nonEmptyString\"}},\n          \"additionalProperties\": false\n        },\n        {\n          \"type\": \"object\",\n          \"required\": [\"git\", \"ref\"],\n          \"properties\": {\n            \"git\": {\"$ref\": \"#/$defs/repositoryGit\"},\n            \"ref\": {\"$ref\": \"#/$defs/repositoryStructuredRef\"}\n          },\n          \"additionalProperties\": false\n        }\n      ]\n    },\n    \"networkSourceIdentity\": {\n      \"type\": \"object\",\n      \"required\": [\"kind\", \"value\"],\n      \"properties\": {\n        \"kind\": {\"const\": \"network-git\"},\n        \"value\": {\n          \"type\": \"string\",\n          \"minLength\": 3,\n          \"maxLength\": 4096,\n          \"pattern\": \"^[A-Za-z0-9][A-Za-z0-9.-]*/[^\\\\s%?#\\\\\\\\:]+(?:/[^\\\\s%?#\\\\\\\\:]+)*$\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"localSourceIdentity\": {\n      \"type\": \"object\",\n      \"required\": [\"kind\", \"value\"],\n      \"properties\": {\n        \"kind\": {\"const\": \"operator-local-git\"},\n        \"value\": {\"$ref\": \"#/$defs/sha256\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"declaredRepositorySourceV1\": {\n      \"type\": \"object\",\n      \"required\": [\"identity\", \"transport\", \"locked_commit\"],\n      \"properties\": {\n        \"identity\": {\"$ref\": \"#/$defs/networkSourceIdentity\"},\n        \"transport\": {\"enum\": [\"https\", \"ssh\"]},\n        \"locked_commit\": {\"$ref\": \"#/$defs/lockedCommit\"},\n        \"tag\": {\"$ref\": \"#/$defs/gitRefName\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"effectiveRepositorySourceV1\": {\n      \"type\": \"object\",\n      \"required\": [\"identity\", \"object_format\", \"commit\", \"substituted\", \"build_source\"],\n      \"properties\": {\n        \"identity\": {\n          \"oneOf\": [\n            {\"$ref\": \"#/$defs/networkSourceIdentity\"},\n            {\"$ref\": \"#/$defs/localSourceIdentity\"}\n          ]\n        },\n        \"transport\": {\"enum\": [\"https\", \"ssh\"]},\n        \"object_format\": {\"enum\": [\"sha1\", \"sha256\"]},\n        \"commit\": {\"$ref\": \"#/$defs/commit\"},\n        \"substituted\": {\"type\": \"boolean\"},\n        \"substitution\": {\n          \"oneOf\": [\n            {\n              \"type\": \"object\",\n              \"required\": [\"type\"],\n              \"properties\": {\"type\": {\"const\": \"local-path\"}},\n              \"additionalProperties\": false\n            },\n            {\n              \"type\": \"object\",\n              \"required\": [\"type\", \"ref\"],\n              \"properties\": {\n                \"type\": {\"const\": \"network-git\"},\n                \"ref\": {\"$ref\": \"#/$defs/repositoryStructuredRef\"}\n              },\n              \"additionalProperties\": false\n            }\n          ]\n        },\n        \"build_source\": {\"$ref\": \"#/$defs/buildSourceIdentity\"}\n      },\n      \"allOf\": [\n        {\n          \"if\": {\"properties\": {\"object_format\": {\"const\": \"sha1\"}}, \"required\": [\"object_format\"]},\n          \"then\": {\"properties\": {\"commit\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{40}$\"}}},\n          \"else\": {\"properties\": {\"commit\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{64}$\"}}}\n        },\n        {\n          \"if\": {\"properties\": {\"substituted\": {\"const\": true}}, \"required\": [\"substituted\"]},\n          \"then\": {\"required\": [\"substitution\"]},\n          \"else\": {\"not\": {\"required\": [\"substitution\"]}}\n        },\n        {\n          \"if\": {\"properties\": {\"identity\": {\"properties\": {\"kind\": {\"const\": \"network-git\"}}, \"required\": [\"kind\"]}}},\n          \"then\": {\"required\": [\"transport\"]},\n          \"else\": {\"not\": {\"required\": [\"transport\"]}}\n        }\n      ],\n      \"additionalProperties\": false\n    },\n    \"repositoryDescriptorSelectionV1\": {\n      \"type\": \"object\",\n      \"required\": [\"path\", \"target\"],\n      \"properties\": {\n        \"path\": {\"const\": \"curator-build.json\"},\n        \"target\": {\"$ref\": \"#/$defs/identifier\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"buildSourceIdentity\": {\n      \"type\": \"object\",\n      \"required\": [\"algorithm\", \"content_sha256\"],\n      \"properties\": {\n        \"algorithm\": {\"const\": \"curator-build-source-v1\"},\n        \"content_sha256\": {\"$ref\": \"#/$defs/sha256\"}\n      },\n      \"additionalProperties\": false\n    },\n    \"goNativeTargetV1\": {\n      \"type\": \"object\",\n      \"required\": [\"goos\", \"goarch\", \"tuning\"],\n","exit_code":0,"status":"completed"}}
