 declared: dict[str, Any], effective: dict[str, Any]\n   148\t) -> str | None:\n   149\t    substitution = effective.get(\"substitution\", {})\n   150\t    identity = effective.get(\"identity\", {})\n   151\t    if effective.get(\"substituted\") is False:\n   152\t        locked = declared.get(\"locked_commit\", {})\n   153\t        if (\n   154\t            effective.get(\"identity\") != declared.get(\"identity\")\n   155\t            or effective.get(\"transport\") != declared.get(\"transport\")\n   156\t            or not isinstance(locked, dict)\n   157\t            or effective.get(\"object_format\") != locked.get(\"object_format\")\n   158\t            or effective.get(\"commit\") != locked.get(\"hex\")\n   159\t        ):\n   160\t            return \"unsubstituted effective source must equal declared source and lock\"\n   161\t    elif isinstance(substitution, dict) and isinstance(identity, dict):\n   162\t        substitution_type = substitution.get(\"type\")\n   163\t        identity_kind = identity.get(\"kind\")\n   164\t        if substitution_type == \"local-path\" and identity_kind != \"operator-local-git\":\n   165\t            return \"local substitution requires operator-local-git effective identity\"\n   166\t        if substitution_type == \"network-git\" and identity_kind != \"network-git\":\n   167\t            return \"network substitution requires network-git effective identity\"\n   168\t    return None\n   169\t\n   170\t\n   171\tdef validate_wire_semantics(schema_name: str, instance: Any) -> str | None:\n   172\t    if not isinstance(instance, dict):\n   173\t        return None\n   174\t    legacy_manifest = re.fullmatch(r\"(?:agent-skill|csk-skill)-v([1-6])\\.schema\\.json\", schema_name)\n   175\t    if legacy_manifest is not None:\n   176\t        if \"build_repositories\" in instance:\n   177\t            return \"build_repositories is legal only in manifest schema 7\"\n   178\t        commands = instance.get(\"commands\", {})\n   179\t        if isinstance(commands, dict) and any(\n   180\t            isinstance(command, dict) and command.get(\"driver\") == \"go-repository-v1\"\n   181\t            for command in commands.values()\n   182\t        ):\n   183\t            return \"go-repository-v1 is legal only in manifest schema 7\"\n   184\t    if schema_name in {\"agent-skill-v7.schema.json\", \"csk-skill-v7.schema.json\"}:\n   185\t        repositories = instance.get(\"build_repositories\", {})\n   186\t        commands = instance.get(\"commands\", {})\n   187\t        if not isinstance(repositories, dict) or not isinstance(commands, dict):\n   188\t            return None\n   189\t        selected = {\n   190\t            command.get(\"repository\")\n   191\t            for command in commands.values()\n   192\t            if isinstance(command, dict) and command.get(\"driver\") == \"go-repository-v1\"\n   193\t        }\n   194\t        if selected - set(repositories):\n   195\t            return \"repository command selects an undeclared build repository\"\n   196\t        if set(repositories) - selected:\n   197\t            return \"every build repository declaration must be selected by a command\"\n   198\t    elif schema_name == \"curator-build-v1.schema.json\":\n   199\t        for target in instance.get(\"targets\", {}).values():\n   200\t            if isinstance(target, dict):\n   201\t                root, source = target.get(\"build_root\"), target.get(\"source_dir\")\n   202\t                if isinstance(root, str) and isinstance(source, str) and not is_below_or_equal(source, root):\n   203\t                    return \"source_dir must equal or be below build_root\"\n   204\t    elif schema_name == \"build-receipt-v2.schema.json\":\n   205\t        build_input = instance.get(\"input\", {})\n   206\t        if isinstance(build_input, dict):\n   207\t            root, source_dir = build_input.get(\"build_root\"), build_input.get(\"source_dir\")\n   208\t            if isinstance(root, str) and isinstance(source_dir, str) and not is_below_or_equal(source_dir, root):\n   209\t                return \"receipt source_dir must equal or be below build_root\"\n   210\t            source = build_input.get(\"source\", {})\n   211\t            if isinstance(source, dict):\n   212\t                declared, effective = source.get(\"declared\", {}), source.get(\"effective\", {})\n   213\t                if isinstance(declared, dict) and isinstance(effective, dict):\n   214\t                    error = validate_effective_source(declared, effective)\n   215\t                    if error is not None:\n   216\t                        return error\n   217\t    elif schema_name == \"install-marker-v3.schema.json\":\n   218\t        builds = instance.get(\"builds\", {})\n   219\t        if not isinstance(builds, dict):\n   220\t            return None\n   221\t        has_local = any(isinstance(record, dict) and record.get(\"driver\") == \"go-v1\" for record in builds.values())\n   222\t        if has_local != (\"build_source\" in instance):\n   223\t            return \"marker build_source is present exactly when a local go-v1 build is active\"\n   224\t        for record in builds.values():\n   225\t            if not isinstance(record, dict) or record.get(\"driver\") != \"go-repository-v1\":\n   226\t                continue\n   227\t            declared = {\n   228\t                \"identity\": record.get(\"declared_identity\"),\n   229\t                \"locked_commit\": record.get(\"declared_locked_commit\"),\n   230\t            }\n   231\t            effective = {\n   232\t                \"identity\": record.get(\"effective_identity\"),\n   233\t                \"object_format\": record.get(\"object_format\"),\n   234\t                \"commit\": record.get(\"commit\"),\n   235\t                \"substituted\": record.get(\"substituted\"),\n   236\t            }\n   237\t            if \"substitution\" in record:\n   238\t                effective[\"substitution\"] = record[\"substitution\"]\n   239\t            error = validate_effective_source(declared, effective)\n   240\t            if error is not None:\n   241\t                return error\n   242\t    elif schema_name == \"conformance-claim-v3.schema.json\":\n   243\t        systems = set(instance.get(\"operating_systems\", []))\n   244\t        claims = instance.get(\"build_drivers\", [])\n   245\t        if isinstance(claims, list):\n   246\t            drivers = [claim.get(\"driver\") for claim in claims if isinstance(claim, dict)]\n   247\t            if len(drivers) != len(set(drivers)):\n   248\t                return \"build driver assertions must be unique\"\n   249\t            for claim in claims:\n   250\t                if isinstance(claim, dict) and not set(claim.get(\"operating_systems\", [])).issubset(systems):\n   251\t                    return \"build driver platforms must be a subset of the top-level evidenced platforms\"\n   252\t    return None\n   253\t\n   254\t\n   255\tdef validate_manifest() -> None:\n   175\t| 4 | transitive skill requirements |\n   176\t| 5 | MCP server requirements |\n   177\t| 6 | declarative compiled commands and context-excluded `build_roots` |\n   178\t| 7 | first-class external build repositories and `go-repository-v1` |\n   179\t\n   180\tVersion gates are downward: a field introduced by a later version MUST be\n   181\trejected in an earlier one. Schema 1 preserves its deployed extension behavior;\n   182\tschemas 2 through 7 reject unknown fields. Schema 1 through 5 MUST reject\n   183\t`build_roots`, a command with `type: \"build\"`, and every build-only field.\n   184\tSchema 1 through 6 MUST reject `build_repositories`, `repository`, `target`,\n   185\tand `go-repository-v1`. Their script, system, runtime-root, capability,\n   186\tdependency, context, hash, `go-v1`, receipt-v1, and marker-v1/v2 behavior is\n   187\tunchanged.\n   188\t\n   189\t### 4.1 Runtime roots and commands\n   190\t\n   306\t#### 4.2.1 Schema-7 external repositories and `go-repository-v1`\n   307\t\n   308\tManifest schema 7 MAY contain a strict top-level `build_repositories` map keyed\n   309\tby portable identifiers. Each declaration MUST contain exactly `git` and\n   310\t`locked_commit` and MAY contain `tag`. Every declaration MUST be selected by at\n   311\tleast one active or inactive command in the same manifest.\n   312\t\n   313\t`locked_commit` MUST contain exactly `object_format` and `hex`.\n   314\t`object_format` MUST be `sha1` or `sha256`; `hex` MUST be the complete lowercase\n   315\tcommit object ID for that format, respectively 40 or 64 hexadecimal\n   316\tcharacters. A declaration MUST NOT use a branch, range, abbreviated ID,\n   317\t`HEAD`, revision expression, or package-selected local path. When present,\n   318\t`tag` MUST satisfy section 6.3 and is an assertion in addition to, not instead\n   319\tof, the immutable full commit lock.\n   320\t\n   321\tA schema-7 external build command has exactly this package-controlled surface:\n   322\t\n   323\t```json\n   324\t{\n   325\t  \"type\": \"build\",\n   326\t  \"driver\": \"go-repository-v1\",\n   327\t  \"repository\": \"golden-tools\",\n   328\t  \"target\": \"golden-tool\"\n   329\t}\n   330\t```\n   331\t\n   332\tThe command MUST select exactly one declared repository and exactly one target\n   333\tfrom the effective commit's root `curator-build.json`. The command and\n   334\tdescriptor target drivers MUST both equal `go-repository-v1`. An unknown or\n   335\tmismatched driver MUST fail before artifact-cache lookup or compiler execution\n   336\tand MUST NOT fall back to `go-v1`, a script, a system command, or a generic\n   337\tbuild facility.\n   338\t\n   339\t`curator-build.json` schema 1 is strict and contains exactly\n   340\t`schema_version: 1` and a non-empty `targets` map keyed by portable identifiers.\n   341\tEach `go-repository-v1` target MUST contain exactly `driver`, `build_root`, and\n   342\t`source_dir`. These paths are relative to the repository root. The single\n   343\tvalue `.` MAY identify the repository root; every other value MUST be a\n   344\tportable relative path. `source_dir` MUST equal or be below `build_root`.\n   345\t`build_root` MUST contain `go.mod` directly, and that file MUST be the nearest\n   346\tancestor `go.mod` of `source_dir`.\n   347\t\n   348\tTargets MAY share one build root. A nested module is admitted only when the\n   349\tselected target names its root and satisfies the nearest-module rule. Managers\n   350\tMUST NOT discover modules, targets, commands, or outputs. Every non-standard\n   351\tmodule, package, source, embed, and vendor input selected by the fixed\n   352\t`go list` graph MUST remain below the selected build root. Input MUST NOT come\n   353\tfrom the consuming skill, another external repository, a sibling or parent\n   354\tmodule, a host module cache, a workspace, or the network.\n   355\t\n   356\tThe whole external snapshot is validated, hashed, and audited. Only the\n   357\tselected build root is compiler-visible, and no external repository byte is\n   358\tagent-facing or runtime-copied. Allowing `build_root: \".\"` here MUST NOT change\n   359\tthe schema-6 prohibition on a local `build_root` equal to `.`.\n   360\t\n   361\tThe consuming manifest command key is the sole executable name. The manager\n   362\tMUST derive `bin/<command>` on Unix or `bin/<command>.exe` on Windows and MUST\n   363\tderive private staging and shim paths independently of package data. Neither\n   364\tthe command nor descriptor MAY select a program, argv, environment, flag,\n   365\tcompiler tag, toolchain, output name or path, install destination, alias, PATH\n   366\tedit, signing identity, credential, hook, plugin, generator, build recipe,\n   367\tpost-build action, fallback, or secondary artifact.\n   368\t\n   369\t`go-repository-v1` reuses the exact `go-v1` trusted toolchain identity, native\n   370\ttarget, process vectors, environment, vendor-only dependency checks, compiler\n   425\tproject agents, manager defaults. Effective locale is manifest `locale`, then\n   426\tthe manager preference.\n   427\t\n   428\t`Skillfile.dev.json` conforms to `skillfile-dev-v1.schema.json` or\n   429\t`skillfile-dev-v2.schema.json` and is never committed. Schema 1 retains only\n   430\tskill substitutions and MUST reject external-repository substitutions. Schema\n   431\t2 retains the `substitutions` map and MAY add the strict\n   432\t`build_repository_substitutions` map. Its outer key is the consuming skill and\n   433\tits inner key is a repository identifier declared by that skill.\n   434\t\n   435\tEach skill substitution remains exactly one of a local Git checkout `path` or\n   436\t`git` plus exact `ref`. Each external-repository substitution MUST be exactly\n   437\tone operator project-relative local Git `path`, or `git` plus one structured\n   438\texact `ref` whose form is `revision`, `tag`, or `branch` under section 6.3.\n   439\tPackage data MUST NOT create or alter a substitution.\n   440\t\n   441\tA local external substitution resolves relative to the canonical project root\n   442\tand selects the repository's exact committed `HEAD`; dirty, staged, and\n   443\tuntracked worktree bytes MUST NOT become compiler input. A substitution\n   444\treplaces acquisition only. It MUST NOT change repository identifier,\n   445\tdescriptor target, driver, command name, output, compiler policy, credential,\n   490\t### 6.3 External repository source identity and exact lock\n   491\t\n   492\tSchema-7 external repository declarations use section 6.1 canonicalization\n   493\tnarrowed to HTTPS and SSH. HTTPS MUST have the form `https://host/path` and\n   494\tMUST NOT contain userinfo. SSH MUST have the URI form\n   495\t`ssh://[user@]host/path` or SCP form `[user@]host:path`. An SSH username is\n   496\tOPTIONAL ASCII matching `[A-Za-z0-9][A-Za-z0-9._-]{0,63}` and is removed from\n   497\tcanonical identity. A declaration MUST NOT use `git`, `http`, `file`, another\n   498\tscheme, an explicit port, password, query, fragment, percent escape, backslash,\n   499\tempty path component, `.` component, or `..` component.\n   500\t\n   501\tThe host is lowercased and the path case is preserved. Leading and trailing\n   502\tslashes and exactly one case-sensitive trailing `.git` are removed. The\n   503\tcanonical identity is `host/path` and MUST be no more than 4096 Unicode scalar\n   504\tvalues. Transport spelling and a permitted SSH username do not change that\n   505\tidentity. The declared source records identity kind `network-git`, this value,\n   506\tand transport `https` or `ssh`.\n   507\t\n   508\tFor `go-repository-v1`, the raw SSH repository path is further restricted to\n   509\tASCII letters, digits, `.`, `_`, `-`, and `/`, with the same non-empty,\n   510\tno-`.`/no-`..` component rules. A quote, whitespace, shell metacharacter,\n   511\tescape, or non-ASCII byte MUST be rejected before Git or SSH starts. HTTPS\n   512\tretains the Unicode path grammar above.\n   513\t\n   514\tA manifest tag is the name below `refs/tags/` and MUST:\n   515\t\n   516\t1. encode to 1 through 255 UTF-8 bytes of valid Unicode scalar text;\n   517\t2. neither start nor end with `/`, contain `//`, nor end with `.`;\n   518\t3. have no slash component starting with `.` or ending with `.lock`;\n   519\t4. contain none of NUL, ASCII control bytes, DEL, space, `~`, `^`, `:`, `?`,\n   520\t   `*`, `[`, or backslash;\n   521\t5. contain neither `..` nor `@{` and not equal the single character `@`; and\n   522\t6. make the exact constructed `refs/tags/<tag>` pass the protocol equivalent\n   523\t   of `git check-ref-format` without normalization.\n   524\t\n   525\tA manager MUST NOT pass a tag as an unqualified revision expression. An\n   526\toperator network substitution MUST use exactly one structured ref:\n   527\t\n   528\t- `revision` is a full lowercase object ID for the effective repository object\n   529\t  format;\n   530\t- `tag` uses the grammar above and selects only `refs/tags/<value>`; or\n   531\t- `branch` uses the same safe-name grammar and selects only\n   532\t  `refs/heads/<value>`.\n   533\t\n   534\tNo other revision, peel, reflog, range, or normalization syntax is admitted.\n   535\t\n   536\tThe declared full object ID is immutable. For an unsubstituted source, its\n   537\tobject format MUST equal the effective repository format and the named object\n   538\tMUST be a commit. A substitution MUST leave that declaration unchanged while\n   539\teffective state records the substituted repository's actual object format and\n   540\tfull commit. An unsubstituted declaration without `tag` MUST acquire only\n   541\t`<full-locked-oid>:refs/curator/locked`. An unsubstituted declaration with\n   542\t`tag` MUST instead acquire only\n   543\t`refs/tags/<tag>:refs/curator/tag` in fresh operation-private state, recompute\n   544\tand peel the exact lightweight or annotated-tag chain, and require its terminal\n   545\tcommit to equal the full lock. Server policy permitting or denying direct\n","exit_code":0,"status":"completed"}}
