{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"jq '.\\\"\"'$defs\" | {portablePath,repositoryGit,gitRefName,repositoryStructuredRef,networkSourceIdentity}'\"' schemas/v1/common.schema.json\"","aggregated_output":"{\n  \"portablePath\": {\n    \"type\": \"string\",\n    \"minLength\": 1,\n    \"maxLength\": 4096,\n    \"pattern\": \"^[^/\\\\\\\\:\\\\u0000-\\\\u001f\\\\u007f-\\\\u009f](?:[^\\\\\\\\:\\\\u0000-\\\\u001f\\\\u007f-\\\\u009f]*[^/ .\\\\\\\\:\\\\u0000-\\\\u001f\\\\u007f-\\\\u009f])?$\",\n    \"not\": {\n      \"pattern\": \"(?:^|/)(?:\\\\.{1,2}|[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\\\.|/|$)|//\"\n    }\n  },\n  \"repositoryGit\": {\n    \"type\": \"string\",\n    \"minLength\": 1,\n    \"maxLength\": 4096,\n    \"pattern\": \"^(?:https://[A-Za-z0-9][A-Za-z0-9.-]*/[^\\\\s%?#\\\\\\\\/:]+(?:/[^\\\\s%?#\\\\\\\\/:]+)*|ssh://(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}@)?[A-Za-z0-9][A-Za-z0-9.-]*/[^\\\\s%?#\\\\\\\\/:]+(?:/[^\\\\s%?#\\\\\\\\/:]+)*|(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}@)?[A-Za-z0-9][A-Za-z0-9.-]*:[^\\\\s%?#\\\\\\\\/:]+(?:/[^\\\\s%?#\\\\\\\\/:]+)*)$\"\n  },\n  \"gitRefName\": {\n    \"type\": \"string\",\n    \"minLength\": 1,\n    \"maxLength\": 255,\n    \"pattern\": \"^(?!/)(?!.*//)(?!.*\\\\.\\\\.)(?!.*@\\\\{)(?!.*(?:^|/)\\\\.)(?!.*(?:^|/)[^/]*\\\\.lock(?:/|$))(?!.*[\\\\u0000-\\\\u0020\\\\u007f~^:?*\\\\[\\\\\\\\])(?!@$).*[^/.]$\"\n  },\n  \"repositoryStructuredRef\": {\n    \"oneOf\": [\n      {\n        \"type\": \"object\",\n        \"required\": [\n          \"kind\",\n          \"value\"\n        ],\n        \"properties\": {\n          \"kind\": {\n            \"const\": \"revision\"\n          },\n          \"value\": {\n            \"type\": \"string\",\n            \"pattern\": \"^(?:[0-9a-f]{40}|[0-9a-f]{64})$\"\n          }\n        },\n        \"additionalProperties\": false\n      },\n      {\n        \"type\": \"object\",\n        \"required\": [\n          \"kind\",\n          \"value\"\n        ],\n        \"properties\": {\n          \"kind\": {\n            \"enum\": [\n              \"tag\",\n              \"branch\"\n            ]\n          },\n          \"value\": {\n            \"$ref\": \"#/$defs/gitRefName\"\n          }\n        },\n        \"additionalProperties\": false\n      }\n    ]\n  },\n  \"networkSourceIdentity\": {\n    \"type\": \"object\",\n    \"required\": [\n      \"kind\",\n      \"value\"\n    ],\n    \"properties\": {\n      \"kind\": {\n        \"const\": \"network-git\"\n      },\n      \"value\": {\n        \"type\": \"string\",\n        \"minLength\": 3,\n        \"maxLength\": 4096,\n        \"pattern\": \"^[A-Za-z0-9][A-Za-z0-9.-]*/[^\\\\s%?#\\\\\\\\:]+(?:/[^\\\\s%?#\\\\\\\\:]+)*$\"\n      }\n    },\n    \"additionalProperties\": false\n  }\n}\n","exit_code":0,"status":"completed"}}
