+func TestBuildRootExcludedBeforeLocaleRenderingWithoutCompilerExecution(t *testing.T) {
+	e := newEnv(t)
+	name := "build-skill"
+	dir := filepath.Join(e.skillsRoot, name)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
