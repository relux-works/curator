+
+	fakeBin := t.TempDir()
+	compilerMarker := filepath.Join(t.TempDir(), "go-invoked")
+	e.write(fakeBin, "go", "#!/bin/sh\nprintf invoked > \""+compilerMarker+"\"\nexit 99\n")
+	if err := os.Chmod(filepath.Join(fakeBin, "go"), 0o755); err != nil {
