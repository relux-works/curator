+		t.Fatalf("build root or artifact leaked into runtime store: %v", err)
+	}
+	if _, err := os.Stat(compilerMarker); !os.IsNotExist(err) {
+		t.Fatalf("compiler executed during static context installation: %v", err)
+	}
