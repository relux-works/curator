+
+	nodes, err = h.build([]manifest.Decl{decl("provider")}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, want := nodes[0].ActiveCommandNames(), []string{"build-tool", "script-tool"}; !reflect.DeepEqual(got, want) {
