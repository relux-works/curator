+		"schema_version": 6,
+		"build_roots": ["assets/build-tool"],
+		"capabilities": {},
+		"commands": {
+			"build-tool": {"type":"build","driver":"go-v1","source_dir":"assets/build-tool/cmd/tool"}
+		}
+	}`)
+	e.git(dir, "add", ".")
