+		"capabilities": {},
+		"commands": {
+			"build-tool": {"type":"build","driver":"go-v1","source_dir":"assets/build-tool/cmd/tool"}
+		}
+	}`)
+	e.git(dir, "add", ".")
+	e.git(dir, "commit", "-qm", "init")
+	e.git(dir, "tag", "v1")
