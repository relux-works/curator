+	h.skillV6("consumer", map[string]map[string]any{}, map[string]map[string]any{
+		"provider": requirement("provider", "runtime", "build-tool"),
+	})
+
+	nodes, err := h.build([]manifest.Decl{decl("consumer")}, nil)
