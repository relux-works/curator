+func TestBuildCommandCollisions(t *testing.T) {
+	tests := []struct {
+		name      string
+		leftType  string
+		rightType string
+	}{
+		{name: "build versus build", leftType: "build", rightType: "build"},
+		{name: "build versus script", leftType: "build", rightType: "script"},
