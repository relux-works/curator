    98	func (mirror *Mirror) stageRoot(stageRoot, adapterRoot string, groups []Group, expected map[string]bool, mode string) error {
    99		key := rootKey(adapterRoot)
   100		managed := readLedger(adapterRoot)
   101	
   102		var stale []string
   103		for name := range managed {
   104			if !expected[name] {
   105				stale = append(stale, name)
   106			}
   107		}
   108		sort.Strings(stale)
   109		for _, name := range stale {
   110			if err := mirror.stageStale(key, name, filepath.Join(adapterRoot, name)); err != nil {
   111				return err
   112			}
   113		}
   114	
   115		for _, group := range groups {
   116			names := append([]string(nil), group.Skills...)
   117			sort.Strings(names)
   118			for _, name := range names {
   119				// The mirror points at the canonical root the commit publishes,
   120				// while its bytes are read from wherever the content lives right
   121				// now — the staged replacement for a skill this run installs, the
   122				// canonical directory for one that is already current.
   123				content := group.source(name)
   124				if _, err := os.Stat(content); err != nil {
   125					continue
   126				}
   127				canonical := filepath.Join(group.Root, name)
   128				target := filepath.Join(adapterRoot, name)
   129				conflict, err := unmanagedConflict(target, managed[name], canonical)
   130				if err != nil {
   131					return err
   132				}
   133				if conflict {
   134					return fmt.Errorf("adapter target already exists and is not managed: %s", target)
   135				}
   136				if err := mirror.stageEntry(stageRoot, key, name, content, canonical, target, mode); err != nil {
   137					return err
   138				}
   139			}
   140		}
   141	
   142		ledger, err := ledgerPayload(expected)
   143		if err != nil {
   144			return err
   145		}
   146		stagedLedger := filepath.Join(stageRoot, "adapters", key, LedgerName)
   147		if err := os.MkdirAll(filepath.Dir(stagedLedger), 0o700); err != nil {
   148			return fmt.Errorf("stage adapter ledger: %w", err)
   149		}
   150		if err := os.WriteFile(stagedLedger, ledger, 0o644); err != nil {
   151			return fmt.Errorf("stage adapter ledger: %w", err)
   152		}
   153		// "ledger" sorts after "entry/..." bytewise, so every mirror this ledger
   154		// claims is already durable when the claim itself commits.
   155		mirror.plan.Replace(staging.ClassAdapterLedger, key+"/ledger", filepath.Join(adapterRoot, LedgerName), stagedLedger)
   156		return nil
   157	}
   158	
   159	// stageStale journals a managed entry the next ledger no longer claims. Its
   160	// desired state is absence, so the transaction backs the entry up before
   161	// removing it and restores it — a copied tree byte for byte, a link with its
   162	// exact destination — if any later class fails.
   163	//
   164	// An entry that is neither a directory, a regular file, nor a link is reported
   165	// and left alone rather than removed behind a rollback that could not put it
   166	// back; the same rule the canonical stores use for stale skills.
   167	func (mirror *Mirror) stageStale(key, name, target string) error {
   168		info, err := os.Lstat(target)
   169		if os.IsNotExist(err) {
   170			return nil
   171		}
   172		if err != nil {
   173			return err
   174		}
   175		if info.Mode()&os.ModeSymlink == 0 && !info.IsDir() && !info.Mode().IsRegular() {
   176			mirror.Messages = append(mirror.Messages, fmt.Sprintf(
   177				"stale adapter entry %q was left in %s because it is a special file that cannot be removed transactionally",
   178				name, filepath.Dir(target)))
   179			return nil
   180		}
   181		mirror.plan.RemoveEntry("adapter/"+key+"/"+name, target)
   182		return nil
   183	}
   184	
   185	// stageEntry stages one mirror entry. "auto" prefers a link and falls back to a
   190	func (mirror *Mirror) stageEntry(stageRoot, key, name, content, canonical, target, mode string) error {
   191		switch mode {
   192		case "copy":
   193			return mirror.stageCopy(stageRoot, key, name, content, target)
   194		case "symlink":
   195			return mirror.stageLink(stageRoot, key, name, canonical, target)
   196		default:
   197			if linksSupported(stageRoot, target) {
   198				return mirror.stageLink(stageRoot, key, name, canonical, target)
   199			}
   200			return mirror.stageCopy(stageRoot, key, name, content, target)
   201		}
   202	}
   203	
   204	// stageLink stages one symbolic-link mirror entry. An entry that is already the
   205	// exact link the commit would install produces no target at all: the desired
   206	// state is the live state, and journaling an identical replacement would churn
   207	// every adapter root on every run.
   208	func (mirror *Mirror) stageLink(stageRoot, key, name, canonical, target string) error {
   209		destination := linkDestination(canonical, target)
   210		if current, err := os.Readlink(target); err == nil && current == destination {
   211			return nil
   212		}
   213		stagedEntry := filepath.Join(stageRoot, "adapters", key, "links", name)
   214		if err := os.MkdirAll(filepath.Dir(stagedEntry), 0o700); err != nil {
   215			return fmt.Errorf("stage adapter mirror %s: %w", target, err)
   216		}
   217		if err := os.RemoveAll(stagedEntry); err != nil {
   218			return fmt.Errorf("stage adapter mirror %s: %w", target, err)
   219		}
   220		if err := os.Symlink(destination, stagedEntry); err != nil {
   221			return fmt.Errorf("stage adapter mirror %s: %w", target, err)
   222		}
   223		mirror.plan.ReplaceEntry(staging.ClassAdapterLedger, key+"/entry/"+name, target, stagedEntry)
   224		return nil
   225	}
   226	
   227	func (mirror *Mirror) stageCopy(stageRoot, key, name, content, target string) error {
   228		stagedEntry := filepath.Join(stageRoot, "adapters", key, "entries", name)
   229		if err := os.MkdirAll(filepath.Dir(stagedEntry), 0o700); err != nil {
   230			return fmt.Errorf("stage adapter mirror %s: %w", target, err)
   231		}
   232		if err := os.RemoveAll(stagedEntry); err != nil {
   233			return fmt.Errorf("stage adapter mirror %s: %w", target, err)
   234		}
   235		if err := copyTree(content, stagedEntry); err != nil {
