    75		}
    76		agents := make([]string, 0, len(adapterRoots))
    77		for agent := range adapterRoots {
    78			agents = append(agents, agent)
    79		}
    80		sort.Strings(agents)
    81	
    82		var mirror Mirror
    83		staged := map[string]bool{}
    84		for _, agent := range agents {
    85			adapterRoot := adapterRoots[agent]
    86			if staged[adapterRoot] {
    87				// Two agents may share one native-discovery root; stage it once.
    88				continue
    89			}
    90			staged[adapterRoot] = true
    91			if err := mirror.stageRoot(stageRoot, adapterRoot, groups, expected, mode); err != nil {
    92				return Mirror{}, err
    93			}
    94		}
    95		return mirror, nil
    96	}
