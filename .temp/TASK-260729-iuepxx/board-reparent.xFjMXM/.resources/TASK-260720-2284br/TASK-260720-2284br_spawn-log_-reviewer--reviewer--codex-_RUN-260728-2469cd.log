   121	
   122	// TestFailureAtEveryTargetClassRestoresPriorStateInReverseOrder injects a
   123	// failure at each target of a second installation and proves the complete prior
   124	// project, global, hybrid, runtime, shim, env, adapter, mirror, removal, and
   125	// consumer state comes back, in exact reverse commit order.
   126	//
   127	// The project scenario runs in the production-default adapter mode, so the
   128	// mirror entries it commits and restores are the symbolic links a real machine
   129	// gets; the global scenario adds the forwarding shims and the user-bin mirror
   130	// ledger that only the machine-wide scope produces.
   131	func TestFailureAtEveryTargetClassRestoresPriorStateInReverseOrder(t *testing.T) {
   132		// The machine-wide scope only publishes forwarding shims into a user bin
   133		// that is already on PATH, so the sweep gives it one. PATH is set here, in
   134		// the sequential parent, because the scenarios below run in parallel.
   135		globalUserHome := t.TempDir()
   136		if runtime.GOOS != "windows" {
   137			userBin := filepath.Join(globalUserHome, ".local", "bin")
   138			if err := os.MkdirAll(userBin, 0o755); err != nil {
   139				t.Fatal(err)
   140			}
   141			t.Setenv("PATH", userBin+string(os.PathListSeparator)+os.Getenv("PATH"))
   142		}
   143	
   144		for _, scenario := range []sweepScenario{
   145			projectSweepScenario("project-hybrid-auto", "auto"),
   146			globalSweepScenario("global-auto", "auto"),
   147		} {
   148			t.Run(scenario.name, func(t *testing.T) {
   149				t.Parallel()
   150				// One baseline serves every injection. A correct rollback returns
   151				// the machine to exactly the prior state, so the next injection
   152				// starts from the same place — and any residue one rollback leaves
   153				// behind shows up as a failure of the injection after it.
   154				e := newEnv(t)
   155				e.cfg.AdapterMode = scenario.mode
   156				if scenario.sharedUserHome {
   157					e.userHome = globalUserHome
   158				}
   159				scenario.baseline(t, e)
   160				before := snapshotState(t, e)
   161				scenario.upgrade(t, e)
   162	
   163				for _, class := range scenario.classes {
   164					passed := t.Run(class, func(t *testing.T) {
   165						probe := &commitProbe{
   166							failClass: class,
   167							failErr:   fmt.Errorf("injected failure in class %s", class),
   168						}
   169						result := scenario.install(e, install.Options{
   170							Commit: install.CommitDeps{Hooks: probe.hooks(), MaxRestarts: 1},
   171						})
   172						// A class the scenario never produces cannot be failed, so
   173						// the install would succeed here: coverage of every class in
   174						// scenario.classes is enforced rather than assumed.
   175						if result.Status != "failed" {
   176							t.Fatalf("install status = %q, want failed in class %s: %+v", result.Status, class, result)
   177						}
   178						if changed := before.diff(snapshotState(t, e)); len(changed) > 0 {
   179							t.Fatalf("rollback did not restore the prior state: %v", changed)
   180						}
   181						for _, committed := range probe.committedClasses() {
   182							if committed > class {
   183								t.Fatalf("class %s committed after the failure in %s", committed, class)
   184							}
   185						}
   186						probe.assertReverseRollback(t)
   187						assertNoJournalRemains(t, e.home)
   188					})
   189					if !passed {
   190						// Once one rollback is wrong the shared baseline is no
   191						// longer trustworthy, so later injections would report
   192						// noise rather than new information.
   193						break
   194					}
   195				}
   196	
   197				// The same operation must still succeed after the whole sweep, and
   198				// the successful commit is what proves every swept class was really
   199				// on the table.
   200				probe := &commitProbe{}
   201				result := scenario.install(e, install.Options{Commit: install.CommitDeps{Hooks: probe.hooks()}})
   202				if result.Status != "ok" {
   203					t.Fatalf("install after the rollback sweep failed: %+v", result)
   204				}
   205				classes := probe.committedClasses()
   220	// TestAdapterMirrorLinksAreJournaledAndRestoredExactly is the symlink half of
   221	// the atomicity contract: in the production-default auto mode and in explicit
   222	// symlink mode, a mirror entry that a commit re-points is restored to its exact
   223	// prior destination when a later class fails, and no prepared journal survives
   224	// the failure for a later recovery to commit.
   225	//
   226	// The re-pointing is real rather than synthetic: skill-h starts in the hybrid
   227	// store and becomes project-declared, so its canonical root — and therefore its
   228	// mirror destination — changes.
   229	func TestAdapterMirrorLinksAreJournaledAndRestoredExactly(t *testing.T) {
   230		for _, mode := range []string{"auto", "symlink"} {
   231			t.Run(mode, func(t *testing.T) {
   232				t.Parallel()
   233				e := newEnv(t)
   234				e.cfg.AdapterMode = mode
   235				e.skill("skill-a")
   236				e.skill("skill-h")
   237				e.declare("skill-a")
   238				e.hybridDeclare("skill-h")
   239				if result := e.install(install.Options{}); result.Status != "ok" {
   240					t.Fatalf("baseline install failed: %+v", result)
   241				}
   242	
   243				mirror := filepath.Join(e.project, ".claude", "skills", "skill-h")
   244				before := adapterEntryState(t, mirror)
   245				if !strings.HasPrefix(before, "link:") {
   246					t.Skipf("%s mode did not produce a link on this filesystem: %s", mode, before)
   247				}
   248				if !strings.Contains(before, "hybrid") {
   249					t.Fatalf("the hybrid mirror does not point at the hybrid store: %s", before)
   250				}
   251				priorState := snapshotState(t, e)
   252	
   253				// skill-h becomes project-declared, so the mirror has to be
   254				// re-pointed at the project store; then the commit fails.
   255				e.declare("skill-a", "skill-h")
   256				e.hybridDeclare()
   257				probe := &commitProbe{failClass: staging.ClassConsumer, failErr: fmt.Errorf("injected consumer-class failure")}
   258				result := e.install(install.Options{Commit: install.CommitDeps{Hooks: probe.hooks(), MaxRestarts: 1}})
   259				if result.Status != "failed" {
   260					t.Fatalf("install status = %q, want failed: %+v", result.Status, result)
   261				}
   262	
   263				if got := adapterEntryState(t, mirror); got != before {
   264					t.Fatalf("mirror entry = %s, want its exact prior link %s", got, before)
   265				}
   266				if changed := priorState.diff(snapshotState(t, e)); len(changed) > 0 {
   267					t.Fatalf("rollback did not restore the prior state: %v", changed)
   268				}
   269				probe.assertReverseRollback(t)
   270				assertNoJournalRemains(t, e.home)
   271	
   272				// A recovery pass after the failure must find nothing to finish.
   273				// The failed operation returned without leaving a transaction that
   274				// a later run would commit on its behalf.
   275				afterFailure := snapshotState(t, e)
   276				runRecovery(t, e.home)
   277				if changed := afterFailure.diff(snapshotState(t, e)); len(changed) > 0 {
   278					t.Fatalf("recovery applied state from a failed operation: %v", changed)
   279				}
   280				if got := adapterEntryState(t, mirror); got != before {
   281					t.Fatalf("recovery re-pointed the mirror to %s after the operation failed", got)
   282				}
   283	
   284				// The same operation must still succeed on a retry.
   285				if result := e.install(install.Options{}); result.Status != "ok" {
   286					t.Fatalf("retry after rollback failed: %+v", result)
   287				}
   288				retried := adapterEntryState(t, mirror)
   289				if !strings.HasPrefix(retried, "link:") || strings.Contains(retried, "hybrid") {
   290					t.Fatalf("mirror entry after a successful retry = %s, want a link into the project store", retried)
   291				}
   292			})
   293		}
   294	}
   295	
   296	// runRecovery finishes every incomplete transaction under one manager home,
   297	// which is what the next installation would do before mutating anything.
   298	func runRecovery(t *testing.T, home string) {
   299		t.Helper()
   300		engine, err := transaction.New(home)
   301		if err != nil {
   302			t.Fatal(err)
   303		}
   304		manager, err := managerlock.New(home)
   305		if err != nil {
   306			t.Fatal(err)
   307		}
   308		lock, err := manager.AcquireHomeOnly(context.Background(), false)
   309		if err != nil {
   310			t.Fatal(err)
   311		}
   312		recoverErr := engine.Recover(lock)
   313		if closeErr := lock.Close(); closeErr != nil {
   314			t.Fatal(closeErr)
   315		}
   316		if recoverErr != nil {
   317			t.Fatal(recoverErr)
   318		}
   319	}
   320	
   321	// TestStaleAdapterEntryIsRemovedBeforeTheConsumerLedger closes the ordering hole
   322	// that made stale mirror pruning a post-commit sweep: a managed entry the next
   323	// ledger no longer claims is a journaled removal, and it commits before the
   324	// machine-wide consumer ledger, in every adapter mode.
   325	func TestStaleAdapterEntryIsRemovedBeforeTheConsumerLedger(t *testing.T) {
   326		for _, mode := range []string{"auto", "symlink", "copy"} {
   327			t.Run(mode, func(t *testing.T) {
   328				t.Parallel()
   329				e := newEnv(t)
   330				e.cfg.AdapterMode = mode
   331				e.skill("skill-a")
   332				e.skill("skill-drop")
   333				e.declare("skill-a", "skill-drop")
   334				if result := e.install(install.Options{}); result.Status != "ok" {
   335					t.Fatalf("baseline install failed: %+v", result)
   336				}
   337				stale := filepath.Join(e.project, ".claude", "skills", "skill-drop")
   338				if adapterEntryState(t, stale) == "absent" {
   339					t.Fatalf("the baseline install published no mirror for skill-drop")
   340				}
   341	
   342				e.declare("skill-a")
   343				probe := &commitProbe{}
   344				if result := e.install(install.Options{Commit: install.CommitDeps{Hooks: probe.hooks()}}); result.Status != "ok" {
   345					t.Fatalf("second install failed: %+v", result)
   346				}
   347				if got := adapterEntryState(t, stale); got != "absent" {
   348					t.Fatalf("stale mirror entry survived: %s", got)
   349				}
   350	
   351				probe.mu.Lock()
   352				defer probe.mu.Unlock()
   353				removalIndex, consumerIndex := -1, -1
   354				for index, event := range probe.committed {
   355					if event.Class == staging.ClassRemoval && strings.Contains(event.Identifier, "adapter/") {
   356						removalIndex = index
   357					}
   358					if event.Class == staging.ClassConsumer {
   359						consumerIndex = index
   360					}
   361				}
   362				if removalIndex < 0 {
   363					t.Fatalf("the stale mirror was not a journaled removal: %+v", probe.committed)
   364				}
   365				if consumerIndex < 0 {
   366					t.Fatal("the project install committed no consumer ledger")
   367				}
   368				if removalIndex > consumerIndex {
   369					t.Fatal("the consumer ledger committed before the stale mirror was removed")
   370				}
   371				if last := probe.committed[len(probe.committed)-1]; last.Class != staging.ClassConsumer {
   372					t.Fatalf("last committed class = %q, want the consumer ledger", last.Class)
   373				}
   374			})
   375		}
   376	}
   377	
   378	// TestStaleAdapterRemovalRollsBackToTheExactPriorEntry proves the removal class
   379	// is restorable, which is the whole reason stale pruning moved into the journal.
   380	func TestStaleAdapterRemovalRollsBackToTheExactPriorEntry(t *testing.T) {
   381		e := newEnv(t)
   382		e.cfg.AdapterMode = "auto"
   383		e.skill("skill-a")
   384		e.skill("skill-drop")
   385		e.declare("skill-a", "skill-drop")
   386		if result := e.install(install.Options{}); result.Status != "ok" {
   387			t.Fatalf("baseline install failed: %+v", result)
   388		}
   389		stale := filepath.Join(e.project, ".claude", "skills", "skill-drop")
   390		before := adapterEntryState(t, stale)
   391		if before == "absent" {
   392			t.Fatal("the baseline install published no mirror for skill-drop")
   393		}
   394		priorState := snapshotState(t, e)
   395	
   396		e.declare("skill-a")
   397		probe := &commitProbe{failClass: staging.ClassConsumer, failErr: fmt.Errorf("injected consumer-class failure")}
   398		result := e.install(install.Options{Commit: install.CommitDeps{Hooks: probe.hooks(), MaxRestarts: 1}})
   399		if result.Status != "failed" {
   400			t.Fatalf("install status = %q, want failed: %+v", result.Status, result)
   401		}
   402		if got := adapterEntryState(t, stale); got != before {
   403			t.Fatalf("removed mirror entry came back as %s, want its exact prior state %s", got, before)
   404		}
   405		if changed := priorState.diff(snapshotState(t, e)); len(changed) > 0 {
   406			t.Fatalf("rollback did not restore the prior state: %v", changed)
   407		}
   408		assertNoJournalRemains(t, e.home)
   409	}

