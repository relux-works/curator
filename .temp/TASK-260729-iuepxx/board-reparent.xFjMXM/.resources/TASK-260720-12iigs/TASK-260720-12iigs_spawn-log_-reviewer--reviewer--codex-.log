+func v6SchemaExamples() []schemaExample {
+	buildCommand := func() map[string]any {
+		return map[string]any{"type": "build", "driver": "go-v1", "source_dir": "build/cmd/tool"}
+	}
+	withField := func(field string, value any) map[string]any {
