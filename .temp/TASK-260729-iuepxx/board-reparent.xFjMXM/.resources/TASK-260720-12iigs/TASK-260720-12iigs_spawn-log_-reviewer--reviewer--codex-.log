        "sha256": "sha256:a4f06a1304c926ed7f2326c8fd90cabc5c5bd2981e690a4351c852d91c079d88",
        "size": 24
      }
    },
    "receipt_sha256": "sha256:9a23f5b77e6173b0f10e7ed43cd2b21aa3b99f3a34945ec432fbb31338a6186d",
