+		if err != nil {
+			t.Fatal(err)
+		}
+		sum := sha256.Sum256(payload)
+		if got := hex.EncodeToString(sum[:]); got != digest {
+			t.Fatalf("rc.4 artifact changed from accepted baseline %s: %s digest %s, want %s", legacyWireBaselineCommit, path, got, digest)
+		}
+	}
+}
