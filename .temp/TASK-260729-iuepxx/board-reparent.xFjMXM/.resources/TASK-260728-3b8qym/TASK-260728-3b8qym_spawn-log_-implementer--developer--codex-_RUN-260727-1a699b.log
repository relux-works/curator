+
+	sha1Config := "[core]\n\trepositoryformatversion = 0\n\tbare = false\n"
+	sha256Config := "[core]\n\trepositoryformatversion = 1\n\tbare = false\n[extensions]\n\tobjectFormat = sha256\n\trefStorage = files\n"
