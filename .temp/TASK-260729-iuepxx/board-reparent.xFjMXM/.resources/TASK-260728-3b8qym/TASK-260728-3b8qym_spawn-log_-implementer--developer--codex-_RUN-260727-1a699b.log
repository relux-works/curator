+	platforms := namedObjects(t, qualification["platforms"])
+	if platforms["linux"]["status"] != "excluded" || platforms["linux"]["until_task"] != "TASK-260728-1skseh" {
+		t.Fatalf("Linux qualification boundary is not exact: %#v", platforms["linux"])
+	}
+}
