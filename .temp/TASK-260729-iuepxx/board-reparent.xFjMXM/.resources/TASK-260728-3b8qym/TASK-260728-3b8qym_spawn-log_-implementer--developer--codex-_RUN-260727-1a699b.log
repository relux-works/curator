+		}
+		index, err := hex.DecodeString(item["index_hex"].(string))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if string(pack[:4]) != "PACK" || !bytes.Equal(index[:4], []byte{0xff, 0x74, 0x4f, 0x63}) {
+			t.Fatalf("%s does not carry exact pack/index magic", name)
+		}
+	}
