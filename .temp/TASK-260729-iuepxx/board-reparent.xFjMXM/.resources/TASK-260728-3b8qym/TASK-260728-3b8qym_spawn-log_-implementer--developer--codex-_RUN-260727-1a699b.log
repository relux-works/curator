+		map[string]any{"name": "reject-pack-hash-family-mismatch", "repository_object_format": "sha256", "pack_checksum_width": 40, "expected_error": "build_repository_local_object_format_unsupported"},
+	}
+	writeJSON(filepath.Join(fixtures, "pack-index.json"), map[string]any{"cases": packCases})
