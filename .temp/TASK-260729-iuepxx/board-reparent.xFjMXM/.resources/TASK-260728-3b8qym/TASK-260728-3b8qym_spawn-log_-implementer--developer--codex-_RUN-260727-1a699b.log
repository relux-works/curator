+	writeJSON(filepath.Join(fixtures, "local-config-and-refs.json"), map[string]any{"cases": configCases})
+
+	packCases := []any{
+		packIndexCase("valid-empty-pack-v2-sha1", "sha1", 2, 2, "valid"),
