+    for case in raw["cases"]:
+        content = decode_base64(case.get("content_base64"), f"raw object {case['name']}")
+        try:
+            digest = git_object_id(case.get("object_format"), case.get("object_type"), content)
+        except (TypeError, ValueError) as exc:
