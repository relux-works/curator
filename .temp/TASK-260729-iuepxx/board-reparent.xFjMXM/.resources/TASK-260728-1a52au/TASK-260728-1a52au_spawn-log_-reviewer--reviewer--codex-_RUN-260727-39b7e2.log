\",\"xhigh\",\"max\"]},\"tracking\":{\"commands\":[\"status\",\"events\",\"watch\",\"wait\",\"directives\",\"directive\"],\"delivery\":\"external-watch\",\"in_session_delivery\":false,\"mode\":\"tracked\",\"run_id_prefix\":\"RUN-\",\"runtime\":\"external\"}},\"version_control\":{\"acknowledgement_parameter\":\"commit_ack\",\"acknowledgement_value\":\"scope_committed\",\"config_key\":\"version_control.confirm\",\"configured\":false,\"confirm\":false,\"desired_commit_time\":null,\"enforced_types\":[\"bug\",\"story\"],\"owner_message\":\"I acknowledge that MY scope is committed; foreign uncommitted work is fine.\"},\"whoami\":{\"remote\":null,\"token_stored\":false,\"user\":null}}\nid:TASK-260728-1a52au\ntype:task\nname:schema-v7-external-repository-core-contract\ntitle:TASK-260728-1a52au: schema-v7-external-repository-core-contract\nstatus:reviewing\nreview:required\ntask_class:docs\nestimate:{\"kind\":\"estimated\",\"scale\":{\"kind\":\"fibonacci\",\"number\":5}}\nobservability:{\"readiness\":{\"advisoryBlockedElementIds\":[],\"blockedElementIds\":[],\"coverage\":{\"complete\":true,\"estimated\":1,\"ratio\":\"1/1\",\"total\":1,\"unestimated\":0},\"estimateKind\":\"estimated\",\"isAdvisoryBlocked\":false,\"isBlocked\":false,\"rolledEstimate\":{\"kind\":\"estimated\",\"scale\":{\"kind\":\"fibonacci\",\"number\":5}}},\"scope\":{\"id\":\"TASK-260728-1a52au\",\"name\":\"schema-v7-external-repository-core-contract\",\"type\":\"task\"},\"summary\":{\"active\":[{\"id\":\"TASK-260728-1a52au\",\"name\":\"schema-v7-external-repository-core-contract\",\"status\":\"reviewing\"}],\"blocked\":[],\"byType\":{\"bug\":{\"total\":0,\"todo\":0,\"active\":0,\"done\":0,\"closed\":0,\"blocked\":0},\"epic\":{\"total\":0,\"todo\":0,\"active\":0,\"done\":0,\"closed\":0,\"blocked\":0},\"story\":{\"total\":0,\"todo\":0,\"active\":0,\"done\":0,\"closed\":0,\"blocked\":0},\"task\":{\"total\":1,\"todo\":0,\"active\":1,\"done\":0,\"closed\":0,\"blocked\":0}}}}\nparent:STORY-260728-10wxx2\nassignee: