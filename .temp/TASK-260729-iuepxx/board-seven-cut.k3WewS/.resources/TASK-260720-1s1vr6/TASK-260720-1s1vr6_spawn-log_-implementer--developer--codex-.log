+	receipt := candidate["receipt"].(map[string]any)
+	if sha256Identity(canonicalBytes(receipt)) != "sha256:9a23f5b77e6173b0f10e7ed43cd2b21aa3b99f3a34945ec432fbb31338a6186d" || candidate["receipt_sha256"] != "sha256:9a23f5b77e6173b0f10e7ed43cd2b21aa3b99f3a34945ec432fbb31338a6186d" {
+		t.Fatalf("forged receipt is not the exact self-consistent regression candidate: %#v", candidate)
+	}
+	marker := cases["marker-embed-build-source-regression"]
+	markerInput := marker["input"].(map[string]any)
+	variants := markerInput["variants"].([]any)
+	if markerInput["legacy_content_sha256"] != "sha256:829a040a1455fdf96e2731aa5c089e7e42dbcec2a51b1db3222a610f0ffb5b35" || variants[0].(map[string]any)["build_source"].(map[string]any)["content_sha256"] == variants[1].(map[string]any)["build_source"].(map[string]any)["content_sha256"] {
+		t.Fatalf("marker-embed regression identities are incomplete: %#v", marker)
+	}
+}
