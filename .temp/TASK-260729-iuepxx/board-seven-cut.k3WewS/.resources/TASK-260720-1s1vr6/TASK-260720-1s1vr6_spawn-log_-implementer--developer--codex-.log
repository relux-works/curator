+			"build_input_ccj_utf8":    string(buildInputBytes),
+			"build_input_ccj_base64":  base64.StdEncoding.EncodeToString(buildInputBytes),
+			"cache_key":               cacheKey,
+			"stored_receipt":          receipt,
