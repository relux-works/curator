Run the setup script to create symlinks:

```bash
./scripts/setup.sh
```

This links the skill to `~/.agents/skills/go-testing-tools`, `~/.claude/skills/go-testing-tools`, and `~/.codex/skills/go-testing-tools`.

To remove:

```bash
./scripts/deinit.sh
```

exec
/bin/zsh -lc "sed -n '621,940p' /Users/iv/.agents/skills/project-management/SKILL.md && sed -n '941,1260p' /Users/iv/.agents/skills/project-management/SKILL.md" in /Users/iv/Developer/ReluxWorks/curator
 succeeded in 0ms:
export TASK_BOARD_TOKEN=tb_xxxxx
export TASK_BOARD_ID=my-project

# Create a board
curl -X POST -H "Authorization: Bearer $TASK_BOARD_TOKEN" \
  -d '{"id":"my-project","name":"My Project"}' \
  $TASK_BOARD_REMOTE/admin/boards

# Use normally — q and m route to server automatically
