        "type": "build",
        "driver": "go-v1",
        "source_dir": "assets/build-tool/cmd/golden-tool"
      }
    },
    "capabilities": {
      "network": "none",
      "filesystem": "repo",
      "exec": "none",
      "secrets": "none",
      "env_read": []
