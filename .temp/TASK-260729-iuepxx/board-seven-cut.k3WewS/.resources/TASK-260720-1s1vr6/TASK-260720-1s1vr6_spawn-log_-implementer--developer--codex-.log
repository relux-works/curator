+		rejection("toolchain-version-multiple-terminal-newlines", "toolchain", "malformed_go_version", map[string]any{"stdout_base64": base64.StdEncoding.EncodeToString([]byte("go version go1.25.5 darwin/arm64\n\n"))}),
