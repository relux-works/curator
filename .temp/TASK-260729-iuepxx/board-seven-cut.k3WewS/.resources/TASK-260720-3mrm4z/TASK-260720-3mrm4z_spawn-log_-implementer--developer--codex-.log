+		A int64 `json:"a"`
+	}
+	if err := UnmarshalCanonical([]byte(`{"a":1,"extra":true}`), &decoded); err == nil || !strings.Contains(err.Error(), "unknown field") {
+		t.Fatalf("unknown field error = %v", err)
