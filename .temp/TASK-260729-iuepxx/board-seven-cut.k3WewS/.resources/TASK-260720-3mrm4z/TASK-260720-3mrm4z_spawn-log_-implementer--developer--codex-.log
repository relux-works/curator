+		t.Fatal(err)
+	}
+	want := `{"bool":false,"controls":"\u0000\u0001\b\f\n\r\t","ints":[-1,2,3,4,5],"object":{"a":"1","b":"2"},"strings":["a","b"],"uints":[1,2,3,4,5]}`
+	if string(got) != want {
+		t.Fatalf("canonical bytes:\n got %s\nwant %s", got, want)
+	}
