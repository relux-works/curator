+					object := value
+					if objectName != "" {
+						object = value[objectName].(map[string]any)
+					}
+					delete(object, field)
+				})
+				if _, err := DecodeReceipt(payload); err == nil {
+					t.Fatal("incomplete receipt was accepted")
