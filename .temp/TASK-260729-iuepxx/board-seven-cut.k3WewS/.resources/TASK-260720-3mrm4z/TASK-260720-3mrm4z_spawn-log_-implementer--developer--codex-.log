+		"leading whitespace":  []byte(` {"a":1,"s":"é"}`),
+		"pretty printed":      []byte("{\n  \"a\": 1,\n  \"s\": \"é\"\n}"),
+		"trailing newline":    append(append([]byte{}, canonical...), '\n'),
