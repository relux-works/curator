+		"ints": []any{int(-1), int8(2), int16(3), int32(4), int64(5)},
+		"uints": []any{uint(1), uint8(2), uint16(3), uint32(4), uint64(5)},
+		"strings": []string{"a", "b"},
+		"object": map[string]string{"b": "2", "a": "1"},
+	}
+	got, err := MarshalCanonical(value)
