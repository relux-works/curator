+func TestMarshalCanonicalRejectsUnsupportedValues(t *testing.T) {
+	for name, value := range map[string]any{
+		"fraction":       json.Number("1.5"),
+		"exponent":       json.Number("1e2"),
+		"negative zero":  json.Number("-0"),
