+func TestExpectedInputComparisonCoversEveryLogicalComponent(t *testing.T) {
+	expected := goldenInput()
+	receipt, err := NewReceipt(expected, goldenArtifact())
+	if err != nil {
+		t.Fatal(err)
+	}
