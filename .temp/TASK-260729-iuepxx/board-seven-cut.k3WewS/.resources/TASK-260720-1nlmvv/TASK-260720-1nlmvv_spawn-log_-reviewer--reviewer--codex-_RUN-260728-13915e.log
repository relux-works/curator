   349	// contextExposure reports the build-root exclusion violation of one installed
   350	// skill, or an empty string when the boundary is intact. Both directions are
   430	// classification can tell an operator that installed state moved underneath it
   431	// instead of publishing a verdict that was already stale when it was printed.
   432	func markerDigests(stores ...string) map[string]string {
   433		digests := map[string]string{}
   434		for _, store := range stores {
   435			entries, err := os.ReadDir(store)
   436			if err != nil {
   437				continue
   438			}
   439			for _, entry := range entries {
   440				path := filepath.Join(store, entry.Name(), marker.Name)
   441				payload, readErr := os.ReadFile(path) // #nosec G304 -- path derives from a manager-owned store
   442				if readErr != nil {
   443					digests[path] = "absent"
   444					continue
   445				}
   446				sum := sha256.Sum256(payload)
   447				digests[path] = hex.EncodeToString(sum[:])
   448			}
   449		}
   450		return digests
   451	}
   452	
   453	// markerMoved reports whether the marker of one installed directory differs
   454	// between two fingerprints of the same stores.
   455	func markerMoved(before, after map[string]string, installedDir string) bool {
   456		path := filepath.Join(installedDir, marker.Name)
   457		return before[path] != after[path]
   458	}
