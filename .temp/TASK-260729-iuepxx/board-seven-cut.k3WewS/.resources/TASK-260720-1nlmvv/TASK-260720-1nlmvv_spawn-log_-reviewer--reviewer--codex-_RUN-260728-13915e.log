			}(),
			source: &source, facts: testFacts(string(install.BuildCacheHit)), want: buildCorruptReceipt,
		},
		"artifact hash moved": {
			recorded: func() marker.Build { b := testRecordedBuild(); b.ArtifactSHA256 = testDigest(6); return b }(),
			source:   &source, facts: testFacts(string(install.BuildCacheHit)), want: buildArtifactDrift,
