	if len(repaired) != 1 || !strings.Contains(repaired[0], "rebuilt untrusted build cache state") {
		t.Fatalf("successful repair notice = %v", repaired)
	}
	preserved := repairNotices("app", []buildFacts{untrusted}, "failed")
	if len(preserved) != 1 || !strings.Contains(preserved[0], "previous installation") {
		t.Fatalf("failed repair notice = %v", preserved)
