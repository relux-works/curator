     1	package install
     2	
     3	import (
     4		"strings"
     5		"unicode"
     6		"unicode/utf8"
     7	)
     8	
     9	const (
    10		// maxDiagnosticRunes bounds one rendered diagnostic detail. Compiler
    11		// output, receipts, and cache bytes are untrusted and unbounded; a report
    12		// line must stay a report line.
    13		maxDiagnosticRunes = 240
    14		// redactedPath replaces every absolute path in a rendered detail. Manager
    15		// home, cache, staging, and probe locations are private implementation
    16		// state and are never published to a report or a machine-readable field.
    17		redactedPath = "<path>"
    18		// truncationMarker ends a detail that was longer than the bound.
    19		truncationMarker = "..."
    20	)
    21	
    22	// RedactDiagnostic renders one untrusted diagnostic detail for an operator.
    23	//
    24	// Build reasons, receipt bytes, cache contents, and compiler output are
    25	// package- or filesystem-controlled data, so they are never printed verbatim.
    26	// The rendering collapses the value onto one line, drops control characters so
    27	// the value cannot drive a terminal, replaces every absolute path with a
    28	// placeholder, and bounds the result. Protocol-relative paths such as a build
    29	// root survive: they are declaration state, not private location state.
    30	func RedactDiagnostic(detail string) string {
    31		cleaned := strings.ToValidUTF8(detail, "")
    32		// Anything that is not printable — control characters, escape sequences,
    33		// line breaks, and zero-width format runes — becomes plain whitespace, so
    34		// an untrusted detail cannot address the terminal or forge a second line.
    35		cleaned = strings.Map(func(r rune) rune {
    36			if !unicode.IsPrint(r) {
    37				return ' '
    38			}
    39			return r
    40		}, cleaned)
    41	
    42		fields := strings.Fields(cleaned)
    43		for index, field := range fields {
    44			fields[index] = redactField(field)
    45		}
    46		return boundRunes(strings.Join(fields, " "))
    47	}
    48	
    49	// redactField replaces one whitespace-delimited token when it names an
    50	// absolute location, preserving the punctuation that surrounds it so the
    51	// remaining sentence still reads.
    52	func redactField(field string) string {
    53		const openers = `"'` + "`" + `([{<`
    54		const closers = `"'` + "`" + `)]}>:;,.`
    55		prefix := field[:len(field)-len(strings.TrimLeft(field, openers))]
    56		core := strings.TrimLeft(field, openers)
    57		suffix := core[len(strings.TrimRight(core, closers)):]
    58		core = strings.TrimRight(core, closers)
    59		if !absolutePath(core) {
    60			return field
    61		}
    62		return prefix + redactedPath + suffix
    63	}
    64	
    65	// absolutePath reports whether a token names a Unix, Windows, or UNC absolute
    66	// path. It deliberately does not consult the filesystem: redaction must not
    67	// depend on what happens to exist on the reporting host.
    68	func absolutePath(token string) bool {
    69		switch {
    70		case strings.HasPrefix(token, "/") && len(token) > 1:
    71			return true
    72		case strings.HasPrefix(token, `\\`):
    73			return true
    74		case len(token) >= 3 && token[1] == ':' && (token[2] == '\\' || token[2] == '/'):
    75			first := token[0]
    76			return first >= 'A' && first <= 'Z' || first >= 'a' && first <= 'z'
    77		default:
    78			return false
    79		}
    80	}
    81	
    82	func boundRunes(value string) string {
    83		if utf8.RuneCountInString(value) <= maxDiagnosticRunes {
    84			return value
    85		}
    86		keep := maxDiagnosticRunes - utf8.RuneCountInString(truncationMarker)
    87		runes := []rune(value)
    88		return strings.TrimRight(string(runes[:keep]), " ") + truncationMarker
    89	}
