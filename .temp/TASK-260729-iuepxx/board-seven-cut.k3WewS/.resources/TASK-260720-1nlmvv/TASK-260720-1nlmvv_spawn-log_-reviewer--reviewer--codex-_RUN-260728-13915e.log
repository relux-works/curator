	refused := repairNotices("app", []buildFacts{corrupt}, "failed")
	if len(refused) != 1 || !strings.Contains(refused[0], "before any mutation") {
		t.Fatalf("refusal notice = %v", refused)
	}
	if notices := repairNotices("app", []buildFacts{hit}, "ok"); len(notices) != 0 {
		t.Fatalf("a cache hit produced repair notices: %v", notices)
	}
}

func TestMarkerDigestsDetectAConcurrentInstallMarkerChange(t *testing.T) {
	store := t.TempDir()
	installed := filepath.Join(store, "build-skill")
package main

import (
	"encoding/json"
	"io"
	"os"
	"path/filepath"
