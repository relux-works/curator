    56		buildMissingArtifact = "missing-build-artifact"
    57		// buildCorruptReceipt is a protected entry whose canonical receipt identity
    58		// differs from the one the marker recorded.
    59		buildCorruptReceipt = "corrupt-build-receipt"
    60		// buildArtifactDrift is a protected entry whose artifact path or hash
    61		// differs from the one the marker recorded.
    62		buildArtifactDrift = "build-artifact-drift"
    63		// buildCorruptCache is a protected entry that cannot be interpreted at all.
    64		buildCorruptCache = "corrupt-build-cache"
    65		// buildUntrustedCache is candidate cache state outside a provable
    66		// manager-protected boundary.
    67		buildUntrustedCache = "untrusted-build-cache"
    68		// buildUnsupportedPlatform is a host that cannot protect the build cache.
    69		buildUnsupportedPlatform = "unsupported-build-platform"
    70		// buildStateChanged is compiled state that moved while status classified
    71		// it, so the verdict this run derived is not authoritative.
    72		buildStateChanged = "build-state-changed"
    73		// buildUnknownState is a planner outcome this manager does not know. It
    74		// fails closed rather than being reported as current.
    75		buildUnknownState = "unknown-build-state"
    76	)
