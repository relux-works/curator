   237	
   238	func onlyFields(raw map[string]json.RawMessage, allowed []string) bool {
   239		fields := make(map[string]bool, len(allowed))
   240		for _, field := range allowed {
   241			fields[field] = true
   242		}
   243		for field := range raw {
   244			if !fields[field] {
   245				return false
   246			}
   247		}
   248		return true
   249	}
