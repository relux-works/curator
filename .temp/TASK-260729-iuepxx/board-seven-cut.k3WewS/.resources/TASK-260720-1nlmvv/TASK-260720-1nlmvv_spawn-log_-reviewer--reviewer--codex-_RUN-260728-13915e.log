    78	// currentnessCodes lists every stable code `status` can report, so a test can
    79	// prove the documented set and the reachable set are the same.
    80	func currentnessCodes() []string {
    81		return []string{
    82			stateUpToDate, stateNotInstalled, stateNeedsInstall, stateContentDrift, stateUnresolvable,
    83			stateInvalidMarker, stateUnsupportedMarker,
    84			buildCurrent, buildCommandDrift, buildContextExposed, buildSourceDrift, buildTargetMismatch,
    85			buildUnsupportedDriver, buildMissingArtifact, buildCorruptReceipt, buildArtifactDrift,
    86			buildCorruptCache, buildUntrustedCache, buildUnsupportedPlatform, buildStateChanged,
    87			buildUnknownState,
    88		}
    89	}
