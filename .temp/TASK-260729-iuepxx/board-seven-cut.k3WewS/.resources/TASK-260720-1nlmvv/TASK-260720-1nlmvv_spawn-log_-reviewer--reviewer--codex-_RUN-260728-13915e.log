   772	func scopeStatusDrift(cfg *config.Config, manifestRoot, skillsDir string) map[string]string {
   773		drift := map[string]string{}
   774		projectManifest, err := manifest.Load(manifestRoot)
   775		if err != nil || projectManifest == nil {
   776			return drift
   777		}
   778		for _, decl := range projectManifest.Skills {
   779			installed := filepath.Join(skillsDir, decl.Name)
   780			if _, err := os.Stat(installed); err != nil {
   781				drift[decl.Name] = stateNotInstalled
   782				continue
   783			}
   784			recorded := marker.Read(installed)
   785			if recorded == nil {
   786				drift[decl.Name] = stateInvalidMarker
   787				continue
   788			}
   789			// Marker schema 1 stays readable: an unchanged schema 1 through 5
   790			// installation remains current under it, and only a schema this manager
   791			// cannot read at all is unsupported. A schema-1 marker that has to
   792			// describe a compiled command is demoted later, by the build
   793			// classification that can actually see the plan.
   794			if recorded.SchemaVersion != marker.SchemaVersion && recorded.SchemaVersion != marker.LegacySchemaVersion {
   795				drift[decl.Name] = stateUnsupportedMarker
   796				continue
   797			}
   798			actualHash, err := hashing.ContentSHA256(installed, nil)
   799			if err != nil || actualHash != recorded.ContentSHA256 {
   800				drift[decl.Name] = stateContentDrift
   801				continue
   802			}
   803			repo := filepath.Join(cfg.SkillsRoot, filepath.FromSlash(decl.Source))
   804			resolved, err := gitops.Resolve(repo, decl.Ref.Kind, decl.Ref.Value)
   805			if err != nil {
   806				drift[decl.Name] = stateUnresolvable
   807				continue
   808			}
   809			if recorded.RefKind == decl.Ref.Kind && recorded.Ref == decl.Ref.Value && recorded.Commit == resolved.Commit {
   810				drift[decl.Name] = stateUpToDate
   811			} else {
   812				drift[decl.Name] = stateNeedsInstall
   813			}
   814		}
   815		return drift
   816	}
