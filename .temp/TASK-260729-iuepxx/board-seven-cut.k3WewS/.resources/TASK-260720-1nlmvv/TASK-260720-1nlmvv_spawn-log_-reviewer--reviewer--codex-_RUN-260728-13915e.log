   131	// Read loads the marker of an installed directory; nil when absent or
   132	// unreadable (an unreadable marker simply means "not current").
   133	func Read(installedDir string) *Marker {
   134		payload, err := os.ReadFile(filepath.Join(installedDir, Name)) // #nosec G304 -- path derives from the install root
   135		if err != nil {
   136			return nil
   137		}
   138		if err := protocoljson.Validate(payload); err != nil {
   139			return nil
   140		}
   141		var raw map[string]json.RawMessage
   142		if err := json.Unmarshal(payload, &raw); err != nil {
   143			return nil
   144		}
   145		var m Marker
   146		decoder := json.NewDecoder(bytes.NewReader(payload))
   147		decoder.DisallowUnknownFields()
   148		if err := decoder.Decode(&m); err != nil || !validMarker(&m, raw) {
   149			return nil
   150		}
   151		return &m
   152	}
