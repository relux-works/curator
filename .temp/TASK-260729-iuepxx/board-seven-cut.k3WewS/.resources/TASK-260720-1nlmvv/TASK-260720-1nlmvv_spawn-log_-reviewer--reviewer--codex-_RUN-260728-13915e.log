   476	// factsList projects a whole plan onto the presentation view.
   477	func factsList(builds []install.PlannedBuild) []buildFacts {
   478		facts := make([]buildFacts, 0, len(builds))
   479		for _, build := range builds {
   480			facts = append(facts, factsOf(build))
   481		}
   482		return facts
   483	}
   484	
   485	func repairNotices(alias string, builds []buildFacts, status string) []string {
   486		var notices []string
   487		for _, build := range builds {
   488			notice := ""
   489			switch {
   490			case build.Outcome == string(install.BuildWouldRebuildUntrustedCache) && status == "ok":
   491				notice = "rebuilt untrusted build cache state into a new protected entry; " +
   492					"the previous installation stayed in place until every gate, the private build, and the journaled commit succeeded"
   493			case build.Outcome == string(install.BuildWouldRebuildUntrustedCache):
   494				notice = "did not repair untrusted build cache state; " +
   495					"the previous installation, its consumers, and the live build cache are unchanged"
   496			case build.Outcome == string(install.BuildCorrupt), build.Outcome == string(install.BuildUnsupported):
   497				notice = fmt.Sprintf("refused %s build cache state before any mutation; "+
   498					"the previous installation, its consumers, and the live build cache are unchanged", build.Outcome)
   499			default:
   500				continue
   501			}
   502			notices = append(notices, fmt.Sprintf("%s: %s.%s: %s", alias, build.Skill, build.Command, notice))
   503		}
   504		return notices
   505	}
