   290	// classifyBuildCommand is the per-command decision procedure. It compares the
   291	// recorded portable identities with the derived ones first, so a wrong target
   292	// or toolchain is reported as exactly that rather than as a cache miss, and
   293	// only then interprets the read-only cache inspection.
   294	func classifyBuildCommand(recorded marker.Build, recordedSource *buildsource.Identity, planned buildFacts) (string, string) {
   295		if recorded.Driver != buildmeta.DriverGoV1 || planned.Driver != buildmeta.DriverGoV1 {
   296			return buildUnsupportedDriver, fmt.Sprintf(
   297				"recorded driver %q and planned driver %q must both be the closed %s driver",
   298				recorded.Driver, planned.Driver, buildmeta.DriverGoV1)
   299		}
   300		if recordedSource == nil {
   301			return stateInvalidMarker, "the install marker records a build without a build-source identity"
   302		}
   303		if *recordedSource != planned.Source {
   304			return buildSourceDrift, fmt.Sprintf(
   305				"recorded build source %s does not match the frozen snapshot identity %s",
   306				buildSourceText(*recordedSource), buildSourceText(planned.Source))
   307		}
   308		if recorded.CacheKey != planned.CacheKey {
   309			return buildTargetMismatch, fmt.Sprintf(
   310				"recorded logical key %s does not match the key derived for target %s and the current trusted toolchain",
   311				recorded.CacheKey, renderTarget(planned.Target))
   312		}
   313	
   314		switch install.BuildOutcome(planned.Outcome) {
   315		case install.BuildCacheHit:
   316			switch {
   317			case planned.ReceiptHash != recorded.ReceiptSHA256:
   318				return buildCorruptReceipt, fmt.Sprintf(
   319					"the protected entry carries receipt %s, but the install marker recorded %s",
   320					planned.ReceiptHash, recorded.ReceiptSHA256)
   321			case planned.Artifact.Path != recorded.ArtifactPath:
   322				return buildArtifactDrift, fmt.Sprintf(
   323					"the protected entry carries artifact path %q, but the install marker recorded %q",
   324					planned.Artifact.Path, recorded.ArtifactPath)
   325			case planned.Artifact.SHA256 != recorded.ArtifactSHA256:
   326				return buildArtifactDrift, fmt.Sprintf(
   327					"the protected artifact hashes to %s, but the install marker recorded %s",
   328					planned.Artifact.SHA256, recorded.ArtifactSHA256)
   329			}
   330			return buildCurrent, ""
   331		case install.BuildWouldPreflightAndBuild:
   332			return buildMissingArtifact, withReason(
   333				"the protected build cache holds no entry for the recorded logical key", planned.Reason)
   334		case install.BuildWouldRebuildUntrustedCache:
   335			return buildUntrustedCache, withReason(
   336				"candidate cache bytes are outside a provable manager-protected boundary", planned.Reason)
   337		case install.BuildCorrupt:
   338			return buildCorruptCache, withReason(
   339				"the protected cache entry cannot be interpreted", planned.Reason)
   340		case install.BuildUnsupported:
   341			return buildUnsupportedPlatform, withReason(
   342				"this host cannot prove manager-protected build cache state", planned.Reason)
   343		default:
   344			return buildUnknownState, withReason(
   345				fmt.Sprintf("planner outcome %q is not a known compiled state", planned.Outcome), planned.Reason)
   346		}
   347	}
