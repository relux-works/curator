    71	// stageBuilds builds every planned miss in operation-private staging, in the
    72	// plan's provider-first, command-lexical order.
    73	//
    74	// A cache hit performs no source-aware Go command. A failure at any point
    75	// returns an error without publishing anything, so closing the plan removes
    76	// the whole operation-private root, including outputs staged earlier in the
    77	// same pass, and leaves the installation and the live cache untouched.
    78	//
    79	// The pass ends by finalizing trust: the toolchain is re-fingerprinted through
    80	// the last build child and every frozen source is rechecked. A staged result is
    81	// therefore returned only when the identities the plan committed to still hold,
    82	// and that happens before the caller hands the result anywhere.
    83	func stageBuilds(ctx context.Context, plan BuildPlan, deps BuildDeps) (Staged, error) {
    84		staged := Staged{scope: plan.scope}
    85		if plan.Empty() {
    86			return staged, nil
    87		}
    88		if plan.session == nil {
    89			return staged, fmt.Errorf("staging requires a trusted Go session")
    90		}
    91		for _, build := range plan.builds {
    92			if build.outcome.blocking() {
    93				return Staged{}, fmt.Errorf("%s.%s is %s: %s", build.skill, build.command, build.outcome, build.reason)
    94			}
    95			if !build.outcome.buildable() {
    96				continue
    97			}
    98			source := plan.sources[build.skill]
    99			if source == nil {
   100				return Staged{}, fmt.Errorf("%s.%s: build source was not validated", build.skill, build.command)
   101			}
   102			artifact, err := deps.Builder.Stage(ctx, StageRequest{
   103				Session:       plan.session,
   104				Source:        source,
   105				CommandObject: build.commandObject,
   106				BuildRoot:     build.buildRoot,
   107				SourceDir:     build.sourceDir,
   108				Command:       build.command,
   109			})
   110			if err != nil {
   111				return Staged{}, fmt.Errorf("%s.%s: %w", build.skill, build.command, err)
   112			}
   113			receipt, err := buildmeta.NewReceipt(build.input, artifact.Metadata)
   114			if err != nil {
   115				return Staged{}, fmt.Errorf("%s.%s: %w", build.skill, build.command, err)
   116			}
   117			if receipt.CacheKey != build.key {
   118				return Staged{}, fmt.Errorf("%s.%s: staged receipt key %s does not match the planned key %s",
   119					build.skill, build.command, receipt.CacheKey, build.key)
   120			}
   121			staged.builds = append(staged.builds, StagedBuild{
   122				skill:    build.skill,
   123				command:  build.command,
   124				key:      build.key,
   125				path:     artifact.Path,
   126				receipt:  receipt,
   127				artifact: artifact.Metadata,
   128			})
   129		}
   130		if err := plan.Verify(ctx); err != nil {
   131			return Staged{}, err
   132		}
   133		return staged, nil
   134	}
