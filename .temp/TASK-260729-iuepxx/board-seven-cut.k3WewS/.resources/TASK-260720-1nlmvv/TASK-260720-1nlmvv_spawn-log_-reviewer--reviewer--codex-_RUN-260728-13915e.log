    97	// checkFailed is the `status --check` verdict of one scope. It fails closed:
    98	// only an exactly current skill set and an exactly current compiled command set
    99	// exit zero. Compiled commands are consulted separately from the declared-skill
   100	// map because a build can belong to a transitively resolved node that no
   101	// project declaration names.
   102	func checkFailed(drift map[string]string, builds []buildReport) bool {
   103		for _, state := range drift {
   104			if !currentCode(state) {
   105				return true
   106			}
   107		}
   108		for _, build := range builds {
   109			if !currentCode(build.State) {
   110				return true
   111			}
   112		}
   113		return false
   114	}
