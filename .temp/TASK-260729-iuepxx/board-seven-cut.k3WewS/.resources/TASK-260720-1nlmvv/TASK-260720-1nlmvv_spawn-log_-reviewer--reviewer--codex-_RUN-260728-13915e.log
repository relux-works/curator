   154	func validMarker(m *Marker, raw map[string]json.RawMessage) bool {
   155		commonRequired := []string{
   156			"schema_version", "name", "source", "ref_kind", "ref", "commit", "content_sha256", "locale",
   157			"agents", "commands", "dependencies", "skill_schema_version", "runtime_roots", "installed_at", "files",
   158		}
   159		commonOptional := []string{
   160			"git", "requirements", "mcp_servers", "attestation", "activation", "requirers", "substituted",
   161		}
   162		required := append([]string(nil), commonRequired...)
   163		allowed := append(append([]string(nil), commonRequired...), commonOptional...)
   164		switch m.SchemaVersion {
   165		case LegacySchemaVersion:
   166		case SchemaVersion:
   167			required = append(required, "build_roots", "builds")
   168			allowed = append(allowed, "build_roots", "build_source", "builds")
   169		default:
   170			return false
   171		}
   172		for _, field := range required {
   173			if _, present := raw[field]; !present {
   174				return false
   175			}
   176		}
   177		if !onlyFields(raw, allowed) || !identifiers.Valid(m.Name) || !identifiers.PortablePath(m.Source) ||
   178			(m.RefKind != "tag" && m.RefKind != "branch" && m.RefKind != "revision") ||
   179			m.Ref == "" || utf8.RuneCountInString(m.Ref) > 8192 || !markerCommitRE.MatchString(m.Commit) ||
   180			!markerSHA256RE.MatchString(m.ContentSHA256) || m.SkillSchemaVersion < 0 ||
   181			(m.SchemaVersion == LegacySchemaVersion && m.SkillSchemaVersion > 5) ||
   182			(m.SchemaVersion == SchemaVersion && m.SkillSchemaVersion > 6) {
   183			return false
   184		}
   185		setsSorted := m.SchemaVersion == SchemaVersion
   230			}
