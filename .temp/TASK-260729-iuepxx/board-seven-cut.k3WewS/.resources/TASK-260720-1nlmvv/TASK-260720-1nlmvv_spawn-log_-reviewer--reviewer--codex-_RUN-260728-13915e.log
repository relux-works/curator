    91	// currentCode reports whether a code means "exactly current". Everything else
    92	// — invalid, unsupported, missing, corrupt, drifted, or unknown — is drift.
    93	func currentCode(code string) bool {
    94		return code == stateUpToDate || code == buildCurrent
    95	}
