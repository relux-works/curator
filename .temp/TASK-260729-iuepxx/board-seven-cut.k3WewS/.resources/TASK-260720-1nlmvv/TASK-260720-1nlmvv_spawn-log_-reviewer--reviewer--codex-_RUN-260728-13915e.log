   282	
   283	// planBuilds derives the immutable build plan after every manifest, closure,
   284	// collision, requirement, audit, registry, and moved-tag gate has passed.
   285	//
   286	// Planning is read-only: it validates frozen sources, resolves the trusted
   287	// toolchain identity (a probe on a dry run), and inspects protected cache
   288	// state. It never runs go list or go build and never writes persistent state.
   289	// The plan is returned even on failure so the caller can report every outcome
   290	// it managed to derive.
   291	func planBuilds(ctx context.Context, request buildPlanRequest) (BuildPlan, error) {
   292		plan := BuildPlan{scope: request.scope}
   293		planned := plannedCommands(request.nodes)
   294		if len(planned) == 0 {
   295			return plan, nil
   296		}
   297	
   298		plan.sources = map[string]*buildsource.Token{}
   299		for _, node := range buildNodes(request.nodes) {
   300			token, err := buildsource.Validate(node.Snapshot)
   301			if err != nil {
   302				return plan, fmt.Errorf("%s: %w", node.Name, err)
   303			}
   304			plan.sources[node.Name] = token
   305		}
   306	
   307		var target buildmeta.Target
   308		var toolchain buildmeta.Toolchain
   309		if request.dryRun {
   310			probedTarget, probedToolchain, err := request.deps.Toolchain.Probe(ctx)
   311			if err != nil {
   312				return plan, err
   313			}
   314			target, toolchain = probedTarget, probedToolchain
   315		} else {
   316			session, err := request.deps.Toolchain.Establish(ctx)
   317			if err != nil {
   318				return plan, err
   319			}
   320			plan.session = session
   321			target, toolchain = session.Target(), session.Toolchain()
   322		}
