   460	// printRepairNotices reports what a real installation did with compiled state
   461	// it was not allowed to reuse.
   462	//
   463	// Curator has no separate repair command: install and upgrade are the
   464	// reconciliation path. They rebuild a missing, corrupt, wrong-target, or
   465	// untrusted entry into new protected state after every declaration, closure,
   466	// collision, audit, registry, and moved-tag gate has already passed, and they
   467	// never adopt candidate bytes by changing permissions or rewriting a marker.
   468	// These notices state which of the two happened, so an operator can see that a
   469	// failed run left the previous installation in place.
   470	func printRepairNotices(result install.Result) {
   471		for _, notice := range repairNotices(result.Alias, factsList(result.Builds), result.Status) {
   472			fmt.Println(notice)
   473		}
   474	}
