+	}
+}
+
+func validGoBuildInputV1() map[string]any {
+	return map[string]any{
+		"schema_version": 1,
+		"driver":         "go-v1",
+		"build_source":   validBuildSourceIdentity(),
+		"build_root":     "build",
+		"command":        "golden-tool",
+		"source_dir":     "build/cmd/golden-tool",
+		"target": map[string]any{
