    54	// CachePublisher publishes verified private builds into the protected
    55	// immutable build cache and re-reads the result. It never adopts or repairs
    56	// foreign bytes.
    57	//
    58	// Publication and verification are deliberately the same boundary. The planning
    59	// inspector runs before the home lock against whatever the cache looked like
    60	// then; only the store that just published can say whether the entry a launcher
    61	// is about to point at is protected right now.
    62	type CachePublisher interface {
    63		Inspect(expect buildcache.Expectation) buildcache.Result
    64		Publish(publication buildcache.Publication, lock buildcache.HomeLock) (buildcache.PublicationResult, error)
    65	}
