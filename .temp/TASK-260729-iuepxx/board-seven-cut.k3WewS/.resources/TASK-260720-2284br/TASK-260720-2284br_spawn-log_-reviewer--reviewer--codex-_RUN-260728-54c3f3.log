    56	
    57	// ParseBytes parses one substitution payload that a caller already read. It is
    58	// the byte-level entry point Load itself is built from, so a caller that has to
    59	// bind a generation digest to the exact bytes its closure was resolved from can
    60	// read the file once and parse those bytes. The project root stays a parameter
    61	// because a relative substitution path resolves against it.
    62	func ParseBytes(payload []byte, projectRoot string) (map[string]Substitution, error) {
    63		filePath := PathIn(projectRoot)
    64		if err := protocoljson.Validate(payload); err != nil {
    65			return nil, fmt.Errorf("malformed JSON in %s: %w", filePath, err)
    66		}
    67		var raw any
    68		if err := json.Unmarshal(payload, &raw); err != nil {
    69			return nil, fmt.Errorf("malformed JSON in %s: %w", filePath, err)
    70		}
    71		obj, ok := raw.(map[string]any)
    72		if !ok {
    73			return nil, fmt.Errorf("%s must contain a JSON object", filePath)
    74		}
    75		for key := range obj {
    76			if key != "substitutions" {
    77				return nil, verr.New(Name, "has unsupported field(s): %s", key)
    78			}
    79		}
    80		rawSubs, present := obj["substitutions"]
    81		if !present {
    82			return map[string]Substitution{}, nil
    83		}
    84		subsObj, ok := rawSubs.(map[string]any)
    85		if !ok {
    86			return nil, verr.New("substitutions", "must be an object")
    87		}
    88	
    89		substitutions := map[string]Substitution{}
    90		for name, rawEntry := range subsObj {
    91			label := "substitutions." + name
    92			if name == "" {
    93				return nil, verr.New("substitutions", "substitution names must be non-empty strings")
    94			}
    95			if !identifiers.Valid(name) {
    96				return nil, verr.New(label, "substitution name %s", identifiers.Rule)
    97			}
    98			entry, ok := rawEntry.(map[string]any)
    99			if !ok {
   100				return nil, verr.New(label, "must be an object")
   101			}
   102			for key := range entry {
   103				if key != "path" && key != "git" && key != "ref" {
   104					return nil, verr.New(label, "has unsupported field(s): %s", key)
   105				}
   106			}
   107			_, hasPath := entry["path"]
   108			_, hasGit := entry["git"]
   109			if hasPath == hasGit {
   110				return nil, verr.New(label, "must declare exactly one of 'path' or 'git'")
   111			}
   112	
   113			if hasPath {
   114				text, ok := entry["path"].(string)
   115				if !ok || text == "" {
   116					return nil, verr.New(label+".path", "must be a non-empty string")
   117				}
   118				if _, hasRef := entry["ref"]; hasRef {
   119					return nil, verr.New(label, "with 'path' reads the local checkout; 'ref' does not apply")
   120				}
   121				resolved := text
   122				if !filepath.IsAbs(resolved) {
   123					resolved = filepath.Join(projectRoot, resolved)
   124				}
   125				substitutions[name] = Substitution{SkillName: name, Path: resolved}
