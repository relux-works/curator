   163	// readHybridDocument reads and parses the machine-home hybrid activation
   164	// manifest and returns the generation of the exact bytes it parsed. An absent
   165	// file yields no declarations, matching scopes.LoadHybridDecls.
   166	func readHybridDocument(home string) ([]scopes.HybridDecl, string, error) {
   167		path := scopes.HybridManifestPath(home)
   168		current, err := readDocument(path)
   169		if err != nil {
   170			return nil, "", err
   171		}
   172		if !current.exists {
   173			return nil, current.generation, nil
   174		}
   175		parsed, err := scopes.ParseHybridDecls(current.payload, path)
   176		if err != nil {
   177			return nil, "", err
   178		}
   179		return parsed, current.generation, nil
   180	}
