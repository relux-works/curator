   315		// entries maps a canonical shared-state key to the generation observed for
   316		// it, the path that revalidates it, and the reader that produced it. One
   317		// record holds all three, so an observation cannot exist without the location
   318		// and the reader its recheck needs.
   319		entries map[string]observation
   320		// outcomes maps one planned build to the protected-cache verdict planning
   321		// took for it.
   322		outcomes map[string]BuildOutcome
   323	}
   324	
   325	// observation is one optimistic generation and everything needed to revalidate
   326	// it under the home lock.
   327	type observation struct {
   328		// generation is what the reader below saw when the input was consulted.
   329		generation string
   330		// path is the location to re-read under the home lock.
   331		path string
   332		// bytesBound marks a declaration document, whose generation covers the exact
   333		// bytes a parser consumed rather than whatever the path held at some separate
   334		// moment. It selects the recheck reader too: an observation must always be
   335		// rechecked by the reader that recorded it, or two readers that disagree
   336		// about a path would restart every attempt forever.
   337		bytesBound bool
   338	}
   339	
   340	// current returns the generation of this observation's path now, read by the
   341	// same reader that recorded it.
   342	func (entry observation) current() string {
   343		if entry.bytesBound {
   344			return documentGeneration(entry.path)
   345		}
   346		digest, err := transaction.DigestPath(entry.path)
   347		if err != nil {
   348			// An unreadable or unsafe preimage is itself a stable observation: the
   349			// recheck reproduces the same marker and only a change restarts.
   350			return "unreadable:" + err.Error()
   351		}
   352		return digest
   353	}
   354	
   355	func newObservations() *observations {
   356		return &observations{
   357			entries:  map[string]observation{},
   358			outcomes: map[string]BuildOutcome{},
   359		}
   360	}
   361	
   362	// observe records the current digest of one consulted shared path. It is for
   363	// state whose *path* is the observation — an installed marker — and deliberately
   364	// cannot take a documentKey: a declaration document read separately from its
   365	// digest is the ABA defect this contract exists to prevent.
   366	func (observed *observations) observe(key, path string) {
   367		if observed == nil {
   368			return
   369		}
   370		entry := observation{path: path}
   371		entry.generation = entry.current()
   372		observed.entries[key] = entry
   373	}
   374	
   375	// observeDocument records one declaration document at the generation of the
   376	// exact bytes its parser consumed, as returned by the single read in
   377	// readDocument. The caller passes that generation rather than a path, so no
   378	// second read can slip between the bytes the closure was built from and the
   379	// generation this run revalidates.
   380	func (observed *observations) observeDocument(key documentKey, path, generation string) {
   381		if observed == nil {
   382			return
   383		}
   384		observed.entries[string(key)] = observation{generation: generation, path: path, bytesBound: true}
   385	}
   386	
   387	// recheck re-reads every observation and reports the earliest affected step.
   388	func (observed *observations) recheck(plan BuildPlan, inspect CacheInspector) *restartError {
   389		if observed == nil {
   390			return nil
   391		}
   392		step := restartNone
   393		var reasons []string
   394		keys := make([]string, 0, len(observed.entries))
   395		for key := range observed.entries {
   396			keys = append(keys, key)
   397		}
   398		sort.Strings(keys)
   399		for _, key := range keys {
   400			entry := observed.entries[key]
   401			if entry.current() != entry.generation {
   402				step = maxRestart(step, restartClosure)
   403				reasons = append(reasons, fmt.Sprintf("generation of %s changed", key))
   404			}
   405		}
   406		for _, build := range plan.builds {
   407			recorded, seen := observed.outcomes[build.skill+"."+build.command]
   408			if !seen {
   409				continue
   410			}
   411			current := BuildOutcome(inspect.Inspect(buildcache.Expectation{Input: build.input}).DryRunOutcome())
   412			// A miss that became a hit is another publisher's identical winner and
   413			// is safe to adopt. Any other transition invalidates the planned reuse.
   414			if current == recorded || (recorded.buildable() && current == BuildCacheHit) {
   415				continue
   416			}
   417			step = maxRestart(step, restartPlan)
   418			reasons = append(reasons, fmt.Sprintf("cache trust for %s.%s changed from %s to %s",
   419				build.skill, build.command, recorded, current))
   420		}
   421		if step == restartNone {
   422			return nil
   423		}
   424		return &restartError{step: step, reasons: reasons}
   425	}
   426	
   427	func maxRestart(left, right restartStep) restartStep {
   428		if right > left {
   429			return right
   430		}
   431		return left
   432	}
