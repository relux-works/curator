   150		if err != nil {
   151			return nil, "", err
   152		}
   153		if !current.exists {
   154			return map[string]devsub.Substitution{}, current.generation, nil
   155		}
   156		parsed, err := devsub.ParseBytes(current.payload, projectRoot)
   157		if err != nil {
   158			return nil, "", err
   159		}
   160		return parsed, current.generation, nil
   161	}
