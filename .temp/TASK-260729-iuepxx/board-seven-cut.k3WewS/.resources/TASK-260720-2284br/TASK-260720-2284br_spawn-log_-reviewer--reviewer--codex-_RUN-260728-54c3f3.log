   119	// TestDeclarationGenerationIsContentAddressed is the property the ABA cases
   120	// depend on: a generation identifies bytes, so a byte-identical restoration is
   121	// indistinguishable from never having changed, and only binding the generation to
   122	// the parsed bytes can catch a transient generation in between.
   123	func TestDeclarationGenerationIsContentAddressed(t *testing.T) {
   124		path := filepath.Join(t.TempDir(), "Skillfile.json")
   125		if absent := documentGeneration(path); absent != documentAbsent {
   126			t.Fatalf("an absent document must be explicit: %s", absent)
   127		}
   128	
   129		writeDocument(t, path, `{"generation": "A"}`)
   130		settled := documentGeneration(path)
   131		if settled == documentAbsent {
   132			t.Fatal("a present document must not read as absent")
   133		}
   134	
   135		writeDocument(t, path, `{"generation": "B"}`)
   136		if changed := documentGeneration(path); changed == settled {
   137			t.Fatal("different bytes must produce different generations")
   138		}
   139	
   140		writeDocument(t, path, `{"generation": "A"}`)
   141		if restored := documentGeneration(path); restored != settled {
   142			t.Fatal("byte-identical content must produce the same generation")
   143		}
   144	
   145		if err := os.Chmod(path, 0o600); err != nil {
   146			t.Fatal(err)
   147		}
   148		if rechecked := documentGeneration(path); rechecked != settled {
   149			t.Fatal("a mode change selects nothing installed and must not restart a run")
   150		}
   151	}
   152	
   153	// TestDocumentGenerationIsStableWhenUnreadable keeps the recheck honest about
   154	// state it cannot read: it has to reproduce the same marker rather than restart
   155	// forever or, worse, compare unequal markers and give up after MaxRestarts.
   156	func TestDocumentGenerationIsStableWhenUnreadable(t *testing.T) {
   157		path := filepath.Join(t.TempDir(), "Skillfile.json")
   158		if err := os.Mkdir(path, 0o755); err != nil {
   159			t.Fatal(err)
   160		}
   161		first := documentGeneration(path)
   162		if first == documentAbsent {
   163			t.Fatal("a directory in place of a document is not absence")
   164		}
   165		if second := documentGeneration(path); second != first {
   166			t.Fatalf("an unreadable document must observe stably: %s then %s", first, second)
   167		}
   168	}
   169	
   170	// TestObservationsRecheckDocumentsAgainstTheParsedBytes drives the recheck
   171	// directly: an observation recorded from a transient generation must report a
   172	// change once the file settles back, which is the ABA restart the install cases
   173	// below rely on. A marker observation keeps its path-digest reader.
   174	func TestObservationsRecheckDocumentsAgainstTheParsedBytes(t *testing.T) {
   175		dir := t.TempDir()
   176		path := filepath.Join(dir, "Skillfile.json")
   177		writeDocument(t, path, `{"generation": "A"}`)
   178		transient := generationOfBytes(t, []byte(`{"generation": "B"}`))
   179	
   180		observed := newObservations()
   181		observed.observeDocument(projectManifestKey, path, transient)
   182		if restart := observed.recheck(BuildPlan{}, nil); restart == nil {
   183			t.Fatal("a generation the file never settled at must restart closure resolution")
   184		}
   185	
   186		observed = newObservations()
   187		settled, err := readDocument(path)
   188		if err != nil {
   189			t.Fatal(err)
   190		}
   191		observed.observeDocument(projectManifestKey, path, settled.generation)
   192		marker := filepath.Join(dir, "marker.json")
   193		writeDocument(t, marker, "{}")
   194		observed.observe("marker/project/skill-a", marker)
   195		if restart := observed.recheck(BuildPlan{}, nil); restart != nil {
   196			t.Fatalf("unchanged state must not restart: %v", restart)
   197		}
   198	
   199		writeDocument(t, marker, `{"changed": true}`)
   200		if restart := observed.recheck(BuildPlan{}, nil); restart == nil {
   201			t.Fatal("a changed marker must still restart through its path digest")
   202		}
   203	}

