    79		if err := json.Unmarshal(payload, &raw); err != nil {
    80			return nil, fmt.Errorf("malformed JSON in %s: %w", filePath, err)
    81		}
    82		obj, ok := raw.(map[string]any)
    83		if !ok {
    84			return nil, fmt.Errorf("%s must contain a JSON object", filePath)
    85		}
    86		return Parse(obj, filePath)
    87	}
