     8	
     9	// A declaration observation is sound only if its generation belongs to the bytes
    10	// the parser consumed. These cases lock that binding at the read itself, so a
    11	// future refactor cannot go back to digesting the path as a second operation and
    12	// reopen the A -> B -> A window (see generation.go).
    13	
    14	// writeDocument writes one declaration payload the way every supported manifest
    15	// writer does: os.WriteFile, in place, on the inode the path already names.
    16	func writeDocument(t *testing.T, path, payload string) {
    17		t.Helper()
    18		if err := os.WriteFile(path, []byte(payload), 0o644); err != nil {
    19			t.Fatal(err)
    20		}
    21	}
    22	
    23	// generationOfBytes reports the generation the manager would record for payload,
    24	// derived from a separate file that holds exactly those bytes. It never calls the
    25	// digest helper under test directly, so an assertion against it cannot pass by
    26	// agreeing with itself.
    27	func generationOfBytes(t *testing.T, payload []byte) string {
    28		t.Helper()
    29		path := filepath.Join(t.TempDir(), "reference.json")
    30		if err := os.WriteFile(path, payload, 0o644); err != nil {
    31			t.Fatal(err)
    32		}
    33		reference, err := readDocument(path)
    34		if err != nil {
    35			t.Fatal(err)
    36		}
    37		return reference.generation
    38	}
    39	
    40	// onceAfterOpen installs a one-shot read-window hook and proves it fired.
    41	func onceAfterOpen(t *testing.T, target string, change func()) {
    42		t.Helper()
    43		fired := false
    44		afterDocumentOpen = func(path string) {
    45			if fired || path != target {
    46				return
    47			}
    48			fired = true
    49			change()
    50		}
    51		t.Cleanup(func() {
    52			afterDocumentOpen = nil
    53			if !fired {
    54				t.Fatalf("the read window never opened for %s", target)
    55			}
    56		})
    57	}
    58	
    59	// TestReadDocumentBindsGenerationToBytesRewrittenInPlace covers the writer shape
    60	// Curator actually ships: os.WriteFile truncates and rewrites the inode the
    61	// reader already holds open, so the read consumes the *new* bytes. The recorded
    62	// generation has to be the generation of those bytes and not of whatever the path
    63	// held when the read started.
    64	func TestReadDocumentBindsGenerationToBytesRewrittenInPlace(t *testing.T) {
    65		path := filepath.Join(t.TempDir(), "Skillfile.json")
    66		writeDocument(t, path, `{"generation": "A"}`)
    67		transient := `{"generation": "B", "padding": "wider than A"}`
    68		onceAfterOpen(t, path, func() { writeDocument(t, path, transient) })
    69	
    70		parsed, err := readDocument(path)
    71		if err != nil {
    72			t.Fatal(err)
    73		}
    74		if string(parsed.payload) != transient {
    75			t.Fatalf("the read did not consume the in-place rewrite, so this case proves nothing: %q", parsed.payload)
    76		}
    77		if want := generationOfBytes(t, parsed.payload); parsed.generation != want {
    78			t.Fatalf("the generation does not belong to the bytes the parser gets: got %s, bytes are %s",
    79				parsed.generation, want)
    80		}
    81	}
    82	
    83	// TestReadDocumentBindsGenerationToBytesReplacedByRename covers the other writer
    84	// shape: an atomic rename leaves the open handle on the old inode, so the read
    85	// consumes the *previous* bytes while the path already holds the new ones. The
    86	// generation must follow the bytes that were returned, which is exactly what a
    87	// path digest taken around the read cannot do — and the mismatch it leaves is
    88	// what makes the under-lock recheck restart.
    89	func TestReadDocumentBindsGenerationToBytesReplacedByRename(t *testing.T) {
    90		dir := t.TempDir()
    91		path := filepath.Join(dir, "Skillfile.json")
    92		settled := `{"generation": "A"}`
    93		writeDocument(t, path, settled)
    94		replacement := `{"generation": "B"}`
    95		onceAfterOpen(t, path, func() {
    96			staged := filepath.Join(dir, "staged.json")
    97			writeDocument(t, staged, replacement)
    98			if err := os.Rename(staged, path); err != nil {
    99				t.Fatal(err)
   100			}
   101		})
   102	
   103		parsed, err := readDocument(path)
   104		if err != nil {
   105			t.Fatal(err)
   106		}
   107		if string(parsed.payload) != settled {
   108			t.Fatalf("the rename should have left the read on the old inode: %q", parsed.payload)
   109		}
   110		if want := generationOfBytes(t, parsed.payload); parsed.generation != want {
   111			t.Fatalf("the generation does not belong to the bytes the parser gets: got %s, bytes are %s",
   112				parsed.generation, want)
   113		}
   114		if current := documentGeneration(path); current == parsed.generation {
   115			t.Fatal("the recheck cannot see the replacement, so a stale closure would commit")
   116		}
   117	}
