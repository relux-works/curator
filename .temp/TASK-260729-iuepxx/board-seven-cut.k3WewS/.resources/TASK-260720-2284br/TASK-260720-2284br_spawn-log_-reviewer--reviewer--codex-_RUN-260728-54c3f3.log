    69	// ParseBytes parses one manifest payload that a caller already read. It is the
    70	// byte-level entry point Load itself is built from, so a caller that has to bind
    71	// a generation digest to the exact bytes its closure was resolved from can read
    72	// the file once and parse those bytes, instead of reading the path a second time
    73	// and parsing a possibly different generation.
    74	func ParseBytes(payload []byte, filePath string) (*Manifest, error) {
    75		if err := protocoljson.Validate(payload); err != nil {
    76			return nil, fmt.Errorf("malformed JSON in %s: %w", filePath, err)
    77		}
