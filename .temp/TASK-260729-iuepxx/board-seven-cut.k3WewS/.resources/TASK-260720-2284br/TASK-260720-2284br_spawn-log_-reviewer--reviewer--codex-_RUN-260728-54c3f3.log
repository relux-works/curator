    70	// readDocument reads one declaration document exactly once and returns its bytes
    71	// with the generation of those bytes.
    72	func readDocument(path string) (result document, err error) {
    73		file, err := os.Open(path) // #nosec G304 -- a manifest path derived from the project root or the manager home
    74		if os.IsNotExist(err) {
    75			return document{generation: documentAbsent}, nil
    76		}
    77		if err != nil {
    78			return document{}, err
    79		}
    80		defer func() { err = errors.Join(err, file.Close()) }()
    81		if afterDocumentOpen != nil {
    82			afterDocumentOpen(path)
    83		}
    84		info, err := file.Stat()
    85		if err != nil {
    86			return document{}, err
    87		}
    88		if !info.Mode().IsRegular() {
    89			return document{}, fmt.Errorf("%s is not a regular file", path)
    90		}
    91		payload, err := io.ReadAll(file)
    92		if err != nil {
    93			return document{}, err
    94		}
    95		return document{payload: payload, exists: true, generation: digestDeclaration(payload)}, nil
