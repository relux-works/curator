   169	// Close releases the frozen snapshots and the operation-private toolchain
   170	// session, deleting every staged output that session owns.
   171	func (plan BuildPlan) Close() error {
   172		var errs []error
   173		if plan.session != nil {
   174			errs = append(errs, plan.session.Close())
   175		}
   176		names := make([]string, 0, len(plan.sources))
   177		for name := range plan.sources {
   178			names = append(names, name)
   179		}
   180		sort.Strings(names)
   181		for _, name := range names {
   182			errs = append(errs, plan.sources[name].Close())
   183		}
   184		return errors.Join(errs...)
   185	}
