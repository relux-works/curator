    92	// Project installs one project per Spec §8.1.
    93	func Project(cfg *config.Config, projectRoot, alias string, opts Options) (result Result) {
    94		result = Result{Alias: alias, Path: projectRoot, Status: "ok"}
    95		platform := opts.Platform
    96		if platform == "" {
    97			platform = runtimestore.Platform()
    98		}
    99	
   100		// 1. Load the manifest; absent means skipped.
   101		projectManifest, err := manifest.Load(projectRoot)
   102		if err != nil {
   103			result.failf("%v", err)
   104			return result
   105		}
   106		if projectManifest == nil {
   107			result.Status = "skipped"
   108			result.Messages = append(result.Messages, alias+": Skillfile.json not found; skipped")
   109			return result
   110		}
   111	
   112		// 2. Effective agents.
   113		agents := projectManifest.Agents
   114		if len(agents) == 0 {
   115			if project, known := cfg.Projects[alias]; known && len(project.Agents) > 0 {
   116				agents = project.Agents
   117			} else {
   118				agents = cfg.DefaultAgents
   119			}
   120		}
   121		if unknown := adapters.UnknownAgents(agents); len(unknown) > 0 {
   122			result.Messages = append(result.Messages, fmt.Sprintf(
   123				"%s: warning: unknown agent(s) ignored: %s", alias, strings.Join(unknown, ", ")))
   124		}
   125	
   126		// 3. Managed .gitignore gate.
   127		required := adapters.RequiredGitignoreEntries(agents)
   128		if err := gitignore.Ensure(projectRoot, required, opts.FixGitignore && !opts.DryRun); err != nil {
   129			result.Status = "skipped"
   130			result.Messages = append(result.Messages, fmt.Sprintf("%s: %v; skipped", alias, err))
   131			return result
   132		}
   133	
   134		// 4. Dev substitutions.
   135		substitutions, err := devsub.Load(projectRoot)
   136		if err != nil {
   137			result.failf("%v", err)
   138			return result
   139		}
   140		if len(substitutions) > 0 {
   141			if cfg.Audit.Enabled && cfg.Audit.Mode == "strict" {
   142				result.failf("dev substitutions are active in %s; strict audit refuses substituted installs", devsub.Name)
   143				return result
   144			}
   145			if err := gitignore.Ensure(projectRoot, []string{devsub.Name}, opts.FixGitignore && !opts.DryRun); err != nil {
   146				result.Status = "skipped"
   147				result.Messages = append(result.Messages, fmt.Sprintf("%s: %v; skipped", alias, err))
   148				return result
   149			}
   150			var names []string
   151			for name := range substitutions {
   152				names = append(names, name)
   153			}
   154			sort.Strings(names)
   155			for _, name := range names {
   156				result.Messages = append(result.Messages, fmt.Sprintf(
   157					"%s: SUBSTITUTION %s -> %s", alias, name, substitutions[name].Describe()))
   158			}
   159		}
   160	
   161		// 5. Hybrid scope: applicable machine-level declarations join the
   162		// manifest; a project declaration of the same name shadows the hybrid
   163		// entry (Spec §9.3).
   164		hybridDecls, err := scopes.LoadHybridDecls(cfg.Home())
   165		if err != nil {
   166			result.failf("%v", err)
   167			return result
   168		}
   169		projectDeclared := map[string]bool{}
   170		for _, decl := range projectManifest.Skills {
   171			projectDeclared[decl.Name] = true
   172		}
   173		aliases := []string{alias}
   174		if project, known := cfg.Projects[alias]; known {
   175			aliases = append(aliases, project.ProjectAlias)
   176		}
   177		if projectManifest.ProjectAlias != "" {
   178			aliases = append(aliases, projectManifest.ProjectAlias)
   179		}
   180		var hybridDirect []manifest.Decl
   181		for _, hd := range hybridDecls {
   182			if !scopes.AppliesToProject(hd, aliases, projectRoot) {
   183				continue
   184			}
   185			if projectDeclared[hd.Decl.Name] {
   186				result.Messages = append(result.Messages, fmt.Sprintf(
   187					"%s: hybrid skill %s is shadowed by the project declaration", alias, hd.Decl.Name))
   188				continue
   189			}
   190			hybridDirect = append(hybridDirect, hd.Decl)
   191		}
   192		effectiveManifest := projectManifest
   193		if len(hybridDirect) > 0 {
   194			merged := *projectManifest
   195			merged.Skills = append(append([]manifest.Decl{}, projectManifest.Skills...), hybridDirect...)
   196			effectiveManifest = &merged
   197		}
   198	
   199		// 6. Effective locale.
   200		effectiveLocale := projectManifest.Locale
   201		if effectiveLocale == "" {
   202			effectiveLocale = cfg.PreferredLocale
   203		}
   204	
   205		// 7. Closure resolution.
   206		scratchRoot := ""
   207		if opts.DryRun {
   208			scratchRoot, err = os.MkdirTemp("", "curator-dry-run-")
   209			if err != nil {
   210				result.failf("could not create temporary dry-run workspace: %v", err)
   211				return result
   212			}
   213			defer func() { _ = os.RemoveAll(scratchRoot) }()
   214		}
   215		if opts.FetchedRepos == nil {
   216			opts.FetchedRepos = map[string]bool{}
   217		}
   218		fetchedBefore := copySet(opts.FetchedRepos)
   219		nodes, err := closure.Build(closure.Options{
   220			SkillsRoot:     cfg.SkillsRoot,
   221			Home:           cfg.Home(),
   222			AllowedSources: cfg.AllowedSources,
   223			FetchExisting:  opts.Fetch && !opts.DryRun,
   224			FetchedRepos:   opts.FetchedRepos,
   225			ScratchRoot:    scratchRoot,
   226		}, effectiveManifest, substitutions)
   227		if err != nil {
   228			result.failf("%v", err)
   229			return result
   230		}
   231		for _, repo := range newSetEntries(fetchedBefore, opts.FetchedRepos) {
   232			result.Messages = append(result.Messages, fmt.Sprintf("%s: fetched %s", alias, filepath.Base(repo)))
   233		}
   234	
   235		// 8. Validate every node with the same rules as `skill check`. Manifest
   236		// parsing alone is insufficient because runtime-only nodes still require
   237		// SKILL.md and must pass locale consistency checks (Spec §4, §8.1).
   238		if !validateNodes(nodes, effectiveLocale, alias, &result) {
   239			return result
   240		}
   241	
   242		// 9. Active command collisions.
   243		if err := closure.DetectActiveCommandCollisions(nodes); err != nil {
   244			result.failf("%v", err)
   245			return result
   246		}
   247	
   248		// 10. Declared dependency checks.
   249		if err := checkSystemCommands(nodes); err != nil {
   250			result.failf("%v", err)
   251			return result
   252		}
   253		if err := checkLegacySkillDependencies(nodes); err != nil {
   254			result.failf("%v", err)
   255			return result
   256		}
   257	
   258		// 11. MCP verification (Spec §11); Options.VerifyMcp overrides for tests.
   259		verifyMcp := opts.VerifyMcp
   260		if verifyMcp == nil {
   261			verifyMcp = func(nodes []*closure.Node) (map[string]map[string][]string, []string, error) {
   262				userHome, err := os.UserHomeDir()
   263				if err != nil {
   264					userHome = ""
   265				}
   266				requirements := map[string]map[string]skillspec.McpServer{}
   267				for _, node := range nodes {
   268					if len(node.Spec.McpServers) > 0 {
   269						requirements[node.Name] = node.Spec.McpServers
   270					}
   271				}
   272				findings, warnings, err := mcp.Verify(mcp.Env{ProjectRoot: projectRoot, UserHome: userHome}, agents, requirements)
   273				found := map[string]map[string][]string{}
   274				for name, finding := range findings {
   275					found[name] = finding.FoundIn
   276				}
   277				prefixed := make([]string, 0, len(warnings))
   278				for _, warning := range warnings {
   279					prefixed = append(prefixed, alias+": "+warning)
   280				}
   281				return found, prefixed, err
   282			}
   283		}
   284		mcpFound, mcpWarnings, mcpErr := verifyMcp(nodes)
   285		result.Messages = append(result.Messages, mcpWarnings...)
   286		if mcpErr != nil {
   287			result.failf("%v", mcpErr)
   288			return result
   289		}
   290	
   291		// 12. Migration warnings.
   292		for _, node := range nodes {
   293			for _, dependency := range node.Spec.Dependencies {
   294				if dependency.Type == "skill" {
   295					result.Messages = append(result.Messages, fmt.Sprintf(
   296						"%s: %s uses dependencies.commands with type 'skill'; migrate to agent-skill.json schema v4 dependencies.skills",
   297						alias, node.Name))
   298					break
   299				}
   300			}
   301		}
   302	
   303		// 13. Audit gate (Spec §12); Options.AuditGate overrides for tests.
   304		auditGate := opts.AuditGate
   305		if auditGate == nil {
   306			auditGate = func(nodes []*closure.Node) ([]string, []string) {
   307				subjects := make([]audit.Subject, 0, len(nodes))
   308				for _, node := range nodes {
   309					subjects = append(subjects, audit.Subject{
   310						Name: node.Name, Source: node.Decl.Source, Git: node.Decl.Git,
   311						Commit: node.Resolved.Commit, Snapshot: node.Snapshot,
   312						SchemaVersion: node.Spec.SchemaVersion, Capabilities: node.Spec.Capabilities,
   313					})
   314				}
   315				var warnings, errs []string
   316				if opts.DryRun {
   317					warnings, errs = audit.GateReadOnly(cfg, subjects)
   318				} else {
   319					warnings, errs = audit.Gate(cfg, subjects)
   320				}
   321				prefixed := make([]string, 0, len(warnings))
   322				for _, warning := range warnings {
   323					prefixed = append(prefixed, alias+": "+warning)
   324				}
   325				return prefixed, errs
   326			}
   327		}
   328		auditWarnings, auditErrs := auditGate(nodes)
   329		result.Messages = append(result.Messages, auditWarnings...)
   330		if len(auditErrs) > 0 {
   331			result.failf("%s", strings.Join(auditErrs, "; "))
   332			return result
   333		}
   334	
   335		// 14. Registry resolution (Spec §13); Options.ResolveAttest overrides.
   336		resolveAttest := opts.ResolveAttest
   337		if resolveAttest == nil {
   338			resolveAttest = func(nodes []*closure.Node) (map[string]*marker.Attestation, []string, error) {
   339				return resolveRegistries(cfg, nodes, alias, !opts.DryRun)
   340			}
   341		}
   342		attestations, regWarnings, regErr := resolveAttest(nodes)
   343		result.Messages = append(result.Messages, regWarnings...)
   344		if regErr != nil {
   345			result.failf("%v", regErr)
   346			return result
   347		}
   348	
   349		// 15. Narrow boundaries for the remaining read-only gates. Operation-private
   350		// toolchain state must never land in the checkout, the runtime store, or a
   351		// skill repository.
   352		deps, err := opts.Build.resolve(cfg.Home(), []string{
   353			projectRoot, filepath.Join(cfg.Home(), "runtime"), cfg.SkillsRoot,
   354		})
   355		if err != nil {
   356			result.failf("%v", err)
   357			return result
   358		}
   359	
   360		// 16. Moved tags.
   361		movedTags := detectMovedTags(projectRoot, nodes, deps.Generation)
   362		if len(movedTags) > 0 {
   363			if opts.StrictTags {
   364				result.failf("%s", strings.Join(movedTags, "; "))
   365				return result
   366			}
   367			for _, warning := range movedTags {
   368				result.Messages = append(result.Messages, alias+": "+warning)
   369			}
   370		}
   371	
   372		// 17. Build planning. This is the last read-only phase: it resolves the
   373		// trusted toolchain identity and inspects protected cache state, but runs
   374		// no go list or go build and writes no persistent state.
   375		plan, planErr := planBuilds(opts.context(), buildPlanRequest{
   376			scope: alias, nodes: nodes, deps: deps, dryRun: opts.DryRun,
   377		})
   378		defer func() { releasePlan(&result, plan) }()
   379		result.Messages = append(result.Messages, plan.Lines()...)
   380		result.Builds = plan.Builds()
   381		if planErr != nil {
   382			result.failf("%v", planErr)
   383			return result
   384		}
   385	
   386		// 18. Dry run stops before any file changes.
   387		if opts.DryRun {
   388			for _, node := range nodes {
   389				result.Messages = append(result.Messages, fmt.Sprintf("%s: %s (planned)", alias, nodeSummary(node)))
   390			}
   391			result.Messages = append(result.Messages, alias+": dry-run; no files modified")
   392			return result
   393		}
   394	
   395		// 19. Stage every build miss privately. Nothing below has run yet, so a
   396		// staging failure leaves the prior installation and the live build cache
   397		// byte-for-byte unchanged once the plan releases its private root.
   398		staged, stageErr := stageBuilds(opts.context(), plan, deps)
   399		if stageErr != nil {
   400			result.failf("%v", stageErr)
   401			return result
   402		}
   403		result.Messages = append(result.Messages, staged.Lines()...)
   404		result.Staged = staged.Builds()
   405		if opts.OnStaged != nil {
   406			if err := opts.OnStaged(staged); err != nil {
   407				result.failf("%v", err)
   408				return result
   409			}
   410		}
   411	
   412		// 20. Record the checkout as a runtime consumer for GC (Spec §8.7).
   413		if err := scopes.RecordConsumer(cfg.Home(), projectRoot); err != nil {
   414			result.failf("%v", err)
   415			return result
   416		}
   417	
   418		// 21. Materialize every node in provider-first order.
   419		skillsDir := filepath.Join(projectRoot, ".agents", "skills")
   420		binDir := filepath.Join(projectRoot, ".agents", "bin")
   421		hybridStore := scopes.HybridSkillsRoot(cfg.Home())
   422		hybridNames := hybridStoreNames(nodes, projectDeclared)
   423		expectedCommands := map[string]bool{}
   424		var contextNames []string
   425		var hybridContextNames []string
   426		expectedSkills := map[string]bool{}
   427		for _, node := range nodes {
   428			if !hybridNames[node.Name] {
   429				expectedSkills[node.Name] = true
   430			}
    20	)
