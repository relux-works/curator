func TestStagingRunsProviderFirstAndCommandLexical(t *testing.T) {
	e := newEnv(t)
	e.buildSkill("provider", "p-beta", "p-alpha")
	e.buildSkillWithRequirement("consumer", "provider", "c-beta", "c-alpha")
	e.declare("consumer")
