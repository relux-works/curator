   189	// session re-verifies the toolchain as it closes: drift detected there must
   190	// not be swallowed by a successful-looking installation.
   191	func releasePlan(result *Result, plan BuildPlan) {
   192		if err := plan.Close(); err != nil && result.Status == "ok" {
   193			result.failf("%v", err)
   194		}
   195	}
