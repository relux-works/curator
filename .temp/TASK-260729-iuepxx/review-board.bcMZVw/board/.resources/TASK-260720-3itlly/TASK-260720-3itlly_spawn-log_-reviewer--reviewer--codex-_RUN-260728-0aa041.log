   118				for _, node := range nodes {
   119					subjects = append(subjects, audit.Subject{
   120						Name: node.Name, Source: node.Decl.Source, Git: node.Decl.Git,
   121						Commit: node.Resolved.Commit, Snapshot: node.Snapshot,
   122						SchemaVersion: node.Spec.SchemaVersion, Capabilities: node.Spec.Capabilities,
   123					})
