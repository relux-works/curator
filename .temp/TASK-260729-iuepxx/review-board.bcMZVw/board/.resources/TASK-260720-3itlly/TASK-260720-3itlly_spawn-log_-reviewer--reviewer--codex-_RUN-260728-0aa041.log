		t.Fatalf("baseline global install failed: %+v", result)
	}
	e.write(GlobalRoot(e.home), "Skillfile.json", `{
		"schema_version": 1, "agents": ["claude_code"],
		"skills": [{"name": "skill-g", "tag": "v1"}, {"name": "build-skill", "tag": "v1"}]}`)
