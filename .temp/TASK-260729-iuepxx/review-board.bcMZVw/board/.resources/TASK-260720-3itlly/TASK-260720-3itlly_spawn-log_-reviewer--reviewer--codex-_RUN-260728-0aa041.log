		t.Fatal(err)
	}
	e.write(GlobalRoot(e.home), "Skillfile.json", `{
		"schema_version": 1, "agents": ["claude_code"],
		"skills": [{"name": "skill-g", "tag": "v1"}]}`)
	userHome := t.TempDir()
	baseline, _, _, _ := newFakeDeps(t)
