   148	
   149	// Misses returns the planned commands a real run must build privately.
   150	func (plan BuildPlan) Misses() []PlannedBuild {
   151		var misses []PlannedBuild
   152		for _, build := range plan.builds {
   153			if build.outcome.buildable() {
   154				misses = append(misses, build)
   155			}
   156		}
   157		return misses
   158	}
   159	
   160	// Lines renders one scope-prefixed report line per planned command.
   161	func (plan BuildPlan) Lines() []string {
   162		lines := make([]string, 0, len(plan.builds))
   163		for _, build := range plan.builds {
   164			lines = append(lines, plan.scope+": "+build.Describe())
   165		}
   166		return lines
   167	}
