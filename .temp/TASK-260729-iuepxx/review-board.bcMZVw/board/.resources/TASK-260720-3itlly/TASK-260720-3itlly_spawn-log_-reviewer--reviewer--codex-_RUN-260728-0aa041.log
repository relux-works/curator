   301	// Close revalidates the toolchain through the last child exit, then removes
   302	// telemetry mode and every other operation-private probe path even on drift.
   303	func (session *Session) Close() error {
   304		if session == nil {
   305			return nil
   306		}
   307		session.closeOnce.Do(func() {
   308			verifyCtx, cancel := context.WithTimeout(context.Background(), session.fingerprintTimeout)
   309			verifyErr := session.VerifyToolchain(verifyCtx)
   310			cancel()
   311			if !strictlyBelow(session.operation, session.privateBase) {
   312				session.closeErr = errors.Join(verifyErr, diagnostic("private_probe_cleanup_failed", "refusing to remove a probe outside its private base"))
   313				return
   314			}
   315			if err := os.RemoveAll(session.operation); err != nil {
   316				session.closeErr = errors.Join(verifyErr, diagnosticErr("private_probe_cleanup_failed", err, "cannot remove operation-private probe"))
   317				return
   318			}
   319			session.closeErr = verifyErr
   320		})
   321		return session.closeErr
   322	}
