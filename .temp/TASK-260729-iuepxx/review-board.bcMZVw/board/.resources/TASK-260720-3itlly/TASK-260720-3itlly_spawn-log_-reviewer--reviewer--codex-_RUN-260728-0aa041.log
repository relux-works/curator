   139	
   140	// Builds returns the planned commands in provider-first, command-lexical order.
   141	func (plan BuildPlan) Builds() []PlannedBuild {
   142		return append([]PlannedBuild(nil), plan.builds...)
   143	}
   144	
   145	// Empty reports whether the closure activates no build command at all. An
   146	// empty plan performs no toolchain, cache, or Go work.
