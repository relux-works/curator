   130				}
   131				for index := range warnings {
   132					warnings[index] = "global: " + warnings[index]
   133				}
   134				return warnings, errs
   135			}
   136		}
   137		warnings, auditErrors := auditGate(nodes)
   138		result.Messages = append(result.Messages, warnings...)
   139		if len(auditErrors) > 0 {
   140			result.failf("%s", strings.Join(auditErrors, "; "))
   141			return result
   142		}
   143	
   144		// Narrow boundaries for the remaining read-only gates. Operation-private
