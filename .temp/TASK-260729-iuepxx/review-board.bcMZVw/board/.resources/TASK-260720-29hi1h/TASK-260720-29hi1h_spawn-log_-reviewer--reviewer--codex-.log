   192	// StageShimTransition materializes only operation-private launcher files.
   193	// Live project, canonical-global, and safe-forwarding paths are returned as
   194	// transaction targets and are never created, replaced, or removed here.
   195	func StageShimTransition(stageRoot string, desired []ShimSpec, currentlyManaged []ManagedShim) (TransitionPlan, error) {
   196		stageRoot, err := cleanAbsolute(stageRoot)
   197		if err != nil {
   198			return TransitionPlan{}, fmt.Errorf("shim staging root: %w", err)
   199		}
   200		desired = append([]ShimSpec(nil), desired...)
   201		currentlyManaged = append([]ManagedShim(nil), currentlyManaged...)
   202		sort.Slice(desired, func(i, j int) bool {
   203			return shimSortKey(desired[i].Destination) < shimSortKey(desired[j].Destination)
   204		})
   205		plan := TransitionPlan{}
   206		desiredPaths := make(map[string]bool, len(desired))
   207		for _, spec := range desired {
   208			shim := spec.Destination
   209			if err := validateManagedShim(shim); err != nil {
   210				return TransitionPlan{}, err
   211			}
   212			if pathsOverlap(stageRoot, shim.binDir) {
   213				return TransitionPlan{}, fmt.Errorf("shim staging root overlaps live managed bin %s", shim.binDir)
   214			}
   215			if spec.Target == nil {
   216				return TransitionPlan{}, fmt.Errorf("managed shim %s has no runtime target", shim.path)
   217			}
   218			if err := validatePathEntries(spec.PathEntries, shim.platform); err != nil {
   219				return TransitionPlan{}, fmt.Errorf("managed shim %s: %w", shim.path, err)
   220			}
   221			key := platformPathKey(shim.path, shim.platform)
   222			if desiredPaths[key] {
   223				return TransitionPlan{}, fmt.Errorf("duplicate desired managed shim %s", shim.path)
   224			}
   225			desiredPaths[key] = true
   226			staged := stagedShimPath(stageRoot, shim)
   227			if err := writeStagedShim(staged, spec.Target.ExecutablePath(), shim.platform, spec.PathEntries); err != nil {
   228				return TransitionPlan{}, fmt.Errorf("stage managed shim %s: %w", shim.path, err)
   229			}
   230			plan.Desired = append(plan.Desired, DesiredTarget{
   231				Kind: ShimTarget, Role: shim.role, Command: shim.command,
   232				RuntimeKind: spec.Target.Kind(), LivePath: shim.path, StagedPath: staged,
   233			})
   234		}
   235	
   236		sort.Slice(currentlyManaged, func(i, j int) bool { return shimSortKey(currentlyManaged[i]) < shimSortKey(currentlyManaged[j]) })
   237		seenCurrent := map[string]bool{}
   238		for _, shim := range currentlyManaged {
   239			if err := validateManagedShim(shim); err != nil {
   240				return TransitionPlan{}, err
   241			}
   242			key := platformPathKey(shim.path, shim.platform)
