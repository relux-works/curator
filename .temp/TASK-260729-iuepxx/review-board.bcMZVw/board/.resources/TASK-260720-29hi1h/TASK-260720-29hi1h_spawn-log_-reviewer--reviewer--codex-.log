   323	func pathWithin(root, path string) bool {
   324		rel, err := filepath.Rel(root, path)
   325		return err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && !filepath.IsAbs(rel)
   326	}
