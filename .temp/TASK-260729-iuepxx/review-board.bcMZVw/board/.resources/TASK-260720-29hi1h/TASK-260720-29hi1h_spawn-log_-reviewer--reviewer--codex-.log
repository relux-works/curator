   156	func TestShimTransitionMatrixIsDeterministicAndManagerScoped(t *testing.T) {
   157		root := t.TempDir()
   158		artifact := filepath.Join(root, "cache", "artifact")
   159		lay(t, root, map[string]string{"cache/artifact": "artifact", "live/project/manual": "user-owned"})
   160		if err := os.Chmod(artifact, 0o755); err != nil {
   161			t.Fatal(err)
   162		}
   163		compiled := compiledTargetFixture(t, artifact, runtime.GOOS)
   164		script := ScriptTarget{runtimeDir: filepath.Join(root, "runtime"), executable: artifact}
   165		project := mustManagedShim(t, ProjectShim, filepath.Join(root, "live", "project"), "tool", "unix")
   166		canonical := mustManagedShim(t, GlobalCanonicalShim, filepath.Join(root, "live", "global"), "tool", "unix")
   167		forward := mustManagedShim(t, SafeForwardingShim, filepath.Join(root, "live", "user-bin"), "tool", "unix")
   168		current := []ManagedShim{forward, project, canonical}
   169	
   170		for _, testCase := range []struct {
   171			name         string
   172			target       RuntimeTarget
   173			destinations []ManagedShim
   174			wantDesired  int
   175			wantRemoved  []ShimRole
   176		}{
   177			{name: "script-to-build", target: compiled, destinations: current, wantDesired: 3},
   178			{name: "build-to-script", target: script, destinations: current, wantDesired: 3},
   179			{name: "remove-global-publication", target: script, destinations: []ManagedShim{project}, wantDesired: 1, wantRemoved: []ShimRole{GlobalCanonicalShim, SafeForwardingShim}},
   180		} {
   181			t.Run(testCase.name, func(t *testing.T) {
   182				desired := make([]ShimSpec, 0, len(testCase.destinations))
   183				for _, destination := range testCase.destinations {
   184					desired = append(desired, ShimSpec{Destination: destination, Target: testCase.target})
   185				}
   186				plan, err := StageShimTransition(filepath.Join(root, "stage", testCase.name), desired, current)
   187				if err != nil {
   188					t.Fatal(err)
   189				}
   190				if len(plan.Desired) != testCase.wantDesired || len(plan.Removals) != len(testCase.wantRemoved) {
   191					t.Fatalf("transition plan = %+v", plan)
   192				}
   193				for index := 1; index < len(plan.Desired); index++ {
   194					if string(plan.Desired[index-1].Role) > string(plan.Desired[index].Role) {
   195						t.Fatalf("desired targets are not deterministic: %+v", plan.Desired)
   196					}
   197				}
   198				for index, role := range testCase.wantRemoved {
   199					if plan.Removals[index].Role != role {
   200						t.Fatalf("removal order = %+v", plan.Removals)
   201					}
   202				}
   203			})
   204		}
   205	
   206		removed, err := StageShimTransition(filepath.Join(root, "stage", "removal"), nil, current)
   207		if err != nil || len(removed.Desired) != 0 || len(removed.Removals) != 3 {
   208			t.Fatalf("full removal plan = %+v, %v", removed, err)
   209		}
   210		if payload, err := os.ReadFile(filepath.Join(root, "live", "project", "manual")); err != nil || string(payload) != "user-owned" {
   211			t.Fatalf("unmanaged live target changed: %q, %v", payload, err)
   212		}
   213	}
