    13	
    14	// ScriptRuntimeSpec is the complete active script runtime needed at one skill
    15	// commit. Build roots and build commands are intentionally not representable.
    16	type ScriptRuntimeSpec struct {
    17		Home         string
    18		SkillName    string
    19		Commit       string
    20		Snapshot     string
    21		RuntimeRoots []string
    22		Commands     []skillspec.Command
    23		Platform     string
    24	}
    25	
    26	// ScriptRuntimePlan selects validated live command targets and optionally a
    27	// complete staged replacement for a missing or incomplete runtime directory.
    28	type ScriptRuntimePlan struct {
    29		Commands    map[string]ScriptTarget
    30		Desired     *DesiredTarget
    31		Replacement bool
    32	}
    33	
    34	// PrepareScriptRuntime validates every required runtime root and active script
    35	// path before reuse. Missing or incomplete live state is left untouched and a
    36	// complete operation-private replacement is staged for the transaction layer.
    37	func PrepareScriptRuntime(stageRoot string, spec ScriptRuntimeSpec) (ScriptRuntimePlan, error) {
    38		stageRoot, err := cleanAbsolute(stageRoot)
    39		if err != nil {
    40			return ScriptRuntimePlan{}, fmt.Errorf("runtime staging root: %w", err)
    41		}
    42		if _, err := cleanAbsolute(spec.Home); err != nil {
    43			return ScriptRuntimePlan{}, fmt.Errorf("manager home: %w", err)
    44		}
    45		if _, err := cleanAbsolute(spec.Snapshot); err != nil {
    46			return ScriptRuntimePlan{}, fmt.Errorf("snapshot: %w", err)
    47		}
    48		if !identifiers.Valid(spec.SkillName) || !identifiers.Valid(spec.Commit) {
    49			return ScriptRuntimePlan{}, fmt.Errorf("script runtime skill and commit must be portable identifiers")
    50		}
    51		if spec.Platform != "unix" && spec.Platform != "windows" {
    52			return ScriptRuntimePlan{}, fmt.Errorf("unsupported runtime platform %q", spec.Platform)
    53		}
    54		roots, commands, err := validateScriptSpec(spec)
    55		if err != nil {
    56			return ScriptRuntimePlan{}, err
    57		}
    58		live := Dir(spec.Home, spec.SkillName, spec.Commit)
    59		if pathsOverlap(stageRoot, live) {
    60			return ScriptRuntimePlan{}, fmt.Errorf("runtime staging root overlaps live runtime %s", live)
    61		}
    62		plan := ScriptRuntimePlan{Commands: scriptTargets(live, roots, commands, spec.Platform)}
    63		if err := validateRuntimeTree(live, roots, commands, spec.Platform); err == nil {
    64			return plan, nil
    65		} else if _, statErr := os.Lstat(live); statErr == nil {
    66			plan.Replacement = true
    67		} else if !os.IsNotExist(statErr) {
    68			return ScriptRuntimePlan{}, fmt.Errorf("inspect script runtime: %w", statErr)
    69		}
    70	
    71		staged := filepath.Join(stageRoot, "runtime", spec.SkillName, spec.Commit)
    72		if err := os.RemoveAll(staged); err != nil {
    73			return ScriptRuntimePlan{}, fmt.Errorf("reset private runtime staging: %w", err)
    74		}
    75		if err := stageScriptTree(staged, spec.Snapshot, roots, commands, spec.Platform); err != nil {
    76			_ = os.RemoveAll(staged)
    77			return ScriptRuntimePlan{}, err
    78		}
    79		if err := validateRuntimeTree(staged, roots, commands, spec.Platform); err != nil {
    80			_ = os.RemoveAll(staged)
    81			return ScriptRuntimePlan{}, fmt.Errorf("validate staged script runtime: %w", err)
    82		}
    83		plan.Desired = &DesiredTarget{Kind: RuntimeTreeTarget, RuntimeKind: ScriptRuntime, LivePath: live, StagedPath: staged}
    84		return plan, nil
    85	}
    86	
    87	func validateScriptSpec(spec ScriptRuntimeSpec) ([]string, []skillspec.Command, error) {
    88		roots := append([]string(nil), spec.RuntimeRoots...)
    89		sort.Strings(roots)
    90		for index, root := range roots {
    91			if !identifiers.PortablePath(root) {
    92				return nil, nil, fmt.Errorf("runtime root %q is not a portable relative path", root)
    93			}
    94			if index > 0 && roots[index-1] == root {
    95				return nil, nil, fmt.Errorf("runtime roots must be unique")
    96			}
    97		}
    98		commands := append([]skillspec.Command(nil), spec.Commands...)
    99		sort.Slice(commands, func(i, j int) bool { return commands[i].Name < commands[j].Name })
   100		for index, command := range commands {
   101			if command.Type != "script" || !identifiers.Valid(command.Name) {
   102				return nil, nil, fmt.Errorf("active runtime command %q is not a script command", command.Name)
   103			}
   104			if index > 0 && commands[index-1].Name == command.Name {
   105				return nil, nil, fmt.Errorf("active script commands must be unique")
   106			}
   107			rel := commandRel(command, spec.Platform)
   108			if !identifiers.PortablePath(rel) {
   109				return nil, nil, fmt.Errorf("script command %q path is not portable", command.Name)
   110			}
   111			if len(roots) > 0 && !insideAnyRoot(rel, roots) {
   112				return nil, nil, fmt.Errorf("script command %q is outside every runtime root", command.Name)
   113			}
   114		}
   115		return roots, commands, nil
   116	}
   117	
   118	func scriptTargets(runtimeDir string, roots []string, commands []skillspec.Command, platform string) map[string]ScriptTarget {
   119		targets := make(map[string]ScriptTarget, len(commands))
   120		for _, command := range commands {
   121			path := filepath.Join(runtimeDir, filepath.FromSlash(commandRel(command, platform)))
   122			if len(roots) == 0 {
   123				name := command.Name
   124				if platform == "windows" {
   125					name += ".cmd"
   126				}
   127				path = filepath.Join(runtimeDir, "bin", name)
   128			}
   129			targets[command.Name] = ScriptTarget{runtimeDir: runtimeDir, executable: path}
   130		}
   131		return targets
   132	}
   133	
   134	func validateRuntimeTree(root string, runtimeRoots []string, commands []skillspec.Command, platform string) error {
   135		rootInfo, err := os.Lstat(root)
   136		if err != nil || !rootInfo.IsDir() || rootInfo.Mode()&os.ModeSymlink != 0 {
   137			return fmt.Errorf("runtime directory is absent or unsafe")
   138		}
   139		if err := filepath.Walk(root, func(path string, info os.FileInfo, walkErr error) error {
   140			if walkErr != nil {
   141				return walkErr
   142			}
   143			if path == root {
   144				return nil
   145			}
   146			rel, err := filepath.Rel(root, path)
   147			if err != nil {
   148				return err
   149			}
   150			rel = filepath.ToSlash(rel)
   151			if !allowedRuntimePath(rel, info.IsDir(), runtimeRoots, commands, platform) {
   152				return fmt.Errorf("runtime contains unmanaged path: %s", rel)
   153			}
   154			if info.Mode()&os.ModeSymlink != 0 || (!info.IsDir() && !info.Mode().IsRegular()) {
   155				return fmt.Errorf("runtime contains unsafe path: %s", rel)
   156			}
   157			return nil
   158		}); err != nil {
   159			return err
   160		}
   161		for _, rel := range runtimeRoots {
   162			info, err := os.Lstat(filepath.Join(root, filepath.FromSlash(rel)))
   163			if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
   164				return fmt.Errorf("runtime root is absent or unsafe: %s", rel)
   165			}
   166		}
   167		for name, target := range scriptTargets(root, runtimeRoots, commands, platform) {
   168			info, err := os.Lstat(target.executable)
   169			if err != nil || !info.Mode().IsRegular() {
   170				return fmt.Errorf("script command is absent or unsafe: %s", name)
   171			}
   172			if platform == "unix" && info.Mode().Perm()&0o111 == 0 {
   173				return fmt.Errorf("script command is not executable: %s", name)
   174			}
   175		}
   176		return nil
   177	}
   178	
   179	func allowedRuntimePath(path string, directory bool, roots []string, commands []skillspec.Command, platform string) bool {
   180		if len(roots) > 0 {
   181			for _, root := range roots {
   182				if path == root || strings.HasPrefix(path, root+"/") ||
   183					(directory && strings.HasPrefix(root, path+"/")) {
   184					return true
   185				}
   186			}
   187			return false
   188		}
   189		if directory && path == "bin" {
   190			return true
   191		}
   192		for _, target := range scriptTargets("", roots, commands, platform) {
   193			if path == filepath.ToSlash(strings.TrimPrefix(target.executable, string(filepath.Separator))) {
   194				return true
   195			}
   196		}
   197		return false
   198	}
   199	
   200	func stageScriptTree(staged, snapshot string, roots []string, commands []skillspec.Command, platform string) error {
   201		if err := os.MkdirAll(staged, 0o700); err != nil {
   202			return err
   203		}
   204		if len(roots) > 0 {
   205			for _, root := range roots {
   206				source := filepath.Join(snapshot, filepath.FromSlash(root))
   207				info, err := os.Lstat(source)
   208				if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
   209					return fmt.Errorf("snapshot runtime root is absent or unsafe: %s", root)
   210				}
   211				if err := copyTree(source, filepath.Join(staged, filepath.FromSlash(root))); err != nil {
   212					return fmt.Errorf("stage runtime root %s: %w", root, err)
   213				}
   214			}
   215		} else {
   216			for _, command := range commands {
   217				source := filepath.Join(snapshot, filepath.FromSlash(commandRel(command, platform)))
   218				info, err := os.Lstat(source)
   219				if err != nil || !info.Mode().IsRegular() {
   220					return fmt.Errorf("snapshot script command is absent or unsafe: %s", command.Name)
   221				}
   222				name := command.Name
   223				if platform == "windows" {
   224					name += ".cmd"
   225				}
   226				if err := copyFile(source, filepath.Join(staged, "bin", name)); err != nil {
   227					return fmt.Errorf("stage script command %s: %w", command.Name, err)
   228				}
   229			}
   230		}
   231		if platform == "unix" {
   232			for _, target := range scriptTargets(staged, roots, commands, platform) {
   233				if err := makeExecutable(target.executable); err != nil {
   234					return err
   235				}
   236			}
   237		}
   238		return nil
   239	}
   240	
   241	func insideAnyRoot(path string, roots []string) bool {
   242		for _, root := range roots {
   243			if path == root || strings.HasPrefix(path, root+"/") {
   244				return true
   245			}
   246		}
   247		return false
   248	}
