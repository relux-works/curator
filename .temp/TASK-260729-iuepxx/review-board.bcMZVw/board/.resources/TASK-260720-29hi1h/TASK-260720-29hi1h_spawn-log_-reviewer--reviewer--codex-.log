   256	func validatePathEntries(entries []string, platform string) error {
   257		for _, entry := range entries {
   258			if _, err := cleanAbsolute(entry); err != nil {
   259				return fmt.Errorf("PATH entry: %w", err)
   260			}
   261			if platform == "unix" && strings.Contains(entry, ":") {
   262				return fmt.Errorf("Unix PATH entry contains a separator")
   263			}
   264			if platform == "windows" && strings.Contains(entry, ";") {
   265				return fmt.Errorf("Windows PATH entry contains a separator")
   266			}
   267		}
   268		return nil
   269	}
   270	
   271	func validateManagedShim(shim ManagedShim) error {
   272		want, err := NewManagedShim(shim.role, shim.binDir, shim.command, shim.platform)
   273		if err != nil {
   274			return err
   275		}
   276		if want.path != shim.path {
   277			return fmt.Errorf("managed shim path is not manager-derived")
   278		}
   279		return nil
   280	}
   281	
   282	func writeStagedShim(path, executable, platform string, pathEntries []string) error {
   283		if executable == "" || !filepath.IsAbs(executable) {
   284			return fmt.Errorf("runtime executable must be an absolute path")
   285		}
   286		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
   287			return err
   288		}
   289		content := UnixShimContent(executable, pathEntries)
   290		if platform == "windows" {
   291			content = WindowsShimContent(executable, pathEntries)
   292		}
   293		return os.WriteFile(path, []byte(content), 0o700)
   294	}
   295	
   296	func stagedShimPath(stageRoot string, shim ManagedShim) string {
   297		digest := sha256.Sum256([]byte(shim.path))
   298		return filepath.Join(stageRoot, "shims", string(shim.role), hex.EncodeToString(digest[:]), filepath.Base(shim.path))
   299	}
   300	
   301	func shimSortKey(shim ManagedShim) string {
   302		return string(shim.role) + "\x00" + shim.command + "\x00" + platformPathKey(shim.path, shim.platform)
   303	}
   304	
   305	func platformPathKey(path, platform string) string {
   306		if platform == "windows" {
   307			return strings.ToLower(path)
   308		}
   309		return path
   310	}
   311	
   312	func cleanAbsolute(path string) (string, error) {
   313		if path == "" || !filepath.IsAbs(path) || filepath.Clean(path) != path {
   314			return "", fmt.Errorf("path must be clean and absolute")
   315		}
   316		return path, nil
   317	}
