   215	func TestCompiledShimsStageWithoutLaunchThenPostInstallForwardExactly(t *testing.T) {
   216		if runtime.GOOS == "windows" {
   217			t.Skip("POSIX post-install launch fixture")
   218		}
   219		root := t.TempDir()
   220		marker := filepath.Join(root, "artifact-launched")
   221		artifactDir := filepath.Join(root, "immutable cache's % Юникод")
   222		artifact := filepath.Join(artifactDir, "compiled tool")
   223		if err := os.MkdirAll(artifactDir, 0o755); err != nil {
   224			t.Fatal(err)
   225		}
   226		payload := "#!/bin/sh\n" +
