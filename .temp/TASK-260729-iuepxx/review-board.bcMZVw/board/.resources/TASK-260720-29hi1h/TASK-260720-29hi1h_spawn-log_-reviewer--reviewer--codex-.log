    19	func TestPrepareScriptRuntimeStagesIncompleteReplacementWithoutBuildRoots(t *testing.T) {
    20		root := t.TempDir()
    21		home := filepath.Join(root, "manager")
    22		snapshot := filepath.Join(root, "snapshot")
    23		stage := filepath.Join(root, "private stage")
    24		lay(t, snapshot, map[string]string{
    25			"runtime scripts/tool":          "#!/bin/sh\nexit 0\n",
    26			"runtime scripts/lib/data":      "runtime",
    27			"build source/cmd/tool/main.go": "package main",
    28		})
    29		live := Dir(home, "skill-a", "commit-a")
    30		lay(t, live, map[string]string{
    31			"runtime scripts/lib/data": "incomplete",
    32			"build source/sentinel":    "must remain live until transaction",
    33		})
    34	
    35		plan, err := PrepareScriptRuntime(stage, ScriptRuntimeSpec{
    36			Home: home, SkillName: "skill-a", Commit: "commit-a", Snapshot: snapshot,
    37			RuntimeRoots: []string{"runtime scripts"},
    38			Commands:     []skillspec.Command{{Name: "tool", Type: "script", UnixPath: "runtime scripts/tool"}},
    39			Platform:     "unix",
    40		})
    41		if err != nil {
    42			t.Fatal(err)
    43		}
    44		if !plan.Replacement || plan.Desired == nil {
    45			t.Fatalf("incomplete runtime plan = %+v", plan)
    46		}
    47		if plan.Desired.LivePath != live || plan.Commands["tool"].ExecutablePath() != filepath.Join(live, "runtime scripts", "tool") {
    48			t.Fatalf("runtime targets do not select eventual live tree: %+v", plan)
    49		}
    50		if _, err := os.Stat(filepath.Join(live, "build source", "sentinel")); err != nil {
    51			t.Fatalf("planning mutated the live runtime: %v", err)
    52		}
    53		if _, err := os.Stat(filepath.Join(plan.Desired.StagedPath, "runtime scripts", "tool")); err != nil {
    54			t.Fatalf("staged replacement lacks active script: %v", err)
    55		}
    56		if _, err := os.Stat(filepath.Join(plan.Desired.StagedPath, "build source")); !os.IsNotExist(err) {
    57			t.Fatalf("build root leaked into staged runtime: %v", err)
    58		}
    59	}
