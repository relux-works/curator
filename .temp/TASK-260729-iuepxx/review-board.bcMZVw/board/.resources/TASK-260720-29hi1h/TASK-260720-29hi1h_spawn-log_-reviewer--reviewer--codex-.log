   122	
   123	func NewManagedShim(role ShimRole, binDir, command, platform string) (ManagedShim, error) {
   124		if role != ProjectShim && role != GlobalCanonicalShim && role != SafeForwardingShim {
   125			return ManagedShim{}, fmt.Errorf("unsupported managed shim role %q", role)
   126		}
   127		if !identifiers.Valid(command) {
   128			return ManagedShim{}, fmt.Errorf("managed shim command is not a portable identifier")
   129		}
   130		if platform != "unix" && platform != "windows" {
   131			return ManagedShim{}, fmt.Errorf("unsupported shim platform %q", platform)
   132		}
   133		abs, err := cleanAbsolute(binDir)
   134		if err != nil {
   135			return ManagedShim{}, fmt.Errorf("managed shim bin: %w", err)
   136		}
   137		name := command
   138		if platform == "windows" {
   139			name += ".cmd"
   140		}
   141		return ManagedShim{role: role, binDir: abs, command: command, platform: platform, path: filepath.Join(abs, name)}, nil
   142	}
