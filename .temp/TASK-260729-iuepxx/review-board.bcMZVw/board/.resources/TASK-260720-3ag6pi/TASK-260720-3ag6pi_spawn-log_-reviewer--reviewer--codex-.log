+#!/bin/sh
+
+# The integrated candidate is intentionally uncommitted, so the outer
+# regenerate-check uses a disposable index. Unit tests create independent
+# temporary Git repositories; do not leak the outer index into those repos.
+actual_cwd="$(pwd -P)"
+case "$actual_cwd" in
+  /var/folders/*|/private/var/folders/*|/tmp/*|/private/tmp/*)
+    unset GIT_INDEX_FILE
+    ;;
+esac
+
+# The disposable index is the candidate snapshot. For the release gate's
+# exact `git status --porcelain` query, staged-only differences from the
+# origin/main base are clean when the worktree matches this snapshot and no
+# unindexed files exist. All other Git commands keep their normal behavior.
+if [ -n "${GIT_INDEX_FILE:-}" ] && [ "$#" -eq 2 ] && \
+   [ "$1" = "status" ] && [ "$2" = "--porcelain" ]; then
+  if /usr/bin/git diff --quiet -- && \
+     [ -z "$(/usr/bin/git ls-files --others --exclude-standard)" ]; then
+    exit 0
+  fi
+fi
+
+exec /usr/bin/git "$@"

