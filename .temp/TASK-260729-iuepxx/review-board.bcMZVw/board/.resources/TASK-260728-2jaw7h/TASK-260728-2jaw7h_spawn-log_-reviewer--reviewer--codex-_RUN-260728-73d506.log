	writeExternalRepositoryExpected(expected, marker)
	writeManifest(suite)
	writeCandidateManifest(candidate)
	writeRC5ReleaseMetadata(*root, suite)
	assertFrozenReleaseIdentity(*root)
}

func writeSkillManifestResolutionVectors(dir string) {
	canonical := "{\"schema_version\":1,\"commands\":{}}\n"
	legacyEquivalent := "{\n  \"commands\": {},\n  \"schema_version\": 1\n}\n"
	writeJSON(filepath.Join(dir, "skill-manifest-resolution.json"), []any{
		map[string]any{
			"name": "canonical-only", "files": map[string]any{"agent-skill.json": canonical},
			"expected_source": "agent-skill.json", "expected_commands": []any{},
		},
		map[string]any{
			"name": "legacy-only", "files": map[string]any{"csk-skill.json": canonical},
			"expected_source": "csk-skill.json", "expected_commands": []any{},
		},
		map[string]any{
			"name":            "equal-dual-manifests",
			"files":           map[string]any{"agent-skill.json": canonical, "csk-skill.json": legacyEquivalent},
			"expected_source": "agent-skill.json", "expected_commands": []any{},
// assertFrozenReleaseIdentity refuses to leave a rewritten frozen release
// behind. release/frozen.json is authored, never generated, so regenerating the
// corpus cannot move the expectation along with the artifact: a change that
// alters a released suite manifest, its schema-case index, or the release
// document that pins it fails here rather than producing a new, internally
// consistent, silently different release.
func assertFrozenReleaseIdentity(root string) {
	payload, err := os.ReadFile(filepath.Join(root, "release", "frozen.json"))
	must(err)
	var frozen struct {
		Releases []map[string]string `json:"releases"`
	}
	must(json.Unmarshal(payload, &frozen))
	if len(frozen.Releases) == 0 {
		must(fmt.Errorf("release/frozen.json records no frozen release"))
	}
	for _, record := range frozen.Releases {
		for _, subject := range [][2]string{
			{"release_document", "release_document_sha256"},
			{"suite_manifest", "suite_manifest_sha256"},
			{"schema_cases_index", "schema_cases_index_sha256"},
		} {
			relative, expected := record[subject[0]], record[subject[1]]
			content, readErr := os.ReadFile(filepath.Join(root, filepath.FromSlash(relative)))
			must(readErr)
			sum := sha256.Sum256(content)
			actual := "sha256:" + hex.EncodeToString(sum[:])
			if actual != expected {
				must(fmt.Errorf(
					"generation rewrote frozen release %s: %s is %s, release/frozen.json requires %s",
					record["protocol_version"], relative, actual, expected,
				))
			}
		}
	}
}

func writeJSON(path string, value any) {
	must(os.MkdirAll(filepath.Dir(path), 0o755))
	file, err := os.Create(path)
	must(err)
	encoder := json.NewEncoder(file)
	encoder.SetEscapeHTML(false)
	encoder.SetIndent("", "  ")
	must(encoder.Encode(value))
	must(file.Close())
}

func writeText(path, text string) {
	must(os.MkdirAll(filepath.Dir(path), 0o755))
	must(os.WriteFile(path, []byte(text), 0o644))
}
func must(err error) {
	if err != nil {
		panic(fmt.Sprintf("generate conformance vectors: %v", err))
	}
}
