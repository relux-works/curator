ry.json',\n'invalid-v7-command-target.json',\n'invalid-v7-command-driver.json',\n}\nselected = []\nfor case in index:\n    path = case['instance']\n    is_legacy = any(path == f'{prefix}-v{version}/{name}' for prefix in ('agent-skill','csk-skill') for version in range(1,7) for name in legacy_names)\n    if path in selected_paths or is_legacy:\n        selected.append(case)\nassert len(selected) == len(selected_paths) + 2 * 6 * len(legacy_names), len(selected)\nfor case in selected:\n    schema_name = case['schema']\n    instance = validate.load_json(Path('conformance/v1/schema-cases') / case['instance'])\n    errors = list(Draft202012Validator(schema_docs[schema_name], registry=registry).iter_errors(instance))\n    semantic = None if errors else validate.validate_wire_semantics(schema_name, instance)\n    actual = not errors and semantic is None\n    assert actual == case['valid'], (case, errors[:1], semantic)\nprint(f'adversarial_replay_cases={len(selected)} all_expected_classifications_match')\nprint(f'legacy_schema7_rejections={2*6*len(legacy_names)}')\nprint(f'cycle1_boundary_and_semantic_probes={len(selected_paths)}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
