+	if edge["content_sha256"] != "sha256:68008c9a1131c1295d78f4f7d184c3df5f7382a88d8d40333be7cf02b2ee4de9" {
+		t.Fatalf("build-source edge digest changed: %v", edge["content_sha256"])
