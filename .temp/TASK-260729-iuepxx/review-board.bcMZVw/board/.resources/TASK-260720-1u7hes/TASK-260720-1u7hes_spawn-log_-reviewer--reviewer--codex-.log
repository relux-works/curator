+func TestProtocolRC4ManifestInventoryAndDigests(t *testing.T) {
+	root := repositoryRoot(t)
+	suite := filepath.Join(root, "conformance", "v1")
+	manifest := readObject(t, filepath.Join(suite, "manifest.json"))
+	if manifest["protocol_version"] != protocolVersion {
+		t.Fatalf("manifest protocol_version = %v, want %s", manifest["protocol_version"], protocolVersion)
+	}
+
+	listed := map[string]string{}
+	for _, raw := range manifest["files"].([]any) {
+		entry := raw.(map[string]any)
+		path := entry["path"].(string)
+		if _, exists := listed[path]; exists {
+			t.Fatalf("manifest repeats %s", path)
+		}
+		listed[path] = entry["sha256"].(string)
+	}
+
+	actual := map[string]string{}
+	if err := filepath.WalkDir(suite, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if !entry.Type().IsRegular() || path == filepath.Join(suite, "manifest.json") {
+			return nil
+		}
+		payload, readErr := os.ReadFile(path)
+		if readErr != nil {
+			return readErr
+		}
+		relative, relErr := filepath.Rel(suite, path)
+		if relErr != nil {
+			return relErr
+		}
+		digest := sha256.Sum256(payload)
+		actual[filepath.ToSlash(relative)] = "sha256:" + hex.EncodeToString(digest[:])
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(listed, actual) {
+		t.Fatal("manifest inventory or file digests differ from the complete conformance suite")
+	}
+
+	required := []string{
+		"vectors/build-drivers.json",
+		"vectors/manager-lifecycle.json",
+		"expected/build-driver/build-input.ccj.json",
+		"expected/build-driver/build-source.preimage.bin",
+		"expected/build-driver/receipt.ccj.json",
+		"expected/build-driver/toolchain.preimage.bin",
+		"fixtures/go-build-skill/.csk-install.json",
+		"fixtures/go-build-skill/agent-skill.json",
+		"schema-cases/agent-skill-v6/valid.json",
+		"schema-cases/csk-skill-v6/valid.json",
+		"schema-cases/build-receipt-v1/valid.json",
+		"schema-cases/install-marker-v2/valid.json",
+		"schema-cases/conformance-claim-v2/valid.json",
+		"schema-cases/conformance-claim-v1/valid.json",
+	}
+	for _, path := range required {
+		if _, ok := listed[path]; !ok {
+			t.Errorf("manifest omits required rc.4 artifact %s", path)
+		}
+	}
+}
