+from __future__ import annotations
+
+import hashlib
+import json
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import validate
+
+
+SOURCE_ROOT = Path(__file__).resolve().parents[1]
+
+
+class ProtocolRC4ValidatorTests(unittest.TestCase):
+    RC4_SCHEMAS = {
+        "agent-skill-v6.schema.json",
+        "csk-skill-v6.schema.json",
+        "build-receipt-v1.schema.json",
+        "install-marker-v2.schema.json",
+        "conformance-claim-v2.schema.json",
+    }
+
+    def setUp(self) -> None:
+        self.temporary = tempfile.TemporaryDirectory()
+        self.root = Path(self.temporary.name)
+        for directory in ("conformance", "reviews", "schemas"):
+            shutil.copytree(SOURCE_ROOT / directory, self.root / directory)
+        self.patches = (
+            patch.object(validate, "ROOT", self.root),
+            patch.object(validate, "SCHEMAS", self.root / "schemas" / "v1"),
+            patch.object(validate, "SUITE", self.root / "conformance" / "v1"),
+            patch.object(validate, "REVIEWS", self.root / "reviews"),
+        )
+        for active_patch in self.patches:
+            active_patch.start()
+
+    def tearDown(self) -> None:
+        for active_patch in reversed(self.patches):
+            active_patch.stop()
+        self.temporary.cleanup()
+
+    @staticmethod
+    def _write_json(path: Path, value: object) -> None:
+        path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
+
+    def _refresh_manifest_digest(self, relative: str) -> None:
+        manifest_path = self.root / "conformance" / "v1" / "manifest.json"
+        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+        payload = (self.root / "conformance" / "v1" / relative).read_bytes()
+        digest = "sha256:" + hashlib.sha256(payload).hexdigest()
+        for entry in manifest["files"]:
+            if entry["path"] == relative:
+                entry["sha256"] = digest
+                break
+        else:
+            self.fail(f"manifest does not contain {relative}")
+        self._write_json(manifest_path, manifest)
+
+    def test_accepts_complete_schema_case_manifest_and_vector_inventories(self) -> None:
+        validate.validate_schemas()
+        validate.validate_manifest()
+        validate.validate_vector_semantics()
+
+    def test_rejects_case_removed_from_index_even_when_file_remains(self) -> None:
+        path = self.root / "conformance" / "v1" / "schema-cases" / "index.json"
+        index = json.loads(path.read_text(encoding="utf-8"))
+        self._write_json(path, index[:-1])
+        with self.assertRaisesRegex(validate.ValidationFailure, "schema case index mismatch"):
+            validate.validate_schemas()
+
+    def test_rejects_schema_removed_with_all_of_its_cases(self) -> None:
+        (self.root / "schemas" / "v1" / "build-receipt-v1.schema.json").unlink()
+        shutil.rmtree(
+            self.root / "conformance" / "v1" / "schema-cases" / "build-receipt-v1"
+        )
+        with self.assertRaisesRegex(validate.ValidationFailure, "schema inventory mismatch"):
+            validate.validate_schemas()
+
+    def test_rejects_each_removed_rc4_schema(self) -> None:
+        for name in sorted(self.RC4_SCHEMAS):
+            with self.subTest(schema=name):
+                path = self.root / "schemas" / "v1" / name
+                payload = path.read_bytes()
+                path.unlink()
+                try:
+                    with self.assertRaisesRegex(validate.ValidationFailure, "schema inventory mismatch"):
+                        validate.validate_schemas()
+                finally:
+                    path.write_bytes(payload)
+
+    def test_rejects_each_removed_generated_rc4_case(self) -> None:
+        cases = validate.expected_schema_cases()
+        for schema in sorted(self.RC4_SCHEMAS):
+            directory = schema.removesuffix(".schema.json")
+            for filename, _ in cases[schema]:
+                relative = f"{directory}/{filename}"
+                with self.subTest(case=relative):
+                    path = self.root / "conformance" / "v1" / "schema-cases" / relative
+                    payload = path.read_bytes()
+                    path.unlink()
+                    try:
+                        with self.assertRaises(validate.ValidationFailure):
+                            validate.validate_schemas()
+                    finally:
+                        path.write_bytes(payload)
+
+    def test_rejects_unresolved_reference_in_new_schema(self) -> None:
+        path = self.root / "schemas" / "v1" / "build-receipt-v1.schema.json"
+        schema = json.loads(path.read_text(encoding="utf-8"))
+        schema["properties"]["input"]["$ref"] = "missing.schema.json#/$defs/input"
+        self._write_json(path, schema)
+        with self.assertRaisesRegex(validate.ValidationFailure, "unresolved schema reference"):
+            validate.validate_schemas()
+
+    def test_rejects_manifest_hash_that_no_longer_matches_file(self) -> None:
+        path = self.root / "conformance" / "v1" / "vectors" / "build-drivers.json"
+        path.write_bytes(path.read_bytes() + b"\n")
+        with self.assertRaisesRegex(validate.ValidationFailure, "vector digest mismatch"):
+            validate.validate_manifest()
+
