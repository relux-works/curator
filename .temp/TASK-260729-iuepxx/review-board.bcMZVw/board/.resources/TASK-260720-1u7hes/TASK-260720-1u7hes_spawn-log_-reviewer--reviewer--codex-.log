+        if actual != expected:
+            raise ReleaseFailure(f"historical claim v1 artifact changed: {relative}")
+
+    manifest = load_json(ROOT / "conformance" / "v1" / "manifest.json")
+    if manifest.get("protocol_version") != PROTOCOL_VERSION:
+        raise ReleaseFailure(f"conformance manifest is not {PROTOCOL_VERSION}")
+    entries = manifest.get("files")
+    if not isinstance(entries, list):
+        raise ReleaseFailure("conformance manifest files must be an array")
+    listed = [entry.get("path") for entry in entries if isinstance(entry, dict)]
+    if listed != sorted(expected_suite_inventory()):
+        raise ReleaseFailure(f"{PROTOCOL_VERSION} conformance manifest inventory is incomplete")
+
+    case_index = load_json(ROOT / "conformance" / "v1" / "schema-cases" / "index.json")
