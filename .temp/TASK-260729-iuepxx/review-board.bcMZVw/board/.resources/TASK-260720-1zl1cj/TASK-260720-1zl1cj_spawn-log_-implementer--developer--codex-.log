			t.Fatalf("lock path %q is outside manager home %q", lockPath, first.Home())
		}
		if strings.HasPrefix(lockPath, project+string(filepath.Separator)) {
			t.Fatalf("lock path %q was placed inside project %q", lockPath, project)
		}
	}
