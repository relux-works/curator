SSH_USER_PATTERN = r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
HTTPS_REPOSITORY = re.compile(
        cases = {
            "non-array container": ({"type": "object", "items": {"oneOf": []}}, "is not an array schema"),
            "open items": (
