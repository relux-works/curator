	defaultFingerprintTimeout = 2 * time.Minute
	defaultOutputLimit        = int64(64 * 1024)
	maxVersionOutput          = 4096
)

var (
	goVersionPattern = regexp.MustCompile(`^go version go(1\.([0-9]+)(?:\.[0-9]+)?(?:rc[0-9]+|beta[0-9]+)?) ([a-z0-9]+)/([a-z0-9]+)$`)
