	defaultBuildOutput   = int64(8 * 1024 * 1024)
	defaultArtifactLimit = int64(128 * 1024 * 1024)
	defaultFileLimit     = int64(512 * 1024 * 1024)
	defaultDiskLimit     = int64(1024 * 1024 * 1024)
