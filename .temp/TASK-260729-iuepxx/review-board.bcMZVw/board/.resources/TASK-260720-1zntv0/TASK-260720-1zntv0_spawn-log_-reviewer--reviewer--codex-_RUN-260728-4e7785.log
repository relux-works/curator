    66	// that the compiler and every tool child inherits them.
    67	func applyNativeControls(limits ResourceLimits, probes []ControlProbe) (*nativeControlApplication, error) {
    68		application := &nativeControlApplication{}
    69		for _, probe := range probes {
    70			if probe.Availability != AvailabilityAvailable {
    71				continue
    72			}
    73			switch probe.Name {
    74			case ControlDescendantDomainTermination:
    75				// A new session makes the worker its own process-group leader, so the
    76				// parent can terminate the complete worker domain with one killpg and
    77				// no descendant can outlive it by changing groups first.
    78				if _, err := unix.Setsid(); err != nil {
    79					return nil, diagnosticErr(CodeControlUnavailable, err, "cannot create the private worker session")
    80				}
    81				group, err := unix.Getpgid(0)
    82				if err != nil || group != os.Getpid() {
    83					return nil, diagnosticErr(CodeControlUnavailable, err, "worker is not its own process-group leader")
    84				}
    85			case ControlPerFileSizeLimit:
    86				var current unix.Rlimit
    87				if err := unix.Getrlimit(unix.RLIMIT_FSIZE, &current); err != nil {
    88					return nil, diagnosticErr(CodeControlUnavailable, err, "cannot read RLIMIT_FSIZE")
    89				}
    90				if limits.FileBytes <= 0 {
    91					return nil, diagnostic(CodeControlUnavailable, "the per-file byte bound is not positive")
    92				}
    93				wanted := uint64(limits.FileBytes) // #nosec G115 -- normalizeBuildLimits bounds this to a positive value below defaultFileLimit
    94				if current.Max != unix.RLIM_INFINITY && wanted > current.Max {
    95					wanted = current.Max
    96				}
    97				if err := unix.Setrlimit(unix.RLIMIT_FSIZE, &unix.Rlimit{Cur: wanted, Max: current.Max}); err != nil {
    98					return nil, diagnosticErr(CodeControlUnavailable, err, "cannot apply RLIMIT_FSIZE")
    99				}
   100				var applied unix.Rlimit
   101				if err := unix.Getrlimit(unix.RLIMIT_FSIZE, &applied); err != nil || applied.Cur != wanted {
   102					return nil, diagnosticErr(CodeControlUnavailable, err, "RLIMIT_FSIZE was not applied")
   103				}
   104			case ControlInheritedHandleRestriction:
   105				// Applied at compiler launch by releaseInheritedDescriptors; the Go
   106				// runtime opens every descriptor close-on-exec, and the worker closes
   107				// its protocol descriptors before the compiler starts.
   108			default:
   109				return nil, diagnostic(CodeControlUnavailable, "no macOS application for inventory control %q", probe.Name)
   110			}
   111			application.Applied = append(application.Applied, probe.Name)
   112		}
   113		return application, nil
   114	}
