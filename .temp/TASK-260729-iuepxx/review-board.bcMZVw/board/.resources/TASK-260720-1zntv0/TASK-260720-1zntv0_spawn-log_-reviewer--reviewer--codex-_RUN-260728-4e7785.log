    70	// probeNativeControl performs the per-operation availability determination for
    71	// one Windows inventory control. It starts no program and caches nothing.
    72	func probeNativeControl(name string) (bool, error) {
    73		switch name {
    74		case ControlDescendantDomainTermination, ControlActiveProcessCountLimit, ControlAggregateMemoryLimit:
    75			flags, err := probeLimitFlags(name)
    76			if err != nil {
    77				return false, err
    78			}
    79			job, err := newProbeJob(flags, probeLimits())
    80			if err != nil {
    81				return false, err
    82			}
    83			return true, windows.CloseHandle(job)
    84		case ControlInheritedHandleRestriction:
    85			// os/exec restricts inheritance with PROC_THREAD_ATTRIBUTE_HANDLE_LIST,
    86			// so the attribute list must be usable on this host.
    87			list, err := windows.NewProcThreadAttributeList(1)
    88			if err != nil {
    89				return false, err
    90			}
    91			list.Delete()
    92			return true, nil
    93		default:
    94			return false, fmt.Errorf("no Windows probe for inventory control %q", name)
    95		}
    96	}
