   103	
   104	// applyNativeControls assigns the worker to one private Job Object carrying
   105	// every probed-available limit, so the compiler and every tool child inherits
   106	// the same aggregate domain.
   107	func applyNativeControls(limits ResourceLimits, probes []ControlProbe) (*nativeControlApplication, error) {
   108		application := &nativeControlApplication{}
   109		var flags uint32
   110		for _, probe := range probes {
   111			if probe.Availability != AvailabilityAvailable {
   112				continue
   113			}
   114			switch probe.Name {
   115			case ControlDescendantDomainTermination, ControlActiveProcessCountLimit, ControlAggregateMemoryLimit:
   116				limit, err := probeLimitFlags(probe.Name)
   117				if err != nil {
   118					return nil, diagnosticErr(CodeControlUnavailable, err, "cannot apply inventory control %q", probe.Name)
   119				}
   120				flags |= limit
   121			case ControlInheritedHandleRestriction:
   122				// Applied at compiler launch: os/exec passes exactly the standard
   123				// handles through PROC_THREAD_ATTRIBUTE_HANDLE_LIST and the worker
   124				// adds no inherited handle.
   125			default:
   126				return nil, diagnostic(CodeControlUnavailable, "no Windows application for inventory control %q", probe.Name)
   127			}
   128			application.Applied = append(application.Applied, probe.Name)
   129		}
   130		if flags != 0 {
   131			job, err := newProbeJob(flags, limits)
   132			if err != nil {
   133				return nil, diagnosticErr(CodeControlUnavailable, err, "cannot create the private worker job object")
   134			}
   135			if err := windows.AssignProcessToJobObject(job, windows.CurrentProcess()); err != nil {
   136				_ = windows.CloseHandle(job)
   137				return nil, diagnosticErr(CodeControlUnavailable, err, "cannot assign the worker to its private job object")
   138			}
   139			workerJob.Lock()
   140			workerJob.handle = job
   141			workerJob.Unlock()
   142		}
   143		return application, nil
   144	}
