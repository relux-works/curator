    24	func artifactHasMultipleLinks(path string, _ fs.FileInfo) (bool, error) {
    25		encoded, err := windows.UTF16PtrFromString(path)
    26		if err != nil {
    27			return false, err
    28		}
    29		handle, err := windows.CreateFile(encoded, windows.GENERIC_READ, windows.FILE_SHARE_READ, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
    30		if err != nil {
    31			return false, err
    32		}
    33		defer windows.CloseHandle(handle)
    34		var info windows.ByHandleFileInformation
    35		if err := windows.GetFileInformationByHandle(handle, &info); err != nil {
    36			return false, err
    37		}
    38		return info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || info.NumberOfLinks != 1, nil
    39	}
    35	// Executor is the only process seam used by the package-independent driver.
    36	type Executor interface {
    37		Run(context.Context, Process) (Output, error)
    38	}
    39	
    40	// OSExecutor executes an absolute program directly, without a shell. A nil
    41	// cmd.Stdin causes os/exec to connect the child to the null device.
    42	type OSExecutor struct{}
    43	
    44	func (OSExecutor) Run(ctx context.Context, process Process) (Output, error) {
    45		runCtx, cancel := context.WithTimeout(ctx, process.Timeout)
    46		defer cancel()
    47	
    48		cmd := exec.CommandContext(runCtx, process.Executable, process.Arguments...) // #nosec G204 -- executable is independently trusted before this seam
    49		cmd.Dir = process.Directory
    50		cmd.Env = append([]string(nil), process.Environment...)
    51		cmd.Stdin = nil
    52		budget := &outputBudget{remaining: process.OutputLimit}
    53		stdout := &boundedBuffer{budget: budget}
    54		stderr := &boundedBuffer{budget: budget}
    55		cmd.Stdout = stdout
    56		cmd.Stderr = stderr
    57		err := cmd.Run()
    58		result := Output{Stdout: stdout.Bytes(), Stderr: stderr.Bytes()}
    59		if runCtx.Err() != nil {
    60			return result, errProcessTimeout
    61		}
    62		if errors.Is(stdout.err, errOutputLimit) || errors.Is(stderr.err, errOutputLimit) || errors.Is(budget.err, errOutputLimit) {
    63			return result, errOutputLimit
    64		}
    65		return result, err
    66	}
    67	
    68	type boundedBuffer struct {
    69		buffer bytes.Buffer
    70		budget *outputBudget
    71		err    error
    72	}
    73	
    74	type outputBudget struct {
    75		mu        sync.Mutex
    76		remaining int64
    77		err       error
    78	}
    79	
    80	func (buffer *boundedBuffer) Write(payload []byte) (int, error) {
    81		buffer.budget.mu.Lock()
    82		defer buffer.budget.mu.Unlock()
    83		if buffer.budget.remaining <= 0 {
    84			buffer.err = errOutputLimit
    85			buffer.budget.err = errOutputLimit
    86			return 0, buffer.err
    87		}
    88		written := len(payload)
    89		if int64(written) > buffer.budget.remaining {
    90			written = int(buffer.budget.remaining)
    91		}
    92		_, _ = buffer.buffer.Write(payload[:written])
    93		buffer.budget.remaining -= int64(written)
    94		if written != len(payload) {
    95			buffer.err = errOutputLimit
    96			buffer.budget.err = errOutputLimit
    97			return written, buffer.err
    98		}
    99		return written, nil
   100	}
   101	
   102	func (buffer *boundedBuffer) Bytes() []byte {
   103		return append([]byte(nil), buffer.buffer.Bytes()...)
   104	}
