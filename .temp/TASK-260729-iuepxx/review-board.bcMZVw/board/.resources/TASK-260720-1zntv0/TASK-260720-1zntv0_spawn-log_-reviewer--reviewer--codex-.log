func TestDirectiveScanFindsExactTokenAcrossReadBoundary(t *testing.T) {
	path := filepath.Join(t.TempDir(), "main.go")
	payload := append(bytes.Repeat([]byte{'x'}, 64*1024-5), forbiddenCompilerDirective...)
