func TestBuildUsesOnlyFixedListAndBuildWithHostPolicy(t *testing.T) {
	fixture := newBuildFixture(t)
	payload := encodePackages(t, fixture.rootPackage())
	executor := &recordingExecutor{run: func(index int, process Process) (Output, error) {
		switch index {
		case 0:
			return Output{Stdout: payload}, nil
		case 1:
			writeTestFile(t, process.Arguments[9], []byte("verified executable"), 0o600)
			return Output{}, nil
		default:
			t.Fatalf("unexpected executable call %d", index)
			return Output{}, nil
		}
	}}
	limits := ResourceLimits{Timeout: time.Second, OutputBytes: 64 * 1024, ArtifactBytes: 1024, DiskBytes: 8 * 1024 * 1024, MemoryBytes: 64 * 1024 * 1024, Processes: 8}
	artifact, err := Build(context.Background(), fixture.request(NewHostPolicy(executor), limits))
	if err != nil {
		t.Fatal(err)
	}
	if len(executor.calls) != 2 {
		t.Fatalf("calls = %d, want fixed list + build", len(executor.calls))
	}
	if !reflect.DeepEqual(executor.calls[0].Arguments, listArguments) {
		t.Fatalf("list argv = %q", executor.calls[0].Arguments)
	}
	wantBuild := []string{"build", "-mod=vendor", "-trimpath", "-buildvcs=false", "-buildmode=exe", "-compiler=gc", "-pgo=off", "-ldflags=-linkmode=internal -libgcc=none", "-o", artifact.StagedPath, "."}
	if !reflect.DeepEqual(executor.calls[1].Arguments, wantBuild) {
		t.Fatalf("build argv = %q", executor.calls[1].Arguments)
	}
	for _, call := range executor.calls {
		if call.Executable != fixture.session.Executable() || call.Directory != fixture.sourceDir || call.Timeout != limits.Timeout || call.OutputLimit != limits.OutputBytes {
			t.Fatalf("process = %+v", call)
		}
		assertFixedBuildEnvironment(t, call.Environment, fixture.session)
	}
	wantHash := sha256.Sum256([]byte("verified executable"))
	if artifact.Metadata.Path != filepath.ToSlash(filepath.Join("bin", "golden-tool")) || artifact.Metadata.Size != int64(len("verified executable")) || artifact.Metadata.SHA256 != "sha256:"+hex.EncodeToString(wantHash[:]) {
		t.Fatalf("artifact = %+v", artifact)
	}
	info, err := os.Lstat(artifact.StagedPath)
	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0o111 == 0 {
		t.Fatalf("artifact permissions/type = %v, %v", info, err)
	}
}

