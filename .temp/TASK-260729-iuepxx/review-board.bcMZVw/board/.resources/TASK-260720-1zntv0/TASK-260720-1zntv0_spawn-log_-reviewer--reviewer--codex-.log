   332	func verifyArtifact(stage, artifactPath, artifactRel string, limit int64) (buildmeta.Artifact, error) {
   333		entries, err := os.ReadDir(stage)
   334		if err != nil || len(entries) != 1 || entries[0].Name() != "bin" || !entries[0].IsDir() {
   335			return buildmeta.Artifact{}, diagnosticErr("artifact_output_invalid", err, "build staging contains an unexpected output")
   336		}
   337		binEntries, err := os.ReadDir(filepath.Join(stage, "bin"))
   338		if err != nil || len(binEntries) != 1 || filepath.Join(stage, "bin", binEntries[0].Name()) != artifactPath {
   339			return buildmeta.Artifact{}, diagnosticErr("artifact_output_invalid", err, "build did not produce exactly one derived output")
   340		}
   341		info, err := os.Lstat(artifactPath)
   342		if err != nil || !info.Mode().IsRegular() || info.Mode()&fs.ModeSymlink != 0 {
   343			return buildmeta.Artifact{}, diagnosticErr("artifact_special_file", err, "staged output is not a regular file")
   344		}
   345		if info.Size() < 0 || info.Size() > limit {
   346			return buildmeta.Artifact{}, diagnostic("artifact_size_limit", "staged output exceeds its artifact bound")
   347		}
   348		if err := applyArtifactPermissions(artifactPath); err != nil {
   349			return buildmeta.Artifact{}, diagnosticErr("artifact_permissions_failed", err, "cannot apply manager artifact permissions")
   350		}
   351		permissioned, err := os.Lstat(artifactPath)
   352		if err != nil || !permissioned.Mode().IsRegular() || !os.SameFile(info, permissioned) || permissioned.Size() != info.Size() {
   353			return buildmeta.Artifact{}, diagnosticErr("artifact_mutated", err, "staged output changed while applying permissions")
   354		}
   355		multiple, err := artifactHasMultipleLinks(artifactPath, permissioned)
   356		if err != nil {
   357			return buildmeta.Artifact{}, diagnosticErr("artifact_unreadable", err, "cannot inspect staged output link count")
   358		}
   359		if multiple {
   360			return buildmeta.Artifact{}, diagnostic("artifact_link", "staged output has multiple filesystem links")
   361		}
   362		file, err := os.Open(artifactPath) // #nosec G304 -- path is manager-derived inside private staging
   363		if err != nil {
   364			return buildmeta.Artifact{}, diagnosticErr("artifact_unreadable", err, "cannot open staged output")
   365		}
   338	func TestHostPolicyRejectsEveryAttemptToWidenExecution(t *testing.T) {
   339		for _, testCase := range []struct {
   340			name, code string
   341			mutate     func(*HostExecution)
   342		}{
   343			{name: "another executable", code: "unexpected_child_process", mutate: func(execution *HostExecution) { execution.Process.Executable = os.Args[0] }},
   344			{name: "another argv", code: "unexpected_go_arguments", mutate: func(execution *HostExecution) { execution.Process.Arguments = []string{"run", "."} }},
   345			{name: "network permitted", code: "host_policy_invalid", mutate: func(execution *HostExecution) { execution.NetworkDenied = false }},
   346			{name: "poisoned variable", code: "process_environment_poisoned", mutate: func(execution *HostExecution) {
   347				execution.Process.Environment = append(execution.Process.Environment, "GOAUTH=netrc")
   348			}},
   349			{name: "writable source", code: "host_policy_invalid", mutate: func(execution *HostExecution) {
   350				execution.WritableRoots = append(execution.WritableRoots, execution.ReadOnlyRoots[0])
   351			}},
   352		} {
   353			t.Run(testCase.name, func(t *testing.T) {
   354				fixture := newBuildFixture(t)
   355				executor := &recordingExecutor{run: func(_ int, _ Process) (Output, error) {
   356					t.Fatal("guarded executor started after policy widening")
   357					return Output{}, nil
   358				}}
   359				guarded := NewHostPolicy(executor)
   360				policy := hostPolicyFunc(func(ctx context.Context, execution HostExecution) (Output, error) {
   361					testCase.mutate(&execution)
   362					return guarded.Run(ctx, execution)
   363				})
   364				_, err := Build(context.Background(), fixture.request(policy, ResourceLimits{}))
   365				if DiagnosticCode(err) != testCase.code || len(executor.calls) != 0 {
   366					t.Fatalf("error/calls = %v/%d", err, len(executor.calls))
   367				}
   368			})
   369		}
   370	}
