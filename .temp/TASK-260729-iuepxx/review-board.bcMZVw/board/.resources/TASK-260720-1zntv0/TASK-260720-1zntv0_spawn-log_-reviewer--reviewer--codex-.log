	if err != nil {
		t.Fatal(err)
	}
	defer token.Close()
	chmodSnapshot(t, snapshot, 0o555, 0o444)
	defer chmodSnapshot(t, snapshot, 0o755, 0o644)

	config := ConfigFromEnvironment(t.TempDir(), snapshot)
	config.CuratorGo = filepath.Join(runtime.GOROOT(), "bin", platformGoName)
	session, err := Establish(context.Background(), config)
	if err != nil {
		t.Fatal(err)
	}
	defer session.Close()

	delegate := NewHostPolicy(nil)
	var calls []HostExecution
	policy := hostPolicyFunc(func(ctx context.Context, execution HostExecution) (Output, error) {
		calls = append(calls, execution)
		return delegate.Run(ctx, execution)
	})
	artifact, err := Build(context.Background(), BuildRequest{
		Session: session, Source: token, BuildRoot: buildRootRel, SourceDir: sourceDirRel, Command: "golden-tool", Policy: policy,
		Limits: ResourceLimits{Timeout: 30 * time.Second, OutputBytes: 2 * 1024 * 1024, ArtifactBytes: 16 * 1024 * 1024, DiskBytes: 256 * 1024 * 1024, MemoryBytes: defaultMemoryLimit, Processes: defaultProcessLimit},
	})
	if err != nil {
		t.Fatal(err)
	}
	if len(calls) != 2 || !reflect.DeepEqual(calls[0].Process.Arguments, listArguments) || calls[1].Process.Arguments[0] != "build" {
		t.Fatalf("direct process graph = %+v", calls)
	}
	if artifact.Metadata.Size <= 0 || artifact.Metadata.Size > 16*1024*1024 || artifact.Metadata.SHA256 == "" {
		t.Fatalf("artifact = %+v", artifact)
	}
	// Deliberately do not execute artifact.StagedPath. Two direct Go calls are
	// the complete source-aware graph observed by the host-policy boundary.
}

func chmodSnapshot(t *testing.T, root string, directoryMode, fileMode os.FileMode) {
	t.Helper()
	if err := filepath.WalkDir(root, func(path string, entry os.DirEntry, err error) error {
		if err != nil {
			return err
		}
		mode := fileMode
		if entry.IsDir() {
			mode = directoryMode
		}
		return os.Chmod(path, mode)
	}); err != nil {
		t.Fatal(err)
	}
}

type hostPolicyFunc func(context.Context, HostExecution) (Output, error)

func (function hostPolicyFunc) Run(ctx context.Context, execution HostExecution) (Output, error) {
	return function(ctx, copyHostExecution(execution))
}

type buildFixture struct {
	t         *testing.T
	root      string
	buildRoot string
	sourceDir string
	token     *buildsource.Token
	session   *Session
}

func newBuildFixture(t *testing.T) *buildFixture {
	t.Helper()
	snapshot := filepath.Join(t.TempDir(), "snapshot")
	buildRoot := filepath.Join(snapshot, "build")
	sourceDir := filepath.Join(buildRoot, "cmd", "tool")
	writeTestFile(t, filepath.Join(buildRoot, "go.mod"), []byte("module example.test/build\n\ngo 1.23\n"), 0o644)
	writeTestFile(t, filepath.Join(sourceDir, "main.go"), []byte("package main\nfunc main() {}\n"), 0o644)
	snapshot = mustPhysical(t, snapshot)
	buildRoot = filepath.Join(snapshot, "build")
	sourceDir = filepath.Join(buildRoot, "cmd", "tool")
	token, err := buildsource.Validate(snapshot)
	if err != nil {
		t.Fatal(err)
	}
	toolchain := testToolchain(t)
	host := hostFacts{runtimeGOROOT: toolchain, goos: runtime.GOOS, goarch: runtime.GOARCH}
	session, err := establish(context.Background(), Config{PrivateBase: t.TempDir(), CuratorGo: filepath.Join(toolchain, "bin", platformGoName), Executor: validProbeExecutor(t, toolchain, host)}, host)
	if err != nil {
		t.Fatal(err)
	}
	fixture := &buildFixture{t: t, root: snapshot, buildRoot: buildRoot, sourceDir: sourceDir, token: token, session: session}
	fixture.makeReadOnly()
	t.Cleanup(func() {
		fixture.makeWritable()
		_ = fixture.token.Close()
		_ = session.Close()
	})
	return fixture
}

func (fixture *buildFixture) request(policy HostPolicy, limits ResourceLimits) BuildRequest {
	return BuildRequest{Session: fixture.session, Source: fixture.token, BuildRoot: "build", SourceDir: "build/cmd/tool", Command: "golden-tool", Policy: policy, Limits: limits}
}

func (fixture *buildFixture) rootPackage() packageJSON {
	return packageJSON{
		Dir: fixture.sourceDir, ImportPath: "example.test/build/cmd/tool", Name: "main", GoFiles: []string{"main.go"},
		Module: &moduleJSON{Path: "example.test/build", Main: true, Dir: fixture.buildRoot, GoMod: filepath.Join(fixture.buildRoot, "go.mod"), GoVersion: "1.23"},
	}
}

func (fixture *buildFixture) makeReadOnly() { fixture.chmodTree(0o555, 0o444) }
func (fixture *buildFixture) makeWritable() { fixture.chmodTree(0o755, 0o644) }

func (fixture *buildFixture) refreshToken() {
	fixture.t.Helper()
	_ = fixture.token.Close()
	token, err := buildsource.Validate(fixture.root)
	if err != nil {
		fixture.t.Fatal(err)
	}
	fixture.token = token
}

func (fixture *buildFixture) chmodTree(directoryMode, fileMode os.FileMode) {
	fixture.t.Helper()
	_ = filepath.WalkDir(fixture.root, func(path string, entry os.DirEntry, err error) error {
		if err != nil {
			return err
		}
		mode := fileMode
		if entry.IsDir() {
			mode = directoryMode
		}
		return os.Chmod(path, mode)
	})
}

func encodePackages(t *testing.T, packages ...packageJSON) []byte {
	t.Helper()
	var payload []byte
	for _, item := range packages {
		encoded, err := json.Marshal(item)
		if err != nil {
			t.Fatal(err)
		}
		payload = append(payload, encoded...)
		payload = append(payload, '\n')
	}
	return payload
}

func assertFixedBuildEnvironment(t *testing.T, environment []string, session *Session) {
	t.Helper()
	if !reflect.DeepEqual(environment, session.Environment()) {
		t.Fatalf("environment changed\n got: %q\nwant: %q", environment, session.Environment())
	}
	values := environmentMap(environment)
	for key, want := range map[string]string{"GOPROXY": "off", "GOSUMDB": "off", "GOVCS": "*:off", "GOWORK": "off", "GOTOOLCHAIN": "local", "CGO_ENABLED": "0", "GO_EXTLINK_ENABLED": "0", "PATH": values["PATH"]} {
		if values[key] != want {
			t.Fatalf("%s = %q, want %q", key, values[key], want)
		}
	}
	if entries, err := os.ReadDir(values["PATH"]); err != nil || len(entries) != 0 {
		t.Fatalf("PATH is not empty/private: %v %v", entries, err)
	}
}
package godriver

import (
	"encoding/json"
	"os"
	"path/filepath"
	"reflect"
	"testing"
)

func TestCandidateGoV1SourceAwareContract(t *testing.T) {
	root := os.Getenv("CURATOR_CONFORMANCE_ROOT")
	if root == "" {
		t.Skip("CURATOR_CONFORMANCE_ROOT is not set")
	}
	payload, err := os.ReadFile(filepath.Join(root, "vectors", "build-drivers.json")) // #nosec G304 -- explicit candidate conformance input
	if err != nil {
		t.Fatal(err)
	}
	var vectors struct {
		Driver           string            `json:"driver"`
		FixedEnvironment map[string]string `json:"fixed_environment"`
		Argv             []struct {
			Name string   `json:"name"`
			Argv []string `json:"argv"`
		} `json:"argv"`
		Rejections []struct {
			Name     string `json:"name"`
			Boundary string `json:"boundary"`
			Expected struct {
				Error string `json:"error"`
			} `json:"expected"`
		} `json:"rejection_cases"`
	}
	if err := json.Unmarshal(payload, &vectors); err != nil {
		t.Fatal(err)
	}
	if vectors.Driver != "go-v1" || len(vectors.Argv) != 5 {
		t.Fatalf("candidate driver/argv = %q/%d", vectors.Driver, len(vectors.Argv))
	}
	if !reflect.DeepEqual(vectors.Argv[3].Argv[1:], listArguments) {
		t.Fatalf("candidate list argv = %q, implementation = %q", vectors.Argv[3].Argv[1:], listArguments)
	}
	wantBuild := []string{"build", "-mod=vendor", "-trimpath", "-buildvcs=false", "-buildmode=exe", "-compiler=gc", "-pgo=off", "-ldflags=-linkmode=internal -libgcc=none", "-o"}
	if len(vectors.Argv[4].Argv) != 12 || !reflect.DeepEqual(vectors.Argv[4].Argv[1:10], wantBuild) || vectors.Argv[4].Argv[11] != "." {
		t.Fatalf("candidate build argv = %q", vectors.Argv[4].Argv)
	}
	for key, want := range map[string]string{
		"GOENV": "off", "GOTOOLCHAIN": "local", "GOFLAGS": "", "GOPROXY": "off", "GOSUMDB": "off", "GOVCS": "*:off",
		"GOWORK": "off", "CGO_ENABLED": "0", "GO_EXTLINK_ENABLED": "0", "GOEXPERIMENT": "", "PATH": "<operation-private>/empty-path",
	} {
		if vectors.FixedEnvironment[key] != want {
			t.Fatalf("candidate fixed environment %s = %q, want %q", key, vectors.FixedEnvironment[key], want)
		}
	}

	wantRejections := map[string]string{
		"non-main-package": "build_package_not_main", "multiple-packages": "build_package_ambiguous",
		"missing-vendored-dependency": "vendor_dependency_missing", "inconsistent-vendor-modules": "vendor_metadata_inconsistent",
		"workspace-only-dependency": "workspace_dependency_forbidden", "toolchain-switch-request": "toolchain_switch_forbidden",
		"cgo-only-package": "cgo_required", "native-c-input": "go_native_input_forbidden", "native-cxx-input": "go_native_input_forbidden",
		"native-swig-input": "go_native_input_forbidden", "root-syso": "go_syso_forbidden", "transitive-syso": "go_syso_forbidden",
		"root-assembly-absolute-include": "go_assembly_forbidden", "transitive-assembly-escaping-include": "go_assembly_forbidden",
		"escaped-embed-input": "go_embed_input_escape", "cgo-import-dynamic": "go_forbidden_compiler_directive",
		"attempted-go-generate": "go_generator_forbidden", "default-pgo": "go_pgo_forbidden",
		"poisoned-path": "process_environment_poisoned", "inherited-goflags-toolexec": "process_environment_poisoned",
		"inherited-goenv": "process_environment_poisoned", "inherited-gowork": "process_environment_poisoned",
		"external-link-required": "external_link_forbidden", "libgcc-fallback-attempt": "libgcc_fallback_forbidden",
		"child-outside-goroot-tools": "unexpected_child_process", "toolchain-digest-mismatch": "toolchain_digest_mismatch",
	}
	seen := make(map[string]string, len(vectors.Rejections))
	for _, rejection := range vectors.Rejections {
		seen[rejection.Name] = rejection.Expected.Error
	}
	for name, code := range wantRejections {
		if seen[name] != code {
			t.Fatalf("candidate rejection %s = %q, want %q", name, seen[name], code)
		}
	}
}
