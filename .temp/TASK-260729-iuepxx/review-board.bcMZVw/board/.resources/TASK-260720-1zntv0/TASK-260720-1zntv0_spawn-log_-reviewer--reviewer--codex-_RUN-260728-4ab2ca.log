    19	// injectControlSeamFault installs a real failure at exactly one seam of the
    20	// manager-owned control domain for the duration of one test.
    21	func injectControlSeamFault(t *testing.T, target controlSeam) *int {
    22		t.Helper()
    23		if controlSeamFault != nil {
    24			t.Fatal("a control seam fault is already installed")
    25		}
    26		fired := 0
    27		controlSeamFault = func(seam controlSeam) error {
    28			if seam != target {
    29				return nil
    30			}
    31			fired++
    32			return errors.New("injected " + string(seam) + " failure")
    33		}
    34		t.Cleanup(func() { controlSeamFault = nil })
    35		return &fired
    36	}
