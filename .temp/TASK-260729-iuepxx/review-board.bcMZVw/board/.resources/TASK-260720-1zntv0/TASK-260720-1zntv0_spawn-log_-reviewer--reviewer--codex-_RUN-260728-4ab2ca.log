   274	// validatePackageCommandSurface rejects every package attempt to reach the
   275	// execution boundary before any private state is created.
   276	func validatePackageCommandSurface(request BuildRequest) error {
   277		object := request.CommandObject
   278		if object == nil {
   279			return diagnostic(CodePackageInfluenceForbidden, "the package build-command surface was not presented for validation")
   280		}
   281		extra := make([]string, 0, len(object))
   282		for key := range object {
   283			switch key {
   284			case "type", "driver", "source_dir":
   285			default:
   286				extra = append(extra, key)
   287			}
   288		}
   289		if len(extra) != 0 {
   290			sort.Strings(extra)
   291			surface := packageInfluenceSurfaces[extra[0]]
   292			if surface == "" {
   293				surface = "execution boundary, worker, controls, limits, permits, or publication"
   294			}
   295			return diagnostic(CodePackageInfluenceForbidden,
   296				"package build command declares %q, which selects the %s", extra[0], surface)
   297		}
   298		if value, _ := object["type"].(string); value != "build" {
   299			return diagnostic(CodePackageInfluenceForbidden, "package build command type %q is not the closed build type", value)
   300		}
   301		if value, _ := object["driver"].(string); value != buildmeta.DriverGoV1 {
   302			return diagnostic(CodePackageInfluenceForbidden, "package build command driver %q is not the closed go-v1 driver", value)
   303		}
   304		if value, _ := object["source_dir"].(string); value != request.SourceDir {
   305			return diagnostic(CodePackageInfluenceForbidden, "package build command source_dir %q does not match the validated command", value)
   306		}
   307		return nil
   308	}
