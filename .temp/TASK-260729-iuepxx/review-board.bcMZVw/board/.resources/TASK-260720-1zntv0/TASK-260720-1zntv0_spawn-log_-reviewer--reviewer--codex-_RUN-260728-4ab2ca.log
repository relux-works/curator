    15	// fileLimitMutex serializes the manager-side RLIMIT_FSIZE window. The soft
    16	// bound is process-wide, so probing and the launch window must not overlap.
    17	var fileLimitMutex sync.Mutex
    18	
    19	// wantedFileLimit is the exact per-file soft bound this operation installs. It
    20	// is derived from the manager-owned limit alone, clamped to the inherited hard
    21	// bound, so the parent and the worker compute the same value.
    22	func wantedFileLimit(limits ResourceLimits) (uint64, error) {
    23		if limits.FileBytes <= 0 {
    24			return 0, fmt.Errorf("the per-file byte bound is not positive")
    25		}
    26		var current unix.Rlimit
    27		if err := unix.Getrlimit(unix.RLIMIT_FSIZE, &current); err != nil {
    28			return 0, err
    29		}
    30		wanted := uint64(limits.FileBytes) // #nosec G115 -- normalizeBuildLimits bounds this to a positive value below defaultFileLimit
    31		if current.Max != unix.RLIM_INFINITY && wanted > current.Max {
    32			wanted = current.Max
    33		}
    34		return wanted, nil
    35	}
