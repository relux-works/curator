   244	// validateProbeSet is the worker's defence in depth over the probe record it was
   245	// handed. The normative availability decision already happened in the parent
   246	// before this process was released to execute, so a probe record that
   247	// contradicts rc5-native-control-inventory-v1 here is an evidence fault and
   248	// never a mandatory-control rejection.
   249	func validateProbeSet(platform string, probes []ControlProbe) error {
   250		records := nativeControlPlatforms[platform]
   251		if records == nil {
   252			return diagnostic(CodeCapabilityEvidenceInvalid, "no native-control inventory record for platform %q", platform)
   253		}
   254		if len(probes) != len(nativeControlInventory) {
   255			return diagnostic(CodeCapabilityEvidenceInvalid, "request carries %d probes, want exactly the inventory", len(probes))
   256		}
   257		for index, probe := range probes {
   258			if probe.Name != nativeControlInventory[index] {
   259				return diagnostic(CodeCapabilityEvidenceInvalid, "probe %d is %q, want %q", index, probe.Name, nativeControlInventory[index])
   260			}
   261			if probe.ProbedAt != ProbeTiming {
   262				return diagnostic(CodeCapabilityEvidenceInvalid, "probe %q reports probed_at %q", probe.Name, probe.ProbedAt)
   263			}
   264			record := records[probe.Name]
   265			switch probe.Availability {
   266			case AvailabilityAvailable:
   267				if record.Availability != AvailabilityAvailable {
   268					return diagnostic(CodeCapabilityEvidenceInvalid,
   269						"probe claims %q is available, but rc5-native-control-inventory-v1 marks it unavailable on %s", probe.Name, platform)
   270				}
   271			case AvailabilityUnavailable:
   272				if record.Availability == AvailabilityAvailable {
   273					return diagnostic(CodeCapabilityEvidenceInvalid,
   274						"rc5-native-control-inventory-v1 marks %q available on %s but the request reports it unavailable", probe.Name, platform)
   275				}
   276			default:
   277				return diagnostic(CodeCapabilityEvidenceInvalid, "probe %q reports availability %q", probe.Name, probe.Availability)
   278			}
   279		}
   280		return nil
   281	}
