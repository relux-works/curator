   288	// evidenceFromApplied builds the closed record from this operation's probes and
   289	// the controls whose mechanism is actually installed. The manager parent derives
   290	// it only after the control domain is complete, so status applied is never
   291	// reported for a mechanism that has not been installed; the worker derives the
   292	// same record independently from what it confirms, and the parent requires the
   293	// two to be identical.
   294	func evidenceFromApplied(platform string, probes []ControlProbe, applied []string) CapabilityEvidence {
   295		appliedSet := make(map[string]bool, len(applied))
   296		for _, name := range applied {
   297			appliedSet[name] = true
   298		}
   299		record := CapabilityEvidence{
   300			RecordVersion:   CapabilityEvidenceVersion,
   301			ExecutionPolicy: ExecutionPolicy,
   302			Platform:        platform,
   303			Controls:        make([]CapabilityEvidenceEntry, 0, len(probes)),
   304		}
   305		for _, probe := range probes {
   306			status := StatusUnavailable
   307			if probe.Availability == AvailabilityAvailable && appliedSet[probe.Name] {
   308				status = StatusApplied
   309			} else if probe.Availability == AvailabilityAvailable {
   310				// An available control the worker did not apply is a contradiction;
   311				// record it faithfully so validation rejects it instead of hiding it.
   312				status = StatusUnavailable
   313			}
   314			record.Controls = append(record.Controls, CapabilityEvidenceEntry{
   315				Name: probe.Name, Availability: probe.Availability, Status: status, ProbedAt: probe.ProbedAt,
   316			})
   317		}
   318		return record
   319	}
   320	
   321	// validateCapabilityEvidence enforces the eight closed consistency rules. The
   322	// probes are this operation's parent-side determination; a record that reports
   323	// an availability the operation did not probe is rejected.
   324	func validateCapabilityEvidence(record CapabilityEvidence, platform string, probes []ControlProbe) error {
   325		if record.ExecutionPolicy != ExecutionPolicy {
   326			return diagnostic(CodeHardenedClaimForbidden,
   327				"capability evidence execution_policy %q is not the portable identity %q", record.ExecutionPolicy, ExecutionPolicy)
   328		}
   329		for _, entry := range record.Controls {
   330			if isDeferredHardenedGuarantee(entry.Name) {
   331				return diagnostic(CodeHardenedClaimForbidden,
   332					"capability evidence names deferred hardened guarantee %q", entry.Name)
   333			}
   334		}
   335		if record.RecordVersion != CapabilityEvidenceVersion {
   336			return diagnostic(CodeCapabilityEvidenceInvalid,
   337				"unknown capability evidence record_version %q", record.RecordVersion)
   338		}
   339		if record.Platform != platform || nativeControlPlatforms[record.Platform] == nil {
   340			return diagnostic(CodeCapabilityEvidenceInvalid,
   341				"capability evidence platform %q is not the probed platform %q", record.Platform, platform)
   342		}
   343		probed := make(map[string]string, len(probes))
   344		for _, probe := range probes {
   345			probed[probe.Name] = probe.Availability
   346		}
   347		seen := make(map[string]bool, len(record.Controls))
   348		for _, entry := range record.Controls {
   349			if !inInventory(entry.Name) {
   350				return diagnostic(CodeCapabilityEvidenceInvalid,
   351					"capability evidence reports control %q outside rc5-native-control-inventory-v1", entry.Name)
   352			}
   353			if seen[entry.Name] {
   354				return diagnostic(CodeCapabilityEvidenceInvalid, "capability evidence duplicates control %q", entry.Name)
   355			}
   356			seen[entry.Name] = true
   357			if entry.ProbedAt != ProbeTiming {
   358				return diagnostic(CodeCapabilityEvidenceInvalid,
   359					"capability evidence control %q reports probed_at %q", entry.Name, entry.ProbedAt)
   360			}
   361			availability, present := probed[entry.Name]
   362			if !present || entry.Availability != availability {
   363				return diagnostic(CodeCapabilityEvidenceInvalid,
   364					"capability evidence control %q reports availability %q that this operation did not probe", entry.Name, entry.Availability)
   365			}
   366			switch entry.Availability {
   367			case AvailabilityAvailable:
   368				if entry.Status != StatusApplied {
   369					return diagnostic(CodeCapabilityEvidenceInvalid,
   370						"available control %q reports status %q", entry.Name, entry.Status)
   371				}
   372			case AvailabilityUnavailable:
   373				if entry.Status != StatusUnavailable {
   374					return diagnostic(CodeCapabilityEvidenceInvalid,
   375						"unavailable control %q reports status %q", entry.Name, entry.Status)
   376				}
   377			default:
   378				return diagnostic(CodeCapabilityEvidenceInvalid,
   379					"control %q reports availability %q", entry.Name, entry.Availability)
   380			}
   381		}
   382		if len(seen) != len(nativeControlInventory) {
   383			missing := make([]string, 0, len(nativeControlInventory))
   384			for _, control := range nativeControlInventory {
   385				if !seen[control] {
   386					missing = append(missing, control)
   387				}
   388			}
   389			sort.Strings(missing)
   390			return diagnostic(CodeCapabilityEvidenceInvalid,
   391				"capability evidence is missing exactly one entry per inventory control: %v", missing)
   392		}
   393		return nil
   394	}

