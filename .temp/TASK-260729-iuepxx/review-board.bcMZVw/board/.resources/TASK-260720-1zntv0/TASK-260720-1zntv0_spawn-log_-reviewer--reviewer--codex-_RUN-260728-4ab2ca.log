    37	// probeNativeControl performs the per-operation availability determination for
    38	// one macOS inventory control. It performs the exact operation the control will
    39	// perform for this build, starts no program, and caches nothing.
    40	func probeNativeControl(name string, limits ResourceLimits) (bool, error) {
    41		switch name {
    42		case ControlDescendantDomainTermination:
    43			// Session and process-group teardown requires a usable process group and
    44			// permission to signal it. Signal 0 performs the permission check only.
    45			// The private session itself is created by the kernel between fork and
    46			// exec, so it cannot fail once the worker is executing.
    47			group, err := unix.Getpgid(0)
    48			if err != nil {
    49				return false, err
    50			}
    51			if err := unix.Kill(-group, 0); err != nil {
    52				return false, err
    53			}
    54			return true, nil
    55		case ControlPerFileSizeLimit:
    56			// Prove the exact byte bound this operation will install is settable,
    57			// then restore the manager's own bound immediately.
    58			wanted, err := wantedFileLimit(limits)
    59			if err != nil {
    60				return false, err
    61			}
    62			fileLimitMutex.Lock()
    63			defer fileLimitMutex.Unlock()
    64			var previous unix.Rlimit
    65			if err := unix.Getrlimit(unix.RLIMIT_FSIZE, &previous); err != nil {
    66				return false, err
    67			}
    68			if err := unix.Setrlimit(unix.RLIMIT_FSIZE, &unix.Rlimit{Cur: wanted, Max: previous.Max}); err != nil {
    69				return false, err
    70			}
    71			var applied unix.Rlimit
    72			readErr := unix.Getrlimit(unix.RLIMIT_FSIZE, &applied)
    73			restoreErr := unix.Setrlimit(unix.RLIMIT_FSIZE, &previous)
    74			if restoreErr != nil {
    75				return false, restoreErr
    76			}
    77			if readErr != nil {
    78				return false, readErr
    79			}
    80			return applied.Cur == wanted, nil
    81		case ControlInheritedHandleRestriction:
    82			// Close-on-exec must be readable and settable for the descriptors the
    83			// worker holds when the compiler starts.
    84			var pair [2]int
    85			if err := unix.Pipe(pair[:]); err != nil {
    86				return false, err
    87			}
    88			defer func() {
    89				_ = unix.Close(pair[0])
    90				_ = unix.Close(pair[1])
    91			}()
    92			flags, err := unix.FcntlInt(uintptr(pair[0]), unix.F_GETFD, 0)
    93			if err != nil {
    94				return false, err
    95			}
    96			if _, err := unix.FcntlInt(uintptr(pair[0]), unix.F_SETFD, flags|unix.FD_CLOEXEC); err != nil {
    97				return false, err
    98			}
    99			return true, nil
   100		default:
   101			return false, fmt.Errorf("no macOS probe for inventory control %q", name)
   102		}
   103	}
   104	
   105	// controlDomain is the manager-owned macOS control domain. Every mechanism is
   106	// installed by the parent: the private session by the kernel between fork and
   107	// exec, and the per-file bound by lowering RLIMIT_FSIZE across the fork so the
   108	// worker and every descendant inherit it. Nothing is applied after the worker
   109	// begins executing, so CodeControlUnavailable cannot first appear there.
   110	type controlDomain struct {
   111		controls  []string
   112		session   bool
   113		fileBound bool
   114		fileBytes uint64
   115		installed bool
   116	}
   117	
   118	// prepareControlDomain builds the macOS domain from this operation's probes. It
   119	// creates no process and rejects with CodeControlUnavailable before the worker
   120	// exists.
   121	func prepareControlDomain(limits ResourceLimits, probes []ControlProbe) (*controlDomain, error) {
   122		if err := seamFault(seamPrepare); err != nil {
   123			return nil, diagnosticErr(CodeControlUnavailable, err, "cannot create the manager-owned native control domain")
   124		}
   125		domain := &controlDomain{}
   126		for _, name := range installableControls(probes) {
   127			switch name {
   128			case ControlDescendantDomainTermination:
   129				domain.session = true
   130			case ControlPerFileSizeLimit:
   131				bytes, err := wantedFileLimit(limits)
   132				if err != nil {
   133					return nil, diagnosticErr(CodeControlUnavailable, err, "cannot derive the per-file byte bound")
   134				}
   135				domain.fileBound, domain.fileBytes = true, bytes
   136			case ControlInheritedHandleRestriction:
   137				// Installed at fork and exec: the manager passes exactly the three
   138				// standard descriptors and no extra file, and the Go runtime opens
   139				// every other descriptor close-on-exec.
   140			default:
   141				return nil, diagnostic(CodeControlUnavailable, "no macOS mechanism for inventory control %q", name)
   142			}
   143			domain.controls = append(domain.controls, name)
   144		}
   145		return domain, nil
   146	}
   147	
   148	// launch starts the identity-verified worker with every probed-available macOS
   149	// control already installed. The last installation step happens before fork, so
   150	// a failure here leaves no worker process at all.
   151	func (domain *controlDomain) launch(command *exec.Cmd) error {
   152		if err := seamFault(seamInstall); err != nil {
   153			return diagnosticErr(CodeControlUnavailable, err, "cannot install the manager-owned native control domain")
   154		}
   155		if command.SysProcAttr == nil {
   156			command.SysProcAttr = &syscall.SysProcAttr{}
   157		}
   158		// A private session makes the worker its own process-group leader, so one
   159		// killpg terminates the complete worker domain and no descendant can outlive
   160		// it by changing groups first.
   161		command.SysProcAttr.Setsid = domain.session
   162		if !domain.fileBound {
   163			if err := command.Start(); err != nil {
   164				return diagnosticErr(CodeWorkerIdentityInvalid, err, "cannot start the identity-verified worker")
   165			}
   166			domain.installed = true
   167			return nil
   168		}
   169	
   170		fileLimitMutex.Lock()
   171		var previous unix.Rlimit
   172		if err := unix.Getrlimit(unix.RLIMIT_FSIZE, &previous); err != nil {
   173			fileLimitMutex.Unlock()
   174			return diagnosticErr(CodeControlUnavailable, err, "cannot read RLIMIT_FSIZE")
   175		}
   176		if err := unix.Setrlimit(unix.RLIMIT_FSIZE, &unix.Rlimit{Cur: domain.fileBytes, Max: previous.Max}); err != nil {
   177			fileLimitMutex.Unlock()
   178			return diagnosticErr(CodeControlUnavailable, err, "cannot apply RLIMIT_FSIZE to the worker domain")
   179		}
   180		startErr := command.Start()
   181		restoreErr := unix.Setrlimit(unix.RLIMIT_FSIZE, &previous)
   182		fileLimitMutex.Unlock()
   183	
   184		if startErr != nil {
   185			return diagnosticErr(CodeWorkerIdentityInvalid, startErr, "cannot start the identity-verified worker")
   186		}
   187		if restoreErr != nil {
   188			domain.destroy(command)
   189			return diagnosticErr(CodeControlUnavailable, restoreErr, "cannot restore the manager RLIMIT_FSIZE after the worker fork")
   190		}
   191		domain.installed = true
   192		return nil
   193	}
   194	
   195	// installedControls reports the controls whose mechanism is in place. It is
   196	// empty until the domain has been installed, so evidence can never claim an
   197	// applied status before installation.
   198	func (domain *controlDomain) installedControls() []string {
   199		if domain == nil || !domain.installed {
   200			return nil
   201		}
   202		return append([]string(nil), domain.controls...)
   203	}
   204	
   205	// destroy terminates a worker that was never released to run its session.
   206	func (domain *controlDomain) destroy(command *exec.Cmd) {
   207		terminateWorkerDomain(command)
   208		if command != nil && command.Process != nil {
   209			_ = command.Wait()
   210		}
   211	}
   212	
   213	// close releases the domain. macOS holds no kernel object beyond the session,
   214	// which is torn down with the process group.
   215	func (domain *controlDomain) close() {}
   216	
   217	// observeNativeControls runs inside the worker. It confirms that every control
   218	// the parent installed is really in effect here and completes the worker's own
   219	// descriptor duty. It applies no availability decision: a contradiction is an
   220	// evidence fault, never a mandatory-control rejection.
   221	func observeNativeControls(limits ResourceLimits, probes []ControlProbe, protocol []*os.File) ([]string, error) {
   222		confirmed := make([]string, 0, len(probes))
   223		for _, name := range installableControls(probes) {
   224			switch name {
   225			case ControlDescendantDomainTermination:
   226				group, err := unix.Getpgid(0)
   227				if err != nil || group != os.Getpid() {
   228					return nil, diagnosticErr(CodeCapabilityEvidenceInvalid, err,
   229						"the worker is not the leader of its private session and process group")
   230				}
   231			case ControlPerFileSizeLimit:
   232				wanted, err := wantedFileLimit(limits)
   233				if err != nil {
   234					return nil, diagnosticErr(CodeCapabilityEvidenceInvalid, err, "cannot derive the per-file byte bound")
   235				}
   236				var applied unix.Rlimit
   237				if err := unix.Getrlimit(unix.RLIMIT_FSIZE, &applied); err != nil || applied.Cur != wanted {
   238					return nil, diagnosticErr(CodeCapabilityEvidenceInvalid, err,
   239						"RLIMIT_FSIZE is %d in the worker, want the installed bound %d", applied.Cur, wanted)
   240				}
   241			case ControlInheritedHandleRestriction:
   242				if err := releaseInheritedDescriptors(protocol); err != nil {
   243					return nil, diagnosticErr(CodeCapabilityEvidenceInvalid, err,
   244						"cannot confirm close-on-exec on the worker protocol descriptors")
   245				}
   246			default:
   247				return nil, diagnostic(CodeCapabilityEvidenceInvalid, "no macOS confirmation for inventory control %q", name)
   248			}
   249			confirmed = append(confirmed, name)
   250		}
   251		return confirmed, nil
   252	}
   253	
   254	// releaseInheritedDescriptors proves close-on-exec is set on the descriptors the
   255	// worker still holds, so the compiler inherits none of them.
   256	func releaseInheritedDescriptors(keep []*os.File) error {
   257		for _, file := range keep {
   258			if file == nil {
   259				continue
   260			}
   261			flags, err := unix.FcntlInt(file.Fd(), unix.F_GETFD, 0)
   262			if err != nil {
   263				return err
   264			}
   265			if flags&unix.FD_CLOEXEC == 0 {
   266				if _, err := unix.FcntlInt(file.Fd(), unix.F_SETFD, flags|unix.FD_CLOEXEC); err != nil {
   267					return err
   268				}
   269			}
   270			confirmed, err := unix.FcntlInt(file.Fd(), unix.F_GETFD, 0)
   271			if err != nil || confirmed&unix.FD_CLOEXEC == 0 {
   272				return fmt.Errorf("descriptor %d is not close-on-exec", file.Fd())
   273			}
   274		}
   275		return nil
   276	}
   277	
   278	// compilerSysProcAttr keeps the compiler inside the worker's process group and
   279	// session so one killpg terminates the complete domain, and adds no inherited
   280	// descriptor.
   281	func compilerSysProcAttr() *syscall.SysProcAttr { return &syscall.SysProcAttr{} }
   282	
   283	// workerSysProcAttr is the base attribute set of the worker launch. The control
   284	// domain adds the private session before the manager forks.
   285	func workerSysProcAttr() *syscall.SysProcAttr { return &syscall.SysProcAttr{} }
   286	
   287	// terminateWorkerDomain kills the worker's process group first so no compiler
   288	// or tool child outlives the operation, then the worker process itself.
   289	func terminateWorkerDomain(command *exec.Cmd) {
   290		if command == nil || command.Process == nil {
   291			return
   292		}
   293		pid := command.Process.Pid
   294		if pid > 0 {
   295			_ = unix.Kill(-pid, unix.SIGKILL)
   296		}
   297		_ = command.Process.Kill()
   298	}

