   309			return output, diagnostic("process_output_limit", "Go child exceeded its combined output bound")
   310		}
   311		return output, nil
   312	}
   313	
   314	func (client *workerClient) send(message workerMessage) error {
   315		if err := writeMessage(client.stdin, message); err != nil {
   316			if code := DiagnosticCode(err); code != "" {
   317				return err
   318			}
   319			return client.protocolFailure(err, "cannot send the %s message", message.Kind)
   320		}
   321		return nil
   322	}
   323	
   324	func (client *workerClient) receive(kind string) (workerMessage, error) {
   325		message, err := readMessage(client.stdout)
   326		if err != nil {
   327			return workerMessage{}, client.protocolFailure(err, "cannot read the %s message", kind)
   328		}
   329		if message.Kind == kindFailure {
   330			if message.Failure == nil || message.Failure.Code == "" {
   331				return workerMessage{}, diagnostic(CodeWorkerProtocolInvalid, "worker reported an unstructured failure")
   332			}
   333			return workerMessage{}, diagnostic(message.Failure.Code, "%s", message.Failure.Detail)
   334		}
   335		if message.Kind != kind {
   336			return workerMessage{}, diagnostic(CodeWorkerProtocolInvalid, "worker sent %q, want %q", message.Kind, kind)
   337		}
   338		if message.Nonce != client.nonce {
   339			return workerMessage{}, diagnostic(CodeWorkerProtocolInvalid, "worker response carries an unknown nonce")
   340		}
   341		return message, nil
   342	}
   343	
   344	// protocolFailure prefers the worker's own stable diagnostic when the session
   345	// channel closed because the worker rejected the session.
   346	func (client *workerClient) protocolFailure(cause error, format string, args ...any) error {
   347		if detail := string(client.stderr.Bytes()); detail != "" {
   348			return diagnosticErr(CodeWorkerProtocolInvalid, cause, format+": %s", append(args, detail)...)
   349		}
   350		return diagnosticErr(CodeWorkerProtocolInvalid, cause, format, args...)
   351	}
   352	
   353	// teardown terminates and joins the complete worker domain and discards the
   354	// session channel. It is safe to call more than once. The domain is terminated
   355	// before the worker is reaped, so a group kill can never reach a reused
   356	// process identifier.
   357	func (client *workerClient) teardown() {
   358		if client.finished {
   359			return
   360		}
   361		client.finished = true
   362		if client.stdin != nil {
   363			_ = writeMessage(client.stdin, workerMessage{Kind: kindShutdown, Nonce: client.nonce})
   364			_ = client.stdin.Close()
   365		}
   366		if client.command != nil && client.command.Process != nil {
   367			if !client.drained {
   368				// Drain to end of file first: the worker exit closes the response pipe
   369				// without reaping the process, so the process-group identifier is still
   370				// reserved when the domain is terminated below.
   371				drained := make(chan struct{})
   372				go func() {
   373					if client.stdout != nil {
   374						_, _ = io.Copy(io.Discard, client.stdout)
   375					}
   376					close(drained)
   377				}()
