   119	
   120	var errProtocolClosed = errors.New("worker session channel closed")
   121	
   122	// writeMessage writes one length-prefixed canonical frame.
   123	func writeMessage(writer io.Writer, message workerMessage) error {
   124		payload, err := json.Marshal(message)
   125		if err != nil {
   126			return err
   127		}
   128		if int64(len(payload)) > maxProtocolFrame {
   129			return diagnostic(CodeWorkerProtocolInvalid, "outgoing %s frame exceeds the session bound", message.Kind)
   130		}
   131		var header [4]byte
   132		binary.BigEndian.PutUint32(header[:], uint32(len(payload))) // #nosec G115 -- the length was just bounded by maxProtocolFrame
   133		if _, err := writer.Write(header[:]); err != nil {
   134			return err
   135		}
   136		_, err = writer.Write(payload)
   137		return err
   138	}
   139	
   140	// readMessage reads one length-prefixed canonical frame. An oversize declared
   141	// length is rejected before any payload byte is buffered.
   142	func readMessage(reader io.Reader) (workerMessage, error) {
   143		var header [4]byte
   144		if _, err := io.ReadFull(reader, header[:]); err != nil {
   145			if errors.Is(err, io.EOF) {
   146				return workerMessage{}, errProtocolClosed
   147			}
   148			return workerMessage{}, diagnosticErr(CodeWorkerProtocolInvalid, err, "cannot read a session frame header")
   149		}
   150		length := int64(binary.BigEndian.Uint32(header[:]))
   151		if length == 0 || length > maxProtocolFrame {
   152			return workerMessage{}, diagnostic(CodeWorkerProtocolInvalid, "session frame length %d is outside the bound", length)
   153		}
   154		payload := make([]byte, length)
   155		if _, err := io.ReadFull(reader, payload); err != nil {
   156			return workerMessage{}, diagnosticErr(CodeWorkerProtocolInvalid, err, "cannot read a session frame payload")
   157		}
   158		decoder := json.NewDecoder(bytes.NewReader(payload))
   159		decoder.DisallowUnknownFields()
   160		var message workerMessage
   161		if err := decoder.Decode(&message); err != nil {
   162			return workerMessage{}, diagnosticErr(CodeWorkerProtocolInvalid, err, "session frame is not a known message")
   163		}
   164		if _, err := decoder.Token(); !errors.Is(err, io.EOF) {
   165			return workerMessage{}, diagnostic(CodeWorkerProtocolInvalid, "session frame has trailing data")
   166		}
   167		switch message.Kind {
   168		case kindRequest, kindReady, kindList, kindListResult, kindPermit, kindBuildResult, kindShutdown, kindFailure:
   169		default:
   170			return workerMessage{}, diagnostic(CodeWorkerProtocolInvalid, "unknown session message kind %q", message.Kind)
   171		}
   172		return message, nil
   173	}
   174	
   175	// buildPermit derives the authenticated fixed build permit. It binds the
   176	// session secret, the session nonce, and the exact build argument vector, so a
   177	// permit cannot be replayed into another session or cover another vector.
   178	func buildPermit(secret, nonce string, argv []string) string {
   179		key, err := hex.DecodeString(secret)
   180		if err != nil {
   181			key = []byte(secret)
   182		}
   183		mac := hmac.New(sha256.New, key)
   184		mac.Write([]byte("curator-go-build-permit\x00"))
   185		mac.Write([]byte(nonce))
   186		mac.Write([]byte{0})
   187		mac.Write([]byte(strings.Join(argv, "\x00")))
   188		return hex.EncodeToString(mac.Sum(nil))
   189	}
   190	
   191	func validPermit(permit, secret, nonce string, argv []string) bool {
   192		expected := buildPermit(secret, nonce, argv)
   193		return hmac.Equal([]byte(expected), []byte(permit))
   194	}
