   213	// probeForSessionOutput reports whether the worker wrote anything on the session
   214	// channel. A worker destroyed before its controls were installed must not have.
   215	func (client *workerClient) probeForSessionOutput() bool {
   216		if client.command == nil || client.command.Process == nil || client.stdout == nil {
   217			// The worker was never created, so it cannot have produced output.
   218			return false
   219		}
   220		client.drained = true
   221		produced := make(chan bool, 1)
   222		go func() {
   223			var probe [1]byte
   224			count, _ := io.ReadFull(client.stdout, probe[:])
   225			produced <- count > 0
   226		}()
   227		select {
   228		case value := <-produced:
   229			return value
   230		case <-time.After(workerShutdownGrace):
   231			return false
   232		}
   233	}
