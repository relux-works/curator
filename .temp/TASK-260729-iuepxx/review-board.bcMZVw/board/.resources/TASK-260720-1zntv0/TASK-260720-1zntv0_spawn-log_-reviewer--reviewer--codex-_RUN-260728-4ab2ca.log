   310	func normalizeBuildLimits(limits ResourceLimits) (ResourceLimits, error) {
   311		if limits.Timeout == 0 {
   312			limits.Timeout = defaultBuildTimeout
   313		}
   314		if limits.OutputBytes == 0 {
   315			limits.OutputBytes = defaultBuildOutput
   316		}
   317		if limits.ArtifactBytes == 0 {
   318			limits.ArtifactBytes = defaultArtifactLimit
   319		}
   320		if limits.FileBytes == 0 {
   321			limits.FileBytes = defaultFileLimit
   322		}
   323		if limits.DiskBytes == 0 {
   324			limits.DiskBytes = defaultDiskLimit
   325		}
   326		if limits.MemoryBytes == 0 {
   327			limits.MemoryBytes = defaultMemoryLimit
   328		}
   329		if limits.Processes == 0 {
   330			limits.Processes = defaultProcessLimit
   331		}
   332		if limits.Timeout < time.Millisecond || limits.Timeout > defaultBuildTimeout ||
   333			limits.OutputBytes < 1 || limits.OutputBytes > defaultBuildOutput ||
   334			limits.ArtifactBytes < 1 || limits.ArtifactBytes > defaultArtifactLimit ||
   335			limits.FileBytes < limits.ArtifactBytes || limits.FileBytes > defaultFileLimit ||
   336			limits.DiskBytes < limits.ArtifactBytes || limits.DiskBytes > defaultDiskLimit ||
   337			limits.MemoryBytes < 1 || limits.MemoryBytes > defaultMemoryLimit ||
   338			limits.Processes < 1 || limits.Processes > defaultProcessLimit {
   339			return ResourceLimits{}, diagnostic("invalid_resource_limits", "go-v1 limits are outside manager bounds")
   340		}
   341		return limits, nil
   342	}
