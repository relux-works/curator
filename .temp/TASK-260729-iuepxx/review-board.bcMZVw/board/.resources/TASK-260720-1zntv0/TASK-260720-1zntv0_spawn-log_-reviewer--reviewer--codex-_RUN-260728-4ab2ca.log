   143			return Result{}, diagnosticErr("invalid_build_request", err, "invalid go-v1 build input")
   144		}
   145		if err := request.Source.Recheck(); err != nil {
   146			return Result{}, diagnosticErr("source_mutated", err, "frozen source changed before preflight")
   147		}
   148		if err := request.Session.VerifyToolchain(ctx); err != nil {
   149			return Result{}, err
   150		}
   151	
   152		sourceRoot, buildRoot, sourceDir, err := canonicalBuildDirectories(request.Source.Path(), request.BuildRoot, request.SourceDir)
