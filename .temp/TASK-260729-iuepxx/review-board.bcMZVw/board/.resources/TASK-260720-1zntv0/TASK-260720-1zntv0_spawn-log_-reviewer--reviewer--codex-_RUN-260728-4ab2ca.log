   261	// TestBuildFailsClosedWhenTheGoChildCannotStart drives a real refused process
   262	// creation through the complete operation. The Windows active-process bound is
   263	// the only inventory control that can refuse the compiler natively, so the
   264	// aggregate domain is set to admit the worker alone and the compiler creation is
   265	// refused by the kernel.
   266	func TestBuildFailsClosedWhenTheGoChildCannotStart(t *testing.T) {
   267		if runtime.GOOS != "windows" {
   268			t.Skip("active-process-count-limit is available only on Windows in rc5-native-control-inventory-v1")
   269		}
   270		fixture := newSnapshotFixture(t)
   271		fixture.start(stubScript{ListStdout: string(encodePackages(t, fixture.rootPackage())), Artifact: "artifact"})
   272		before := len(fixture.calls())
   273	
   274		_, err := Build(context.Background(), fixture.request(ResourceLimits{Timeout: 30 * time.Second, Processes: 1}))
   275		if DiagnosticCode(err) != "go_list_failed" {
   276			t.Fatalf("error = %v, want the fixed go list command to fail closed", err)
   277		}
   278		if after := len(fixture.calls()); after != before {
   279			t.Fatalf("launcher calls went from %d to %d; the refused child must never run", before, after)
   280		}
   281		requireNoPrivateArtifact(t, fixture.session)
   282	}
   283	
   284	// TestWorkerDomainTeardownSurvivesARefusedChild proves the complete domain is
   285	// still terminated and joined after a refused process creation.
   286	func TestWorkerDomainTeardownSurvivesARefusedChild(t *testing.T) {
   287		scenario := newWorkerScenario(t)
   288		scenario.request.Directory = filepath.Join(scenario.fixture.sourceDir, "absent")
   289		worker := scenario.requireReady()
   290		worker.send(workerMessage{Kind: kindList, Nonce: scenario.nonce})
   291		if message := worker.receive(); message.Result == nil || !message.Result.StartFailed {
   292			t.Fatalf("message = %+v, want a refused creation", message)
   293		}
   294		pid := worker.command.Process.Pid
   295		worker.close()
   296		deadline := time.Now().Add(15 * time.Second)
   297		for processAlive(pid) && time.Now().Before(deadline) {
   298			time.Sleep(50 * time.Millisecond)
   299		}
   300		if processAlive(pid) {
   301			t.Fatalf("worker %d outlived the domain teardown", pid)
   302		}
   303		if _, err := os.Lstat(scenario.request.ArtifactPath); err == nil {
   304			t.Fatal("a refused build produced an artifact")
   305		}
   306	}

