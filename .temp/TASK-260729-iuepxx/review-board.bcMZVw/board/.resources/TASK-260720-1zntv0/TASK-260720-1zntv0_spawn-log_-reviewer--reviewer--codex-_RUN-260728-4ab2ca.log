   148	// expect enforces the session ordering and nonce binding. Any other kind,
   149	// including a second list or a second build request, tears the session down
   150	// without starting a compiler.
   151	func (session *workerSession) expect(kind string) (workerMessage, error) {
   152		message, err := readMessage(session.input)
   153		if err != nil {
   154			return workerMessage{}, err
   155		}
   156		if message.Kind != kind {
   157			return workerMessage{}, diagnostic(CodeWorkerProtocolInvalid, "session expected %q, got %q", kind, message.Kind)
   158		}
   159		if message.Nonce != session.nonce {
   160			return workerMessage{}, diagnostic(CodeWorkerProtocolInvalid, "session message carries a replayed or unknown nonce")
   161		}
   162		return message, nil
   163	}
