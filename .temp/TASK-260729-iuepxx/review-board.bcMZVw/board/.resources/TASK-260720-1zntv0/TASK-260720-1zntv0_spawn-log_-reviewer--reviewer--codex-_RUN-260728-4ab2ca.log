   235	// matchAppliedControls cross-checks the worker's applied-control report against
   236	// the record it emitted, so a report and its evidence cannot drift.
   237	func matchAppliedControls(applied []string, evidence CapabilityEvidence) error {
   238		reported := make(map[string]bool, len(applied))
   239		for _, name := range applied {
   240			if reported[name] {
   241				return diagnostic(CodeCapabilityEvidenceInvalid, "worker reports control %q applied twice", name)
   242			}
   243			reported[name] = true
   244		}
   245		for _, entry := range evidence.Controls {
   246			if (entry.Status == StatusApplied) != reported[entry.Name] {
   247				return diagnostic(CodeCapabilityEvidenceInvalid,
   248					"worker applied-control report contradicts evidence for %q", entry.Name)
   249			}
   250			delete(reported, entry.Name)
   251		}
   252		for name := range reported {
   253			return diagnostic(CodeCapabilityEvidenceInvalid, "worker applied control %q outside its evidence record", name)
   254		}
   255		return nil
   256	}
