   139	// TestControlDomainInstallsBeforeTheWorkerIsReleased proves the ordering the
   140	// failure boundary depends on: a domain reports no installed control until it
   141	// has been installed, so an applied status cannot exist before the mechanism
   142	// does, and the worker is released only afterwards.
   143	func TestControlDomainInstallsBeforeTheWorkerIsReleased(t *testing.T) {
   144		limits, err := normalizeBuildLimits(ResourceLimits{})
   145		if err != nil {
   146			t.Fatal(err)
   147		}
   148		platform, probes, err := probeNativeControls(limits)
   149		if err != nil {
   150			t.Fatal(err)
   151		}
   152		domain, err := prepareControlDomain(limits, probes)
   153		if err != nil {
   154			t.Fatal(err)
   155		}
   156		defer domain.close()
   157		if names := domain.installedControls(); len(names) != 0 {
   158			t.Fatalf("a prepared but uninstalled domain reports %q as installed", names)
   159		}
   160		empty := evidenceFromApplied(platform, probes, domain.installedControls())
   161		for _, entry := range empty.Controls {
   162			if entry.Status == StatusApplied {
   163				t.Fatalf("control %q reports applied before its mechanism was installed", entry.Name)
   164			}
   165		}
   166		// An uninstalled domain can never produce a valid record, because every
   167		// platform-available control would be reported as not applied.
   168		if DiagnosticCode(validateCapabilityEvidence(empty, platform, probes)) != CodeCapabilityEvidenceInvalid {
   169			t.Fatal("an uninstalled domain produced an acceptable capability-evidence record")
   170		}
   171	
   172		identity, err := resolveExecutableIdentity(managerExecutable())
   173		if err != nil {
   174			t.Fatal(err)
   175		}
   176		worker := startRawWorker(t, identity, limits, probes)
   177		installed := worker.domain.installedControls()
   178		wanted := installableControls(probes)
   179		if strings.Join(installed, ",") != strings.Join(wanted, ",") {
   180			t.Fatalf("installed controls = %q, want every probed-available control %q", installed, wanted)
   181		}
   182	}
   183	
   184	// TestParentRejectsAWorkerRecordThatDiffersFromWhatWasInstalled proves the
   185	// manager, not the worker, owns the applied status: a worker record that does
   186	// not match the manager's installed set is an evidence fault.
   187	func TestParentRejectsAWorkerRecordThatDiffersFromWhatWasInstalled(t *testing.T) {
   188		platform := PlatformWindows
   189		probes := syntheticProbes(platform)
   190		installed := installableControls(probes)
   191		manager := evidenceFromApplied(platform, probes, installed)
   192	
   193		if len(manager.Controls) != len(nativeControlInventory) {
   194			t.Fatalf("manager record has %d entries", len(manager.Controls))
   195		}
   196		drifted := evidenceFromApplied(platform, probes, installed[:len(installed)-1])
   197		if DiagnosticCode(validateCapabilityEvidence(drifted, platform, probes)) != CodeCapabilityEvidenceInvalid {
   198			t.Fatal("a worker record dropping an installed control was accepted")
   199		}
   200		if err := matchAppliedControls(installed[:len(installed)-1], manager); DiagnosticCode(err) != CodeCapabilityEvidenceInvalid {
   201			t.Fatalf("error = %v, want %s", err, CodeCapabilityEvidenceInvalid)
   202		}
   203	}
   204	
   205	// TestParentClassifiesAChildStartFailureWithoutBuildContinuation proves the
   206	// parent's half of the refused-creation path: a bounded start-failure result is
   207	// classified as the fixed command it was, carries no exit status, and stops the
   208	// operation before the build phase.
   209	func TestParentClassifiesAChildStartFailureWithoutBuildContinuation(t *testing.T) {
   210		for _, testCase := range []struct {
   211			name, kind, code string
   212			started          int
   213			classify         func(error, []byte) error
   214		}{
   215			{name: "list", kind: kindListResult, code: "go_list_failed", started: 1, classify: classifyListFailure},
   216			{name: "build", kind: kindBuildResult, code: "go_build_failed", started: 2, classify: classifyBuildFailure},
   217		} {
   218			t.Run(testCase.name, func(t *testing.T) {
   219				nonce, err := sessionToken()
   220				if err != nil {
   221					t.Fatal(err)
   222				}
   223				frame := encodeWorkerFrame(t, workerMessage{
   224					Kind: testCase.kind, Nonce: nonce,
   225					Result: &workerResult{
   226						Started: testCase.started, ExitCode: -1, StartFailed: true,
   227						Detail: "fork/exec /goroot/bin/go: no such file or directory",
   228					},
   229				})
   230				client := &workerClient{
   231					nonce:  nonce,
   232					stdout: io.NopCloser(bytes.NewReader(frame)),
   233					plan:   workerPlan{Limits: ResourceLimits{OutputBytes: defaultBuildOutput}},
   234				}
   235				output, err := client.result(testCase.kind, testCase.started)
   236				if err == nil {
   237					t.Fatal("a refused process creation was reported as success")
   238				}
   239				if !strings.Contains(err.Error(), "could not be started") {
   240					t.Fatalf("error = %v, want the refused-creation detail", err)
   241				}
   242				classified := testCase.classify(err, output.Stderr)
   243				if DiagnosticCode(classified) != testCase.code {
   244					t.Fatalf("classified = %v, want %s", classified, testCase.code)
   245				}
   246			})
   247		}
   248	}
   249	
   250	func encodeWorkerFrame(t *testing.T, message workerMessage) []byte {
   251		t.Helper()
   252		payload, err := json.Marshal(message)
   253		if err != nil {
   254			t.Fatal(err)
   255		}
   256		var header [4]byte
   257		binary.BigEndian.PutUint32(header[:], uint32(len(payload)))
   258		return append(header[:], payload...)
   259	}
