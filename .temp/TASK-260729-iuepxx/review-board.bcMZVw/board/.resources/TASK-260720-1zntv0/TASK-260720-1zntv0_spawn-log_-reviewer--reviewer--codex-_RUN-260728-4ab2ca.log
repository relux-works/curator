   398	// runGo starts exactly the fingerprinted Go launcher with a manager-owned
   399	// argument vector. It is the worker's only process-creation site.
   400	//
   401	// A launcher that fails its identity check ends the session with that stable
   402	// diagnostic and creates no process. A process the operating system refuses to
   403	// create has no exit status at all, so the refusal is reported as a bounded
   404	// result rather than read from a nil process state.
   405	func (session *workerSession) runGo(argv []string) (*workerResult, error) {
   406		request := session.request
   407		if err := verifyGoLauncher(request.GoExecutable); err != nil {
   408			return nil, err
   409		}
   410		session.started++
   411		limits := session.limits()
   412		ctx, cancel := context.WithTimeout(context.Background(), limits.Timeout)
   413		defer cancel()
   414	
   415		command := exec.CommandContext(ctx, request.GoExecutable, argv...) // #nosec G204 -- fixed manager-owned vector against a verified launcher
   416		command.Dir = request.Directory
   417		command.Env = append([]string(nil), request.Environment...)
   418		command.Stdin = nil
   419		command.SysProcAttr = compilerSysProcAttr()
   420		budget := &outputBudget{remaining: limits.OutputBytes}
   421		stdout := &boundedBuffer{budget: budget}
   422		stderr := &boundedBuffer{budget: budget}
   423		command.Stdout = stdout
   424		command.Stderr = stderr
   425	
   426		runErr := command.Run()
   427		result := &workerResult{Stdout: stdout.Bytes(), Stderr: stderr.Bytes(), Started: session.started}
   428		if ctx.Err() != nil {
   429			result.TimedOut = true
   430		}
   431		if errors.Is(stdout.err, errOutputLimit) || errors.Is(stderr.err, errOutputLimit) || errors.Is(budget.err, errOutputLimit) {
   432			result.Overflow = true
   433		}
   434		if runErr != nil {
   435			result.Detail = runErr.Error()
   436			if state := command.ProcessState; state != nil {
   437				result.ExitCode = state.ExitCode()
   438			} else {
   439				// Process creation failed, so no child ever ran: there is no exit
   440				// status to read and the phase carries no output to interpret.
   441				result.StartFailed = true
   442				result.ExitCode = -1
   443			}
   444		}
   445		return result, nil
   446	}
   447	
   448	// verifyGoLauncher re-proves the identity of the only program the worker
   449	// starts, immediately before every exec. The exact content identity of the
   450	// tree is carried by the parent's curator-go-toolchain-v1 fingerprint, which is
   451	// re-verified after every child and before publication.
   452	func verifyGoLauncher(path string) error {
   453		if !filepath.IsAbs(path) {
   454			return diagnostic(CodeWorkerIdentityInvalid, "the Go launcher path is not absolute")
   455		}
   456		resolved, err := filepath.EvalSymlinks(filepath.Clean(path))
   457		if err != nil || resolved != path {
   458			return diagnosticErr(CodeWorkerIdentityInvalid, err, "the Go launcher path is not canonical and link-free")
   459		}
   460		if err := validateLauncher(path); err != nil {
   461			return diagnosticErr(CodeWorkerIdentityInvalid, err, "the Go launcher is not the fingerprinted native executable")
   462		}
   463		return nil
   464	}

