   305	// validateWorkerEnvironment re-proves the closed offline environment inside the
   306	// worker, so a mutated request cannot widen the compiler environment.
   307	func validateWorkerEnvironment(environment []string, goroot string, privateRoots []string) error {
   308		values := make(map[string]string, len(environment))
   309		for _, item := range environment {
   310			key, value, present := strings.Cut(item, "=")
   311			if !present || key == "" {
   312				return diagnostic(CodeWorkerProtocolInvalid, "compiler environment contains a malformed entry")
   313			}
   314			if _, duplicate := values[key]; duplicate {
   315				return diagnostic(CodeWorkerProtocolInvalid, "compiler environment repeats %s", key)
   316			}
   317			values[key] = value
   318		}
   319		required := map[string]string{
   320			"GOENV": "off", "GOTOOLCHAIN": "local", "LC_ALL": "C", "LANG": "C",
   321			"GO111MODULE": "on", "GOFLAGS": "", "GOPROXY": "off", "GOSUMDB": "off", "GOPRIVATE": "",
   322			"GONOPROXY": "none", "GONOSUMDB": "none", "GOVCS": "*:off", "GOWORK": "off",
   323			"CGO_ENABLED": "0", "GO_EXTLINK_ENABLED": "0", "GOEXPERIMENT": "",
   324			"GOROOT": goroot,
   325		}
   326		for key, want := range required {
   327			if got, present := values[key]; !present || got != want {
   328				return diagnostic(CodeWorkerProtocolInvalid, "compiler environment has unexpected %s", key)
   329			}
   330		}
   331		for _, key := range []string{"GOPATH", "GOMODCACHE", "GOCACHE", "GOTMPDIR", "HOME", "XDG_CONFIG_HOME", "PATH", "TMPDIR"} {
   332			value, present := values[key]
   333			if !present || value == "" {
   334				return diagnostic(CodeWorkerProtocolInvalid, "compiler environment is missing operation-private %s", key)
   335			}
   336			if key == "PATH" {
   337				if !privateOrSibling(value, privateRoots) {
   338					return diagnostic(CodeWorkerProtocolInvalid, "compiler PATH is not an operation-private empty directory")
   339				}
   340				continue
   341			}
   342			if !containsExact(privateRoots, value) {
   343				return diagnostic(CodeWorkerProtocolInvalid, "compiler environment %s is not operation-private", key)
   344			}
   345		}
   346		for _, forbidden := range []string{
   347			"CC", "CXX", "FC", "AR", "PKG_CONFIG", "GOFLAGS_FILE", "GOAUTH",
   348			"HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY", "SSH_AUTH_SOCK",
   349			"GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM", "GOTOOLDIR", "GOROOT_FINAL", "GOBIN",
   350		} {
   351			if _, present := values[forbidden]; present {
   352				return diagnostic(CodeWorkerProtocolInvalid, "compiler environment contains forbidden %s", forbidden)
   353			}
   354		}
   355		if values["GOOS"] == "" || values["GOARCH"] == "" {
   356			return diagnostic(CodeWorkerProtocolInvalid, "compiler environment is missing the native target")
   357		}
   358		allowed := make(map[string]bool, len(required)+16)
   359		for key := range required {
   360			allowed[key] = true
   361		}
   362		for _, key := range []string{"GOOS", "GOARCH", "GOPATH", "GOMODCACHE", "GOCACHE", "GOTMPDIR", "HOME", "XDG_CONFIG_HOME", "PATH", "TMPDIR"} {
   363			allowed[key] = true
   364		}
   365		if tuning := tuningVariable(values["GOARCH"]); tuning != "" {
   366			if values[tuning] == "" {
   367				return diagnostic(CodeWorkerProtocolInvalid, "compiler environment is missing %s", tuning)
   368			}
   369			allowed[tuning] = true
   370		}
   371		for _, key := range platformEnvironmentNames() {
   372			allowed[key] = true
   373		}
   374		for key := range values {
   375			if !allowed[key] {
   376				return diagnostic(CodeWorkerProtocolInvalid, "compiler environment contains non-protocol variable %s", key)
   377			}
   378		}
   379		entries, err := os.ReadDir(values["PATH"])
   380		if err != nil || len(entries) != 0 {
   381			return diagnosticErr(CodeWorkerProtocolInvalid, err, "compiler PATH is not an empty manager directory")
   382		}
   383		return nil
   384	}
   385	
   386	func privateOrSibling(path string, privateRoots []string) bool {
   387		if containsExact(privateRoots, path) {
   388			return true
   389		}
   390		for _, root := range privateRoots {
   391			if filepath.Dir(root) == filepath.Dir(path) {
   392				return true
   393			}
   394		}
   395		return false
   396	}
