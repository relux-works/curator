   197	// validateRequest is the worker's own guard over everything it was asked to do.
   198	// A mutated executable, argument vector, working directory, environment, root,
   199	// limit, or control profile is rejected before any compiler starts.
   200	func (session *workerSession) validateRequest() error {
   201		request := session.request
   202		if request.Platform != InventoryPlatform(runtime.GOOS) || request.Platform == "" {
   203			return diagnostic(CodeCapabilityEvidenceInvalid, "request platform %q is not this host", request.Platform)
   204		}
   205		if err := validateProbeSet(request.Platform, request.Probes); err != nil {
   206			return err
   207		}
   208		if len(request.ReadOnlyRoots) != 2 || len(request.PrivateRoots) == 0 {
   209			return diagnostic(CodeWorkerProtocolInvalid, "request must carry the frozen source root, GOROOT, and private roots")
   210		}
   211		sourceRoot, goroot := request.ReadOnlyRoots[0], request.ReadOnlyRoots[1]
   212		if !filepath.IsAbs(sourceRoot) || !filepath.IsAbs(goroot) || goroot != request.GOROOT {
   213			return diagnostic(CodeWorkerProtocolInvalid, "request roots are not absolute manager-owned roots")
   214		}
   215		if request.GoExecutable != filepath.Join(goroot, "bin", platformGoName) {
   216			return diagnostic(CodeWorkerIdentityInvalid, "request selects a program other than the fingerprinted Go launcher")
   217		}
   218		if request.ToolDirectory != filepath.Join(goroot, "pkg", "tool", toolPlatform(request.Environment)) {
   219			return diagnostic(CodeWorkerIdentityInvalid, "request selects a tool directory outside the fingerprinted GOROOT")
   220		}
   221		if !filepath.IsAbs(request.Directory) || !isWithin(request.Directory, sourceRoot) && request.Directory != sourceRoot {
   222			return diagnostic(CodeWorkerProtocolInvalid, "request working directory is not inside the frozen source snapshot")
   223		}
   224		for _, root := range request.PrivateRoots {
   225			if !filepath.IsAbs(root) || root == sourceRoot || root == goroot || isWithin(root, sourceRoot) || isWithin(root, goroot) {
   226				return diagnostic(CodeWorkerProtocolInvalid, "private root %q overlaps the frozen source or GOROOT", root)
   227			}
   228		}
   229		if !reflect.DeepEqual(request.ListArgv, listArguments) {
   230			return diagnostic(CodeWorkerProtocolInvalid, "request carries a non-protocol go list vector")
   231		}
   232		if err := validateFixedBuildArgv(request.BuildArgv, request.ArtifactPath, request.PrivateRoots); err != nil {
   233			return err
   234		}
   235		if err := validateWorkerEnvironment(request.Environment, goroot, request.PrivateRoots); err != nil {
   236			return err
   237		}
   238		if _, err := normalizeBuildLimits(session.limits()); err != nil {
   239			return err
   240		}
   241		return nil
   242	}
