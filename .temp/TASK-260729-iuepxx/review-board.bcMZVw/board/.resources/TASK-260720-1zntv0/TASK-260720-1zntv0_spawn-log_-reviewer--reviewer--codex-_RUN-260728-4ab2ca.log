   154			return Result{}, err
   155		}
   156	
   157		// Step 2: probe, once for this operation and before the worker exists,
   158		// which inventory controls this platform provides for exactly these limits.
   159		// Each probe performs the operation the control will perform, so a control
   160		// that is not applicable rejects here rather than after the worker starts.
