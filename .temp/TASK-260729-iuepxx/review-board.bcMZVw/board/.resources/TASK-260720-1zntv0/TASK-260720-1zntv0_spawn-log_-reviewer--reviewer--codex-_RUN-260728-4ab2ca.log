    67	// accept performs steps 5 and 6 of the worker session: it validates the single
    68	// request, proves its own executable identity, confirms the installed controls,
    69	// and acknowledges the nonce together with the capability-evidence record.
    70	func (session *workerSession) accept() error {
    71		message, err := readMessage(session.input)
    72		if err != nil {
    73			return err
    74		}
    75		if message.Kind != kindRequest || message.Request == nil {
    76			return diagnostic(CodeWorkerProtocolInvalid, "session must open with a request, got %q", message.Kind)
    77		}
    78		request := message.Request
    79		if request.Version != protocolVersion {
    80			return diagnostic(CodeWorkerProtocolInvalid, "unsupported worker protocol version %q", request.Version)
    81		}
    82		if len(message.Nonce) != sessionNonceLength || len(request.Secret) != sessionSecretLength {
    83			return diagnostic(CodeWorkerProtocolInvalid, "session nonce or secret is malformed")
    84		}
    85		session.nonce = message.Nonce
    86		session.request = request
    87	
    88		identity, err := resolveExecutableIdentity(workerExecutable())
    89		if err != nil {
    90			return err
    91		}
    92		if err := identity.matches(request.ExecutablePath, request.ExecutableSHA256, request.ExecutableSize); err != nil {
    93			return err
    94		}
    95		if err := session.validateRequest(); err != nil {
    96			return err
    97		}
    98		confirmed, err := observeNativeControls(session.limits(), request.Probes, session.protocolFiles())
    99		if err != nil {
   100			return err
   101		}
   102		evidence := evidenceFromApplied(request.Platform, request.Probes, confirmed)
   103		if err := validateCapabilityEvidence(evidence, request.Platform, request.Probes); err != nil {
   104			return err
   105		}
   106		return writeMessage(session.output, workerMessage{
   107			Kind: kindReady, Nonce: session.nonce,
   108			Ready: &workerReady{
   109				ExecutablePath: identity.Path, ExecutableSHA256: identity.SHA256, ExecutableSize: identity.Size,
   110				Applied: confirmed, Evidence: evidence,
   111			},
   112		})
   113	}
