   283	func validateFixedBuildArgv(argv []string, artifact string, privateRoots []string) error {
   284		prefix := buildArgumentPrefix
   285		if len(argv) != len(prefix)+2 || !reflect.DeepEqual(argv[:len(prefix)], prefix) || argv[len(argv)-1] != "." {
   286			return diagnostic(CodeWorkerProtocolInvalid, "request carries a non-protocol go build vector")
   287		}
   288		output := argv[len(prefix)]
   289		if output != artifact || !filepath.IsAbs(output) {
   290			return diagnostic(CodeWorkerProtocolInvalid, "go build output is not the manager-derived absolute staging path")
   291		}
   292		for _, root := range privateRoots {
   293			if strictlyBelow(output, root) {
   294				return nil
   295			}
   296		}
   297		return diagnostic(CodeWorkerProtocolInvalid, "go build output escapes operation-private staging")
   298	}
