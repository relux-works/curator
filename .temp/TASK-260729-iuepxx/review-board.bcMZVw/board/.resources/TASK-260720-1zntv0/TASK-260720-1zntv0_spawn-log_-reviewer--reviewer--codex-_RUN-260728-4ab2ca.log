   344	func canonicalBuildDirectories(snapshot, buildRootRel, sourceDirRel string) (string, string, string, error) {
   345		physicalSnapshot, err := filepath.EvalSymlinks(snapshot)
   346		if err != nil {
   347			return "", "", "", diagnosticErr("invalid_build_request", err, "cannot resolve frozen source root")
   348		}
   349		buildRoot := filepath.Join(physicalSnapshot, filepath.FromSlash(buildRootRel))
   350		sourceDir := filepath.Join(physicalSnapshot, filepath.FromSlash(sourceDirRel))
   351		for _, item := range []struct{ path, label string }{{buildRoot, "build root"}, {sourceDir, "source directory"}} {
   352			info, err := os.Lstat(item.path)
   353			if err != nil || !info.IsDir() || info.Mode()&fs.ModeSymlink != 0 {
   354				return "", "", "", diagnosticErr("invalid_build_request", err, "%s is not a real directory", item.label)
   355			}
   356			physical, err := filepath.EvalSymlinks(item.path)
   357			if err != nil || physical != item.path {
   358				return "", "", "", diagnosticErr("invalid_build_request", err, "%s is not canonical and link-free", item.label)
   359			}
   360		}
   361		goMod := filepath.Join(buildRoot, "go.mod")
   362		info, err := os.Lstat(goMod)
   363		if err != nil || !info.Mode().IsRegular() {
   364			return "", "", "", diagnosticErr("build_module_missing", err, "build root lacks a regular go.mod")
   365		}
   366		if err := rejectWorkspaceAndToolchainDirectives(buildRoot, goMod); err != nil {
   367			return "", "", "", err
   368		}
   369		return physicalSnapshot, buildRoot, sourceDir, nil
   370	}
   371	
   372	func rejectWorkspaceAndToolchainDirectives(buildRoot, goMod string) error {
   373		var workspace string
   374		err := filepath.WalkDir(buildRoot, func(path string, entry fs.DirEntry, walkErr error) error {
   375			if walkErr != nil {
   376				return walkErr
   377			}
   378			if entry.Name() == "go.work" {
   379				workspace = path
   380				return fs.SkipAll
   381			}
   382			return nil
   383		})
   384		if err != nil {
   385			return diagnosticErr("workspace_dependency_forbidden", err, "cannot prove workspace exclusion")
   386		}
   387		if workspace != "" {
   388			return diagnostic("workspace_dependency_forbidden", "build root contains forbidden workspace file %q", workspace)
   389		}
   390		payload, err := os.ReadFile(goMod) // #nosec G304 -- direct go.mod below validated build root
   391		if err != nil {
   392			return diagnosticErr("build_module_missing", err, "cannot inspect build root go.mod")
   393		}
   394		for _, line := range bytes.Split(payload, []byte{'\n'}) {
   395			fields := bytes.Fields(line)
   396			if len(fields) != 0 && bytes.Equal(fields[0], []byte("toolchain")) {
   397				return diagnostic("toolchain_switch_forbidden", "build root go.mod contains a package-selected toolchain directive")
   398			}
   399		}
   400		return nil
   401	}
   402	
   403	// privateRoots lists the operation-private write targets the manager resolved
   404	// independently of package data.
   405	func privateRoots(environment []string, stage string) []string {
   406		values := environmentMap(environment)
   407		keys := []string{"GOPATH", "GOMODCACHE", "GOCACHE", "GOTMPDIR", "HOME", "XDG_CONFIG_HOME", "TMPDIR", "APPDATA", "LOCALAPPDATA", "USERPROFILE", "TEMP", "TMP"}
   408		result := make([]string, 0, len(keys)+1)
   409		seen := map[string]bool{}
   410		for _, key := range keys {
   411			if value := values[key]; value != "" && !seen[value] {
   412				seen[value] = true
   413				result = append(result, value)
   414			}
   415		}
   416		return append(result, stage)
   417	}
   418	
   419	// verifyPrivateState is a post-child integrity check over manager-private
   420	// state. It is not a kernel-enforced write confinement or an aggregate disk
   421	// quota; the portable profile claims neither.
   422	func verifyPrivateState(root, staging string, limit int64) error {
   423		var total int64
   424		err := filepath.WalkDir(root, func(path string, _ fs.DirEntry, walkErr error) error {
   425			if walkErr != nil {
   426				return walkErr
   427			}
   428			info, err := os.Lstat(path)
   429			if err != nil {
   430				return err
   431			}
   432			switch {
   433			case info.IsDir():
   434				return nil
   435			case info.Mode().IsRegular():
   436				if info.Size() > limit-total {
   437					return diagnostic("process_disk_limit", "Go private state exceeded its disk bound")
   438				}
   439				total += info.Size()
   440				return nil
   441			default:
   442				if isWithin(path, staging) {
   443					return nil
   444				}
   445				return diagnostic("private_build_special_file", "Go created a link or special file in private state")
   446			}
   447		})
   448		if err != nil {
   449			if DiagnosticCode(err) != "" {
   450				return err
   451			}
   452			return diagnosticErr("private_build_unreadable", err, "cannot inspect private Go state")
   453		}
   454		return nil
   455	}
   456	
   457	func verifyArtifact(stage, artifactPath, artifactRel string, limit int64) (buildmeta.Artifact, error) {
   458		entries, err := os.ReadDir(stage)
   459		if err != nil || len(entries) != 1 || entries[0].Name() != "bin" || !entries[0].IsDir() {
   460			return buildmeta.Artifact{}, diagnosticErr("artifact_output_invalid", err, "build staging contains an unexpected output")
   461		}
   462		binEntries, err := os.ReadDir(filepath.Join(stage, "bin"))
   463		if err != nil || len(binEntries) != 1 || filepath.Join(stage, "bin", binEntries[0].Name()) != artifactPath {
   464			return buildmeta.Artifact{}, diagnosticErr("artifact_output_invalid", err, "build did not produce exactly one derived output")
   465		}
   466		info, err := os.Lstat(artifactPath)
   467		if err != nil || !info.Mode().IsRegular() || info.Mode()&fs.ModeSymlink != 0 {
   468			return buildmeta.Artifact{}, diagnosticErr("artifact_special_file", err, "staged output is not a regular file")
   469		}
   470		if info.Size() < 0 || info.Size() > limit {
   471			return buildmeta.Artifact{}, diagnostic("artifact_size_limit", "staged output exceeds its artifact bound")
   472		}
   473		if err := applyArtifactPermissions(artifactPath); err != nil {
   474			return buildmeta.Artifact{}, diagnosticErr("artifact_permissions_failed", err, "cannot apply manager artifact permissions")
   475		}
   476		permissioned, err := os.Lstat(artifactPath)
   477		if err != nil || !permissioned.Mode().IsRegular() || !os.SameFile(info, permissioned) || permissioned.Size() != info.Size() {
   478			return buildmeta.Artifact{}, diagnosticErr("artifact_mutated", err, "staged output changed while applying permissions")
   479		}
   480		multiple, err := artifactHasMultipleLinks(artifactPath, permissioned)
   481		if err != nil {
   482			return buildmeta.Artifact{}, diagnosticErr("artifact_unreadable", err, "cannot inspect staged output link count")
   483		}
   484		if multiple {
   485			return buildmeta.Artifact{}, diagnostic("artifact_link", "staged output has multiple filesystem links")
   486		}
   487		file, err := os.Open(artifactPath) // #nosec G304 -- path is manager-derived inside private staging
   488		if err != nil {
   489			return buildmeta.Artifact{}, diagnosticErr("artifact_unreadable", err, "cannot open staged output")
   490		}
   491		defer func() { _ = file.Close() }()
   492		opened, err := file.Stat()
   493		if err != nil || !opened.Mode().IsRegular() || !os.SameFile(info, opened) {
   494			return buildmeta.Artifact{}, diagnosticErr("artifact_special_file", err, "staged output changed while opening")
   495		}
   496		digest := sha256.New()
   497		written, copyErr := io.CopyN(digest, file, opened.Size())
   498		var extra [1]byte
   499		extraCount, extraErr := file.Read(extra[:])
   500		if copyErr != nil || written != opened.Size() || extraCount != 0 || (extraErr != nil && extraErr != io.EOF) {
   501			return buildmeta.Artifact{}, diagnosticErr("artifact_mutated", errors.Join(copyErr, extraErr), "staged output changed while hashing")
   502		}
   503		after, err := os.Lstat(artifactPath)
   504		if err != nil || !after.Mode().IsRegular() || !os.SameFile(info, after) || after.Size() != opened.Size() {
   505			return buildmeta.Artifact{}, diagnosticErr("artifact_mutated", err, "staged output changed during verification")
   506		}
   507		return buildmeta.Artifact{Path: artifactRel, SHA256: "sha256:" + hex.EncodeToString(digest.Sum(nil)), Size: written}, nil
   508	}
   509	
   510	func classifyListFailure(err error, stderr []byte) error {
   511		if DiagnosticCode(err) != "" {
   512			return err
   513		}
   514		text := string(stderr)
   515		switch {
   516		case containsAny(text, "inconsistent vendoring", "is explicitly required in go.mod, but not marked as explicit in vendor/modules.txt"):
   517			return diagnosticErr("vendor_metadata_inconsistent", err, "go list rejected inconsistent vendor metadata")
   518		case containsAny(text, "cannot find module providing package", "import lookup disabled by -mod=vendor"):
   519			return diagnosticErr("vendor_dependency_missing", err, "go list could not resolve a vendored dependency")
   520		case containsAny(text, "go.mod requires go >=", "requires go >=", "toolchain not available"):
   521			return diagnosticErr("toolchain_switch_forbidden", err, "module requests another toolchain")
   522		case containsAny(text, "go.work", "workspace"):
   523			return diagnosticErr("workspace_dependency_forbidden", err, "module depends on a forbidden workspace")
   524		case containsAny(text, "no Go files", "build constraints exclude all Go files"):
   525			return diagnosticErr("cgo_required", err, "package has no buildable non-cgo files")
   526		default:
   527			return diagnosticErr("go_list_failed", err, "fixed go list command failed")
   528		}
   529	}
   530	
   531	func classifyBuildFailure(err error, stderr []byte) error {
   532		if DiagnosticCode(err) != "" {
   533			return err
   534		}
   535		text := string(stderr)
   536		switch {
   537		case containsAny(text, "requires external linking", "external linking required"):
   538			return diagnosticErr("external_link_forbidden", err, "internal-only Go build failed")
   539		case containsAny(text, "libgcc", "gcc"):
   540			return diagnosticErr("libgcc_fallback_forbidden", err, "Go build attempted a forbidden host linker fallback")
   541		default:
   542			return diagnosticErr("go_build_failed", err, "fixed go build command failed")
   543		}
   544	}
   545	
   546	func containsAny(value string, needles ...string) bool {
   547		for _, needle := range needles {
   548			if len(needle) > 0 && contains(value, needle) {
   549				return true
   550			}
   551		}
   552		return false
   553	}
   554	
   555	func contains(value, needle string) bool {
   556		for index := 0; index+len(needle) <= len(value); index++ {
   557			if value[index:index+len(needle)] == needle {
   558				return true
   559			}
   560		}
   561		return false
   562	}
   563	
   564	func containsExact(values []string, want string) bool {
   565		for _, value := range values {
   566			if value == want {
   567				return true
   568			}
   569		}
   570		return false
   571	}
