   390		// compiler or tool child can outlive the operation.
   391		client.domain.close()
   392		if client.cancel != nil {
   393			client.cancel()
   394		}
   395	}
   396	
   397	// Evidence returns the closed capability-evidence-v1 record for this session.
   398	func (client *workerClient) Evidence() CapabilityEvidence { return client.evidence }
   399	
   400	func sessionToken() (string, error) {
   401		var raw [32]byte
   402		if _, err := rand.Read(raw[:]); err != nil {
   403			return "", err
   404		}
   405		return hex.EncodeToString(raw[:]), nil
   406	}
   407	
   408	// workerEnvironment is the fixed bootstrap environment of the worker process
   409	// itself. It carries only indispensable operating-system process variables.
   410	func workerEnvironment() []string {
   411		values := indispensableEnvironment()
   412		if values == nil {
   413			values = map[string]string{}
   414		}
   415		return environmentSlice(values)
   416	}

