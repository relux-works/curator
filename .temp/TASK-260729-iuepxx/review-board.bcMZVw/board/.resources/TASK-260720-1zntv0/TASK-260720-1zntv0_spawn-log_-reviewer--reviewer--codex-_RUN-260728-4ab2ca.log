    14	
    15	// WorkerMode is the fixed hidden mode that re-executes the installed manager
    16	// as the go-v1 build worker. It is an implementation boundary, not a
    17	// user-visible command surface: no package file, manifest value, descriptor
    18	// value, environment value, PATH lookup, shell, or user option selects it.
    19	const WorkerMode = "__curator-go-worker-v1"
    20	
    21	// protocolVersion pins the framing and message vocabulary of one session.
    22	const protocolVersion = "curator-go-worker-v1"
    23	
    24	// maxProtocolFrame bounds every framed message. The list result carries the
    25	// bounded go list stream, so the ceiling is above the largest permitted
    26	// combined-output bound and below any value that could exhaust the worker.
    27	const maxProtocolFrame = int64(64 * 1024 * 1024)
    28	
    29	// Message kinds. The session state machine admits no other kind.
    30	const (
    31		kindRequest     = "request"
    32		kindReady       = "ready"
    33		kindList        = "list"
    34		kindListResult  = "list-result"
    35		kindPermit      = "permit"
    36		kindBuildResult = "build-result"
    37		kindShutdown    = "shutdown"
    38		kindFailure     = "failure"
    39	)
    40	
    41	// wireLimits is the bounded resource request carried to the worker.
    42	type wireLimits struct {
    43		TimeoutMillis int64 `json:"timeout_millis"`
    44		OutputBytes   int64 `json:"output_bytes"`
    45		ArtifactBytes int64 `json:"artifact_bytes"`
    46		FileBytes     int64 `json:"file_bytes"`
    47		DiskBytes     int64 `json:"disk_bytes"`
    48		MemoryBytes   int64 `json:"memory_bytes"`
    49		Processes     int   `json:"processes"`
    50	}
    51	
    52	// workerRequest is the single length-bounded canonical request. Every value is
    53	// manager-owned; package bytes select nothing here.
    54	type workerRequest struct {
    55		Version          string         `json:"version"`
    56		Secret           string         `json:"secret"`
