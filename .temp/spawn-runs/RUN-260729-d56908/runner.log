	"github.com/relux-works/curator/internal/godriver"
	"github.com/relux-works/curator/internal/marker"
)

// fakeSession stands in for a trusted Go session. Its root models the
// operation-private staging area the driver owns and deletes on Release.
type fakeSession struct {
	target     buildmeta.Target
	toolchain  buildmeta.Toolchain
	root       string
	released   int
	releaseErr error
	verified   int
	verifyErr  error
	// lateVerifyErr is reported by every verification after the first, so any
	// re-check taken during teardown surfaces as a failed installation.
	lateVerifyErr error
}

func (session *fakeSession) Target() buildmeta.Target       { return session.target }
func (session *fakeSession) Toolchain() buildmeta.Toolchain { return session.toolchain }

func (session *fakeSession) VerifyToolchain(context.Context) error {
	session.verified++
	if session.verified > 1 && session.lateVerifyErr != nil {
		return session.lateVerifyErr
	}
	return session.verifyErr
}

func (session *fakeSession) Release() error {
	session.released++
	if err := os.RemoveAll(session.root); err != nil {
		return err
	}
	return session.releaseErr
}

type fakeToolchain struct {
	t             *testing.T
	target        buildmeta.Target
	toolchain     buildmeta.Toolchain
	probes        int
	establishes   int
	session       *fakeSession
	probeErr      error
	establishErr  error
	releaseErr    error
	verifyErr     error
	lateVerifyErr error
	// observeProbe runs while the plan is mid-flight, so a test can record the
	// complete temporary footprint a dry run holds at its widest point.
	observeProbe func()
}

func (toolchain *fakeToolchain) Probe(context.Context) (buildmeta.Target, buildmeta.Toolchain, error) {
	toolchain.probes++
	if toolchain.observeProbe != nil {
		toolchain.observeProbe()
	}
	if toolchain.probeErr != nil {
		return buildmeta.Target{}, buildmeta.Toolchain{}, toolchain.probeErr
	}
	return toolchain.target, toolchain.toolchain, nil
}

func (toolchain *fakeToolchain) Establish(context.Context) (BuildSession, error) {
	toolchain.establishes++
	if toolchain.establishErr != nil {
		return nil, toolchain.establishErr
	}
	toolchain.session = &fakeSession{
		target:        toolchain.target,
		toolchain:     toolchain.toolchain,
		root:          toolchain.t.TempDir(),
		releaseErr:    toolchain.releaseErr,
		verifyErr:     toolchain.verifyErr,
		lateVerifyErr: toolchain.lateVerifyErr,
	}
	return toolchain.session, nil
}

// fakeCache is one protected-cache boundary: the same object answers planning
// lookups and publishes staged builds, exactly like the real store. Splitting
// the two would let a test assert against a cache the product never wrote to.
type fakeCache struct {
	t         *testing.T
	root      string
	byCommand map[string]buildcache.Result
	inspected []string
	seeded    map[string]bool
	published []string
	reverted  []string
	// byKey resolves a published logical key back to its command, so a reversal
	// addresses the cache the same way the real store does.
	byKey map[buildmeta.CacheKey]string
	// displaced holds the entry a publication moved aside, so a reversal can put
	// the exact prior verdict back instead of an approximation of it.
	displaced map[buildmeta.CacheKey]buildcache.Result
	// observe runs inside the lookup, modelling any state change that races a
	// cache decision the planner is about to trust.
	observe func(buildcache.Expectation)
	// publishErr fails publication of one command. It fires before the fake
	// changes anything, which is the store's own contract: a publication that
	// returns a plain error compensated whatever it had already moved.
	publishErr map[string]error
	// revertErr fails the reversal of one command, modelling a store that could
	// not put the displaced entry back. The published entry stays live, because
	// that is exactly what a failed reversal leaves behind.
	revertErr map[string]error
}

func (cache *fakeCache) Inspect(expect buildcache.Expectation) buildcache.Result {
	cache.inspected = append(cache.inspected, expect.Input.Command)
	if cache.observe != nil {
		cache.observe(expect)
	}
	if cache.seeded[expect.Input.Command] {
		delete(cache.seeded, expect.Input.Command)
		cache.byCommand[expect.Input.Command] = cache.materialize(expect.Input)
	}
	if result, present := cache.byCommand[expect.Input.Command]; present {
		return result
	}
	return buildcache.Result{Status: buildcache.Miss, Reason: "cache entry is absent"}
}

// seedHit marks one command as already protected. The entry is materialized on
// the first lookup, from the exact input the planner derives, because a hit a
// launcher can point at must carry a real artifact and a matching receipt —
// a fabricated path would let a test pass against state the product rejects.
func (cache *fakeCache) seedHit(commands ...string) {
	if cache.seeded == nil {
		cache.seeded = map[string]bool{}
	}
	for _, command := range commands {
		cache.seeded[command] = true
	}
}

func (cache *fakeCache) materialize(input buildmeta.Input) buildcache.Result {
	cache.t.Helper()
	relative, err := buildmeta.ArtifactPath(input.Command, input.Target.GOOS)
	if err != nil {
		cache.t.Fatal(err)
	}
	payload := []byte("protected:" + input.Command)
	artifact := filepath.Join(cache.entryRoot(), "protected", input.Command, filepath.FromSlash(relative))
	if err := os.MkdirAll(filepath.Dir(artifact), 0o700); err != nil {
		cache.t.Fatal(err)
	}
	if err := os.WriteFile(artifact, payload, 0o700); err != nil {
		cache.t.Fatal(err)
	}
	digest := sha256.Sum256(payload)
	receipt, err := buildmeta.NewReceipt(input, buildmeta.Artifact{
		Path: relative, SHA256: "sha256:" + hex.EncodeToString(digest[:]), Size: int64(len(payload)),
	})
	if err != nil {
		cache.t.Fatal(err)
	}
	receiptBytes, err := receipt.CanonicalBytes()
	if err != nil {
		cache.t.Fatal(err)
	}
	receiptHash, err := buildmeta.HashReceiptBytes(receiptBytes)
	if err != nil {
		cache.t.Fatal(err)
	}
	return buildcache.Result{
		Status: buildcache.Hit, Receipt: receipt, ReceiptBytes: receiptBytes,
		ReceiptHash: receiptHash, ArtifactPath: artifact,
	}
}

// Publish copies the private artifact into the fake protected root and turns
// the key into an exact hit, the way the real immutable publication does.
func (cache *fakeCache) Publish(publication buildcache.Publication, lock buildcache.HomeLock) (buildcache.PublicationResult, error) {
	cache.t.Helper()
	if err := lock.AssertHeld(); err != nil {
		return buildcache.PublicationResult{}, err
	}
	command := publication.Input.Command
	if err := cache.publishErr[command]; err != nil {
		return buildcache.PublicationResult{}, err
	}
	receipt, err := buildmeta.DecodeExpectedReceipt(publication.ReceiptBytes, publication.Input)
	if err != nil {
		return buildcache.PublicationResult{}, err
	}
	if existing, present := cache.byCommand[command]; present && existing.Status == buildcache.Hit {
		cache.published = append(cache.published, command)
		return buildcache.PublicationResult{
			Status: buildcache.ReusedWinner, ArtifactPath: existing.ArtifactPath, ReceiptHash: existing.ReceiptHash,
		}, nil
	}
	// An entry the manager refuses to reuse is displaced, exactly like the real
	// publication quarantines it, and is remembered so a reversal can put the
	// same verdict back.
	quarantined := ""
	if existing, present := cache.byCommand[command]; present {
		if cache.displaced == nil {
			cache.displaced = map[buildmeta.CacheKey]buildcache.Result{}
		}
		cache.displaced[receipt.CacheKey] = existing
		quarantined = "quarantine:" + command
	}
	if cache.byKey == nil {
		cache.byKey = map[buildmeta.CacheKey]string{}
	}
	cache.byKey[receipt.CacheKey] = command
	receiptHash, err := buildmeta.HashReceiptBytes(publication.ReceiptBytes)
	if err != nil {
		return buildcache.PublicationResult{}, err
	}
	entry := filepath.Join(cache.entryRoot(), string(receipt.CacheKey)[len("sha256:"):])
	artifact := filepath.Join(entry, filepath.FromSlash(receipt.Artifact.Path))
	if err := os.MkdirAll(filepath.Dir(artifact), 0o700); err != nil {
		return buildcache.PublicationResult{}, err
	}
	payload, err := os.ReadFile(publication.ArtifactSource) // #nosec G304 -- test-owned private staging
	if err != nil {
		return buildcache.PublicationResult{}, err
	}
	if err := os.WriteFile(artifact, payload, 0o700); err != nil {
		return buildcache.PublicationResult{}, err
	}
	cache.published = append(cache.published, command)
	cache.byCommand[command] = buildcache.Result{
		Status: buildcache.Hit, Receipt: receipt, ReceiptBytes: publication.ReceiptBytes,
		ReceiptHash: receiptHash, ArtifactPath: artifact,
	}
	return buildcache.PublicationResult{
		Status: buildcache.Published, ArtifactPath: artifact, ReceiptHash: receiptHash,
		Quarantined: quarantined,
	}, nil
}

// Revert withdraws one published winner and restores whatever it displaced, so
// a failed commit leaves the fake cache exactly where the run found it.
func (cache *fakeCache) Revert(
	key buildmeta.CacheKey,
	published buildcache.PublicationResult,
	lock buildcache.HomeLock,
) error {
	cache.t.Helper()
	if err := lock.AssertHeld(); err != nil {
		return err
	}
	if published.Status != buildcache.Published {
		return nil
	}
	command, known := cache.byKey[key]
	if !known {
		return fmt.Errorf("revert of an unpublished key %s", key)
	}
	if err := cache.revertErr[command]; err != nil {
		return &buildcache.StateChangedError{Key: key, Err: err}
	}
	cache.reverted = append(cache.reverted, command)
	if displaced, present := cache.displaced[key]; present {
		cache.byCommand[command] = displaced
		delete(cache.displaced, key)
		return nil
	}
	delete(cache.byCommand, command)
	return nil
}

func (cache *fakeCache) entryRoot() string {
	cache.t.Helper()
	if cache.root == "" {
		cache.root = cache.t.TempDir()
	}
	return cache.root
}

