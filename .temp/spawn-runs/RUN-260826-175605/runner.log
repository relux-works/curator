+#!/usr/bin/env bash
+set -euo pipefail
+
+toolchain_dir=/tmp/BUG-260823-1vx45a-go-20260827
+expected="$({ curl -fsSL 'https://go.dev/dl/?mode=json&include=all' | jq -r '.[] | select(.version == "go1.25.5") | .files[] | select(.filename == "go1.25.5.linux-arm64.tar.gz") | .sha256'; })"
+actual="$(sha256sum "$toolchain_dir/go1.25.5.linux-arm64.tar.gz" | cut -d' ' -f1)"
+test -n "$expected"
+test "$actual" = "$expected"
+cd "$toolchain_dir"
+tar -xzf go1.25.5.linux-arm64.tar.gz
+./go/bin/go version
