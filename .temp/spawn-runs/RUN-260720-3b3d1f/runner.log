def _best_chain(chains: list[str]) -> str:
    return min(chains, key=lambda chain: (chain.count(" -> "), chain))


def _resolve_node(
    config: GlobalConfig,
    item: _Pending,
    substitution: Substitution | None,
    *,
    use_cache: bool,
    fetch_existing: bool,
    fetched_repos: set[Path],
    stack: ExitStack | None,
) -> ClosureNode:
