package board

import (
	"fmt"
	"strings"
)

// Re-export errors used by validation for callers that need errors.Is().
// The sentinel errors themselves are defined in errors.go.

// ValidateStatusChange checks whether changing elem's status to newStatus is
// allowed given the board state. Returns an error if blocked by unfinished
// dependencies or if the element is unassigned for forward transitions.
func ValidateStatusChange(b *Board, elem *Element, pd *ProgressData, newStatus Status) error {
	return validateStatusChange(b, elem, pd, newStatus, true)
}

// validateAutomaticStatusChange applies the state-machine and dependency
// checks used by status changes while omitting guards that exist only for a
// direct manual transition, such as the assignee requirement.
func validateAutomaticStatusChange(b *Board, elem *Element, pd *ProgressData, newStatus Status) error {
	return validateStatusChange(b, elem, pd, newStatus, false)
}

func validateStatusChange(b *Board, elem *Element, pd *ProgressData, newStatus Status, manual bool) error {
	if _, err := ParseStatus(string(newStatus)); err != nil {
		return err
	}

	// Check blockedBy before allowing development or later
	if newStatus == StatusDevelopment || newStatus == StatusToReview ||
		newStatus == StatusReviewing || newStatus == StatusDone {
		activeBlockers := b.ActiveBlockers(elem)
		if len(activeBlockers) > 0 {
			var blockerDescs []string
			for _, blocker := range activeBlockers {
				blockerDescs = append(blockerDescs, fmt.Sprintf("%s (status: %s)", blocker.ID(), blocker.Status))
			}
			return fmt.Errorf("cannot set %s to %s — blocked by:\n  %s: %w",
				elem.ID(), newStatus, strings.Join(blockerDescs, "\n  "), ErrBlocked)
		}
	}

	// Manual guard: forward workflow transitions require assignment. Container
	// aggregation is derived state and does not imply ownership of the parent.
	if manual && (newStatus == StatusToDev || newStatus == StatusDevelopment || newStatus == StatusToReview) {
		if strings.TrimSpace(pd.AssignedTo) == "" {
			return fmt.Errorf("cannot change status of %s — %w.\nRun: task-board m 'assign(%s, agent=<name>)'",
				elem.ID(), ErrNotAssigned, elem.ID())
		}
	}

	return nil
}

// ValidateDependencyLink checks the domain constraints for a dependency edge
// without changing either element's progress.
func ValidateDependencyLink(b *Board, elem, blocker *Element) error {
	if elem == nil {
		return fmt.Errorf("element: %w", ErrNotFound)
	}
	if blocker == nil {
		return fmt.Errorf("blocker: %w", ErrNotFound)
	}
	if strings.EqualFold(elem.ID(), blocker.ID()) {
		return fmt.Errorf("%s cannot depend on itself: %w", elem.ID(), ErrInvalidLink)
	}
	if b.IsAncestor(elem, blocker) || b.IsAncestor(blocker, elem) {
		return fmt.Errorf("dependency between ancestor and descendant %s/%s: %w", elem.ID(), blocker.ID(), ErrInvalidLink)
	}
	if dependencyPathExists(b, blocker, elem.ID()) {
		return fmt.Errorf("link %s blocked by %s creates a cycle: %w", elem.ID(), blocker.ID(), ErrInvalidLink)
	}
	return nil
}

// ValidateParentChange checks the target and hierarchy constraints for a move
// without changing the board.
func ValidateParentChange(b *Board, elem *Element, newParentID string) error {
	if elem == nil {
		return fmt.Errorf("element: %w", ErrNotFound)
	}
	if err := ValidateParentForCreate(elem.Type, newParentID); err != nil {
		return err
	}
	if b.FindByID(newParentID) == nil {
		return fmt.Errorf("parent %s: %w", newParentID, ErrNotFound)
	}
	return nil
}
package board

import (
	"errors"
	"fmt"
	"strings"
	"sync"
)

// BoardConsistencyService encapsulates all mutations that have cascading
// side-effects (status changes, dependency links, assignment). Each method
// performs validation, applies the primary change, and runs any escalation
// or de-escalation chains, returning the full set of changes.
//
// Thread-safe: all public methods acquire a mutex.
type BoardConsistencyService struct {
	mu    sync.Mutex
	store DataStore
}

// NewConsistencyService creates a new BoardConsistencyService.
func NewConsistencyService(store DataStore) *BoardConsistencyService {
	return &BoardConsistencyService{store: store}
}

func (s *BoardConsistencyService) runSerialized(fn func() error) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	return WithMutationLock(s.store, fn)
}

// SetStatus changes an element's status, validates the transition, and runs
// auto-promotion and auto-escalation chains up the hierarchy.
func (s *BoardConsistencyService) SetStatus(id string, newStatus Status) (*ChangeSet, error) {
	var cs *ChangeSet
	err := s.runSerialized(func() error {
		b, err := s.store.LoadBoard()
		if err != nil {
			return fmt.Errorf("loading board: %w", err)
		}

		elem := b.FindByID(id)
		if elem == nil {
			return fmt.Errorf("element %s: %w", id, ErrNotFound)
		}

		pd, err := s.store.ReadProgress(id)
		if err != nil {
			return fmt.Errorf("reading progress: %w", err)
		}

		// Validate
		if err := ValidateStatusChange(b, elem, pd, newStatus); err != nil {
			return err
		}

		// Apply primary change
		oldStatus := pd.Status
		pd.Status = newStatus
		if err := s.store.WriteProgress(id, pd); err != nil {
			return fmt.Errorf("writing progress: %w", err)
		}
		elem.Status = newStatus

		cs = &ChangeSet{
			Primary: Change{
				ElementID: id,
				Action:    StatusChanged,
				Field:     "status",
				OldValue:  string(oldStatus),
				NewValue:  string(newStatus),
			},
		}

		sideEffects, err := recalculateAncestors(b, s.store, b.ParentOf(elem), elem.ID())
		if err != nil {
			rollbackErr := rollbackStatusChanges(b, s.store, sideEffects)
			pd.Status = oldStatus
			primaryRollbackErr := s.store.WriteProgress(id, pd)
			elem.Status = oldStatus
			return errors.Join(
				err,
				rollbackErr,
				func() error {
					if primaryRollbackErr == nil {
						return nil
					}
					return fmt.Errorf("rolling back status for %s: %w", id, primaryRollbackErr)
				}(),
			)
		}
		cs.SideEffects = append(cs.SideEffects, sideEffects...)
		return nil
	})
	return cs, err
}

func rollbackStatusChanges(b *Board, store DataStore, changes []Change) error {
	var rollbackErr error
	for i := len(changes) - 1; i >= 0; i-- {
		change := changes[i]
		if change.Field != "status" {
			continue
		}
		pd, err := store.ReadProgress(change.ElementID)
		if err != nil {
			rollbackErr = errors.Join(rollbackErr, fmt.Errorf("reading %s for rollback: %w", change.ElementID, err))
			continue
		}
		pd.Status = Status(change.OldValue)
		if err := store.WriteProgress(change.ElementID, pd); err != nil {
			rollbackErr = errors.Join(rollbackErr, fmt.Errorf("rolling back %s: %w", change.ElementID, err))
			continue
		}
		if elem := b.FindByID(change.ElementID); elem != nil {
			elem.Status = Status(change.OldValue)
		}
	}
	return rollbackErr
}

// Link creates a dependency: id is blocked by blockerID. Task-level links are
// the source of truth for read-time container projections; they never create
// stored story or epic side-effect links.
func (s *BoardConsistencyService) Link(id, blockerID string) (*ChangeSet, error) {
	normalizedID, err := NormalizeIdentifierField("Blocks", id)
	if err != nil {
		return nil, err
	}
	normalizedBlockerID, err := NormalizeIdentifierField("BlockedBy", blockerID)
	if err != nil {
		return nil, err
	}
	id = normalizedID
	blockerID = normalizedBlockerID

	var cs *ChangeSet
	err = s.runSerialized(func() error {
		b, err := s.store.LoadBoard()
		if err != nil {
			return fmt.Errorf("loading board: %w", err)
		}

		elem := b.FindByID(id)
		if elem == nil {
			return fmt.Errorf("element %s: %w", id, ErrNotFound)
		}

		blocker := b.FindByID(blockerID)
		if blocker == nil {
			return fmt.Errorf("blocker %s: %w", blockerID, ErrNotFound)
		}
		if err := ValidateDependencyLink(b, elem, blocker); err != nil {
			return err
		}

		// Read and update blocked element
		pd, err := s.store.ReadProgress(id)
		if err != nil {
			return fmt.Errorf("reading progress for %s: %w", id, err)
		}

		alreadyBlocked := false
		for _, existing := range pd.BlockedBy {
			if strings.EqualFold(existing, blocker.ID()) {
				alreadyBlocked = true
				break
			}
		}

		if !alreadyBlocked {
			pd.BlockedBy = append(pd.BlockedBy, blocker.ID())
		}
		if err := NormalizeProgressForMutation(pd); err != nil {
			return err
		}

		// Prepare the reciprocal blocks list before either write so validation
		// failures cannot leave a one-sided dependency.
		blockerPd, err := s.store.ReadProgress(blocker.ID())
		if err != nil {
			return fmt.Errorf("reading progress for %s: %w", blocker.ID(), err)
		}
		alreadyBlocks := false
		for _, existing := range blockerPd.Blocks {
			if strings.EqualFold(existing, elem.ID()) {
				alreadyBlocks = true
				break
			}
		}
		if !alreadyBlocks {
			blockerPd.Blocks = append(blockerPd.Blocks, elem.ID())
			if err := NormalizeProgressForMutation(blockerPd); err != nil {
				return err
			}
		}

		if alreadyBlocked && alreadyBlocks {
			cs = &ChangeSet{Primary: Change{ElementID: id, Action: Linked, Field: "blockedBy", NewValue: blocker.ID()}}
			return nil
		}
		if err := writeProgressPair(s.store, id, pd, blocker.ID(), blockerPd); err != nil {
			return err
		}

		cs = &ChangeSet{
			Primary: Change{
				ElementID: id,
				Action:    Linked,
				Field:     "blockedBy",
				NewValue:  blocker.ID(),
			},
		}

		return nil
	})
	return cs, err
}

