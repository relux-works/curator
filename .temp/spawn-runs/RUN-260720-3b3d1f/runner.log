package board

import (
	"errors"
	"fmt"
	"strings"
)

// statusWorkflowOrder returns the workflow progression order of a status.
func statusWorkflowOrder(s Status) int {
	switch s {
	case StatusBacklog:
		return 0
	case StatusAnalysis:
		return 1
	case StatusToDev:
		return 2
	case StatusDevelopment:
		return 3
	case StatusToReview:
		return 4
	case StatusReviewing:
		return 5
	case StatusDone, StatusClosed:
		return 6
	default:
		return -1
	}
}

// statusEscalationPriority ranks active work for aggregate parent status.
func statusEscalationPriority(s Status) int {
	switch s {
	case StatusDevelopment:
		return 8
	case StatusToReview:
		return 7
	case StatusReviewing:
		return 6
	case StatusToDev:
		return 5
	case StatusAnalysis:
		return 4
	case StatusBacklog:
		return 3
	case StatusBlocked:
		return 2
	case StatusDone, StatusClosed:
		return 1
	default:
		return 0
	}
}

// AggregateParentStatus deterministically derives a container status from all
// direct children. Active work uses escalation priority; when every child is
// terminal the parent is done. A zero status means that every child is blocked,
// so callers must preserve the manual parent state.
func AggregateParentStatus(b *Board, parent *Element) Status {
	children := b.Children(parent)
	if len(children) == 0 {
		return StatusBacklog
	}

	var best Status
	bestPriority := 0
	allTerminal := true
	for _, child := range children {
		switch child.Status {
		case StatusDone, StatusClosed:
			continue
		case StatusBlocked:
			allTerminal = false
			continue
		default:
			allTerminal = false
		}
		if priority := statusEscalationPriority(child.Status); priority > bestPriority {
			bestPriority = priority
			best = child.Status
		}
	}
	if allTerminal {
		return StatusDone
	}
	return best
}

// recalculateAncestors recomputes every ancestor even when an intermediate
// container already has the desired status. That makes the result independent
// from the mutation path that produced the child state.
func recalculateAncestors(b *Board, store DataStore, start *Element, triggerID string) ([]Change, error) {
	var changes []Change
	visited := make(map[string]struct{})
	current := start
	for current != nil {
		key := strings.ToUpper(current.ID())
		if _, ok := visited[key]; ok {
			return changes, fmt.Errorf("hierarchy cycle at %s: %w", current.ID(), ErrInvalidLink)
		}
		visited[key] = struct{}{}

		if current.Status != StatusBlocked {
			target := AggregateParentStatus(b, current)
			if target != "" && target != current.Status {
				pd, err := store.ReadProgress(current.ID())
				if err != nil {
					return changes, fmt.Errorf("reading progress for %s: %w", current.ID(), err)
				}
				if err := validateAutomaticStatusChange(b, current, pd, target); err != nil {
					if errors.Is(err, ErrBlocked) {
						current = b.ParentOf(current)
						continue
					}
					return changes, fmt.Errorf("validating automatic status for %s: %w", current.ID(), err)
				}

				old := current.Status
				pd.Status = target
				if err := store.WriteProgress(current.ID(), pd); err != nil {
					return changes, fmt.Errorf("writing automatic status for %s: %w", current.ID(), err)
				}
				current.Status = target

				action := Escalated
				if old == StatusDone || old == StatusClosed {
					action = Reopened
				} else if target == StatusDone || allChildrenAheadOf(b, current, old) {
					action = Promoted
				} else if statusEscalationPriority(target) < statusEscalationPriority(old) {
					action = Demoted
				}
				changes = append(changes, Change{
					ElementID: current.ID(),
					Action:    action,
					Field:     "status",
					OldValue:  string(old),
					NewValue:  string(target),
					TriggerID: triggerID,
				})
			}
		}
		current = b.ParentOf(current)
	}
	return changes, nil
}

func allChildrenAheadOf(b *Board, parent *Element, status Status) bool {
	parentOrder := statusWorkflowOrder(status)
	if parentOrder < 0 {
		return false
	}
	children := b.Children(parent)
	if len(children) == 0 {
		return false
	}
	for _, child := range children {
		order := statusWorkflowOrder(child.Status)
		if order < 0 || order <= parentOrder {
			return false
		}
	}
	return true
}
// --- set_status ---

func registerSetStatus(s *agentquery.Schema[BoardItem], store board.DataStore, svc *board.BoardConsistencyService) {
	s.MutationWithMetadata("set_status", func(ctx agentquery.MutationContext[BoardItem]) (any, error) {
		id := positionalArg(ctx.Args)
		status := ctx.ArgMap["status"]
		if id == "" {
			return nil, fmt.Errorf("id is required")
		}
		if status == "" {
			return nil, fmt.Errorf("status is required")
		}

		newStatus, err := board.ParseStatus(status)
		if err != nil {
			return nil, err
		}

		if ctx.DryRun {
			b, elem, err := loadMutationElement(store, id)
			if err != nil {
				return nil, err
			}
			pd, err := store.ReadProgress(id)
			if err != nil {
				return nil, fmt.Errorf("reading progress: %w", err)
			}
			if err := board.ValidateStatusChange(b, elem, pd, newStatus); err != nil {
				return nil, err
			}
			return map[string]any{
				"dry_run": true,
				"id":      id,
				"status":  string(newStatus),
			}, nil
		}

		cs, err := svc.SetStatus(id, newStatus)
		if err != nil {
			return nil, err
		}

		return changeSetResult(cs), nil
	}, agentquery.MutationMetadata{
		Description: "Change element status with auto-promotion and escalation",
		Parameters: []agentquery.ParameterDef{
			{Name: "id", Type: "string", Required: true, Description: "Element ID"},
			{Name: "status", Type: "string", Required: true, Description: "New status", Enum: []string{
				"backlog", "analysis", "to-dev", "development", "to-review", "reviewing", "done", "closed", "blocked",
			}},
		},
		Examples:   []string{"set_status(TASK-260218-abc123, status=development)"},
		Idempotent: true,
	})
}

