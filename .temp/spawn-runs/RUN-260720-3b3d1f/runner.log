    decl = manifest.SkillDecl(
        name=item.name,
        source=item.source,
        ref=manifest.SkillRef(resolved.kind, resolved.ref),
        git=item.git,
    )
    return ClosureNode(
        name=item.name,
        decl=decl,
        resolved=resolved,
        repo=repo,
        snapshot=snap,
        spec=spec,
        identity=identity,
        substituted=substituted,
    )


def _ensure_repo(
    config: GlobalConfig,
    item: _Pending,
    *,
    use_cache: bool,
    fetch_existing: bool,
