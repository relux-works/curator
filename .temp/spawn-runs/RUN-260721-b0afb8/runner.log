   142		requireDirectoryCaseSensitivity(t, parent, true)
   143	
   144		home := filepath.Join(parent, "Missing", "Nested", "CuratorHome")
   145		preCreationVariant := filepath.Join(parent, "Missing", "nESTED", "cURATORhOME")
   146		first, err := New(home)
   147		if err != nil {
   148			t.Fatal(err)
   149		}
   150		second, err := New(preCreationVariant)
   151		if err != nil {
   152			t.Fatal(err)
   153		}
   154	
   155		homeLock, err := first.AcquireHomeOnly(context.Background(), false)
   156		if err != nil {
   157			t.Fatal(err)
   158		}
   159		defer func() {
   160			if err := homeLock.Close(); err != nil {
   161				t.Errorf("release first-use home lock: %v", err)
   162			}
   163		}()
   164		created := []string{
   165			filepath.Join(parent, "Missing"),
   166			filepath.Join(parent, "Missing", "Nested"),
   167			home,
   168		}
   169		caseSemantics := make([]bool, len(created))
   170		for index, path := range created {
   171			caseSensitive, err := directoryCaseSensitive(path)
   172			if err != nil {
   173				t.Fatalf("inspect manager-created directory %q: %v", path, err)
   174			}
   175			caseSemantics[index] = caseSensitive
   176		}
   177	
   178		// Change spelling only where the containing directory actually performs
   179		// case-insensitive lookup. The first component is under the sensitive test
   180		// parent and therefore keeps its exact spelling.
   181		components := []string{"Missing", "Nested", "CuratorHome"}
   182		parentSensitive := true
   183		for index := range components {
   184			if !parentSensitive {
   185				components[index] = swapCase(components[index])
   186			}
   187			parentSensitive = caseSemantics[index]
   188		}
   189		alias := filepath.Join(append([]string{parent}, components...)...)
   190		after, err := New(alias)
   191		if err != nil {
   192			t.Fatal(err)
   193		}
   194		if after.Home() != first.Home() {
   195			t.Fatalf("multi-component identity changed after first use: before %q, after %q", first.Home(), after.Home())
   196		}
   197		if got := runHelper(t, "try-home", alias, ""); got != "blocked" {
   198			t.Fatalf("multi-component alias subprocess = %q, want blocked", got)
   199		}
   200		if err := second.prepare(); err != nil {
   201			t.Fatal(err)
   202		}
