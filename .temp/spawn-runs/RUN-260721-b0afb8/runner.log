   229			t.Fatal(err)
   230		}
   231	
   232		const workers = 8
   233		projects := make([]string, workers)
   234		for index := range projects {
   235			projects[index] = t.TempDir()
   236		}
   237		start := make(chan struct{})
   238		errorsByWorker := make(chan error, workers)
   239		var wait sync.WaitGroup
   240		for _, project := range projects {
   241			wait.Add(1)
   242			go func() {
   243				defer wait.Done()
   244				<-start
   245				operation := manager.NewOperation(false)
   246				if _, err := operation.AcquireProjects(context.Background(), project); err != nil {
   247					errorsByWorker <- err
   248					return
   249				}
   250				if err := operation.Close(); err != nil {
   251					errorsByWorker <- err
   252				}
   253			}()
   254		}
   255		close(start)
   256		wait.Wait()
   257		close(errorsByWorker)
   258		for err := range errorsByWorker {
   259			t.Errorf("concurrent first-use acquisition: %v", err)
   260		}
   261		if _, err := os.Stat(manager.Home()); err != nil {
   262			t.Fatalf("prepared manager home: %v", err)
   263		}
