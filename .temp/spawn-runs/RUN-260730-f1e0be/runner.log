```bash
# Render single diagram
java -jar plantuml.jar diagram.puml

# Render all in directory
java -jar plantuml.jar -o ../artefacts/plantuml diagrams/plantuml/**/*.puml

# Generate SVG
java -jar plantuml.jar -tsvg diagram.puml
```

