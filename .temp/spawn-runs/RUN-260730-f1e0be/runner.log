review_python=/Users/iv/Developer/ReluxWorks/curator/.temp/TASK-260720-3ag6pi/reviewer/venv/bin/python
{
  "$review_python" - <<'"'PY'
from __future__ import annotations

import hashlib
import json
from pathlib import Path

repo = Path.cwd()
conformance = repo / \"conformance\" / \"v1\"
manifest_path = conformance / \"manifest.json\"
manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))
entries = manifest[\"files\"]
listed = [entry[\"path\"] for entry in entries]
actual = sorted(
    path.relative_to(conformance).as_posix()
    for path in conformance.rglob(\"*\")
    if path.is_file() and path "'!= manifest_path
)
assert manifest["protocol_version"] == "1.0.0-rc.5"
assert listed == sorted(listed), "manifest paths are not sorted"
assert len(listed) == len(set(listed)), "duplicate manifest paths"
assert listed == actual, "manifest inventory differs from filesystem inventory"

bad_hashes: list[str] = []
for entry in entries:
    digest = "sha256:" + hashlib.sha256((conformance / entry["path"]).read_bytes()).hexdigest()
    if digest != entry["sha256"]:
        bad_hashes.append(entry["path"])
assert not bad_hashes, f"manifest hash mismatches: {bad_hashes}"

case_index_path = conformance / "schema-cases" / "index.json"
case_index = json.loads(case_index_path.read_text(encoding="utf-8"))
indexed_instances = [entry["instance"] for entry in case_index]
case_files = sorted(
    path.relative_to(conformance / "schema-cases").as_posix()
    for path in (conformance / "schema-cases").rglob("*.json")
    if path != case_index_path
)
assert len(indexed_instances) == len(set(indexed_instances)), "duplicate schema-case index instance"
