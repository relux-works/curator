        elif path.startswith("conformance/v1/schema-cases/"):
            remainder = path.removeprefix("conformance/v1/schema-cases/")
            if remainder.split("/", 1)[0] in case_groups:
                selected.append(path)
    return sorted(selected)

def blob(commit: str, path: str) -> bytes:
