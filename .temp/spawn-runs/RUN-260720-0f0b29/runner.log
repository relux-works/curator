+		"invalid.json":                          false,
+		"invalid-build-missing-driver.json":     false,
+		"invalid-build-missing-source-dir.json": false,
+		"invalid-build-root-dot.json":           false,
+		"invalid-build-source-dir-dot.json":     false,
+		"invalid-build-unsupported-driver.json": false,
