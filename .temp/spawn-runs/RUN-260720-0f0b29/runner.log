   768	
   769	func collectDeclaredProperties(value any, declared map[string]bool) {
   770		switch value := value.(type) {
   771		case map[string]any:
   772			if properties, ok := value["properties"].(map[string]any); ok {
   773				for field := range properties {
   774					declared[field] = true
   775				}
   776			}
   777			for _, child := range value {
   778				collectDeclaredProperties(child, declared)
   779			}
   780		case []any:
   781			for _, child := range value {
   782				collectDeclaredProperties(child, declared)
   783			}
   784		}
   785	}

