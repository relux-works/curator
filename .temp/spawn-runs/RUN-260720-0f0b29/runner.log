   744		}
   745		gotSet := make(map[string]bool, len(properties))
   746		for field := range properties {
   747			gotSet[field] = true
   748		}
   749		wantSet := make(map[string]bool, len(want))
   750		for _, field := range want {
   751			wantSet[field] = true
   752		}
   753		if !reflect.DeepEqual(gotSet, wantSet) {
