+		want["invalid-build-"+field+".json"] = false
+	}
+	for _, schema := range []string{"agent-skill-v6.schema.json", "csk-skill-v6.schema.json"} {
+		prefix := strings.TrimSuffix(schema, ".schema.json") + "/"
+		got := map[string]bool{}
+		for _, item := range index {
+			if item["schema"] != schema {
