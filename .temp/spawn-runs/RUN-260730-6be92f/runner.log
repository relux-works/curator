import json
import os
import tempfile
from pathlib import Path

from csk import locking
from csk.locking import BuildLock, ManagerHomeLock, ProjectLock

real_open = os.open
binary_flag = getattr(os, \"O_BINARY\", 0)
synthetic = binary_flag == 0
if synthetic:
    binary_flag = 1 << 29
    locking.os.O_BINARY = binary_flag
opened = []

def capture_open(path, flags, mode=0o777, *, dir_fd=None):
    candidate = Path(path)
    if candidate.name.endswith(\".lock\"):
        opened.append((candidate.as_posix(), flags))
    effective = flags & ~binary_flag if synthetic else flags
    if dir_fd is None:
        return real_open(path, effective, mode)
    return real_open(path, effective, mode, dir_fd=dir_fd)

with tempfile.TemporaryDirectory() as raw:
    locking.os.open = capture_open
    try:
        root = Path(raw)
        home = root / \"home\"
        project = root / \"project\"
        with ProjectLock(home, project) as project_lock:
            project_lock.assert_held()
            with BuildLock(home, \"digest-key\") as build_lock:
                build_lock.assert_held()
        with ManagerHomeLock(home) as home_lock:
            home_lock.assert_held()
    finally:
        locking.os.open = real_open
    labels = sorted(
        \"home\" if path.endswith(\"/.lock\") else \"project\" if \"/projects/\" in path else \"build\"
        for path, _ in opened
    )
    all_binary = all(flags & binary_flag for _, flags in opened)
    result = {
        \"labels\": labels,
        \"stable_open_count\": len(opened),
        \"all_binary\": all_binary,
        \"synthetic_posix_flag\": synthetic,
    }
    print(json.dumps(result, sort_keys=True))
    if labels "'!= ["build", "home", "project"] or not all_binary:
        raise SystemExit(1)
