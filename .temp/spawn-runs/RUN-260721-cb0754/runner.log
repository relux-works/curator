    41		for index := 1; index < len(identities); index++ {
    42			if bytes.Compare([]byte(identities[index-1]), []byte(identities[index])) >= 0 {
    43				t.Fatalf("identities are not in unsigned UTF-8 order: %#v", identities)
    44			}
