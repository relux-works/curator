   258	// Close releases held locks in reverse class and project order.
   259	func (operation *Operation) Close() error {
   260		if operation == nil {
   261			return nil
   262		}
   263		operation.mu.Lock()
   264		defer operation.mu.Unlock()
   265		if operation.closed {
   266			return nil
   267		}
   268		operation.closed = true
   269		var result error
   270		if operation.home != nil {
   271			result = errors.Join(result, operation.home.Close())
   272			operation.home = nil
   273		}
   274		if operation.buildKey != nil {
   275			result = errors.Join(result, operation.buildKey.Close())
   276			operation.buildKey = nil
   277		}
   278		for index := len(operation.projects) - 1; index >= 0; index-- {
   279			result = errors.Join(result, operation.projects[index].Close())
   280		}
   281		operation.projects = nil
   282		return result
   283	}
