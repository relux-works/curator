    51	func canonicalAbsolute(path, label string) (string, error) {
    52		if path == "" {
    53			return "", fmt.Errorf("%s is empty", label)
    54		}
    55		if !utf8.ValidString(path) || strings.IndexByte(path, 0) >= 0 {
    56			return "", fmt.Errorf("%s is not valid UTF-8 filesystem text", label)
    57		}
    58		absolute, err := filepath.Abs(path)
    59		if err != nil {
    60			return "", fmt.Errorf("resolve %s: %w", label, err)
    61		}
    62		absolute = filepath.Clean(absolute)
    63		resolved, err := filepath.EvalSymlinks(absolute)
    64		if err == nil {
    65			return filepath.Clean(resolved), nil
    66		}
    67		if !os.IsNotExist(err) {
    68			return "", fmt.Errorf("resolve %s symlinks: %w", label, err)
    69		}
    70	
    71		// A first mutation may address a not-yet-created manager home. Resolve the
    72		// longest existing prefix so its identity does not change after the missing
    73		// suffix is created through a symlinked ancestor.
    74		prefix := absolute
    75		suffix := make([]string, 0, 4)
    76		for {
    77			parent := filepath.Dir(prefix)
    78			if parent == prefix {
    79				return "", fmt.Errorf("resolve existing prefix for %s: %w", label, err)
    80			}
    81			suffix = append(suffix, filepath.Base(prefix))
    82			prefix = parent
    83	
    84			resolved, err = filepath.EvalSymlinks(prefix)
    85			if err == nil {
    86				for index := len(suffix) - 1; index >= 0; index-- {
    87					resolved = filepath.Join(resolved, suffix[index])
    88				}
    89				return filepath.Clean(resolved), nil
    90			}
    91			if !os.IsNotExist(err) {
    92				return "", fmt.Errorf("resolve %s symlinks: %w", label, err)
    93			}
    94		}
    95	}
