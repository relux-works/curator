    33	}
    34	
    35	// New constructs a manager without creating filesystem state.
    36	func New(home string) (*Manager, error) {
    37		canonical, err := canonicalAbsolute(home, "manager home")
    38		if err != nil {
    39			return nil, err
    40		}
    41		return &Manager{
    42			home:     canonical,
    43			lockRoot: filepath.Join(canonical, "state", "locks", "v1"),
    44			process:  stateForHome(canonical),
    45		}, nil
    46	}
