   435	func helperCommand(mode, home, project string) *exec.Cmd {
   436		command := exec.Command(os.Args[0], "-test.run=^TestManagerLockHelper$")
   437		command.Env = append(os.Environ(),
   438			helperModeEnv+"="+mode,
   439			helperHomeEnv+"="+home,
   440			helperProjectEnv+"="+project,
   441		)
   442		return command
