   445	func TestManagerLockHelper(t *testing.T) {
   446		mode := os.Getenv(helperModeEnv)
   447		if mode == "" {
   448			return
   449		}
   450		manager, err := New(os.Getenv(helperHomeEnv))
   451		if err != nil {
   452			t.Fatal(err)
   453		}
   454		ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
   455		defer cancel()
   456		switch mode {
   457		case "try-project":
   458			operation := manager.NewOperation(false)
   459			cleanupOperation(t, operation)
   460			_, err = operation.AcquireProjects(ctx, os.Getenv(helperProjectEnv))
   461		case "try-home":
   462			var lock *HomeLock
   463			lock, err = manager.AcquireHomeOnly(ctx, false)
   464			if lock != nil {
   465				cleanupHomeLock(t, lock)
   466			}
   467		case "try-key":
   468			operation := manager.NewOperation(false)
   469			cleanupOperation(t, operation)
   470			if _, err = operation.AcquireProjects(ctx, os.Getenv(helperProjectEnv)); err == nil {
   471				err = operation.AcquireBuildKey(ctx, os.Getenv(helperKeyEnv))
   472			}
   473		case "hold-project":
   474			operation := manager.NewOperation(false)
   475			cleanupOperation(t, operation)
   476			if _, err = operation.AcquireProjects(context.Background(), os.Getenv(helperProjectEnv)); err == nil {
   477				fmt.Println("ready")
   478				_ = os.Stdout.Sync()
   479				_, _ = io.Copy(io.Discard, os.Stdin)
   480				return
   481			}
   482		default:
   483			t.Fatalf("unknown helper mode %q", mode)
   484		}
   485		if err == nil {
   486			fmt.Println("acquired")
   487			return
   488		}
   489		if errors.Is(err, context.DeadlineExceeded) {
   490			fmt.Println("blocked")
   491			return
   492		}
   493		t.Fatalf("helper lock error: %v", err)
   494	}
