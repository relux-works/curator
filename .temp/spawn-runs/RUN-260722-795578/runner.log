+					t.Fatal(err)
+				}
+				mustWrite(t, path, "foreign replacement")
+			},
+			check: func(t *testing.T, path string) {
+				if got := mustRead(t, path); got != "foreign replacement" {
+					t.Fatalf("foreign replacement changed: %q", got)
