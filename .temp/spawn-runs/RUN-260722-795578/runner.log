+	err := command.Run()
+	var exitErr *exec.ExitError
+	if !errors.As(err, &exitErr) || exitErr.ExitCode() != 86 {
+		t.Fatalf("prepare helper exit = %v, want 86", err)
+	}
+	journal, err := mustEngine(t, home).loadJournal(transactionID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return journal
+}
