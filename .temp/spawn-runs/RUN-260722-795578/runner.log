+			if got, err := DigestPath(live); err != nil || got != preimage {
+				t.Fatalf("preparing recovery changed live target: digest %q, error %v; want %q", got, err, preimage)
+			}
+			if _, err := os.Lstat(journal.Targets[0].StagedPath); !os.IsNotExist(err) {
