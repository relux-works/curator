+func TestSubprocessCrashRecoveryDuringPreparation(t *testing.T) {
+	for _, kind := range []string{"file", "directory"} {
+		t.Run(kind, func(t *testing.T) {
+			root := t.TempDir()
+			home := filepath.Join(root, "home")
