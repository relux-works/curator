+			lock, err := manager.AcquireHomeOnly(context.Background(), false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer lock.Close()
+			err = mustEngine(t, home).Recover(lock)
+			if !errors.Is(err, ErrImplementationCorruption) {
