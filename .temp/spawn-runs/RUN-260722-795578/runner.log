		t.Fatalf("invalid plan wrote a journal: %v", err)
	}
}

func TestPrepareFaultAndPreparingRecoveryCleanStagingWithoutLiveMutation(t *testing.T) {
	root := t.TempDir()
	mustMkdirAll(t, filepath.Join(root, "live"))
