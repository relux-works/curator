 }
 
+// TestScopedDirsDoesNotReadFromAReplacedDirectory guards the mutation window
+// introduced by ancestor-handle reuse. Once a cached directory is renamed out
+// of the rooted tree and a replacement is installed at the same path, a later
+// lookup must either resolve the replacement or fail closed. Continuing through
+// the detached handle would hash bytes that are no longer present at the
+// canonical GOROOT path, whereas the legacy root-relative Open resolves that
+// path again and detects the file-identity change.
+func TestScopedDirsDoesNotReadFromAReplacedDirectory(t *testing.T) {
+	root := t.TempDir()
+	writeTree(t, root, map[string]string{
+		"pkg/first":  "old-first",
+		"pkg/second": "old-second",
+	})
+
+	handle, err := os.OpenRoot(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = handle.Close() }()
+
+	dirs := scopedDirs{root: handle}
+	defer dirs.close()
+	if _, err := dirs.open("pkg"); err != nil {
+		t.Fatal(err)
+	}
+
+	detached := filepath.Join(root, "detached")
+	if err := os.Rename(filepath.Join(root, "pkg"), detached); err != nil {
+		t.Fatal(err)
+	}
+	writeTree(t, root, map[string]string{
+		"pkg/first":  "new-first",
+		"pkg/second": "new-second",
+	})
+
+	legacyFile, err := handle.Open("pkg/second")
+	if err != nil {
+		t.Fatal(err)
+	}
+	legacyPayload, legacyReadErr := io.ReadAll(legacyFile)
+	legacyCloseErr := legacyFile.Close()
+	if legacyReadErr != nil || legacyCloseErr != nil {
+		t.Fatal(errors.Join(legacyReadErr, legacyCloseErr))
+	}
+	if string(legacyPayload) != "new-second" {
+		t.Fatalf("root-relative open read %q, want replacement bytes", legacyPayload)
+	}
+
+	scoped, openErr := dirs.open("pkg")
+	if openErr != nil {
+		return // Refusing the replaced directory is the fail-closed result.
+	}
+	scopedPayload, readErr := scoped.ReadFile("second")
+	if readErr != nil {
+		return // Refusing the detached file is also fail closed.
+	}
+	if string(scopedPayload) != "new-second" {
+		t.Fatalf("scoped lookup read detached bytes %q after directory replacement", scopedPayload)
+	}
+}
+
