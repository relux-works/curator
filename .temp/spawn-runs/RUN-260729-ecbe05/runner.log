+	if err := os.Rename(filepath.Join(root, "pkg"), detached); err != nil {
+		t.Fatal(err)
+	}
+	writeTree(t, root, map[string]string{
+		"pkg/first":  "new-first",
+		"pkg/second": "new-second",
+	})
+
+	legacyFile, err := handle.Open("pkg/second")
+	if err != nil {
+		t.Fatal(err)
+	}
+	legacyPayload, legacyReadErr := io.ReadAll(legacyFile)
+	legacyCloseErr := legacyFile.Close()
+	if legacyReadErr != nil || legacyCloseErr != nil {
+		t.Fatal(errors.Join(legacyReadErr, legacyCloseErr))
+	}
+	if string(legacyPayload) != "new-second" {
+		t.Fatalf("root-relative open read %q, want replacement bytes", legacyPayload)
+	}
+
+	scoped, openErr := dirs.open("pkg")
+	if openErr != nil {
+		return // Refusing the replaced directory is the fail-closed result.
+	}
+	scopedPayload, readErr := scoped.ReadFile("second")
+	if readErr != nil {
+		return // Refusing the detached file is also fail closed.
+	}
+	if string(scopedPayload) != "new-second" {
+		t.Fatalf("scoped lookup read detached bytes %q after directory replacement", scopedPayload)
+	}
+}
