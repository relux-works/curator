+func runHelper(t *testing.T, mode, home, project string) string {
+	t.Helper()
+	command := helperCommand(mode, home, project)
+	output, err := command.CombinedOutput()
+	if err != nil {
+		t.Fatalf("helper %s failed: %v\n%s", mode, err, output)
