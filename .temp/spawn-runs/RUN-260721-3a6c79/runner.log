+func TestSubprocessContentionAndIndependentProjects(t *testing.T) {
+	home := t.TempDir()
+	projectA := t.TempDir()
+	projectB := t.TempDir()
+	manager, err := New(home)
+	if err != nil {
+		t.Fatal(err)
