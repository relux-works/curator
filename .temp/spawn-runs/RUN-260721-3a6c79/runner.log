+func helperCommand(mode, home, project string) *exec.Cmd {
+	command := exec.Command(os.Args[0], "-test.run=^TestManagerLockHelper$")
+	command.Env = append(os.Environ(),
+		helperModeEnv+"="+mode,
+		helperHomeEnv+"="+home,
+		helperProjectEnv+"="+project,
+	)
+	return command
+}
