+func TestAbnormalChildExitReleasesOSLock(t *testing.T) {
+	home := t.TempDir()
+	project := t.TempDir()
+	command := helperCommand("hold-project", home, project)
+	stdout, err := command.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
