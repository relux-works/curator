+	defer cancel()
+	if _, err := high.AcquireProjects(ctx, string(ordered[0])); !errors.Is(err, ErrLockOrder) {
+		t.Fatalf("inversion error = %v, want ErrLockOrder", err)
+	}
+	if elapsed := time.Since(started); elapsed > 100*time.Millisecond {
