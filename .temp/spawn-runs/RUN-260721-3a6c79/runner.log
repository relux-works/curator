+func cleanupHomeLock(t *testing.T, lock *HomeLock) {
+	t.Helper()
+	t.Cleanup(func() {
+		if err := lock.Close(); err != nil {
+			t.Errorf("release manager-home lock: %v", err)
+		}
+	})
+}

