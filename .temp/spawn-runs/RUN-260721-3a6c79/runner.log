+		_ = command.Process.Kill()
+		_ = command.Wait()
+		t.Fatalf("child did not report held lock: %q (%v)", scanner.Text(), scanner.Err())
+	}
+	if err := command.Process.Kill(); err != nil {
+		t.Fatal(err)
