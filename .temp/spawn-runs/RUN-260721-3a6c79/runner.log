+		t.Fatalf("same home helper = %q, want blocked", got)
+	}
+	if err := homeLock.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if got := runHelper(t, "try-home", home, ""); got != "acquired" {
+		t.Fatalf("released home helper = %q, want acquired", got)
+	}
+}
