+	high := manager.NewOperation(false)
+	cleanupOperation(t, high)
+	if _, err := high.AcquireProjects(context.Background(), string(ordered[1])); err != nil {
+		t.Fatal(err)
+	}
+	low := manager.NewOperation(false)
+	cleanupOperation(t, low)
