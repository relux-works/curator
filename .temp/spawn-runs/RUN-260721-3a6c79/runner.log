+	if _, err := otherProject.AcquireProjects(context.Background(), t.TempDir()); !errors.Is(err, ErrLockOrder) {
+		t.Fatalf("project acquired while process held home lock: %v", err)
+	}
+	if err := homeLock.Close(); err != nil {
