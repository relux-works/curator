    71		missing := make([]string, 0, 4)
    72		for {
    73			parent := filepath.Dir(prefix)
    74			if parent == prefix {
    75				return "", fmt.Errorf("resolve existing prefix for %q: %w", path, err)
    76			}
    77			missing = append(missing, filepath.Base(prefix))
    78			prefix = parent
    79			resolved, err = filepath.EvalSymlinks(prefix)
    80			if err == nil {
    81				for index := len(missing) - 1; index >= 0; index-- {
    82					resolved = filepath.Join(resolved, missing[index])
    83				}
    84				return filepath.Clean(resolved), nil
    85			}
    86			if !os.IsNotExist(err) {
    87				return "", fmt.Errorf("resolve symlinks for %q: %w", path, err)
    88			}
    89		}
    90	}
