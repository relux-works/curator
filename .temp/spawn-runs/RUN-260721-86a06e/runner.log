    92	func namespacePathsOverlap(left, right targetNamespacePath) (bool, error) {
    93		if namespaceContains(left.key, right.key) || namespaceContains(right.key, left.key) {
    94			return true, nil
    95		}
    96		leftInfo, leftErr := os.Stat(left.path)
    97		rightInfo, rightErr := os.Stat(right.path)
    98		if leftErr != nil && !os.IsNotExist(leftErr) {
    99			return false, fmt.Errorf("inspect target %d %s path: %w", left.target, left.kind, leftErr)
   100		}
   101		if rightErr != nil && !os.IsNotExist(rightErr) {
   102			return false, fmt.Errorf("inspect target %d %s path: %w", right.target, right.kind, rightErr)
   103		}
   104		return leftErr == nil && rightErr == nil && os.SameFile(leftInfo, rightInfo), nil
   105	}
   106	
   107	func namespaceContains(parent, child string) bool {
   108		parentVolume, parentParts := namespaceComponents(parent)
   109		childVolume, childParts := namespaceComponents(child)
   110		if !namespaceComponentEqual(parentVolume, childVolume) || len(parentParts) > len(childParts) {
   111			return false
   112		}
   113		for index := range parentParts {
   114			if !namespaceComponentEqual(parentParts[index], childParts[index]) {
   115				return false
   116			}
   117		}
   118		return true
   119	}
   120	
   121	func namespaceComponents(path string) (string, []string) {
   122		clean := filepath.Clean(path)
   123		volume := filepath.VolumeName(clean)
   124		remainder := clean[len(volume):]
   125		parts := strings.FieldsFunc(remainder, func(value rune) bool {
   126			if value == rune(filepath.Separator) {
   127				return true
   128			}
   129			return runtime.GOOS == "windows" && (value == '/' || value == '\\')
   130		})
   131		return volume, parts
   132	}
   133	
   134	func namespaceComponentEqual(left, right string) bool {
   135		if runtime.GOOS == "windows" {
   136			return strings.EqualFold(left, right)
   137		}
   138		return left == right
   139	}
