    43	// Prepare creates the durable journal before copying deterministic sibling
    44	// staging targets. Live targets are not changed. Preparation is kept under the
    45	// home lock so one transaction id cannot race another process.
    46	func (engine *Engine) Prepare(lock HomeLock, plan Plan) (*Journal, error) {
    47		if err := requireHomeLock(lock); err != nil {
    48			return nil, err
    49		}
    50		engine.mu.Lock()
    51		defer engine.mu.Unlock()
    52	
    53		journal, sources, err := engine.buildJournal(plan)
    54		if err != nil {
    55			return nil, err
    56		}
    57		if _, err := os.Lstat(engine.journalPath(journal.TransactionID)); err == nil {
    58			return nil, fmt.Errorf("transaction %s already exists", journal.TransactionID)
    59		} else if !os.IsNotExist(err) {
    60			return nil, err
    61		}
    62		if err := engine.saveJournal(journal); err != nil {
    63			return nil, err
    64		}
    65		prepared := false
    66		defer func() {
    67			if !prepared {
    68				_ = engine.removePreparedSidecars(journal)
    69			}
    70		}()
    71		for index := range journal.Targets {
    72			target := &journal.Targets[index]
    73			if target.StagedPath == "" {
    74				continue
    75			}
    76			if err := copyTarget(sources[index], target.StagedPath); err != nil {
    77				return nil, engine.abortPreparation(journal, err)
    78			}
    79			got, err := DigestPath(target.StagedPath)
    80			if err != nil || got != target.DesiredDigest {
    81				if err == nil {
    82					err = corruptionf("staged target %s/%s digest %s, want %s", target.Class, target.Identifier, got, target.DesiredDigest)
    83				}
    84				return nil, engine.abortPreparation(journal, err)
    85			}
    86		}
    87		journal.Phase = PhasePrepared
    88		if err := engine.saveJournal(journal); err != nil {
    89			return nil, engine.abortPreparation(journal, err)
    90		}
    91		if err := engine.emit(journal, -1, PointPrepared); err != nil {
    92			return nil, engine.abortPreparation(journal, err)
    93		}
    94		prepared = true
    95		return cloneJournal(journal), nil
    96	}
    97	
    98	func (engine *Engine) buildJournal(plan Plan) (*Journal, []string, error) {
    99		if !transactionIDPattern.MatchString(plan.TransactionID) {
   100			return nil, nil, fmt.Errorf("invalid transaction id")
   101		}
   102		if plan.ProjectIdentity == "" || !validText(plan.ProjectIdentity) {
   103			return nil, nil, fmt.Errorf("invalid project identity")
   104		}
   105		if len(plan.Targets) == 0 {
   106			return nil, nil, fmt.Errorf("transaction has no targets")
   107		}
   108		keys := append([]string(nil), plan.ReferencedBuildKeys...)
   109		sort.Slice(keys, func(i, j int) bool { return bytes.Compare([]byte(keys[i]), []byte(keys[j])) < 0 })
   110		if !sortedUniqueStrings(keys) && len(keys) > 0 {
   111			return nil, nil, fmt.Errorf("referenced build keys must be nonempty and unique")
   112		}
   113		targets := append([]Target(nil), plan.Targets...)
   114		sort.Slice(targets, func(i, j int) bool {
   115			if compared := bytes.Compare([]byte(targets[i].Class), []byte(targets[j].Class)); compared != 0 {
   116				return compared < 0
   117			}
   118			return bytes.Compare([]byte(targets[i].Identifier), []byte(targets[j].Identifier)) < 0
   119		})
   120		journal := &Journal{
   121			Schema:              journalSchema,
   122			TransactionID:       plan.TransactionID,
   123			ProjectIdentity:     plan.ProjectIdentity,
   124			Phase:               PhasePreparing,
   125			ReferencedBuildKeys: keys,
   126			Targets:             make([]TargetRecord, len(targets)),
   127		}
   128		sources := make([]string, len(targets))
   129		livePaths := make(map[string]struct{}, len(targets))
   130		for index, target := range targets {
   131			if target.Class == "" || target.Identifier == "" || !validText(target.Class) || !validText(target.Identifier) {
   132				return nil, nil, fmt.Errorf("target %d has invalid class or identifier", index)
   133			}
   134			if index > 0 && target.Class == targets[index-1].Class && target.Identifier == targets[index-1].Identifier {
   135				return nil, nil, fmt.Errorf("duplicate transaction target %s/%s", target.Class, target.Identifier)
   136			}
   137			if (target.PreimageDigest == "") == (target.ExpectedGeneration == "") {
   138				return nil, nil, fmt.Errorf("target %s/%s must have exactly one preimage expectation", target.Class, target.Identifier)
   139			}
   140			if target.PreimageDigest != "" && !validDigest(target.PreimageDigest) {
   141				return nil, nil, fmt.Errorf("target %s/%s has invalid preimage digest", target.Class, target.Identifier)
   142			}
   143			live, err := filepath.Abs(target.LivePath)
   144			if err != nil || target.LivePath == "" {
   145				return nil, nil, fmt.Errorf("target %s/%s live path is invalid", target.Class, target.Identifier)
   146			}
   147			live = filepath.Clean(live)
   148			if _, duplicate := livePaths[live]; duplicate {
   149				return nil, nil, fmt.Errorf("multiple transaction targets share live path %s", live)
   150			}
   151			livePaths[live] = struct{}{}
   152			if err := validateGenerationPath(target.GenerationPath); err != nil {
   153				return nil, nil, fmt.Errorf("target %s/%s: %w", target.Class, target.Identifier, err)
   154			}
   155			desiredDigest := DigestAbsent
   156			stagedPath := ""
   157			if target.StagedSource != "" {
   158				source, err := filepath.Abs(target.StagedSource)
   159				if err != nil {
   160					return nil, nil, err
   161				}
   162				source = filepath.Clean(source)
   163				if source == live {
   164					return nil, nil, fmt.Errorf("target %s/%s stages from its live path", target.Class, target.Identifier)
   165				}
   166				desiredDigest, err = DigestPath(source)
   167				if err != nil || desiredDigest == DigestAbsent {
   168					if err == nil {
   169						err = fmt.Errorf("staged source is absent")
   170					}
   171					return nil, nil, fmt.Errorf("target %s/%s: %w", target.Class, target.Identifier, err)
   172				}
   173				sources[index] = source
   174				stagedPath = sidecarPath(live, plan.TransactionID, index, "desired")
   175			}
   176			record := TargetRecord{
   177				Class:              target.Class,
   178				Identifier:         target.Identifier,
   179				LivePath:           live,
   180				StagedPath:         stagedPath,
   181				PreimageDigest:     target.PreimageDigest,
   182				ExpectedGeneration: target.ExpectedGeneration,
   183				GenerationPath:     target.GenerationPath,
   184				BackupPath:         sidecarPath(live, plan.TransactionID, index, "backup"),
   185				RollbackPath:       sidecarPath(live, plan.TransactionID, index, "rollback"),
   186				DesiredDigest:      desiredDigest,
   187				State:              StatePending,
   188			}
   189			for _, sidecar := range []string{record.StagedPath, record.BackupPath, record.RollbackPath} {
   190				if sidecar == "" {
   191					continue
   192				}
   193				if _, err := os.Lstat(sidecar); err == nil {
   194					return nil, nil, corruptionf("unreferenced transaction sidecar exists: %s", sidecar)
   195				} else if !os.IsNotExist(err) {
   196					return nil, nil, err
   197				}
   198			}
   199			journal.Targets[index] = record
   200		}
   201		if err := validateJournal(journal); err != nil {
   202			return nil, nil, err
   203		}
   204		return journal, sources, nil
   205	}
