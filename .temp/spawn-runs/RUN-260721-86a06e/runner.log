   629	func (engine *Engine) cleanupCommitted(journal *Journal) error {
   630		for index := range journal.Targets {
   631			target := &journal.Targets[index]
   632			current, err := DigestPath(target.LivePath)
   633			if err != nil {
   634				return err
   635			}
   636			if current != target.DesiredDigest {
   637				return corruptionf("cleanup refused changed target %s/%s", target.Class, target.Identifier)
   638			}
   639		}
   640		for index := len(journal.Targets) - 1; index >= 0; index-- {
   641			target := &journal.Targets[index]
   642			for _, path := range []string{target.BackupPath, target.RollbackPath, target.StagedPath} {
   643				if path != "" {
   644					if err := removeDurably(path); err != nil {
   645						return err
   646					}
   647				}
   648			}
   649		}
   650		return removeDurably(engine.journalPath(journal.TransactionID))
   651	}
   652	
   653	func (engine *Engine) removePreparedSidecars(journal *Journal) error {
   654		for index := len(journal.Targets) - 1; index >= 0; index-- {
   655			for _, path := range []string{journal.Targets[index].StagedPath, journal.Targets[index].BackupPath, journal.Targets[index].RollbackPath} {
   656				if path != "" {
   657					if err := removeDurably(path); err != nil {
   658						return err
   659					}
   660				}
   661			}
   662		}
   663		return nil
   664	}
