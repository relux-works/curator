   663	type removalCandidate struct {
   664		targetIndex int
   665		path        string
   666		digest      string
   667	}
   668	
   669	func committedRemovalCandidates(journal *Journal) []removalCandidate {
   670		removals := make([]removalCandidate, 0, len(journal.Targets)*3)
   671		for index := len(journal.Targets) - 1; index >= 0; index-- {
   672			target := &journal.Targets[index]
   673			removals = appendRemovalCandidate(removals, index, target.BackupPath, target.BackupDigest)
   674			removals = appendRemovalCandidate(removals, index, target.RollbackPath, target.DesiredDigest)
   675			removals = appendRemovalCandidate(removals, index, target.StagedPath, target.DesiredDigest)
   676		}
   677		return removals
   678	}
   679	
   680	func rollbackRemovalCandidates(journal *Journal) []removalCandidate {
   681		removals := make([]removalCandidate, 0, len(journal.Targets)*3)
   682		for index := len(journal.Targets) - 1; index >= 0; index-- {
   683			target := &journal.Targets[index]
   684			removals = appendRemovalCandidate(removals, index, target.StagedPath, target.DesiredDigest)
   685			removals = appendRemovalCandidate(removals, index, target.BackupPath, target.BackupDigest)
   686			removals = appendRemovalCandidate(removals, index, target.RollbackPath, target.DesiredDigest)
   687		}
   688		return removals
   689	}
   690	
   691	func appendRemovalCandidate(removals []removalCandidate, targetIndex int, path, digest string) []removalCandidate {
   692		if path == "" {
   693			return removals
   694		}
   695		return append(removals, removalCandidate{targetIndex: targetIndex, path: path, digest: digest})
   696	}
   697	
   698	func findRemovalCandidate(journal *Journal, path string) (removalCandidate, bool) {
   699		for _, removal := range committedRemovalCandidates(journal) {
   700			if removal.path == path {
   701				return removal, true
   702			}
   703		}
   704		return removalCandidate{}, false
   705	}
   706	
   707	func (engine *Engine) resumeRecordedRemoval(journal *Journal) error {
   708		if journal.RemovalPath == "" {
   709			return nil
   710		}
   711		removal, found := findRemovalCandidate(journal, journal.RemovalPath)
   712		if !found {
   713			return journalf("removal path is not a canonical transaction sidecar")
   714		}
   715		return engine.finishRecordedRemoval(journal, removal)
   716	}
   717	
   718	func (engine *Engine) removeRecordedSidecar(journal *Journal, removal removalCandidate) error {
   719		if journal.RemovalPath != "" {
   720			return corruptionf("transaction %s has unfinished removal %s before %s", journal.TransactionID, journal.RemovalPath, removal.path)
   721		}
   722		present, err := validateRemovalStart(removal.path, removal.digest)
   723		if err != nil {
   724			return err
   725		}
   726		if !present {
   727			return nil
   728		}
   729		journal.RemovalPath = removal.path
   730		if err := engine.saveJournal(journal); err != nil {
   731			journal.RemovalPath = ""
   732			return err
   733		}
   734		return engine.finishRecordedRemoval(journal, removal)
   735	}
   736	
   737	func (engine *Engine) finishRecordedRemoval(journal *Journal, removal removalCandidate) error {
   738		if journal.RemovalPath != removal.path {
   739			return corruptionf("transaction %s removal ownership does not match %s", journal.TransactionID, removal.path)
   740		}
   741		if err := removeDurablyWithOwnership(
   742			removal.path,
   743			removal.digest,
   744			true,
   745			func() error { return engine.emit(journal, removal.targetIndex, PointAfterCleanupRename) },
   746			func() error { return engine.emit(journal, removal.targetIndex, PointDuringCleanupRemoval) },
   747		); err != nil {
   748			return err
   749		}
   750		journal.RemovalPath = ""
   751		if err := engine.saveJournal(journal); err != nil {
   752			journal.RemovalPath = removal.path
   753			return err
   754		}
   755		return nil
   756	}
   757	
   758	func (engine *Engine) emit(journal *Journal, targetIndex int, point Point) error {
   759		event := Event{Point: point, TransactionID: journal.TransactionID, TargetIndex: targetIndex}
   760		if targetIndex >= 0 {
   761			event.Class = journal.Targets[targetIndex].Class
   762			event.Identifier = journal.Targets[targetIndex].Identifier
   763		}
   764		if engine.hooks.Observe != nil {
   765			engine.hooks.Observe(event)
   766		}
   767		if engine.hooks.Fault != nil {
   768			return engine.hooks.Fault(event)
   769		}
   770		return nil
   771	}
   772	
   773	// ReferencedBuildKeys returns the sorted union from every live journal. GC can
   774	// therefore retain in-flight artifacts without understanding current projects.
   775	func (engine *Engine) ReferencedBuildKeys(lock HomeLock) ([]string, error) {
   776		if err := requireHomeLock(lock); err != nil {
   777			return nil, err
   778		}
   779		engine.mu.Lock()
   780		defer engine.mu.Unlock()
   781		ids, err := engine.journalIDs()
   782		if err != nil {
   783			return nil, err
   784		}
   785		set := make(map[string]struct{})
   786		for _, id := range ids {
   787			journal, err := engine.loadJournal(id)
   788			if err != nil {
   789				return nil, err
   790			}
   791			for _, key := range journal.ReferencedBuildKeys {
   792				set[key] = struct{}{}
   793			}
   794		}
   795		keys := make([]string, 0, len(set))
   796		for key := range set {
   797			keys = append(keys, key)
   798		}
   799		sort.Slice(keys, func(i, j int) bool { return bytes.Compare([]byte(keys[i]), []byte(keys[j])) < 0 })
   800		return keys, nil
   801	}
   802	
   803	func cloneJournal(journal *Journal) *Journal {
   804		clone := *journal
   805		clone.ReferencedBuildKeys = append([]string(nil), journal.ReferencedBuildKeys...)
   806		clone.Targets = append([]TargetRecord(nil), journal.Targets...)
   807		return &clone
   808	}
