+			}
+			return err
+		}
+		if err := syncDirectory(filepath.Dir(current)); err != nil {
+			return err
+		}
+		if afterRemoval != nil {
+			if err := afterRemoval(); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
