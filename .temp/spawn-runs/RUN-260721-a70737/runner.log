   102		}
   103		return nil
   104	}
   105	
   106	func digestFile(hash io.Writer, path, rel string, info os.FileInfo) (result error) {
   107		file, err := os.Open(path) // #nosec G304 -- caller-selected transaction target
   108		if err != nil {
   109			return err
   110		}
   111		defer func() { result = errors.Join(result, file.Close()) }()
