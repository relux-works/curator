   347	func (engine *Engine) journalIDs() ([]string, error) {
   348		entries, err := os.ReadDir(engine.journalRoot)
   349		if os.IsNotExist(err) {
   350			return nil, nil
   351		}
   352		if err != nil {
   353			return nil, err
   354		}
   355		seen := make(map[string]string, len(entries))
   356		for _, entry := range entries {
   357			name := entry.Name()
   358			suffix := ""
   359			switch {
   360			case strings.HasSuffix(name, ".json.delete"):
   361				suffix = ".json.delete"
   362			case strings.HasSuffix(name, ".json"):
   363				suffix = ".json"
   364			default:
   365				continue
   366			}
   367			id := strings.TrimSuffix(name, suffix)
   368			if !transactionIDPattern.MatchString(id) {
   369				return nil, journalf("unexpected journal filename %q", name)
   370			}
   371			if prior, exists := seen[id]; exists {
   372				return nil, corruptionf("transaction %s has multiple journal records %q and %q", id, prior, name)
   373			}
   374			seen[id] = name
   375		}
   376		ids := make([]string, 0, len(seen))
   377		for id := range seen {
   378			ids = append(ids, id)
   379		}
   380		sort.Slice(ids, func(i, j int) bool { return bytes.Compare([]byte(ids[i]), []byte(ids[j])) < 0 })
   381		return ids, nil
   382	}
