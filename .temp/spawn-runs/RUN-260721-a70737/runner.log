+		return bytes.Compare([]byte(entries[i].RelativePath), []byte(entries[j].RelativePath)) < 0
+	})
+	if err := validateRemovalEntries(entries); err != nil {
+		return nil, corruptionf("durable removal manifest for %s is invalid: %v", path, err)
+	}
