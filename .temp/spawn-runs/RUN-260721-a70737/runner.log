    70			if err != nil {
    71				return err
    72			}
    73			paths = append(paths, filepath.ToSlash(rel))
    74			return nil
    75		})
    76		if err != nil {
    77			return err
    78		}
    79		sort.Slice(paths, func(i, j int) bool { return bytes.Compare([]byte(paths[i]), []byte(paths[j])) < 0 })
    80		for _, rel := range paths {
    81			path := filepath.Join(root, filepath.FromSlash(rel))
