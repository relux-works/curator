    57		}
    58		var paths []string
    59		err := filepath.Walk(root, func(path string, info os.FileInfo, walkErr error) error {
    60			if walkErr != nil {
    61				return walkErr
    62			}
    63			if path == root {
    64				return nil
    65			}
    66			if info.Mode()&os.ModeSymlink != 0 || (!info.IsDir() && !info.Mode().IsRegular()) {
    67				return fmt.Errorf("unsafe transaction tree entry at %s", path)
    68			}
