   113			return fmt.Errorf("transaction target has a negative size: %s", path)
   114		}
   115		// #nosec G115 -- the negative range was rejected immediately above.
   116		if err := writeDigestEntry(hash, 'f', rel, info.Mode().Perm(), uint64(info.Size())); err != nil {
   117			return err
   118		}
   119		if _, err := io.Copy(hash, file); err != nil {
   120			return err
   121		}
   122		after, err := file.Stat()
   123		if err != nil {
   124			return err
   125		}
   126		if !after.Mode().IsRegular() || after.Size() != info.Size() || after.Mode().Perm() != info.Mode().Perm() {
   127			return fmt.Errorf("transaction target changed while digesting: %s", path)
   128		}
   129		return nil
   130	}
   131	
   132	func writeDigestEntry(writer io.Writer, kind byte, rel string, mode os.FileMode, size uint64) error {
   133		if _, err := writer.Write([]byte{kind}); err != nil {
   134			return err
   135		}
   136		if err := binary.Write(writer, binary.BigEndian, uint64(len([]byte(rel)))); err != nil {
   137			return err
   138		}
   139		if _, err := writer.Write([]byte(rel)); err != nil {
   140			return err
   141		}
   142		if err := binary.Write(writer, binary.BigEndian, uint32(mode.Perm())); err != nil {
   143			return err
   144		}
   145		return binary.Write(writer, binary.BigEndian, size)
   146	}
