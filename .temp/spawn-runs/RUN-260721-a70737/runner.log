+		return pathErr
+	}
+	if tombErr != nil && !os.IsNotExist(tombErr) {
+		return tombErr
+	}
+	if pathExists && tombExists {
+		return corruptionf("durable removal refused simultaneous original and tomb for %s", path)
+	}
