   475	func removeTreeDurably(path string, afterRemoval func() error) error {
   476		info, err := os.Lstat(path)
   477		if os.IsNotExist(err) {
   478			return nil
   479		}
   480		if err != nil {
   481			return err
   482		}
   483		if info.Mode()&os.ModeSymlink != 0 || (!info.Mode().IsRegular() && !info.IsDir()) {
   484			return corruptionf("durable removal refused unsafe tomb entry %s", path)
   485		}
   486		if info.IsDir() {
   487			entries, err := os.ReadDir(path)
   488			if err != nil {
   489				return err
   490			}
   491			for _, entry := range entries {
   492				if err := removeTreeDurably(filepath.Join(path, entry.Name()), afterRemoval); err != nil {
   493					return err
   494				}
   495			}
   496		}
   497		if err := os.Remove(path); err != nil {
   498			return err
   499		}
   500		if err := syncDirectory(filepath.Dir(path)); err != nil {
   501			return err
   502		}
   503		if afterRemoval != nil {
   504			return afterRemoval()
   505		}
   506		return nil
   507	}
