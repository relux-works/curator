    18	// DigestPath returns a deterministic digest for one regular file or safe
    19	// directory tree. Links and special files are rejected. Absence is explicit.
    20	func DigestPath(path string) (string, error) {
    21		info, err := os.Lstat(path)
    22		if os.IsNotExist(err) {
    23			return DigestAbsent, nil
    24		}
    25		if err != nil {
    26			return "", err
    27		}
    28		hash := sha256.New()
    29		_, _ = hash.Write(digestDomain)
    30		if info.Mode().IsRegular() {
    31			if err := digestFile(hash, path, "", info); err != nil {
    32				return "", err
    33			}
    34		} else if info.IsDir() && info.Mode()&os.ModeSymlink == 0 {
    35			if err := digestDirectory(hash, path, info); err != nil {
    36				return "", err
    37			}
    38		} else {
    39			return "", fmt.Errorf("unsafe transaction target type at %s", path)
    40		}
    41		return "sha256:" + hex.EncodeToString(hash.Sum(nil)), nil
    42	}
    43	
    44	func digestRegularPayload(payload []byte, mode os.FileMode) (string, error) {
    45		hash := sha256.New()
    46		_, _ = hash.Write(digestDomain)
    47		if err := writeDigestEntry(hash, 'f', "", mode.Perm(), uint64(len(payload))); err != nil {
    48			return "", err
    49		}
    50		_, _ = hash.Write(payload)
    51		return "sha256:" + hex.EncodeToString(hash.Sum(nil)), nil
    52	}
    53	
    54	func digestDirectory(hash io.Writer, root string, rootInfo os.FileInfo) error {
    55		if err := writeDigestEntry(hash, 'd', "", rootInfo.Mode().Perm(), 0); err != nil {
