+			return err
+		}
+		if afterRename != nil {
+			if err := afterRename(); err != nil {
+				return err
+			}
+		}
+		tombExists = true
+	}
+	if !tombExists {
+		return nil
+	}
+	if _, err := os.Lstat(path); err == nil {
+		return corruptionf("durable removal refused concurrent original and tomb for %s", path)
+	} else if !os.IsNotExist(err) {
+		return err
+	}
