			second.RollbackPath = sidecarPath(second.LivePath, value.TransactionID, 1, "rollback")
			value.Targets = append(value.Targets, second)
		}},
	}
	for _, testCase := range tests {
		t.Run(testCase.name, func(t *testing.T) {
