+		}
+		byPath[entry.RelativePath] = entry
+	}
+	for _, entry := range entries[1:] {
+		parent := pathpkg.Dir(entry.RelativePath)
+		if parent == "." {
+			parent = ""
+		}
+		parentEntry, found := byPath[parent]
+		if !found || parentEntry.Kind != "directory" {
