index 0000000000000000000000000000000000000000..0ce9b602811f6a4980e45b0d3048693df1e7b733
--- /dev/null
+++ b/.temp/TASK-260720-2g21eg/reviewer-cycle3/TASK-260720-2g21eg_reviewer-cycle3-stdlib-identity-probe.py
@@ -0,0 +1,123 @@
+from __future__ import annotations
+
+import hashlib
+import json
+import stat
+import tempfile
+from pathlib import Path
+
+from csk.builds import go_v1
+
+
+def write(path: Path, payload: bytes, *, executable: bool = False) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(payload)
+    if executable:
+        path.chmod(stat.S_IRUSR | stat.S_IWUSR | stat.S_IXUSR)
+
+
+def main() -> None:
+    evidence_root = Path(__file__).resolve().parent
+    with tempfile.TemporaryDirectory(
+        prefix="stdlib-identity-probe-",
+        dir=evidence_root,
+    ) as temporary:
+        prefix = Path(temporary) / "manager"
+        interpreter = prefix / "bin" / "python3.14"
+        launcher = prefix / "bin" / "csk"
+        site_root = prefix / "lib" / "python3.14" / "site-packages"
+        package_root = site_root / "csk"
+        stdlib_module = prefix / "lib" / "python3.14" / "json" / "__init__.py"
+
+        write(interpreter, b"bound fake interpreter\n", executable=True)
+        write(
+            launcher,
+            f"#!{interpreter}\n# bound launcher\n".encode(),
+            executable=True,
+        )
+        write(package_root / "__init__.py", b"# csk\n")
+        write(package_root / "cli.py", b"# cli\n")
+        write(package_root / "builds" / "__init__.py", b"# builds\n")
+        write(package_root / "builds" / "go_v1.py", b"# go-v1\n")
+        original = b"# trusted stdlib module\n"
+        replacement = b"raise RuntimeError('unverified stdlib code executed')\n"
+        write(stdlib_module, original)
+
+        before = go_v1._resolve_manager_identity(launcher)
+        before_module_sha = hashlib.sha256(stdlib_module.read_bytes()).hexdigest()
+
+        runtime = {
+            "executable": str(before.interpreter.invocation_path),
+            "argv0": str(before.launcher.path),
+            "flags": {
+                "no_site": 1,
+                "no_user_site": 1,
+                "safe_path": 1,
+                "dont_write_bytecode": 1,
+            },
+            "path": [
+                str(before.startup.stdlib_root),
+                str(before.startup.site_root),
+            ],
+            "modules": [
+                {
+                    "name": "csk",
+                    "path": str(package_root / "__init__.py"),
+                },
+                {
+                    "name": "csk.cli",
+                    "path": str(package_root / "cli.py"),
+                },
+                {
+                    "name": "csk.builds.go_v1",
+                    "path": str(package_root / "builds" / "go_v1.py"),
+                },
+                {
+                    "name": "json",
+                    "path": str(stdlib_module),
+                },
+            ],
+        }
+        go_v1.validate_worker_runtime(runtime, before)
+
+        guard = go_v1._IdentityMutationGuard(
+            go_v1.PLATFORM_MACOS,
+            before.watch_paths(),
+        )
+        stdlib_module.write_bytes(replacement)
+        guard.close()
+        after = go_v1._resolve_manager_identity(launcher)
+        after_module_sha = hashlib.sha256(stdlib_module.read_bytes()).hexdigest()
+        go_v1.validate_worker_runtime(runtime, after)
+
+        result = {
+            "manager_identity_unchanged": before == after,
+            "startup_identity_unchanged": before.startup == after.startup,
+            "stdlib_module_sha_before": before_module_sha,
+            "stdlib_module_sha_after": after_module_sha,
+            "stdlib_module_changed": before_module_sha != after_module_sha,
+            "runtime_proof_accepted_before": True,
+            "runtime_proof_accepted_after": True,
+            "mutation_guard_accepted_change": True,
+            "stdlib_module_path": str(stdlib_module),
+            "stdlib_module_present_in_startup_hooks": any(
+                hook.path == stdlib_module.as_posix()
+                for hook in after.startup.hooks
+            ),
+        }
+        print(json.dumps(result, indent=2, sort_keys=True))
+
+        assert result == {
+            **result,
+            "manager_identity_unchanged": True,
+            "startup_identity_unchanged": True,
+            "stdlib_module_changed": True,
+            "runtime_proof_accepted_before": True,
+            "runtime_proof_accepted_after": True,
+            "mutation_guard_accepted_change": True,
+            "stdlib_module_present_in_startup_hooks": False,
+        }
+
+
+if __name__ == "__main__":
+    main()

apply patch
