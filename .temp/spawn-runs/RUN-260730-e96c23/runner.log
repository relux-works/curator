EXIT_OK = 0
EXIT_PARTIAL_FAIL = 1
EXIT_CONFIG = 2
EXIT_LOCK = 3


def main(argv: list[str] | None = None) -> int:
    # This is an implementation-only re-execution boundary.  It is reachable
    # only from the actual installed entry point with the one fixed argument;
    # programmatic argv, manifests, environment, PATH, and the public parser
    # cannot select it.
    if argv is None and sys.argv[1:] == ["__csk-go-worker-v1"]:
        from .builds.go_v1 import run_worker

        return run_worker()
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        return int(exc.code) if isinstance(exc.code, int) else EXIT_CONFIG
    if args.version:
        print(f"csk {__version__}")
        return EXIT_OK
    if not args.command:
        parser.print_help()
        return EXIT_OK
    try:
        return _dispatch(args)
    except (
        config.ConfigError,
        manifest.ManifestError,
        project_resolver.ProjectResolutionError,
        global_install.GlobalInstallError,
        installer.InstallError,
        hybrid.HybridError,
        audit_runner.AuditError,
        AuditBackendError,
        git_ops.GitError,
        ValueError,
    ) as exc:
        print(f"error: {exc}", file=sys.stderr)
