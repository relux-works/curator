+func v6SkillManifest(command map[string]any) map[string]any {
+	return map[string]any{
+		"schema_version": 6,
+		"capabilities":   map[string]any{},
+		"build_roots":    []any{"build"},
+		"commands":       map[string]any{"build-tool": command},
+	}
