/bin/zsh -lc 'before_digest=$(find conformance/v1 -type f ! -path '"'*/.DS_Store' -print0 | sort -z | xargs -0 shasum -a 256 | shasum -a 256 | awk '{print "'$1}'"')
make regenerate
after_digest="'$(find conformance/v1 -type f ! -path '"'*/.DS_Store' -print0 | sort -z | xargs -0 shasum -a 256 | shasum -a 256 | awk '{print "'$1}'"')
printf 'before=%s\\nafter=%s\\n' \""'$before_digest" "$after_digest"
test "$before_digest" = "$after_digest"
test ! -e .temp/TASK-260720-wajgn8-regenerate-index
GIT_INDEX_FILE="$PWD/.temp/TASK-260720-wajgn8-regenerate-index" git read-tree HEAD
