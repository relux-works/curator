+	}
+	for _, field := range []string{"args", "env", "flags", "hooks", "output", "scripts", "tags", "toolchain"} {
+		examples = append(examples, schemaExample{
+			name:     "invalid-build-" + field,
+			instance: withField(field, []any{}),
+		})
+	}
+	return examples
+}
