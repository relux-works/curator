   442	func TestAbnormalChildExitReleasesOSLock(t *testing.T) {
   443		home := t.TempDir()
   444		project := t.TempDir()
   445		command := helperCommand("hold-project", home, project)
   446		stdout, err := command.StdoutPipe()
   447		if err != nil {
   448			t.Fatal(err)
   449		}
   450		command.Stderr = os.Stderr
   451		stdin, err := command.StdinPipe()
   452		if err != nil {
   453			t.Fatal(err)
   454		}
   455		t.Cleanup(func() {
   456			_ = stdin.Close()
   457		})
   458		if err := command.Start(); err != nil {
   459			t.Fatal(err)
   460		}
   461		scanner := bufio.NewScanner(stdout)
   462		if !scanner.Scan() || scanner.Text() != "ready" {
   463			_ = command.Process.Kill()
   464			_ = command.Wait()
   465			t.Fatalf("child did not report held lock: %q (%v)", scanner.Text(), scanner.Err())
   466		}
