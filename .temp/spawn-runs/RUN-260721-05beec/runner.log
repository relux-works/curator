    20	// symlinks are evaluated so aliases of one project contend on the same lock.
    21	func CanonicalProject(path string) (ProjectIdentity, error) {
    22		canonical, err := canonicalAbsolute(path, "project path")
    23		if err != nil {
    24			return "", err
    25		}
    26		return ProjectIdentity(canonical), nil
    27	}
    28	
    29	// CanonicalProjects returns unique canonical identities in unsigned UTF-8 byte
    30	// order. Duplicate physical or textual project identities are rejected.
    31	func CanonicalProjects(paths ...string) ([]ProjectIdentity, error) {
    32		identities := make([]ProjectIdentity, 0, len(paths))
    33		for _, path := range paths {
    34			identity, err := CanonicalProject(path)
    35			if err != nil {
    36				return nil, err
    37			}
    38			identities = append(identities, identity)
    39		}
    40		sort.Slice(identities, func(i, j int) bool {
    41			return bytes.Compare([]byte(identities[i]), []byte(identities[j])) < 0
    42		})
    43		for index := 1; index < len(identities); index++ {
    44			if identities[index-1] == identities[index] {
    45				return nil, fmt.Errorf("duplicate canonical project identity %q", identities[index])
    46			}
    47		}
    48		return identities, nil
    49	}
    50	
    51	func canonicalAbsolute(path, label string) (string, error) {
    52		if path == "" {
    53			return "", fmt.Errorf("%s is empty", label)
    54		}
    55		if !utf8.ValidString(path) || strings.IndexByte(path, 0) >= 0 {
    56			return "", fmt.Errorf("%s is not valid UTF-8 filesystem text", label)
    57		}
    58		absolute, err := filepath.Abs(path)
    59		if err != nil {
    60			return "", fmt.Errorf("resolve %s: %w", label, err)
    61		}
    62		absolute = filepath.Clean(absolute)
    63		resolved, err := filepath.EvalSymlinks(absolute)
    64		if err == nil {
    65			return canonicalWithExistingPrefix(filepath.Clean(resolved), nil, label)
    66		}
    67		if !os.IsNotExist(err) {
    68			return "", fmt.Errorf("resolve %s symlinks: %w", label, err)
    69		}
    70	
    71		// A first mutation may address a not-yet-created manager home. Resolve the
    72		// longest existing prefix so its identity does not change after the missing
    73		// suffix is created through a symlinked ancestor.
    74		prefix := absolute
    75		suffix := make([]string, 0, 4)
    76		for {
    77			parent := filepath.Dir(prefix)
    78			if parent == prefix {
    79				return "", fmt.Errorf("resolve existing prefix for %s: %w", label, err)
    80			}
    81			suffix = append(suffix, filepath.Base(prefix))
    82			prefix = parent
    83	
    84			resolved, err = filepath.EvalSymlinks(prefix)
    85			if err == nil {
    86				return canonicalWithExistingPrefix(filepath.Clean(resolved), suffix, label)
    87			}
    88			if !os.IsNotExist(err) {
    89				return "", fmt.Errorf("resolve %s symlinks: %w", label, err)
    90			}
    91		}
    92	}
    93	
    94	func lockName(domain, identity string) string {
    95		digest := sha256.Sum256([]byte(domain + "\x00" + identity))
    96		return hex.EncodeToString(digest[:]) + ".lock"
    97	}
### internal/managerlock/identity_unix.go
     1	//go:build unix
     2	
     3	package managerlock
     4	
     5	import "path/filepath"
     6	
     7	func canonicalWithExistingPrefix(existing string, missing []string, _ string) (string, error) {
     8		canonical := existing
     9		for index := len(missing) - 1; index >= 0; index-- {
    10			canonical = filepath.Join(canonical, missing[index])
    11		}
    12		return filepath.Clean(canonical), nil
    13	}
### internal/managerlock/identity_windows.go
     1	//go:build windows
     2	
     3	package managerlock
     4	
     5	import (
     6		"errors"
     7		"fmt"
     8		"path/filepath"
     9		"strings"
    10		"unsafe"
    11	
    12		"golang.org/x/sys/windows"
    13	)
    14	
    15	func canonicalWithExistingPrefix(existing string, missing []string, label string) (string, error) {
    16		caseSensitive, err := directoryCaseSensitive(existing)
    17		if err != nil {
    18			return "", fmt.Errorf("resolve case sensitivity for %s: %w", label, err)
    19		}
    20		canonical := existing
    21		for index := len(missing) - 1; index >= 0; index-- {
    22			canonical = filepath.Join(canonical, missing[index])
    23		}
    24		canonical = filepath.Clean(canonical)
    25		if caseSensitive {
    26			return canonical, nil
    27		}
    28	
    29		// Windows' ordinary path lookup is case-insensitive. Normalize both the
    30		// resolved prefix and a not-yet-created suffix so managers constructed
    31		// before and after first use retain one identity. A directory with the
    32		// per-directory case-sensitive flag keeps its exact spelling instead.
    33		return strings.ToUpper(canonical), nil
    34	}
    35	
    36	func directoryCaseSensitive(path string) (bool, error) {
    37		pathUTF16, err := windows.UTF16PtrFromString(path)
    38		if err != nil {
    39			return false, err
    40		}
    41		handle, err := windows.CreateFile(
    42			pathUTF16,
    43			windows.FILE_READ_ATTRIBUTES,
    44			windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE,
    45			nil,
    46			windows.OPEN_EXISTING,
    47			windows.FILE_FLAG_BACKUP_SEMANTICS,
    48			0,
    49		)
    50		if err != nil {
    51			return false, err
    52		}
    53		defer windows.CloseHandle(handle)
    54	
    55		var flags uint32
    56		err = windows.GetFileInformationByHandleEx(
    57			handle,
    58			windows.FileCaseSensitiveInfo,
    59			(*byte)(unsafe.Pointer(&flags)),
    60			uint32(unsafe.Sizeof(flags)),
    61		)
    62		if err == nil {
    63			return flags&windows.FILE_CS_FLAG_CASE_SENSITIVE_DIR != 0, nil
    64		}
    65		if errors.Is(err, windows.ERROR_INVALID_FUNCTION) ||
    66			errors.Is(err, windows.ERROR_NOT_SUPPORTED) ||
    67			errors.Is(err, windows.ERROR_INVALID_PARAMETER) ||
    68			errors.Is(err, windows.ERROR_CALL_NOT_IMPLEMENTED) {
    69			// Filesystems and Windows versions without per-directory case
    70			// sensitivity use traditional case-insensitive path lookup.
    71			return false, nil
    72		}
    73		return false, err
    74	}
### internal/managerlock/filelock.go
     1	package managerlock
     2	
     3	import (
     4		"context"
     5		"errors"
     6		"fmt"
     7		"os"
     8		"path/filepath"
     9		"sync"
    10		"time"
    11	)
    12	
    13	const lockRetryInterval = 10 * time.Millisecond
    14	
    15	type fileLock struct {
    16		mu        sync.Mutex
    17		file      *os.File
    18		held      bool
    19		onRelease func()
    20	}
    21	
    22	func acquireFileLock(ctx context.Context, path string, onRelease func()) (*fileLock, error) {
    23		if ctx == nil {
    24			return nil, fmt.Errorf("lock context is nil")
    25		}
    26		if err := ctx.Err(); err != nil {
    27			return nil, err
    28		}
    29		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
    30			return nil, fmt.Errorf("create manager lock state: %w", err)
    31		}
    32		file, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o600) // #nosec G304 -- path is derived below the canonical manager home
    33		if err != nil {
    34			return nil, fmt.Errorf("open manager lock: %w", err)
    35		}
    36	
    37		for {
    38			locked, lockErr := tryFileLock(file)
    39			if lockErr != nil {
    40				_ = file.Close()
    41				return nil, fmt.Errorf("acquire manager lock: %w", lockErr)
    42			}
    43			if locked {
    44				if err := ctx.Err(); err != nil {
    45					_ = unlockFile(file)
    46					_ = file.Close()
    47					return nil, err
    48				}
    49				return &fileLock{file: file, held: true, onRelease: onRelease}, nil
    50			}
    51	
    52			timer := time.NewTimer(lockRetryInterval)
    53			select {
    54			case <-ctx.Done():
    55				if !timer.Stop() {
    56					select {
    57					case <-timer.C:
    58					default:
    59					}
    60				}
    61				_ = file.Close()
    62				return nil, ctx.Err()
    63			case <-timer.C:
    64			}
    65		}
    66	}
    67	
    68	func (lock *fileLock) AssertHeld() error {
    69		if lock == nil {
    70			return ErrNotHeld
    71		}
    72		lock.mu.Lock()
    73		defer lock.mu.Unlock()
    74		if !lock.held || lock.file == nil {
    75			return ErrNotHeld
    76		}
    77		return nil
    78	}
    79	
    80	func (lock *fileLock) Close() error {
    81		if lock == nil {
    82			return nil
    83		}
    84		lock.mu.Lock()
    85		if !lock.held || lock.file == nil {
    86			lock.mu.Unlock()
    87			return nil
    88		}
    89		file := lock.file
    90		lock.file = nil
    91		lock.held = false
    92		onRelease := lock.onRelease
    93		lock.onRelease = nil
    94		err := errors.Join(unlockFile(file), file.Close())
    95		lock.mu.Unlock()
    96		if onRelease != nil {
    97			onRelease()
    98		}
    99		return err
   100	}
### internal/managerlock/filelock_unix.go
     1	//go:build unix
     2	
     3	package managerlock
     4	
     5	import (
     6		"errors"
     7		"os"
     8	
     9		"golang.org/x/sys/unix"
    10	)
    11	
    12	func tryFileLock(file *os.File) (bool, error) {
    13		err := unix.Flock(int(file.Fd()), unix.LOCK_EX|unix.LOCK_NB)
    14		if err == nil {
    15			return true, nil
    16		}
    17		if errors.Is(err, unix.EWOULDBLOCK) || errors.Is(err, unix.EAGAIN) {
    18			return false, nil
    19		}
    20		return false, err
    21	}
    22	
    23	func unlockFile(file *os.File) error {
    24		return unix.Flock(int(file.Fd()), unix.LOCK_UN)
    25	}
### internal/managerlock/filelock_windows.go
     1	//go:build windows
     2	
     3	package managerlock
     4	
     5	import (
     6		"errors"
     7		"os"
     8	
     9		"golang.org/x/sys/windows"
    10	)
    11	
    12	func tryFileLock(file *os.File) (bool, error) {
    13		overlapped := new(windows.Overlapped)
    14		err := windows.LockFileEx(
    15			windows.Handle(file.Fd()),
    16			windows.LOCKFILE_EXCLUSIVE_LOCK|windows.LOCKFILE_FAIL_IMMEDIATELY,
    17			0,
    18			1,
    19			0,
    20			overlapped,
    21		)
    22		if err == nil {
    23			return true, nil
    24		}
    25		if errors.Is(err, windows.ERROR_LOCK_VIOLATION) {
    26			return false, nil
    27		}
    28		return false, err
    29	}
    30	
    31	func unlockFile(file *os.File) error {
    32		overlapped := new(windows.Overlapped)
    33		return windows.UnlockFileEx(windows.Handle(file.Fd()), 0, 1, 0, overlapped)
    34	}
### internal/managerlock/managerlock.go
     1	// Package managerlock provides cross-process locks for Curator operations.
     2	// Lock files are stable manager state; release drops only the operating-system
     3	// lock and never removes a path that another process may already have opened.
     4	package managerlock
     5	
     6	import (
     7		"context"
     8		"errors"
     9		"fmt"
    10		"path/filepath"
    11		"strings"
    12		"sync"
    13		"unicode/utf8"
    14	)
    15	
    16	var (
    17		// ErrLockOrder reports an acquisition that would invert the required
    18		// project -> optional build key -> manager-home order.
    19		ErrLockOrder = errors.New("manager lock acquisition order violation")
    20		// ErrDryRun reports an attempted acquisition on a dry-run path. The error
    21		// is returned before any lock directory or file is created.
    22		ErrDryRun = errors.New("dry-run must not acquire manager locks")
    23		// ErrNotHeld reports a released or otherwise invalid lock witness.
    24		ErrNotHeld = errors.New("manager lock is not held")
    25	)
    26	
    27	// Manager derives every lock path from one configured Curator home. New is
    28	// read-only; lock state is created lazily by a real acquisition.
    29	type Manager struct {
    30		home     string
    31		lockRoot string
    32		process  *processState
    33	}
    34	
    35	// New constructs a manager without creating filesystem state.
    36	func New(home string) (*Manager, error) {
    37		canonical, err := canonicalAbsolute(home, "manager home")
    38		if err != nil {
    39			return nil, err
    40		}
    41		return &Manager{
    42			home:     canonical,
    43			lockRoot: filepath.Join(canonical, "state", "locks", "v1"),
    44			process:  stateForHome(canonical),
    45		}, nil
    46	}
    47	
    48	// Home is the canonical absolute configured Curator home.
    49	func (manager *Manager) Home() string {
    50		if manager == nil {
    51			return ""
    52		}
    53		return manager.home
    54	}
    55	
    56	// Operation owns one ordered project operation. A dry-run operation rejects
    57	// every acquisition before filesystem access.
    58	type Operation struct {
    59		mu           sync.Mutex
    60		manager      *Manager
    61		dryRun       bool
    62		closed       bool
    63		projects     []*fileLock
    64		identities   []ProjectIdentity
    65		buildKey     *fileLock
    66		buildKeyUsed bool
    67		home         *HomeLock
    68	}
    69	
    70	// NewOperation creates an operation state machine. It performs no I/O.
    71	func (manager *Manager) NewOperation(dryRun bool) *Operation {
    72		return &Operation{manager: manager, dryRun: dryRun}
    73	}
    74	
    75	// AcquireProjects canonicalizes and sorts the complete batch before acquiring
    76	// it. Later batches are permitted only when every new identity follows the
    77	// last held identity, so an inversion fails before waiting on an OS lock.
    78	func (operation *Operation) AcquireProjects(ctx context.Context, projects ...string) ([]ProjectIdentity, error) {
    79		if operation == nil || operation.manager == nil {
    80			return nil, fmt.Errorf("manager operation is nil")
    81		}
    82		if operation.dryRun {
    83			return nil, ErrDryRun
    84		}
    85		identities, err := CanonicalProjects(projects...)
    86		if err != nil {
    87			return nil, err
    88		}
    89		if len(identities) == 0 {
    90			return nil, fmt.Errorf("at least one project lock is required")
    91		}
    92	
    93		operation.mu.Lock()
    94		defer operation.mu.Unlock()
    95		if operation.closed {
    96			return nil, orderError("operation is closed")
    97		}
    98		if operation.buildKeyUsed || operation.home != nil {
    99			return nil, orderError("project lock requested after a later lock class")
   100		}
   101		if len(operation.identities) > 0 && compareProject(operation.identities[len(operation.identities)-1], identities[0]) >= 0 {
   102			return nil, orderError("project identities are not strictly increasing")
   103		}
   104		if err := operation.manager.process.reserve(acquireProject); err != nil {
   105			return nil, err
   106		}
   107		acquired := false
   108		defer func() { operation.manager.process.finish(acquireProject, acquired) }()
   109	
   110		batch := make([]*fileLock, 0, len(identities))
   111		for _, identity := range identities {
   112			lock, acquireErr := acquireFileLock(ctx, operation.manager.projectLockPath(identity), nil)
   113			if acquireErr != nil {
   114				for index := len(batch) - 1; index >= 0; index-- {
   115					acquireErr = errors.Join(acquireErr, batch[index].Close())
   116				}
   117				return nil, acquireErr
   118			}
   119			batch = append(batch, lock)
   120		}
   121		acquired = true
   122		operation.projects = append(operation.projects, batch...)
   123		operation.identities = append(operation.identities, identities...)
   124		return append([]ProjectIdentity(nil), operation.identities...), nil
   125	}
   126	
   127	// AcquireBuildKey takes the optional per-key deduplication lock. An operation
   128	// may use at most one key, and must release it before acquiring the home lock.
   129	func (operation *Operation) AcquireBuildKey(ctx context.Context, logicalKey string) error {
   130		if operation == nil || operation.manager == nil {
   131			return fmt.Errorf("manager operation is nil")
   132		}
   133		if operation.dryRun {
   134			return ErrDryRun
   135		}
   136		if logicalKey == "" || !utf8.ValidString(logicalKey) || strings.IndexByte(logicalKey, 0) >= 0 {
   137			return fmt.Errorf("logical build key is empty or invalid UTF-8")
   138		}
   139	
   140		operation.mu.Lock()
   141		defer operation.mu.Unlock()
   142		if operation.closed || len(operation.projects) == 0 || operation.buildKeyUsed || operation.home != nil {
   143			return orderError("build-key lock requires held project locks and may be used once before the home lock")
   144		}
   145		if err := operation.manager.process.reserve(acquireBuildKey); err != nil {
   146			return err
   147		}
   148		acquired := false
   149		defer func() { operation.manager.process.finish(acquireBuildKey, acquired) }()
   150		lock, err := acquireFileLock(ctx, operation.manager.buildKeyLockPath(logicalKey), func() {
   151			operation.manager.process.released(acquireBuildKey)
   152		})
   153		if err != nil {
   154			return err
   155		}
   156		acquired = true
   157		operation.buildKey = lock
   158		operation.buildKeyUsed = true
   159		return nil
   160	}
   161	
   162	// ReleaseBuildKey releases the optional key lock before the serialized commit
   163	// phase. The persistent lock file deliberately remains in manager state.
   164	func (operation *Operation) ReleaseBuildKey() error {
   165		if operation == nil {
   166			return nil
   167		}
   168		operation.mu.Lock()
   169		defer operation.mu.Unlock()
   170		if operation.buildKey == nil {
   171			return orderError("build-key lock is not held")
   172		}
   173		err := operation.buildKey.Close()
   174		operation.buildKey = nil
   175		return err
   176	}
   177	
   178	// HomeLock is an exclusive manager-home mutation witness. It satisfies the
   179	// caller-held witness expected by buildcache and future transaction code.
   180	type HomeLock struct {
   181		lock *fileLock
   182	}
   183	
   184	// AssertHeld verifies that the operating-system lock has not been released.
   185	func (lock *HomeLock) AssertHeld() error {
   186		if lock == nil {
   187			return ErrNotHeld
   188		}
   189		return lock.lock.AssertHeld()
   190	}
   191	
   192	// Close releases the operating-system lock without deleting its stable file.
   193	func (lock *HomeLock) Close() error {
   194		if lock == nil {
   195			return nil
   196		}
   197		return lock.lock.Close()
   198	}
   199	
   200	// AcquireHome acquires the mutation lock after project locks and after an
   201	// optional build-key lock has been released.
   202	func (operation *Operation) AcquireHome(ctx context.Context) (*HomeLock, error) {
   203		if operation == nil || operation.manager == nil {
   204			return nil, fmt.Errorf("manager operation is nil")
   205		}
   206		if operation.dryRun {
   207			return nil, ErrDryRun
   208		}
   209		operation.mu.Lock()
   210		defer operation.mu.Unlock()
   211		if operation.closed || len(operation.projects) == 0 || operation.buildKey != nil || operation.home != nil {
   212			return nil, orderError("home lock requires held project locks and no held build-key lock")
   213		}
   214		return operation.acquireHome(ctx)
   215	}
   216	
   217	func (operation *Operation) acquireHome(ctx context.Context) (*HomeLock, error) {
   218		if err := operation.manager.process.reserve(acquireHome); err != nil {
   219			return nil, err
   220		}
   221		acquired := false
   222		defer func() { operation.manager.process.finish(acquireHome, acquired) }()
   223		fileLock, err := acquireFileLock(ctx, operation.manager.homeLockPath(), func() {
   224			operation.manager.process.released(acquireHome)
   225		})
   226		if err != nil {
   227			return nil, err
   228		}
   229		acquired = true
   230		operation.home = &HomeLock{lock: fileLock}
   231		return operation.home, nil
   232	}
   233	
   234	// AcquireHomeOnly is the recovery/GC path. It acquires no project or key lock.
   235	// dryRun rejects the request without creating any manager state.
   236	func (manager *Manager) AcquireHomeOnly(ctx context.Context, dryRun bool) (*HomeLock, error) {
   237		if manager == nil {
   238			return nil, fmt.Errorf("manager is nil")
   239		}
   240		if dryRun {
   241			return nil, ErrDryRun
   242		}
   243		if err := manager.process.reserve(acquireHome); err != nil {
   244			return nil, err
   245		}
   246		acquired := false
   247		defer func() { manager.process.finish(acquireHome, acquired) }()
   248		fileLock, err := acquireFileLock(ctx, manager.homeLockPath(), func() {
   249			manager.process.released(acquireHome)
   250		})
   251		if err != nil {
   252			return nil, err
   253		}
   254		acquired = true
   255		return &HomeLock{lock: fileLock}, nil
   256	}
   257	
   258	// Close releases held locks in reverse class and project order.
   259	func (operation *Operation) Close() error {
   260		if operation == nil {
   261			return nil
   262		}
   263		operation.mu.Lock()
   264		defer operation.mu.Unlock()
   265		if operation.closed {
   266			return nil
   267		}
   268		operation.closed = true
   269		var result error
   270		if operation.home != nil {
   271			result = errors.Join(result, operation.home.Close())
   272			operation.home = nil
   273		}
   274		if operation.buildKey != nil {
   275			result = errors.Join(result, operation.buildKey.Close())
   276			operation.buildKey = nil
   277		}
   278		for index := len(operation.projects) - 1; index >= 0; index-- {
   279			result = errors.Join(result, operation.projects[index].Close())
   280		}
   281		operation.projects = nil
   282		return result
   283	}
   284	
   285	func (manager *Manager) projectLockPath(identity ProjectIdentity) string {
   286		return filepath.Join(manager.lockRoot, "projects", lockName("project", string(identity)))
   287	}
   288	
   289	func (manager *Manager) buildKeyLockPath(logicalKey string) string {
   290		return filepath.Join(manager.lockRoot, "build", lockName("build-key", logicalKey))
   291	}
   292	
   293	func (manager *Manager) homeLockPath() string {
   294		return filepath.Join(manager.lockRoot, lockName("manager-home", manager.home))
   295	}
   296	
   297	func compareProject(left, right ProjectIdentity) int {
   298		leftBytes, rightBytes := []byte(left), []byte(right)
   299		for index := 0; index < len(leftBytes) && index < len(rightBytes); index++ {
   300			if leftBytes[index] < rightBytes[index] {
   301				return -1
   302			}
   303			if leftBytes[index] > rightBytes[index] {
   304				return 1
   305			}
   306		}
   307		switch {
   308		case len(leftBytes) < len(rightBytes):
   309			return -1
   310		case len(leftBytes) > len(rightBytes):
   311			return 1
   312		default:
   313			return 0
   314		}
   315	}
   316	
   317	func orderError(detail string) error {
   318		return fmt.Errorf("%w: %s", ErrLockOrder, detail)
   319	}
   320	
   321	type acquisitionKind uint8
   322	
   323	const (
   324		acquireProject acquisitionKind = iota
   325		acquireBuildKey
   326		acquireHome
   327	)
   328	
   329	type processState struct {
   330		mu             sync.Mutex
   331		projectPending int
   332		keyPending     int
   333		keysHeld       int
   334		homePending    int
   335		homesHeld      int
   336	}
   337	
   338	var processStates = struct {
   339		sync.Mutex
   340		byHome map[string]*processState
   341	}{byHome: map[string]*processState{}}
   342	
   343	func stateForHome(home string) *processState {
   344		processStates.Lock()
   345		defer processStates.Unlock()
   346		if state := processStates.byHome[home]; state != nil {
   347			return state
   348		}
   349		state := new(processState)
   350		processStates.byHome[home] = state
   351		return state
   352	}
   353	
   354	func (state *processState) reserve(kind acquisitionKind) error {
   355		state.mu.Lock()
   356		defer state.mu.Unlock()
   357		switch kind {
   358		case acquireProject:
   359			if state.homesHeld > 0 || state.homePending > 0 {
   360				return orderError("project lock requested while the process holds or is acquiring the home lock")
   361			}
   362			state.projectPending++
   363		case acquireBuildKey:
   364			if state.homesHeld > 0 || state.homePending > 0 {
   365				return orderError("build-key lock requested while the process holds or is acquiring the home lock")
   366			}
   367			state.keyPending++
   368		case acquireHome:
   369			if state.keysHeld > 0 || state.keyPending > 0 || state.projectPending > 0 {
   370				return orderError("home lock requested before an in-process project/key acquisition completed or key release")
   371			}
   372			state.homePending++
   373		}
   374		return nil
   375	}
   376	
   377	func (state *processState) finish(kind acquisitionKind, acquired bool) {
   378		state.mu.Lock()
   379		defer state.mu.Unlock()
   380		switch kind {
   381		case acquireProject:
   382			state.projectPending--
   383		case acquireBuildKey:
   384			state.keyPending--
   385			if acquired {
   386				state.keysHeld++
   387			}
   388		case acquireHome:
   389			state.homePending--
   390			if acquired {
   391				state.homesHeld++
   392			}
   393		}
   394	}
   395	
   396	func (state *processState) released(kind acquisitionKind) {
   397		state.mu.Lock()
   398		defer state.mu.Unlock()
   399		switch kind {
   400		case acquireBuildKey:
   401			if state.keysHeld > 0 {
   402				state.keysHeld--
   403			}
   404		case acquireHome:
   405			if state.homesHeld > 0 {
   406				state.homesHeld--
   407			}
   408		}
   409	}
