   129	func (operation *Operation) AcquireBuildKey(ctx context.Context, logicalKey string) error {
   130		if operation == nil || operation.manager == nil {
   131			return fmt.Errorf("manager operation is nil")
   132		}
   133		if operation.dryRun {
   134			return ErrDryRun
   135		}
   136		if logicalKey == "" || !utf8.ValidString(logicalKey) || strings.IndexByte(logicalKey, 0) >= 0 {
   137			return fmt.Errorf("logical build key is empty or invalid UTF-8")
   138		}
   139	
   140		operation.mu.Lock()
   141		defer operation.mu.Unlock()
   142		if operation.closed || len(operation.projects) == 0 || operation.buildKeyUsed || operation.home != nil {
   143			return orderError("build-key lock requires held project locks and may be used once before the home lock")
   144		}
   145		if err := operation.manager.process.reserve(acquireBuildKey); err != nil {
   146			return err
   147		}
   148		acquired := false
   149		defer func() { operation.manager.process.finish(acquireBuildKey, acquired) }()
   150		lock, err := acquireFileLock(ctx, operation.manager.buildKeyLockPath(logicalKey), func() {
   151			operation.manager.process.released(acquireBuildKey)
   152		})
   153		if err != nil {
   154			return err
   155		}
   156		acquired = true
   157		operation.buildKey = lock
   158		operation.buildKeyUsed = true
   159		return nil
   160	}
   161	
   162	// ReleaseBuildKey releases the optional key lock before the serialized commit
   163	// phase. The persistent lock file deliberately remains in manager state.
   164	func (operation *Operation) ReleaseBuildKey() error {
   165		if operation == nil {
   166			return nil
   167		}
   168		operation.mu.Lock()
   169		defer operation.mu.Unlock()
   170		if operation.buildKey == nil {
   171			return orderError("build-key lock is not held")
   172		}
   173		err := operation.buildKey.Close()
   174		operation.buildKey = nil
   175		return err
   176	}
   177	
   178	// HomeLock is an exclusive manager-home mutation witness. It satisfies the
   179	// caller-held witness expected by buildcache and future transaction code.
   180	type HomeLock struct {
   181		lock *fileLock
   182	}
   183	
   184	// AssertHeld verifies that the operating-system lock has not been released.
   185	func (lock *HomeLock) AssertHeld() error {
   186		if lock == nil {
   187			return ErrNotHeld
   188		}
   189		return lock.lock.AssertHeld()
   190	}
   191	
   192	// Close releases the operating-system lock without deleting its stable file.
   193	func (lock *HomeLock) Close() error {
   194		if lock == nil {
   195			return nil
   196		}
   197		return lock.lock.Close()
   198	}
   199	
   200	// AcquireHome acquires the mutation lock after project locks and after an
   201	// optional build-key lock has been released.
   202	func (operation *Operation) AcquireHome(ctx context.Context) (*HomeLock, error) {
   203		if operation == nil || operation.manager == nil {
   204			return nil, fmt.Errorf("manager operation is nil")
   205		}
   206		if operation.dryRun {
   207			return nil, ErrDryRun
   208		}
   209		operation.mu.Lock()
   210		defer operation.mu.Unlock()
   211		if operation.closed || len(operation.projects) == 0 || operation.buildKey != nil || operation.home != nil {
   212			return nil, orderError("home lock requires held project locks and no held build-key lock")
   213		}
   214		return operation.acquireHome(ctx)
   215	}
   216	
   217	func (operation *Operation) acquireHome(ctx context.Context) (*HomeLock, error) {
   218		if err := operation.manager.process.reserve(acquireHome); err != nil {
   219			return nil, err
   220		}
   221		acquired := false
   222		defer func() { operation.manager.process.finish(acquireHome, acquired) }()
   223		fileLock, err := acquireFileLock(ctx, operation.manager.homeLockPath(), func() {
   224			operation.manager.process.released(acquireHome)
   225		})
   226		if err != nil {
   227			return nil, err
   228		}
   229		acquired = true
   230		operation.home = &HomeLock{lock: fileLock}
   231		return operation.home, nil
   232	}
   233	
   234	// AcquireHomeOnly is the recovery/GC path. It acquires no project or key lock.
   235	// dryRun rejects the request without creating any manager state.
   236	func (manager *Manager) AcquireHomeOnly(ctx context.Context, dryRun bool) (*HomeLock, error) {
   237		if manager == nil {
   238			return nil, fmt.Errorf("manager is nil")
   239		}
   240		if dryRun {
   241			return nil, ErrDryRun
   242		}
   243		if err := manager.process.reserve(acquireHome); err != nil {
   244			return nil, err
   245		}
   246		acquired := false
   247		defer func() { manager.process.finish(acquireHome, acquired) }()
   248		fileLock, err := acquireFileLock(ctx, manager.homeLockPath(), func() {
   249			manager.process.released(acquireHome)
   250		})
   251		if err != nil {
   252			return nil, err
   253		}
   254		acquired = true
   255		return &HomeLock{lock: fileLock}, nil
   256	}
   257	
   258	// Close releases held locks in reverse class and project order.
   259	func (operation *Operation) Close() error {
   260		if operation == nil {
   261			return nil
   262		}
   263		operation.mu.Lock()
   264		defer operation.mu.Unlock()
   265		if operation.closed {
   266			return nil
   267		}
   268		operation.closed = true
   269		var result error
   270		if operation.home != nil {
   271			result = errors.Join(result, operation.home.Close())
   272			operation.home = nil
   273		}
   274		if operation.buildKey != nil {
   275			result = errors.Join(result, operation.buildKey.Close())
   276			operation.buildKey = nil
   277		}
   278		for index := len(operation.projects) - 1; index >= 0; index-- {
   279			result = errors.Join(result, operation.projects[index].Close())
   280		}
   281		operation.projects = nil
   282		return result
   283	}
   284	
   285	func (manager *Manager) projectLockPath(identity ProjectIdentity) string {
   286		return filepath.Join(manager.lockRoot, "projects", lockName("project", string(identity)))
   287	}
   288	
   289	func (manager *Manager) buildKeyLockPath(logicalKey string) string {
   290		return filepath.Join(manager.lockRoot, "build", lockName("build-key", logicalKey))
   291	}
   292	
   293	func (manager *Manager) homeLockPath() string {
   294		return filepath.Join(manager.lockRoot, lockName("manager-home", manager.home))
   295	}
   296	
   297	func compareProject(left, right ProjectIdentity) int {
   298		leftBytes, rightBytes := []byte(left), []byte(right)
   299		for index := 0; index < len(leftBytes) && index < len(rightBytes); index++ {
   300			if leftBytes[index] < rightBytes[index] {
   301				return -1
   302			}
   303			if leftBytes[index] > rightBytes[index] {
   304				return 1
   305			}
   306		}
   307		switch {
   308		case len(leftBytes) < len(rightBytes):
   309			return -1
   310		case len(leftBytes) > len(rightBytes):
   311			return 1
   312		default:
   313			return 0
   314		}
   315	}
   316	
   317	func orderError(detail string) error {
   318		return fmt.Errorf("%w: %s", ErrLockOrder, detail)
   319	}
   320	
   321	type acquisitionKind uint8
   322	
   323	const (
   324		acquireProject acquisitionKind = iota
   325		acquireBuildKey
   326		acquireHome
   327	)
   328	
   329	type processState struct {
   330		mu             sync.Mutex
   331		projectPending int
   332		keyPending     int
   333		keysHeld       int
   334		homePending    int
   335		homesHeld      int
   336	}
   337	
   338	var processStates = struct {
   339		sync.Mutex
   340		byHome map[string]*processState
   341	}{byHome: map[string]*processState{}}
   342	
   343	func stateForHome(home string) *processState {
   344		processStates.Lock()
   345		defer processStates.Unlock()
   346		if state := processStates.byHome[home]; state != nil {
   347			return state
   348		}
   349		state := new(processState)
   350		processStates.byHome[home] = state
   351		return state
   352	}
   353	
   354	func (state *processState) reserve(kind acquisitionKind) error {
   355		state.mu.Lock()
   356		defer state.mu.Unlock()
   357		switch kind {
   358		case acquireProject:
   359			if state.homesHeld > 0 || state.homePending > 0 {
   360				return orderError("project lock requested while the process holds or is acquiring the home lock")
   361			}
   362			state.projectPending++
   363		case acquireBuildKey:
   364			if state.homesHeld > 0 || state.homePending > 0 {
   365				return orderError("build-key lock requested while the process holds or is acquiring the home lock")
   366			}
   367			state.keyPending++
   368		case acquireHome:
   369			if state.keysHeld > 0 || state.keyPending > 0 || state.projectPending > 0 {
   370				return orderError("home lock requested before an in-process project/key acquisition completed or key release")
   371			}
   372			state.homePending++
   373		}
   374		return nil
   375	}
   376	
   377	func (state *processState) finish(kind acquisitionKind, acquired bool) {
   378		state.mu.Lock()
   379		defer state.mu.Unlock()
   380		switch kind {
   381		case acquireProject:
   382			state.projectPending--
   383		case acquireBuildKey:
   384			state.keyPending--
   385			if acquired {
   386				state.keysHeld++
   387			}
   388		case acquireHome:
   389			state.homePending--
   390			if acquired {
   391				state.homesHeld++
   392			}
   393		}
   394	}
   395	
   396	func (state *processState) released(kind acquisitionKind) {
   397		state.mu.Lock()
   398		defer state.mu.Unlock()
   399		switch kind {
   400		case acquireBuildKey:
   401			if state.keysHeld > 0 {
   402				state.keysHeld--
   403			}
   404		case acquireHome:
   405			if state.homesHeld > 0 {
   406				state.homesHeld--
   407			}
   408		}
   409	}

