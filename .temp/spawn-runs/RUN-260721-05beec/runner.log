     1	// Package managerlock provides cross-process locks for Curator operations.
     2	// Lock files are stable manager state; release drops only the operating-system
     3	// lock and never removes a path that another process may already have opened.
     4	package managerlock
     5	
     6	import (
     7		"context"
     8		"errors"
