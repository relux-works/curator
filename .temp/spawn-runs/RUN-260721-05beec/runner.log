    25	func TestCanonicalProjectIdentitiesAndOrder(t *testing.T) {
    26		root := t.TempDir()
    27		projects := []string{
    28			filepath.Join(root, "文"),
    29			filepath.Join(root, "z"),
    30			filepath.Join(root, "é"),
    31		}
    32		for _, project := range projects {
    33			if err := os.Mkdir(project, 0o700); err != nil {
    34				t.Fatal(err)
    35			}
    36		}
    37		identities, err := CanonicalProjects(projects...)
    38		if err != nil {
    39			t.Fatal(err)
    40		}
    41		for index := 1; index < len(identities); index++ {
    42			if bytes.Compare([]byte(identities[index-1]), []byte(identities[index])) >= 0 {
    43				t.Fatalf("identities are not in unsigned UTF-8 order: %#v", identities)
    44			}
    45		}
    46		manager, err := New(t.TempDir())
    47		if err != nil {
    48			t.Fatal(err)
    49		}
    50		operation := manager.NewOperation(false)
    51		cleanupOperation(t, operation)
    52		held, err := operation.AcquireProjects(context.Background(), projects...)
    53		if err != nil {
    54			t.Fatal(err)
    55		}
    56		for index := range identities {
    57			if held[index] != identities[index] {
    58				t.Fatalf("acquisition order = %#v, want %#v", held, identities)
    59			}
    60		}
    61	
    62		alias := filepath.Join(root, "alias")
    63		if err := os.Symlink(projects[0], alias); err != nil {
    64			t.Logf("symlink identity check unavailable: %v", err)
    65			return
    66		}
    67		originalIdentity, err := CanonicalProject(projects[0])
    68		if err != nil {
    69			t.Fatal(err)
    70		}
    71		aliasIdentity, err := CanonicalProject(alias)
    72		if err != nil {
    73			t.Fatal(err)
    74		}
    75		if aliasIdentity != originalIdentity {
    76			t.Fatalf("symlink identity = %q, want %q", aliasIdentity, originalIdentity)
    77		}
    78		if _, err := CanonicalProjects(projects[0], alias); err == nil {
    79			t.Fatal("duplicate canonical project identities were accepted")
    80		}
    81	}
