   533			operation := manager.NewOperation(false)
   534			cleanupOperation(t, operation)
   535			_, err = operation.AcquireProjects(ctx, os.Getenv(helperProjectEnv))
   536		case "try-home":
   537			var lock *HomeLock
   538			lock, err = manager.AcquireHomeOnly(ctx, false)
   539			if lock != nil {
   540				cleanupHomeLock(t, lock)
   541			}
   542		case "try-key":
   543			operation := manager.NewOperation(false)
   544			cleanupOperation(t, operation)
   545			if _, err = operation.AcquireProjects(ctx, os.Getenv(helperProjectEnv)); err == nil {
   546				err = operation.AcquireBuildKey(ctx, os.Getenv(helperKeyEnv))
   547			}
   548		case "hold-project":
   549			operation := manager.NewOperation(false)
   550			cleanupOperation(t, operation)
   551			if _, err = operation.AcquireProjects(context.Background(), os.Getenv(helperProjectEnv)); err == nil {
   552				fmt.Println("ready")
   553				_ = os.Stdout.Sync()
   554				_, _ = io.Copy(io.Discard, os.Stdin)
   555				return
   556			}
   557		default:
   558			t.Fatalf("unknown helper mode %q", mode)
   559		}
   560		if err == nil {
   561			fmt.Println("acquired")
   562			return
   563		}
   564		if errors.Is(err, context.DeadlineExceeded) {
   565			fmt.Println("blocked")
   566			return
   567		}
   568		t.Fatalf("helper lock error: %v", err)
   569	}
   570	
   571	func cleanupOperation(t *testing.T, operation *Operation) {
   572		t.Helper()
   573		t.Cleanup(func() {
   574			if err := operation.Close(); err != nil {
   575				t.Errorf("release manager operation locks: %v", err)
   576			}
   577		})
   578	}
   579	
   580	func cleanupHomeLock(t *testing.T, lock *HomeLock) {
   581		t.Helper()
   582		t.Cleanup(func() {
   583			if err := lock.Close(); err != nil {
   584				t.Errorf("release manager-home lock: %v", err)
   585			}
   586		})
   587	}

