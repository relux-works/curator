   474	func TestRollbackCleanupRecoveryResumesOwnedDirectoryTomb(t *testing.T) {
   475		for _, point := range []Point{PointAfterCleanupRename, PointDuringCleanupRemoval} {
   476			t.Run(string(point), func(t *testing.T) {
   477				root := t.TempDir()
   478				live := filepath.Join(root, "live", "target")
   479				stage := filepath.Join(root, "stage", "target")
   480				mustWrite(t, filepath.Join(live, "a"), "old-a")
   481				mustWrite(t, filepath.Join(live, "b"), "old-b")
   482				mustWrite(t, filepath.Join(stage, "a"), "new-a")
   483				mustWrite(t, filepath.Join(stage, "b"), "new-b")
   484				preimage, err := DigestPath(live)
   485				if err != nil {
   486					t.Fatal(err)
   487				}
   488				startRollback := errors.New("start rollback")
   489				cleanupFault := errors.New("rollback cleanup fault")
   490				rollbackStarted := false
   491				cleanupFaulted := false
   492				engine := mustEngine(t, filepath.Join(root, "home"), WithHooks(Hooks{Fault: func(event Event) error {
   493					if !rollbackStarted && event.Point == PointTargetCommitted {
   494						rollbackStarted = true
   495						return startRollback
   496					}
   497					if rollbackStarted && !cleanupFaulted && event.Point == point {
   498						cleanupFaulted = true
   499						return cleanupFault
   500					}
   501					return nil
   502				}}))
   503				journal, err := engine.Prepare(testLock{}, Plan{TransactionID: "txn-rollback-owned-tomb", ProjectIdentity: "/project", Targets: []Target{{
   504					Class: "runtime", Identifier: "target", LivePath: live, StagedSource: stage, PreimageDigest: preimage,
   505				}}})
   506				if err != nil {
   507					t.Fatal(err)
   508				}
   509				if err := engine.Commit(testLock{}, journal.TransactionID); !errors.Is(err, startRollback) || !errors.Is(err, cleanupFault) {
   510					t.Fatalf("commit error = %v, want rollback and cleanup faults", err)
   511				}
   512				stored, err := engine.loadJournal(journal.TransactionID)
   513				if err != nil {
   514					t.Fatal(err)
   515				}
   516				if stored.Phase != PhaseRollbackCleanup || stored.RemovalPath != stored.Targets[0].RollbackPath {
   517					t.Fatalf("rollback cleanup progress = phase %s path %q", stored.Phase, stored.RemovalPath)
   518				}
   519				if err := mustEngine(t, filepath.Join(root, "home")).Recover(testLock{}); err != nil {
   520					t.Fatal(err)
   521				}
   522				if got := mustRead(t, filepath.Join(live, "a")); got != "old-a" {
   523					t.Fatalf("restored target changed during rollback cleanup recovery: %q", got)
   524				}
   525				if _, err := os.Lstat(engine.journalPath(journal.TransactionID)); !os.IsNotExist(err) {
   526					t.Fatalf("rollback cleanup journal remains: %v", err)
   527				}
   528			})
   529		}
   530	}
