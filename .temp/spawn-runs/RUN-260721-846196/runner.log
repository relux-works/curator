+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/relux-works/curator/internal/transaction"
+)
+
+type heldLock struct{}
+
+func (heldLock) AssertHeld() error { return nil }
+
+func must(err error) {
+	if err != nil {
+		panic(err)
+	}
+}
+
+func write(path, value string) {
+	must(os.MkdirAll(filepath.Dir(path), 0o755))
+	must(os.WriteFile(path, []byte(value), 0o644))
+}
+
+func main() {
+	root, err := os.MkdirTemp("", "transaction-owned-tomb-probe-")
+	must(err)
+	defer os.RemoveAll(root)
+
+	live := filepath.Join(root, "live", "target")
+	stage := filepath.Join(root, "stage", "target")
+	write(filepath.Join(live, "a"), "old-a")
+	write(filepath.Join(live, "b"), "old-b")
+	write(filepath.Join(stage, "a"), "new-a")
+	write(filepath.Join(stage, "b"), "new-b")
+	preimage, err := transaction.DigestPath(live)
+	must(err)
+
+	injected := errors.New("stop during cleanup removal")
+	faulted := false
+	engine, err := transaction.New(filepath.Join(root, "home"), transaction.WithHooks(transaction.Hooks{
+		Fault: func(event transaction.Event) error {
+			if !faulted && event.Point == transaction.PointDuringCleanupRemoval {
+				faulted = true
+				return injected
+			}
+			return nil
+		},
+	}))
+	must(err)
+	journal, err := engine.Prepare(heldLock{}, transaction.Plan{
+		TransactionID:   "txn-owned-tomb-foreign-probe",
+		ProjectIdentity: "/project",
+		Targets: []transaction.Target{{
+			Class:          "runtime",
+			Identifier:     "target",
+			LivePath:       live,
+			StagedSource:   stage,
+			PreimageDigest: preimage,
+		}},
+	})
+	must(err)
+	err = engine.Commit(heldLock{}, journal.TransactionID)
+	if !errors.Is(err, injected) {
+		panic(fmt.Sprintf("commit error = %v, want injected", err))
+	}
+
+	tomb := journal.Targets[0].BackupPath + ".delete"
+	foreign := filepath.Join(tomb, "foreign-concurrent-bytes")
+	write(foreign, "do-not-delete")
+
+	restarted, err := transaction.New(filepath.Join(root, "home"))
+	must(err)
+	recoveryErr := restarted.Commit(heldLock{}, journal.TransactionID)
+	_, statErr := os.Lstat(foreign)
+	fmt.Printf("recovery_error=%v\n", recoveryErr)
+	fmt.Printf("foreign_exists_after_recovery=%t\n", statErr == nil)
+	fmt.Printf("foreign_stat_error=%v\n", statErr)
+}

