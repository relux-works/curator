   843	func TestCacheInspectionIsBracketedByTheFrozenSource(t *testing.T) {
   844		e := newEnv(t)
   845		e.buildSkill("build-skill", "alpha", "beta")
   846		e.declare("build-skill")
   847		deps, _, cache, builder := newFakeDeps(t)
   848		// The lookup returns a reusable entry for identity A while the snapshot
   849		// changes underneath it. Bracketing rejects that decision inside the
   850		// read-only planning phase, so the second command is never planned and the
   851		// miss is never compiled.
   852		cache.byCommand["alpha"] = buildcache.Result{Status: buildcache.Hit, ArtifactPath: "/protected/bin/alpha"}
   853		cache.observe = func(buildcache.Expectation) { e.mutateSnapshot("build-skill") }
   854		handoffs := 0
   855	
   856		result := e.install(Options{Build: deps, OnStaged: func(Staged) error {
   857			handoffs++
   858			return nil
   859		}})
   860		if result.Status != "failed" {
   861			t.Fatalf("install status = %q, want failed when the source changes during cache inspection", result.Status)
   862		}
   863		if !containsSubstring(result.Errors, "build-source snapshot mutated") {
   864			t.Fatalf("errors do not report the mutated source: %v", result.Errors)
   865		}
   866		if !containsSubstring(result.Errors, "build-skill.alpha") {
   867			t.Fatalf("errors do not name the command whose lookup raced the source: %v", result.Errors)
   868		}
   869		if len(cache.inspected) != 1 {
   870			t.Fatalf("cache inspections = %v, want planning to stop at the first raced lookup", cache.inspected)
   871		}
   872		if len(result.Builds) != 0 {
   873			t.Fatalf("plan reported %d commands, want none accepted after a raced lookup", len(result.Builds))
   874		}
   875		if len(builder.calls) != 0 || handoffs != 0 {
   876			t.Fatalf("planning proceeded past a mutated source: builds=%v handoffs=%d", builder.calls, handoffs)
   877		}
   878		requireAbsent(t, e.persistentPaths())
   879	}
