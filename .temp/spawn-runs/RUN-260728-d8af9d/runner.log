   363	func (before liveState) requireUnchanged(t *testing.T, e *env, context string) {
   364		t.Helper()
   365		after := captureLiveState(t, e)
   366		if after.project != before.project {
   367			t.Fatalf("%s: installed project tree changed", context)
   368		}
   369		if after.runtime != before.runtime {
   370			t.Fatalf("%s: runtime store changed", context)
   371		}
   372		if after.cache != before.cache {
   373			t.Fatalf("%s: live build cache changed", context)
   374		}
   375		if after.consumers != before.consumers {
   376			t.Fatalf("%s: consumer ledger changed", context)
   377		}
   378		if after.global != before.global {
   379			t.Fatalf("%s: global scope changed", context)
   380		}
   381	}
