   390	func TestDryRunPlansBuildsWithoutToolchainSessionOrPersistentState(t *testing.T) {
   391		e := newEnv(t)
   392		e.buildSkill("build-skill", "alpha")
   393		e.declare("build-skill")
   394		deps, toolchain, cache, builder := newFakeDeps(t)
   395	
   396		result := e.install(Options{DryRun: true, Build: deps})
   397		if result.Status != "ok" {
   398			t.Fatalf("dry-run failed: %+v", result)
   399		}
   400		if toolchain.probes != 1 || toolchain.establishes != 0 {
   401			t.Fatalf("dry-run probes=%d establishes=%d, want exactly one probe and no session",
   402				toolchain.probes, toolchain.establishes)
   403		}
   404		if len(builder.calls) != 0 {
   405			t.Fatalf("dry-run invoked the builder: %v", builder.calls)
   406		}
   407		if len(cache.inspected) != 1 || cache.inspected[0] != "alpha" {
   408			t.Fatalf("dry-run cache inspection = %v, want exactly [alpha]", cache.inspected)
   409		}
   410		if len(result.Builds) != 1 {
   411			t.Fatalf("planned builds = %d, want 1", len(result.Builds))
   412		}
   413		planned := result.Builds[0]
   414		if planned.Outcome() != BuildWouldPreflightAndBuild {
   415			t.Fatalf("planned outcome = %q, want %q", planned.Outcome(), BuildWouldPreflightAndBuild)
   416		}
   417		line := planned.Describe()
   418		for _, want := range []string{
   419			"build-skill.alpha build",
   420			"source=curator-build-source-v1:sha256:",
   421			"root=src dir=src/cmd/alpha",
   422			"target=linux/amd64+GOAMD64=v1",
   423			"key=sha256:",
   424			"outcome=would-preflight-and-build",
   425		} {
   426			if !strings.Contains(line, want) {
   427				t.Fatalf("dry-run line %q is missing %q", line, want)
   428			}
   429		}
   430		if string(planned.CacheKey()) == "" || !strings.Contains(line, "key="+string(planned.CacheKey())) {
   431			t.Fatalf("dry-run line %q does not report the exact planned key %q", line, planned.CacheKey())
   432		}
   433		if !containsLine(result.Messages, "test: "+line) {
   434			t.Fatalf("dry-run messages omit the plan line: %v", result.Messages)
   435		}
   436		requireAbsent(t, e.persistentPaths())
   437		requireNoLocks(t, e.home)
   438		requireNoLocks(t, e.project)
   439	}
