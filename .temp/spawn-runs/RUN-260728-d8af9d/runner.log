  1088	// TestReleaseTakesNoToolchainVerdictAfterLiveMutation pins the post-handoff
  1089	// boundary. Releasing the plan is deferred across every live write, so a
  1090	// verification taken there would report drift against state the run can no
  1091	// longer preserve. The fake fails every check after the first, so any re-check
  1092	// during teardown fails an installation that had already committed.
  1093	func TestReleaseTakesNoToolchainVerdictAfterLiveMutation(t *testing.T) {
  1094		e := newEnv(t)
  1095		e.buildSkill("build-skill", "alpha")
  1096		e.declare("build-skill")
  1097		deps, toolchain, _, builder := newFakeDeps(t)
  1098		toolchain.lateVerifyErr = errors.New("toolchain tree changed during operation")
  1099	
  1100		result := e.install(Options{Build: deps})
  1101		if result.Status != "ok" {
  1102			t.Fatalf("install status = %q, want ok: %+v", result.Status, result)
  1103		}
  1104		if containsSubstring(result.Errors, "toolchain tree changed during operation") {
  1105			t.Fatalf("teardown reported a toolchain verdict after live mutation: %v", result.Errors)
  1106		}
  1107		session := toolchain.session
  1108		if session == nil || session.verified != 1 {
  1109			t.Fatalf("session verification count = %+v, want exactly one pre-handoff check", session)
  1110		}
  1111		if session.released != 1 {
  1112			t.Fatalf("session release count = %d, want exactly one release", session.released)
  1113		}
  1114		// The run really did commit, so the pre-handoff check was the last point at
  1115		// which drift could still be reported for free.
  1116		if _, err := os.Stat(filepath.Join(e.project, ".agents", "skills", "build-skill")); err != nil {
  1117			t.Fatalf("installation did not commit: %v", err)
  1118		}
  1119		for _, path := range builder.staged {
  1120			if _, err := os.Stat(path); !os.IsNotExist(err) {
  1121				t.Fatalf("staged artifact %s survived the release: %v", path, err)
  1122			}
  1123		}
  1124	}
