    94	type fakeCache struct {
    95		byCommand map[string]buildcache.Result
    96		inspected []string
    97		// observe runs inside the lookup, modelling any state change that races a
    98		// cache decision the planner is about to trust.
    99		observe func(buildcache.Expectation)
   100	}
   101	
   102	func (cache *fakeCache) Inspect(expect buildcache.Expectation) buildcache.Result {
   103		cache.inspected = append(cache.inspected, expect.Input.Command)
   104		if cache.observe != nil {
   105			cache.observe(expect)
   106		}
   107		if result, present := cache.byCommand[expect.Input.Command]; present {
   108			return result
   109		}
   110		return buildcache.Result{Status: buildcache.Miss, Reason: "cache entry is absent"}
   111	}
   112	
   113	type fakeBuilder struct {
   114		t       *testing.T
   115		calls   []string
   116		staged  []string
   117		failOn  map[string]error
   118		observe func(StageRequest)
   119	}
   120	
   121	func (builder *fakeBuilder) Stage(_ context.Context, request StageRequest) (StagedArtifact, error) {
   122		builder.t.Helper()
   123		builder.calls = append(builder.calls, request.Command)
   124		if builder.observe != nil {
   125			builder.observe(request)
   126		}
   127		if err := builder.failOn[request.Command]; err != nil {
   128			return StagedArtifact{}, err
   129		}
   130		session, ok := request.Session.(*fakeSession)
   131		if !ok {
   132			return StagedArtifact{}, errors.New("staging outside a trusted session")
   133		}
   134		relative, err := buildmeta.ArtifactPath(request.Command, session.target.GOOS)
   135		if err != nil {
   136			return StagedArtifact{}, err
   137		}
   138		path := filepath.Join(session.root, filepath.FromSlash(relative))
   139		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
   140			return StagedArtifact{}, err
   141		}
   142		payload := []byte("artifact:" + request.Command)
   143		if err := os.WriteFile(path, payload, 0o700); err != nil {
   144			return StagedArtifact{}, err
   145		}
   146		builder.staged = append(builder.staged, path)
   147		digest := sha256.Sum256(payload)
   148		return StagedArtifact{
   149			Path: path,
   150			Metadata: buildmeta.Artifact{
   151				Path:   relative,
   152				SHA256: "sha256:" + hex.EncodeToString(digest[:]),
   153				Size:   int64(len(payload)),
   154			},
   155		}, nil
   156	}
