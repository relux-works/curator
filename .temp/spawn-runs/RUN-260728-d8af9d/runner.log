   441	// requireNoLocks asserts a read-only phase left no cross-process lock behind.
   442	func requireNoLocks(t *testing.T, root string) {
   443		t.Helper()
   444		err := filepath.Walk(root, func(path string, info os.FileInfo, err error) error {
   445			if err != nil {
   446				if os.IsNotExist(err) {
   447					return nil
   448				}
   449				return err
   450			}
   451			if info.IsDir() && info.Name() == ".git" {
   452				return filepath.SkipDir // git's own transient locks are not manager state
   453			}
   454			if !info.IsDir() && strings.HasSuffix(path, ".lock") {
   455				t.Fatalf("dry-run left a lock at %s", path)
   456			}
   457			return nil
   458		})
   459		if err != nil {
   460			t.Fatalf("walk %s: %v", root, err)
   461		}
   462	}
