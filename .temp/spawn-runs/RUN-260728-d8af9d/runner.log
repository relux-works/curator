    22	// fakeSession stands in for a trusted Go session. Its root models the
    23	// operation-private staging area the driver owns and deletes on Release.
    24	type fakeSession struct {
    25		target     buildmeta.Target
    26		toolchain  buildmeta.Toolchain
    27		root       string
    28		released   int
    29		releaseErr error
    30		verified   int
    31		verifyErr  error
    32		// lateVerifyErr is reported by every verification after the first, so any
    33		// re-check taken during teardown surfaces as a failed installation.
    34		lateVerifyErr error
    35	}
    36	
    37	func (session *fakeSession) Target() buildmeta.Target       { return session.target }
    38	func (session *fakeSession) Toolchain() buildmeta.Toolchain { return session.toolchain }
    39	
    40	func (session *fakeSession) VerifyToolchain(context.Context) error {
    41		session.verified++
    42		if session.verified > 1 && session.lateVerifyErr != nil {
    43			return session.lateVerifyErr
    44		}
    45		return session.verifyErr
    46	}
    47	
    48	func (session *fakeSession) Release() error {
    49		session.released++
    50		if err := os.RemoveAll(session.root); err != nil {
    51			return err
    52		}
    53		return session.releaseErr
    54	}
    55	
    56	type fakeToolchain struct {
    57		t             *testing.T
    58		target        buildmeta.Target
    59		toolchain     buildmeta.Toolchain
    60		probes        int
    61		establishes   int
    62		session       *fakeSession
    63		probeErr      error
    64		establishErr  error
    65		releaseErr    error
    66		verifyErr     error
    67		lateVerifyErr error
    68	}
    69	
    70	func (toolchain *fakeToolchain) Probe(context.Context) (buildmeta.Target, buildmeta.Toolchain, error) {
    71		toolchain.probes++
    72		if toolchain.probeErr != nil {
    73			return buildmeta.Target{}, buildmeta.Toolchain{}, toolchain.probeErr
    74		}
    75		return toolchain.target, toolchain.toolchain, nil
    76	}
    77	
    78	func (toolchain *fakeToolchain) Establish(context.Context) (BuildSession, error) {
    79		toolchain.establishes++
    80		if toolchain.establishErr != nil {
    81			return nil, toolchain.establishErr
    82		}
    83		toolchain.session = &fakeSession{
    84			target:        toolchain.target,
    85			toolchain:     toolchain.toolchain,
    86			root:          toolchain.t.TempDir(),
    87			releaseErr:    toolchain.releaseErr,
    88			verifyErr:     toolchain.verifyErr,
    89			lateVerifyErr: toolchain.lateVerifyErr,
    90		}
    91		return toolchain.session, nil
    92	}
