    39	// Options control one installation run.
    40	type Options struct {
    41		DryRun       bool
    42		Fetch        bool
    43		FixGitignore bool
    44		StrictTags   bool
    45		Verbose      bool
    46		Platform     string // "" resolves to the current platform
    47		// FetchedRepos deduplicates closure-scoped upgrades across selected
    48		// projects. Callers may leave it nil for a single installation.
    49		FetchedRepos map[string]bool
    50		// Context bounds toolchain probing and compilation. Nil means background.
    51		Context context.Context
    52		// Build injects the narrow toolchain, protected-cache, builder, clock, and
    53		// generation-read boundaries. The zero value resolves the real ones.
    54		Build BuildDeps
    55		// OnStaged observes the operation-private staging result after every build
    56		// succeeded and before the plan releases it. Publishing staged outputs to
    57		// the protected cache and to live installation targets belongs to the
    58		// atomic commit phase, not to this one.
    59		OnStaged func(Staged) error
    60		// Hooks for later phases. Each may be nil.
    61		VerifyMcp     func(nodes []*closure.Node) (map[string]map[string][]string, []string, error)
    62		AuditGate     func(nodes []*closure.Node) (warnings []string, errs []string)
    63		ResolveAttest func(nodes []*closure.Node) (map[string]*marker.Attestation, []string, error)
    64	}
    65	
    66	func (o Options) context() context.Context {
    67		if o.Context == nil {
    68			return context.Background()
    69		}
    70		return o.Context
    71	}
