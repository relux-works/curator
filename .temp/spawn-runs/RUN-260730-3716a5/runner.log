    launcher.write_text(
        "#!/bin/sh\n'''exec' '/attacker/python' \"$0\" \"$@\"\n' '''\n",
        encoding="utf-8",
    )
    launcher.chmod(0o755)
    with pytest.raises(go_v1.GoV1Error) as raised:
        go_v1._resolve_manager_identity(launcher)
    assert raised.value.code == go_v1.CODE_WORKER_IDENTITY_INVALID


