+  'C:\\Program Files\\Python314\\python.exe',
+  '-S', '-s', '-B', '-P',
+  'C:\\Users\\admin\\TASK-260720-2g21eg-cycle5-61f29f\\venv\\Scripts\\csk.exe',
+  '__csk-go-worker-v1'
