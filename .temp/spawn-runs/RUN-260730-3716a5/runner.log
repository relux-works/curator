+    print(f"system_exit={exc.code!r}", flush=True)
diff --git a/.temp/TASK-260720-2g21eg/TASK-260720-2g21eg_probe_windows_launch_capability.py b/.temp/TASK-260720-2g21eg/TASK-260720-2g21eg_probe_windows_launch_capability.py
