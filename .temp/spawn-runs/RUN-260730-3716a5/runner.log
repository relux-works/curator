+sys.path.insert(0, str(site_root))
+
+import csk.cli  # noqa: E402
+
+
+def diagnostic_main(argv: list[str] | None = None) -> int:
+    print(f"main_argv={argv!r}", flush=True)
+    print(f"sys_argv={sys.argv!r}", flush=True)
