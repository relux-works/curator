+
+func syncDirectory(string) error {
+	return fmt.Errorf("persistent build cache protection is unsupported")
+}
+
+func renameDirectoryNoReplace(string, string) error {
+	return fmt.Errorf("persistent build cache protection is unsupported")
+}
+
