+	if err := operation.AcquireBuildKey(context.Background(), "sha256:key-two"); !errors.Is(err, ErrLockOrder) {
+		t.Fatalf("second build key error = %v", err)
+	}
+	homeLock, err := operation.AcquireHome(context.Background())
+	if err != nil {
+		t.Fatal(err)
