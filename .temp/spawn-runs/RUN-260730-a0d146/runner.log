+                        project_lock.path,
+                        desired,
+                    ),
+                ),
+            )
+        project_lock.assert_held()
+        home_lock.assert_held()
+        assert project_lock.path.read_bytes() == project_witness
+        assert home_lock.path.read_bytes() == home_witness
+        assert not engine.journal_root.exists()
