+def _path_matches_fd(path: Path, fd: int) -> bool:
+    try:
+        path_info = path.lstat()
+        descriptor_info = os.fstat(fd)
+    except OSError:
+        return False
+    return stat.S_ISREG(path_info.st_mode) and os.path.samestat(
+        path_info,
