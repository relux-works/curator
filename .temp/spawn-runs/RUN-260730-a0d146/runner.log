+            _plan(
+                "txn-witness-loss",
+                tmp_path / "project",
+                _target("10-context", "skill", live, desired),
+            ),
+        )
+        with pytest.raises(LockError, match="ownership was lost"):
+            engine.commit(lock, "txn-witness-loss")
+
