+        with pytest.raises(LockError), ManagerHomeLock(home, timeout=0.15):
+            pass
+    finally:
+        _terminate_subprocess(stale_owner)
+
+    with ManagerHomeLock(home, timeout=2) as recovered:
+        recovered.assert_held()
+
+    barrier = tmp_path / "contender-barrier"
