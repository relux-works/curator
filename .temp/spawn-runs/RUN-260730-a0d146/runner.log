+def _record_allows_stable_takeover(fd: int) -> bool:
+    """Use OS ownership for v1 records and fail closed on live legacy records."""
+    payload = _read_lock_fd_bytes(fd)
+    if payload == b"":
+        return True
+    if payload is None:
+        return False
+    data = _decode_lock(payload)
+    if data is None:
+        return False
+    if data.get("protocol") == _LOCK_PROTOCOL:
+        return True
+    pid = data.get("pid")
+    return isinstance(pid, int) and not isinstance(pid, bool) and not _pid_alive(pid)
+
+
+def _write_lock_fd(fd: int, data: dict[str, object]) -> None:
+    payload = (json.dumps(data, sort_keys=True, separators=(",", ":")) + "\n").encode(
+        "utf-8"
+    )
+    os.ftruncate(fd, 0)
+    os.lseek(fd, 0, os.SEEK_SET)
+    view = memoryview(payload)
+    while view:
+        written = os.write(fd, view)
+        if written <= 0:
+            raise OSError("short stable lock record write")
+        view = view[written:]
+    os.fsync(fd)
