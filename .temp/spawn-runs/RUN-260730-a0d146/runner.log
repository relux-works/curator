+def _write_lock_fd(fd: int, data: dict[str, object]) -> None:
+    payload = (json.dumps(data, sort_keys=True, separators=(",", ":")) + "\n").encode(
+        "utf-8"
+    )
+    os.ftruncate(fd, 0)
+    os.lseek(fd, 0, os.SEEK_SET)
+    view = memoryview(payload)
+    while view:
+        written = os.write(fd, view)
+        if written <= 0:
