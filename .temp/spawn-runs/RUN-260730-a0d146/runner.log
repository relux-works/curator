+        0,
+        1,
+        0,
+        ctypes.byref(overlapped),
+    ):
+        return True
+    error_number = int(get_last_error())
+    if error_number == _ERROR_LOCK_VIOLATION:
+        return False
+    raise OSError(
+        error_number,
+        f"{format_error(error_number)}: cannot acquire stable file lock",
+    )
