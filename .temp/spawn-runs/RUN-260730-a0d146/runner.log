+
+    with project_lock, ManagerHomeLock(home) as home_lock:
+        project_witness = project_lock.path.read_bytes()
+        home_witness = home_lock.path.read_bytes()
+        with pytest.raises(TransactionError, match="project lock namespace"):
+            engine.prepare(
