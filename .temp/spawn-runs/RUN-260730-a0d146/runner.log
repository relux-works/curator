+    while remaining:
+        chunk = os.read(fd, remaining)
+        if not chunk:
+            return None
+        chunks.append(chunk)
+        remaining -= len(chunk)
+    after = os.fstat(fd)
+    if not os.path.samestat(info, after) or after.st_size != info.st_size:
+        return None
+    return b"".join(chunks)
