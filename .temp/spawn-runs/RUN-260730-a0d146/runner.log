+_LOCK_HOLDER = """
+import time
+import sys
+from pathlib import Path
+
+from csk.locking import ManagerHomeLock
+
+home = Path(sys.argv[1])
+ready = Path(sys.argv[2])
+release = Path(sys.argv[3])
+with ManagerHomeLock(home, timeout=5):
+    ready.write_text("ready", encoding="utf-8")
