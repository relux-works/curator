+def _windows_unlock_file(fd: int) -> None:
+    import msvcrt
+
+    win_dll: Any = ctypes.WinDLL  # type: ignore[attr-defined]
+    get_last_error: Any = ctypes.get_last_error  # type: ignore[attr-defined]
