+def _read_lock_fd_bytes(fd: int) -> bytes | None:
+    info = os.fstat(fd)
+    if not stat.S_ISREG(info.st_mode) or info.st_size > _LOCK_RECORD_LIMIT:
+        return None
+    os.lseek(fd, 0, os.SEEK_SET)
+    remaining = info.st_size
