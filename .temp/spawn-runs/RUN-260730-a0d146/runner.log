+        raw = json.loads(journal_path.read_text(encoding="utf-8"))
+        target = raw["targets"][0]
+        redirected_live = lock.path.resolve()
+        target["live_path"] = str(redirected_live)
+        target["staged_path"] = str(
+            transactions._sidecar(
