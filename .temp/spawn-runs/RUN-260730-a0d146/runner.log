+def _record_allows_stable_takeover(fd: int) -> bool:
+    payload = _read_lock_fd_bytes(fd)
+    if payload == b"":
+        return True
+    data = _decode_lock(payload)
+    if data is None:
+        return False
+    if data.get("protocol") == _LOCK_PROTOCOL:
+        return True
+    pid = data.get("pid")
+    return (
+        isinstance(pid, int)
+        and not isinstance(pid, bool)
+        and not _pid_alive(pid)
+    )
