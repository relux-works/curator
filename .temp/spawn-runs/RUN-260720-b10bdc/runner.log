+func selectedGeneration(target string) string {
+	pointer := target + ".current"
+	pathInfo, err := os.Lstat(pointer)
+	if err != nil || !pathInfo.Mode().IsRegular() || pathInfo.Size() < 2 || pathInfo.Size() > 255 {
+		return ""
