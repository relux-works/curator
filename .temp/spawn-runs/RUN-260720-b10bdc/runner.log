+	if err != nil {
+		t.Fatal(err)
+	}
+	expectedIdentity := expected.Identity()
+	if err := expected.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(target, "SKILL.md"), []byte("tampered"), 0o644); err != nil {
+		t.Fatal(err)
+	}
