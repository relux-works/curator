@@ -0,0 +1,18 @@
+//go:build linux
+
+package snapshot
+
+import (
+	"errors"
+	"fmt"
+
+	"golang.org/x/sys/unix"
+)
+
+func exchangeDirectories(staged, target string) error {
+	err := unix.Renameat2(unix.AT_FDCWD, staged, unix.AT_FDCWD, target, unix.RENAME_EXCHANGE)
+	if errors.Is(err, unix.ENOSYS) || errors.Is(err, unix.ENOTSUP) || errors.Is(err, unix.EINVAL) {
+		return fmt.Errorf("%w: %v", errAtomicExchangeUnsupported, err)
+	}
+	return err
+}
