+			defer group.Done()
+			<-start
+			if index%2 == 0 {
+				path, err := Get(home, "internal/skill-a", repo, commit)
+				if err != nil {
+					errs[index] = err
+					return
+				}
+				token, err := buildsource.Validate(path)
+				if err != nil {
+					errs[index] = err
+					return
+				}
