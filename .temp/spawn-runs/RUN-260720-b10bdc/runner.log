new file mode 100644
index 0000000000000000000000000000000000000000..3dc8ccd376baed32c3b50e96113ce069a3210548
--- /dev/null
+++ b/.temp/TASK-260720-256kj1/worktree/internal/snapshot/lock_unix.go
@@ -0,0 +1,17 @@
+//go:build unix
+
+package snapshot
+
+import (
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+func lockFile(file *os.File) error {
+	return unix.Flock(int(file.Fd()), unix.LOCK_EX)
+}
+
+func unlockFile(file *os.File) error {
+	return unix.Flock(int(file.Fd()), unix.LOCK_UN)
+}
diff --git a/.temp/TASK-260720-256kj1/worktree/internal/snapshot/lock_windows.go b/.temp/TASK-260720-256kj1/worktree/internal/snapshot/lock_windows.go
