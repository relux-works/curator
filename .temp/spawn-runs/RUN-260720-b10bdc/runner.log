+	if err := os.WriteFile(filepath.Join(legacy, "SKILL.md"), []byte("tampered"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	pointer := Dir(home, "internal/skill-a", commit) + ".current"
+	if err := os.Mkdir(pointer, 0o755); err != nil {
