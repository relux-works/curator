+//go:build darwin
+
+package snapshot
+
+import (
+	"errors"
+	"fmt"
+
+	"golang.org/x/sys/unix"
+)
+
+func exchangeDirectories(staged, target string) error {
+	err := unix.RenamexNp(staged, target, unix.RENAME_SWAP)
+	if errors.Is(err, unix.ENOTSUP) || errors.Is(err, unix.EINVAL) {
+		return fmt.Errorf("%w: %v", errAtomicExchangeUnsupported, err)
+	}
+	return err
+}
