index 0000000000000000000000000000000000000000..069ff772e4f06dc538c913344436e61c22f70e34
--- /dev/null
+++ b/.temp/TASK-260720-256kj1/worktree/internal/snapshot/lock_windows.go
@@ -0,0 +1,22 @@
+//go:build windows
+
+package snapshot
+
+import (
+	"os"
+
+	"golang.org/x/sys/windows"
+)
+
+func lockFile(file *os.File) error {
+	var overlapped windows.Overlapped
+	return windows.LockFileEx(
+		windows.Handle(file.Fd()), windows.LOCKFILE_EXCLUSIVE_LOCK,
+		0, 1, 0, &overlapped,
+	)
+}
+
+func unlockFile(file *os.File) error {
+	var overlapped windows.Overlapped
+	return windows.UnlockFileEx(windows.Handle(file.Fd()), 0, 1, 0, &overlapped)
+}
