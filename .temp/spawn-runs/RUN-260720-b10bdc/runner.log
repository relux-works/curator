+func TestConcurrentGetRepairsPresentTamperedSnapshotAtomically(t *testing.T) {
+	repo, commit := repositoryAtCommit(t, map[string]string{
+		".csk-install.json": "{\"source\":true}\n",
+		"SKILL.md":          "original",
+		"a/b/c":             "nested",
+	})
+	home := t.TempDir()
