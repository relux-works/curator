					t.Fatal(err)
				}
			},
		},
		{
			name: "extra file",
			mutate: func(t *testing.T, root string) {
				if err := os.WriteFile(filepath.Join(root, "extra"), []byte("tampered"), 0o644); err != nil {
					t.Fatal(err)
				}
			},
		},
		{
			name: "link",
			mutate: func(t *testing.T, root string) {
				if err := os.Symlink("SKILL.md", filepath.Join(root, "link")); err != nil {
					t.Skipf("symlink unavailable: %v", err)
