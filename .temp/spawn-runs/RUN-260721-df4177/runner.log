+		{Class: "b", Identifier: "nfd", LivePath: filepath.Join(liveRoot, "e\u0301"), StagedSource: sourceB, PreimageDigest: DigestAbsent},
+	}}
+	assertPlanRejectedBeforeJournal(t, filepath.Join(root, "home"), plan)
