+		func() error { return engine.emit(journal, removal.targetIndex, PointDuringCleanupRemoval) },
+	); err != nil {
+		return err
+	}
+	journal.RemovalPath = ""
+	if err := engine.saveJournal(journal); err != nil {
+		journal.RemovalPath = removal.path
+		return err
+	}
 	return nil
 }
 
