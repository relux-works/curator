+func namespaceNormalizationInsensitive(path string) (bool, error) {
+	ancestor, err := existingNamespaceAncestor(path)
+	if err != nil {
+		return false, err
+	}
+	var stat unix.Statfs_t
+	if err := unix.Statfs(ancestor, &stat); err != nil {
