+func TestBuildJournalRejectsNormalizationAliasesOnNormalizationInsensitiveDarwinFilesystem(t *testing.T) {
+	root := t.TempDir()
+	liveRoot := filepath.Join(root, "live")
+	mustMkdirAll(t, liveRoot)
