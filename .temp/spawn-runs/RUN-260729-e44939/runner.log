+    monkeypatch.setattr(transactions, "_windows_sync_regular", lambda path: None)
+    monkeypatch.setattr(transactions, "_windows_sync_directory", lambda path: None)
+
+    with ManagerHomeLock(home) as lock:
+        engine.prepare(
