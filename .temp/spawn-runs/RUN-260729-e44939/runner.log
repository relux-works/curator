+    _write(desired / "nested" / "one", "new-one")
+    removed_entries = 0
+
+    def crash_during_cleanup(point: str, target: JournalTarget | None) -> None:
+        nonlocal removed_entries
+        if point == "sidecar_entry_removed":
+            removed_entries += 1
