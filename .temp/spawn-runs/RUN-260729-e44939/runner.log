+        if point == "sidecar_tombed":
+            raise SimulatedCrash(point)
+
+    engine = TransactionEngine(home, fault_hook=crash_after_sidecar_tomb)
+    with ManagerHomeLock(home) as lock:
+        engine.prepare(
+            lock,
+            _plan(
