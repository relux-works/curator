+        if source.name.endswith((".desired", ".backup", ".rollback"))
+        and destination.name == f"{source.name}.delete"
+    ]
+    assert cleanup_moves
+    assert all(
+        flags == transactions._MOVEFILE_WRITE_THROUGH
+        for _, _, flags in cleanup_moves
+    )
