+                release.wait(timeout=2)
+        except Exception as exc:  # noqa: BLE001 - surface worker failures in the parent test
+            errors.append(exc)
+
+    thread = threading.Thread(target=hold_build)
+    thread.start()
+    assert started.wait(timeout=2)
+    try:
+        with (
