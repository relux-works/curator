+            ):
+                pass
+            with (
+                pytest.raises(LockOrderError, match="manager-home lock"),
+                BuildLock(home, "build-key"),
+            ):
+                pass
+        finally:
+            release_open.set()
+            thread.join(timeout=2)
+    assert not errors
+    assert not thread.is_alive()
