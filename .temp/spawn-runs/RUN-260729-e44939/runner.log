+    try:
+        with pytest.raises(LockOrderError, match="pending|released before"):
+            with ManagerHomeLock(home):
+                pass
+    finally:
+        release_open.set()
+        thread.join(timeout=2)
+    assert not errors
+    assert not thread.is_alive()
+
