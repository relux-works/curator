+    moves: list[tuple[Path, Path, int]] = []
+
+    def move_file(source: Path, destination: Path, flags: int) -> None:
+        moves.append((source, destination, flags))
+        if flags & transactions._MOVEFILE_REPLACE_EXISTING:
