+def test_prepare_rejects_platform_case_alias_without_residue(tmp_path: Path):
+    home = tmp_path / "home"
+    engine = TransactionEngine(home)
+    desired_a = _write(tmp_path / "desired-a", "a")
+    desired_b = _write(tmp_path / "desired-b", "b")
