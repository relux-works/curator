+        flags: int,
+        mode: int = 0o777,
+    ) -> int:
+        if Path(path) == pending.path:
+            entered_open.set()
+            if not release_open.wait(timeout=2):
+                raise TimeoutError("test did not release pending filesystem acquire")
+        return real_open(path, flags, mode)
