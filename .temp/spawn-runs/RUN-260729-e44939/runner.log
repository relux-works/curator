+def _validate_cleanup_tree(
+    path: Path,
+    expected_entries: list[CleanupTreeEntry],
+    *,
+    allow_partial: bool,
+) -> None:
+    actual_entries = _cleanup_manifest(path)
+    expected_by_relative = {entry.relative_path: entry for entry in expected_entries}
+    for actual in actual_entries:
+        expected = expected_by_relative.get(actual.relative_path)
+        if expected is None:
+            raise TransactionCorruptionError(
+                f"unrecorded cleanup bytes: {path / actual.relative_path}"
+            )
+        if actual != expected:
+            raise TransactionCorruptionError(
+                f"changed cleanup bytes: {path / actual.relative_path}"
+            )
+    if not allow_partial and len(actual_entries) != len(expected_entries):
+        raise TransactionCorruptionError(f"missing cleanup bytes: {path}")
+
+
+def _remove_cleanup_tree(
+    path: Path,
+    expected_entries: list[CleanupTreeEntry],
+    *,
+    on_removed: Callable[[], None],
+) -> None:
+    if not _path_exists(path):
+        return
+    _validate_cleanup_tree(path, expected_entries, allow_partial=True)
+    expected_by_relative = {entry.relative_path: entry for entry in expected_entries}
+    root = expected_by_relative[""]
+    if root.kind == "file":
+        current = _cleanup_tree_entry(path, "", path.lstat())
+        if current != root:
+            raise TransactionCorruptionError(f"changed cleanup bytes: {path}")
