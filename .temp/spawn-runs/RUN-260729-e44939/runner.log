+) -> CleanupTreeEntry:
+    mode = stat.S_IMODE(info.st_mode)
+    if stat.S_ISREG(info.st_mode):
+        return CleanupTreeEntry(
+            relative_path=relative_path,
+            kind="file",
+            mode=mode,
+            digest=digest_path(path),
+        )
+    if stat.S_ISDIR(info.st_mode) and not path.is_symlink():
+        return CleanupTreeEntry(
+            relative_path=relative_path,
+            kind="directory",
+            mode=mode,
+            digest=None,
+        )
