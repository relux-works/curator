+            engine.commit(lock, "txn-foreign-cleanup")
+
+    cleanup_tomb = next(tmp_path.glob(".csk-txn-*.delete"))
+    if mutation == "unrecorded":
+        foreign = _write(cleanup_tomb / "foreign", "must-not-delete")
+    else:
