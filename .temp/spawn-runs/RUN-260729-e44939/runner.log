        target_class=target_class,
        identifier=identifier,
        live_path=live,
        desired_path=desired,
        expected_preimage_digest=digest_path(live),
    )


def _plan(
    transaction_id: str, project: Path, *targets: MutableTarget
) -> TransactionPlan:
