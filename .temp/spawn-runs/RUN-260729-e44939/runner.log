+            pass
+        with ManagerHomeLock(home):
+            pass
+    elif failed_class == "build":
+        with project:
+            with pytest.raises(PermissionError), build:
+                pass
+            with ManagerHomeLock(home):
+                pass
+    else:
+        with pytest.raises(PermissionError), home_lock:
+            pass
+        with ProjectLock(home, tmp_path / "after-failure"):
+            pass
+    assert injected
