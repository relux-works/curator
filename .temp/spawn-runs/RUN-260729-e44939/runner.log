+        engine.prepare(
+            lock,
+            _plan(
+                "txn-symlink-alias",
+                tmp_path / "project",
+                _target(
+                    "10-context",
+                    "parent",
+                    physical_parent,
+                    desired_parent,
+                ),
+                _target(
+                    "10-context",
+                    "child",
+                    alias / "child",
+                    desired_child,
+                ),
+            ),
+        )
+
+    assert not (physical_parent / "child").exists()
+    assert not engine.journal_root.exists()
+    assert not any(tmp_path.glob(".csk-txn-*"))
