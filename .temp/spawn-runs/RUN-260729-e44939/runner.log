+def _validate_cleanup_manifest_record(
+    expected_digest: str,
+    entries: list[CleanupTreeEntry],
+) -> None:
+    if not isinstance(entries, list) or not all(
+        isinstance(entry, CleanupTreeEntry) for entry in entries
+    ):
