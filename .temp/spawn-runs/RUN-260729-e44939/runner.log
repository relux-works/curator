+            ),
+        )
+        with pytest.raises(SimulatedCrash, match="sidecar_tombed"):
+            engine.commit(lock, "txn-foreign-cleanup")
+
+    cleanup_tomb = next(tmp_path.glob(".csk-txn-*.delete"))
+    _write(cleanup_tomb / "foreign", "must-not-delete")
+    with (
