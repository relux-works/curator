package main

import (
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"runtime"
	"strings"
)

// profileRun is one execution of the contract's exact two argument vectors over
// a build root whose only variable is its `[profile]` section, under a poisoned
// PATH. `pin` selects whether the manager's `-Csplit-debuginfo` pin is present.
type profileRun struct {
	Label   string `json:"label"`
	Profile string `json:"profile"`
	Pinned  bool   `json:"split_debuginfo_pinned"`
	Graph   int    `json:"graph_exit"`
	Build   int    `json:"build_exit"`
	Hits    int    `json:"path_resolutions"`
	Names   string `json:"path_resolved_names,omitempty"`
	StageP  string `json:"stage_p_verdict,omitempty"`
}

const profileProbeMain = "fn main() {\n    println!(\"42\");\n}\n"

func writeProfileRoot(dir, profile string) error {
	if err := mkdirAll(filepath.Join(dir, "src")); err != nil {
		return err
	}
	if err := mkdirAll(filepath.Join(dir, "vendor")); err != nil {
		return err
	}
	manifest := "[package]\nname = \"probeprofile\"\nversion = \"0.1.0\"\nedition = \"2021\"\n"
	if profile != "" {
		manifest += "\n" + profile + "\n"
	}
	if err := os.WriteFile(filepath.Join(dir, "Cargo.toml"), []byte(manifest), 0o644); err != nil {
		return err
	}
	if err := os.WriteFile(filepath.Join(dir, "src", "main.rs"), []byte(profileProbeMain), 0o644); err != nil {
		return err
	}
	lock := "# This file is automatically @generated by Cargo.\n# It is not intended for manual editing.\nversion = 4\n\n[[package]]\nname = \"probeprofile\"\nversion = \"0.1.0\"\n"
	return os.WriteFile(filepath.Join(dir, "Cargo.lock"), []byte(lock), 0o644)
}

// runProfileCase runs the exact graph and compile vectors and returns what the
// poisoned PATH recorded. Everything else is the normative environment of
// reference section 6: private CARGO_HOME with only the manager-written config,
// private HOME, absolute RUSTC, pinned linker, pinned SDK.
func runProfileCase(work string, tc Toolchain, label, profile string, pinned bool) profileRun {
	pr := profileRun{Label: label, Profile: profile, Pinned: pinned}
	base := filepath.Join(work, "struct", "profile", label)
	_ = os.RemoveAll(base)
	root := filepath.Join(base, "build_root")
	if err := writeProfileRoot(root, profile); err != nil {
		pr.Names = "fixture error: " + err.Error()
		return pr
	}
	shimDir := filepath.Join(base, "poisoned-path")
	log := filepath.Join(base, "PATH_HITS")
	if err := writeShims(shimDir, log); err != nil {
		pr.Names = "fixture error: " + err.Error()
		return pr
	}
	cargoHome := filepath.Join(base, "cargo-home")
	target := filepath.Join(base, "target")
	_ = mkdirAll(cargoHome)
	doc, why := serializeCargoConfig(filepath.Join(root, "vendor"))
	if why != "" {
		pr.Names = "config rejected: " + why
		return pr
	}
	if err := os.WriteFile(filepath.Join(cargoHome, "config.toml"), []byte(doc), 0o644); err != nil {
		pr.Names = "fixture error: " + err.Error()
		return pr
	}

	tcRun := tc
	if !pinned {
		tcRun.DebugInfoPin = ""
	}
	env := opEnv(work, tcRun, cargoHome, target, shimDir)
	_ = os.Remove(log)
	rGraph := exec1(root, env, append([]string{tc.CargoPath}, graphArgv...)...)
	rBuild := exec1(root, env, append([]string{tc.CargoPath}, compileArgv(tc.HostTuple, "probeprofile")...)...)
	pr.Graph = rGraph.ExitCode
	pr.Build = rBuild.ExitCode
	pr.Hits = countLines(log)
	if b, err := os.ReadFile(log); err == nil && len(b) > 0 {
		seen := map[string]bool{}
		var names []string
		for _, l := range strings.Split(strings.TrimSpace(string(b)), "\n") {
			n := strings.TrimSpace(strings.TrimPrefix(l, "PATH-RESOLVED:"))
			if n != "" && !seen[n] {
				seen[n] = true
				names = append(names, n)
			}
		}
		pr.Names = strings.Join(names, ",")
	}
	manifest, _ := os.ReadFile(filepath.Join(root, "Cargo.toml"))
	pr.StageP = profileGateVerdict(string(manifest))
	return pr
}

// structProfileProcessGraph is the measurement that forced this revision. The
// decisive rows are the two that reach `dsymutil`: the documented "packed"
// value, and any unrecognized value, which cargo drops on the floor so that
// rustc's own macOS default — also "packed" — applies.
func structProfileProcessGraph(work string, tc Toolchain) Structural {
	s := Structural{
		ID:    "profile-tables-cannot-start-a-process",
		Title: "no admitted [profile] shape reaches an executable outside the fingerprinted closure",
		Expected: "allowlisted: 0 hits, Stage P admits; packed/unknown/override unpinned: >0 hits; " +
			"pinned: 0 hits; Stage P rejects all three",
		Obligation: "Stage P rejects the shape from snapshot bytes before any cargo process, and the manager " +
			"pins -Csplit-debuginfo so the class is inert whatever cargo forwards.",
	}
	if runtime.GOOS == "windows" {
		s.Observed = "not run: the poisoned-PATH shims are POSIX shell scripts"
		s.Verdict = "not_run"
		return s
	}
	if !tc.Available {
		s.Observed = "not run: no toolchain"
		s.Verdict = "not_run"
		return s
	}

	const packed = "[profile.release]\ndebug = 2\nsplit-debuginfo = \"packed\""
	const unknown = "[profile.release]\ndebug = 2\nsplit-debuginfo = \"wat\""
	const override = "[profile.release]\ndebug = 2\n\n[profile.release.package.probeprofile]\nsplit-debuginfo = \"packed\""
	const allowed = "[profile.release]\nopt-level = 3\nlto = \"fat\"\ncodegen-units = 1\npanic = \"abort\"\ndebug = 2"

	runs := []profileRun{
		runProfileCase(work, tc, "allowlisted-pinned", allowed, true),
		runProfileCase(work, tc, "packed-unpinned", packed, false),
		runProfileCase(work, tc, "packed-pinned", packed, true),
		runProfileCase(work, tc, "unknown-value-unpinned", unknown, false),
		runProfileCase(work, tc, "unknown-value-pinned", unknown, true),
		runProfileCase(work, tc, "package-override-unpinned", override, false),
	}
	for _, r := range runs {
		b, _ := json.Marshal(r)
		s.Evidence = append(s.Evidence, string(b))
	}

	ok := runs[0].Hits == 0 && runs[0].StageP == "" && runs[0].Build == 0 &&
		runs[1].Hits > 0 && runs[2].Hits == 0 &&
		runs[3].Hits > 0 && runs[4].Hits == 0 &&
		runs[5].Hits > 0 &&
		runs[1].StageP != "" && runs[3].StageP != "" && runs[5].StageP != ""
	if ok {
		s.Observed = s.Expected
	} else {
		s.Observed = fmt.Sprintf("allowlisted hits=%d stageP=%q; packed unpinned=%d pinned=%d stageP=%q; "+
			"unknown unpinned=%d pinned=%d stageP=%q; override unpinned=%d stageP=%q",
			runs[0].Hits, runs[0].StageP, runs[1].Hits, runs[2].Hits, runs[1].StageP,
			runs[3].Hits, runs[4].Hits, runs[3].StageP, runs[5].Hits, runs[5].StageP)
	}
	s.settle()
	return s
}

// structAdmittedSetTotality answers blocking finding 2 with a measurement
// rather than with prose: it builds a default-layout package that uses every
// auto-discovered target shape plus one declared absent leaf, runs the exact
// graph vector, and requires every reported path to be a member of A.
func structAdmittedSetTotality(work string, tc Toolchain) Structural {
	s := Structural{
		ID:       "stage-p-admitted-set-covers-auto-discovered-targets",
		Title:    "every manifest_path and src_path the graph reports is a member of the Stage P admitted set",
		Expected: "reported>=6, outside A=0, superseded set rejects src/main.rs",
		Obligation: "A is the link-free snapshot walk plus the admitted absent leaves, so G11 needs no copy of " +
			"Cargo's target auto-discovery.",
	}
	if !tc.Available {
		s.Observed = "not run: no toolchain"
		s.Verdict = "not_run"
		return s
	}
	root := filepath.Join(work, "struct", "admitset", "build_root")
	_ = os.RemoveAll(root)
	for _, d := range []string{"src", "src/bin", "examples", "tests", "benches", "vendor"} {
		_ = mkdirAll(filepath.Join(root, d))
	}
	manifest := "[package]\nname = \"probeadmit\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n" +
		"[[bin]]\nname = \"ghost\"\npath = \"src/ghost.rs\"\n"
	_ = os.WriteFile(filepath.Join(root, "Cargo.toml"), []byte(manifest), 0o644)
	_ = os.WriteFile(filepath.Join(root, "src", "main.rs"), []byte(profileProbeMain), 0o644)
	_ = os.WriteFile(filepath.Join(root, "src", "lib.rs"), []byte("pub fn f() {}\n"), 0o644)
	_ = os.WriteFile(filepath.Join(root, "src", "bin", "extra.rs"), []byte(profileProbeMain), 0o644)
	_ = os.WriteFile(filepath.Join(root, "examples", "e.rs"), []byte(profileProbeMain), 0o644)
	_ = os.WriteFile(filepath.Join(root, "tests", "t.rs"), []byte("#[test]\nfn t() {}\n"), 0o644)
	_ = os.WriteFile(filepath.Join(root, "benches", "b.rs"), []byte(profileProbeMain), 0o644)
	lock := "version = 4\n\n[[package]]\nname = \"probeadmit\"\nversion = \"0.1.0\"\n"
	_ = os.WriteFile(filepath.Join(root, "Cargo.lock"), []byte(lock), 0o644)

	env := baseEnv(work, tc.RustcPath, "")
	run, out := exec1Full(root, env, append([]string{tc.CargoPath}, graphArgv...)...)
	if run.ExitCode != 0 {
		s.Observed = fmt.Sprintf("graph exited %d", run.ExitCode)
		s.settle()
		return s
	}
	var doc cmDoc
	if err := json.Unmarshal([]byte(out), &doc); err != nil {
		s.Observed = "metadata did not parse"
		s.settle()
		return s
	}
	reported := reportedPaths(doc)

	// The one declared leaf section 4.3 admits and permits to be absent.
	declaredAbsent := []string{filepath.Join(root, "src", "ghost.rs")}
	a := buildAdmittedSet(root, declaredAbsent)
	outside := g11(a, reported)

	// The superseded set: manifests plus declared values only.
	sup := supersededAdmittedSet(root,
		[]string{filepath.Join(root, "Cargo.toml")}, declaredAbsent)
	supOutside := g11(sup, reported)
	supRejectsMain := contains(supOutside, filepath.Join(root, "src", "main.rs"))

	for _, p := range reported {
		s.Evidence = append(s.Evidence, "reported "+relTo(root, p)+" inA="+boolWord(a.Has(p)))
	}
	s.Evidence = append(s.Evidence,
		fmt.Sprintf("A size=%d walkErr=%q", a.Size(), a.WalkErr),
		fmt.Sprintf("superseded set left %d reported paths outside", len(supOutside)))

	s.Observed = fmt.Sprintf("reported>=6, outside A=%d, superseded set rejects src/main.rs", len(outside))
	if len(reported) < 6 || !supRejectsMain {
		s.Observed = fmt.Sprintf("reported=%d, outside A=%d, superseded rejects src/main.rs=%v",
			len(reported), len(outside), supRejectsMain)
	}
	s.settle()
	return s
}

