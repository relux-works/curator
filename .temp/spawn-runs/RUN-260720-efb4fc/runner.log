.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="402.6289" x="196.1816" y="576.0078"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="382.6289" x="206.1816" y="598.0723">Derive fixed build inputs and inspect protected cache read-only</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="225.4355" x="284.7783" y="691.2761"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="205.4355" x="294.7783" y="713.3406">Recheck shared-state generations</text><path d="M597.0049,741.7451 L597.0049,766.4441 L577.0049,770.4441 L597.0049,774.4441 L597.0049,799.1431 A0,0 0 0 0 597.0049,799.1431 L948.0386,799.1431 A0,0 0 0 0 948.0386,799.1431 L948.0386,751.7451 L938.0386,741.7451 L597.0049,741.7451 A0,0 0 0 0 597.0049,741.7451" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><path d="M938.0386,741.7451 L938.0386,751.7451 L948.0386,751.7451 L938.0386,741.7451" fill="#FFFFFF" style="stroke:#000000;stroke-width:1;"/><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="141.2036" x="603.0049" y="759.8149">No go list or go build.</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="270.2705" x="603.0049" y="775.6143">No persistent cache, audit, registry, lock,</text><text fill="#000000" font-family="Verdana" font-size="13" lengthAdjust="spacing" textLength="330.0337" x="603.0049" y="791.4136">journal, marker, shim, consumer, or GC mutation.</text><rect fill="#FFFFFF" height="49.168" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="359.0176" x="217.9873" y="745.8601"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="266.3613" x="227.9873" y="767.9246">Report cache-hit, would-preflight-and-build,</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLengt