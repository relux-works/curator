+	if err := os.Mkdir(root, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	writeTestFile(t, root, "file", []byte("same"))
+	if err := token.Recheck(); !errors.Is(err, ErrSnapshotMutated) {
