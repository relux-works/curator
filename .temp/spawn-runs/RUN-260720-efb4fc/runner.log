+)
+
+func TestRejectsSpecialFile(t *testing.T) {
+	root := t.TempDir()
+	if err := unix.Mkfifo(filepath.Join(root, "pipe"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Validate(root); !errors.Is(err, ErrInvalidSnapshot) {
+		t.Fatalf("Validate error = %v", err)
+	}
+}
