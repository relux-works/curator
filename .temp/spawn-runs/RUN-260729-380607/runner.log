    35	
    36	# --- CI gates ---------------------------------------------------------------
    37	#
    38	# These targets are the local mirror of the workflow. CI calls the scripts
    39	# directly rather than through `make`, because `make` is not a guaranteed tool
    40	# on windows-latest; the recipes below invoke exactly the same scripts with
    41	# exactly the same environment, so a green `make check-ci` means the same thing
    42	# the job does.
    43	#
    44	# Every gate consumes a protocol suite root. CI exports it from the committed
    45	# pin; a local run must supply it explicitly, because a gate that quietly runs
    46	# with the conformance suite unset is a smaller gate wearing the same name.
    47	require-pin-root:
    48		@test -n "$(CURATOR_CONFORMANCE_ROOT)" || { \
