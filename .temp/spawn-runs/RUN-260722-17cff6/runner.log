   397	func (engine *Engine) journalIDs() ([]string, error) {
   398		entries, err := os.ReadDir(engine.journalRoot)
   399		if os.IsNotExist(err) {
   400			return nil, nil
   401		}
   402		if err != nil {
   403			return nil, err
   404		}
   405		seen := make(map[string]string, len(entries))
   406		for _, entry := range entries {
   407			name := entry.Name()
   408			suffix := ""
   409			switch {
   410			case strings.HasSuffix(name, ".json.delete"):
   411				suffix = ".json.delete"
   412			case strings.HasSuffix(name, ".json"):
   413				suffix = ".json"
   414			default:
   415				continue
   416			}
   417			id := strings.TrimSuffix(name, suffix)
   418			if !transactionIDPattern.MatchString(id) {
   419				return nil, journalf("unexpected journal filename %q", name)
   420			}
   421			if prior, exists := seen[id]; exists {
   422				return nil, corruptionf("transaction %s has multiple journal records %q and %q", id, prior, name)
   423			}
   424			seen[id] = name
   425		}
   426		ids := make([]string, 0, len(seen))
   427		for id := range seen {
   428			ids = append(ids, id)
   429		}
   430		sort.Slice(ids, func(i, j int) bool { return bytes.Compare([]byte(ids[i]), []byte(ids[j])) < 0 })
   431		return ids, nil
   432	}
