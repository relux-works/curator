   438	func captureRemovalEntries(path, expectedDigest string) ([]RemovalEntry, error) {
   439		if err := verifyRemovalDigest(path, expectedDigest); err != nil {
   440			return nil, err
   441		}
   442		var entries []RemovalEntry
   443		err := filepath.Walk(path, func(current string, info os.FileInfo, walkErr error) error {
   444			if walkErr != nil {
   445				return walkErr
   446			}
   447			if info.Mode()&os.ModeSymlink != 0 || (!info.Mode().IsRegular() && !info.IsDir()) {
   448				return corruptionf("durable removal refused unsafe entry %s", current)
   449			}
   450			relative, err := filepath.Rel(path, current)
   451			if err != nil {
   452				return err
   453			}
   454			if relative == "." {
   455				relative = ""
   456			} else {
   457				relative = filepath.ToSlash(relative)
   458			}
   459			entry := RemovalEntry{RelativePath: relative, Mode: uint32(info.Mode().Perm())}
   460			if info.IsDir() {
   461				entry.Kind = "directory"
   462			} else {
   463				entry.Kind = "file"
   464				entry.Digest, err = DigestPath(current)
   465				if err != nil {
   466					return err
   467				}
   468			}
   469			entries = append(entries, entry)
   470			return nil
   471		})
   472		if err != nil {
   473			return nil, err
   474		}
   475		sort.Slice(entries, func(i, j int) bool {
   476			return bytes.Compare([]byte(entries[i].RelativePath), []byte(entries[j].RelativePath)) < 0
   477		})
   478		if err := validateRemovalEntries(entries); err != nil {
   479			return nil, corruptionf("durable removal manifest for %s is invalid: %v", path, err)
   480		}
   481		if err := verifyRemovalDigest(path, expectedDigest); err != nil {
   482			return nil, err
   483		}
   484		return entries, nil
   485	}
