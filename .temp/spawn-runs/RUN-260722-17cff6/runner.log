    41	func copyDirectory(source, destination string) error {
    42		entries, err := os.ReadDir(source)
    43		if err != nil {
    44			return err
    45		}
    46		for _, entry := range entries {
    47			sourcePath := filepath.Join(source, entry.Name())
    48			destinationPath := filepath.Join(destination, entry.Name())
    49			info, err := os.Lstat(sourcePath)
    50			if err != nil {
    51				return err
    52			}
    53			switch {
    54			case info.Mode().IsRegular():
    55				if err := copyRegular(sourcePath, destinationPath, info.Mode().Perm()); err != nil {
    56					return err
    57				}
    58			case info.IsDir() && info.Mode()&os.ModeSymlink == 0:
    59				if err := os.Mkdir(destinationPath, info.Mode().Perm()); err != nil {
    60					return err
    61				}
    62				if err := copyDirectory(sourcePath, destinationPath); err != nil {
    63					return err
    64				}
    65				if err := os.Chmod(destinationPath, info.Mode().Perm()); err != nil {
    66					return err
    67				}
    68			default:
    69				return fmt.Errorf("unsafe staged transaction entry: %s", sourcePath)
    70			}
    71		}
    72		return syncTree(destination)
    73	}
