name: Specification CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: specification-${{ github.ref }}
  cancel-in-progress: true

jobs:
  validate:
    name: Specification (${{ matrix.os }})
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          fetch-depth: 0

      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6.5.0
        with:
          go-version-file: go.mod
          cache: false

      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: requirements-dev.txt

      - name: Install validation dependencies
        run: python -m pip install -r requirements-dev.txt

      - name: Validate schemas, cases, manifest, and local links
        run: python tools/validate.py

      - name: Test stable release gate
        run: python -B -m unittest discover -s tools -p 'test_*.py'

      - name: Verify generator and cryptographic vectors
        run: go test ./tools/...

      - name: Regenerate authoritative vectors
        run: go run ./tools/generate-vectors -root .

      - name: Prove deterministic regeneration
        run: git diff --exit-code -- conformance/v1 release/1.0.0-rc.5.json

  formatting:
    name: Formatting
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - name: Check Go formatting
        run: |
          files="$(gofmt -l tools)"
          test -z "$files" || { echo "$files"; exit 1; }
      - name: Check whitespace
        run: git diff --check

  links:
    name: Links
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - uses: lycheeverse/lychee-action@e7477775783ea5526144ba13e8db5eec57747ce8 # v2.9.0
        with:
          args: >-
            --no-progress
            --max-retries 3
            --retry-wait-time 2
            --accept 200,206,429
            '**/*.md'
          fail: true
name: Release specification

on:
  push:
    tags: ["v*"]

permissions:
  contents: write
  id-token: write
  attestations: write

jobs:
  release:
    name: Publish signed specification artifacts
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          fetch-depth: 0

      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6.5.0
        with:
          go-version-file: go.mod
          cache: false

      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: requirements-dev.txt

      - name: Install validation dependencies
        run: python -m pip install -r requirements-dev.txt

      - name: Validate release input
        env:
          GITHUB_DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
          GITHUB_TOKEN: ${{ github.token }}
        run: |
          git config gpg.format ssh
          git config gpg.ssh.allowedSignersFile "$PWD/maintainers.allowed_signers"
          git verify-tag "$GITHUB_REF_NAME"
          git fetch --no-tags origin "$GITHUB_DEFAULT_BRANCH:refs/remotes/origin/$GITHUB_DEFAULT_BRANCH"
          python tools/verify_release_commit.py --commit "$GITHUB_SHA"
          python tools/validate.py
          python -B -m unittest discover -s tools -p 'test_*.py'
          go test ./tools/...
          go run ./tools/generate-vectors -root .
          git diff --exit-code -- conformance/v1 release/1.0.0-rc.5.json
          version="${GITHUB_REF_NAME#v}"
          python tools/release_gate.py --version "$version" --commit "$GITHUB_SHA"

      - name: Package normative release
        run: |
          version="${GITHUB_REF_NAME#v}"
          directory="curator-protocol-${version}"
          mkdir "$directory"
          cp -R README.md LICENSE CHANGELOG.md COMPATIBILITY.md SECURITY.md GOVERNANCE.md RELEASE.md maintainers.allowed_signers \
            protocol profiles cli conformance schemas decisions docs release reviews "$directory/"
          tar -czf "${directory}.tar.gz" "$directory"
          zip -qr "${directory}.zip" "$directory"
          sha256sum "${directory}.tar.gz" "${directory}.zip" > checksums.txt

      - uses: actions/attest-build-provenance@0f67c3f4856b2e3261c31976d6725780e5e4c373 # v4.1.1
        with:
          subject-path: |
            curator-protocol-*.tar.gz
            curator-protocol-*.zip
            checksums.txt

      - uses: softprops/action-gh-release@718ea10b132b3b2eba29c1007bb80653f286566b # v3.0.1
        with:
          generate_release_notes: true
          prerelease: ${{ contains(github.ref_name, '-') }}
          files: |
            curator-protocol-*.tar.gz
            curator-protocol-*.zip
            checksums.txt
#!/usr/bin/env python3
"""Run a pytest suite and turn every skipped test into a gate failure."""

from __future__ import annotations

import sys

import pytest


class NoSkips:
    def __init__(self) -> None:
        self.nodeids: set[str] = set()

    def pytest_collectreport(self, report: pytest.CollectReport) -> None:
        if report.skipped:
            self.nodeids.add(report.nodeid)

    def pytest_runtest_logreport(self, report: pytest.TestReport) -> None:
        if report.skipped:
            self.nodeids.add(report.nodeid)


def main() -> int:
    gate = NoSkips()
    result = pytest.main(sys.argv[1:], plugins=[gate])
    if gate.nodeids:
        print("conformance gate: skipped tests are forbidden", file=sys.stderr)
        for nodeid in sorted(gate.nodeids):
            print(f"- {nodeid}", file=sys.stderr)
        return 1
    return int(result)


if __name__ == "__main__":
    raise SystemExit(main())
