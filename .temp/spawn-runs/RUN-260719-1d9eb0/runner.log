  "driver": "go-v1",
  "snapshot_sha256": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "command": "golden-tool",
  "source_dir": "cmd/golden-tool",
  "target": {
    "goos": "darwin",

