diff --git a/.temp/TASK-260720-poa3ze/digest-check/main.go b/.temp/TASK-260720-poa3ze/digest-check/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..d5fed145f5e16b939cfcbb3a90746924604d8edb
--- /dev/null
+++ b/.temp/TASK-260720-poa3ze/digest-check/main.go
@@ -0,0 +1,37 @@
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+	"hash"
+)
+
+type entry struct {
+	kind    byte
+	path    string
+	payload string
+}
+
+func framed(h hash.Hash, kind byte, path, payload string) {
+	h.Write([]byte{kind})
+	_ = binary.Write(h, binary.BigEndian, uint64(len(path)))
+	h.Write([]byte(path))
+	_ = binary.Write(h, binary.BigEndian, uint64(len(payload)))
+	h.Write([]byte(payload))
+}
+
+func main() {
+	h := sha256.New()
+	h.Write([]byte("curator-go-toolchain-v1\x00"))
+	for _, e := range []entry{
+		{'D', "bin", ""},
+		{'F', "bin/go", "GO"},
+		{'D', "pkg", ""},
+		{'L', "pkg/tool-link", "../bin/go"},
+	} {
+		framed(h, e.kind, e.path, e.payload)
+	}
+	framed(h, 'V', "", "go version go1.25.5 darwin/arm64")
+	fmt.Printf("sha256:%x\n", h.Sum(nil))
+}
