+    desired = _write(tmp_path / "desired", "new")
+
+    def crash_after_tomb(point: str, target: JournalTarget | None) -> None:
+        if rollback and point == "target_committed":
+            raise RuntimeError("force rollback")
+        if point == "journal_tombed":
