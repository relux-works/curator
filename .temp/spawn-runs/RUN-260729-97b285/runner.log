+    flush_file_buffers.argtypes = [ctypes.c_void_p]
+    flush_file_buffers.restype = ctypes.c_int
+    close_handle: Any = kernel32.CloseHandle
+    close_handle.argtypes = [ctypes.c_void_p]
+    close_handle.restype = ctypes.c_int
