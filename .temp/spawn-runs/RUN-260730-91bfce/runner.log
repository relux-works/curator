   189	def _apply_system_config(
   190	    system_data: dict[str, Any], user_data: dict[str, Any], system_path: Path
   191	) -> dict[str, Any]:
   192	    """Overlay the system config, enforcing its locked keys over the user config.
   193	
   194	    A key listed under 'locked' takes its value from the system config, and a
   195	    user override of that key is ignored with a warning. Other system keys act
   196	    as defaults the user config may override.
   197	    """
   198	    schema = system_data.get("schema_version")
   199	    if not isinstance(schema, int) or isinstance(schema, bool) or schema != SCHEMA_VERSION:
   200	        raise ConfigError(f"System config {system_path} requires schema_version 1")
   201	    unknown = sorted(set(system_data) - MANAGER_KEYS - {"locked"})
   202	    if unknown:
   203	        joined = ", ".join(repr(item) for item in unknown)
   204	        raise ConfigError(f"System config {system_path} has unsupported field(s): {joined}")
   205	    locked_raw = system_data.get("locked", [])
   206	    if not _is_str_list(locked_raw):
   207	        raise ConfigError(f"System config {system_path} field 'locked' must be a list of strings")
   208	    if len(set(locked_raw)) != len(locked_raw):
   209	        raise ConfigError(f"System config {system_path} field 'locked' must not contain duplicates")
   210	    unsupported_locks = sorted(set(locked_raw) - LOCKABLE_KEYS)
   211	    if unsupported_locks:
   212	        raise ConfigError(f"System config {system_path} cannot lock {unsupported_locks[0]!r}")
   213	    locked = set(locked_raw)
   214	    merged = dict(user_data)
   215	    for key, value in system_data.items():
   216	        if key in {"locked", "schema_version"}:
   217	            continue
   218	        if key in locked:
   219	            if key in user_data and user_data[key] != value:
   220	                print(
   221	                    f"warning: config key {key!r} is locked by {system_path}; "
   222	                    "the user override is ignored",
   223	                    file=sys.stderr,
   224	                )
   225	            merged[key] = value
   226	        else:
   227	            merged.setdefault(key, value)
   228	    for key in locked:
   229	        if key not in system_data:
   230	            raise ConfigError(f"System config {system_path} locks {key!r} but does not set it")
   231	    return merged
   232	
   233	
   234	def parse_config(data: dict[str, Any], path: Path) -> GlobalConfig:
   235	    if not isinstance(data, dict):
   236	        raise ConfigError("Global config must be a JSON object")
   237	    _reject_unknown_fields(data, set(MANAGER_KEYS), "top level")
   238	    schema = data.get("schema_version")
   239	    if schema is None:
   240	        raise ConfigError("Global config is missing required field 'schema_version'")

