   161	def _tree_state(root: Path) -> tuple[tuple[str, str, int, int, str], ...]:
   162	    records: list[tuple[str, str, int, int, str]] = []
   163	    pending = [root]
   164	    while pending:
   165	        path = pending.pop()
   166	        info = path.lstat()
   167	        relative = "." if path == root else path.relative_to(root).as_posix()
   168	        mode = stat.S_IMODE(info.st_mode)
   169	        if stat.S_ISDIR(info.st_mode):
   170	            kind = "directory"
   171	            payload = ""
   172	            try:
   173	                with os.scandir(path) as iterator:
   174	                    children = sorted(
   175	                        (Path(entry.path) for entry in iterator),
   176	                        reverse=True,
   177	                    )
   178	            except PermissionError:
   179	                children = []
   180	                payload = "unreadable"
   181	            pending.extend(children)
   182	        elif stat.S_ISREG(info.st_mode):
   183	            kind = "file"
   184	            payload = hashlib.sha256(path.read_bytes()).hexdigest()
   185	        elif stat.S_ISLNK(info.st_mode):
   186	            kind = "symlink"
   187	            payload = os.readlink(path)
   188	        else:
   189	            kind = "special"
   190	            payload = ""
   191	        records.append((relative, kind, mode, info.st_size, payload))
   192	    return tuple(sorted(records))
