   554	def _artifact_name(build_input: _metadata.GoBuildInput) -> str:
   555	    parts = build_input.artifact_path.split("/")
   556	    if len(parts) != 2 or parts[0] != "bin" or not parts[1]:
   557	        raise ValueError("manager-derived artifact path is not a direct bin child")
   558	    if parts[1] in {".", ".."} or "/" in parts[1] or os.sep in parts[1]:
   559	        raise ValueError("manager-derived artifact filename is unsafe")
   560	    return parts[1]
