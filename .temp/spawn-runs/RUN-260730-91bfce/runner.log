   563	def _key_component(cache_key: str) -> str:
   564	    prefix = "sha256:"
   565	    if (
   566	        not isinstance(cache_key, str)
   567	        or not cache_key.startswith(prefix)
   568	        or len(cache_key) != len(prefix) + 64
   569	    ):
   570	        raise BuildCacheError("cache_key_invalid", "logical cache key is malformed")
   571	    component = cache_key.removeprefix(prefix)
   572	    if any(character not in "0123456789abcdef" for character in component):
   573	        raise BuildCacheError("cache_key_invalid", "logical cache key is malformed")
   574	    return component
