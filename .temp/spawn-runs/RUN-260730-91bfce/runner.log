   231	func requireHomeLock(lock HomeLock) error {
   232		if lock == nil || (reflect.ValueOf(lock).Kind() == reflect.Pointer && reflect.ValueOf(lock).IsNil()) {
   233			return fmt.Errorf("caller-held manager-home lock is required")
   234		}
   235		if err := lock.AssertHeld(); err != nil {
   236			return fmt.Errorf("manager-home lock is not held: %w", err)
   237		}
   238		return nil
   239	}
