   114	func validateUnixDir(fd int, label string) error {
   115		var stat unix.Stat_t
   116		if err := unix.Fstat(fd, &stat); err != nil {
   117			return untrustedf("stat %s: %v", label, err)
   118		}
   119		if stat.Mode&unix.S_IFMT != unix.S_IFDIR {
   120			return untrustedf("%s is not a directory", label)
   121		}
   122		if int(stat.Uid) != os.Geteuid() {
   123			return untrustedf("%s owner does not match the effective user", label)
   124		}
   125		if stat.Mode&0o022 != 0 {
   126			return untrustedf("%s is writable by group or other", label)
   127		}
   128		return nil
   129	}
