   733	def _validate_regular_file(
   734	    descriptor: int,
   735	    label: str,
   736	    *,
   737	    expected_mode: int,
   738	) -> os.stat_result:
   739	    info = os.fstat(descriptor)
   740	    if not stat.S_ISREG(info.st_mode):
   741	        raise _UntrustedState(f"{label} is not a regular file")
   742	    if info.st_nlink != 1:
   743	        raise _UntrustedState(f"{label} is not singly linked")
   744	    if info.st_uid != _effective_uid():
   745	        raise _UntrustedState(
   746	            f"{label} owner does not match the effective user"
   747	        )
   748	    mode = stat.S_IMODE(info.st_mode)
   749	    if mode != expected_mode:
   750	        raise _UntrustedState(
   751	            f"{label} mode {mode:o} is not immutable mode {expected_mode:o}"
   752	        )
   753	    return info
