   601	def test_atomic_different_concurrent_winner_is_conflict(tmp_path: Path) -> None:
   602	    home, store = _new_store(tmp_path)
   603	    build_input = _build_input()
   604	    first, _ = _publication(tmp_path, build_input, b"first artifact")
   605	    second, _ = _publication(tmp_path, build_input, b"second artifact")
   606	    barrier = threading.Barrier(2)
   607	    stores = (PosixBuildCache(home), PosixBuildCache(home))
   608	
   609	    def publish(args: tuple[PosixBuildCache, CachePublication]) -> object:
   610	        candidate_store, candidate = args
   611	        barrier.wait()
   612	        try:
   613	            return candidate_store.publish(candidate, guard=_HeldGuard())
   614	        except CacheConflictError as exc:
   615	            return exc
   616	
   617	    with ThreadPoolExecutor(max_workers=2) as executor:
   618	        outcomes = list(executor.map(publish, zip(stores, (first, second), strict=True)))
   619	
   620	    conflicts = [value for value in outcomes if isinstance(value, CacheConflictError)]
   621	    successes = [value for value in outcomes if not isinstance(value, CacheConflictError)]
   622	    assert len(conflicts) == 1
   623	    assert len(successes) == 1
   624	    assert conflicts[0].cache_key == cache_key(build_input)
   625	    hit = store.inspect(CacheExpectation(input=build_input))
   626	    assert hit.status is CacheEntryStatus.HIT
   627	    assert hit.artifact_path is not None
   628	    assert hit.artifact_path.read_bytes() in {b"first artifact", b"second artifact"}
