   167	        raise ConfigError(f"Global config not found: {resolved}") from exc
   168	    except protocol_json.ProtocolJSONError as exc:
   169	        raise ConfigError(f"Malformed JSON in global config {resolved}: {exc}") from exc
   170	    if not isinstance(user_data, dict):
   171	        raise ConfigError("Global config must be a JSON object")
   172	
   173	    system_path = system_config_path()
   174	    if system_path is not None:
   175	        try:
   176	            system_data = protocol_json.loads(system_path.read_bytes())
   177	        except FileNotFoundError:
   178	            system_data = None
   179	        except protocol_json.ProtocolJSONError as exc:
   180	            raise ConfigError(f"Malformed JSON in system config {system_path}: {exc}") from exc
   181	        if system_data is not None:
   182	            if not isinstance(system_data, dict):
   183	                raise ConfigError(f"System config {system_path} must be a JSON object")
   184	            user_data = _apply_system_config(system_data, user_data, system_path)
