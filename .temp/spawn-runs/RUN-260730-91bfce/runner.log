   241	func openRegularSource(path string) (*os.File, error) {
   242		if path == "" {
   243			return nil, fmt.Errorf("publication artifact source is empty")
   244		}
   245		lstat, err := os.Lstat(path)
   246		if err != nil {
   247			return nil, fmt.Errorf("inspect publication artifact: %w", err)
   248		}
   249		if !lstat.Mode().IsRegular() {
   250			return nil, fmt.Errorf("publication artifact is not a regular file")
   251		}
   252		file, err := os.Open(path) // #nosec G304 -- caller-provided private staging input is verified below
   253		if err != nil {
