   181	// Quarantine atomically moves a present entry aside under the caller-held home
   182	// lock. It never traverses or repairs the entry and returns an empty path for a
   183	// missing key.
   184	func (store *Store) Quarantine(key buildmeta.CacheKey, lock HomeLock) (string, error) {
   185		if err := requireHomeLock(lock); err != nil {
   186			return "", err
   187		}
   188		if store == nil || store.supported == nil || !store.supported() {
   189			return "", fmt.Errorf("persistent build cache protection is unsupported")
   190		}
   191		entryPath, _, err := store.paths(key)
   192		if err != nil {
   193			return "", err
   194		}
   195		return store.quarantinePath(entryPath, lock)
   196	}
