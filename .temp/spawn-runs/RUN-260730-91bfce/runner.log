   133		if err := unix.Fstat(fd, &stat); err != nil {
   134			return untrustedf("stat %s: %v", label, err)
   135		}
   136		if stat.Mode&unix.S_IFMT != unix.S_IFREG {
   137			return untrustedf("%s is not a regular file", label)
   138		}
   139		if stat.Nlink != 1 {
