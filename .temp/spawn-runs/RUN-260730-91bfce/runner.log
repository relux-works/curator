776-    "artifact_is_regular_executable": true,
777:    "receipt": {
778-      "schema_version": 1,
779:      "cache_key": "sha256:3fcd714a40e8918eb67dbd35d435875dcce6c9047da811a1fa26626e5e57be48",
780-      "input": {
781-        "schema_version": 1,
782-        "driver": "go-v1",
