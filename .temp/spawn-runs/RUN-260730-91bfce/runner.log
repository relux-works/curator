   703	def _validate_manager_home(descriptor: int) -> None:
   704	    info = os.fstat(descriptor)
   705	    if not stat.S_ISDIR(info.st_mode):
   706	        raise _UntrustedState("manager home is not a directory")
   707	    if info.st_uid != _effective_uid():
   708	        raise _UntrustedState(
   709	            "manager home owner does not match the effective user"
   710	        )
   711	    mode = stat.S_IMODE(info.st_mode)
   712	    if mode & 0o022:
   713	        raise _UntrustedState("manager home is writable by group or other")
   714	    if mode & 0o700 != 0o700:
   715	        raise _UntrustedState("manager home does not grant owner control")
   716	
