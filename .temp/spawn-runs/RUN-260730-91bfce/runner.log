   511	def _protection_supported() -> bool:
   512	    if os.name != "posix":
   513	        return False
   514	    required_flags = all(
   515	        hasattr(os, name)
   516	        for name in (
   517	            "O_CLOEXEC",
   518	            "O_DIRECTORY",
   519	            "O_NOFOLLOW",
   520	        )
   521	    )
   522	    required_calls = (
   523	        os.open in os.supports_dir_fd
   524	        and os.mkdir in os.supports_dir_fd
   525	        and os.rename in os.supports_dir_fd
   526	        and os.listdir in os.supports_fd
   527	    )
   528	    return (
   529	        required_flags
   530	        and required_calls
   531	        and hasattr(os, "geteuid")
   532	        and _rename_noreplace_available()
   533	    )
