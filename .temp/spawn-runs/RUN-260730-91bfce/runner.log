   869	def _hash_file(
   870	    descriptor: int,
   871	    *,
   872	    expected_size: int,
   873	    label: str,
   874	    error_factory: Callable[[str], Exception],
   875	) -> tuple[str, int]:
   876	    before = os.fstat(descriptor)
   877	    if before.st_size != expected_size:
   878	        raise error_factory(f"{label} size does not match the receipt")
   879	    os.lseek(descriptor, 0, os.SEEK_SET)
   880	    remaining = expected_size
   881	    digest = hashlib.sha256()
   882	    while remaining:
   883	        chunk = os.read(descriptor, min(_READ_CHUNK, remaining))
   884	        if not chunk:
   885	            raise error_factory(f"{label} changed while reading")
   886	        digest.update(chunk)
   887	        remaining -= len(chunk)
   888	    if os.read(descriptor, 1):
   889	        raise error_factory(f"{label} grew while reading")
   890	    after = os.fstat(descriptor)
   891	    if not _stable_file_state(before, after):
   892	        raise error_factory(f"{label} changed while reading")
   893	    return f"sha256:{digest.hexdigest()}", expected_size
