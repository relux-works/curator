   536	def _rename_noreplace_available() -> bool:
   537	    library = ctypes.CDLL(None)
   538	    if sys.platform == "darwin":
   539	        return hasattr(library, "renameatx_np")
   540	    if sys.platform.startswith("linux"):
   541	        return hasattr(library, "renameat2")
   542	    return False
