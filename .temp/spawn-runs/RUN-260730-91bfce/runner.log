   844	def _read_bounded_file(
   845	    descriptor: int,
   846	    limit: int,
   847	    label: str,
   848	) -> bytes:
   849	    before = os.fstat(descriptor)
   850	    if before.st_size < 0 or before.st_size > limit:
   851	        raise _CorruptState(f"{label} size is outside the supported range")
   852	    os.lseek(descriptor, 0, os.SEEK_SET)
   853	    remaining = before.st_size
   854	    chunks: list[bytes] = []
   855	    while remaining:
   856	        chunk = os.read(descriptor, min(_READ_CHUNK, remaining))
   857	        if not chunk:
   858	            raise _CorruptState(f"{label} changed while reading")
   859	        chunks.append(chunk)
   860	        remaining -= len(chunk)
   861	    if os.read(descriptor, 1):
   862	        raise _CorruptState(f"{label} grew while reading")
   863	    after = os.fstat(descriptor)
   864	    if not _stable_file_state(before, after):
   865	        raise _CorruptState(f"{label} changed while reading")
   866	    return b"".join(chunks)
