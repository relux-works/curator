   718	def _validate_directory(descriptor: int, label: str, expected_mode: int) -> None:
   719	    info = os.fstat(descriptor)
   720	    if not stat.S_ISDIR(info.st_mode):
   721	        raise _UntrustedState(f"{label} is not a directory")
   722	    if info.st_uid != _effective_uid():
   723	        raise _UntrustedState(
   724	            f"{label} owner does not match the effective user"
   725	        )
   726	    mode = stat.S_IMODE(info.st_mode)
   727	    if mode != expected_mode:
   728	        raise _UntrustedState(
   729	            f"{label} mode {mode:o} is not protected mode {expected_mode:o}"
   730	        )
