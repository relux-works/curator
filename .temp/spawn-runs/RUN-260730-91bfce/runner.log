   255		}
   256		opened, err := file.Stat()
   257		if err != nil {
   258			_ = file.Close()
   259			return nil, err
   260		}
   261		if !opened.Mode().IsRegular() || !os.SameFile(lstat, opened) {
   262			_ = file.Close()
   263			return nil, fmt.Errorf("publication artifact changed while opening")
   264		}
   265		return file, nil
   266	}

