   198	func (store *Store) quarantinePath(entryPath string, lock HomeLock) (string, error) {
   199		if err := requireHomeLock(lock); err != nil {
   200			return "", err
   201		}
   202		if _, err := os.Lstat(entryPath); err != nil {
   203			if errors.Is(err, os.ErrNotExist) {
   204				return "", nil
   205			}
   206			return "", fmt.Errorf("inspect cache entry for quarantine: %w", err)
   207		}
   208		parent := filepath.Dir(entryPath)
   209		name := ".quarantine-" + filepath.Base(entryPath) + "-"
   210		placeholder, err := os.CreateTemp(parent, name)
   211		if err != nil {
   212			return "", fmt.Errorf("reserve quarantine name: %w", err)
   213		}
   214		quarantinePath := placeholder.Name()
   215		if err := placeholder.Close(); err != nil {
   216			_ = os.Remove(quarantinePath)
   217			return "", err
   218		}
   219		if err := os.Remove(quarantinePath); err != nil {
   220			return "", err
   221		}
   222		if err := os.Rename(entryPath, quarantinePath); err != nil {
   223			return "", fmt.Errorf("quarantine cache entry: %w", err)
   224		}
   225		if err := syncDirectory(parent); err != nil {
   226			return "", fmt.Errorf("sync quarantined cache root: %w", err)
   227		}
   228		return quarantinePath, nil
   229	}
