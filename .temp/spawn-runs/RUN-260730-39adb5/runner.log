+        planner.os.replace(replacement, path)
+        return content
+
+    monkeypatch.setattr(
+        planner,
+        "_hash_regular_file_noatime",
+        replace_after_hash,
+    )
+
+    with pytest.raises(planner.BuildPlanningError) as error:
+        probe.capture()
+
+    assert error.value.code == "concurrent_state_change"
