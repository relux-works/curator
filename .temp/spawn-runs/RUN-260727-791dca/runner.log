allocated with `sandbox_free_error'.\n    42\t *\n    43\t * @result 0 on success, -1 otherwise.\n    44\t */\n    45\tAPI_DEPRECATED(\"No longer supported\", macos(10.5, 10.8), ios(2.0, 6.0), tvos(4.0, 4.0), watchos(1.0, 1.0))\n    46\tAPI_UNAVAILABLE(macCatalyst)\n    47\t__result_use_check\n    48\tint sandbox_init(const char *profile, uint64_t flags, char **errorbuf);\n    49\t\n    50\t/*\n    51\t * @define SANDBOX_NAMED  The `profile' argument specifies a Sandbox\n    52\t * profile named by one of the kSBXProfile* string constants.\n    53\t */\n    54\t#define SANDBOX_NAMED\t\t0x0001\n    55\t\n    56\t/*\n    57\t * Available Sandbox profiles.\n    58\t */\n    59\t\n    60\t/* TCP/IP networking is prohibited. */\n    61\tAPI_DEPRECATED(\"No longer supported\", macos(10.5, 10.8), ios(2.0, 6.0), tvos(4.0, 4.0), watchos(1.0, 1.0))\n    62\tAPI_UNAVAILABLE(macCatalyst)\n    63\textern const char kSBXProfileNoInternet[];\n    64\t\n    65\t/* All sockets-based networking is prohibited. */\n    66\tAPI_DEPRECATED(\"No longer supported\", macos(10.5, 10.8), ios(2.0, 6.0), tvos(4.0, 4.0), watchos(1.0, 1.0))\n    67\tAPI_UNAVAILABLE(macCatalyst)\n    68\textern const char kSBXProfileNoNetwork[];\n    69\t\n    70\t/* File system writes are prohibited. */\n    71\tAPI_DEPRECATED(\"No longer supported\", macos(10.5, 10.8), ios(2.0, 6.0), tvos(4.0, 4.0), watchos(1.0, 1.0))\n    72\tAPI_UNAVAILABLE(macCatalyst)\n    73\textern const char kSBXProfileNoWrite[];\n    74\t\n    75\t/* File system writes are restricted to temporary folders /var/tmp and\n    76\t * confstr(_CS_DARWIN_USER_DIR, ...).\n    77\t */\n    78\tAPI_DEPRECATED(\"No longer supported\", macos(10.5, 10.8), ios(2.0, 6.0), tvos(4.0, 4.0), watchos(1.0, 1.0))\n    79\tAPI_UNAVAILABLE(macCatalyst)\n    80\textern const char kSBXProfileNoWriteExceptTemporary[];\n    81\t\n    82\t/* All operating system services are prohibited. */\n    83\tAPI_DEPRECATED(\"No longer supported\", macos(10.5, 10.8), ios(2.0, 6.0), tvos(4.0, 4.0), watchos(1.0, 1.0))\n    84\tAPI_UNAVAILABLE(macCatalyst)\n    85\textern const char kSBXProfilePureComputation[];\n    86\t\n    87\t/*\n    88\t * @function sandbox_free_error\n    89\t * Deallocates an error string previously allocated by sandbox_init.\n    90\t *\n    91\t * @param errorbuf (input)   The buffer to be freed.  Must be a pointer\n    92\t * previously returned by sandbox_init in the `errorbuf' argument, or NULL.\n    93\t *\n    94\t * @result void\n    95\t */\n    96\tAPI_DEPRECATED(\"No longer supported\", macos(10.5, 10.8), ios(2.0, 6.0), tvos(4.0, 4.0), watchos(1.0, 1.0))\n    97\tAPI_UNAVAILABLE(macCatalyst)\n    98\tvoid sandbox_free_error(char *errorbuf);\n    99\t\n   100\t__END_DECLS\n   101\t\n   102\t#endif /* _SANDBOX_H_ */\n","exit_code":0,"status":"completed"}}
