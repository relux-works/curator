": \"string\", \"pattern\": \"^[A-Za-z0-9+/]{86}==$\"}\n   172\t      },\n   173\t      \"additionalProperties\": false\n   174\t    },\n   175\t    \"canonicalValue\": {\n   176\t      \"oneOf\": [\n   177\t        {\"type\": \"null\"},\n   178\t        {\"type\": \"boolean\"},\n   179\t        {\"$ref\": \"#/$defs/safeInteger\"},\n   180\t        {\"type\": \"string\"},\n   181\t        {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/canonicalValue\"}},\n   182\t        {\"type\": \"object\", \"additionalProperties\": {\"$ref\": \"#/$defs/canonicalValue\"}}\n   183\t      ]\n   184\t    }\n   185\t  }\n","exit_code":0,"status":"completed"}}
