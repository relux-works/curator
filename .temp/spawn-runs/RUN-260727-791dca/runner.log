{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"nl -ba 'internal/godriver/host_policy.go' | sed -n '1,380p'\"","aggregated_output":"     1\tpackage godriver\n     2\t\n     3\timport (\n     4\t\t\"context\"\n     5\t\t\"errors\"\n     6\t\t\"fmt\"\n     7\t\t\"os\"\n     8\t\t\"path/filepath\"\n     9\t\t\"reflect\"\n    10\t\t\"strings\"\n    11\t)\n    12\t\n    13\t// HostExecution is the complete policy input for one direct Go child. The\n    14\t// policy owns OS isolation and process-resource enforcement; it must not add a\n    15\t// launcher, shell, helper, response file, or other executable.\n    16\ttype HostExecution struct {\n    17\t\tProcess            Process\n    18\t\tReadOnlyRoots      []string\n    19\t\tWritableRoots      []string\n    20\t\tAllowedExecutables []string\n    21\t\tNetworkDenied      bool\n    22\t\tLimits             ResourceLimits\n    23\t}\n    24\t\n    25\t// HostPolicy is the build-tagged platform isolation boundary. Implementations\n    26\t// execute Process.Executable directly and fail closed if a requested supported\n    27\t// control cannot be applied.\n    28\ttype HostPolicy interface {\n    29\t\tRun(context.Context, HostExecution) (Output, error)\n    30\t}\n    31\t\n    32\ttype guardedHostPolicy struct{ executor Executor }\n    33\t\n    34\t// NewHostPolicy returns the native direct-execution adapter. Passing nil uses\n    35\t// OSExecutor. The adapter verifies the closed environment, read-only source,\n    36\t// private writable roots, executable graph roots, and bounded request before\n    37\t// every direct child.\n    38\tfunc NewHostPolicy(executor Executor) HostPolicy {\n    39\t\tif executor == nil {\n    40\t\t\texecutor = OSExecutor{}\n    41\t\t}\n    42\t\treturn guardedHostPolicy{executor: executor}\n    43\t}\n    44\t\n    45\tfunc (policy guardedHostPolicy) Run(ctx context.Context, execution HostExecution) (Output, error) {\n    46\t\tif err := validateHostExecution(execution); err != nil {\n    47\t\t\treturn Output{}, err\n    48\t\t}\n    49\t\tif err := platformValidateHostExecution(execution); err != nil {\n    50\t\t\treturn Output{}, err\n    51\t\t}\n    52\t\treturn policy.executor.Run(ctx, execution.Process)\n    53\t}\n    54\t\n    55\tfunc validateHostExecution(execution HostExecution) error {\n    56\t\tprocess := execution.Process\n    57\t\tif len(execution.ReadOnlyRoots) != 2 || len(execution.WritableRoots) == 0 || len(execution.AllowedExecutables) != 2 || !execution.NetworkDenied {\n    58\t\t\treturn diagnostic(\"host_policy_invalid\", \"go-v1 isolation roots, executable graph, and network denial must be explicit\")\n    59\t\t}\n    60\t\tif process.Executable == \"\" || process.Executable != execution.AllowedExecutables[0] || !filepath.IsAbs(process.Executable) {\n    61\t\t\treturn diagnostic(\"unexpected_child_process\", \"direct executable is not the fingerprinted Go launcher\")\n    62\t\t}\n    63\t\tif !filepath.IsAbs(process.Directory) || process.Directory == execution.ReadOnlyRoots[0] || !strictlyBelow(process.Directory, execution.ReadOnlyRoots[0]) {\n    64\t\t\treturn diagnostic(\"host_policy_invalid\", \"Go child cwd is not the canonical source directory\")\n    65\t\t}\n    66\t\tif process.Timeout != execution.Limits.Timeout || process.OutputLimit != execution.Limits.OutputBytes {\n    67\t\t\treturn diagnostic(\"host_policy_invalid\", \"process bounds differ from the normalized host policy limits\")\n    68\t\t}\n    69\t\tif err := validateBuildEnvironment(process.Environment, execution); err != nil {\n    70\t\t\treturn err\n    71\t\t}\n    72\t\tfor _, root := range execution.ReadOnlyRoots {\n    73\t\t\tif !filepath.IsAbs(root) {\n    74\t\t\t\treturn diagnostic(\"host_policy_invalid\", \"read-only roots must be absolute\")\n    75\t\t\t}\n    76\t\t}\n    77\t\tfor _, root := range execution.WritableRoots {\n    78\t\t\tif !filepath.IsAbs(root) || root == execution.ReadOnlyRoots[0] || root == execution.ReadOnlyRoots[1] || isWithin(root, execution.ReadOnlyRoots[0]) || isWithin(root, execution.ReadOnlyRoots[1]) {\n    79\t\t\t\treturn diagnostic(\"host_policy_invalid\", \"writable root overlaps source or toolchain\")\n    80\t\t\t}\n    81\t\t}\n    82\t\ttoolDir := execution.AllowedExecutables[1]\n    83\t\tif !filepath.IsAbs(toolDir) || !strictlyBelow(toolDir, execution.ReadOnlyRoots[1]) {\n    84\t\t\treturn diagnostic(\"unexpected_child_process\", \"allowed Go tool directory escapes fingerprinted GOROOT\")\n    85\t\t}\n    86\t\tif err := verifyReadOnlyTree(execution.ReadOnlyRoots[0]); err != nil {\n    87\t\t\treturn diagnosticErr(\"source_not_readonly\", err, \"frozen source is writable by build children\")\n    88\t\t}\n    89\t\tif err := validateFixedBuildArguments(process.Arguments, execution.WritableRoots); err != nil {\n    90\t\t\treturn err\n    91\t\t}\n    92\t\treturn nil\n    93\t}\n    94\t\n    95\tfunc validateBuildEnvironment(environment []string, execution HostExecution) error {\n    96\t\tvalues := make(map[string]string, len(environment))\n    97\t\tfor _, item := range environment {\n    98\t\t\tkey, value, present := strings.Cut(item, \"=\")\n    99\t\t\tif !present || key == \"\" {\n   100\t\t\t\treturn diagnostic(\"process_environment_poisoned\", \"build environment contains a malformed entry\")\n   101\t\t\t}\n   102\t\t\tif _, duplicate := values[key]; duplicate {\n   103\t\t\t\treturn diagnostic(\"process_environment_poisoned\", \"build environment repeats %s\", key)\n   104\t\t\t}\n   105\t\t\tvalues[key] = value\n   106\t\t}\n   107\t\trequired := map[string]string{\n   108\t\t\t\"GOENV\": \"off\", \"GOTOOLCHAIN\": \"local\", \"LC_ALL\": \"C\", \"LANG\": \"C\",\n   109\t\t\t\"GO111MODULE\": \"on\", \"GOFLAGS\": \"\", \"GOPROXY\": \"off\", \"GOSUMDB\": \"off\", \"GOPRIVATE\": \"\",\n   110\t\t\t\"GONOPROXY\": \"none\", \"GONOSUMDB\": \"none\", \"GOVCS\": \"*:off\", \"GOWORK\": \"off\",\n   