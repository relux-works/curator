\t  bootstrap [flags]         create the machine configuration\n    50\t  init [path]              create Skillfile.json and the managed gitignore block\n    51\t  add <name> ...           add or replace a skill declaration, then install\n    52\t  remove <name>            remove a skill declaration\n    53\t  install [path] [flags]   apply Skillfile.json (see install -h)\n    54\t  update                   fetch all source repositories under skills_root\n    55\t  upgrade [path]           fetch the selected dependency closure, then install\n    56\t  status [path] [flags]    manifest vs installed state (--check, --json, --attest)\n    57\t  list                     configured projects and declared skills\n    58\t  project <subcommand>     add | resolve\n    59\t  skill check <dir>        validate one skill package (--locale, --json)\n    60\t  global <subcommand>      init | add | remove | list | status | install | update | upgrade\n    61\t  hybrid <subcommand>      add | remove | list | status\n    62\t  audit [target] [flags]   run audit, pin trust, or publish a signed record\n    63\t  gc                       remove unreferenced runtime entries\n    64\t  shell-init [shell]       print or cache an optional hook (auto, zsh, bash, powershell)\n    65\t  ui                       terminal view over installed state\n    66\t  config show              print the effective configuration\n    67\t  --version                print the curator version\n    68\t`\n    69\t\n    70\tfunc main() {\n    71\t\tos.Exit(run(os.Args[1:]))\n    72\t}\n    73\t\n    74\tfunc run(args []string) int {\n    75\t\tif len(args) == 0 {\n    76\t\t\tfmt.Fprint(os.Stderr, usage)\n    77\t\t\treturn exitUsage\n    78\t\t}\n    79\t\tswitch args[0] {\n    80\t\tcase \"--version\", \"version\":\n    81\t\t\tfmt.Println(\"curator \" + version.String())\n    82\t\t\treturn exitOK\n    83\t\tcase \"init\":\n    84\t\t\treturn cmdInit(args[1:])\n    85\t\tcase \"bootstrap\":\n    86\t\t\treturn cmdBootstrap(args[1:])\n    87\t\tcase \"add\":\n    88\t\t\treturn cmdAdd(args[1:])\n    89\t\tcase \"remove\":\n    90\t\t\treturn cmdRemove(args[1:])\n    91\t\tcase \"install\":\n    92\t\t\treturn cmdInstall(args[1:])\n    93\t\tcase \"update\":\n    94\t\t\treturn cmdUpdate()\n    95\t\tcase \"upgrade\":\n    96\t\t\treturn cmdInstallMode(args[1:], true)\n    97\t\tcase \"status\":\n    98\t\t\treturn cmdStatus(args[1:])\n    99\t\tcase \"list\":\n   100\t\t\treturn cmdList()\n   101\t\tcase \"project\":\n   102\t\t\treturn cmdProject(args[1:])\n   103\t\tcase \"skill\":\n   104\t\t\tif len(args) >= 2 && args[1] == \"check\" {\n   105\t\t\t\treturn cmdSkillCheck(args[2:])\n   106\t\t\t}\n   107\t\tcase \"global\":\n   108\t\t\treturn cmdGlobal(args[1:])\n   109\t\tcase \"hybrid\":\n   110\t\t\treturn cmdHybrid(args[1:])\n   111\t\tcase \"audit\":\n   112\t\t\treturn cmdAudit(args[1:])\n   113\t\tcase \"gc\":\n   114\t\t\treturn cmdGC()\n   115\t\tcase \"shell-init\":\n   116\t\t\treturn cmdShellInit(args[1:])\n   117\t\tcase \"ui\":\n   118\t\t\treturn cmdUI()\n   119\t\tcase \"config\":\n   120\t\t\tif len(args) >= 2 && args[1] == \"show\" {\n   121\t\t\t\treturn cmdConfigShow()\n   122\t\t\t}\n   123\t\tcase \"-h\", \"--help\", \"help\":\n   124\t\t\tfmt.Print(usage)\n   125\t\t\treturn exitOK\n   126\t\t}\n   127\t\tfmt.Fprintf(os.Stderr, \"curator: unknown command %q\\n\\n%s\", args[0], usage)\n   128\t\treturn exitUsage\n   129\t}\n   130\t\n   131\tfunc loadConfig() (*config.Config, int) {\n   132\t\tcfg, err := config.Load(\"\", func(message string) {\n   133\t\t\tfmt.Fprintln(os.Stderr, \"warning: \"+message)\n   134\t\t})\n   135\t\tif err != nil {\n   136\t\t\tfmt.Fprintln(os.Stderr, \"curator:\", err)\n   137\t\t\treturn nil, exitFail\n   138\t\t}\n   139\t\treturn cfg, exitOK\n   140\t}\n   141\t\n   142\tfunc projectRootArg(args []string) string {\n   143\t\tfor _, arg := range args {\n   144\t\t\tif !strings.HasPrefix(arg, \"-\") {\n   145\t\t\t\tif abs, err := filepath.Abs(arg); err == nil {\n   146\t\t\t\t\treturn abs\n   147\t\t\t\t}\n   148\t\t\t\treturn arg\n   149\t\t\t}\n   150\t\t}\n   151\t\twd, err := os.Getwd()\n   152\t\tif err != nil {\n   153\t\t\treturn \".\"\n   154\t\t}\n   155\t\treturn wd\n   156\t}\n   157\t\n   158\t// parseInterspersed lets commands accept flags before or after positional\n   159\t// arguments. The standard flag package stops at the first positional token,\n   160\t// while the informative CLI surface documents forms such as\n   161\t// `install <path> --dry-run` and `add <name> --tag <ref>` (Spec §15).\n   162\tfunc parseInterspersed(flags *flag.FlagSet, args []string) ([]string, error) {\n   163\t\tvar flagArgs, positional []string\n   164\t\tfor index := 0; index < len(args); index++ {\n   165\t\t\targ := args[index]\n   166\t\t\tif arg == \"--\" {\n   167\t\t\t\tfor trailing := index + 1; trailing < len(args); trailing++ {\n   168\t\t\t\t\tpositional = append(positional, args[trailing])\n   169\t\t\t\t}\n   170\t\t\t\tbreak\n   171\t\t\t}\n   172\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n   173\t\t\t\tpositional = append(positional, arg)\n   174\t\t\t\tcontinue\n   175\t\t\t}\n   176\t\n   177\t\t\tflagArgs = append(flagArgs, arg)\n   178\t\t\tnameValue := strings.TrimLeft(arg, \"-\")\n   179\t\t\tname, _, hasEquals := strings.Cut(nameValue, \"=\")\n   180\t\t\tdefinition := flags.Lookup(name)\n   181\t\t\tif definition == nil || hasEquals {\n   182\t\t\t\tcontinue\n   183\t\t\t}\n   184\t\t\tif optional, ok := definition.Value.(interface{ AcceptsOptionalValue(string) bool }); ok &&\n   185\t\t\t\tindex+1 < len(args) && optional.AcceptsOptionalValue(args[index+1]) {\n   186\t\t\t\tindex++\n   187\t\t\t\tflagArgs[len(flagArgs)-1] = arg + \"=\" + args[index]\n   188\t\t\t\tcontinue\n   189\t\t\t}\n   190\t\t\tboolean, isBoolean := definition.Value.(interface{ IsBoolFlag() bool })\n   191\t\t\tif isBoolean && boolean.IsBoolFlag() {\n   192\t\t\t\tcontinue\n   193\t\t\t}\n   194\t\t\tif index+1 >= len(args) {\n   195\t\t\t\treturn nil, fmt.Errorf(\"flag needs an argument: %s\", arg)\n   196\t\t\t}\n   197\t\t\tindex++\n   198\t\t\tflagArgs = append(flagArgs, args[index])\n   199\t\t}\n   200\t\tif err := flags.Parse(flagArgs); err != nil {\n   201\t\t\treturn nil, err\n   202\t\t}\n   203\t\treturn positional, nil\n   204\t}\n   205\t\n   206\ttype auditModeValue struct {\n   207\t\tvalue string\n   208\t}\n   209\t\n   210\tfunc (value *auditModeValue) String() string { return value.value }\n   211\t\n   212\tfunc (value *auditModeValue) Set(raw string) error {\n   213\t\tif raw == \"true\" {\n   214\t\t\traw = \"advisory\"\n   215\t\t}\n   216\t\tif raw != \"advisory\" && raw != \"strict\" {\n   217\t\t\treturn fmt.Errorf(\"audit mode must be advisory or strict\")\n   218\t\t}\n   219\t\tvalue.value = raw\n   220\t\treturn nil\n   221\t}\n   222\t\n   223\tfunc (*auditModeValue) IsBoolFlag() bool { return true }\n   224\t\n   225\tfunc (*auditModeValue) AcceptsOptionalValue(raw string) bool {\n   226\t\treturn raw == \"advisory\" || raw == \"strict\"\n   227\t}\n   228\t\n   229\tfunc aliasFor(cfg *config.Config, projectRoot string) string {\n   230\t\tfor alias, project := range cfg.Projects {\n   231\t\t\tif project.Path == projectRoot {\n   232\t\t\t\treturn alias\n   233\t\t\t}\n   234\t\t}\n   235\t\treturn filepath.Base(projectRoot)\n   236\t}\n   237\t\n   238\ttype projectTarget struct {\n   239\t\tAlias string\n   240\t\tRoot  string\n   241\t}\n   242\t\n   243\tfunc selectProjectTargets(cfg *config.Config, positional []string, all bool) ([]projectTarget, error) {\n   244\t\tif all {\n   245\t\t\tif len(positional) > 0 {\n   246\t\t\t\treturn nil, fmt.Errorf(\"--all cannot be combined with a project target\")\n   247\t\t\t}\n   248\t\t\taliases := make([]string, 0, len(cfg.Projects))\n   249\t\t\tfor alias := range cfg.Projects {\n   250\t\t\t\taliases = append(aliases, alias)\n   251\t\t\t}\n   252\t\t\tsort.Strings(aliases)\n   253\t\t\ttargets := make([]projectTarget, 0, len(aliases))\n   254\t\t\tfor _, alias := range aliases {\n   255\t\t\t\ttargets = append(targets, projectTarget{Alias: alias, Root: cfg.Projects[alias].Path})\n   256\t\t\t}\n   257\t\t\tif len(targets) == 0 {\n   258\t\t\t\treturn nil, fmt.Errorf(\"--all requested but no projects are configured\")\n   259\t\t\t}\n   260\t\t\treturn targets, nil\n   261\t\t}\n   262\t\tif len(positional) > 1 {\n   263\t\t\treturn nil, fmt.Errorf(\"expected at most one project target\")\n   264\t\t}\n   265\t\tif len(positional) == 1 {\n   266\t\t\tif project, present := cfg.Projects[positional[0]]; present {\n   267\t\t\t\treturn []projectTarget{{Alias: positional[0], Root: project.Path}}, nil\n   268\t\t\t}\n   269\t\t}\n   270\t\troot := projectRootArg(positional)\n   271\t\troot = nearestProjectRoot(root)\n   272\t\treturn []projectTarget{{Alias: aliasFor(cfg, root), Root: root}}, nil\n   273\t}\n   274\t\n   275\tfunc nearestProjectRoot(start string) string {\n   276\t\toriginal := projectRootArg([]string{start})\n   277\t\troot := original\n   278\t\tif info, err := os.Stat(root); err == nil && !info.IsDir() {\n   279\t\t\troot = filepath.Dir(root)\n   280\t\t}\n   281\t\tfor {\n   282\t\t\tif _, err := os.Stat(filepath.Join(root, manifest.Name)); err == nil {\n   283\t\t\t\treturn root\n   284\t\t\t}\n   285\t\t\tparent := filepath.Dir(root)\n   286\t\t\tif parent == root {\n   287\t\t\t\treturn original\n   288\t\t\t}\n   289\t\t\troot = parent\n   290\t\t}\n   291\t}\n   292\t\n   293\tfunc cmdBootstrap(args []string) int {\n   294\t\tflags := flag.NewFlagSet(\"bootstrap\", flag.ContinueOnError)\n   295\t\tskillsRoot := flags.String(\"skills-root\", \"\", \"directory containing skill repositories\")\n   296\t\tpreferredLocale := flags.String(\"preferred-locale\", \"\", \"preferred locale\")\n   297\t\tdefaultAgents := flags.String(\"default-agents\", \"codex_cli\", \"comma-separated default agents\")\n   298\t\tforce := flags.Bool(\"force\", false, \"overwrite an existing configuration\")\n   299\t\tifMissing := flags.Bool(\"if-missing\", false, \"create configuration only when absent\")\n   300\t\tnonInteractive := flags.Bool(\"non-interactive\", false, \"fail instead of prompting for missing values\")\n   301\t\tpositional, err := parseInterspersed(flags, args)\n   302\t\tif err != nil || len(positional) > 0 {\n   303\t\t\treturn exitUsage\n   304\t\t}\n   305\t\tif *force && *ifMissing {\n   306\t\t\tfmt.Fprintln(os.Stderr, \"curator: bootstrap --if-missing and --force are mutually exclusive\")\n   307\t\t\treturn exitUsage\n   308\t\t}\n   309\t\tpath := config.UserPath()\n   310\t\tif *ifMissing {\n   311\t\t\tif _, statErr := os.Stat(path); statErr == nil {\n   312\t\t\t\tfmt.Println(\"kept existing config:\", path)\n   313\t\t\t\treturn exitOK\n   314\t\t\t} else if !os.IsNotExist(statErr) {\n   315\t\t\t\tfmt.Fprintln(os.Stderr, \"curator:\", statErr)\n   316\t\t\t\treturn exitFail\n   317\t\t\t}\n   318\t\t}\n   319\t\tif *skillsRoot == \"\" && !*nonInteractive {\n   320\t\t\tfmt.Fprint(os.Stderr, \"skills_root: \")\n   321\t\t\treader := bufio.NewReader(os.Stdin)\n   322\t\t\tvalue, readErr := reader.ReadString('\\n')\n   323\t\t\tif readErr == nil {\n   324\t\t\t\t*skillsRoot = strings.TrimSpace(value)\n   325\t\t\t}\n   326\t\t}\n   327\t\tif *skillsRoot == \"\" {\n   328\t\t\tfmt.Fprintln(os.Stderr, \"curator: bootstrap requires --skills-root\")\n   329\t\t\treturn exitUsage\n   330\t\t}\n   331\t\tif err := config.Bootstrap(path, *skillsRoot, *preferredLocale, splitNonEmpty(*defaultAgents), *force); err != nil {\n   332\t\t\tfmt.Fprintln(os.Stderr, \"curator:\", err)\n   333\t\t\treturn exitFail\n   334\t\t}\n   335\t\tfmt.Println(\"wrote\", path)\n   336\t\tfmt.Println(\"shell profile changes are not required: agent skills can invoke project and global command shims directly\")\n   337\t\tfmt.Println(\"optional bare commands for interactive use: curator shell-init --install\")\n   338\t\treturn exitOK\n   339\t}\n   340\t\n   341\tfunc splitNonEmpty(value string) []string {\n   342\t\tvar result []string\n   343\t\tfor _, item := range strings.Split(value, \",\") {\n   344\t\t\tif trimmed := strings.TrimSpace(item); trimmed != \"\" {\n   345\t\t\t\tresult = append(result, trimmed)\n   346\t\t\t}\n   347\t\t}\n   348\t\treturn result\n   349\t}\n   350\t\n   351\tfunc cmdInit(args []string) int {\n   352\t\troot := projectRootArg(args)\n   353\t\tpath, err := manifest.EnsureEmpty(root)\n   354\t\tif err != nil {\n   355\t\t\tfmt.Fprintln(os.Stderr, \"curator:\", err)\n   356\t\t\treturn exitFail\n   357\t\t}\n   358\t\tentries := adapters.RequiredGitignoreEntries(sortedKnownAgents())\n   359\t\tentries = append(entries, \"Skillfile.dev.json\")\n   360\t\tif err := gitignore.Append(filepath.Join(root, \".gitignore\"), entries); err != nil {\n   361\t\t\tfmt.Fprintln(os.Stderr, \"curator:\", err)\n   362\t\t\treturn exitFail\n   363\t\t}\n   364\t\tfmt.Println(\"initialized\", path)\n   365\t\treturn exitOK\n   366\t}\n   367\t\n   368\tfunc sortedKnownAgents() []string {\n   369\t\tknown := adapters.KnownAgents()\n   370\t\tvar agents []string\n   371\t\tfor agent := range known {\n   372\t\t\tagents = append(agents, agent)\n   373\t\t}\n   374\t\tsort.Strings(agents)\n   375\t\treturn agents\n   376\t}\n   377\t\n   378\tfunc cmdAdd(args []string) int {\n   379\t\tflags := flag.NewFlagSet(\"add\", flag.ContinueOnError)\n   380\t\tgit := flags.String(\"git\", \"\", \"git clone URL\")\n","exit_code":0,"status":"completed"}}
