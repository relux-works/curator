diskErr != nil {\n   161\t\t\t\trunErr = errors.Join(runErr, diskErr)\n   162\t\t\t}\n   163\t\t\treturn output, runErr\n   164\t\t}\n   165\t\n   166\t\tlistOutput, err := run(listArguments)\n   167\t\tif err != nil {\n   168\t\t\treturn Artifact{}, classifyListFailure(err, listOutput.Stderr)\n   169\t\t}\n   170\t\tif err := validatePackageGraph(listOutput.Stdout, graphValidation{\n   171\t\t\tBuildRoot: buildRoot, SourceDir: sourceDir, GOROOT: request.Session.GOROOT(),\n   172\t\t}); err != nil {\n   173\t\t\treturn Artifact{}, err\n   174\t\t}\n   175\t\n   176\t\tbuildArguments := []string{\n   177\t\t\t\"build\", \"-mod=vendor\", \"-trimpath\", \"-buildvcs=false\", \"-buildmode=exe\", \"-compiler=gc\", \"-pgo=off\",\n   178\t\t\t\"-ldflags=-linkmode=internal -libgcc=none\", \"-o\", artifactPath, \".\",\n   179\t\t}\n   180\t\tbuildOutput, err := run(buildArguments)\n   181\t\tif err != nil {\n   182\t\t\treturn Artifact{}, classifyBuildFailure(err, buildOutput.Stderr)\n   183\t\t}\n   184\t\tmetadata, err := verifyArtifact(stage, artifactPath, artifactRel, limits.ArtifactBytes)\n   185\t\tif err != nil {\n   186\t\t\treturn Artifact{}, err\n   187\t\t}\n   188\t\tif err := request.Source.Recheck(); err != nil {\n   189\t\t\treturn Artifact{}, diagnosticErr(\"source_mutated\", err, \"frozen source changed before artifact acceptance\")\n   190\t\t}\n   191\t\tif err := request.Session.VerifyToolchain(ctx); err != nil {\n   192\t\t\treturn Artifact{}, err\n   193\t\t}\n   194\t\treturn Artifact{StagedPath: artifactPath, Metadata: metadata}, nil\n   195\t}\n   196\t\n   197\tfunc normalizeBuildLimits(limits ResourceLimits) (ResourceLimits, error) {\n   198\t\tif limits.Timeout == 0 {\n   199\t\t\tlimits.Timeout = defaultBuildTimeout\n   200\t\t}\n   201\t\tif limits.OutputBytes == 0 {\n   202\t\t\tlimits.OutputBytes = defaultBuildOutput\n   203\t\t}\n   204\t\tif limits.ArtifactBytes == 0 {\n   205\t\t\tlimits.ArtifactBytes = defaultArtifactLimit\n   206\t\t}\n   207\t\tif limits.DiskBytes == 0 {\n   208\t\t\tlimits.DiskBytes = defaultDiskLimit\n   209\t\t}\n   210\t\tif limits.MemoryBytes == 0 {\n   211\t\t\tlimits.MemoryBytes = defaultMemoryLimit\n   212\t\t}\n   213\t\tif limits.Processes == 0 {\n   214\t\t\tlimits.Processes = defaultProcessLimit\n   215\t\t}\n   216\t\tif limits.Timeout < time.Millisecond || limits.Timeout > defaultBuildTimeout || limits.OutputBytes < 1 || limits.OutputBytes > defaultBuildOutput ||\n   217\t\t\tlimits.ArtifactBytes < 1 || limits.ArtifactBytes > defaultArtifactLimit || limits.DiskBytes < limits.ArtifactBytes || limits.DiskBytes > defaultDiskLimit ||\n   218\t\t\tlimits.MemoryBytes < 1 || limits.MemoryBytes > defaultMemoryLimit || limits.Processes < 1 || limits.Processes > defaultProcessLimit {\n   219\t\t\treturn ResourceLimits{}, diagnostic(\"invalid_resource_limits\", \"go-v1 limits are outside manager bounds\")\n   220\t\t}\n   221\t\treturn limits, nil\n   222\t}\n   223\t\n   224\tfunc canonicalBuildDirectories(snapshot, buildRootRel, sourceDirRel string) (string, string, string, error) {\n   225\t\tphysicalSnapshot, err := filepath.EvalSymlinks(snapshot)\n   226\t\tif err != nil {\n   227\t\t\treturn \"\", \"\", \"\", diagnosticErr(\"invalid_build_request\", err, \"cannot resolve frozen source root\")\n   228\t\t}\n   229\t\tbuildRoot := filepath.Join(physicalSnapshot, filepath.FromSlash(buildRootRel))\n   230\t\tsourceDir := filepath.Join(physicalSnapshot, filepath.FromSlash(sourceDirRel))\n   231\t\tfor _, item := range []struct{ path, label string }{{buildRoot, \"build root\"}, {sourceDir, \"source directory\"}} {\n   232\t\t\tinfo, err := os.Lstat(item.path)\n   233\t\t\tif err != nil || !info.IsDir() || info.Mode()&fs.ModeSymlink != 0 {\n   234\t\t\t\treturn \"\", \"\", \"\", diagnosticErr(\"invalid_build_request\", err, \"%s is not a real directory\", item.label)\n   235\t\t\t}\n   236\t\t\tphysical, err := filepath.EvalSymlinks(item.path)\n   237\t\t\tif err != nil || physical != item.path {\n   238\t\t\t\treturn \"\", \"\", \"\", diagnosticErr(\"invalid_build_request\", err, \"%s is not canonical and link-free\", item.label)\n   239\t\t\t}\n   240\t\t}\n   241\t\tgoMod := filepath.Join(buildRoot, \"go.mod\")\n   242\t\tinfo, err := os.Lstat(goMod)\n   243\t\tif err != nil || !info.Mode().IsRegular() {\n   244\t\t\treturn \"\", \"\", \"\", diagnosticErr(\"build_module_missing\", err, \"build root lacks a regular go.mod\")\n   245\t\t}\n   246\t\tif err := rejectWorkspaceAndToolchainDirectives(buildRoot, goMod); err != nil {\n   247\t\t\treturn \"\", \"\", \"\", err\n   248\t\t}\n   249\t\treturn physicalSnapshot, buildRoot, sourceDir, nil\n   250\t}\n   251\t\n   252\tfunc rejectWorkspaceAndToolchainDirectives(buildRoot, goMod string) error {\n   253\t\tvar workspace string\n   254\t\terr := filepath.WalkDir(buildRoot, func(path string, entry fs.DirEntry, walkErr error) error {\n   255\t\t\tif walkErr != nil {\n   256\t\t\t\treturn walkErr\n   257\t\t\t}\n   258\t\t\tif entry.Name() == \"go.work\" {\n   259\t\t\t\tworkspace = path\n   260\t\t\t\treturn fs.SkipAll\n   261\t\t\t}\n   262\t\t\treturn nil\n   263\t\t})\n   264\t\tif err != nil {\n   265\t\t\treturn diagnosticErr(\"workspace_dependency_forbidden\", err, \"cannot prove workspace exclusion\")\n   266\t\t}\n   267\t\tif workspace != \"\" {\n   268\t\t\treturn diagnostic(\"workspace_dependency_forbidden\", \"build root contains forbidden workspace file %q\", workspace)\n   269\t\t}\n   270\t\tpayload, err := os.ReadFile(goMod) // #nosec G304 -- direct go.mod below validated build root\n   271\t\tif err != nil {\n   272\t\t\treturn diagnosticErr(\"build_module_missing\", err, \"cannot inspect build root go.mod\")\n   273\t\t}\n   274\t\tfor _, line := range bytes.Split(payload, []byte{'\\n'}) {\n   275\t\t\tfields := bytes.Fields(line)\n   276\t\t\tif len(fields) != 0 && bytes.Equal(fields[0], []byte(\"toolchain\")) {\n   277\t\t\t\treturn diagnostic(\"toolchain_switch_forbidden\", \"build root go.mod contains a package-selected toolchain directive\")\n   278\t\t\t}\n   279\t\t}\n   280\t\treturn nil\n   281\t}\n   282\t\n   283\tfunc privateWritableRoots(environment []string, stage string) []string {\n   284\t\tvalues := environmentMap(environment)\n   285\t\tkeys := []string{\"GOPATH\", \"GOMODCACHE\", \"GOCACHE\", \"GOTMPDIR\", \"HOME\", \"XDG_CONFIG_HOME\", \"TMPDIR\", \"APPDATA\", \"LOCALAPPDATA\", \"USERPROFILE\", \"TEMP\", \"TMP\"}\n   286\t\tresult := make([]string, 0, len(keys)+1)\n   287\t\tseen := map[string]bool{}\n   288\t\tfor _, key := range keys {\n   289\t\t\tif value := values[key]; value != \"\" && !seen[value] {\n   290\t\t\t\tseen[value] = true\n   291\t\t\t\tresult = append(result, value)\n   292\t\t\t}\n   293\t\t}\n   294\t\treturn append(result, stage)\n   295\t}\n   296\t\n   297\tfunc verifyOperationDisk(root, staging string, limit int64) error {\n   298\t\tvar total int64\n   299\t\terr := filepath.WalkDir(root, func(path string, entry fs.DirEntry, walkErr error) error {\n   300\t\t\tif walkErr != nil {\n   301\t\t\t\treturn walkErr\n   302\t\t\t}\n   303\t\t\tinfo, err := os.Lstat(path)\n   304\t\t\tif err != nil {\n   305\t\t\t\treturn err\n   306\t\t\t}\n   307\t\t\tswitch {\n   308\t\t\tcase info.IsDir():\n   309\t\t\t\treturn nil\n   310\t\t\tcase info.Mode().IsRegular():\n   311\t\t\t\tif info.Size() > limit-total {\n   312\t\t\t\t\treturn diagnostic(\"process_disk_limit\", \"Go private state exceeded its disk bound\")\n   313\t\t\t\t}\n   314\t\t\t\ttotal += info.Size()\n   315\t\t\t\treturn nil\n   316\t\t\tdefault:\n   317\t\t\t\tif isWithin(path, staging) {\n   318\t\t\t\t\treturn nil\n   319\t\t\t\t}\n   320\t\t\t\treturn diagnostic(\"private_build_special_file\", \"Go created a link or special file in private state\")\n   321\t\t\t}\n   322\t\t})\n   323\t\tif err != nil {\n   324\t\t\tif DiagnosticCode(err) != \"\" {\n   325\t\t\t\treturn err\n   326\t\t\t}\n   327\t\t\treturn diagnosticErr(\"private_build_unreadable\", err, \"cannot inspect private Go state\")\n   328\t\t}\n   329\t\treturn nil\n   330\t}\n   331\t\n   332\tfunc verifyArtifact(stage, artifactPath, artifactRel string, limit int64) (buildmeta.Artifact, error) {\n   333\t\tentries, err := os.ReadDir(stage)\n   334\t\tif err != nil || len(entries) != 1 || entries[0].Name() != \"bin\" || !entries[0].IsDir() {\n   335\t\t\treturn buildmeta.Artifact{}, diagnosticErr(\"artifact_output_invalid\", err, \"build staging contains an unexpected output\")\n   336\t\t}\n   337\t\tbinEntries, err := os.ReadDir(filepath.Join(stage, \"bin\"))\n   338\t\tif err != nil || len(binEntries) != 1 || filepath.Join(stage, \"bin\", binEntries[0].Name()) != artifactPath {\n   339\t\t\treturn buildmeta.Artifact{}, diagnosticErr(\"artifact_output_invalid\", err, \"build did not produce exactly one derived output\")\n   340\t\t}\n   341\t\tinfo, err := os.Lstat(artifactPath)\n   342\t\tif err != nil || !info.Mode().IsRegular() || info.Mode()&fs.ModeSymlink != 0 {\n   343\t\t\treturn buildmeta.Artifact{}, diagnosticErr(\"artifact_special_file\", err, \"staged output is not a regular file\")\n   344\t\t}\n   345\t\tif info.Size() < 0 || info.Size() > limit {\n   346\t\t\treturn buildmeta.Artifact{}, diagnostic(\"artifact_size_limit\", \"staged output exceeds its artifact bound\")\n   347\t\t}\n   348\t\tif err := applyArtifactPermissions(artifactPath); err != nil {\n   349\t\t\treturn buildmeta.Artifact{}, diagnosticErr(\"artifact_permissions_failed\", err, \"cannot apply manager artifact permissions\")\n   350\t\t}\n   351\t\tpermissioned, err := os.Lstat(artifactPath)\n   352\t\tif err != nil || !permissioned.Mode().IsRegular() || !os.SameFile(info, permissioned) || permissioned.Size() != info.Size() {\n   353\t\t\treturn buildmeta.Artifact{}, diagnosticErr(\"artifact_mutated\", err, \"staged output changed while applying permissions\")\n   354\t\t}\n   355\t\tmultiple, err := artifactHasMultipleLinks(artifactPath, permissioned)\n   356\t\tif err != nil {\n   357\t\t\treturn buildmeta.Artifact{}, diagnosticErr(\"artifact_unreadable\", err, \"cannot inspect staged output link count\")\n   358\t\t}\n   359\t\tif multiple {\n   360\t\t\treturn buildmeta.Artifact{}, diagnostic(\"artifact_link\", \"staged output has multiple filesystem links\")\n   361\t\t}\n   362\t\tfile, err := os.Open(artifactPath) // #nosec G304 -- path is manager-derived inside private staging\n   363\t\tif err != nil {\n   364\t\t\treturn buildmeta.Artifact{}, diagnosticErr(\"artifact_unreadable\", err, \"cannot open staged output\")\n   365\t\t}\n   366\t\tdefer file.Close()\n   367\t\topened, err := file.Stat()\n   368\t\tif err != nil || !opened.Mode().IsRegular() || !os.SameFile(info, opened) {\n   369\t\t\treturn buildmeta.Artifact{}, diagnosticErr(\"artifact_special_file\", err, \"staged output changed while opening\")\n   370\t\t}\n   371\t\tdigest := sha256.New()\n   372\t\twritten, copyErr := io.CopyN(digest, file, opened.Size())\n   373\t\tvar extra [1]byte\n   374\t\textraCount, extraErr := file.Read(extra[:])\n   375\t\tif copyErr != nil || written != opened.Size() || extraCount != 0 || (extraErr != nil && extraErr != io.EOF) {\n   376\t\t\treturn buildmeta.Artifact{}, diagnosticErr(\"artifact_mutated\", errors.Join(copyErr, extraErr), \"staged output changed while hashing\")\n   377\t\t}\n   378\t\tafter, err := os.Lstat(artifactPath)\n   379\t\tif err != nil || !after.Mode().IsRegular() || !os.SameFile(info, after) || after.Size() != opened.Size() {\n   380\t\t\treturn buildmeta.Artifact{}, diagnosticErr(\"artifact_mutated\", err, \"staged output changed during verification\")\n","exit_code":0,"status":"completed"}}
