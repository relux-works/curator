class GoV1Error(RuntimeError):
    """Stable, machine-testable failure at the source-aware Go boundary."""

    def __init__(self, code: str, detail: str):
        self.code = code
        self.detail = detail
        super().__init__(f"go-v1 {code}: {detail}")


