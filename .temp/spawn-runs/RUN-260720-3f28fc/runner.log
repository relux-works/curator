package main

import (
	"crypto/sha256"
	"encoding/binary"
	"fmt"
	"hash"
	"io/fs"
	"os"
	"path/filepath"
	"sort"
	"unicode/utf8"
)

type entry struct {
	kind    byte
	path    string
	payload string
}

func framed(h hash.Hash, kind byte, path, payload string) {
	h.Write([]byte{kind})
	_ = binary.Write(h, binary.BigEndian, uint64(len(path)))
	h.Write([]byte(path))
	_ = binary.Write(h, binary.BigEndian, uint64(len(payload)))
	h.Write([]byte(payload))
}

func buildSource(root string) (string, error) {
	var paths []string
	err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
		if err != nil {
			return err
		}
		if path == root || entry.IsDir() {
			return nil
		}
		if entry.Type()&fs.ModeSymlink != 0 || !entry.Type().IsRegular() {
			return fmt.Errorf("unsupported build-source entry: %s", path)
		}
		rel, err := filepath.Rel(root, path)
		if err != nil {
			return err
		}
		rel = filepath.ToSlash(rel)
		if !utf8.ValidString(rel) {
			return fmt.Errorf("invalid UTF-8 path: %q", rel)
		}
		paths = append(paths, rel)
		return nil
	})
	if err != nil {
		return "", err
	}
	sort.Strings(paths)
	h := sha256.New()
	h.Write([]byte("curator-build-source-v1\x00"))
	for _, path := range paths {
		payload, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(path)))
		if err != nil {
			return "", err
		}
		framed(h, 'F', path, string(payload))
	}
	return fmt.Sprintf("sha256:%x", h.Sum(nil)), nil
}

func markerExcludingContent(root string) (string, error) {
	var paths []string
	err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
		if err != nil {
			return err
		}
		if path == root || entry.IsDir() {
			return nil
		}
		if entry.Type()&fs.ModeSymlink != 0 || !entry.Type().IsRegular() {
			return fmt.Errorf("unsupported content entry: %s", path)
		}
		rel, err := filepath.Rel(root, path)
		if err != nil {
			return err
		}
		rel = filepath.ToSlash(rel)
		if rel != ".csk-install.json" {
			paths = append(paths, rel)
		}
		return nil
	})
	if err != nil {
		return "", err
	}
	sort.Strings(paths)
	h := sha256.New()
	for index, path := range paths {
		if index > 0 {
			h.Write([]byte{0})
		}
		payload, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(path)))
		if err != nil {
			return "", err
		}
		h.Write([]byte(path))
		h.Write([]byte{0})
		h.Write(payload)
	}
	return fmt.Sprintf("sha256:%x", h.Sum(nil)), nil
}

func main() {
	h := sha256.New()
	h.Write([]byte("curator-go-toolchain-v1\x00"))
	for _, e := range []entry{
		{'D', "bin", ""},
		{'F', "bin/go", "GO"},
		{'D', "pkg", ""},
		{'L', "pkg/tool-link", "../bin/go"},
	} {
		framed(h, e.kind, e.path, e.payload)
	}

