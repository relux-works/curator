hub.io/curator-spec/schemas/v1/csk-skill-v1.schema.json\",\nschemas/v1/skillfile-dev-v1.schema.json:2:  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\nschemas/v1/skillfile-dev-v1.schema.json:3:  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/skillfile-dev-v1.schema.json\",\nschemas/v1/skillfile-dev-v1.schema.json:4:  \"title\": \"Skillfile.dev.json schema 1\",\nschemas/v1/skillfile-dev-v1.schema.json:6:  \"required\": [\"substitutions\"],\nschemas/v1/skillfile-dev-v1.schema.json:8:    \"substitutions\": {\nschemas/v1/agent-skill-v1.schema.json:2:  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\nschemas/v1/agent-skill-v1.schema.json:3:  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/agent-skill-v1.schema.json\",\nschemas/v1/agent-skill-v4.schema.json:2:  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\nschemas/v1/agent-skill-v4.schema.json:3:  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/agent-skill-v4.schema.json\",\nschemas/v1/adapter-ledger-v1.schema.json:2:  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\nschemas/v1/adapter-ledger-v1.schema.json:3:  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/adapter-ledger-v1.schema.json\",\nschemas/v1/registry-snapshot-v1.schema.json:2:  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\nschemas/v1/registry-snapshot-v1.schema.json:3:  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/registry-snapshot-v1.schema.json\",\nschemas/v1/registry-bundle-v1.schema.json:2:  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\nschemas/v1/registry-bundle-v1.schema.json:3:  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/registry-bundle-v1.schema.json\",\nschemas/v1/csk-skill-v2.schema.json:2:  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\nschemas/v1/csk-skill-v2.schema.json:3:  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/csk-skill-v2.schema.json\",\nschemas/v1/common.schema.json:2:  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\nschemas/v1/common.schema.json:3:  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json\",\nschemas/v1/common.schema.json:175:    \"canonicalValue\": {\nschemas/v1/common.schema.json:181:        {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/canonicalValue\"}},\nschemas/v1/common.schema.json:182:        {\"type\": \"object\", \"additionalProperties\": {\"$ref\": \"#/$defs/canonicalValue\"}}\nschemas/v1/README.md:15:canonical skill-manifest schemas. The corresponding `csk-skill-*` schemas are\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"sed -n '320,410p' protocol/core.md\nsed -n '1,180p' schemas/v1/skillfile-dev-v1.schema.json\nsed -n '1,220p' schemas/v1/skillfile-v1.schema.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"sed -n '320,410p' protocol/core.md\nsed -n '1,180p' schemas/v1/skillfile-dev-v1.schema.json\nsed -n '1,220p' schemas/v1/skillfile-v1.schema.json\"","aggregated_output":"Writers MUST NOT create this legacy form.\n\n## 5. Project manifests\n\n`Skillfile.json` conforms to `skillfile-v1.schema.json`. It contains unique\nskill declarations and exactly one of `tag`, `branch`, or `revision` for each\nskill. `source` is a portable relative path below the manager's configured\nsource root. `git` is used when the source repository is absent. Branches are\npermitted only for direct project declarations and development substitutions.\n\n`project.alias`, when present, is a non-empty, case-sensitive Unicode label of\nat most 128 characters with no control characters. It is an operator-facing\nmatching label, not a filesystem identifier, and therefore MAY contain spaces.\n\nEffective agents are selected in this order: manifest `agents`, registered\nproject agents, manager defaults. Effective locale is manifest `locale`, then\nthe manager preference.\n\n`Skillfile.dev.json` conforms to `skillfile-dev-v1.schema.json` and is never\ncommitted. Each substitution is exactly one of a local git checkout `path` or\n`git` plus exact `ref`. A substitution replaces every requirement of that name,\nskips its normal unification check, is recorded in the marker, and causes\nstrict audit mode to fail.\n\n## 6. Sources and snapshots\n\n### 6.1 Canonical source identity\n\nNetwork git sources use a canonical identity. Local paths and `file:` URLs have\nno network identity. Protocol 1.0 network URLs:\n\n- use `ssh`, `git`, `http`, or `https`, or SCP form `[user@]host:path`;\n- have an ASCII host matching `[A-Za-z0-9][A-Za-z0-9.-]*`;\n- contain no explicit port, password, query, fragment, percent escape, or\n  backslash;\n- contain a non-empty portable repository path with no whitespace, `%`, `?`,\n  or `#` character;\n- produce a canonical `host/path` identity of at most 4096 Unicode scalar\n  values.\n\nCanonicalization lowercases the host, removes user and transport, trims outer\npath slashes, and removes one case-sensitive trailing `.git`. Repository path\ncase is preserved. The result is `host/path`. Invalid network forms MUST be\nrejected, not treated as local.\n\nAllowlist matching is segment-aware: identity `h/a/b` matches prefix `h/a` but\nnot `h/a-evil`. An empty allowlist permits all network identities. Local\nsources bypass the network allowlist.\n\n### 6.2 Git safety and references\n\nGit execution MUST restrict protocols to `file`, `git`, `http`, `https`, and\n`ssh`; refuse empty or dash-prefixed operands; and place untrusted operands\nafter `--` where supported. Submodules are unsupported. Archive extraction\nMUST reject symbolic links, hard links, path escapes, duplicate platform paths,\nand entries exceeding implementation limits documented by the manager.\n\nTags resolve `refs/tags/<value>^{commit}`. Revisions resolve\n`<value>^{commit}`. Branches prefer `refs/remotes/origin/<value>` and then a\nlocal head. A resolved commit is the full lowercase hexadecimal object id\nreturned by git. Snapshots are immutable regular-file trees produced from that\ncommit.\n\n## 7. Closure resolution\n\nDirect declarations enter as `full` requirements from synthetic consumer\n`<project>`. Processing a provider adds its skill requirements.\n\nWithin one closure, one skill name MUST resolve to exactly one commit and one\ncanonical source identity. Different identities or commits fail with every\nrelevant requirement chain. Different refs resolving to one commit unify.\nCycles fail and name the cycle.\n\nActivation is edge-based. Context is active when any incoming edge is `full`\nor `context`. All commands are active when any edge is `full`; otherwise the\nactive set is the union of runtime edges, narrowed where requested.\n\nProvider order is deterministic Kahn topological order: among currently ready\nproviders select the lexicographically smallest skill name by Unicode scalar\nvalue. The synthetic project is not emitted. Diagnostic requirement chains use\nthe lexicographically smallest complete chain when multiple chains are equal\nin length.\n\n## 8. Content hashes\n\nThe Curator content hash is calculated over regular files excluding the marker\nitself. For each selected file in sorted protocol-path order, append:\n\n```text\nUTF8(path) || 0x00 || file_bytes\n```\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/skillfile-dev-v1.schema.json\",\n  \"title\": \"Skillfile.dev.json schema 1\",\n  \"type\": \"object\",\n  \"required\": [\"substitutions\"],\n  \"properties\": {\n    \"substitutions\": {\n      \"type\": \"object\",\n      \"propertyNames\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n      \"additionalProperties\": {\n        \"oneOf\": [\n          {\n            \"type\": \"object\",\n            \"required\": [\"path\"],\n            \"properties\": {\"path\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"}},\n            \"additionalProperties\": false\n          },\n          {\n            \"type\": \"object\",\n            \"required\": [\"git\", \"ref\"],\n            \"properties\": {\n              \"git\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"},\n              \"ref\": {\"$ref\": \"common.schema.json#/$defs/devRef\"}\n            },\n            \"additionalProperties\": false\n          }\n        ]\n      }\n    }\n  },\n  \"additionalProperties\": false\n}\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://relux-works.github.io/curator-spec/schemas/v1/skillfile-v1.schema.json\",\n  \"title\": \"Skillfile.json schema 1\",\n  \"type\": \"object\",\n  \"required\": [\"schema_version\", \"skills\"],\n  \"properties\": {\n    \"schema_version\": {\"const\": 1},\n    \"project\": {\n      \"type\": \"object\",\n      \"properties\": {\"alias\": {\"$ref\": \"common.schema.json#/$defs/projectAlias\"}},\n      \"additionalProperties\": false\n    },\n    \"agents\": {\"$ref\": \"common.schema.json#/$defs/identifierSet\"},\n    \"locale\": {\"$ref\": \"common.schema.json#/$defs/locale\"},\n    \"skills\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"name\"],\n        \"properties\": {\n          \"name\": {\"$ref\": \"common.schema.json#/$defs/identifier\"},\n          \"source\": {\"$ref\": \"common.schema.json#/$defs/portablePath\"},\n          \"git\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"},\n          \"tag\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"},\n          \"branch\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"},\n          \"revision\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"}\n        },\n        \"oneOf\": [{\"required\": [\"tag\"]}, {\"required\": [\"branch\"]}, {\"required\": [\"revision\"]}],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"additionalProperties\": false\n}\n","exit_code":0,"status":"completed"}}
