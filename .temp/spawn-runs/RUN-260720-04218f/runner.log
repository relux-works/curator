    end
  endif
  :Operation 3;
}

:Commit transaction;
stop

@enduml
```

## Async Process Pattern

```plantuml
@startuml
!theme plain

|User|
start
:Submit request;

|API|
:Receive request;
:Create job;
:Return job ID;

fork
  |Worker|
  :Process job;
  :Update status;
fork again
  |API|
  :Return immediately;

  |User|
  :Receive job ID;

  while (job complete?) is (no)
    :Poll status;
    :Wait;
  endwhile (yes)

  :Get results;
end fork

stop
@enduml
```

