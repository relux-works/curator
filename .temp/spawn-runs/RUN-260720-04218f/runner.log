	projectManifest, err := manifest.Load(projectRoot)
	if err != nil {
		result.failf("%v", err)
		return result
	}
	if projectManifest == nil {
		result.Status = "skipped"
		result.Messages = append(result.Messages, alias+": Skillfile.json not found; skipped")
		return result
	}

