@@ -0,0 +1,59 @@
+@startuml
+!theme plain
+!pragma layout smetana
+
+title Independent consumers of the shared compiled-build suite
+
+skinparam componentStyle rectangle
+skinparam packageStyle rectangle
+
+package "curator-spec (the only oracle)" #LightBlue {
+  [Schema v6 and base build vectors] as Base
+  [Executable interop cases\nwith stable case IDs] as Cases
+  [Expected normalized outcomes\nand suite digest] as Expected
+  [Black-box parity runner] as Runner
+}
+
+package "Curator repository" #LightGreen {
+  [Go suite consumer] as GoConsumer
+  [Curator manager] as Curator
+}
+
+package "csk repository" #LightYellow {
+  [Python suite consumer] as PyConsumer
+  [csk manager] as Csk
+}
+
+Base --> Cases : fixture and normative case references
+Cases --> Expected : generated together
+
+Cases --> GoConsumer : identical suite bytes
+Expected --> GoConsumer : case outcomes
+GoConsumer --> Curator : drives public behavior
+
+Cases --> PyConsumer : identical suite bytes
+Expected --> PyConsumer : case outcomes
+PyConsumer --> Csk : drives public behavior
+
+GoConsumer --> Runner : one result per case
+PyConsumer --> Runner : one result per case
+Expected --> Runner : required case set
+
+note bottom of GoConsumer
+  Does not import csk or copy
+  implementation-owned expected values.
+end note
+
+note bottom of PyConsumer
+  Does not import Curator or copy
+  implementation-owned expected values.
+end note
+
+note right of Runner
+  Managers use disjoint homes, projects,
+  caches, and fixture copies. The runner
+  compares decisions and launch behavior,
+  never platform-dependent binary bytes.
+end note
+
+@enduml

