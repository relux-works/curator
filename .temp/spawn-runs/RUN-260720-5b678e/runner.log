+GO111MODULE=on
+GOFLAGS=
+GOPROXY=off
+GOSUMDB=off
+GOPRIVATE=
+GONOPROXY=none
+GONOSUMDB=none
+GOVCS=*:off
+GOWORK=off
+CGO_ENABLED=0
+GO_EXTLINK_ENABLED=0
+GOEXPERIMENT=
