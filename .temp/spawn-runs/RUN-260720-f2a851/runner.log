[build-system]
requires = ["setuptools>=80", "setuptools-scm[simple]>=8"]
build-backend = "setuptools.build_meta"

[project]
name = "cocoaskills"
dynamic = ["version"]
description = "Local skill manager for AI agent skills with reproducible per-project installs"
readme = "README.md"
requires-python = ">=3.11"
license = "Apache-2.0"
license-files = ["LICENSE"]
authors = [
  { name = "Ivan Oparin", email = "oparin@me.com" }
]
keywords = [
  "skills",
  "ai-agents",
  "claude-code",
  "cursor",
  "codex",
  "gemini",
  "dependency-manager",
]
