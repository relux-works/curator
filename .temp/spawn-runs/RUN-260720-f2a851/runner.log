    11	import (
    12		"crypto/sha256"
    13		"encoding/hex"
    14		"io/fs"
    15		"os"
    16		"path/filepath"
    17		"sort"
    18		"strings"
    19	)
    20	
    21	// MarkerName is excluded from hashing by default.
    22	const MarkerName = ".csk-install.json"
    23	
    24	// ContentSHA256 hashes the tree rooted at root, excluding the given
    25	// root-relative POSIX paths (defaults to the install marker when nil).
    26	func ContentSHA256(root string, exclude map[string]bool) (string, error) {
    27		if exclude == nil {
    28			exclude = map[string]bool{MarkerName: true}
    29		}
    30		var files []string
    31		err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
    32			if err != nil {
    33				return err
    34			}
    35			if entry.IsDir() {
    36				return nil
    37			}
    38			if !entry.Type().IsRegular() && entry.Type()&fs.ModeSymlink == 0 {
    39				return nil
    40			}
    41			rel, relErr := filepath.Rel(root, path)
    42			if relErr != nil {
    43				return relErr
    44			}
    45			posix := filepath.ToSlash(rel)
    46			if exclude[posix] {
    47				return nil
    48			}
    49			files = append(files, posix)
    50			return nil
    51		})
    52		if err != nil {
    53			return "", err
    54		}
    55		sort.Strings(files)
    56	
    57		digest := sha256.New()
    58		for index, posix := range files {
    59			if index > 0 {
    60				digest.Write([]byte{0})
    61			}
    62			digest.Write([]byte(posix))
    63			digest.Write([]byte{0})
    64			content, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(posix))) // #nosec G304 -- paths come from the walked tree
    65			if err != nil {
    66				return "", err
    67			}
    68			digest.Write(content)
    69		}
    70		return "sha256:" + hex.EncodeToString(digest.Sum(nil)), nil
    71	}
    72	
    73	// Normalize lowercases and strips the optional prefix so hashes compare
    74	// reliably.
    75	func Normalize(hash string) string {
    76		return strings.ToLower(strings.TrimPrefix(strings.TrimSpace(hash), "sha256:"))
    77	}

