     1	// Package identifiers validates the identifier alphabet of Spec §5.2 and the
     2	// source path rule of Spec §6.1.
     3	//
     4	// Skill names, command names, and MCP server names become filesystem path
     5	// components (shim filenames, runtime directories). Restricting them to a
     6	// safe alphabet keeps a third-party manifest from writing outside its
     7	// designated directories.
     8	package identifiers
     9	
    10	import (
    11		"regexp"
    12		"strings"
    13		"unicode"
    14		"unicode/utf8"
    15	)
    16	
    17	var identifierRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]*$`)
    18	var localeRE = regexp.MustCompile(`^[A-Za-z0-9](?:[A-Za-z0-9-]{0,62}[A-Za-z0-9])?$`)
    19	
    20	// Rule is the human-readable identifier rule, phrased once for reuse in
    21	// error messages.
    22	const Rule = "must be a portable identifier: start with a letter or digit, contain only letters, digits, dots, underscores, or hyphens, and not use a Windows-reserved filename"
    23	
    24	// SourceRule is the human-readable rule for source paths under skills_root.
    25	const SourceRule = "must be a relative path whose segments start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens"
    26	
    27	// Valid reports whether value matches the identifier alphabet of Spec §5.2.
    28	func Valid(value string) bool {
    29		return len(value) <= 128 && identifierRE.MatchString(value) && PortableComponent(value)
    30	}
    31	
    32	// ValidLocale reports whether value is the protocol's safe BCP 47-compatible
    33	// locale selector surface.
    34	func ValidLocale(value string) bool {
    35		return utf8.RuneCountInString(value) <= 64 && localeRE.MatchString(value)
    36	}
    37	
    38	// PortableComponent applies cross-platform filename restrictions, including
    39	// Windows device names, trailing spaces/dots, and stream separators.
    40	func PortableComponent(value string) bool {
    41		if value == "" || !utf8.ValidString(value) || value == "." || value == ".." ||
    42			strings.HasSuffix(value, ".") || strings.HasSuffix(value, " ") || strings.ContainsAny(value, `:/\`) {
    43			return false
    44		}
    45		for _, character := range value {
    46			if unicode.IsControl(character) {
    47				return false
    48			}

