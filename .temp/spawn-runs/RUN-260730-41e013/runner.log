        {
            ".agents/sentinel": "project-live\n",
            ".codex/sentinel": "codex-live\n",
            ".claude/sentinel": "claude-live\n",
        },
    )
    write_files(
        csk_home,
        {
            "runtime/sentinel/tool": "runtime-live\n",
            "hybrid/skills/sentinel/SKILL.md": "hybrid-live\n",
