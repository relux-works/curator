+    )
+
+    supported = adapters._transaction_links_supported(
+        stage_root,
+        live_root / ".claude" / "skills" / "skill-a",
+    )
+
+    assert supported
+    assert probed == [stage_root]
+    assert list(live_root.iterdir()) == []
