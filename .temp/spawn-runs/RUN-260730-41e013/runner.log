+        csk_home / "cache" / "stale-source" / ("0" * 40) / "snapshot"
+    )
+    stale_snapshot.mkdir(parents=True)
+    process = subprocess.run(
+        [sys.executable, "-c", "import os; print(os.getpid())"],
+        check=True,
+        capture_output=True,
