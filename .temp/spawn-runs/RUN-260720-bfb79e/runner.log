+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+
+	"github.com/relux-works/curator/internal/snapshot"
+)
+
+func git(dir string, args ...string) {
+	command := exec.Command("git", args...)
+	command.Dir = dir
+	command.Env = append(os.Environ(),
+		"GIT_AUTHOR_NAME=review", "GIT_AUTHOR_EMAIL=review@example.com",
+		"GIT_COMMITTER_NAME=review", "GIT_COMMITTER_EMAIL=review@example.com",
+	)
+	if output, err := command.CombinedOutput(); err != nil {
+		panic(fmt.Sprintf("git %v: %v: %s", args, err, output))
+	}
+}
+
+func main() {
+	repo, err := os.MkdirTemp("", "snapshot-atomic-repo-")
+	if err != nil {
+		panic(err)
+	}
+	defer os.RemoveAll(repo)
+	git(repo, "init", "-q", "-b", "main")
+	if err := os.WriteFile(filepath.Join(repo, "SKILL.md"), []byte("authoritative"), 0o644); err != nil {
+		panic(err)
+	}
+	git(repo, "add", ".")
+	git(repo, "commit", "-qm", "snapshot")
+	command := exec.Command("git", "rev-parse", "HEAD")
+	command.Dir = repo
+	commitBytes, err := command.Output()
+	if err != nil {
+		panic(err)
+	}
+	commit := string(commitBytes[:len(commitBytes)-1])
+
+	var getErrors atomic.Int64
+	var missingObservations atomic.Int64
+	errorTexts := make(chan string, 1200)
+	for iteration := 0; iteration < 100; iteration++ {
+		home, err := os.MkdirTemp("", "snapshot-atomic-home-")
+		if err != nil {
+			panic(err)
+		}
+		target, err := snapshot.Get(home, "internal/skill-a", repo, commit)
+		if err != nil {
+			panic(err)
+		}
+		if err := os.WriteFile(filepath.Join(target, "SKILL.md"), []byte("tampered"), 0o644); err != nil {
+			panic(err)
+		}
+
+		start := make(chan struct{})
+		done := make(chan struct{})
+		var workers sync.WaitGroup
+		for worker := 0; worker < 12; worker++ {
+			workers.Add(1)
+			go func() {
+				defer workers.Done()
+				<-start
+				if _, err := snapshot.Get(home, "internal/skill-a", repo, commit); err != nil {
+					getErrors.Add(1)
+					errorTexts <- err.Error()
+				}
+			}()
+		}
+		go func() {
+			<-start
+			for {
+				select {
+				case <-done:
+					return
+				default:
+					if _, err := os.Lstat(target); os.IsNotExist(err) {
+						missingObservations.Add(1)
+					}
+				}
+			}
+		}()
+		close(start)
+		workers.Wait()
+		close(done)
+		_ = os.RemoveAll(home)
+	}
+	fmt.Printf("get_errors=%d missing_target_observations=%d\n", getErrors.Load(), missingObservations.Load())
+	close(errorTexts)
+	seen := map[string]int{}
+	for message := range errorTexts {
+		seen[message]++
+	}
+	for message, count := range seen {
+		fmt.Printf("error_count=%d error=%s\n", count, message)
+	}
+}

