+        / ".csk-install.json"
+    )
+    manager_home_lock = installer.locking.ManagerHomeLock
+
+    class PostCommitContention:
+        def __enter__(self):
+            raise installer.locking.LockError("post-commit lock contention")
+
+        def __exit__(self, *args):
