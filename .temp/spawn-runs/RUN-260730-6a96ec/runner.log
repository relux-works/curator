+    stage_root = tmp_path / "private-stage"
+    live_root = tmp_path / "project"
+    live_directory = live_root / ".claude" / "skills"
+    stage_root.mkdir()
+    live_directory.mkdir(parents=True)
+    probed = []
+    monkeypatch.setattr(
