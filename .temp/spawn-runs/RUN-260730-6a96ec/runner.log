+        "_device_id",
+        lambda path: 1 if path == stage_root else 2,
+    )
+    monkeypatch.setattr(
+        adapters,
+        "_link_probe",
+        lambda directory: probed.append(directory) or True,
+    )
+
+    supported = adapters._transaction_links_supported(
