  1494	def _digest_file(
  1495	    record: _TreeRecord,
  1496	    digest: hashlib._Hash,
  1497	    deadline: float,
  1498	) -> tuple[int, bytes]:
  1499	    flags = os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_CLOEXEC", 0)
  1500	    flags |= getattr(os, "O_NOFOLLOW", 0)
  1501	    try:
  1502	        descriptor = os.open(record.native_path, flags)
  1503	    except OSError as exc:
  1504	        raise ToolchainError(
  1505	            "toolchain_mutated",
  1506	            f"cannot open toolchain file {record.protocol_path!r}",
  1507	        ) from exc
  1508	    payload_digest = hashlib.sha256()
  1509	    total = 0
  1510	    try:
  1511	        opened = os.fstat(descriptor)
  1512	        if (
  1513	            not stat.S_ISREG(opened.st_mode)
  1514	            or not _same_stat(record.initial_stat, opened)
  1515	            or opened.st_size < 0
  1516	        ):
  1517	            raise ToolchainError(
  1518	                "toolchain_mutated",
  1519	                f"toolchain file {record.protocol_path!r} changed while opening",
  1520	            )
  1521	        digest.update(
  1522	            _framed_record_header("F", record.path_bytes, opened.st_size)
  1523	        )
  1524	        while True:
  1525	            _check_deadline(deadline)
  1526	            chunk = os.read(descriptor, 128 * 1024)
  1527	            if not chunk:
  1528	                break
  1529	            total += len(chunk)
  1530	            digest.update(chunk)
  1531	            payload_digest.update(chunk)
  1532	        if total != opened.st_size:
  1533	            raise ToolchainError(
  1534	                "toolchain_mutated",
  1535	                f"toolchain file {record.protocol_path!r} changed while reading",
  1536	            )
  1537	    finally:
  1538	        os.close(descriptor)
  1539	    try:
  1540	        current = record.native_path.lstat()
  1541	    except OSError as exc:
  1542	        raise ToolchainError(
  1543	            "toolchain_mutated",
  1544	            f"toolchain file {record.protocol_path!r} disappeared",
  1545	        ) from exc
  1546	    if not stat.S_ISREG(current.st_mode) or not _same_stat(record.initial_stat, current):
  1547	        raise ToolchainError(
  1548	            "toolchain_mutated",
  1549	            f"toolchain file {record.protocol_path!r} changed",
  1550	        )
  1551	    return total, payload_digest.digest()
