  1248	            states.append(
  1249	                _TreeState(
  1250	                    path_bytes=record.path_bytes,
  1251	                    kind=record.kind,
  1252	                    size=0,
  1253	                    payload_sha256=b"",
  1254	                )
  1255	            )
  1256	        elif record.kind == "L":
  1257	            payload = _revalidate_link(record)
  1258	            digest.update(
  1259	                _framed_record_header("L", record.path_bytes, len(payload))
  1260	            )
  1261	            digest.update(payload)
  1262	            states.append(
  1263	                _TreeState(
  1264	                    path_bytes=record.path_bytes,
  1265	                    kind=record.kind,
  1266	                    size=len(payload),
  1267	                    payload_sha256=hashlib.sha256(payload).digest(),
  1268	                )
  1269	            )
  1270	        elif record.kind == "F":
  1271	            size, payload_digest = _digest_file(record, digest, deadline)
  1272	            states.append(
  1273	                _TreeState(
  1274	                    path_bytes=record.path_bytes,
  1275	                    kind=record.kind,
  1276	                    size=size,
  1277	                    payload_sha256=payload_digest,
  1278	                )
  1279	            )
