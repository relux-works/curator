  1231	def _fingerprint_normalized(
  1232	    goroot: Path,
  1233	    version: str,
  1234	    *,
  1235	    deadline: float,
  1236	) -> tuple[str, tuple[_TreeState, ...]]:
  1237	    _check_deadline(deadline)
