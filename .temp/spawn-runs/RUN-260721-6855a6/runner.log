func TestWindowsProtectedStateMatrix(t *testing.T) {
	tests := []struct {
		name   string
		mutate func(t *testing.T, store *Store, hit Result)
	}{
		{
			name: "artifact grants another principal mutation rights",
			mutate: func(t *testing.T, _ *Store, hit Result) {
