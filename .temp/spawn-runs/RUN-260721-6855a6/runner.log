func acquireSnapshotLock(path string) (*snapshotLock, error) {
	file, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o600) // #nosec G304 -- path is manager-derived
	if err != nil {
		return nil, fmt.Errorf("open snapshot lock: %w", err)
