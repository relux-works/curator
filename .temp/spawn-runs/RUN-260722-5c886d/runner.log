			}
			testCase.check(t, staged)
			if _, err := os.Lstat(mustEngine(t, home).journalPath(journal.TransactionID)); err != nil {
				t.Fatalf("corrupt preparing recovery removed journal: %v", err)
			}
		})
	}
}

