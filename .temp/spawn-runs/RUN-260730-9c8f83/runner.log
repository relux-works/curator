+            ctypes.byref(flags),
+            ctypes.sizeof(flags),
+        ):
+            return bool(flags.value & _FILE_CS_FLAG_CASE_SENSITIVE_DIR)
+        error_number = int(get_last_error())
+        if error_number in {
+            _ERROR_INVALID_FUNCTION,
+            _ERROR_NOT_SUPPORTED,
+            _ERROR_INVALID_PARAMETER,
+            _ERROR_CALL_NOT_IMPLEMENTED,
+        }:
+            return False
