+            engine._save_journal(journal)
+        elif phase == "removal_tomb":
+
+            def crash_after_tomb(point: str, current: JournalTarget | None) -> None:
+                del current
+                if point == "journal_tombed":
+                    raise SimulatedCrash(point)
+
+            engine._fault_hook = crash_after_tomb
