+        or stat.S_IMODE(after.st_mode) != stat.S_IMODE(info.st_mode)
+    ):
+        raise TransactionCorruptionError(
+            f"transaction entry changed while digesting: {path}"
+        )
+    return "sha256:" + digest.hexdigest()
