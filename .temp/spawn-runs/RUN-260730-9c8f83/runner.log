+def _canonical_filesystem_identity(path: Path, *, label: str) -> str:
+    try:
+        absolute = Path(os.path.abspath(path.expanduser()))
+        resolved = absolute.resolve(strict=False)
+        existing, missing = _longest_existing_prefix(resolved)
+        if os.name == "nt":
