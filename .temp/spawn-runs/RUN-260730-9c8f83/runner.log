+def _cleanup_writable_order(
+    entries: list[CleanupTreeEntry],
+) -> list[CleanupTreeEntry]:
+    return sorted(
+        entries,
+        key=lambda entry: (
+            len(PurePosixPath(entry.relative_path).parts)
+            if entry.relative_path
+            else 0,
+            0 if entry.kind == "directory" else 1,
