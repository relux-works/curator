+        if error_number in {
+            _ERROR_INVALID_FUNCTION,
+            _ERROR_NOT_SUPPORTED,
+            _ERROR_INVALID_PARAMETER,
+            _ERROR_CALL_NOT_IMPLEMENTED,
+        }:
+            return False
+        raise OSError(
+            error_number,
+            f"{format_error(error_number)}: cannot inspect case sensitivity: {path}",
+        )
+    finally:
