+def _entry_content_digest(path: Path, info: os.stat_result) -> str:
+    if not stat.S_ISREG(info.st_mode) or path.is_symlink():
+        raise TransactionCorruptionError(
+            f"transaction entry is not a regular file: {path}"
+        )
