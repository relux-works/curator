+        witness_fd = os.open(path, os.O_RDONLY | no_follow)
+        sync_fd: int | None = None
+        try:
+            before = os.fstat(witness_fd)
+            try:
+                sync_fd = os.open(path, os.O_RDWR | no_follow)
+            except PermissionError:
+                pass
+            path.chmod(mode)
+            current = path.lstat()
