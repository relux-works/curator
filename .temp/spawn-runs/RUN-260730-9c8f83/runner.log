+            engine.commit(lock, "txn-read-only-rollback")
+
+    assert (live / "payload").read_text(encoding="utf-8") == "old"
+    assert live.stat().st_mode & 0o777 == 0o555
+    assert (live / "payload").stat().st_mode & 0o777 == 0o444
