+def _staging_construction_mode(entry: StagingTreeEntry) -> int:
+    if entry.kind == "directory":
+        return entry.mode | stat.S_IRUSR | stat.S_IWUSR | stat.S_IXUSR
+    return entry.mode | stat.S_IRUSR | stat.S_IWUSR
