+    if entry.kind == "file":
+        flags = os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
+        fd = os.open(path, flags)
+        try:
+            os.fchmod(fd, mode)
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+    else:
+        path.chmod(mode)
+        _sync_directory(path)
+    _sync_directory(path.parent)
