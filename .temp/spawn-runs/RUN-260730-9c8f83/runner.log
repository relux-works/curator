    transactions._windows_sync_regular(regular)
    transactions._windows_sync_directory(directory)

    assert requests == [
        (regular, 0x40000000, 0x00200000, frozenset()),
        (directory, 0x80000000, 0x02000000, frozenset({5, 6})),
    ]


