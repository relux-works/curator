+        (desired / "nested").chmod(0o700)
+        (desired / "nested" / "payload").chmod(0o600)
+        shutil.rmtree(desired)
+    else:
+        desired.unlink()
+
+    with ManagerHomeLock(home) as lock:
+        TransactionEngine(home).recover(lock)
