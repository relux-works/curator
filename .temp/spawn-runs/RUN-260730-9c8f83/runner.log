+
+        lock.assert_held()
+        assert lock.path.read_bytes() == lock_witness
+        assert alias_record.read_bytes() == record_bytes
+        assert {
+            path: digest_path(path)
+            for path in transaction_paths
+        } == before_digests
+        assert not canonical_record.exists()
