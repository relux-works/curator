+@pytest.mark.parametrize(
+    ("phase", "record_suffix"),
+    [
+        ("prepared", ".json"),
+        ("committing", ".json"),
+        ("rolling_back", ".json"),
+        ("cleanup", ".json"),
+        ("removal_tomb", ".json.delete"),
