+                "txn-read-only-cleanup-foreign",
+                tmp_path / "project",
+                _target("10-context", "skill", live, desired),
+            ),
+        )
+        with pytest.raises(SimulatedCrash, match="before_sidecar_mode_writable"):
+            engine.commit(lock, "txn-read-only-cleanup-foreign")
