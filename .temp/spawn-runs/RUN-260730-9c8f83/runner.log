+            f"recorded cleanup entry is missing: {path}"
+        ) from exc
+    if (
+        actual.kind != expected.kind
+        or actual.digest != expected.digest
+        or actual.mode not in allowed_modes
+    ):
+        raise TransactionCorruptionError(f"changed cleanup bytes: {path}")
