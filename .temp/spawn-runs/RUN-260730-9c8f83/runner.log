+            engine.commit(lock, "txn-read-only-cleanup-foreign")
+
+    journal_path = engine.journal_root / "txn-read-only-cleanup-foreign.json"
+    raw = json.loads(journal_path.read_text(encoding="utf-8"))
+    active = next(
