+                raise TransactionCorruptionError(
+                    f"transaction entry changed while opening for durability: {path}"
+                )
+            os.fsync(sync_fd)
+        finally:
+            if sync_fd is not None:
+                os.close(sync_fd)
+            os.close(witness_fd)
+    else:
+        path.chmod(mode)
