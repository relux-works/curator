+    components = [
+        value
+        for value in re.split(r"[\\/]+", tail.lstrip("\\/"))
+        if value
+    ]
+    lookup = root
+    canonical = volume.upper() + "\\"
+    parent_is_case_sensitive = case_sensitive(lookup)
+    for index, component in enumerate(components):
