+def _longest_existing_prefix(path: Path) -> tuple[Path, list[str]]:
+    current = path
+    missing: list[str] = []
+    while True:
+        try:
+            current.lstat()
+            return current, missing
+        except FileNotFoundError:
+            parent = current.parent
+            if parent == current:
+                raise
+            missing.append(current.name)
