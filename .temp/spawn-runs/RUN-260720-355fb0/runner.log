        "type": "build",
        "driver": "go-v1",
        "source_dir": "assets/build-tool/cmd/golden-tool"
      }
    },
    "capabilities": {
      "network": "none",
      "filesystem": "repo",
      "exec": "none",
      "secrets": "none",
      "env_read": []
    },
    "dependencies": {}
  },
  "snapshot_files": [
    "SKILL.md",
    "assets/prompt.md",
    "assets/build-tool/go.mod",
