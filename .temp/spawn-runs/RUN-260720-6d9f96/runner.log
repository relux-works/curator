from __future__ import annotations

import hashlib
import json
import shutil
import tempfile
import unittest
from pathlib import Path
from unittest.mock import patch

import validate


SOURCE_ROOT = Path(__file__).resolve().parents[1]


class ProtocolRC4ValidatorTests(unittest.TestCase):
    RC4_SCHEMAS = {
        "agent-skill-v6.schema.json",
        "csk-skill-v6.schema.json",
        "build-receipt-v1.schema.json",
        "install-marker-v2.schema.json",
        "conformance-claim-v2.schema.json",
    }

    def setUp(self) -> None:
        self.temporary = tempfile.TemporaryDirectory()
        self.root = Path(self.temporary.name)
        for directory in ("conformance", "reviews", "schemas"):
            shutil.copytree(SOURCE_ROOT / directory, self.root / directory)
        self.patches = (
            patch.object(validate, "ROOT", self.root),
            patch.object(validate, "SCHEMAS", self.root / "schemas" / "v1"),
            patch.object(validate, "SUITE", self.root / "conformance" / "v1"),
            patch.object(validate, "REVIEWS", self.root / "reviews"),
        )
        for active_patch in self.patches:
            active_patch.start()

    def tearDown(self) -> None:
        for active_patch in reversed(self.patches):
            active_patch.stop()
        self.temporary.cleanup()

    @staticmethod
    def _write_json(path: Path, value: object) -> None:
        path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")

    def _refresh_manifest_digest(self, relative: str) -> None:
        manifest_path = self.root / "conformance" / "v1" / "manifest.json"
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        payload = (self.root / "conformance" / "v1" / relative).read_bytes()
        digest = "sha256:" + hashlib.sha256(payload).hexdigest()
        for entry in manifest["files"]:
            if entry["path"] == relative:
                entry["sha256"] = digest
                break
        else:
            self.fail(f"manifest does not contain {relative}")
        self._write_json(manifest_path, manifest)

    def test_accepts_complete_schema_case_manifest_and_vector_inventories(self) -> None:
        validate.validate_schemas()
        validate.validate_manifest()
        validate.validate_vector_semantics()

    def test_rejects_case_removed_from_index_even_when_file_remains(self) -> None:
        path = self.root / "conformance" / "v1" / "schema-cases" / "index.json"
        index = json.loads(path.read_text(encoding="utf-8"))
        self._write_json(path, index[:-1])
        with self.assertRaisesRegex(validate.ValidationFailure, "schema case index mismatch"):
            validate.validate_schemas()

    def test_rejects_schema_removed_with_all_of_its_cases(self) -> None:
        (self.root / "schemas" / "v1" / "build-receipt-v1.schema.json").unlink()
        shutil.rmtree(
            self.root / "conformance" / "v1" / "schema-cases" / "build-receipt-v1"
        )
        with self.assertRaisesRegex(validate.ValidationFailure, "schema inventory mismatch"):
            validate.validate_schemas()

    def test_rejects_each_removed_rc4_schema(self) -> None:
        for name in sorted(self.RC4_SCHEMAS):
            with self.subTest(schema=name):
                path = self.root / "schemas" / "v1" / name
                payload = path.read_bytes()
                path.unlink()
                try:
                    with self.assertRaisesRegex(validate.ValidationFailure, "schema inventory mismatch"):
                        validate.validate_schemas()
                finally:
                    path.write_bytes(payload)

    def test_rejects_each_removed_generated_rc4_case(self) -> None:
        cases = validate.expected_schema_cases()
        for schema in sorted(self.RC4_SCHEMAS):
            directory = schema.removesuffix(".schema.json")
            for filename, _ in cases[schema]:
                relative = f"{directory}/{filename}"
                with self.subTest(case=relative):
                    path = self.root / "conformance" / "v1" / "schema-cases" / relative
                    payload = path.read_bytes()
                    path.unlink()
                    try:
                        with self.assertRaises(validate.ValidationFailure):
                            validate.validate_schemas()
                    finally:
                        path.write_bytes(payload)

    def test_rejects_unresolved_reference_in_new_schema(self) -> None:
        path = self.root / "schemas" / "v1" / "build-receipt-v1.schema.json"
        schema = json.loads(path.read_text(encoding="utf-8"))
        schema["properties"]["input"]["$ref"] = "missing.schema.json#/$defs/input"
        self._write_json(path, schema)
        with self.assertRaisesRegex(validate.ValidationFailure, "unresolved schema reference"):
            validate.validate_schemas()

    def test_rejects_manifest_hash_that_no_longer_matches_file(self) -> None:
        path = self.root / "conformance" / "v1" / "vectors" / "build-drivers.json"
        path.write_bytes(path.read_bytes() + b"\n")
        with self.assertRaisesRegex(validate.ValidationFailure, "vector digest mismatch"):
            validate.validate_manifest()

    def test_rejects_renamed_lifecycle_case_with_updated_manifest_hash(self) -> None:
        relative = "vectors/manager-lifecycle.json"
        path = self.root / "conformance" / "v1" / relative
        vector = json.loads(path.read_text(encoding="utf-8"))
        vector["gc_cases"][0]["name"] = "renamed-locked-gc"
        self._write_json(path, vector)
        self._refresh_manifest_digest(relative)
        validate.validate_manifest()
        with self.assertRaisesRegex(validate.ValidationFailure, "manager gc_cases case inventory mismatch"):
            validate.validate_vector_semantics()


if __name__ == "__main__":
    unittest.main()
class ProtocolRC4ReleaseGateTests(unittest.TestCase):
    def setUp(self) -> None:
        self.temporary = tempfile.TemporaryDirectory()
        self.root = Path(self.temporary.name)
        for directory in ("conformance", "reviews", "schemas"):
            shutil.copytree(SOURCE_ROOT / directory, self.root / directory)
        (self.root / "decisions").mkdir()
        shutil.copy2(
            SOURCE_ROOT / "decisions" / "0004-compile-only-build-drivers.md",
            self.root / "decisions" / "0004-compile-only-build-drivers.md",
        )
        (self.root / "tools").mkdir()
        shutil.copy2(SOURCE_ROOT / "tools" / "validate.py", self.root / "tools" / "validate.py")
        self.root_patch = patch.object(release_gate, "ROOT", self.root)
        self.root_patch.start()

    def tearDown(self) -> None:
        self.root_patch.stop()
        self.temporary.cleanup()

    @staticmethod
    def _write_json(path: Path, value: object) -> None:
        path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")

    def _valid_claim(self) -> dict[str, object]:
        claim = json.loads(
            (self.root / "conformance" / "v1" / "schema-cases" / "conformance-claim-v2" / "valid.json").read_text(
                encoding="utf-8"
            )
        )
        claim["suite_sha256"] = release_gate.current_suite_sha256()
        return claim

    def test_accepts_complete_rc4_artifact_set(self) -> None:
        release_gate.validate_protocol_artifacts(RC4_VERSION)

    def test_rejects_each_missing_required_artifact(self) -> None:
        for relative in sorted(release_gate.RC4_REQUIRED_FILES):
            with self.subTest(path=relative):
                path = self.root / relative
                payload = path.read_bytes()
                path.unlink()
                try:
                    with self.assertRaises(release_gate.ReleaseFailure):
                        release_gate.validate_protocol_artifacts(RC4_VERSION)
                finally:
                    path.write_bytes(payload)

    def test_rejects_renamed_v6_schema(self) -> None:
        source = self.root / "schemas" / "v1" / "agent-skill-v6.schema.json"
        renamed = source.with_name("agent-skill-v6-renamed.schema.json")
        source.rename(renamed)
        with self.assertRaisesRegex(release_gate.ReleaseFailure, "required artifacts are missing"):
            release_gate.validate_protocol_artifacts(RC4_VERSION)

    def test_rejects_stale_build_driver_vector_digest(self) -> None:
        path = self.root / "conformance" / "v1" / "vectors" / "build-drivers.json"
        vector = json.loads(path.read_text(encoding="utf-8"))
        vector["driver"] = "go-v0"
        self._write_json(path, vector)
        with self.assertRaisesRegex(release_gate.ReleaseFailure, "specification validation failed"):
            release_gate.validate_protocol_artifacts(RC4_VERSION)

    def test_rejects_missing_manifest_entry(self) -> None:
        path = self.root / "conformance" / "v1" / "manifest.json"
        manifest = json.loads(path.read_text(encoding="utf-8"))
        manifest["files"] = manifest["files"][1:]
        self._write_json(path, manifest)
        with self.assertRaisesRegex(release_gate.ReleaseFailure, "specification validation failed"):
            release_gate.validate_protocol_artifacts(RC4_VERSION)

    def test_rejects_removed_schema_case_and_index_entry(self) -> None:
        suite = self.root / "conformance" / "v1"
        case = "agent-skill-v6/invalid-build-hooks.json"
        (suite / "schema-cases" / case).unlink()
        index_path = suite / "schema-cases" / "index.json"
        index = json.loads(index_path.read_text(encoding="utf-8"))
        self._write_json(index_path, [entry for entry in index if entry["instance"] != case])
        manifest_path = suite / "manifest.json"
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        manifest["files"] = [
            entry for entry in manifest["files"] if entry["path"] != f"schema-cases/{case}"
        ]
        self._write_json(manifest_path, manifest)
        with self.assertRaisesRegex(release_gate.ReleaseFailure, "specification validation failed"):
            release_gate.validate_protocol_artifacts(RC4_VERSION)

    def test_rejects_claim_v2_version_mismatch(self) -> None:
        path = self.root / "schemas" / "v1" / "conformance-claim-v2.schema.json"
        schema = json.loads(path.read_text(encoding="utf-8"))
        schema["properties"]["protocol_version"]["const"] = "1.0.0-rc.3"
        self._write_json(path, schema)
        with self.assertRaises(release_gate.ReleaseFailure):
            release_gate.validate_protocol_artifacts(RC4_VERSION)

    def test_rejects_claim_v1_redefined_for_rc4(self) -> None:
        path = self.root / "schemas" / "v1" / "conformance-claim-v1.schema.json"
        schema = json.loads(path.read_text(encoding="utf-8"))
        schema["properties"]["protocol_version"]["const"] = RC4_VERSION
        self._write_json(path, schema)
        with self.assertRaises(release_gate.ReleaseFailure):
            release_gate.validate_protocol_artifacts(RC4_VERSION)

    def test_accepts_claim_for_current_rc4_suite(self) -> None:
        path = self.root / "claim.json"
        self._write_json(path, self._valid_claim())
        release_gate.validate_conformance_claim(path, RC4_VERSION)

    def test_rejects_rc3_suite_hash_as_rc4_evidence(self) -> None:
        claim = self._valid_claim()
        claim["suite_sha256"] = RC3_SUITE_SHA256
        path = self.root / "claim.json"
        self._write_json(path, claim)
        with self.assertRaisesRegex(release_gate.ReleaseFailure, "current 1.0.0-rc.4 suite"):
            release_gate.validate_conformance_claim(path, RC4_VERSION)

    def test_rejects_duplicate_suite_hash_in_rc4_claim(self) -> None:
        claim = self._valid_claim()
        payload = json.dumps(claim)
        payload = payload.replace(
            f'"suite_sha256": "{claim["suite_sha256"]}"',
            f'"suite_sha256": "{claim["suite_sha256"]}", "suite_sha256": "{RC3_SUITE_SHA256}"',
        )
        path = self.root / "claim.json"
        path.write_text(payload, encoding="utf-8")
        with self.assertRaisesRegex(release_gate.ReleaseFailure, "duplicate JSON key"):
            release_gate.validate_conformance_claim(path, RC4_VERSION)

if __name__ == "__main__":
    unittest.main()
