   827	// ReferencedBuildKeys returns the sorted union from every live journal. GC can
   828	// therefore retain in-flight artifacts without understanding current projects.
   829	func (engine *Engine) ReferencedBuildKeys(lock HomeLock) ([]string, error) {
   830		if err := requireHomeLock(lock); err != nil {
   831			return nil, err
   832		}
   833		engine.mu.Lock()
   834		defer engine.mu.Unlock()
   835		ids, err := engine.journalIDs()
   836		if err != nil {
   837			return nil, err
   838		}
   839		set := make(map[string]struct{})
   840		for _, id := range ids {
   841			journal, err := engine.loadJournal(id)
   842			if err != nil {
   843				return nil, err
   844			}
   845			for _, key := range journal.ReferencedBuildKeys {
   846				set[key] = struct{}{}
   847			}
   848		}
   849		keys := make([]string, 0, len(set))
   850		for key := range set {
   851			keys = append(keys, key)
   852		}
   853		sort.Slice(keys, func(i, j int) bool { return bytes.Compare([]byte(keys[i]), []byte(keys[j])) < 0 })
   854		return keys, nil
   855	}
   856	
   857	func cloneJournal(journal *Journal) *Journal {
   858		clone := *journal
   859		clone.ReferencedBuildKeys = append([]string(nil), journal.ReferencedBuildKeys...)
   860		clone.RemovalEntries = append([]RemovalEntry(nil), journal.RemovalEntries...)
   861		clone.Targets = append([]TargetRecord(nil), journal.Targets...)
   862		for index := range clone.Targets {
   863			clone.Targets[index].StagingEntries = append([]RemovalEntry(nil), journal.Targets[index].StagingEntries...)
   864		}
   865		return &clone
   866	}

