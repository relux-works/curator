   450	func (engine *Engine) recoverPendingBackup(target *TargetRecord) error {
   451		backupDigest, err := DigestPath(target.BackupPath)
   452		if err != nil {
   453			return err
   454		}
   455		if backupDigest == DigestAbsent {
   456			return nil
   457		}
   458		liveDigest, err := DigestPath(target.LivePath)
   459		if err != nil {
   460			return err
   461		}
   462		if liveDigest != DigestAbsent {
   463			return corruptionf("target %s/%s has both a pending backup and live bytes", target.Class, target.Identifier)
   464		}
   465		if target.PreimageDigest != "" && backupDigest != target.PreimageDigest {
   466			return corruptionf("pending backup for %s/%s has unknown bytes", target.Class, target.Identifier)
   467		}
   468		if target.ExpectedGeneration != "" {
   469			if err := verifyGenerationAt(target, target.BackupPath); err != nil {
   470				return err
   471			}
   472		}
   473		target.BackupDigest = backupDigest
   474		target.State = StateBackedUp
   475		return nil
   476	}
