   150		leftInfo, leftErr := os.Stat(left.path)
   151		rightInfo, rightErr := os.Stat(right.path)
   152		if leftErr != nil && !os.IsNotExist(leftErr) {
   153			return false, fmt.Errorf("inspect %s %s path: %w", left.owner, left.kind, leftErr)
   154		}
   155		if rightErr != nil && !os.IsNotExist(rightErr) {
   156			return false, fmt.Errorf("inspect %s %s path: %w", right.owner, right.kind, rightErr)
   157		}
   158		return leftErr == nil && rightErr == nil && os.SameFile(leftInfo, rightInfo), nil
   159	}
   160	
   161	func namespaceContains(parent, child string, caseInsensitive, normInsensitive bool) bool {
   162		parentVolume, parentParts := namespaceComponents(parent)
   163		childVolume, childParts := namespaceComponents(child)
   164		if !namespaceComponentEqual(parentVolume, childVolume, caseInsensitive, normInsensitive) || len(parentParts) > len(childParts) {
   165			return false
   166		}
   167		for index := range parentParts {
   168			if !namespaceComponentEqual(parentParts[index], childParts[index], caseInsensitive, normInsensitive) {
   169				return false
   170			}
   171		}
   172		return true
   173	}
   174	
   175	func namespaceComponents(path string) (string, []string) {
   176		clean := filepath.Clean(path)
   177		volume := filepath.VolumeName(clean)
   178		remainder := clean[len(volume):]
   179		parts := strings.FieldsFunc(remainder, func(value rune) bool {
   180			if value == rune(filepath.Separator) {
   181				return true
   182			}
   183			return runtime.GOOS == "windows" && (value == '/' || value == '\\')
   184		})
   185		return volume, parts
   186	}
   187	
   188	func namespaceComponentEqual(left, right string, caseInsensitive, normInsensitive bool) bool {
   189		if normInsensitive {
   190			left = norm.NFD.String(left)
   191			right = norm.NFD.String(right)
   192		}
   193		if caseInsensitive {
   194			return strings.EqualFold(left, right)
   195		}
   196		return left == right
   197	}
   198	
   199	func existingNamespaceAncestor(path string) (string, error) {
   200		current := filepath.Clean(path)
   201		for {
   202			if _, err := os.Lstat(current); err == nil {
   203				return current, nil
   204			} else if !os.IsNotExist(err) {
   205				return "", err
   206			}
   207			parent := filepath.Dir(current)
   208			if parent == current {
   209				return "", fmt.Errorf("path has no existing ancestor: %s", path)
   210			}
   211			current = parent
   212		}
   213	}

