   697			removals = appendRemovalCandidate(removals, index, target.BackupPath, target.BackupDigest)
   698			removals = appendRemovalCandidate(removals, index, target.RollbackPath, target.DesiredDigest)
   699			removals = appendRemovalCandidate(removals, index, target.StagedPath, target.DesiredDigest)
   700		}
   701		return removals
   702	}
   703	
   704	func rollbackRemovalCandidates(journal *Journal) []removalCandidate {
   705		removals := make([]removalCandidate, 0, len(journal.Targets)*3)
   706		for index := len(journal.Targets) - 1; index >= 0; index-- {
   707			target := &journal.Targets[index]
   708			removals = appendRemovalCandidate(removals, index, target.StagedPath, target.DesiredDigest)
   709			removals = appendRemovalCandidate(removals, index, target.BackupPath, target.BackupDigest)
