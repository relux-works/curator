+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+
+	"github.com/relux-works/curator/internal/transaction"
+)
+
+type testLock struct{}
+
+func (testLock) AssertHeld() error { return nil }
+
+func main() {
+	if len(os.Args) > 1 && os.Args[1] == "child" {
+		child()
+		return
+	}
+	root, err := os.MkdirTemp("", "transaction-prefix-truncation-")
+	must(err)
+	defer os.RemoveAll(root)
+	home := filepath.Join(root, "home")
+	live := filepath.Join(root, "live", "target")
+	source := filepath.Join(root, "source", "target")
+	must(os.MkdirAll(filepath.Dir(live), 0o755))
+	must(os.MkdirAll(filepath.Dir(source), 0o755))
+	must(os.WriteFile(live, []byte("old"), 0o644))
+	must(os.WriteFile(source, []byte(strings.Repeat("desired-staging-payload-", 5000)), 0o644))
+
+	executable, err := os.Executable()
+	must(err)
+	command := exec.Command(executable, "child", home, live, source)
+	err = command.Run()
+	var exitErr *exec.ExitError
+	if !errors.As(err, &exitErr) || exitErr.ExitCode() != 86 {
+		panic(fmt.Sprintf("child exit = %v, want 86", err))
+	}
+
+	paths, err := filepath.Glob(filepath.Join(home, "state", "transactions", "v1", "*.json"))
+	must(err)
+	if len(paths) != 1 {
+		panic(fmt.Sprintf("journal count = %d, want 1", len(paths)))
+	}
+	payload, err := os.ReadFile(paths[0])
+	must(err)
+	var journal transaction.Journal
+	must(json.Unmarshal(payload, &journal))
+	staged := journal.Targets[0].StagedPath
+	before, err := os.Stat(staged)
+	must(err)
+	if before.Size() < 2 {
+		panic(fmt.Sprintf("partial staged size = %d", before.Size()))
+	}
+	truncatedSize := before.Size() / 2
+	must(os.Truncate(staged, truncatedSize))
+
+	engine, err := transaction.New(home)
+	must(err)
+	recoverErr := engine.Recover(testLock{})
+	_, stagedErr := os.Lstat(staged)
+	_, journalErr := os.Lstat(paths[0])
+	livePayload, readErr := os.ReadFile(live)
+	fmt.Printf("partial_before=%d truncated_to=%d recover_error=%v staged_exists=%t journal_exists=%t live=%q live_read_error=%v\n",
+		before.Size(), truncatedSize, recoverErr, stagedErr == nil, journalErr == nil, string(livePayload), readErr)
+}
+
+func child() {
+	home, live, source := os.Args[2], os.Args[3], os.Args[4]
+	preimage, err := transaction.DigestPath(live)
+	must(err)
+	engine, err := transaction.New(home, transaction.WithHooks(transaction.Hooks{Fault: func(event transaction.Event) error {
+		if event.Point == transaction.PointDuringStagingCopy {
+			os.Exit(86)
+		}
+		return nil
+	}}))
+	must(err)
+	_, err = engine.Prepare(testLock{}, transaction.Plan{
+		TransactionID:   "txn-prefix-truncation",
+		ProjectIdentity: "/reviewer-probe",
+		Targets: []transaction.Target{{
+			Class: "class", Identifier: "target", LivePath: live, StagedSource: source, PreimageDigest: preimage,
+		}},
+	})
+	must(err)
+}
+
+func must(err error) {
+	if err != nil {
+		panic(err)
+	}
+}

