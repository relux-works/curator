   812	func (engine *Engine) emit(journal *Journal, targetIndex int, point Point) error {
   813		event := Event{Point: point, TransactionID: journal.TransactionID, TargetIndex: targetIndex}
   814		if targetIndex >= 0 {
   815			event.Class = journal.Targets[targetIndex].Class
   816			event.Identifier = journal.Targets[targetIndex].Identifier
   817		}
   818		if engine.hooks.Observe != nil {
   819			engine.hooks.Observe(event)
   820		}
   821		if engine.hooks.Fault != nil {
   822			return engine.hooks.Fault(event)
   823		}
   824		return nil
   825	}
