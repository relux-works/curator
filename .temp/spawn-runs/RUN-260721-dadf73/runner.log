+	ImportStack []string
+	Pos         string
+	Err         string
+}
+
+type moduleJSON struct {
+	Path      string
+	Query     string
+	Version   string
+	Versions  []string
+	Replace   *moduleJSON
+	Time      *json.RawMessage
+	Update    *moduleJSON
+	Main      bool
+	Indirect  bool
