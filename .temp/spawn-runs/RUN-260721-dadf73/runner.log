+func TestBuildUsesOnlyFixedListAndBuildWithHostPolicy(t *testing.T) {
+	fixture := newBuildFixture(t)
+	payload := encodePackages(t, fixture.rootPackage())
+	executor := &recordingExecutor{run: func(index int, process Process) (Output, error) {
+		switch index {
+		case 0:
+			return Output{Stdout: payload}, nil
+		case 1:
+			writeTestFile(t, process.Arguments[9], []byte("verified executable"), 0o600)
+			return Output{}, nil
+		default:
+			t.Fatalf("unexpected executable call %d", index)
+			return Output{}, nil
+		}
+	}}
+	limits := ResourceLimits{Timeout: time.Second, OutputBytes: 64 * 1024, ArtifactBytes: 1024, DiskBytes: 8 * 1024 * 1024, MemoryBytes: 64 * 1024 * 1024, Processes: 8}
+	artifact, err := Build(context.Background(), fixture.request(NewHostPolicy(executor), limits))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(executor.calls) != 2 {
+		t.Fatalf("calls = %d, want fixed list + build", len(executor.calls))
+	}
+	if !reflect.DeepEqual(executor.calls[0].Arguments, listArguments) {
+		t.Fatalf("list argv = %q", executor.calls[0].Arguments)
+	}
+	wantBuild := []string{"build", "-mod=vendor", "-trimpath", "-buildvcs=false", "-buildmode=exe", "-compiler=gc", "-pgo=off", "-ldflags=-linkmode=internal -libgcc=none", "-o", artifact.StagedPath, "."}
+	if !reflect.DeepEqual(executor.calls[1].Arguments, wantBuild) {
+		t.Fatalf("build argv = %q", executor.calls[1].Arguments)
+	}
+	for _, call := range executor.calls {
+		if call.Executable != fixture.session.Executable() || call.Directory != fixture.sourceDir || call.Timeout != limits.Timeout || call.OutputLimit != limits.OutputBytes {
+			t.Fatalf("process = %+v", call)
+		}
+		assertFixedBuildEnvironment(t, call.Environment, fixture.session)
+	}
+	wantHash := sha256.Sum256([]byte("verified executable"))
+	if artifact.Metadata.Path != filepath.ToSlash(filepath.Join("bin", "golden-tool")) || artifact.Metadata.Size != int64(len("verified executable")) || artifact.Metadata.SHA256 != "sha256:"+hex.EncodeToString(wantHash[:]) {
+		t.Fatalf("artifact = %+v", artifact)
+	}
+	info, err := os.Lstat(artifact.StagedPath)
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0o111 == 0 {
+		t.Fatalf("artifact permissions/type = %v, %v", info, err)
+	}
+}
+
+func TestBuildStopsBeforeBuildForEveryPreflightRejectionClass(t *testing.T) {
+	tests := []struct {
+		name string
+		code string
+		edit func(*buildFixture, *packageJSON)
+	}{
+		{name: "non main", code: "build_package_not_main", edit: func(_ *buildFixture, item *packageJSON) { item.Name = "library" }},
+		{name: "incomplete", code: "go_list_incomplete", edit: func(_ *buildFixture, item *packageJSON) { item.Incomplete = true }},
+		{name: "package error", code: "go_list_incomplete", edit: func(_ *buildFixture, item *packageJSON) { item.Error = &packageError{Err: "bad"} }},
+		{name: "dependency error", code: "go_list_incomplete", edit: func(_ *buildFixture, item *packageJSON) { item.DepsErrors = []*packageError{{Err: "bad"}} }},
+		{name: "test package", code: "go_test_input_forbidden", edit: func(_ *buildFixture, item *packageJSON) { item.ForTest = "x" }},
+		{name: "cgo", code: "cgo_required", edit: func(_ *buildFixture, item *packageJSON) { item.CgoFiles = []string{"cgo.go"} }},
+		{name: "native", code: "go_native_input_forbidden", edit: func(_ *buildFixture, item *packageJSON) { item.CFiles = []string{"x.c"} }},
+		{name: "assembly", code: "go_assembly_forbidden", edit: func(_ *buildFixture, item *packageJSON) { item.SFiles = []string{"x.s"} }},
+		{name: "syso", code: "go_syso_forbidden", edit: func(_ *buildFixture, item *packageJSON) { item.SysoFiles = []string{"x.syso"} }},
+		{name: "escaped source", code: "go_source_input_escape", edit: func(_ *buildFixture, item *packageJSON) { item.GoFiles = []string{"../../../../outside.go"} }},
+		{name: "escaped embed", code: "go_embed_input_escape", edit: func(_ *buildFixture, item *packageJSON) { item.EmbedFiles = []string{"../../../../outside.txt"} }},
+		{name: "replaced module", code: "vendor_metadata_inconsistent", edit: func(_ *buildFixture, item *packageJSON) { item.Module.Replace = &moduleJSON{Path: "evil"} }},
+	}
+	for _, testCase := range tests {
+		t.Run(testCase.name, func(t *testing.T) {
+			fixture := newBuildFixture(t)
+			item := fixture.rootPackage()
+			testCase.edit(fixture, &item)
+			calls := 0
+			policy := hostPolicyFunc(func(_ context.Context, execution HostExecution) (Output, error) {
+				calls++
+				return Output{Stdout: encodePackages(t, item)}, nil
+			})
+			_, err := Build(context.Background(), fixture.request(policy, ResourceLimits{}))
+			if DiagnosticCode(err) != testCase.code {
+				t.Fatalf("error = %v, want %s", err, testCase.code)
+			}
+			if calls != 1 {
+				t.Fatalf("calls = %d, build must not start after preflight rejection", calls)
+			}
+		})
+	}
+}
