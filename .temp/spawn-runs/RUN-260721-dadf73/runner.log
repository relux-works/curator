+func TestBuildRejectsWorkspaceAndPackageSelectedToolchainBeforeGo(t *testing.T) {
+	for _, testCase := range []struct {
+		name, code string
+		write      func(*buildFixture)
+	}{
+		{name: "workspace", code: "workspace_dependency_forbidden", write: func(fixture *buildFixture) {
+			writeTestFile(fixture.t, filepath.Join(fixture.buildRoot, "go.work"), []byte("go 1.23\nuse .\n"), 0o444)
+		}},
+		{name: "toolchain", code: "toolchain_switch_forbidden", write: func(fixture *buildFixture) {
+			writeTestFile(fixture.t, filepath.Join(fixture.buildRoot, "go.mod"), []byte("module example.test/build\n\ngo 1.23\ntoolchain go1.99.0\n"), 0o444)
+		}},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			fixture := newBuildFixture(t)
+			fixture.makeWritable()
+			testCase.write(fixture)
+			fixture.makeReadOnly()
+			fixture.refreshToken()
+			calls := 0
+			policy := hostPolicyFunc(func(_ context.Context, _ HostExecution) (Output, error) {
+				calls++
+				return Output{}, nil
+			})
+			_, err := Build(context.Background(), fixture.request(policy, ResourceLimits{}))
+			if DiagnosticCode(err) != testCase.code || calls != 0 {
+				t.Fatalf("error/calls = %v/%d", err, calls)
+			}
+		})
+	}
+}
+
+func TestBuildDetectsSourceMutationThroughLastChildAndNeverStartsOutput(t *testing.T) {
+	fixture := newBuildFixture(t)
+	calls := 0
+	policy := hostPolicyFunc(func(_ context.Context, execution HostExecution) (Output, error) {
+		calls++
+		if calls != 1 {
+			t.Fatal("build or artifact execution started after source mutation")
+		}
+		fixture.makeWritable()
+		writeTestFile(t, filepath.Join(fixture.sourceDir, "main.go"), []byte("package main\nfunc main() { panic(\"mutated\") }\n"), 0o644)
+		return Output{Stdout: encodePackages(t, fixture.rootPackage())}, nil
+	})
+	_, err := Build(context.Background(), fixture.request(policy, ResourceLimits{}))
+	if DiagnosticCode(err) != "source_mutated" || calls != 1 {
+		t.Fatalf("error/calls = %v/%d", err, calls)
+	}
+}
+
+func TestHostPolicyRejectsEveryAttemptToWidenExecution(t *testing.T) {
+	for _, testCase := range []struct {
+		name, code string
+		mutate     func(*HostExecution)
+	}{
+		{name: "another executable", code: "unexpected_child_process", mutate: func(execution *HostExecution) { execution.Process.Executable = os.Args[0] }},
+		{name: "another argv", code: "unexpected_go_arguments", mutate: func(execution *HostExecution) { execution.Process.Arguments = []string{"run", "."} }},
+		{name: "network permitted", code: "host_policy_invalid", mutate: func(execution *HostExecution) { execution.NetworkDenied = false }},
+		{name: "poisoned variable", code: "process_environment_poisoned", mutate: func(execution *HostExecution) {
+			execution.Process.Environment = append(execution.Process.Environment, "GOAUTH=netrc")
+		}},
+		{name: "writable source", code: "host_policy_invalid", mutate: func(execution *HostExecution) {
+			execution.WritableRoots = append(execution.WritableRoots, execution.ReadOnlyRoots[0])
+		}},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			fixture := newBuildFixture(t)
+			executor := &recordingExecutor{run: func(_ int, _ Process) (Output, error) {
+				t.Fatal("guarded executor started after policy widening")
+				return Output{}, nil
+			}}
+			guarded := NewHostPolicy(executor)
+			policy := hostPolicyFunc(func(ctx context.Context, execution HostExecution) (Output, error) {
+				testCase.mutate(&execution)
+				return guarded.Run(ctx, execution)
+			})
+			_, err := Build(context.Background(), fixture.request(policy, ResourceLimits{}))
+			if DiagnosticCode(err) != testCase.code || len(executor.calls) != 0 {
+				t.Fatalf("error/calls = %v/%d", err, len(executor.calls))
+			}
+		})
+	}
+}
+
+func TestBuildPresentsReadonlyNetworkAndAllResourceControls(t *testing.T) {
+	fixture := newBuildFixture(t)
+	limits := ResourceLimits{Timeout: 3 * time.Second, OutputBytes: 8192, ArtifactBytes: 4096, DiskBytes: 8 * 1024 * 1024, MemoryBytes: 32 * 1024 * 1024, Processes: 3}
+	var calls []HostExecution
+	policy := hostPolicyFunc(func(_ context.Context, execution HostExecution) (Output, error) {
+		calls = append(calls, execution)
+		if len(calls) == 1 {
+			return Output{Stdout: encodePackages(t, fixture.rootPackage())}, nil
+		}
+		writeTestFile(t, execution.Process.Arguments[9], []byte("artifact"), 0o600)
+		return Output{}, nil
+	})
+	if _, err := Build(context.Background(), fixture.request(policy, limits)); err != nil {
+		t.Fatal(err)
+	}
+	if len(calls) != 2 {
+		t.Fatalf("calls = %d", len(calls))
+	}
+	for _, call := range calls {
+		if !call.NetworkDenied || !reflect.DeepEqual(call.Limits, limits) || len(call.ReadOnlyRoots) != 2 || len(call.WritableRoots) < 8 || len(call.AllowedExecutables) != 2 {
+			t.Fatalf("host policy input = %+v", call)
+		}
+		for _, writable := range call.WritableRoots {
+			if writable == call.ReadOnlyRoots[0] || writable == call.ReadOnlyRoots[1] || isWithin(writable, call.ReadOnlyRoots[0]) || isWithin(writable, call.ReadOnlyRoots[1]) {
+				t.Fatalf("writable root overlaps readonly input: %+v", call)
+			}
+		}
+	}
+}
