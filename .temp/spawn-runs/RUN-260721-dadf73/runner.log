--- /dev/null
+++ b/.temp/TASK-260720-1zntv0/worktree/internal/godriver/testdata/realbuild/build/cmd/golden-tool/main.go
@@ -0,0 +1,15 @@
+package main
+
+import (
+	_ "embed"
+	"fmt"
+
+	"example.test/vendored/message"
+)
+
