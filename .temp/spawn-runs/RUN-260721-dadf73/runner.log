+func TestBuildRejectsHardLinkedArtifact(t *testing.T) {
+	fixture := newBuildFixture(t)
+	calls := 0
+	policy := hostPolicyFunc(func(_ context.Context, execution HostExecution) (Output, error) {
+		calls++
+		if calls == 1 {
+			return Output{Stdout: encodePackages(t, fixture.rootPackage())}, nil
+		}
+		outside := filepath.Join(fixture.session.operation, "outside-artifact")
+		writeTestFile(t, outside, []byte("linked"), 0o600)
+		if err := os.Link(outside, execution.Process.Arguments[9]); err != nil {
+			t.Skipf("hard links unavailable: %v", err)
+		}
+		return Output{}, nil
+	})
+	_, err := Build(context.Background(), fixture.request(policy, ResourceLimits{}))
+	if DiagnosticCode(err) != "artifact_link" || calls != 2 {
+		t.Fatalf("error/calls = %v/%d", err, calls)
+	}
