+	Doc        string
+	Target     string
+	Shlib      string
+	Root       string
+	ConflictDir string
+	ForTest    string
+	Export     string
+	BuildID    string
+	Module     *moduleJSON
+	Match      []string
+	Goroot     bool
+	Standard   bool
+	DepOnly    bool
+	BinaryOnly bool
+	Incomplete bool
+	Stale      bool
+	StaleReason string
+	Error      *packageError
+	DepsErrors []*packageError
+
+	GoFiles         []string
+	CgoFiles        []string
+	CompiledGoFiles []string
+	IgnoredGoFiles  []string
+	IgnoredOtherFiles []string
+	CFiles          []string
+	CXXFiles        []string
+	MFiles          []string
+	HFiles          []string
+	FFiles          []string
+	SFiles          []string
+	SwigFiles       []string
+	SwigCXXFiles    []string
+	SysoFiles       []string
+	EmbedFiles      []string
+	EmbedPatterns   []string
+	TestGoFiles     []string
+	XTestGoFiles    []string
+	Imports         []string
