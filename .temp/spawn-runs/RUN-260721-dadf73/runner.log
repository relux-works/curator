+func TestHostPolicyRejectsEveryAttemptToWidenExecution(t *testing.T) {
+	for _, testCase := range []struct {
+		name, code string
+		mutate     func(*HostExecution)
+	}{
+		{name: "another executable", code: "unexpected_child_process", mutate: func(execution *HostExecution) { execution.Process.Executable = os.Args[0] }},
+		{name: "another argv", code: "unexpected_go_arguments", mutate: func(execution *HostExecution) { execution.Process.Arguments = []string{"run", "."} }},
+		{name: "network permitted", code: "host_policy_invalid", mutate: func(execution *HostExecution) { execution.NetworkDenied = false }},
+		{name: "poisoned variable", code: "process_environment_poisoned", mutate: func(execution *HostExecution) {
+			execution.Process.Environment = append(execution.Process.Environment, "GOAUTH=netrc")
+		}},
+		{name: "writable source", code: "host_policy_invalid", mutate: func(execution *HostExecution) {
+			execution.WritableRoots = append(execution.WritableRoots, execution.ReadOnlyRoots[0])
+		}},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			fixture := newBuildFixture(t)
+			executor := &recordingExecutor{run: func(_ int, _ Process) (Output, error) {
+				t.Fatal("guarded executor started after policy widening")
+				return Output{}, nil
+			}}
+			guarded := NewHostPolicy(executor)
+			policy := hostPolicyFunc(func(ctx context.Context, execution HostExecution) (Output, error) {
+				testCase.mutate(&execution)
+				return guarded.Run(ctx, execution)
+			})
+			_, err := Build(context.Background(), fixture.request(policy, ResourceLimits{}))
+			if DiagnosticCode(err) != testCase.code || len(executor.calls) != 0 {
+				t.Fatalf("error/calls = %v/%d", err, len(executor.calls))
+			}
+		})
+	}
+}
