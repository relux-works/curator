+++ b/.temp/TASK-260720-1zntv0/worktree/internal/godriver/build_test.go
@@ -0,0 +1,476 @@
+package godriver
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
