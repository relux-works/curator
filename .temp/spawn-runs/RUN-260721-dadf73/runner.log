+	if len(executor.calls) != 0 {
+		t.Fatalf("calls = %d", len(executor.calls))
+	}
+}
+
+func TestBuildRejectsArtifactLinksOversizeAndUnexpectedOutputs(t *testing.T) {
+	for _, testCase := range []struct {
+		name, code string
+		produce    func(*testing.T, string)
+	}{
+		{name: "link", code: "artifact_special_file", produce: func(t *testing.T, path string) {
+			if err := os.Symlink(filepath.Join(filepath.Dir(path), "missing"), path); err != nil {
+				t.Fatal(err)
+			}
+		}},
+		{name: "oversize", code: "artifact_size_limit", produce: func(t *testing.T, path string) { writeTestFile(t, path, make([]byte, 33), 0o600) }},
+		{name: "extra", code: "artifact_output_invalid", produce: func(t *testing.T, path string) {
+			writeTestFile(t, path, []byte("ok"), 0o600)
+			writeTestFile(t, filepath.Join(filepath.Dir(path), "extra"), []byte("bad"), 0o600)
+		}},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			fixture := newBuildFixture(t)
+			calls := 0
