@@ -0,0 +1,488 @@
+package godriver
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"testing"
+	"time"
+
+	"github.com/relux-works/curator/internal/buildsource"
+)
+
+func TestBuildUsesOnlyFixedListAndBuildWithHostPolicy(t *testing.T) {
+	fixture := newBuildFixture(t)
+	payload := encodePackages(t, fixture.rootPackage())
+	executor := &recordingExecutor{run: func(index int, process Process) (Output, error) {
+		switch index {
+		case 0:
+			return Output{Stdout: payload}, nil
+		case 1:
+			writeTestFile(t, process.Arguments[9], []byte("verified executable"), 0o600)
+			return Output{}, nil
+		default:
+			t.Fatalf("unexpected executable call %d", index)
+			return Output{}, nil
+		}
+	}}
+	limits := ResourceLimits{Timeout: time.Second, OutputBytes: 64 * 1024, ArtifactBytes: 1024, DiskBytes: 8 * 1024 * 1024, MemoryBytes: 64 * 1024 * 1024, Processes: 8}
+	artifact, err := Build(context.Background(), fixture.request(NewHostPolicy(executor), limits))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(executor.calls) != 2 {
+		t.Fatalf("calls = %d, want fixed list + build", len(executor.calls))
+	}
+	if !reflect.DeepEqual(executor.calls[0].Arguments, listArguments) {
+		t.Fatalf("list argv = %q", executor.calls[0].Arguments)
+	}
+	wantBuild := []string{"build", "-mod=vendor", "-trimpath", "-buildvcs=false", "-buildmode=exe", "-compiler=gc", "-pgo=off", "-ldflags=-linkmode=internal -libgcc=none", "-o", artifact.StagedPath, "."}
+	if !reflect.DeepEqual(executor.calls[1].Arguments, wantBuild) {
+		t.Fatalf("build argv = %q", executor.calls[1].Arguments)
+	}
+	for _, call := range executor.calls {
+		if call.Executable != fixture.session.Executable() || call.Directory != fixture.sourceDir || call.Timeout != limits.Timeout || call.OutputLimit != limits.OutputBytes {
+			t.Fatalf("process = %+v", call)
+		}
+		assertFixedBuildEnvironment(t, call.Environment, fixture.session)
+	}
+	wantHash := sha256.Sum256([]byte("verified executable"))
+	if artifact.Metadata.Path != filepath.ToSlash(filepath.Join("bin", "golden-tool")) || artifact.Metadata.Size != int64(len("verified executable")) || artifact.Metadata.SHA256 != "sha256:"+hex.EncodeToString(wantHash[:]) {
+		t.Fatalf("artifact = %+v", artifact)
+	}
+	info, err := os.Lstat(artifact.StagedPath)
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0o111 == 0 {
+		t.Fatalf("artifact permissions/type = %v, %v", info, err)
+	}
+}
+
+func TestBuildStopsBeforeBuildForEveryPreflightRejectionClass(t *testing.T) {
+	tests := []struct {
+		name string
+		code string
+		edit func(*buildFixture, *packageJSON)
+	}{
+		{name: "non main", code: "build_package_not_main", edit: func(_ *buildFixture, item *packageJSON) { item.Name = "library" }},
+		{name: "incomplete", code: "go_list_incomplete", edit: func(_ *buildFixture, item *packageJSON) { item.Incomplete = true }},
+		{name: "package error", code: "go_list_incomplete", edit: func(_ *buildFixture, item *packageJSON) { item.Error = &packageError{Err: "bad"} }},
+		{name: "dependency error", code: "go_list_incomplete", edit: func(_ *buildFixture, item *packageJSON) { item.DepsErrors = []*packageError{{Err: "bad"}} }},
+		{name: "test package", code: "go_test_input_forbidden", edit: func(_ *buildFixture, item *packageJSON) { item.ForTest = "x" }},
+		{name: "cgo", code: "cgo_required", edit: func(_ *buildFixture, item *packageJSON) { item.CgoFiles = []string{"cgo.go"} }},
+		{name: "native", code: "go_native_input_forbidden", edit: func(_ *buildFixture, item *packageJSON) { item.CFiles = []string{"x.c"} }},
+		{name: "assembly", code: "go_assembly_forbidden", edit: func(_ *buildFixture, item *packageJSON) { item.SFiles = []string{"x.s"} }},
+		{name: "syso", code: "go_syso_forbidden", edit: func(_ *buildFixture, item *packageJSON) { item.SysoFiles = []string{"x.syso"} }},
+		{name: "escaped source", code: "go_source_input_escape", edit: func(_ *buildFixture, item *packageJSON) { item.GoFiles = []string{"../../../../outside.go"} }},
+		{name: "escaped embed", code: "go_embed_input_escape", edit: func(_ *buildFixture, item *packageJSON) { item.EmbedFiles = []string{"../../../../outside.txt"} }},
+		{name: "replaced module", code: "vendor_metadata_inconsistent", edit: func(_ *buildFixture, item *packageJSON) { item.Module.Replace = &moduleJSON{Path: "evil"} }},
+	}
+	for _, testCase := range tests {
+		t.Run(testCase.name, func(t *testing.T) {
+			fixture := newBuildFixture(t)
+			item := fixture.rootPackage()
+			testCase.edit(fixture, &item)
+			calls := 0
+			policy := hostPolicyFunc(func(_ context.Context, execution HostExecution) (Output, error) {
+				calls++
+				return Output{Stdout: encodePackages(t, item)}, nil
+			})
+			_, err := Build(context.Background(), fixture.request(policy, ResourceLimits{}))
+			if DiagnosticCode(err) != testCase.code {
+				t.Fatalf("error = %v, want %s", err, testCase.code)
+			}
+			if calls != 1 {
+				t.Fatalf("calls = %d, build must not start after preflight rejection", calls)
+			}
+		})
+	}
+}
+
+func TestBuildRejectsDirectivesPGOAndMultipleRootsBeforeBuild(t *testing.T) {
+	for _, testCase := range []struct {
+		name, content, code string
+		multiple            bool
+	}{
+		{name: "cgo import dynamic", content: "package main\n//go:cgo_import_dynamic x y z\nfunc main() {}\n", code: "go_forbidden_compiler_directive"},
+		{name: "generator", content: "package main\n//go:generate forbidden\nfunc main() {}\n", code: "go_generator_forbidden"},
+		{name: "pgo", content: "package main\nfunc main() {}\n", code: "go_pgo_forbidden"},
+		{name: "multiple roots", content: "package main\nfunc main() {}\n", code: "build_package_ambiguous", multiple: true},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			fixture := newBuildFixture(t)
+			fixture.makeWritable()
+			writeTestFile(t, filepath.Join(fixture.sourceDir, "main.go"), []byte(testCase.content), 0o444)
+			if testCase.name == "pgo" {
+				writeTestFile(t, filepath.Join(fixture.sourceDir, "default.pgo"), []byte("attempt"), 0o444)
+			}
+			fixture.makeReadOnly()
+			fixture.refreshToken()
+			item := fixture.rootPackage()
+			items := []packageJSON{item}
+			if testCase.multiple {
+				second := item
+				second.ImportPath = "example.test/other"
+				items = append(items, second)
+			}
+			calls := 0
+			policy := hostPolicyFunc(func(_ context.Context, execution HostExecution) (Output, error) {
+				calls++
+				return Output{Stdout: encodePackages(t, items...)}, nil
+			})
+			_, err := Build(context.Background(), fixture.request(policy, ResourceLimits{}))
+			if DiagnosticCode(err) != testCase.code {
+				t.Fatalf("error = %v, want %s", err, testCase.code)
+			}
+			if calls != 1 {
+				t.Fatalf("calls = %d", calls)
+			}
+		})
+	}
+}
+
+func TestBuildRejectsWritableSourceAndPoisonedPolicyInputs(t *testing.T) {
+	fixture := newBuildFixture(t)
+	fixture.makeWritable()
+	executor := &recordingExecutor{run: func(_ int, _ Process) (Output, error) {
+		t.Fatal("executor must not start for writable source")
+		return Output{}, nil
+	}}
+	_, err := Build(context.Background(), fixture.request(NewHostPolicy(executor), ResourceLimits{}))
+	if DiagnosticCode(err) != "source_not_readonly" {
+		t.Fatalf("error = %v", err)
+	}
+	if len(executor.calls) != 0 {
+		t.Fatalf("calls = %d", len(executor.calls))
+	}
+}
+
+func TestBuildRejectsArtifactLinksOversizeAndUnexpectedOutputs(t *testing.T) {
+	for _, testCase := range []struct {
+		name, code string
+		produce    func(*testing.T, string)
+	}{
+		{name: "link", code: "artifact_special_file", produce: func(t *testing.T, path string) {
+			if err := os.Symlink(filepath.Join(filepath.Dir(path), "missing"), path); err != nil {
+				t.Fatal(err)
+			}
+		}},
+		{name: "oversize", code: "artifact_size_limit", produce: func(t *testing.T, path string) { writeTestFile(t, path, make([]byte, 33), 0o600) }},
+		{name: "extra", code: "artifact_output_invalid", produce: func(t *testing.T, path string) {
+			writeTestFile(t, path, []byte("ok"), 0o600)
+			writeTestFile(t, filepath.Join(filepath.Dir(path), "extra"), []byte("bad"), 0o600)
+		}},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			fixture := newBuildFixture(t)
+			calls := 0
+			policy := hostPolicyFunc(func(_ context.Context, execution HostExecution) (Output, error) {
+				calls++
+				if calls == 1 {
+					return Output{Stdout: encodePackages(t, fixture.rootPackage())}, nil
+				}
+				testCase.produce(t, execution.Process.Arguments[9])
+				return Output{}, nil
+			})
+			limits := ResourceLimits{ArtifactBytes: 32, DiskBytes: 1024 * 1024}
+			_, err := Build(context.Background(), fixture.request(policy, limits))
+			if DiagnosticCode(err) != testCase.code {
+				t.Fatalf("error = %v, want %s", err, testCase.code)
+			}
+			if calls != 2 {
+				t.Fatalf("calls = %d", calls)
+			}
+		})
+	}
+}
+
+func TestBuildClassifiesOfflineVendorAndToolchainFailures(t *testing.T) {
+	for _, testCase := range []struct{ name, stderr, code string }{
+		{name: "missing vendor", stderr: "cannot find module providing package example.test/missing: import lookup disabled by -mod=vendor", code: "vendor_dependency_missing"},
+		{name: "inconsistent vendor", stderr: "go: inconsistent vendoring in /source", code: "vendor_metadata_inconsistent"},
+		{name: "toolchain", stderr: "go.mod requires go >= 1.99.0 (running go 1.25.5; GOTOOLCHAIN=local)", code: "toolchain_switch_forbidden"},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			fixture := newBuildFixture(t)
+			calls := 0
+			policy := hostPolicyFunc(func(_ context.Context, _ HostExecution) (Output, error) {
+				calls++
+				return Output{Stderr: []byte(testCase.stderr)}, errors.New("exit status 1")
+			})
+			_, err := Build(context.Background(), fixture.request(policy, ResourceLimits{}))
+			if DiagnosticCode(err) != testCase.code || calls != 1 {
+				t.Fatalf("error/calls = %v/%d", err, calls)
+			}
+		})
+	}
+}
+
+func TestBuildDetectsSourceMutationThroughLastChildAndNeverStartsOutput(t *testing.T) {
+	fixture := newBuildFixture(t)
+	calls := 0
+	policy := hostPolicyFunc(func(_ context.Context, execution HostExecution) (Output, error) {
+		calls++
+		if calls != 1 {
+			t.Fatal("build or artifact execution started after source mutation")
+		}
+		fixture.makeWritable()
+		writeTestFile(t, filepath.Join(fixture.sourceDir, "main.go"), []byte("package main\nfunc main() { panic(\"mutated\") }\n"), 0o644)
+		return Output{Stdout: encodePackages(t, fixture.rootPackage())}, nil
+	})
+	_, err := Build(context.Background(), fixture.request(policy, ResourceLimits{}))
+	if DiagnosticCode(err) != "source_mutated" || calls != 1 {
+		t.Fatalf("error/calls = %v/%d", err, calls)
+	}
+}
+
+func TestHostPolicyRejectsEveryAttemptToWidenExecution(t *testing.T) {
+	for _, testCase := range []struct {
+		name, code string
+		mutate     func(*HostExecution)
+	}{
+		{name: "another executable", code: "unexpected_child_process", mutate: func(execution *HostExecution) { execution.Process.Executable = os.Args[0] }},
+		{name: "another argv", code: "unexpected_go_arguments", mutate: func(execution *HostExecution) { execution.Process.Arguments = []string{"run", "."} }},
+		{name: "network permitted", code: "host_policy_invalid", mutate: func(execution *HostExecution) { execution.NetworkDenied = false }},
+		{name: "poisoned variable", code: "process_environment_poisoned", mutate: func(execution *HostExecution) {
+			execution.Process.Environment = append(execution.Process.Environment, "GOAUTH=netrc")
+		}},
+		{name: "writable source", code: "host_policy_invalid", mutate: func(execution *HostExecution) {
+			execution.WritableRoots = append(execution.WritableRoots, execution.ReadOnlyRoots[0])
+		}},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			fixture := newBuildFixture(t)
+			executor := &recordingExecutor{run: func(_ int, _ Process) (Output, error) {
+				t.Fatal("guarded executor started after policy widening")
+				return Output{}, nil
+			}}
+			guarded := NewHostPolicy(executor)
+			policy := hostPolicyFunc(func(ctx context.Context, execution HostExecution) (Output, error) {
+				testCase.mutate(&execution)
+				return guarded.Run(ctx, execution)
+			})
+			_, err := Build(context.Background(), fixture.request(policy, ResourceLimits{}))
+			if DiagnosticCode(err) != testCase.code || len(executor.calls) != 0 {
+				t.Fatalf("error/calls = %v/%d", err, len(executor.calls))
+			}
+		})
+	}
+}
+
+func TestBuildPresentsReadonlyNetworkAndAllResourceControls(t *testing.T) {
+	fixture := newBuildFixture(t)
+	limits := ResourceLimits{Timeout: 3 * time.Second, OutputBytes: 8192, ArtifactBytes: 4096, DiskBytes: 8 * 1024 * 1024, MemoryBytes: 32 * 1024 * 1024, Processes: 3}
+	var calls []HostExecution
+	policy := hostPolicyFunc(func(_ context.Context, execution HostExecution) (Output, error) {
+		calls = append(calls, execution)
+		if len(calls) == 1 {
+			return Output{Stdout: encodePackages(t, fixture.rootPackage())}, nil
+		}
+		writeTestFile(t, execution.Process.Arguments[9], []byte("artifact"), 0o600)
+		return Output{}, nil
+	})
+	if _, err := Build(context.Background(), fixture.request(policy, limits)); err != nil {
+		t.Fatal(err)
+	}
+	if len(calls) != 2 {
+		t.Fatalf("calls = %d", len(calls))
+	}
+	for _, call := range calls {
+		if !call.NetworkDenied || !reflect.DeepEqual(call.Limits, limits) || len(call.ReadOnlyRoots) != 2 || len(call.WritableRoots) < 8 || len(call.AllowedExecutables) != 2 {
+			t.Fatalf("host policy input = %+v", call)
+		}
+		for _, writable := range call.WritableRoots {
+			if writable == call.ReadOnlyRoots[0] || writable == call.ReadOnlyRoots[1] || isWithin(writable, call.ReadOnlyRoots[0]) || isWithin(writable, call.ReadOnlyRoots[1]) {
+				t.Fatalf("writable root overlaps readonly input: %+v", call)
+			}
+		}
+	}
+}
+
+func TestRealGoV1VendoredBuildIsBoundedAndNotLaunched(t *testing.T) {
+	if os.Getenv("CURATOR_REAL_GO_BUILD_TEST") != "1" {
+		t.Skip("set CURATOR_REAL_GO_BUILD_TEST=1 for the bounded native go-v1 integration")
+	}
+	snapshot := filepath.Join(t.TempDir(), "snapshot")
+	fixtureRoot := "testdata/realbuild"
+	buildRootRel := "build"
+	sourceDirRel := "build/cmd/golden-tool"
+	if candidate := os.Getenv("CURATOR_CONFORMANCE_ROOT"); candidate != "" {
+		fixtureRoot = filepath.Join(candidate, "fixtures", "go-build-skill")
+		buildRootRel = "assets/build-tool"
+		sourceDirRel = "assets/build-tool/cmd/golden-tool"
+	}
+	if err := os.CopyFS(snapshot, os.DirFS(fixtureRoot)); err != nil {
+		t.Fatal(err)
+	}
+	snapshot = mustPhysical(t, snapshot)
+	token, err := buildsource.Validate(snapshot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer token.Close()
+	chmodSnapshot(t, snapshot, 0o555, 0o444)
+	defer chmodSnapshot(t, snapshot, 0o755, 0o644)
+
+	config := ConfigFromEnvironment(t.TempDir(), snapshot)
+	config.CuratorGo = filepath.Join(runtime.GOROOT(), "bin", platformGoName)
+	session, err := Establish(context.Background(), config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer session.Close()
+
+	delegate := NewHostPolicy(nil)
+	var calls []HostExecution
+	policy := hostPolicyFunc(func(ctx context.Context, execution HostExecution) (Output, error) {
+		calls = append(calls, execution)
+		return delegate.Run(ctx, execution)
+	})
+	artifact, err := Build(context.Background(), BuildRequest{
+		Session: session, Source: token, BuildRoot: buildRootRel, SourceDir: sourceDirRel, Command: "golden-tool", Policy: policy,
+		Limits: ResourceLimits{Timeout: 30 * time.Second, OutputBytes: 2 * 1024 * 1024, ArtifactBytes: 16 * 1024 * 1024, DiskBytes: 256 * 1024 * 1024, MemoryBytes: defaultMemoryLimit, Processes: defaultProcessLimit},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(calls) != 2 || !reflect.DeepEqual(calls[0].Process.Arguments, listArguments) || calls[1].Process.Arguments[0] != "build" {
+		t.Fatalf("direct process graph = %+v", calls)
+	}
+	if artifact.Metadata.Size <= 0 || artifact.Metadata.Size > 16*1024*1024 || artifact.Metadata.SHA256 == "" {
+		t.Fatalf("artifact = %+v", artifact)
+	}
+	// Deliberately do not execute artifact.StagedPath. Two direct Go calls are
+	// the complete source-aware graph observed by the host-policy boundary.
+}
+
+func chmodSnapshot(t *testing.T, root string, directoryMode, fileMode os.FileMode) {
+	t.Helper()
+	if err := filepath.WalkDir(root, func(path string, entry os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		mode := fileMode
+		if entry.IsDir() {
+			mode = directoryMode
+		}
+		return os.Chmod(path, mode)
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+type hostPolicyFunc func(context.Context, HostExecution) (Output, error)
+
+func (function hostPolicyFunc) Run(ctx context.Context, execution HostExecution) (Output, error) {
+	return function(ctx, copyHostExecution(execution))
+}
+
+type buildFixture struct {
+	t         *testing.T
+	root      string
+	buildRoot string
+	sourceDir string
+	token     *buildsource.Token
+	session   *Session
+}
+
+func newBuildFixture(t *testing.T) *buildFixture {
+	t.Helper()
+	snapshot := filepath.Join(t.TempDir(), "snapshot")
+	buildRoot := filepath.Join(snapshot, "build")
+	sourceDir := filepath.Join(buildRoot, "cmd", "tool")
+	writeTestFile(t, filepath.Join(buildRoot, "go.mod"), []byte("module example.test/build\n\ngo 1.23\n"), 0o644)
+	writeTestFile(t, filepath.Join(sourceDir, "main.go"), []byte("package main\nfunc main() {}\n"), 0o644)
+	snapshot = mustPhysical(t, snapshot)
+	buildRoot = filepath.Join(snapshot, "build")
+	sourceDir = filepath.Join(buildRoot, "cmd", "tool")
+	token, err := buildsource.Validate(snapshot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	toolchain := testToolchain(t)
+	host := hostFacts{runtimeGOROOT: toolchain, goos: runtime.GOOS, goarch: runtime.GOARCH}
+	session, err := establish(context.Background(), Config{PrivateBase: t.TempDir(), CuratorGo: filepath.Join(toolchain, "bin", platformGoName), Executor: validProbeExecutor(t, toolchain, host)}, host)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fixture := &buildFixture{t: t, root: snapshot, buildRoot: buildRoot, sourceDir: sourceDir, token: token, session: session}
+	fixture.makeReadOnly()
+	t.Cleanup(func() {
+		fixture.makeWritable()
+		_ = fixture.token.Close()
+		_ = session.Close()
+	})
+	return fixture
+}
+
+func (fixture *buildFixture) request(policy HostPolicy, limits ResourceLimits) BuildRequest {
+	return BuildRequest{Session: fixture.session, Source: fixture.token, BuildRoot: "build", SourceDir: "build/cmd/tool", Command: "golden-tool", Policy: policy, Limits: limits}
+}
+
+func (fixture *buildFixture) rootPackage() packageJSON {
+	return packageJSON{
+		Dir: fixture.sourceDir, ImportPath: "example.test/build/cmd/tool", Name: "main", GoFiles: []string{"main.go"},
+		Module: &moduleJSON{Path: "example.test/build", Main: true, Dir: fixture.buildRoot, GoMod: filepath.Join(fixture.buildRoot, "go.mod"), GoVersion: "1.23"},
+	}
+}
+
+func (fixture *buildFixture) makeReadOnly() { fixture.chmodTree(0o555, 0o444) }
+func (fixture *buildFixture) makeWritable() { fixture.chmodTree(0o755, 0o644) }
+
+func (fixture *buildFixture) refreshToken() {
+	fixture.t.Helper()
+	_ = fixture.token.Close()
+	token, err := buildsource.Validate(fixture.root)
+	if err != nil {
+		fixture.t.Fatal(err)
+	}
+	fixture.token = token
+}
+
+func (fixture *buildFixture) chmodTree(directoryMode, fileMode os.FileMode) {
+	fixture.t.Helper()
+	_ = filepath.WalkDir(fixture.root, func(path string, entry os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		mode := fileMode
+		if entry.IsDir() {
+			mode = directoryMode
+		}
+		return os.Chmod(path, mode)
+	})
+}
+
+func encodePackages(t *testing.T, packages ...packageJSON) []byte {
+	t.Helper()
+	var payload []byte
+	for _, item := range packages {
+		encoded, err := json.Marshal(item)
+		if err != nil {
+			t.Fatal(err)
+		}
+		payload = append(payload, encoded...)
+		payload = append(payload, '\n')
+	}
+	return payload
+}
+
+func assertFixedBuildEnvironment(t *testing.T, environment []string, session *Session) {
+	t.Helper()
+	if !reflect.DeepEqual(environment, session.Environment()) {
+		t.Fatalf("environment changed\n got: %q\nwant: %q", environment, session.Environment())
+	}
+	values := environmentMap(environment)
+	for key, want := range map[string]string{"GOPROXY": "off", "GOSUMDB": "off", "GOVCS": "*:off", "GOWORK": "off", "GOTOOLCHAIN": "local", "CGO_ENABLED": "0", "GO_EXTLINK_ENABLED": "0", "PATH": values["PATH"]} {
+		if values[key] != want {
+			t.Fatalf("%s = %q, want %q", key, values[key], want)
+		}
+	}
+	if entries, err := os.ReadDir(values["PATH"]); err != nil || len(entries) != 0 {
+		t.Fatalf("PATH is not empty/private: %v %v", entries, err)
+	}
+}
