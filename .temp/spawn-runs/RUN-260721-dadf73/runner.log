func ConfigFromEnvironment(privateBase string, forbiddenRoots ...string) Config {
	return Config{
		PrivateBase:    privateBase,
		CuratorGo:      os.Getenv("CURATOR_GO"),
		GOROOT:         os.Getenv("GOROOT"),
		ForbiddenRoots: append([]string(nil), forbiddenRoots...),
