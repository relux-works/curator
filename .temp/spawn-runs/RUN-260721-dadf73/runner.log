 		t.Run(test.name, func(t *testing.T) {
@@ -69,6 +70,10 @@
 	case "output":
 		_, _ = os.Stdout.Write(make([]byte, 4096))
 		os.Exit(0)
+	case "combined-output":
+		_, _ = os.Stdout.Write(make([]byte, 24))
+		_, _ = os.Stderr.Write(make([]byte, 24))
+		os.Exit(0)
 	case "timeout":
