diff --git a/.temp/TASK-260720-1zntv0/worktree/internal/godriver/testdata/realbuild/build/cmd/golden-tool/main.go b/.temp/TASK-260720-1zntv0/worktree/internal/godriver/testdata/realbuild/build/cmd/golden-tool/main.go
