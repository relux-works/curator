+	Goroot     bool
+	Standard   bool
+	DepOnly    bool
+	BinaryOnly bool
+	Incomplete bool
+	Stale      bool
+	StaleReason string
+	Error      *packageError
+	DepsErrors []*packageError
+
+	GoFiles         []string
