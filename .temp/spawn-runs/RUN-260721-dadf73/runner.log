+}
+
+func TestBuildEnforcesOutputDiskDeadlineAndNonzeroExit(t *testing.T) {
+	for _, testCase := range []struct {
+		name, code string
+		run        func(*testing.T, HostExecution) (Output, error)
+	}{
+		{name: "output", code: "process_output_limit", run: func(_ *testing.T, _ HostExecution) (Output, error) {
+			return Output{Stdout: make([]byte, 33)}, nil
+		}},
+		{name: "disk", code: "process_disk_limit", run: func(t *testing.T, execution HostExecution) (Output, error) {
+			cache := environmentMap(execution.Process.Environment)["GOCACHE"]
+			writeTestFile(t, filepath.Join(cache, "oversized"), make([]byte, 65), 0o600)
+			return Output{Stdout: []byte("{}\n")}, nil
+		}},
+		{name: "deadline", code: "process_timeout", run: func(_ *testing.T, _ HostExecution) (Output, error) {
+			return Output{}, errProcessTimeout
+		}},
+		{name: "nonzero", code: "go_list_failed", run: func(_ *testing.T, _ HostExecution) (Output, error) {
+			return Output{Stderr: []byte("compiler failed")}, errors.New("exit status 1")
+		}},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			fixture := newBuildFixture(t)
+			calls := 0
+			policy := hostPolicyFunc(func(_ context.Context, execution HostExecution) (Output, error) {
+				calls++
+				return testCase.run(t, execution)
+			})
+			limits := ResourceLimits{Timeout: time.Second, OutputBytes: 32, ArtifactBytes: 1, DiskBytes: 64, MemoryBytes: 1024, Processes: 1}
+			_, err := Build(context.Background(), fixture.request(policy, limits))
+			if DiagnosticCode(err) != testCase.code || calls != 1 {
+				t.Fatalf("error/calls = %v/%d", err, calls)
+			}
+			entries, readErr := os.ReadDir(fixture.session.operation)
+			if readErr != nil {
+				t.Fatal(readErr)
+			}
+			for _, entry := range entries {
+				if len(entry.Name()) >= len(".curator-go-build-") && entry.Name()[:len(".curator-go-build-")] == ".curator-go-build-" {
+					t.Fatalf("failed private staging was not removed: %s", entry.Name())
+				}
+			}
+		})
+	}
+}
