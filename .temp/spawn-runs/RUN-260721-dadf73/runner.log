+	Module     *moduleJSON
+	Match      []string
+	Goroot     bool
+	Standard   bool
+	DepOnly    bool
+	BinaryOnly bool
+	Incomplete bool
+	Stale      bool
+	StaleReason string
+	Error      *packageError
+	DepsErrors []*packageError
+
+	GoFiles         []string
+	CgoFiles        []string
+	CompiledGoFiles []string
+	IgnoredGoFiles  []string
+	IgnoredOtherFiles []string
+	CFiles          []string
+	CXXFiles        []string
+	MFiles          []string
+	HFiles          []string
