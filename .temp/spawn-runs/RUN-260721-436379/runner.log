func (engine *Engine) journalIDs() ([]string, error) {
	entries, err := os.ReadDir(engine.journalRoot)
	if os.IsNotExist(err) {
		return nil, nil
	}
	if err != nil {
		return nil, err
	}
	ids := make([]string, 0, len(entries))
	for _, entry := range entries {
		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".json") {
			continue
		}
		id := strings.TrimSuffix(entry.Name(), ".json")
		if !transactionIDPattern.MatchString(id) {
			return nil, journalf("unexpected journal filename %q", entry.Name())
		}
		ids = append(ids, id)
	}
	sort.Slice(ids, func(i, j int) bool { return bytes.Compare([]byte(ids[i]), []byte(ids[j])) < 0 })
	return ids, nil
}

func removeDurably(path string) error {
	tomb := path + ".delete"
	pathExists := true
	if _, err := os.Lstat(path); os.IsNotExist(err) {
		pathExists = false
	} else if err != nil {
		return err
	}
	if _, err := os.Lstat(tomb); err == nil {
		if err := os.RemoveAll(tomb); err != nil {
			return err
		}
		if err := syncDirectory(filepath.Dir(path)); err != nil {
			return err
		}
	} else if !os.IsNotExist(err) {
		return err
	}
	if !pathExists {
		return nil
	}
	if err := durableRenameNoReplace(path, tomb); err != nil {
		return err
	}
	if err := os.RemoveAll(tomb); err != nil {
		return err
	}
	return syncDirectory(filepath.Dir(path))
}

