	mustMkdirAll(t, filepath.Join(root, "stage"))
	target := fileTarget(t, "class", "race", filepath.Join(root, "live", "race"), filepath.Join(root, "stage", "race"), "old", "new")
	engine := mustEngine(t, filepath.Join(root, "home"))
