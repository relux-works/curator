="397.4961" cy="1635.5889" fill="#FFFFFF" rx="6" ry="6" style="stroke:#000000;stroke-width:1;"/><polygon fill="#FFFFFF" points="357.6936,1513.1125,437.2986,1513.1125,449.2986,1525.1125,437.2986,1537.1125,357.6936,1537.1125,345.6936,1525.1125,357.6936,1513.1125" style="stroke:#000000;stroke-width:1;stroke-linejoin:miter;stroke-miterlimit:10;"/><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="18.7935" x="401.4961" y="1548.1716">yes</text><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="79.605" x="357.6936" y="1529.4873">Plan changed?</text><text fill="#000000" font-family="Verdana" font-size="11" lengthAdjust="spacing" textLength="13.6372" x="449.2986" y="1522.803">no</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="276.7988" x="259.0967" y="1688.5889"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="256.7988" x="269.0967" y="1710.6533">Publish immutable protected cache entries</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="183.6641" x="305.6641" y="1743.1729"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="163.6641" x="315.6641" y="1765.2373">Create one rollback journal</text><rect fill="#FFFFFF" height="49.168" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width="345.4883" x="224.752" y="1797.7568"/><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="325.4883" x="234.752" y="1819.8213">Commit contexts, markers, runtime, shims, adapters,</text><text fill="#000000" font-family="Verdana" font-size="12" lengthAdjust="spacing" textLength="275.2676" x="234.752" y="1834.4053">and managed removals in deterministic order</text><rect fill="#FFFFFF" height="34.584" rx="12.5" ry="12.5" style="stroke:#000000;stroke-width:1;" width