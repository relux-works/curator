+	esac
+	[ "${#digest}" -eq 64 ] || die "hash tool returned a non-canonical sha256 digest for $file: '$digest'"
+	printf '%s\n' "$digest"
 }
 
 # A revision and a pre-materialised root are independent identities. Accepting
