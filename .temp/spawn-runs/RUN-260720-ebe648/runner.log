			}
			backups, err := filepath.Glob(filepath.Join(filepath.Dir(repaired), ".snapshot-replaced-*"))
			if err != nil || len(backups) != 0 {
				t.Fatalf("replacement remnants = %v, error = %v", backups, err)
			}
		})
	}
}

