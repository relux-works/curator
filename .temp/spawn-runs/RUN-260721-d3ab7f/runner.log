+func swapCase(value string) string {
+	var result strings.Builder
+	for _, character := range value {
+		switch {
+		case character >= 'a' && character <= 'z':
+			result.WriteRune(character - ('a' - 'A'))
+		case character >= 'A' && character <= 'Z':
+			result.WriteRune(character + ('a' - 'A'))
+		default:
+			result.WriteRune(character)
+		}
+	}
+	return result.String()
