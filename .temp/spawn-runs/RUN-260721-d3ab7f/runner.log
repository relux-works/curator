+	preCreationVariant := filepath.Join(parent, "Missing", "nESTED", "cURATORhOME")
+	first, err := New(home)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := New(preCreationVariant)
+	if err != nil {
+		t.Fatal(err)
+	}
+
