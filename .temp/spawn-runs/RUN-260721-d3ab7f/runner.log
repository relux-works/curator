+		t.Skipf("set directory case sensitivity to %t: %v", enabled, err)
+	}
+	current, err = directoryCaseSensitive(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if current != enabled {
+		t.Fatalf("directory case sensitivity = %t, want %t", current, enabled)
+	}
