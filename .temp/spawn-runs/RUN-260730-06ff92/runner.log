+    def permission_denied_for_candidate(
+        path: str | bytes | os.PathLike[str] | os.PathLike[bytes],
+        flags: int,
+        mode: int = 0o777,
+        *,
+        dir_fd: int | None = None,
+    ) -> int:
+        path_flag = getattr(os, "O_PATH", 0)
+        if (
