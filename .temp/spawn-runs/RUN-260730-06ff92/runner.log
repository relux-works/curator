    for _attempt in range(16):
        name = f"entry-{secrets.token_hex(16)}"
        try:
            os.mkdir(
                name,
                mode=_DIRECTORY_PRIVATE_MODE,
                dir_fd=staging_fd,
            )
        except FileExistsError:
            continue
        return name
    raise OSError(errno.EEXIST, "could not allocate unique staging directory")


