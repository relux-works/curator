+    ctypes.set_errno(0)
+    result = syscall(
+        ctypes.c_long(_FCHMODAT2_LINUX),
+        ctypes.c_int(descriptor),
+        ctypes.c_char_p(b""),
+        ctypes.c_uint(mode),
+        ctypes.c_int(_AT_EMPTY_PATH_LINUX),
+    )
+    if result == 0:
+        return
+    error_number = ctypes.get_errno()
