+    if not path_flag:
+        raise BuildCacheError(
+            "cache_protection_unsupported",
+            "Linux O_PATH directory references are unavailable",
+        )
+    return (
+        path_flag
+        | getattr(os, "O_CLOEXEC", 0)
+        | getattr(os, "O_DIRECTORY", 0)
+        | getattr(os, "O_NOFOLLOW", 0)
+    )
