+    )
+    framework_runtime = python_home / "Python"
+    framework_process = (
+        python_home
+        / "Resources"
+        / "Python.app"
+        / "Contents"
+        / "MacOS"
+        / "Python"
+    )
+    if framework_runtime.is_file():
+        runtime_image = _resolve_executable_identity(
+            framework_runtime,
+            label="installed manager Python runtime image",
+        )
+        process_image = (
+            executable
+            if app_layout
+            else (
