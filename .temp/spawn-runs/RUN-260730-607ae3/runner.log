+def _is_startup_configuration_name(name: str) -> bool:
+    folded = name.casefold()
+    if folded in {
+        candidate.casefold()
+        for candidate in _STARTUP_PREFIX_CONFIGURATION
+    }:
+        return True
+    if not (
+        folded.startswith("python")
+        and folded.endswith("._pth")
+    ):
