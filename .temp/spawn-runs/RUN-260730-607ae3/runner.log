+        length = int(get_name(handle or None, buffer, capacity))
+        if not length:
+            raise GoV1Error(
+                CODE_WORKER_IDENTITY_INVALID,
+                f"{label} is unavailable",
+            )
+        if length < capacity - 1:
+            return _canonical_loaded_image(Path(buffer.value), label)
+        capacity *= 2
+    raise GoV1Error(
+        CODE_WORKER_IDENTITY_INVALID,
+        f"{label} path is unbounded",
+    )
