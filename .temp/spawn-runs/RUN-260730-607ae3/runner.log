+    except UnicodeDecodeError as exc:
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            "installed manager pyvenv configuration is not UTF-8",
+        ) from exc
+    if "\x00" in text:
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            "installed manager pyvenv configuration contains a NUL",
