+    scripts.mkdir(parents=True)
+    venv_interpreter = scripts / "python.exe"
+    venv_interpreter.write_bytes(b"venv launcher")
+    venv_interpreter.chmod(0o755)
+    configuration = venv / "pyvenv.cfg"
