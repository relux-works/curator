+def _windows_loaded_image(handle: int, label: str) -> Path:
+    kernel32 = _windows_kernel32()
+    get_name = kernel32.GetModuleFileNameW
+    get_name.argtypes = [
+        ctypes.c_void_p,
+        ctypes.c_wchar_p,
+        ctypes.c_uint32,
+    ]
+    get_name.restype = ctypes.c_uint32
