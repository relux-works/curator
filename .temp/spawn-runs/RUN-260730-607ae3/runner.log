+def _pyvenv_home(
+    text: str,
+) -> Path:
+    homes: list[str] = []
+    for raw_line in text.splitlines():
+        line = raw_line.strip()
+        if not line or line.startswith("#"):
+            continue
+        if "=" not in line:
+            raise GoV1Error(
+                CODE_WORKER_IDENTITY_INVALID,
