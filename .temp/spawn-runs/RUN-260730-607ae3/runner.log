+        runtime_image = _windows_loaded_image(
+            int(ctypes.pythonapi._handle),
+            "worker Python runtime image",
+        )
+    return {
+        "process_image": os.fspath(process_image),
+        "runtime_image": os.fspath(runtime_image),
+    }
