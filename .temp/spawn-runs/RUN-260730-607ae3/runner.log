+            "worker process image is unavailable",
+        )
+    raw = image_name(0)
+    if not raw:
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            "worker process image is unavailable",
+        )
+    return _canonical_loaded_image(
+        Path(os.fsdecode(raw)),
+        "worker process image",
+    )
