+def _canonical_loaded_image(path: Path, label: str) -> Path:
+    if not path.is_absolute():
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            f"{label} is not absolute",
+        )
+    try:
+        return path.resolve(strict=True)
