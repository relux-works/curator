+def _canonical_runtime_directory(path: Path, label: str) -> Path:
+    try:
+        info = path.lstat()
+        canonical = path.resolve(strict=True)
+    except (OSError, RuntimeError) as exc:
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            f"{label} is unavailable",
