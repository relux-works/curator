+                framework_process,
+                label="installed manager Python process image",
+            )
+            if framework_process.is_file()
+            else executable
+        )
+    else:
+        library = python_home / "lib"
+        candidates: list[Path] = []
+        try:
+            entries = os.scandir(library)
