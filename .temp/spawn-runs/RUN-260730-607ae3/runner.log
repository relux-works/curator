+def _resolve_configuration_identity(path: Path) -> _ExecutableIdentity:
+    identity = _resolve_file_identity(
+        path,
+        executable=False,
+        label="installed manager pyvenv configuration",
+        max_bytes=_MAX_INTERPRETER_CONFIGURATION_BYTES,
+    )
