+    if sys.platform == "darwin":
+        return _resolve_macos_interpreter_runtime(executable)
+    raise GoV1Error(
+        CODE_CONTROL_UNAVAILABLE,
+        "manager interpreter identity is unsupported on this host",
+    )
+
