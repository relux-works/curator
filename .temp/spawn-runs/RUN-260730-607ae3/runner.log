+    if (
+        len(payload) != identity.size
+        or "sha256:" + hashlib.sha256(payload).hexdigest() != identity.sha256
+    ):
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            "installed manager pyvenv configuration changed while reading",
+        )
+    return identity, text
