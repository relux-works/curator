+        or _is_link_or_reparse(info)
+        or not stat.S_ISDIR(info.st_mode)
+    ):
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            f"{label} is not one canonical directory",
+        )
+    return canonical
+
