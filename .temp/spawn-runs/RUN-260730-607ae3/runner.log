+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            "installed manager pyvenv configuration has no unique home",
+        )
+    result = Path(homes[0])
+    if not result.is_absolute():
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            "installed manager pyvenv home is not absolute",
+        )
+    return _canonical_runtime_directory(
