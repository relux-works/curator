+def test_manager_identity_binds_native_python_runtime_image(tmp_path: Path):
+    manager = _make_manager(tmp_path / "manager" / "bin" / "csk")
+    runtime_image = manager.parent.parent / "lib" / "libpython3.11.dylib"
