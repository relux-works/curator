+        label="installed manager pyvenv configuration",
+        max_bytes=_MAX_INTERPRETER_CONFIGURATION_BYTES,
+    )
+    try:
+        payload = path.read_bytes()
+    except OSError as exc:
+        raise GoV1Error(
