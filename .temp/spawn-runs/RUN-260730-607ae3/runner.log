    }
    environment: dict[str, str] = {}
    private_roots: list[Path] = []
    for name, child in private_names.items():
        path = operation / child
        path.mkdir(parents=True)
        environment[name] = str(path)
        private_roots.append(path)
    environment.update(
        {
