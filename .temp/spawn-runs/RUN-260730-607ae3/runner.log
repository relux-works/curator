+def _pyvenv_home(
+    configuration: _ExecutableIdentity,
+) -> Path:
+    try:
+        text = configuration.path.read_bytes().decode(
+            "utf-8-sig",
+            errors="strict",
+        )
+    except (OSError, UnicodeDecodeError) as exc:
+        raise GoV1Error(
+            CODE_WORKER_IDENTITY_INVALID,
+            "installed manager pyvenv configuration cannot be parsed",
+        ) from exc
+    current = _resolve_file_identity(
+        configuration.path,
+        executable=False,
+        label="installed manager pyvenv configuration",
