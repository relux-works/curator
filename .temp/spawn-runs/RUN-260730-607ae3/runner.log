        toolchain.ToolchainConfig(
            private_base=private_base,
            operator_search_path=toolchain.OperatorSearchPath(
                (str(go_executable.parent),)
            ),
            forbidden_roots=(snapshot_root, repository_root),
            go_executable=go_executable,
