+        line = raw_line.strip()
+        if not line or line.startswith("#"):
+            continue
+        if "=" not in line:
+            raise GoV1Error(
+                CODE_WORKER_IDENTITY_INVALID,
+                "installed manager pyvenv configuration is malformed",
+            )
+        key, value = line.split("=", 1)
+        if key.strip().casefold() == "home":
+            homes.append(value.strip())
