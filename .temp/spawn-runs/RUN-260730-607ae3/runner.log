+        except OSError as exc:
+            raise GoV1Error(
+                CODE_WORKER_IDENTITY_INVALID,
+                "cannot inspect the installed manager Python runtime images",
+            ) from exc
+        if entries is not None:
+            with entries:
+                for entry in entries:
+                    folded = entry.name.casefold()
+                    if (
