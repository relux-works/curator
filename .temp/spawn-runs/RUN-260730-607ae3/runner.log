+    candidates = []
+    for name in names:
+        folded = name.casefold()
+        if not (folded.startswith("python") and folded.endswith(".dll")):
+            continue
+        version = folded.removeprefix("python").removesuffix(".dll")
+        if len(version) >= 2 and version.isdigit():
+            candidates.append(python_home / name)
