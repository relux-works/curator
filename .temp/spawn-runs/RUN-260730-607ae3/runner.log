+class _DlInfo(ctypes.Structure):
+    _fields_ = [
+        ("filename", ctypes.c_char_p),
+        ("base", ctypes.c_void_p),
+        ("symbol_name", ctypes.c_char_p),
+        ("symbol_address", ctypes.c_void_p),
+    ]
