   554	// TestGlobalStatusReportsATransitivelyResolvedCompiledCommand proves the
   555	// machine-wide scope resolves the installed directory of a node no declaration
   556	// names. The global scope reads one store — it consults no hybrid store, since
   557	// hybrid declarations activate against a project — so a provider reached only
   558	// through a dependency must still be found, classified, and able to fail
   559	// `--check` on its own.
   560	func TestGlobalStatusReportsATransitivelyResolvedCompiledCommand(t *testing.T) {
   561		home := globalScopeDeclaring(t, `{"name":"consumer","tag":"v1"}`)
   562		skillsRoot := filepath.Join(filepath.Dir(home), "skills")
   563		writeCompiledSkillRepo(t, filepath.Join(skillsRoot, "build-skill"))
   564	
   565		consumer := filepath.Join(skillsRoot, "consumer")
   566		writeFile(t, filepath.Join(consumer, "SKILL.md"), "---\nname: consumer\ndescription: consumer\n---\n")
   567		writeFile(t, filepath.Join(consumer, "agent-skill.json"), `{
   568			"schema_version": 6,
   569			"build_roots": [],
   570			"capabilities": {},
   571			"commands": {},
   572			"dependencies": {"skills": {
   573				"build-skill": {
   574					"git": "./build-skill",
   575					"ref": {"kind":"tag","value":"v1"},
   576					"mode": "runtime"
   577				}
   578			}}
   579		}`)
   580		runGit(t, consumer, "init", "-q", "-b", "main")
   581		runGit(t, consumer, "add", ".")
   582		runGit(t, consumer, "commit", "-qm", "initial consumer")
   583		runGit(t, consumer, "tag", "v1")
   584	
   585		if code, stdout, stderr := capture(t, "global", "install"); code != exitOK {
--- status report and cache recheck ---
   600		check := flags.Bool("check", false, "exit non-zero unless every skill is up to date")
   601		jsonOut := flags.Bool("json", false, "machine-readable output")
   602		attest := flags.Bool("attest", false, "re-check installed skills against trusted registries")
   603		positional, err := parseInterspersed(flags, args)
   604		if err != nil {
   605			return exitUsage
   606		}
   607		cfg, code := loadConfig()
   608		if code != exitOK {
   609			return code
   610		}
   611		targets, targetErr := selectProjectTargets(cfg, positional, *all)
   612		if targetErr != nil {
   613			fmt.Fprintln(os.Stderr, "curator:", targetErr)
   614			return exitUsage
   615		}
   616		if *attest {
   617			exitCode := exitOK
   618			for _, target := range targets {
   619				if code := cmdStatusAttest(cfg, target.Root, target.Alias, *jsonOut); code != exitOK {
   620					exitCode = code
   621				}
   622			}
   623			return exitCode
   624		}
   625	
   626		exitCode := exitOK
   627		jsonResults := make([]map[string]any, 0, len(targets))
   628		for _, target := range targets {
   629			// Installed markers are fingerprinted before the read-only plan and
   630			// again after classification, so compiled state that moved during the
   631			// whole window is reported as such instead of silently deciding the
   632			// verdict from a plan that was already stale.
   633			scope := projectStatusScope(cfg, target.Root, target.Alias)
   634			before := markerDigests(scope.stores...)
   635			result := install.Project(cfg, target.Root, target.Alias, install.Options{DryRun: true})
   636			if result.Status == "failed" {
   637				// A read-only plan that refused, yet still described every compiled
   638				// command it was asked about, has produced a currentness verdict — and
   639				// reporting a verdict is not itself a failure. The rows below carry it
   640				// in the stable vocabulary, and `--check` is the surface that turns a
   641				// non-current verdict into a non-zero exit.
   642				//
   643				// Everything else keeps the historical behaviour exactly: a failure
   644				// that describes no compiled command, or describes only some of them,
   645				// reports the error and exits non-zero rather than publishing a
   646				// silently partial report.
   647				if !result.BuildsComplete {
   648					printResult(result)
   649					exitCode = exitFail
   650					continue
   651				}
   652				printStatusRefusal(result)
   653			}
   654			if result.Status == "skipped" {
   655				printResult(result)
   656				if *check {
   657					exitCode = exitFail
   658				}
   659				continue
   660			}
   661			drift, builds := statusReport(cfg, scope, factsList(result.Builds), before)
   662			payload := map[string]any{"alias": target.Alias, "path": target.Root, "skills": drift}
   663			// A closure without compiled commands keeps the historical object
   664			// exactly: no build key appears at all.
   665			if len(builds) > 0 {
   666				payload["builds"] = builds
   667			}
   668			jsonResults = append(jsonResults, payload)
   669			if !*jsonOut {
   670				names := make([]string, 0, len(drift))
   671				for name := range drift {
   672					names = append(names, name)
   673				}
   674				sort.Strings(names)
   675				for _, name := range names {
   676					fmt.Printf("%s: %s %s\n", target.Alias, name, drift[name])
   677				}
   678				for _, build := range builds {
   679					fmt.Printf("%s: %s\n", target.Alias, build.Describe())
   680				}
   681			}
   682			if *check && checkFailed(drift, builds) {
   683				exitCode = exitFail
   684			}
   685		}
   686		if *jsonOut {
   687			var output any = jsonResults
   688			if len(jsonResults) == 1 {
   689				output = jsonResults[0]
   690			}
   691			payload, _ := json.MarshalIndent(output, "", "  ")
   692			fmt.Println(string(payload))
   693		}
   694		return exitCode
   695	}
   696	
   697	// statusScope is one installed scope seen by the read-only currentness surface:
   698	// the declaration document it compares against, the store its own skills are
   699	// installed into, and every store a command it activates may live in.
   700	//
   701	// It exists so the project scope and the machine-wide scope share one
   702	// classification, one stable vocabulary, and one fail-closed verdict rather than
   703	// growing a second, weaker one.
   704	type statusScope struct {
   705		alias        string
   706		manifestRoot string
   707		skillsDir    string
   708		// stores is fingerprinted for the classification race window and searched
   709		// for the installed directory of a compiled command's skill.
   710		stores []string
   711	}
   712	
   713	// projectStatusScope is one project. It also reads the machine-level hybrid
   714	// store, because a hybrid declaration activates against a project and its
   715	// installed node is reachable from here.
   716	func projectStatusScope(cfg *config.Config, projectRoot, alias string) statusScope {
   717		skillsDir := filepath.Join(projectRoot, ".agents", "skills")
   718		return statusScope{
   719			alias:        alias,
   720			manifestRoot: projectRoot,
   721			skillsDir:    skillsDir,
   722			stores:       []string{skillsDir, scopes.HybridSkillsRoot(cfg.Home())},
   723		}
   724	}
   725	
   726	// globalStatusScope is the machine-wide scope. It consults no hybrid store:
   727	// hybrid declarations activate against a project, never against the global
   728	// scope, and every node the global closure resolves — declared or transitively
   729	// reached — is installed into the global store itself.
   730	func globalStatusScope(cfg *config.Config) statusScope {
   731		root := install.GlobalRoot(cfg.Home())
   732		return statusScope{
   733			alias:        "global",
   734			manifestRoot: root,
   735			skillsDir:    filepath.Join(root, "skills"),
   736			stores:       []string{filepath.Join(root, "skills")},
   737		}
   738	}
   739	
   740	// statusDrift compares declared skills with installed markers.
   741	func statusDrift(cfg *config.Config, projectRoot string) map[string]string {
   742		return scopeStatusDrift(cfg, projectRoot, filepath.Join(projectRoot, ".agents", "skills"))
   743	}
   744	
   745	// statusReport is the complete read-only currentness verdict of one scope: the
   746	// historical per-skill drift map plus one diagnostic row per compiled command
   747	// the closure activates.
   748	//
   749	// Compiled state can only demote a skill that every ordinary check already
   750	// accepted. A skill that is missing, tampered, unresolvable, or behind its
   751	// declaration keeps that more actionable code.
   752	func statusReport(
   753		cfg *config.Config,
   754		scope statusScope,
   755		builds []buildFacts,
   756		before map[string]string,
   757	) (map[string]string, []buildReport) {
   758		drift := scopeStatusDrift(cfg, scope.manifestRoot, scope.skillsDir)
   759		if len(builds) == 0 {
   760			return drift, nil
   761		}
   762	
   763		bySkill := map[string][]buildFacts{}
   764		var skills []string
   765		for _, facts := range builds {
   766			if _, seen := bySkill[facts.Skill]; !seen {
   767				skills = append(skills, facts.Skill)
   768			}
   769			bySkill[facts.Skill] = append(bySkill[facts.Skill], facts)
   770		}
   771		sort.Strings(skills)
   772	
   773		type verdict struct {
   774			skill     string
   775			installed string
   776			facts     []buildFacts
   777			state     string
   778			rows      []buildReport
   779		}
   780		verdicts := make([]verdict, 0, len(skills))
   781		for _, skill := range skills {
   782			facts := bySkill[skill]
   783			installed, present := installedSkillDir(scope, skill)
   784			if !present {
   785				verdicts = append(verdicts, verdict{skill: skill, installed: installed, facts: facts,
   786					state: stateNotInstalled,
   787					rows: plannedRows(facts, stateNotInstalled, "",
   788						"the compiled command belongs to a skill that is not installed")})
   789				continue
   790			}
   791			state, rows := classifySkillBuilds(installed, marker.Read(installed), facts)
   792			verdicts = append(verdicts, verdict{skill: skill, installed: installed, facts: facts, state: state, rows: rows})
   793		}
   794	
   795		// The second look closes the whole window: planning and every classification
   796		// above have run, so compiled state that differs from the state this verdict
   797		// was derived from makes the verdict stale, not authoritative. Both halves of
   798		// that state are re-read — the install markers this run fingerprinted, and
   799		// the protected cache evidence every compiled row was classified from —
   800		// because either one can move on its own.
   801		after := markerDigests(scope.stores...)
   802		movedCache := recheckBuildCache(cfg.Home(), builds)
   803		var reports []buildReport
   804		for _, item := range verdicts {
   805			if changed := changedDuringCheck(item.facts, before, after, item.installed, movedCache); changed != "" {
   806				item.state = buildStateChanged
   807				item.rows = plannedRows(item.facts, buildStateChanged, "", changed)
   808			}
   809			reports = append(reports, item.rows...)
