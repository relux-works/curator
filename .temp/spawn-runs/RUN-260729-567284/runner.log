   527				}
   528			}
   529			refused := decodeGlobalStatus(t, stdout)
   530			if len(refused.Builds) != 1 {
   531				t.Fatalf("global status reported %d compiled commands, want 1:\n%s", len(refused.Builds), stdout)
   532			}
   533			row := refused.Builds[0]
   534			if row.State != buildUnusableToolchain || row.Cause == "" {
   535				t.Fatalf("toolchain row = %+v", row)
   536			}
   537			if row.Skill != "build-skill" || row.Command != "build-tool" || row.Detail == "" {
   538				t.Fatalf("toolchain row does not name the active command: %+v", row)
   539			}
   540			// Nothing the plan could not derive may be published as if it were known.
   541			if row.CacheKey != "" || row.Target != "" || row.ArtifactPath != "" {
   542				t.Fatalf("toolchain row published identities the plan never derived: %+v", row)
   543			}
   544			if refused.Skills["build-skill"] != buildUnusableToolchain {
   545				t.Fatalf("skills = %v", refused.Skills)
   546			}
   547			if code, human, _ := capture(t, "global", "status"); code != exitOK ||
   548				!strings.Contains(human, "state="+buildUnusableToolchain) {
   549				t.Fatalf("plain global status over an unusable toolchain = %d\n%s", code, human)
