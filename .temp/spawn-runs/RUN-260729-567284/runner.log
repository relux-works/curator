   271	// driftExpectation is one non-current compiled state and everything the whole
   272	// reporting contract must say about it.
   273	type driftExpectation struct {
   274		state   string
   275		cause   string
   276		outcome string
   277	}
   278	
   279	// assertGlobalDriftDocument proves the machine-readable half of one non-current
   280	// compiled state, together with the fail-closed exit the same invocation
   281	// produced.
   282	func assertGlobalDriftDocument(t *testing.T, want driftExpectation, code int, stdout string) {
   283		t.Helper()
   284		if code != exitFail {
   285			t.Fatalf("global status --json --check over %s = %d, want %d\n%s", want.state, code, exitFail, stdout)
   320		}
   321		if want.cause != "" && !strings.Contains(human, "cause="+want.cause) {
   322			t.Fatalf("human global status does not report cause %q:\n%s", want.cause, human)
   323		}
   324		if !strings.Contains(human, "cache="+want.outcome) {
   325			t.Fatalf("human global status does not report cache outcome %q:\n%s", want.outcome, human)
   326		}
   327	}
