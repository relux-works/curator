   502					refuseMarker(t, installed, marshal(t, object))
   503				},
   504				want: buildUnsupportedDriver, outcome: "cache-hit",
   505			},
   506			"marker is not a marker document at all": {
   507				tamper: func(t *testing.T) { refuseMarker(t, installed, "{}") },
   508				want:   stateInvalidMarker, outcome: "cache-hit",
   509			},
   510			"build root reached agent-facing context": {
   511				tamper: func(t *testing.T) {
   512					if err := os.MkdirAll(filepath.Join(installed, "assets", "build-tool"), 0o755); err != nil {
   513						t.Fatal(err)
