   337	func TestStatusReportsCompiledCurrentnessAndFailsCheck(t *testing.T) {
   338		project, home := compiledProject(t)
   339		if code, stdout, stderr := capture(t, "install", "app"); code != exitOK {
   340			t.Fatalf("install = %d\nstdout:\n%s\nstderr:\n%s", code, stdout, stderr)
   341		}
   342		installed := filepath.Join(project, ".agents", "skills", "build-skill")
   343	
   344		code, stdout, stderr := capture(t, "status", "app", "--json")
   345		if code != exitOK {
   346			t.Fatalf("status --json = %d\nstderr:\n%s", code, stderr)
   347		}
   348		report := decodeStatus(t, stdout)
   349		if len(report.Builds) != 1 {
   350			t.Fatalf("status reported %d compiled commands, want 1:\n%s", len(report.Builds), stdout)
   351		}
   352		current := report.Builds[0]
   353		if current.State != buildCurrent || current.CacheOutcome != "cache-hit" {
   354			t.Fatalf("current build row = %+v", current)
   355		}
   356		if current.Skill != "build-skill" || current.Command != "build-tool" ||
   357			current.Driver != "go-v1" || current.BuildRoot != "assets/build-tool" ||
   358			current.SourceDir != "assets/build-tool/cmd/tool" || current.CacheKey == "" ||
   359			current.ArtifactPath != "bin/build-tool" || current.Target == "" ||
   360			current.BuildSource.ContentSHA256 == "" {
   361			t.Fatalf("current build row does not report the full planned command: %+v", current)
   362		}
   363		if report.Skills["build-skill"] != stateUpToDate {
   364			t.Fatalf("skills = %v", report.Skills)
   365		}
   366		// No manager-private location may reach the machine-readable surface. The
   367		// project path is the operator's own argument and stays.
   368		for _, forbidden := range []string{home, filepath.Join(project, ".agents", "bin")} {
   369			if strings.Contains(marshal(t, report.Builds), forbidden) {
   370				t.Fatalf("build rows published the private location %q:\n%s", forbidden, stdout)
   371			}
   372		}
   373		if code, _, _ := capture(t, "status", "app", "--check"); code != exitOK {
   374			t.Fatalf("clean compiled status --check = %d, want %d", code, exitOK)
   375		}
   376	
   377		for name, testCase := range map[string]struct {
   378			tamper  func(t *testing.T)
   379			restore func(t *testing.T)
   380			want    string
   381			cause   string
   382			outcome string
   383			// skillState is the code the declared skill is demoted to. It defaults
   384			// to the build state, because compiled state demotes the skill it
   385			// belongs to.
   386			skillState string
   387			// snapshotCache copies the live protected cache aside and puts every
   388			// byte and permission bit back, which is how a case that damages cache
   389			// state resets its own fixture. Repairing a reporting fixture by
   390			// reinstalling compiles the command again and proves nothing this test
   391			// owns; install, repair, and rollback keep their own dedicated tests.
   392			snapshotCache bool
   393			// humanCLI additionally runs the whole plain-text command path, so the
   394			// rendering asserted for every case is pinned to the line the command
   395			// really prints for at least one case of each shape.
   396			humanCLI bool
   397		}{
   398			"artifact hash recorded by the marker no longer matches the entry": {
   399				tamper: func(t *testing.T) {
   400					rewriteMarker(t, installed, func(object map[string]any) {
   401						builds := object["builds"].(map[string]any)
   402						build := builds["build-tool"].(map[string]any)
   403						build["artifact_sha256"] = testDigest(5)
   404					})
   405				},
   406				// One no-cause marker drift also proves the whole plain-text path.
   407				want: buildArtifactDrift, outcome: "cache-hit", humanCLI: true,
   408			},
   409			"receipt recorded by the marker no longer matches the entry": {
   410				tamper: func(t *testing.T) {
   411					rewriteMarker(t, installed, func(object map[string]any) {
   412						builds := object["builds"].(map[string]any)
   413						build := builds["build-tool"].(map[string]any)
   414						build["receipt_sha256"] = testDigest(5)
   415					})
   416				},
   417				want: buildCorruptReceipt, outcome: "cache-hit",
   418			},
   419			"logical key recorded by the marker was derived from another build input": {
   420				tamper: func(t *testing.T) {
   421					rewriteMarker(t, installed, func(object map[string]any) {
   422						builds := object["builds"].(map[string]any)
   423						build := builds["build-tool"].(map[string]any)
   424						build["cache_key"] = testDigest(5)
   425					})
   426				},
   427				// One cause-bearing drift also proves the whole plain-text path.
   428				want: buildInputDrift, cause: causeUnattributed, outcome: "cache-hit", humanCLI: true,
