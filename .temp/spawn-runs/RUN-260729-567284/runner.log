   492			})
   493	
   494			// The exposure is in the installed skill, not in the plan, so the replay
   495			// classifies it as faithfully as a fresh plan would — and the whole
   496			// command path is run once here to pin that to what the CLI publishes.
   497			code, stdout, _ := unchanged.replay(t, globalStatusOptions{jsonOut: true, check: true})
   498			assertGlobalDriftDocument(t, want, code, stdout)
   499			code, stdout, _ = capture(t, "global", "status", "--json", "--check")
   500			assertGlobalDriftDocument(t, want, code, stdout)
   501	
   502			code, human, _ := unchanged.replay(t, globalStatusOptions{})
   503			assertGlobalDriftHuman(t, want, code, human)
   504		})
