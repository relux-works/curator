  1027	// denyWrites makes one directory unwritable and proves it really is, so a case
  1028	// that depends on a write failing cannot pass vacuously — a privileged process
  1029	// ignores the mode entirely.
  1030	func denyWrites(t *testing.T, dir string) {
  1031		t.Helper()
  1032		info, err := os.Stat(dir)
  1033		if err != nil {
  1034			t.Fatal(err)
  1035		}
  1036		if err := os.Chmod(dir, 0o500); err != nil {
  1037			t.Fatal(err)
  1038		}
  1039		t.Cleanup(func() { _ = os.Chmod(dir, info.Mode().Perm()) })
  1040		probe := filepath.Join(dir, ".curator-write-probe")
  1041		if err := os.WriteFile(probe, []byte("probe"), 0o600); err == nil {
  1042			_ = os.Remove(probe)
  1043			if err := os.Chmod(dir, info.Mode().Perm()); err != nil {
  1044				t.Fatal(err)
  1045			}
  1046			t.Skip("this process can write through a read-only directory, so a commit failure cannot be injected")
  1047		}
  1048	}
