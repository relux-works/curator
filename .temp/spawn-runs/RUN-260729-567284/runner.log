   518			if !strings.Contains(stderr, "warning:") || strings.Contains(stderr, "error:") {
   519				t.Fatalf("global status reported the refusal as a failure rather than a warning:\n%s", stderr)
   520			}
   521			for _, want := range append([]string{
   522				godriver.SelectionCuratorGo, godriver.SelectionGOROOT,
