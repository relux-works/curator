   257		return filepath.WalkDir(base, func(path string, entry os.DirEntry, walkErr error) error {
   258			if walkErr != nil {
   259				if os.IsNotExist(walkErr) {
   260					return nil
   261				}
   262				return walkErr
   263			}
   264			if entry.IsDir() {
   265				return os.Chmod(path, 0o700)
   266			}
   267			return os.Chmod(path, 0o600)
   268		})
   269	}
