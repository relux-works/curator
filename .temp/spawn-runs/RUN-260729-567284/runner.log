  1230		drift, rows := statusReport(cfg, scope, facts, before)
  1231		if len(rows) != 1 || rows[0].State != buildCurrent {
  1232			t.Fatalf("settled compiled state = %+v", rows)
  1233		}
  1234		if checkFailed(drift, rows) {
  1235			t.Fatal("a settled compiled installation failed --check")
  1236		}
