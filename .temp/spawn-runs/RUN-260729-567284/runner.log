   506		// A refused toolchain is classified per active compiled command like every
   507		// other state, so it reuses this installation instead of building a second
   508		// identical one. The plan cannot be replayed here: refusing the toolchain is
   509		// exactly what the acquisition phase has to report.
   510		t.Run("trusted go toolchain cannot be resolved", func(t *testing.T) {
   511			t.Setenv(godriver.SelectionCuratorGo, filepath.Join(t.TempDir(), "nowhere", "bin", "go"))
   512	
   513			code, stdout, stderr := capture(t, "global", "status", "--json", "--check")
