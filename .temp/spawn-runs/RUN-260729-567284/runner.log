   417	// toolchainInventory records every command the closure activates when the
   418	// trusted toolchain boundary failed before a single logical identity could be
   419	// derived.
   420	//
   421	// The plan still fails; the inventory exists so a read-only currentness check
   422	// can report one diagnostic per active compiled command — with the stable
   423	// boundary code that refused it — instead of silently reporting nothing at all
   424	// about compiled state.
   425	//
   426	// Every identity that was already established when the toolchain was consulted
   427	// is carried: the closed build driver the schema admits for the command, the
   428	// build root and package directory the declaration names, and the build-source
   429	// digest of the frozen snapshot, which is validated before the toolchain is
   430	// touched. Only what genuinely depends on the toolchain — the native target,
   431	// the logical key, and any cache verdict — stays empty, so a row never
   432	// publishes an identity nothing derived.
   433	func toolchainInventory(
   434		planned []plannedCommand,
   435		sources map[string]*buildsource.Token,
   436		err error,
   437	) []PlannedBuild {
   438		code := godriver.DiagnosticCode(err)
   439		builds := make([]PlannedBuild, 0, len(planned))
   440		for _, item := range planned {
   441			// A build root that cannot be resolved is reported as absent rather than
   442			// guessed: this row exists to name the command, not to assert identity.
   443			buildRoot, rootErr := buildRootFor(item.node.Spec, item.command)
   444			if rootErr != nil {
   445				buildRoot = ""
   446			}
   447			var source buildsource.Identity
   448			if token := sources[item.node.Name]; token != nil {
   449				source = token.Identity()
   450			}
   451			builds = append(builds, PlannedBuild{
   452				skill:         item.node.Name,
   453				command:       item.command.Name,
   454				commandObject: commandObject(item.command),
   455				buildRoot:     buildRoot,
   456				sourceDir:     item.command.SourceDir,
   457				source:        source,
   458				// The driver is the closed go-v1 boundary the parser already admitted
   459				// this command under; only the input it would have keyed is unknown.
   460				input:      buildmeta.Input{Driver: item.command.Driver},
   461				outcome:    BuildToolchainUnavailable,
   462				reason:     err.Error(),
   463				diagnostic: code,
   464			})
   465		}
   466		return builds
   467	}
