    29		stateUpToDate     = "up-to-date"
    30		stateNotInstalled = "not-installed"
    31		stateNeedsInstall = "needs-install"
    32		stateContentDrift = "content-drift"
    33		stateUnresolvable = "unresolvable"
    34	
    35		// stateInvalidMarker is an install marker that is absent, unreadable, or
    36		// not a valid marker document.
    37		stateInvalidMarker = "invalid-marker"
    38		// stateUnsupportedMarker is a marker whose schema this manager cannot read.
    39		stateUnsupportedMarker = "unsupported-marker"
    40	
    41		// buildCurrent is the only compiled state that is up to date.
    42		buildCurrent = "current"
    43		// buildCommandDrift is a recorded compiled command set that differs from
    44		// the set the current closure activates.
    45		buildCommandDrift = "build-command-drift"
    46		// buildContextExposed is a build root that reached agent-facing context.
    47		buildContextExposed = "build-context-exposed"
    48		// buildSourceDrift is a recorded build-source identity that no longer
    49		// matches the frozen raw snapshot.
    50		buildSourceDrift = "build-source-drift"
    51		// buildInputDrift is a recorded logical key that does not match the key
    52		// derived from the current logical build input. The key is one opaque
    53		// digest over the whole input, so the code deliberately does not name a
    54		// cause; the accompanying cause subcode says exactly how much is provable.
    55		buildInputDrift = "build-input-drift"
    56		// buildUnsupportedDriver is a recorded or planned driver outside go-v1.
    57		buildUnsupportedDriver = "unsupported-build-driver"
    58		// buildUnusableToolchain is an active compiled command whose logical
