   286	// cacheFingerprint digests every protected entry so a test can prove a refused
   287	// run left the live build cache byte-for-byte unchanged.
   288	func cacheFingerprint(t *testing.T, home string) string {
   289		t.Helper()
   290		digest := sha256.New()
   291		base := filepath.Join(home, "cache", "build")
   292		err := filepath.WalkDir(base, func(path string, entry os.DirEntry, err error) error {
   293			if err != nil {
   294				return err
   295			}
   296			relative, relErr := filepath.Rel(base, path)
   297			if relErr != nil {
   298				return relErr
   299			}
   300			digest.Write([]byte(relative + "\n"))
   301			if entry.IsDir() {
   302				return nil
   303			}
   304			payload, readErr := os.ReadFile(path) // #nosec G304 -- test fixture path
   305			if readErr != nil {
   306				return readErr
   307			}
   308			digest.Write(payload)
   309			return nil
   310		})
   311		if err != nil {
   312			t.Fatal(err)
   313		}
   314		return hex.EncodeToString(digest.Sum(nil))
   315	}
