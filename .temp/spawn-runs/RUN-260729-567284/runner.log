   103	// currentnessCodes lists every stable code `status` can report, so a test can
   104	// prove the documented set and the reachable set are the same.
   105	func currentnessCodes() []string {
   106		return []string{
   107			stateUpToDate, stateNotInstalled, stateNeedsInstall, stateContentDrift, stateUnresolvable,
   108			stateInvalidMarker, stateUnsupportedMarker,
   109			buildCurrent, buildCommandDrift, buildContextExposed, buildSourceDrift, buildInputDrift,
   110			buildUnsupportedDriver, buildUnusableToolchain, buildMissingArtifact, buildCorruptReceipt,
   111			buildArtifactDrift, buildCorruptCache, buildUntrustedCache, buildUnsupportedPlatform,
   112			buildStateChanged, buildUnknownState,
   113		}
   114	}
