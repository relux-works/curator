   457					})
   458				},
   459				want: buildSourceDrift, outcome: "cache-hit",
   460			},
   461			"marker records no build for the command the closure activates": {
   462				tamper: func(t *testing.T) {
   463					rewriteMarker(t, installed, func(object map[string]any) {
   464						object["builds"] = map[string]any{}
   465						delete(object, "build_source")
   466					})
   467				},
   468				want: buildCommandDrift, outcome: "cache-hit",
   469			},
   470			// The two cases below damage the shared protected cache rather than the
   471			// marker, so each restores it from its own byte-and-mode snapshot before
   472			// the next case runs.
   473			"protected cache entry cannot be interpreted": {
   474				tamper:        func(t *testing.T) { corruptCacheArtifact(t, home) },
   475				snapshotCache: true,
   476				want:          buildCorruptCache, outcome: "corrupt",
   477			},
   478			"protected cache holds no entry for the recorded key": {
   479				tamper: func(t *testing.T) {
   480					for _, entry := range cacheEntries(t, home) {
   481						if err := os.RemoveAll(entry); err != nil {
   482							t.Fatal(err)
   483						}
   484					}
   485				},
   486				snapshotCache: true,
   487				want:          buildMissingArtifact, outcome: "would-preflight-and-build",
   488			},
   489			"marker schema cannot be read by this manager": {
   490				tamper: func(t *testing.T) {
   491					object := markerPayload(t, installed)
   492					object["schema_version"] = marker.SchemaVersion + 1
   493					refuseMarker(t, installed, marshal(t, object))
   494				},
   495				want: stateUnsupportedMarker, outcome: "cache-hit",
   496			},
   497			"marker records a build driver outside the closed set": {
   498				tamper: func(t *testing.T) {
   499					object := markerPayload(t, installed)
