    67		buildCorruptReceipt = "corrupt-build-receipt"
    68		// buildArtifactDrift is a protected entry whose artifact path or hash
    69		// differs from the one the marker recorded.
    70		buildArtifactDrift = "build-artifact-drift"
    71		// buildCorruptCache is a protected entry that cannot be interpreted at all.
    72		buildCorruptCache = "corrupt-build-cache"
    73		// buildUntrustedCache is candidate cache state outside a provable
    74		// manager-protected boundary.
    75		buildUntrustedCache = "untrusted-build-cache"
    76		// buildUnsupportedPlatform is a host that cannot protect the build cache.
    77		buildUnsupportedPlatform = "unsupported-build-platform"
    78		// buildStateChanged is compiled state that moved while status classified
    79		// it, so the verdict this run derived is not authoritative.
    80		buildStateChanged = "build-state-changed"
    81		// buildUnknownState is a planner outcome this manager does not know. It
    82		// fails closed rather than being reported as current.
    83		buildUnknownState = "unknown-build-state"
