   355	// planBuilds derives the immutable build plan after every manifest, closure,
   356	// collision, requirement, audit, registry, and moved-tag gate has passed.
   357	//
   358	// Planning is read-only: it validates frozen sources, resolves the trusted
   359	// toolchain identity (a probe on a dry run), and inspects protected cache
   360	// state. It never runs go list or go build and never writes persistent state.
   361	// The plan is returned even on failure so the caller can report every outcome
   362	// it managed to derive.
   363	func planBuilds(ctx context.Context, request buildPlanRequest) (BuildPlan, error) {
   364		plan := BuildPlan{scope: request.scope}
   365		planned := plannedCommands(request.nodes)
   366		if len(planned) == 0 {
   367			return plan, nil
   368		}
   369	
   370		plan.sources = map[string]*buildsource.Token{}
   371		for _, node := range buildNodes(request.nodes) {
   372			token, err := buildsource.Validate(node.Snapshot)
   373			if err != nil {
   374				return plan, fmt.Errorf("%s: %w", node.Name, err)
   375			}
   376			plan.sources[node.Name] = token
   377		}
   378	
   379		var target buildmeta.Target
   380		var toolchain buildmeta.Toolchain
   381		if request.dryRun {
   382			probedTarget, probedToolchain, err := request.deps.Toolchain.Probe(ctx)
   383			if err != nil {
   384				plan.builds, plan.complete = toolchainInventory(planned, plan.sources, err), true
   385				return plan, err
   386			}
   387			target, toolchain = probedTarget, probedToolchain
   388		} else {
   389			session, err := request.deps.Toolchain.Establish(ctx)
   390			if err != nil {
   391				plan.builds, plan.complete = toolchainInventory(planned, plan.sources, err), true
   392				return plan, err
   393			}
   394			plan.session = session
   395			target, toolchain = session.Target(), session.Toolchain()
   396		}
   397	
   398		var blocked []string
   399		for _, item := range planned {
   400			build, err := planOne(item, plan.sources[item.node.Name], target, toolchain, request.deps.Cache)
   401			if err != nil {
   402				return plan, err
   403			}
   404			plan.builds = append(plan.builds, build)
   405			if build.outcome.blocking() {
