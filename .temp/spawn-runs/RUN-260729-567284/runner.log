    92		// causeTarget means the marker's own recorded artifact path is not the path
    93		// this manager derives for the current native target. This is direct
    94		// evidence that the recorded build was made for another target.
    95		causeTarget = "target"
    96		// causeUnattributed means the logical key differs but the install marker
    97		// records no prior input that could attribute it further. Source directory,
    98		// target tuning, toolchain identity, and the fixed manager build policy all
    99		// enter the same opaque digest, and none of them is recorded.
   100		causeUnattributed = "unattributed"
   101	)
