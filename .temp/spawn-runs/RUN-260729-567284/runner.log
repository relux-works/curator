   329	// TestGlobalStatusReportsCompiledCurrentnessAndFailsCheck is the end-to-end
   330	// proof of the machine-wide compiled surface: an unchanged compiled global
   331	// installation reports every active command as current, and each independent way
   332	// that state can stop being current produces its own stable code — the same
   333	// codes `curator status` reports — and a non-zero `global status --check`.
   334	//
   335	// Every case proves the same complete contract: the machine-readable row, the
   336	// demoted declared-skill entry, the fail-closed exit, the operator line, and the
   337	// zero exit of the plain report. What differs is where the plan under
   338	// classification comes from. A case the read-only plan cannot observe — a
   339	// rewritten install marker, a build root materialized in the installed skill —
   340	// is replayed from one plan acquired while the installation was unchanged. A
   341	// case the plan does observe — protected cache state — acquires its own plan
   342	// while that state is live, because a replayed one would describe cache
   343	// evidence that no longer exists.
   344	func TestGlobalStatusReportsCompiledCurrentnessAndFailsCheck(t *testing.T) {
   345		home := compiledGlobalScope(t)
   346		if code, stdout, stderr := capture(t, "global", "install"); code != exitOK {
   347			t.Fatalf("global install = %d\nstdout:\n%s\nstderr:\n%s", code, stdout, stderr)
   348		}
   349		installed := filepath.Join(install.GlobalRoot(home), "skills", "build-skill")
   350	
   351		// `--json` and `--check` are combined so one invocation proves the published
   352		// document and the exit code it produced are the same run's verdict.
   353		code, stdout, stderr := capture(t, "global", "status", "--json", "--check")
   354		if code != exitOK {
   355			t.Fatalf("clean compiled global status --json --check = %d\nstderr:\n%s", code, stderr)
   356		}
   357		report := decodeGlobalStatus(t, stdout)
   358		if report.Alias != "global" {
   359			t.Fatalf("alias = %q, want %q", report.Alias, "global")
   360		}
   361		if len(report.Builds) != 1 {
   362			t.Fatalf("global status reported %d compiled commands, want 1:\n%s", len(report.Builds), stdout)
   363		}
   364		current := report.Builds[0]
   365		if current.State != buildCurrent || current.CacheOutcome != "cache-hit" {
   366			t.Fatalf("current build row = %+v", current)
   367		}
   368		if current.Skill != "build-skill" || current.Command != "build-tool" ||
   369			current.Driver != "go-v1" || current.BuildRoot != "assets/build-tool" ||
   370			current.SourceDir != "assets/build-tool/cmd/tool" || current.CacheKey == "" ||
   371			current.ArtifactPath != "bin/build-tool" || current.Target == "" ||
   372			current.BuildSource.ContentSHA256 == "" {
   373			t.Fatalf("current build row does not report the full planned command: %+v", current)
   374		}
   375		if report.Skills["build-skill"] != stateUpToDate {
   376			t.Fatalf("skills = %v", report.Skills)
   377		}
   378		// The machine-wide scope has no operator-supplied root, so no manager-owned
   379		// location may reach the machine-readable surface at all.
   380		if strings.Contains(stdout, home) {
   381			t.Fatalf("global status --json published the manager home %q:\n%s", home, stdout)
   382		}
   383	
   384		// One plan of the unchanged installation, acquired once and reused by every
   385		// case below that cannot change what a plan derives.
   386		unchanged := acquireGlobalPlan(t)
   387	
   388		for _, testCase := range []struct {
   389			name     string
   390			tamper   func(t *testing.T)
   391			want     driftExpectation
   392			endToEnd bool
   393		}{
   394			{
   395				name: "recorded build-source identity no longer matches the frozen snapshot",
   396				tamper: func(t *testing.T) {
   397					rewriteMarker(t, installed, func(object map[string]any) {
   398						source := object["build_source"].(map[string]any)
   399						source["content_sha256"] = testDigest(5)
   400					})
   401				},
   402				want:     driftExpectation{state: buildSourceDrift, outcome: "cache-hit"},
   403				endToEnd: true,
   404			},
   405			{
   406				name: "logical key recorded by the marker was derived from another build input",
   407				tamper: func(t *testing.T) {
   408					rewriteMarker(t, installed, func(object map[string]any) {
   409						builds := object["builds"].(map[string]any)
   410						build := builds["build-tool"].(map[string]any)
   411						build["cache_key"] = testDigest(5)
   412					})
   413				},
   414				want: driftExpectation{state: buildInputDrift, cause: causeUnattributed, outcome: "cache-hit"},
   415			},
   416			{
   417				name: "marker records no build for the command the closure activates",
   418				tamper: func(t *testing.T) {
   419					rewriteMarker(t, installed, func(object map[string]any) {
   420						object["builds"] = map[string]any{}
   421						delete(object, "build_source")
   422					})
   423				},
   424				want: driftExpectation{state: buildCommandDrift, outcome: "cache-hit"},
   425			},
   426		} {
   427			t.Run(testCase.name, func(t *testing.T) {
   428				restoreMarkerAfter(t, installed)
   429				testCase.tamper(t)
   430	
   431				code, stdout, _ := unchanged.replay(t, globalStatusOptions{jsonOut: true, check: true})
   432				assertGlobalDriftDocument(t, testCase.want, code, stdout)
   433				if testCase.endToEnd {
   434					// One case in this group also runs the whole command path, so the
   435					// replayed classification is pinned to what the CLI publishes.
   436					code, stdout, _ = capture(t, "global", "status", "--json", "--check")
   437					assertGlobalDriftDocument(t, testCase.want, code, stdout)
   438				}
   439	
   440				code, human, _ := unchanged.replay(t, globalStatusOptions{})
   441				assertGlobalDriftHuman(t, testCase.want, code, human)
   442			})
   443		}
   444	
   445		for _, testCase := range []struct {
   446			name   string
   447			tamper func(t *testing.T)
   448			want   driftExpectation
   449		}{
   450			{
   451				name:   "protected cache entry cannot be interpreted",
   452				tamper: func(t *testing.T) { corruptCacheArtifact(t, home) },
   453				want:   driftExpectation{state: buildCorruptCache, outcome: "corrupt"},
   454			},
   455			{
   456				name: "protected cache holds no entry for the recorded key",
   457				tamper: func(t *testing.T) {
   458					for _, entry := range cacheEntries(t, home) {
   459						if err := os.RemoveAll(entry); err != nil {
   460							t.Fatal(err)
   461						}
   462					}
   463				},
   464				want: driftExpectation{state: buildMissingArtifact, outcome: "would-preflight-and-build"},
   465			},
   466		} {
   467			t.Run(testCase.name, func(t *testing.T) {
   468				snapshotBuildCacheAfter(t, home)
   469				testCase.tamper(t)
   470	
   471				// Protected cache evidence is read by planning itself, so this state is
   472				// classified from a plan acquired while it is live.
   473				drifted := acquireGlobalPlan(t)
   474				code, stdout, _ := drifted.replay(t, globalStatusOptions{jsonOut: true, check: true})
   475				assertGlobalDriftDocument(t, testCase.want, code, stdout)
   476	
   477				code, human, _ := drifted.replay(t, globalStatusOptions{})
   478				assertGlobalDriftHuman(t, testCase.want, code, human)
   479			})
   480		}
   481	
   482		t.Run("build root reached agent-facing context", func(t *testing.T) {
   483			want := driftExpectation{state: buildContextExposed, outcome: "cache-hit"}
   484			exposed := filepath.Join(installed, "assets", "build-tool")
   485			if err := os.MkdirAll(exposed, 0o755); err != nil {
   486				t.Fatal(err)
