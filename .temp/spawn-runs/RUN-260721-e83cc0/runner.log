    22	func requireHomeLock(lock HomeLock) error {
    23		if lock == nil {
    24			return fmt.Errorf("manager-home lock is required")
    25		}
    26		value := reflect.ValueOf(lock)
    27		switch value.Kind() {
    28		case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Pointer, reflect.Slice:
    29			if value.IsNil() {
    30				return fmt.Errorf("manager-home lock is required")
    31			}
    32		}
    33		if err := lock.AssertHeld(); err != nil {
    34			return fmt.Errorf("manager-home lock is not held: %w", err)
    35		}
    36		return nil
    37	}
    38	
    39	func (engine *Engine) ensureJournalRoot() error {
    40		return makeDurableDirectories(engine.journalRoot)
    41	}
    42	
    43	func makeDurableDirectories(path string) error {
    44		info, err := os.Lstat(path)
    45		if err == nil {
    46			if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
    47				return fmt.Errorf("transaction state path is not a safe directory: %s", path)
    48			}
    49			return nil
    50		}
    51		if !os.IsNotExist(err) {
    52			return err
    53		}
    54		parent := filepath.Dir(path)
    55		if parent == path {
    56			return fmt.Errorf("transaction state has no existing directory ancestor: %s", path)
    57		}
    58		if err := makeDurableDirectories(parent); err != nil {
    59			return err
    60		}
    61		if err := os.Mkdir(path, 0o700); err != nil && !os.IsExist(err) {
    62			return err
    63		}
    64		if err := syncDirectory(path); err != nil {
    65			return err
    66		}
    67		return syncDirectory(parent)
    68	}
