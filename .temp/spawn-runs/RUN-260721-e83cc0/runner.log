manifest_hash() {
  local tree=$1
  local exclude=$2
  (
    cd "$tree"
    { git diff --name-only HEAD; git ls-files --others --exclude-standard; } |
      sort -u |
      rg -v "$exclude" |
      while IFS= read -r file_path; do
        if [[ -f "$file_path" ]]; then
          /usr/bin/shasum -a 256 "$file_path"
        fi
      done |
      /usr/bin/shasum -a 256
  )
}
