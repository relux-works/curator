    72			return err
    73		}
    74		if err := engine.ensureJournalRoot(); err != nil {
    75			return err
    76		}
    77		payload, err := marshalJournal(journal)
    78		if err != nil {
    79			return err
    80		}
    81		path := engine.journalPath(journal.TransactionID)
    82		temporary, err := os.CreateTemp(engine.journalRoot, ".journal-*.tmp")
    83		if err != nil {
    84			return err
    85		}
    86		temporaryPath := temporary.Name()
    87		ok := false
    88		defer func() {
    89			_ = temporary.Close()
    90			if !ok {
    91				_ = os.Remove(temporaryPath)
    92			}
    93		}()
    94		if err := temporary.Chmod(0o600); err != nil {
    95			return err
    96		}
    97		if _, err := temporary.Write(payload); err != nil {
    98			return err
    99		}
   100		if err := temporary.Sync(); err != nil {
   101			return err
   102		}
   103		if err := temporary.Close(); err != nil {
   104			return err
   105		}
   106		if _, err := os.Lstat(path); err == nil {
