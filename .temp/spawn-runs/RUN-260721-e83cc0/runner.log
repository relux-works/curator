+		}
+	}}))
+	journal, err := engine.Prepare(testLock{}, Plan{TransactionID: "txn-durability", ProjectIdentity: "/project", Targets: targets})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := engine.Commit(testLock{}, journal.TransactionID); err != nil {
