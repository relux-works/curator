+func TestRollbackDesiredDigestMismatchPreservesUnknownBytes(t *testing.T) {
+	root := t.TempDir()
+	mustMkdirAll(t, filepath.Join(root, "live"))
+	mustMkdirAll(t, filepath.Join(root, "stage"))
