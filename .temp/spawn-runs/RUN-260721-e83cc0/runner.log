+
+package transaction
+
+func durableRenameNoReplace(from, to string) error {
+	return durableRename(from, to)
+}
diff --git a/.temp/TASK-260720-31nl14/worktree/internal/transaction/replace_unix.go b/.temp/TASK-260720-31nl14/worktree/internal/transaction/replace_unix.go
