   129	func (engine *Engine) loadJournal(transactionID string) (*Journal, error) {
   130		if !transactionIDPattern.MatchString(transactionID) {
   131			return nil, journalf("invalid transaction id")
   132		}
   133		payload, err := os.ReadFile(engine.journalPath(transactionID))
   134		if err != nil {
   135			return nil, err
   136		}
   137		decoder := json.NewDecoder(bufio.NewReader(bytes.NewReader(payload)))
   138		decoder.DisallowUnknownFields()
   139		var journal Journal
   140		if err := decoder.Decode(&journal); err != nil {
   141			return nil, journalf("decode %s: %v", transactionID, err)
   142		}
   143		if err := ensureJSONEOF(decoder); err != nil {
   144			return nil, journalf("decode %s: %v", transactionID, err)
   145		}
   146		if err := validateJournal(&journal); err != nil {
   147			return nil, err
   148		}
   149		canonical, err := marshalJournal(&journal)
   150		if err != nil {
   151			return nil, err
   152		}
   153		if !bytes.Equal(payload, canonical) {
   154			return nil, journalf("journal %s is not canonical", transactionID)
   155		}
   156		return &journal, nil
   157	}
   158	
   159	func ensureJSONEOF(decoder *json.Decoder) error {
   160		var extra any
   161		err := decoder.Decode(&extra)
   162		if errors.Is(err, io.EOF) {
   163			return nil
   164		}
   165		if err == nil {
   166			return fmt.Errorf("multiple JSON values")
   167		}
   168		return err
   169	}
