   282	
   283	// Recover processes every journal in unsigned transaction-id order. Recovery
   284	// is home-scoped and intentionally does not accept a current project filter.
   285	func (engine *Engine) Recover(lock HomeLock) error {
   286		if err := requireHomeLock(lock); err != nil {
   287			return err
   288		}
   289		engine.mu.Lock()
   290		defer engine.mu.Unlock()
   291		ids, err := engine.journalIDs()
   292		if err != nil {
   293			return err
   294		}
   295		for _, id := range ids {
   296			journal, err := engine.loadJournal(id)
   297			if err != nil {
   298				return err
   299			}
   300			if err := engine.resume(journal); err != nil {
   301				return fmt.Errorf("recover transaction %s: %w", id, err)
   302			}
   303		}
   304		return nil
   305	}
   306	
   307	func (engine *Engine) resume(journal *Journal) error {
   308		switch journal.Phase {
   309		case PhasePreparing:
   310			return engine.discardPreparing(journal)
   311		case PhasePrepared, PhaseCommitting:
   312			return engine.commit(journal)
   313		case PhaseCleanup:
   314			return engine.cleanupCommitted(journal)
   315		case PhaseRollingBack, PhaseRollbackCleanup:
   316			return engine.rollback(journal)
   317		default:
   318			return journalf("unsupported recovery phase %q", journal.Phase)
   319		}
   320	}
