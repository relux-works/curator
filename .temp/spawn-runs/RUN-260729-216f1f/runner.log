Documentation = "https://github.com/ivanopcode/cocoaskills/blob/main/docs/mvp-design.md"

[tool.setuptools]
package-dir = { "" = "src" }

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
"csk.audit" = ["prompts/*.md", "prompts/*.json"]

[tool.setuptools_scm]
version_file = "src/csk/_version.py"

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]

[tool.mypy]
strict = true
python_version = "3.11"
files = ["src/csk"]

