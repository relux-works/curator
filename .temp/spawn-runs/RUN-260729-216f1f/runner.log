   447		case StateCommitted:
   448			current, err := target.digest(target.LivePath)
   449			if err != nil {
   450				return err
   451			}
   452			if current != target.DesiredDigest {
   453				return corruptionf("committed target %s/%s digest %s, want %s", target.Class, target.Identifier, current, target.DesiredDigest)
   454			}
   455			return nil
   456		default:
   457			return journalf("target %s/%s has state %q during commit", target.Class, target.Identifier, target.State)
   458		}
   459	}
   460	
   461	func (engine *Engine) recoverPendingBackup(target *TargetRecord) error {
   462		backupDigest, err := target.digest(target.BackupPath)
   463		if err != nil {
   464			return err
   465		}
   466		if backupDigest == DigestAbsent {
   467			return nil
   468		}
   469		liveDigest, err := target.digest(target.LivePath)
   470		if err != nil {
   471			return err
   472		}
   473		if liveDigest != DigestAbsent {
   474			return corruptionf("target %s/%s has both a pending backup and live bytes", target.Class, target.Identifier)
   475		}
   476		if target.PreimageDigest != "" && backupDigest != target.PreimageDigest {
   477			return corruptionf("pending backup for %s/%s has unknown bytes", target.Class, target.Identifier)
   478		}
   479		if target.ExpectedGeneration != "" {
   480			if err := verifyGenerationAt(target, target.BackupPath); err != nil {
   481				return err
   482			}
   483		}
   484		target.BackupDigest = backupDigest
   485		target.State = StateBackedUp
   486		return nil
   487	}
   488	
   489	func verifyPreimage(target *TargetRecord) error {
   490		if target.PreimageDigest != "" {
   491			current, err := target.digest(target.LivePath)
   492			if err != nil {
   493				return err
   494			}
   495			if current != target.PreimageDigest {
   496				return corruptionf("target %s/%s preimage digest %s, want %s", target.Class, target.Identifier, current, target.PreimageDigest)
   497			}
   498			return nil
   499		}
   500		return verifyGenerationAt(target, target.LivePath)
   501	}
   502	
   503	func verifyGenerationAt(target *TargetRecord, root string) error {
   504		path := root
   505		if target.GenerationPath != "" {
   506			path = filepath.Join(root, filepath.FromSlash(target.GenerationPath))
   507		}
   508		info, err := os.Lstat(path)
   509		if err != nil || !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 || info.Size() > 1024*1024 {
   510			return corruptionf("target %s/%s generation is unavailable or unsafe", target.Class, target.Identifier)
   511		}
   512		file, err := os.Open(path) // #nosec G304 -- path is constrained to the selected live target
   513		if err != nil {
   514			return err
   515		}
   516		after, err := file.Stat()
   517		if err != nil || !os.SameFile(info, after) || !after.Mode().IsRegular() {
   518			_ = file.Close()
   519			return corruptionf("target %s/%s generation changed while opening", target.Class, target.Identifier)
   520		}
   521		payload, readErr := io.ReadAll(io.LimitReader(file, 1024*1024+1))
   522		closeErr := file.Close()
   523		if readErr != nil || closeErr != nil {
   524			return errors.Join(readErr, closeErr)
   525		}
   526		if len(payload) > 1024*1024 {
   527			return corruptionf("target %s/%s generation exceeds the size limit", target.Class, target.Identifier)
   528		}
   529		if string(payload) != target.ExpectedGeneration {
   530			return corruptionf("target %s/%s generation does not match", target.Class, target.Identifier)
   531		}
   532		return nil
   533	}
