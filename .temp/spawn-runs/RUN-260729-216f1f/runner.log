   102	class TransactionEngine:
   103	    """Durable generic replacement transactions under a caller-held home lock."""
   104	
   105	    def __init__(self, csk_home: Path, *, fault_hook: FaultHook | None = None):
   106	        self.home = csk_home.expanduser().resolve(strict=False)
   107	        self.journal_root = self.home / "state" / "transactions" / "v1"
   108	        self._fault_hook = fault_hook
   109	        self._mutex = threading.Lock()
   110	
   111	    def prepare(self, lock: HomeLockWitness, plan: TransactionPlan) -> Journal:
   112	        lock.assert_held()
   113	        with self._mutex:
   114	            journal, sources = self._build_journal(plan)
   115	            path = self._journal_path(journal.transaction_id)
   116	            if path.exists():
   117	                raise TransactionError(
   118	                    f"transaction already exists: {journal.transaction_id}"
   119	                )
   120	            self._save_journal(journal, create=True)
   121	            try:
   122	                for target, source in zip(journal.targets, sources, strict=True):
   123	                    if source is None:
   124	                        continue
   125	                    assert target.staged_path is not None
   126	                    _copy_target(source, Path(target.staged_path))
   127	                    if digest_path(Path(target.staged_path)) != target.desired_digest:
   128	                        raise TransactionCorruptionError(
   129	                            f"staged target changed while preparing: {target.target_class}/{target.identifier}"
   130	                        )
   131	                journal.phase = "prepared"
   132	                self._save_journal(journal)
   133	                self._emit("prepared", None)
   134	                return _clone_journal(journal)
   135	            except Exception:
   136	                self._discard_prepared(journal)
   137	                raise
   138	
   139	    def commit(self, lock: HomeLockWitness, transaction_id: str) -> None:
   140	        lock.assert_held()
   141	        with self._mutex:
   142	            journal = self._load_journal(transaction_id)
   143	            self._resume(journal)
   144	
   145	    def recover(self, lock: HomeLockWitness) -> None:
   146	        """Recover every home journal, regardless of the initiating project."""
   147	        lock.assert_held()
   148	        with self._mutex:
   149	            for transaction_id in self._journal_ids():
   150	                journal, deleting = self._load_journal_record(transaction_id)
   151	                try:
   152	                    if deleting:
   153	                        self._finish_journal_removal(journal)
   154	                    else:
   155	                        self._resume(journal)
   156	                except Exception as exc:
   157	                    raise TransactionError(
   158	                        f"recover transaction {transaction_id}: {exc}"
   159	                    ) from exc
   160	
   161	    def referenced_generation_digests(self, lock: HomeLockWitness) -> dict[str, str]:
   162	        lock.assert_held()
   163	        with self._mutex:
   164	            result: dict[str, str] = {}
   165	            for transaction_id in self._journal_ids():
   166	                journal, deleting = self._load_journal_record(transaction_id)
   167	                if deleting:
   168	                    continue
   169	                for key, digest in journal.generation_digests.items():
   170	                    previous = result.setdefault(key, digest)
   171	                    if previous != digest:
   172	                        raise TransactionCorruptionError(
   173	                            f"generation {key!r} has conflicting journal digests"
   174	                        )
   175	            return dict(sorted(result.items(), key=lambda item: _utf8_key(item[0])))
