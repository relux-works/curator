   363	
   364	func validText(value string) bool {
   365		return utf8.ValidString(value) && !strings.ContainsRune(value, 0)
   366	}
   367	
   368	func validDigest(value string) bool {
   369		if value == DigestAbsent {
   370			return true
   371		}
   372		if len(value) != len("sha256:")+64 || !strings.HasPrefix(value, "sha256:") {
   373			return false
   374		}
   375		for _, value := range value[len("sha256:"):] {
   376			if (value < '0' || value > '9') && (value < 'a' || value > 'f') {
   377				return false
   378			}
   379		}
   380		return true
   381	}
   382	
   383	func sortedUniqueStrings(values []string) bool {
   384		for index, value := range values {
   385			if value == "" || !validText(value) || (index > 0 && strings.Compare(values[index-1], value) >= 0) {
   386				return false
   387			}
   388		}
   389		return true
   390	}
   391	
   392	func validateRemovalEntries(entries []RemovalEntry) error {
   393		if len(entries) == 0 || entries[0].RelativePath != "" {
   394			return fmt.Errorf("root entry is missing")
   395		}
   396		byPath := make(map[string]RemovalEntry, len(entries))
   397		// Carrying the preceding path forward keeps the strict-order check on a
   398		// value the loop has already validated, rather than reaching backwards
   399		// into the slice under a guard that only the reader can see is safe.
   400		previousPath := ""
   401		for index, entry := range entries {
   402			if !validText(entry.RelativePath) || (index > 0 && bytes.Compare([]byte(previousPath), []byte(entry.RelativePath)) >= 0) {
   403				return fmt.Errorf("entry paths are not in strict unsigned-byte order")
   404			}
   405			if entry.RelativePath != "" {
   406				if pathpkg.IsAbs(entry.RelativePath) || pathpkg.Clean(entry.RelativePath) != entry.RelativePath || entry.RelativePath == ".." || strings.HasPrefix(entry.RelativePath, "../") {
   407					return fmt.Errorf("entry path %q is not a safe canonical relative path", entry.RelativePath)
   408				}
   409			}
   410			if entry.Mode > 0o777 {
