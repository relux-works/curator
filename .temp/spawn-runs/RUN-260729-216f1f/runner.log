   100	// Operation owns one ordered project operation. A dry-run operation rejects
   101	// every acquisition before filesystem access.
   102	type Operation struct {
   103		mu           sync.Mutex
   104		manager      *Manager
   105		dryRun       bool
   106		closed       bool
   107		projects     []*fileLock
   108		identities   []ProjectIdentity
   109		buildKey     *fileLock
   110		buildKeyUsed bool
   111		home         *HomeLock
   112	}
   113	
   114	// NewOperation creates an operation state machine. It performs no I/O.
   115	func (manager *Manager) NewOperation(dryRun bool) *Operation {
   116		return &Operation{manager: manager, dryRun: dryRun}
   117	}
   118	
   119	// AcquireProjects canonicalizes and sorts the complete batch before acquiring
   120	// it. Later batches are permitted only when every new identity follows the
   121	// last held identity, so an inversion fails before waiting on an OS lock.
   122	func (operation *Operation) AcquireProjects(ctx context.Context, projects ...string) ([]ProjectIdentity, error) {
   123		if operation == nil || operation.manager == nil {
   124			return nil, fmt.Errorf("manager operation is nil")
   125		}
   126		if operation.dryRun {
   127			return nil, ErrDryRun
   128		}
   129		identities, err := CanonicalProjects(projects...)
   130		if err != nil {
   131			return nil, err
   132		}
   133		if len(identities) == 0 {
   134			return nil, fmt.Errorf("at least one project lock is required")
   135		}
   136	
   137		operation.mu.Lock()
   138		defer operation.mu.Unlock()
   139		if operation.closed {
   140			return nil, orderError("operation is closed")
   141		}
   142		if operation.buildKeyUsed || operation.home != nil {
   143			return nil, orderError("project lock requested after a later lock class")
   144		}
   145		if len(operation.identities) > 0 && compareProject(operation.identities[len(operation.identities)-1], identities[0]) >= 0 {
   146			return nil, orderError("project identities are not strictly increasing")
   147		}
   148		if err := operation.manager.prepare(); err != nil {
   149			return nil, err
   150		}
   151		process := operation.manager.processState()
   152		if err := process.reserve(acquireProject); err != nil {
   153			return nil, err
   154		}
   155		acquired := false
   156		defer func() { process.finish(acquireProject, acquired) }()
   157	
   158		batch := make([]*fileLock, 0, len(identities))
   159		for _, identity := range identities {
   160			lock, acquireErr := acquireFileLock(ctx, operation.manager.projectLockPath(identity), nil)
   161			if acquireErr != nil {
   162				for index := len(batch) - 1; index >= 0; index-- {
   163					acquireErr = errors.Join(acquireErr, batch[index].Close())
   164				}
   165				return nil, acquireErr
   166			}
   167			batch = append(batch, lock)
   168		}
   169		acquired = true
   170		operation.projects = append(operation.projects, batch...)
   171		operation.identities = append(operation.identities, identities...)
   172		return append([]ProjectIdentity(nil), operation.identities...), nil
   173	}
   174	
   175	// AcquireBuildKey takes the optional per-key deduplication lock. An operation
   176	// may use at most one key, and must release it before acquiring the home lock.
   177	func (operation *Operation) AcquireBuildKey(ctx context.Context, logicalKey string) error {
   178		if operation == nil || operation.manager == nil {
   179			return fmt.Errorf("manager operation is nil")
   180		}
   181		if operation.dryRun {
   182			return ErrDryRun
   183		}
   184		if logicalKey == "" || !utf8.ValidString(logicalKey) || strings.IndexByte(logicalKey, 0) >= 0 {
   185			return fmt.Errorf("logical build key is empty or invalid UTF-8")
   186		}
   187	
   188		operation.mu.Lock()
   189		defer operation.mu.Unlock()
   190		if operation.closed || len(operation.projects) == 0 || operation.buildKeyUsed || operation.home != nil {
   191			return orderError("build-key lock requires held project locks and may be used once before the home lock")
   192		}
   193		process := operation.manager.processState()
   194		if err := process.reserve(acquireBuildKey); err != nil {
   195			return err
   196		}
   197		acquired := false
   198		defer func() { process.finish(acquireBuildKey, acquired) }()
   199		lock, err := acquireFileLock(ctx, operation.manager.buildKeyLockPath(logicalKey), func() {
   200			process.released(acquireBuildKey)
   201		})
   202		if err != nil {
   203			return err
   204		}
   205		acquired = true
   206		operation.buildKey = lock
   207		operation.buildKeyUsed = true
   208		return nil
   209	}
   210	
   211	// ReleaseBuildKey releases the optional key lock before the serialized commit
   212	// phase. The persistent lock file deliberately remains in manager state.
   213	func (operation *Operation) ReleaseBuildKey() error {
   214		if operation == nil {
   215			return nil
   216		}
   217		operation.mu.Lock()
   218		defer operation.mu.Unlock()
   219		if operation.buildKey == nil {
   220			return orderError("build-key lock is not held")
   221		}
   222		err := operation.buildKey.Close()
   223		operation.buildKey = nil
   224		return err
   225	}
   226	
   227	// HomeLock is an exclusive manager-home mutation witness. It satisfies the
   228	// caller-held witness expected by buildcache and future transaction code.
   229	type HomeLock struct {
   230		lock *fileLock
   231	}
   232	
   233	// AssertHeld verifies that the operating-system lock has not been released.
   234	func (lock *HomeLock) AssertHeld() error {
   235		if lock == nil {
   236			return ErrNotHeld
   237		}
   238		return lock.lock.AssertHeld()
   239	}
   240	
   241	// Close releases the operating-system lock without deleting its stable file.
   242	func (lock *HomeLock) Close() error {
   243		if lock == nil {
   244			return nil
   245		}
   246		return lock.lock.Close()
   247	}
   248	
   249	// AcquireHome acquires the mutation lock after project locks and after an
   250	// optional build-key lock has been released.
   251	func (operation *Operation) AcquireHome(ctx context.Context) (*HomeLock, error) {
   252		if operation == nil || operation.manager == nil {
   253			return nil, fmt.Errorf("manager operation is nil")
   254		}
   255		if operation.dryRun {
   256			return nil, ErrDryRun
   257		}
   258		operation.mu.Lock()
   259		defer operation.mu.Unlock()
   260		if operation.closed || len(operation.projects) == 0 || operation.buildKey != nil || operation.home != nil {
   261			return nil, orderError("home lock requires held project locks and no held build-key lock")
   262		}
   263		return operation.acquireHome(ctx)
   264	}
   265	
   266	func (operation *Operation) acquireHome(ctx context.Context) (*HomeLock, error) {
   267		process := operation.manager.processState()
   268		if err := process.reserve(acquireHome); err != nil {
   269			return nil, err
   270		}
   271		acquired := false
   272		defer func() { process.finish(acquireHome, acquired) }()
   273		fileLock, err := acquireFileLock(ctx, operation.manager.homeLockPath(), func() {
   274			process.released(acquireHome)
   275		})
   276		if err != nil {
   277			return nil, err
   278		}
   279		acquired = true
   280		operation.home = &HomeLock{lock: fileLock}
   281		return operation.home, nil
   282	}
   283	
   284	// AcquireHomeOnly is the recovery/GC path. It acquires no project or key lock.
   285	// dryRun rejects the request without creating any manager state.
   286	func (manager *Manager) AcquireHomeOnly(ctx context.Context, dryRun bool) (*HomeLock, error) {
   287		if manager == nil {
   288			return nil, fmt.Errorf("manager is nil")
   289		}
   290		if dryRun {
   291			return nil, ErrDryRun
   292		}
   293		if err := manager.prepare(); err != nil {
   294			return nil, err
   295		}
   296		process := manager.processState()
   297		if err := process.reserve(acquireHome); err != nil {
   298			return nil, err
   299		}
   300		acquired := false
   301		defer func() { process.finish(acquireHome, acquired) }()
   302		fileLock, err := acquireFileLock(ctx, manager.homeLockPath(), func() {
   303			process.released(acquireHome)
   304		})
   305		if err != nil {
   306			return nil, err
   307		}
   308		acquired = true
   309		return &HomeLock{lock: fileLock}, nil
   310	}
   311	
   312	// Close releases held locks in reverse class and project order.
   313	func (operation *Operation) Close() error {
   314		if operation == nil {
   315			return nil
   316		}
   317		operation.mu.Lock()
   318		defer operation.mu.Unlock()
   319		if operation.closed {
   320			return nil
   321		}
   322		operation.closed = true
   323		var result error
   324		if operation.home != nil {
   325			result = errors.Join(result, operation.home.Close())
   326			operation.home = nil
   327		}
   328		if operation.buildKey != nil {
   329			result = errors.Join(result, operation.buildKey.Close())
   330			operation.buildKey = nil
   331		}
   332		for index := len(operation.projects) - 1; index >= 0; index-- {
   333			result = errors.Join(result, operation.projects[index].Close())
   334		}
   335		operation.projects = nil
   336		return result
   337	}
