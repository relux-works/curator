   333					return errors.Join(err, saveErr)
   334				}
   335				return errors.Join(err, engine.rollback(journal))
   336			}
   337		}
   338		journal.Phase = PhaseCleanup
   339		if err := engine.saveJournal(journal); err != nil {
   340			return err
   341		}
   342		if err := engine.emit(journal, -1, PointBeforeCleanup); err != nil {
   343			return err
   344		}
   345		return engine.cleanupCommitted(journal)
   346	}
