   339	func (manager *Manager) projectLockPath(identity ProjectIdentity) string {
   340		manager.mu.RLock()
   341		defer manager.mu.RUnlock()
   342		return filepath.Join(manager.lockRoot, "projects", lockName("project", string(identity)))
   343	}
   344	
   345	func (manager *Manager) buildKeyLockPath(logicalKey string) string {
   346		manager.mu.RLock()
   347		defer manager.mu.RUnlock()
   348		return filepath.Join(manager.lockRoot, "build", lockName("build-key", logicalKey))
   349	}
   350	
   351	func (manager *Manager) homeLockPath() string {
