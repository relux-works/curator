   240	func validateGenerationPath(path string) error {
   241		if path == "" {
   242			return nil
   243		}
   244		clean := filepath.Clean(filepath.FromSlash(path))
   245		if filepath.IsAbs(clean) || clean == ".." || strings.HasPrefix(clean, ".."+string(filepath.Separator)) {
