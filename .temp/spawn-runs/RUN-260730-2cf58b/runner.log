+#!/usr/bin/env python3
+"""Task-scoped, read-only protocol rc.6 conformance audits."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+from collections import Counter
