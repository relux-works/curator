+        *(
+            f"csk-skill-v{version}/{name}.json"
+            for version in range(1, 6)
+            for name in ("valid", "invalid")
+        ),
+        *(f"install-marker-v1/{name}.json" for name in ("valid", "invalid")),
+        *(f"conformance-claim-v1/{name}.json" for name in ("valid", "invalid")),
