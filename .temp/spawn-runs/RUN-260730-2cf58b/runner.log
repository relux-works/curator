+#!/usr/bin/env python3
+"""Task-scoped, read-only protocol rc.6 conformance audits."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+from collections import Counter
+from pathlib import Path
+from typing import Any
+
+
+RC5_COMMIT = "f5d7673039226ab81de2f4f87e2155ae995c4df3"
+LEGACY_BASELINE = "57c1f56846d221ecc55786bd3c2467ec32f11730"
+RC5_RELEASE_SHA256 = (
+    "75ae17fc029b4f51ca40ce768d04fd72991ec3db2602b8fe59213bee6ac34583"
+)
+
+REQUIRED_SCHEMA_CASE_COUNTS = {
+    "agent-skill-v6.schema.json": 24,
+    "csk-skill-v6.schema.json": 24,
+    "build-receipt-v1.schema.json": 18,
+    "install-marker-v2.schema.json": 14,
+    "conformance-claim-v2.schema.json": 7,
+    "conformance-claim-v3.schema.json": 13,
+}
+
+COMPILED_LIFECYCLE_CASES = {
+    "dry_run_cases": {"compiled-cache-miss-is-read-only"},
+    "planning_cases": {"all-source-and-trust-gates-before-build"},
+    "build_order_cases": {"provider-first-and-lexical-command-order"},
+    "private_build_cases": {
+        "all-misses-stage-and-verify-before-home-lock",
+        "second-build-failure-preserves-persistent-state",
+    },
+    "cache_publication_cases": {
+        "publish-complete-immutable-entry-under-home-lock",
+        "concurrent-identical-winner",
+        "concurrent-determinism-mismatch",
+        "corrupt-live-entry",
+        "untrusted-cache-boundary",
+    },
+    "cross_project_cases": {
+        "two-project-success-preserves-both-consumers",
+        "successful-project-survives-other-project-rollback",
+    },
+    "transaction_cases": {
+        "deterministic-lock-order",
+        "deterministic-target-order-and-consumer-last",
+        "reverse-rollback-under-home-lock",
+    },
+    "recovery_cases": {
+        "interrupted-global-journal-recovered-by-transaction-id",
+        "install-recovery-runs-after-private-builds",
+    },
+    "status_cases": {
+        "compiled-installation-current",
+        "compiled-currentness-failure-matrix",
+    },
+    "repair_cases": {"repair-rebuilds-invalid-compiled-entry"},
+    "gc_cases": {
+        "locked-mark-and-sweep-compiled-cache",
+        "post-commit-gc-failure-is-maintenance-warning",
+    },
+}
+
+
+def load_json(path: Path) -> Any:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def git(root: Path, *arguments: str, text: bool = True) -> str | bytes:
+    result = subprocess.run(
+        ["/usr/bin/git", *arguments],
+        cwd=root,
+        check=True,
+        capture_output=True,
+        text=text,
+    )
+    return result.stdout.strip() if text else result.stdout
+
+
+def git_show(root: Path, ref: str, relative: str) -> bytes:
+    return git(root, "show", f"{ref}:{relative}", text=False)
+
+
+def manifest_audit(root: Path) -> None:
+    suite = root / "conformance" / "v1"
+    manifest_path = suite / "manifest.json"
+    manifest = load_json(manifest_path)
+    assert manifest["protocol_version"] == "1.0.0-rc.6"
+    entries = manifest["files"]
+    assert all(set(entry) == {"path", "sha256"} for entry in entries)
+    listed = [entry["path"] for entry in entries]
+    assert listed == sorted(listed)
+    assert len(listed) == len(set(listed))
+    actual = sorted(
+        path.relative_to(suite).as_posix()
+        for path in suite.rglob("*")
+        if path.is_file()
+        and path.name != "manifest.json"
+        and "__pycache__" not in path.parts
+    )
+    assert listed == actual
+    hashes = {entry["path"]: entry["sha256"] for entry in entries}
+    for relative in listed:
+        assert hashes[relative] == f"sha256:{sha256(suite / relative)}"
+
+    index = load_json(suite / "schema-cases" / "index.json")
+    indexed_instances = [entry["instance"] for entry in index]
+    actual_instances = sorted(
+        path.relative_to(suite / "schema-cases").as_posix()
+        for path in (suite / "schema-cases").rglob("*.json")
+        if path.name != "index.json"
+    )
+    assert sorted(indexed_instances) == actual_instances
+    assert len(indexed_instances) == len(set(indexed_instances))
+
+    schema_counts = Counter(entry["schema"] for entry in index)
+    for schema, expected_count in REQUIRED_SCHEMA_CASE_COUNTS.items():
+        assert schema_counts[schema] == expected_count
+
+    fixture_files = sorted(
+        path.relative_to(suite).as_posix()
+        for path in (suite / "fixtures" / "go-build-skill").rglob("*")
+        if path.is_file()
+    )
+    expected_files = sorted(
+        path.relative_to(suite).as_posix()
+        for path in (suite / "expected" / "build-driver").rglob("*")
+        if path.is_file()
+    )
+    assert len(fixture_files) == 13
+    assert len(expected_files) == 11
+    assert set(fixture_files + expected_files) <= set(listed)
+
+    build_drivers = load_json(suite / "vectors" / "build-drivers.json")
+    assert len(build_drivers["positive_cases"]) == 8
+    assert len(build_drivers["rejection_cases"]) == 77
+    assert len(build_drivers["build_source_cases"]) == 10
+    assert len(build_drivers["toolchain_cases"]) == 12
+    assert all(
+        case["expected"]["result"] == "reject"
+        and case["expected"]["artifact_executed"] is False
+        and case["expected"]["reuse"] is False
+        for case in build_drivers["rejection_cases"]
+    )
+
+    manager = load_json(suite / "vectors" / "manager-lifecycle.json")
+    assert manager["schema_version"] == 1
+    compiled_names: list[str] = []
+    for field, required_names in COMPILED_LIFECYCLE_CASES.items():
+        actual_names = {case["name"] for case in manager[field]}
+        assert required_names <= actual_names
+        compiled_names.extend(sorted(required_names))
+    all_lifecycle_names = [
+        case["name"]
+        for field, values in manager.items()
+        if field.endswith("_cases") and isinstance(values, list)
+        for case in values
+    ]
+    assert len(all_lifecycle_names) == 32
+    assert len(compiled_names) == 22
+    fixture = manager["compiled_build_fixture"]
+    portable = build_drivers["portable_identity"]
+    assert fixture["source_vector"] == "build-drivers.json#/portable_identity"
+    for lifecycle_field, identity_field in {
+        "execution_policy": "execution_policy",
+        "build_input": "build_input",
+        "cache_key": "cache_key",
+        "stored_receipt": "stored_receipt",
+        "receipt_sha256": "receipt_sha256",
+        "artifact": "artifact",
+    }.items():
+        assert fixture[lifecycle_field] == portable[identity_field]
+
+    manifest_identity = f"sha256:{sha256(manifest_path)}"
+    rc6 = load_json(root / "release" / "1.0.0-rc.6.json")
+    assert rc6["candidate_protocol_pin"]["manifest_sha256"] == manifest_identity
+    assert (
+        rc6["downstream_consumption"]["required_manifest_sha256"]
+        == manifest_identity
+    )
+
+    print("protocol_version=1.0.0-rc.6")
+    print(f"manifest_entries={len(entries)}")
+    print(f"manifest_sha256={manifest_identity}")
+    print(f"schema_count={len(list((root / 'schemas' / 'v1').glob('*.json')))}")
+    print(f"schema_case_entries={len(index)}")
+    for schema, expected_count in REQUIRED_SCHEMA_CASE_COUNTS.items():
+        print(f"schema_cases[{schema}]={expected_count}")
+        for entry in sorted(
+            (item for item in index if item["schema"] == schema),
+            key=lambda item: item["instance"],
+        ):
+            relative = f"schema-cases/{entry['instance']}"
+            print(
+                "schema_case="
+                f"{schema}|{entry['instance']}|valid={str(entry['valid']).lower()}|"
+                f"{hashes[relative]}"
+            )
+    print(f"go_build_fixture_files={len(fixture_files)}")
+    for relative in fixture_files:
+        print(f"fixture={relative}|{hashes[relative]}")
+    print(f"expected_build_driver_files={len(expected_files)}")
+    for relative in expected_files:
+        print(f"expected={relative}|{hashes[relative]}")
+    print(f"build_driver_positive_cases={len(build_drivers['positive_cases'])}")
+    print(f"build_driver_rejection_cases={len(build_drivers['rejection_cases'])}")
+    print(f"build_source_cases={len(build_drivers['build_source_cases'])}")
+    print(f"toolchain_cases={len(build_drivers['toolchain_cases'])}")
+    for case in build_drivers["rejection_cases"]:
+        print(f"build_driver_rejection={case['boundary']}|{case['name']}")
+    print(f"lifecycle_named_cases={len(all_lifecycle_names)}")
+    print(f"compiled_lifecycle_cases={len(compiled_names)}")
+    for name in sorted(compiled_names):
+        print(f"compiled_lifecycle_case={name}")
+    print(
+        "manager_lifecycle_sha256="
+        f"sha256:{sha256(suite / 'vectors' / 'manager-lifecycle.json')}"
+    )
+    print("all_manifest_hashes_match=true")
+    print("schema_case_index_exact=true")
+    print("release_pins_match_manifest=true")
+    print("manifest_inventory_audit_exit=0")
+
+
+def legacy_audit(root: Path) -> None:
+    schema_paths = [
+        *(f"schemas/v1/agent-skill-v{version}.schema.json" for version in range(1, 6)),
+        *(f"schemas/v1/csk-skill-v{version}.schema.json" for version in range(1, 6)),
+        "schemas/v1/install-marker-v1.schema.json",
+        "schemas/v1/conformance-claim-v1.schema.json",
+    ]
+    base_case_instances = [
+        *(
+            f"agent-skill-v{version}/{name}.json"
+            for version in range(1, 6)
+            for name in ("valid", "invalid")
+        ),
+        *(
+            f"csk-skill-v{version}/{name}.json"
+            for version in range(1, 6)
+            for name in ("valid", "invalid")
+        ),
+        *(f"install-marker-v1/{name}.json" for name in ("valid", "invalid")),
+        *(f"conformance-claim-v1/{name}.json" for name in ("valid", "invalid")),
+    ]
+    for relative in schema_paths:
+        current = (root / relative).read_bytes()
+        assert current == git_show(root, RC5_COMMIT, relative)
+        assert current == git_show(root, LEGACY_BASELINE, relative)
+    for instance in base_case_instances:
+        relative = f"conformance/v1/schema-cases/{instance}"
+        current = (root / relative).read_bytes()
+        assert current == git_show(root, RC5_COMMIT, relative)
+        assert current == git_show(root, LEGACY_BASELINE, relative)
+
+    current_index = load_json(root / "conformance/v1/schema-cases/index.json")
+    baseline_index = json.loads(
+        git_show(
+            root,
+            LEGACY_BASELINE,
+            "conformance/v1/schema-cases/index.json",
+        )
+    )
+    current_by_instance = {entry["instance"]: entry for entry in current_index}
+    baseline_by_instance = {entry["instance"]: entry for entry in baseline_index}
+    for instance in base_case_instances:
+        assert current_by_instance[instance] == baseline_by_instance[instance]
+
+    current_manifest = load_json(root / "conformance/v1/manifest.json")
+    baseline_manifest = json.loads(
+        git_show(root, LEGACY_BASELINE, "conformance/v1/manifest.json")
+    )
+    current_manifest_by_path = {
+        entry["path"]: entry["sha256"] for entry in current_manifest["files"]
+    }
+    baseline_manifest_by_path = {
+        entry["path"]: entry["sha256"] for entry in baseline_manifest["files"]
+    }
+    for instance in base_case_instances:
+        relative = f"schema-cases/{instance}"
+        assert current_manifest_by_path[relative] == baseline_manifest_by_path[relative]
+
+    legacy_manifest_prefixes = tuple(
+        [
+            *(f"agent-skill-v{version}/" for version in range(1, 6)),
+            *(f"csk-skill-v{version}/" for version in range(1, 6)),
+        ]
+    )
+    guard_entries = [
+        entry
+        for entry in current_index
+        if entry["instance"].startswith(legacy_manifest_prefixes)
+        and Path(entry["instance"]).name not in {"valid.json", "invalid.json"}
+    ]
+    assert len(guard_entries) == 70
+    assert all(entry["valid"] is False for entry in guard_entries)
+
+    marker = load_json(root / "schemas/v1/install-marker-v1.schema.json")
+    claim = load_json(root / "schemas/v1/conformance-claim-v1.schema.json")
+    assert marker["properties"]["schema_version"] == {"const": 1}
+    assert claim["properties"]["schema_version"] == {"const": 1}
+    assert claim["properties"]["protocol_version"] == {"const": "1.0.0-rc.3"}
+    assert sha256(root / "release" / "1.0.0-rc.5.json") == RC5_RELEASE_SHA256
+    assert (root / "release" / "1.0.0-rc.5.json").read_bytes() == git_show(
+        root, RC5_COMMIT, "release/1.0.0-rc.5.json"
+    )
+
+    print(f"candidate_head={git(root, 'rev-parse', 'HEAD')}")
+    print(f"candidate_parent={git(root, 'rev-parse', 'HEAD^')}")
+    print(f"origin_main={git(root, 'rev-parse', 'origin/main')}")
+    print(f"legacy_baseline={LEGACY_BASELINE}")
+    for relative in schema_paths:
+        print(f"legacy_schema_sha256[{relative}]={sha256(root / relative)}")
+    print(f"legacy_schema_files_byte_identical={len(schema_paths)}")
+    print(f"legacy_schema_cases_byte_identical={len(base_case_instances)}")
+    print("legacy_index_entries_preserved=true")
+    print("legacy_manifest_entries_preserved=true")
+    print(f"new_schema7_guard_cases_for_legacy_manifests={len(guard_entries)}")
+    print("new_legacy_guard_expected_valid=false")
+    print("install_marker_v1_semantics_frozen=true")
+    print("claim_v1_protocol_version=1.0.0-rc.3")
+    print(f"rc5_release_metadata_sha256={RC5_RELEASE_SHA256}")
+    print("rc5_release_metadata_byte_identical_to_origin_main=true")
+    print("legacy_compatibility_audit_exit=0")
+
+
+def safety_audit(root: Path, source: Path) -> None:
+    git_executable = shutil.which("git")
+    assert git_executable == "/usr/bin/git"
+    for name in ("GIT_INDEX_FILE", "GIT_DIR", "GIT_WORK_TREE"):
+        assert os.environ.get(name) is None
+
+    generator_source = "\n".join(
+        path.read_text(encoding="utf-8")
+        for path in sorted((root / "tools" / "generate-vectors").glob("*.go"))
+    )
+    validator_source = (root / "tools" / "validate.py").read_text(encoding="utf-8")
+    release_source = (root / "tools" / "release_gate.py").read_text(encoding="utf-8")
+    process_tokens = ("os/exec", "exec.Command", "syscall.Exec", "plugin.Open")
+    assert not any(token in generator_source for token in process_tokens)
+    assert not any(
+        token in validator_source
+        for token in ("subprocess", "os.system", "Popen", "exec(")
+    )
+    assert release_source.count("subprocess.run(") == 1
+    assert '["git", *arguments]' in release_source
+
+    build_drivers = load_json(
+        root / "conformance" / "v1" / "vectors" / "build-drivers.json"
+    )
+    rejections = build_drivers["rejection_cases"]
+    assert all(
+        case["expected"]["result"] == "reject"
+        and case["expected"]["artifact_executed"] is False
+        and case["expected"]["reuse"] is False
+        for case in rejections
+    )
+    manager = load_json(
+        root / "conformance" / "v1" / "vectors" / "manager-lifecycle.json"
+    )
+    compiled_dry_run = next(
+        case
+        for case in manager["dry_run_cases"]
+        if case["name"] == "compiled-cache-miss-is-read-only"
+    )
+    assert compiled_dry_run["artifact_executed"] is False
+    assert set(compiled_dry_run["forbidden_go_commands"]) == {"list", "build"}
+
+    release = load_json(root / "release" / "1.0.0-rc.6.json")
+    assert release["claim_v3"]["claims_emitted"] == []
+    assert release["claim_v3"]["rc6_claim_schema"] is None
+    assert release["downstream_consumption"]["committed_release_pin_advanced"] is False
+    assert release["execution_policy"]["hardened_profile_claimed"] is False
+    assert sha256(root / "release" / "1.0.0-rc.5.json") == RC5_RELEASE_SHA256
+
+    candidate_head = git(root, "rev-parse", "HEAD")
+    assert git(root, "rev-parse", "HEAD^") == RC5_COMMIT
+    assert git(root, "status", "--porcelain=v1", "--untracked-files=all") == ""
+    assert git(root, "diff", "--cached", "--name-only") == ""
+    assert git(root, "tag", "--points-at", "HEAD") == ""
+    assert git(root, "log", "-1", "--format=%G?") == "N"
+    assert git(source, "rev-parse", "HEAD") == RC5_COMMIT
+    assert git(source, "diff", "--cached", "--name-only") == ""
+    assert git(source, "rev-parse", "origin/main") == RC5_COMMIT
+
+    print(f"git_executable={git_executable}")
+    for name in ("GIT_INDEX_FILE", "GIT_DIR", "GIT_WORK_TREE"):
+        print(f"{name}=None")
+    print("generator_process_execution_api=false")
+    print("validator_process_execution_api=false")
+    print("release_gate_subprocess_calls=1")
+    print("release_gate_subprocess_scope=git-only")
+    print(f"build_driver_rejections={len(rejections)}")
+    print("all_rejections_artifact_executed=false")
+    print("all_rejections_result=reject")
+    print("compiled_dry_run_artifact_executed=false")
+    print("compiled_dry_run_go_list_or_build_executed=false")
+    print("claims_emitted=0")
+    print("committed_release_pin_advanced=false")
+    print("hardened_profile_claimed=false")
+    print(f"source_worktree_head={git(source, 'rev-parse', 'HEAD')}")
+    print("source_worktree_staged_changes=false")
+    print(f"validation_candidate_head={candidate_head}")
+    print(f"validation_candidate_parent={git(root, 'rev-parse', 'HEAD^')}")
+    print(f"validation_candidate_tree={git(root, 'rev-parse', 'HEAD^{tree}')}")
+    print(f"validation_candidate_signature={git(root, 'log', '-1', '--format=%G?')}")
+    print("validation_candidate_tags=0")
+    print("validation_candidate_scope=disposable-local-test-only")
+    print(f"remote_main={git(source, 'rev-parse', 'origin/main')}")
+    print("remote_main_unchanged=true")
+    print("push_performed=false")
+    print("tag_performed=false")
+    print("release_performed=false")
+    print("implementation_pin_changed=false")
+    print("safety_publication_audit_exit=0")
+
+
+def lifecycle_audit(root: Path, accepted_root: Path) -> None:
+    current_path = root / "conformance" / "v1" / "vectors" / "manager-lifecycle.json"
+    accepted_path = (
+        accepted_root
+        / "conformance"
+        / "v1"
+        / "vectors"
+        / "manager-lifecycle.json"
+    )
+    current = load_json(current_path)
+    accepted = load_json(accepted_path)
+    current_fixture = current["compiled_build_fixture"]
+    accepted_fixture = accepted["compiled_build_fixture"]
+    current_cache_key = current_fixture["cache_key"]
+    accepted_cache_key = accepted_fixture["cache_key"]
+    current_receipt = current_fixture["receipt_sha256"]
+    accepted_receipt = accepted_fixture["receipt_sha256"]
+    assert current_cache_key != accepted_cache_key
+    assert current_receipt != accepted_receipt
+    assert current_fixture["execution_policy"] == "manager-worker-v1"
+
+    replacements = {
+        current_cache_key: "<portable-cache-key>",
+        accepted_cache_key: "<portable-cache-key>",
+        current_receipt: "<portable-receipt-sha256>",
+        accepted_receipt: "<portable-receipt-sha256>",
+    }
+
+    def normalize(value: Any) -> Any:
+        if isinstance(value, dict):
+            return {
+                key: normalize(child)
+                for key, child in value.items()
+                if key != "execution_policy"
+            }
+        if isinstance(value, list):
+            return [normalize(child) for child in value]
+        if isinstance(value, str):
+            return replacements.get(value, value)
+        return value
+
+    normalized_current = normalize(current)
+    normalized_accepted = normalize(accepted)
+    assert normalized_current == normalized_accepted
+    normalized_bytes = (
+        json.dumps(
+            normalized_current,
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+        )
+        + "\n"
+    ).encode()
+    accepted_names = {
+        name
+        for names in COMPILED_LIFECYCLE_CASES.values()
+        for name in names
+    }
+    current_names = {
+        case["name"]
+        for field in COMPILED_LIFECYCLE_CASES
+        for case in current[field]
+    }
+    assert accepted_names <= current_names
+
+    print(f"accepted_lifecycle_sha256=sha256:{sha256(accepted_path)}")
+    print(f"current_lifecycle_sha256=sha256:{sha256(current_path)}")
+    print(f"accepted_cache_key={accepted_cache_key}")
+    print(f"current_cache_key={current_cache_key}")
+    print(f"accepted_receipt_sha256={accepted_receipt}")
+    print(f"current_receipt_sha256={current_receipt}")
+    print("expected_identity_delta=execution_policy+cache_key+receipt_sha256")
+    print(f"compiled_lifecycle_cases={len(accepted_names)}")
+    print(
+        "normalized_semantic_sha256="
+        f"sha256:{hashlib.sha256(normalized_bytes).hexdigest()}"
+    )
+    print("normalized_lifecycle_semantics_byte_identical=true")
+    print("lifecycle_semantic_parity_audit_exit=0")
+
+
+def main() -> int:
+    if len(sys.argv) not in {3, 4}:
+        raise SystemExit(
+            "usage: audit_rc6.py manifest|legacy ROOT "
+            "or audit_rc6.py safety ROOT SOURCE "
+            "or audit_rc6.py lifecycle ROOT ACCEPTED_ROOT"
+        )
+    mode = sys.argv[1]
+    root = Path(sys.argv[2]).resolve()
+    if mode == "manifest":
+        manifest_audit(root)
+    elif mode == "legacy":
+        legacy_audit(root)
+    elif mode == "safety" and len(sys.argv) == 4:
+        safety_audit(root, Path(sys.argv[3]).resolve())
+    elif mode == "lifecycle" and len(sys.argv) == 4:
+        lifecycle_audit(root, Path(sys.argv[3]).resolve())
+    else:
+        raise SystemExit(f"unsupported audit mode: {mode}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

