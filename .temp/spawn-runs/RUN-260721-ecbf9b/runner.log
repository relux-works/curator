+	otherRoot := testToolchain(t)
+	host := hostFacts{runtimeGOROOT: root, goos: runtime.GOOS, goarch: runtime.GOARCH}
+	cases := []struct {
+		name   string
+		mutate func(int, Process, Output) (Output, error)
+		code   string
