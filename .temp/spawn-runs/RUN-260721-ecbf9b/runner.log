+	if _, _, _, _, err := parseGoVersion([]byte("go version go1.22.12 " + runtime.GOOS + "/" + runtime.GOARCH + "\n")); DiagnosticCode(err) != "unsupported_go_family" {
+		t.Fatalf("pre-1.23 error = %v", err)
