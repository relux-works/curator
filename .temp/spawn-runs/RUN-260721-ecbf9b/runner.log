+func TestToolchainMutationFailsRecheck(t *testing.T) {
+	root := testToolchain(t)
+	host := hostFacts{runtimeGOROOT: root, goos: runtime.GOOS, goarch: runtime.GOARCH}
+	executor := validProbeExecutor(t, root, host)
