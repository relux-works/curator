+		PrivateBase: base, CuratorGo: filepath.Join(selected, "bin", platformGoName), GOROOT: ignored,
+		Executor: executor,
+	}
+	session, err := establish(context.Background(), config, host)
+	if err != nil {
+		t.Fatal(err)
