+	defer session.Close()
+	if session.GOROOT() != selected {
+		t.Fatalf("GOROOT = %q, want CURATOR_GO root %q", session.GOROOT(), selected)
+	}
+	for _, call := range executor.calls {
+		if call.Executable != filepath.Join(selected, "bin", platformGoName) {
+			t.Fatalf("executed unselected path %q", call.Executable)
