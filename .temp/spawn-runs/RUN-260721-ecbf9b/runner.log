+			config.Executor = executor
+			session, err := establish(context.Background(), config, host)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer session.Close()
+			if session.GOROOT() != physicalRoot {
+				t.Fatalf("GOROOT = %q", session.GOROOT())
+			}
+		})
+	}
+}
