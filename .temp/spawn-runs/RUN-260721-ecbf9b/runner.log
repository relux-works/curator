+func TestRealTrustedGoProbe(t *testing.T) {
+	if os.Getenv("CURATOR_REAL_GO_TEST") != "1" {
+		t.Skip("set CURATOR_REAL_GO_TEST=1 for the bounded native toolchain probe")
+	}
