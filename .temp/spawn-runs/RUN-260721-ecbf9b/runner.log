+	writeTestFile(t, filepath.Join(root, "VERSION"), []byte("go1.25.5\n"), 0o644)
+	writeTestFile(t, filepath.Join(root, "pkg", "tool", runtime.GOOS+"_"+runtime.GOARCH, "compile"), testExecutableBytes(), 0o755)
+	return root
