+	}
+	if session.Target().GOOS != runtime.GOOS || session.Target().GOARCH != runtime.GOARCH {
+		t.Fatalf("target = %+v", session.Target())
+	}
+	if err := session.Close(); err != nil {
+		t.Fatal(err)
