+	duplicate := `{"GOROOT":"a","GOROOT":"b"}`
+	if _, err := decodeProbeEnvironment([]byte(duplicate)); DiagnosticCode(err) != "invalid_go_env" {
+		t.Fatalf("duplicate error = %v", err)
+	}
+}
