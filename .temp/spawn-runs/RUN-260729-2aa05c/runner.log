+def _create_probe_layout(root: Path, host: _Host) -> _ProbeLayout:
+    home = root / "home"
+    appdata = root / "appdata"
+    config = appdata if host.windows else root / "config"
+    if host.goos == "darwin":
+        config = home / "Library" / "Application Support"
