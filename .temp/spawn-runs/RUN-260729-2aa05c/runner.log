+            "APPDATA": str(tmp_path / "unused-appdata"),
+        },
+        host,
+    )
+    duplicate = (
+        b'{"GOROOT":"'
+        + str(goroot).encode()
+        + b'","GOROOT":"'
+        + str(goroot).encode()
+        + b'"}'
+    )
+    cases = [
+        duplicate,
+        json.dumps({key: value for key, value in values.items() if key != "GOOS"}).encode(),
+        json.dumps(values | {"UNKNOWN": ""}).encode(),
