+GO_RELPATH: Final = "bin/go"
+TESTED_GO_FAMILIES: Final[tuple[str, ...]] = ("1.25",)
+
+GO_ENV_FIELDS: Final[tuple[str, ...]] = (
+    "GOROOT",
+    "GOHOSTOS",
+    "GOHOSTARCH",
+    "GOOS",
+    "GOARCH",
+    "GO386",
+    "GOAMD64",
+    "GOARM",
+    "GOARM64",
+    "GOMIPS",
