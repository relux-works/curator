+    info = payload.lstat()
+    record = toolchain._TreeRecord(
+        protocol_path="file",
+        path_bytes=b"file",
+        native_path=payload,
+        kind="F",
+        initial_stat=info,
+    )
+    with pytest.raises(toolchain.ToolchainError) as duplicate:
+        toolchain._canonical_records([record, record])
+    _assert_code("duplicate_path", duplicate)
