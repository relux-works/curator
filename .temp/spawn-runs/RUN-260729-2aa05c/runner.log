+    assert snapshot.toolchain.algorithm == toolchain.TOOLCHAIN_ALGORITHM
+    assert snapshot.toolchain.go_relpath == "bin/go"
+    assert snapshot.toolchain.go_version.startswith("go version go1.25.5 ")
