+def test_capture_is_immutable_across_project_path_augmentation(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+):
+    config, runner, goroot, _ = _setup(tmp_path)
+    captured = toolchain.capture_operator_search_path(
+        {"PATH": str(goroot / "bin")}
