+    probe_timeout: float = DEFAULT_PROBE_TIMEOUT
+    output_limit: int = DEFAULT_OUTPUT_LIMIT
+    fingerprint_timeout: float = DEFAULT_FINGERPRINT_TIMEOUT
+
+
+@dataclass(frozen=True)
+class _Host:
+    goos: str
+    goarch: str
+    windows: bool
