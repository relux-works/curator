+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import os
+import stat
+import sys
+from pathlib import Path
+
+import pytest
+
+from csk.builds import toolchain
+
+
+_TUNING_VALUES = {
+    "GO386": "sse2",
+    "GOAMD64": "v1",
+    "GOARM": "7",
+    "GOARM64": "v8.0",
+    "GOMIPS": "hardfloat",
+    "GOMIPS64": "hardfloat",
+    "GOPPC64": "power8",
+    "GORISCV64": "rva20u64",
+    "GOWASM": "satconv,signext",
+}
