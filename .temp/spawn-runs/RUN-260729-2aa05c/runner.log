+        empty_path=root / "empty-path",
+        gopath=root / "gopath",
+        gomodcache=root / "gomodcache",
+        gocache=root / "gocache",
+        gotmp=root / "gotmp",
+        home=home,
+        config=config,
+        tmp=root / "tmp",
+        appdata=appdata,
+        localappdata=root / "localappdata",
+        userprofile=root / "userprofile",
+    )
+    directories = {
+        layout.empty,
+        layout.empty_path,
+        layout.gopath,
+        layout.gomodcache,
+        layout.gocache,
+        layout.gotmp,
+        layout.home,
+        layout.config,
+        layout.tmp,
