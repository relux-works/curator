+def _platform_go_name(host: _Host) -> str:
+    return "go.exe" if host.windows else "go"
+
+
+def _path_name_matches(actual: str, expected: str, host: _Host) -> bool:
+    if host.windows:
+        return actual.casefold() == expected.casefold()
+    return actual == expected
