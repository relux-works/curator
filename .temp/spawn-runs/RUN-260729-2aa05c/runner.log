+    algorithm: str
+    content_sha256: str
+    go_relpath: str
+    go_version: str
+
+
+@dataclass(frozen=True)
+class ToolchainSnapshot:
+    """Frozen package-independent values consumed by later build stages."""
+
+    executable: Path
+    goroot: Path
+    target: NativeTarget
+    toolchain: ToolchainIdentity
