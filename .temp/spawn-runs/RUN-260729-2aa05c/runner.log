+        "x86_64": "amd64",
+        "amd64": "amd64",
+        "i386": "386",
+        "i486": "386",
+        "i586": "386",
+        "i686": "386",
+        "x86": "386",
+        "aarch64": "arm64",
+        "arm64": "arm64",
+        "armv6l": "arm",
+        "armv7l": "arm",
+        "ppc64": "ppc64",
+        "ppc64le": "ppc64le",
+        "riscv64": "riscv64",
+        "mips": "mips",
+        "mipsel": "mipsle",
+        "mips64": "mips64",
+        "mips64el": "mips64le",
+    }
