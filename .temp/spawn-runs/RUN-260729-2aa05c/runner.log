+        b"[]",
+        b"{",
+    ]
+    for payload in cases:
+        runner.env_payload = payload
+        with pytest.raises(toolchain.ToolchainError) as raised:
+            toolchain.establish_toolchain(config)
+        _assert_code("invalid_go_env", raised)
