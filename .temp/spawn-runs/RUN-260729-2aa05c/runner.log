+@pytest.mark.parametrize("field", ["GOHOSTOS", "GOOS", "GOHOSTARCH", "GOARCH"])
+def test_host_target_and_version_must_be_identical(tmp_path: Path, field: str):
+    config, _, _, _ = _setup(
+        tmp_path,
+        environment_overrides={field: "mismatch"},
