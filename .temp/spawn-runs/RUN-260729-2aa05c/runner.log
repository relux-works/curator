+def test_go_env_requires_exact_unique_string_fields(tmp_path: Path):
+    config, runner, goroot, _ = _setup(tmp_path)
+    host = toolchain._native_host()
+    values = _probe_environment(
+        goroot,
+        {
+            "HOME": str(tmp_path / "unused-home"),
