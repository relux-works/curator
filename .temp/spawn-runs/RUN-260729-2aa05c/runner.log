+    )
+
+    assert identity == toolchain.ToolchainIdentity(
+        algorithm="curator-go-toolchain-v1",
+        content_sha256=expected,
+        go_relpath="bin/go",
+        go_version="go version go1.25.5 darwin/arm64",
+    )
