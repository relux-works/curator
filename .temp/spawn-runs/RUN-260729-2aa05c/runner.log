+class ToolchainError(RuntimeError):
+    """Stable failure at the package-independent Go trust boundary."""
+
+    def __init__(self, code: str, detail: str):
+        self.code = code
+        self.detail = detail
+        super().__init__(f"go-v1 {code}: {detail}")
