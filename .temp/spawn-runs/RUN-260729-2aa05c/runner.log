+    def __post_init__(self) -> None:
+        frozen = MappingProxyType(dict(self.tuning))
+        if len(frozen) != 1:
+            raise ValueError("a native Go target must carry exactly one tuning variable")
+        object.__setattr__(self, "tuning", frozen)
