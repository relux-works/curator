+    (root / "pkg").mkdir()
+    (root / "bin" / "go").write_bytes(b"GO")
+    (root / "pkg" / "tool-link").symlink_to("../bin/go")
+    expected = "sha256:baf7c5f3b9c3f1fae3da4c356381bf74442aa7f8f0b6fb2304c9c10833d6032e"
