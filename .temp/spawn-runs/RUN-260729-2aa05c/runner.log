+    "GOPPC64",
+    "GORISCV64",
+    "GOWASM",
+    "GOTELEMETRY",
+    "GOTELEMETRYDIR",
+)
+
+TUNING_VARIABLES: Final[Mapping[str, str]] = MappingProxyType(
+    {
+        "386": "GO386",
+        "amd64": "GOAMD64",
+        "arm": "GOARM",
+        "arm64": "GOARM64",
+        "mips": "GOMIPS",
+        "mipsle": "GOMIPS",
+        "mips64": "GOMIPS64",
+        "mips64le": "GOMIPS64",
+        "ppc64": "GOPPC64",
+        "ppc64le": "GOPPC64",
+        "riscv64": "GORISCV64",
+        "wasm": "GOWASM",
