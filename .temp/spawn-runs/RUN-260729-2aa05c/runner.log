+
+@dataclass(frozen=True)
+class _ProbeLayout:
+    root: Path
+    empty: Path
+    empty_path: Path
+    gopath: Path
+    gomodcache: Path
+    gocache: Path
+    gotmp: Path
+    home: Path
+    config: Path
+    tmp: Path
