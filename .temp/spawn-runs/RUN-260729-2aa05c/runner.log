+        root.resolve(),
+        b"go version go1.25.5 darwin/arm64\n",
+    )
+    executable.chmod(0o555)
+    os.utime(executable, (1_893_456_000, 1_893_456_000))
+    crlf = toolchain.fingerprint_toolchain(
+        root.resolve(),
+        b"go version go1.25.5 darwin/arm64\r\n",
