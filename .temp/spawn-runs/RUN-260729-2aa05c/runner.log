+def test_shared_toolchain_vector_is_byte_exact_and_input_order_independent(
+    tmp_path: Path,
+):
+    root = tmp_path / "goroot"
+    (root / "bin").mkdir(parents=True)
+    (root / "pkg").mkdir()
