+func validModuleRootSkillManifest() map[string]any {
+	return map[string]any{
+		"schema_version": 8,
+		"capabilities":   map[string]any{},
+		"build_roots":    []any{"tools/cli"},
+		"commands": map[string]any{
+			"tool": map[string]any{
+				"type": "build", "driver": "go-v1", "source_dir": "tools/cli/cmd/tool",
