   712			removals = appendRemovalCandidate(removals, index, target.StagedPath, target.DesiredDigest)
   713			removals = appendRemovalCandidate(removals, index, target.BackupPath, target.BackupDigest)
   714			removals = appendRemovalCandidate(removals, index, target.RollbackPath, target.DesiredDigest)
