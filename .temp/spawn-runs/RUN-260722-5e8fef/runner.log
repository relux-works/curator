+			if err := mustEngine(t, home).Recover(lock); err != nil {
+				t.Fatal(err)
+			}
+			if got, err := DigestPath(live); err != nil || got != preimage {
+				t.Fatalf("write-ahead recovery changed live target: digest %q, error %v; want %q", got, err, preimage)
