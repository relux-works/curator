+			}
+			if info.Size() != wantOwned {
+				t.Fatalf("durable staged size = %d, want %d", info.Size(), wantOwned)
+			}
+
+			manager, err := managerlock.New(home)
+			if err != nil {
+				t.Fatal(err)
+			}
