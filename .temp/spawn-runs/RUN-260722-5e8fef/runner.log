+func TestSubprocessCrashRecoveryAfterStagingChunkSync(t *testing.T) {
+	for _, ordinal := range []int{1, 2} {
+		t.Run(strconv.Itoa(ordinal), func(t *testing.T) {
+			root := t.TempDir()
