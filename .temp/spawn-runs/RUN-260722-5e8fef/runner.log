+			}
+			journal := crashDuringPreparationAt(t, home, live, source, "txn-prepare-write-ahead", PointAfterStagingChunkSync, ordinal)
+			target := journal.Targets[0]
+			wantAcknowledged := int64(ordinal-1) * stagingCopyChunkSize
