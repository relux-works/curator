+#!/usr/bin/env python3
+"""Verify a Git commit against Curator's accepted composite manifest format."""
+
+from __future__ import annotations
+
+import hashlib
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+
+MANIFEST_LINE = re.compile(
+    r"^(file|symlink|dir)\s+([0-9a-f]{64})  (.*)$"
+)
+DIRECTORY_PATH = re.compile(r"^(.*) \((\d+) inner\)$")
+
+
+def git(repo: Path, *args: str) -> bytes:
+    return subprocess.run(
+        ["git", *args],
+        cwd=repo,
+        check=True,
+        stdout=subprocess.PIPE,
+    ).stdout
+
+
+def sha256(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def directory_identity(path: Path) -> tuple[str, int]:
+    inner: list[str] = []
+    for root, dirs, files in os.walk(path):
+        dirs.sort()
+        for name in sorted(files):
+            file_path = Path(root) / name
+            relative = os.path.relpath(file_path, path)
+            if file_path.is_symlink():
+                identity = os.readlink(file_path)
+            else:
+                identity = sha256(file_path.read_bytes())
+            inner.append(f"{relative} {identity}")
+    return sha256("\n".join(inner).encode()), len(inner)
+
+
+def load_manifest(path: Path) -> tuple[list[str], dict[str, tuple[str, str, int | None]]]:
+    order: list[str] = []
+    entries: dict[str, tuple[str, str, int | None]] = {}
+    for number, line in enumerate(path.read_text().splitlines(), start=1):
+        match = MANIFEST_LINE.fullmatch(line)
+        if not match:
+            raise ValueError(f"invalid manifest line {number}: {line!r}")
+        kind, digest, raw_path = match.groups()
+        inner_count: int | None = None
+        entry_path = raw_path
+        if kind == "dir":
+            directory_match = DIRECTORY_PATH.fullmatch(raw_path)
+            if not directory_match:
+                raise ValueError(f"invalid directory manifest line {number}: {line!r}")
+            entry_path, count = directory_match.groups()
+            inner_count = int(count)
+        if entry_path in entries:
+            raise ValueError(f"duplicate manifest path: {entry_path}")
+        order.append(entry_path)
+        entries[entry_path] = (kind, digest, inner_count)
+    return order, entries
+
+
+def load_commit(
+    repo: Path, commit: str
+) -> tuple[dict[str, tuple[str, str, int | None]], dict[str, str]]:
+    entries: dict[str, tuple[str, str, int | None]] = {}
+    gitlinks: dict[str, str] = {}
+    records = git(repo, "ls-tree", "-rz", "--full-tree", commit).split(b"\0")
+    for record in records:
+        if not record:
+            continue
+        metadata, raw_path = record.split(b"\t", 1)
+        mode, object_type, oid = metadata.decode().split()
+        entry_path = raw_path.decode()
+        if mode == "160000" and object_type == "commit":
+            digest, inner_count = directory_identity(repo / entry_path)
+            entries[entry_path] = ("dir", digest, inner_count)
+            gitlinks[entry_path] = oid
+            continue
+        if object_type != "blob":
+            raise ValueError(
+                f"unsupported tree entry {mode} {object_type} {oid} {entry_path}"
+            )
+        content = git(repo, "cat-file", "blob", oid)
+        kind = "symlink" if mode == "120000" else "file"
+        entries[entry_path] = (kind, sha256(content), None)
+    return entries, gitlinks
+
+
+def main() -> int:
+    if len(sys.argv) != 4:
+        print("usage: verify.py REPO COMMIT MANIFEST", file=sys.stderr)
+        return 2
+
+    repo = Path(sys.argv[1]).resolve()
+    commit = sys.argv[2]
+    manifest = Path(sys.argv[3]).resolve()
+    expected_order, expected = load_manifest(manifest)
+    actual, gitlinks = load_commit(repo, commit)
+
+    failures: list[str] = []
+    if expected_order != sorted(expected_order):
+        failures.append("accepted manifest is not path-sorted")
+    if set(expected) != set(actual):
+        missing = sorted(set(expected) - set(actual))
+        extra = sorted(set(actual) - set(expected))
+        failures.append(f"path-set mismatch: missing={missing} extra={extra}")
+    for entry_path in sorted(set(expected) & set(actual)):
+        if expected[entry_path] != actual[entry_path]:
+            failures.append(
+                f"identity mismatch: {entry_path}: "
+                f"expected={expected[entry_path]} actual={actual[entry_path]}"
+            )
+
+    print(f"manifest_entries={len(expected)}")
+    print(f"commit_tree_entries={len(actual)}")
+    print(f"gitlink_entries={len(gitlinks)}")
+    for entry_path, oid in sorted(gitlinks.items()):
+        _, digest, inner_count = actual[entry_path]
+        print(
+            f"gitlink={entry_path} oid={oid} "
+            f"materialized_sha256={digest} inner={inner_count}"
+        )
+    print(f"mismatches={len(failures)}")
+    for failure in failures:
+        print(f"FAIL: {failure}", file=sys.stderr)
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

