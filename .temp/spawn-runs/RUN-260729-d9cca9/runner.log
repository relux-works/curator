from pathlib import Path
import sys


OVERLAY_PATHS = {
    ".github/ci/candidate-suite.sh",
    ".github/ci/excluded-packages.sh",
    ".github/ci/gate-selftest.sh",
    ".github/ci/ledger-consistency.sh",
