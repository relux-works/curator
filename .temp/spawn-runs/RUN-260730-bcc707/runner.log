+        if Path(path) == lock.path:
+            opened_flags.append(flags)
+        if synthetic_flag:
+            flags &= ~binary_flag
+        return real_open(path, flags, mode)
+
+    monkeypatch.setattr(locking.os, "open", capture_open)
+
+    with lock:
+        lock.assert_held()
+
+    assert opened_flags
+    assert all(flags & binary_flag for flags in opened_flags)
+
