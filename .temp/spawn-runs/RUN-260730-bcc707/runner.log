+        flags: int,
+        mode: int = 0o777,
+    ) -> int:
+        if Path(path) == lock.path:
+            opened_flags.append(flags)
+        if synthetic_flag:
+            flags &= ~binary_flag
+        return real_open(path, flags, mode)
+
+    monkeypatch.setattr(locking.os, "open", capture_open)
+
+    with lock:
+        lock.assert_held()
+
+    assert opened_flags
