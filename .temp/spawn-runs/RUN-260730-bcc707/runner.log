+    real_open = os.open
+    binary_flag = getattr(os, "O_BINARY", 0)
+    synthetic_flag = binary_flag == 0
+    if synthetic_flag:
+        binary_flag = 1 << 29
+        monkeypatch.setattr(locking.os, "O_BINARY", binary_flag, raising=False)
