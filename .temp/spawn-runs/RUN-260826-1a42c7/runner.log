commit 30842ef9ab1ba311b2558c0ee146f34288415b0c
Author: Ivan Oparin <oparin@me.com>
Date:   Fri Jul 31 14:28:48 2026 +0400

    Make the unowned Windows lane packages pass on windows-latest
    
    Five packages fail `Test (windows-latest)` and appear in no other board
    item. Each one is a distinct Windows behaviour or a Unix-shaped expectation,
    so each is addressed where it actually belongs rather than skipped.
    
    internal/buildcache: `ensureProtectedBase` created a cache directory and
    then applied its protected DACL, leaving a window in which the directory is
    observable with entries inherited from its parent. A second publisher that
    opened it there refused the whole publication as untrusted provenance --
    correctly, for state this manager had just created itself. The directory is
    now created with the owner-only protected descriptor already attached, which
    gives Windows the property mkdir's mode argument gives Unix.
    
    internal/identity: a Windows checkout is declared by its native path, and
    `C:\...` left Parse through the scp fallback, which saw the drive colon and
    rejected an ordinary local source as a malformed network remote. The
    drive-letter carve-out already existed for the `C:/...` spelling through the
    single-letter-host rule; it now covers both. This hunk is byte-identical to
    the one in BUG-260731-27h1yc, whose install cases share the root cause and
    which carries the unit coverage for it, so the two branches merge cleanly.
    
    internal/managerlock, internal/staging, internal/globalbins: three portable
    cases asserted Unix semantics rather than the behaviour they exist to cover
    -- an identity spelled without Windows case folding, POSIX path literals that
    are neither absolute nor clean on Windows, and a runtime profile pinned to
    "unix" on a host with no POSIX execute bit. Each now states the same property
    through the host's own rules; no case is skipped or excluded.
    
    cmd/curator: TestHostGoToolchainIsSelectableOnAnInventoryPlatform names the
    precondition seven compiled-command cases share and none state, so a host
    whose GOROOT the go-v1 boundary rejects is diagnosed once instead of seven
    times in cases that are about status reporting.

diff --git a/internal/managerlock/managerlock_test.go b/internal/managerlock/managerlock_test.go
index 7e82f06..2bffe50 100644
--- a/internal/managerlock/managerlock_test.go
+++ b/internal/managerlock/managerlock_test.go
@@ -117,6 +117,30 @@ func TestLockIdentitiesAreDeterministicAndManagerLocal(t *testing.T) {
 	}
 }
 
+// identityBelow spells the identity this platform assigns to a missing home
+// under an already-resolved existing prefix.
+//
+// The suffix rule is not the same everywhere and must not be assumed here. On
+// unix the identity is the path itself. On Windows a component whose containing
+// directory performs case-insensitive lookup is folded into the identity, so the
+// on-disk spelling is not the identity; identity_windows.go implements that rule
+// and identity_windows_test.go asserts it directly. Spelling the expectation
+// through the same rule keeps these portable cases about what they are for --
+// which existing prefix was resolved, and whether the identity survives creation
+// -- instead of re-asserting one platform's spelling on every host.
+func identityBelow(t *testing.T, existing string, missing ...string) string {
+	t.Helper()
+	reversed := make([]string, 0, len(missing))
+	for index := len(missing) - 1; index >= 0; index-- {
+		reversed = append(reversed, missing[index])
+	}
+	identity, err := canonicalWithExistingPrefix(filepath.Clean(existing), reversed, "expected manager home")
+	if err != nil {
+		t.Fatalf("spell the expected identity below %q: %v", existing, err)
+	}
+	return identity
+}
+
 func TestMissingHomeUsesCanonicalExistingPrefix(t *testing.T) {
 	base := t.TempDir()
 	home := filepath.Join(base, "missing", "curator-home")
@@ -129,7 +153,7 @@ func TestMissingHomeUsesCanonicalExistingPrefix(t *testing.T) {
 	if err != nil {
 		t.Fatal(err)
 	}
-	want := filepath.Join(resolvedBase, "missing", "curator-home")
+	want := identityBelow(t, resolvedBase, "missing", "curator-home")
 	if before.Home() != want {
 		t.Fatalf("missing home identity = %q, want canonical prefix identity %q", before.Home(), want)
 	}
@@ -143,6 +167,16 @@ func TestMissingHomeUsesCanonicalExistingPrefix(t *testing.T) {
 	if after.Home() != before.Home() {
 		t.Fatalf("home identity changed after creation: before %q, after %q", before.Home(), after.Home())
 	}
+	// The identity of the created home must also be the identity of the same
+	// physical directory named without the alias the temporary root may carry,
+	// which is the property the canonical existing prefix exists to give.
+	resolved, err := New(filepath.Join(resolvedBase, "missing", "curator-home"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if resolved.Home() != after.Home() {
+		t.Fatalf("resolved twin identity = %q, want %q", resolved.Home(), after.Home())
+	}
 }
 
 func TestMissingHomeBelowSymlinkKeepsIdentityAndContends(t *testing.T) {
@@ -165,7 +199,7 @@ func TestMissingHomeBelowSymlinkKeepsIdentityAndContends(t *testing.T) {
 	if err != nil {
 		t.Fatal(err)
 	}
-	wantHome := filepath.Join(resolvedRealParent, "missing", "curator-home")
+	wantHome := identityBelow(t, resolvedRealParent, "missing", "curator-home")
 	if before.Home() != wantHome {
 		t.Fatalf("missing aliased home identity = %q, want %q", before.Home(), wantHome)
 	}
