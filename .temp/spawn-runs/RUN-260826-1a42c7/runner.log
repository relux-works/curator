   233	// AssertHeld verifies that the operating-system lock has not been released.
   234	func (lock *HomeLock) AssertHeld() error {
   235		if lock == nil {
   236			return ErrNotHeld
   237		}
   238		return lock.lock.AssertHeld()
   239	}
   240	
   241	// Close releases the operating-system lock without deleting its stable file.
   242	func (lock *HomeLock) Close() error {
   243		if lock == nil {
   244			return nil
   245		}
   246		return lock.lock.Close()
   247	}
   248	
   249	// AcquireHome acquires the mutation lock after project locks and after an
   250	// optional build-key lock has been released.
   251	func (operation *Operation) AcquireHome(ctx context.Context) (*HomeLock, error) {
   252		if operation == nil || operation.manager == nil {
   253			return nil, fmt.Errorf("manager operation is nil")
   254		}
   255		if operation.dryRun {
   256			return nil, ErrDryRun
   257		}
   258		operation.mu.Lock()
   259		defer operation.mu.Unlock()
   260		if operation.closed || len(operation.projects) == 0 || operation.buildKey != nil || operation.home != nil {
   261			return nil, orderError("home lock requires held project locks and no held build-key lock")
   262		}
   263		return operation.acquireHome(ctx)
   264	}
   265	
   266	func (operation *Operation) acquireHome(ctx context.Context) (*HomeLock, error) {
   267		process := operation.manager.processState()
   268		if err := process.reserve(acquireHome); err != nil {
   269			return nil, err
   270		}
   271		acquired := false
   272		defer func() { process.finish(acquireHome, acquired) }()
   273		fileLock, err := acquireFileLock(ctx, operation.manager.homeLockPath(), func() {
   274			process.released(acquireHome)
   275		})
   276		if err != nil {
   277			return nil, err
   278		}
   279		acquired = true
   280		operation.home = &HomeLock{lock: fileLock}
   281		return operation.home, nil
   282	}
