+	if token == nil {
+		return false, nil
+	}
+	defer token.Close()
+
+	current := true
+	err = token.Use(func(token *buildsource.Token) error {
+		identity := token.Identity()
+		if identity != *recorded.BuildSource {
+			current = false
+			return nil
+		}
+		commands := make([]string, 0, len(recorded.Builds))
+		for command := range recorded.Builds {
