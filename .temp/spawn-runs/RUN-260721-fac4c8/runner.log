+		t.Fatalf("unexpected v2 wire state: %s", payload)
+	}
+	if _, present := raw["build_source"]; present {
+		t.Fatal("empty builds must omit build_source")
+	}
+	if Read(dir) == nil {
+		t.Fatal("writer produced an unreadable marker")
