+func TestReadLegacyV1AndRewriteAsV2WithoutChangingContentHash(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "SKILL.md"), []byte("legacy"), 0o644); err != nil {
+		t.Fatal(err)
