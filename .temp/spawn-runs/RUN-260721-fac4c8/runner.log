+		"commands": marker.Commands, "dependencies": marker.Dependencies,
+		"skill_schema_version": marker.SkillSchemaVersion, "runtime_roots": marker.RuntimeRoots,
+		"installed_at": marker.InstalledAt, "files": marker.Files,
