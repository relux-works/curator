+	}
+	if err := os.WriteFile(filepath.Join(raw, "SKILL.md"), []byte("raw"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(raw, Name), []byte("package marker bytes"), 0o644); err != nil {
+		t.Fatal(err)
+	}
