+func compiledFixture(t *testing.T) compiledFixtureState {
+	t.Helper()
+	installed := t.TempDir()
+	if err := os.WriteFile(filepath.Join(installed, "SKILL.md"), []byte("context"), 0o644); err != nil {
+		t.Fatal(err)
