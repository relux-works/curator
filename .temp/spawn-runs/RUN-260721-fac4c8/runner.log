+		Toolchain: buildmeta.Toolchain{Algorithm: buildmeta.ToolchainAlgorithm, GoRelpath: buildmeta.ToolchainGoRelpath, GoVersion: "go version go1.25.5 darwin/arm64", ContentSHA256: "sha256:" + strings.Repeat("c", 64)},
