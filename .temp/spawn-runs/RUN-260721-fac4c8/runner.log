+			if path == root || len(path) > len(root) && path[:len(root)] == root && path[len(root)] == '/' {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func containsString(values []string, want string) bool {
+	index := sort.SearchStrings(values, want)
+	return index < len(values) && values[index] == want
