+	legacy.SkillSchemaVersion = 5
+	legacy.ContentSHA256 = contentHash
+	legacy.BuildRoots = nil
+	legacy.Builds = nil
+	payload, err := marshalLegacy(legacy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, Name), payload, 0o644); err != nil {
+		t.Fatal(err)
