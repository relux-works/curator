+	}
+	artifact := buildmeta.Artifact{Path: "bin/tool", SHA256: "sha256:" + strings.Repeat("d", 64), Size: 7}
+	receipt, err := buildmeta.NewReceipt(input, artifact)
+	if err != nil {
+		t.Fatal(err)
+	}
+	receiptBytes, err := receipt.CanonicalBytes()
+	if err != nil {
+		t.Fatal(err)
+	}
