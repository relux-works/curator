+		},
+		"wrong toolchain": func(state *compiledState) {
+			state.options.Inputs["tool"] = mutateInput(state.options.Inputs["tool"], func(input *buildmeta.Input) { input.Toolchain.GoVersion = "go version go1.25.6 darwin/arm64" })
