+func onlyFields(raw map[string]json.RawMessage, allowed []string) bool {
+	fields := make(map[string]bool, len(allowed))
+	for _, field := range allowed {
+		fields[field] = true
+	}
+	for field := range raw {
+		if !fields[field] {
+			return false
+		}
+	}
+	return true
+}
