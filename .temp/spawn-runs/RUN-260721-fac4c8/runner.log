+func normalizedStrings(values []string) []string {
+	result := append([]string(nil), values...)
+	if result == nil {
+		result = []string{}
+	}
+	sort.Strings(result)
+	return result
+}
+
+func normalizedBuilds(values map[string]Build) map[string]Build {
+	if values == nil {
