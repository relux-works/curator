+			}
+			key, keyErr := input.CacheKey()
+			artifactPath, pathErr := buildmeta.ArtifactPath(command, input.Target.GOOS)
+			if keyErr != nil || pathErr != nil || key != build.CacheKey || artifactPath != build.ArtifactPath {
