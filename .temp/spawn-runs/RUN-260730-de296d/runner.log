   236	            try:
   237	                while True:
   238	                    chunk = stream.read(16 * 1024)
   239	                    if not chunk:
   240	                        return
   241	                    with budget_lock:
   242	                        accepted = min(len(chunk), remaining)
   243	                        destination.extend(chunk[:accepted])
   244	                        remaining -= accepted
   245	                        if accepted != len(chunk):
   246	                            output_exceeded.set()
