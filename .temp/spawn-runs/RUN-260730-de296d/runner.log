   154	    if len(payload["source_identity"]) > 4096 or not is_canonical_source_identity(payload["source_identity"]):
   155	        raise RegistryError("audit record source_identity is not canonical")
   156	    if re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", payload["commit"]) is None:
   157	        raise RegistryError("audit record commit must be a full lowercase object id")
   158	    if re.fullmatch(r"sha256:[0-9a-f]{64}", payload["content_sha256"]) is None:
   159	        raise RegistryError("audit record content_sha256 is malformed")
   160	    if payload["status"] not in _STATUSES:
   161	        raise RegistryError(f"audit record status {payload['status']!r} is not recognized")
   162	    audit = payload.get("audit", {})
   163	    if not isinstance(audit, dict):
   164	        raise RegistryError("audit record field 'audit' must be an object")
   165	    if not isinstance(payload.get("sig"), dict):
   166	        raise RegistryError("audit record requires a signature envelope")
