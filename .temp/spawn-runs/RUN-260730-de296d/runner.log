   439	def parse_install_marker(value: Any) -> InstallMarker:
   440	    """Parse one decoded marker schema 1 or 2 and canonicalize set ordering."""
   441	    body = _require_object(value, "marker")
   442	    schema_version = body.get("schema_version")
   443	    if (
   444	        not isinstance(schema_version, int)
   445	        or isinstance(schema_version, bool)
   446	        or schema_version not in SUPPORTED_INSTALL_MARKER_SCHEMA_VERSIONS
   447	    ):
   448	        raise InstallMarkerError(
   449	            "unsupported_install_marker_schema",
   450	            f"unsupported schema_version {schema_version!r}",
   451	        )
   452	    if schema_version == INSTALL_MARKER_V1_SCHEMA_VERSION:
   453	        _validate_object_shape(body, _COMMON_REQUIRED_MEMBERS, _V1_MEMBERS, "marker v1")
   454	        return InstallMarkerV1(
   455	            **_parse_common(body),
   456	            schema_version=INSTALL_MARKER_V1_SCHEMA_VERSION,
   457	        )
   458	
   459	    _validate_object_shape(body, _V2_REQUIRED_MEMBERS, _V2_MEMBERS, "marker v2")
   460	    return InstallMarkerV2(
   461	        **_parse_common(body),
   462	        build_roots=_parse_array(body["build_roots"], "build_roots"),
   463	        builds=_parse_builds(body["builds"]),
   464	        build_source=(
   465	            _parse_build_source(body["build_source"])
   466	            if "build_source" in body
   467	            else None
   468	        ),
   469	        schema_version=INSTALL_MARKER_V2_SCHEMA_VERSION,
   470	    )
   471	
