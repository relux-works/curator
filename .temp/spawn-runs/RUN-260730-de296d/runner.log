   192	def canonical_bytes(record: dict[str, Any]) -> bytes:
   193	    """Return Curator Canonical JSON 1 bytes for a signed object."""
   194	    body = {key: value for key, value in record.items() if key != "sig"}
   195	    try:
   196	        return protocol_json.canonical_bytes(body)
   197	    except protocol_json.ProtocolJSONError as exc:
   198	        raise RegistryError(str(exc)) from exc
   199	
   200	
   201	def _validate_ccj(value: Any) -> None:
   202	    try:
   203	        protocol_json.validate_canonical(value)
   204	    except protocol_json.ProtocolJSONError as exc:
   205	        raise RegistryError(str(exc)) from exc
