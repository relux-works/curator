   657	def _freeze_string_set(value: Any, subject: str) -> tuple[str, ...]:
   658	    if not isinstance(value, (list, tuple)):
   659	        raise InstallMarkerError(
   660	            "install_marker_invalid",
   661	            f"{subject} must be an array, got {type(value).__name__}",
   662	        )
   663	    if any(not isinstance(item, str) for item in value):
   664	        raise InstallMarkerError(
   665	            "install_marker_invalid",
   666	            f"{subject} must contain only strings",
   667	        )
   668	    if len(set(value)) != len(value):
   669	        raise InstallMarkerError(
   670	            "install_marker_invalid",
   671	            f"{subject} must not contain duplicates",
   672	        )
   673	    return tuple(sorted(value))
