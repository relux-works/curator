   208	def parse_public_key(value: str) -> bytes:
   209	    """Decode a pinned key of the form 'ed25519:<base64>' into 32 raw bytes."""
   210	    text = value.strip()
   211	    if text.startswith("ed25519:"):
   212	        text = text[len("ed25519:") :]
   213	    try:
   214	        raw = base64.b64decode(text, validate=True)
   215	    except (binascii.Error, ValueError) as exc:
   216	        raise RegistryError(f"invalid public key encoding: {value!r}") from exc
   217	    if len(raw) != 32:
   218	        raise RegistryError(f"ed25519 public key must be 32 bytes, got {len(raw)}")
   219	    if base64.b64encode(raw).decode("ascii") != text:
   220	        raise RegistryError("ed25519 public key must use canonical padded base64")
   221	    return raw
   222	
   223	
   224	def _signature_envelope(value: Any) -> tuple[str, bytes]:
   225	    if not isinstance(value, dict) or set(value) != {"algorithm", "key_id", "signature"}:
   226	        raise RegistryError("signature envelope has invalid fields")
   227	    key_id = value.get("key_id")
   228	    encoded = value.get("signature")
   229	    if value.get("algorithm") != "ed25519" or not isinstance(key_id, str) or not isinstance(encoded, str):
   230	        raise RegistryError("signature envelope is malformed")
   231	    if re.fullmatch(r"[0-9a-f]{16}", key_id) is None:
   232	        raise RegistryError("signature key_id must be 16 lowercase hexadecimal characters")
   233	    try:
   234	        signature = base64.b64decode(encoded, validate=True)
   235	    except (binascii.Error, ValueError) as exc:
   236	        raise RegistryError("signature is not canonical base64") from exc
   237	    if len(signature) != 64 or base64.b64encode(signature).decode("ascii") != encoded:
   238	        raise RegistryError("signature must be canonical padded base64 for 64 bytes")
   239	    return key_id, signature
   240	
   241	
   242	def verify_record(record: Record, pinned_keys: tuple[str, ...]) -> bool:
   243	    """Verify the record signature against any pinned key for its registry."""
   244	    sig = record.raw.get("sig")
   245	    if not isinstance(sig, dict):
   246	        return False
   247	    try:
   248	        key_id, signature = _signature_envelope(sig)
   249	    except RegistryError:
   250	        return False
   251	    try:
   252	        message = canonical_bytes(record.raw)
   253	    except RegistryError:
   254	        return False
   255	    for key in pinned_keys:
   256	        try:
   257	            public_key = parse_public_key(key)
   258	        except RegistryError:
   259	            continue
