   612	def _freeze_builds(value: Any) -> Mapping[str, InstallMarkerBuild]:
   613	    if not isinstance(value, Mapping):
   614	        raise InstallMarkerError(
   615	            "install_marker_invalid",
   616	            f"builds must be an object, got {type(value).__name__}",
   617	        )
   618	    result: dict[str, InstallMarkerBuild] = {}
   619	    for name, build in value.items():
   620	        _require_identifier(name, "build name")
   621	        if not isinstance(build, InstallMarkerBuild):
   622	            raise InstallMarkerError(
   623	                "install_marker_invalid",
   624	                f"builds.{name} must be an InstallMarkerBuild",
   625	            )
   626	        result[name] = build
   627	    return MappingProxyType(dict(sorted(result.items())))
