   229	        output_exceeded = threading.Event()
   230	        stop_requested = threading.Event()
   231	        reader_errors: list[BaseException] = []
   232	        remaining = output_limit
   233	
   234	        def drain(stream: BinaryIO, destination: bytearray) -> None:
