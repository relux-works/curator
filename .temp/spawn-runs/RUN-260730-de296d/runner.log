   427	def read_install_marker(raw: bytes | str) -> InstallMarker:
   428	    """Read marker JSON while rejecting duplicate keys and unsafe numbers."""
   429	    try:
   430	        value = protocol_json.loads_canonical(raw)
   431	    except protocol_json.ProtocolJSONError as exc:
   432	        raise InstallMarkerError(
   433	            "install_marker_invalid",
   434	            f"marker is not valid protocol JSON: {exc}",
   435	        ) from exc
   436	    return parse_install_marker(value)
