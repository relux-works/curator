   709	def _validate_object_shape(
   710	    body: dict[str, Any],
   711	    required: frozenset[str],
   712	    allowed: frozenset[str],
   713	    subject: str,
   714	) -> None:
   715	    missing = sorted(required - set(body))
   716	    if missing:
   717	        raise InstallMarkerError(
   718	            "install_marker_invalid",
   719	            f"{subject} is missing required member(s): {', '.join(missing)}",
   720	        )
   721	    unknown = sorted(set(body) - allowed)
   722	    if unknown:
   723	        raise InstallMarkerError(
   724	            "install_marker_invalid",
   725	            f"{subject} has unknown member(s): {', '.join(unknown)}",
   726	        )
   727	
   728	
   729	def _require_object(value: Any, subject: str) -> dict[str, Any]:
   730	    if not isinstance(value, dict):
   731	        raise InstallMarkerError(
   732	            "install_marker_invalid",
   733	            f"{subject} must be an object, got {type(value).__name__}",
   734	        )
   735	    if any(not isinstance(key, str) for key in value):
   736	        raise InstallMarkerError(
   737	            "install_marker_invalid",
   738	            f"{subject} object keys must be strings",
   739	        )
   740	    return value
   741	
   742	
   743	def _require_non_empty_string(value: Any, subject: str) -> None:
   744	    if not isinstance(value, str) or not value or len(value) > 8192:
   745	        raise InstallMarkerError(
   746	            "install_marker_invalid",
   747	            f"{subject} must be a non-empty string of at most 8192 characters",
   748	        )
   749	
   750	
   751	def _require_identifier(value: Any, subject: str) -> None:
   752	    if not isinstance(value, str) or not is_valid_identifier(value):
   753	        raise InstallMarkerError(
   754	            "install_marker_invalid",
   755	            f"{subject} is not a portable identifier: {value!r}",
   756	        )
   757	
   758	
   759	def _require_portable_path(value: Any, subject: str) -> None:
   760	    if not isinstance(value, str) or not is_valid_portable_path(value):
   761	        raise InstallMarkerError(
   762	            "install_marker_invalid",
   763	            f"{subject} is not a portable relative path: {value!r}",
   764	        )
   765	
   766	
   767	def _require_sha256(value: Any, subject: str) -> None:
   768	    if (
   769	        not isinstance(value, str)
   770	        or not value.startswith(_SHA256_PREFIX)
   771	        or len(value) != len(_SHA256_PREFIX) + 64
   772	        or not set(value[len(_SHA256_PREFIX) :]) <= _SHA256_DIGITS
   773	    ):
   774	        raise InstallMarkerError(
   775	            "install_marker_invalid",
   776	            f"{subject} must be 'sha256:' and 64 lowercase hexadecimal digits",
   777	        )
