   473	def marker_can_be_current(
   474	    marker: InstallMarker,
   475	    *,
   476	    skill_schema_version: int,
   477	) -> bool:
   478	    """Return schema-level currentness compatibility for a parsed marker."""
   479	    if (
   480	        not isinstance(skill_schema_version, int)
   481	        or isinstance(skill_schema_version, bool)
   482	        or marker.skill_schema_version != skill_schema_version
   483	    ):
   484	        return False
   485	    if isinstance(marker, InstallMarkerV1):
   486	        return 0 <= skill_schema_version <= 5
   487	    return 0 <= skill_schema_version <= 6
