   355	@dataclass(frozen=True, kw_only=True)
   356	class InstallMarkerV2(_InstallMarkerCommon):
   357	    """Marker schema 2 with local ``go-v1`` build references."""
   358	
   359	    build_roots: tuple[str, ...]
   360	    builds: Mapping[str, InstallMarkerBuild]
   361	    build_source: BuildSourceIdentity | None = None
   362	    schema_version: Literal[2] = INSTALL_MARKER_V2_SCHEMA_VERSION
   363	
   364	    def __post_init__(self) -> None:
   365	        if (
   366	            not isinstance(self.schema_version, int)
   367	            or isinstance(self.schema_version, bool)
   368	            or self.schema_version != INSTALL_MARKER_V2_SCHEMA_VERSION
   369	        ):
   370	            raise InstallMarkerError(
   371	                "unsupported_install_marker_schema",
   372	                f"marker v2 schema_version must be 2, got {self.schema_version!r}",
   373	            )
   374	        self._validate_common(maximum_skill_schema=6)
   375	        object.__setattr__(
   376	            self,
   377	            "build_roots",
   378	            _freeze_path_set(self.build_roots, "build_roots"),
   379	        )
   380	        object.__setattr__(self, "builds", _freeze_builds(self.builds))
   381	
   382	        has_builds = bool(self.builds)
   383	        if has_builds != (self.build_source is not None):
   384	            requirement = "present" if has_builds else "absent"
   385	            raise InstallMarkerError(
   386	                "install_marker_invalid",
   387	                f"build_source must be {requirement} exactly when builds is non-empty",
   388	            )
   389	        if self.build_source is not None:
   390	            _validate_build_source(self.build_source)
   391	        if has_builds:
   392	            if self.skill_schema_version != 6:
   393	                raise InstallMarkerError(
   394	                    "install_marker_invalid",
   395	                    "non-empty marker-v2 builds require skill_schema_version 6",
   396	                )
   397	            if not self.build_roots:
   398	                raise InstallMarkerError(
   399	                    "install_marker_invalid",
   400	                    "non-empty marker-v2 builds require at least one build root",
   401	                )
   402	            for name, build in self.builds.items():
   403	                if name not in self.commands:
   404	                    raise InstallMarkerError(
   405	                        "install_marker_invalid",
   406	                        f"build {name!r} is not present in commands",
   407	                    )
   408	                _validate_build_artifact_path(name, build.artifact_path)
   409	
   410	    def to_json(self) -> dict[str, Any]:
   411	        result = self._common_json(INSTALL_MARKER_V2_SCHEMA_VERSION)
   412	        result["build_roots"] = list(self.build_roots)
   413	        result["builds"] = {
   414	            name: build.to_json() for name, build in self.builds.items()
   415	        }
   416	        if self.build_source is not None:
   417	            result["build_source"] = {
   418	                "algorithm": self.build_source.algorithm,
   419	                "content_sha256": self.build_source.content_sha256,
   420	            }
   421	        return result
