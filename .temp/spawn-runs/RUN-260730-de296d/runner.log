   328	def parse_go_build_policy(value: Any) -> GoBuildPolicy:
   329	    """Read the fixed policy object and its required execution-policy identity."""
   330	    body = _require_object(value, "build policy", "build_input_invalid")
   331	    _reject_unknown_members(body, frozenset(GO_BUILD_POLICY_MEMBERS), "build policy", "build_input_invalid")
   332	    for member, expected in FIXED_GO_BUILD_POLICY.items():
   333	        if member not in body:
   334	            raise BuildMetadataError("build_input_invalid", f"build policy is missing required member {member!r}")
   335	        actual = body[member]
   336	        if actual != expected or isinstance(actual, bool) is not isinstance(expected, bool):
   337	            raise BuildMetadataError(
   338	                "build_input_invalid",
   339	                f"build policy {member!r} must be {expected!r}, got {actual!r}",
   340	            )
   341	    if "execution_policy" not in body:
   342	        raise BuildMetadataError(
   343	            "build_input_invalid",
   344	            "build policy is missing the required member 'execution_policy'",
   345	        )
   346	    execution_policy = body["execution_policy"]
   347	    _validate_execution_policy(execution_policy)
   348	    return GoBuildPolicy(execution_policy=execution_policy)
