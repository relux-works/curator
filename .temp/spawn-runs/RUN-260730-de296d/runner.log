   433	    def verify(self) -> None:
   434	        """Re-fingerprint the exact selected tree after the last child exits."""
   435	
   436	        _verify_selected_root(
   437	            self.goroot,
   438	            self._root_stat,
   439	            self.executable,
   440	            self._host,
   441	        )
   442	        deadline = _deadline(self._fingerprint_timeout)
