   685	def _validate_build_source(identity: Any) -> None:
   686	    if not isinstance(identity, BuildSourceIdentity):
   687	        raise InstallMarkerError(
   688	            "install_marker_invalid",
   689	            "build_source must be a BuildSourceIdentity",
   690	        )
   691	    if identity.algorithm != BUILD_SOURCE_ALGORITHM:
   692	        raise InstallMarkerError(
