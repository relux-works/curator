   255	            target=drain,
   256	            args=(stdout_pipe, stdout),
   257	            daemon=True,
   258	        )
   259	        stderr_thread = threading.Thread(
   260	            target=drain,
   261	            args=(stderr_pipe, stderr),
   262	            daemon=True,
   263	        )
   264	        stdout_thread.start()
   265	        stderr_thread.start()
   266	
   267	        timed_out = False
