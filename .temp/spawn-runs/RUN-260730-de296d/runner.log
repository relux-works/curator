   552	def _parse_builds(value: Any) -> Mapping[str, InstallMarkerBuild]:
   553	    body = _require_object(value, "builds")
   554	    result: dict[str, InstallMarkerBuild] = {}
   555	    for name, raw in body.items():
   556	        _require_identifier(name, "build name")
   557	        record = _require_object(raw, f"builds.{name}")
   558	        _validate_object_shape(
   559	            record,
   560	            _BUILD_RECORD_MEMBERS,
   561	            _BUILD_RECORD_MEMBERS,
   562	            f"builds.{name}",
   563	        )
   564	        result[name] = InstallMarkerBuild(
   565	            driver=record["driver"],
   566	            cache_key=record["cache_key"],
   567	            receipt_sha256=record["receipt_sha256"],
   568	            artifact_sha256=record["artifact_sha256"],
   569	            artifact_path=record["artifact_path"],
   570	        )
   571	    return result
