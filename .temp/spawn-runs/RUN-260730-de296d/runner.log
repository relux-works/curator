   500	        "commands": _parse_array(body["commands"], "commands"),
   501	        "dependencies": _parse_array(body["dependencies"], "dependencies"),
   502	        "skill_schema_version": body["skill_schema_version"],
   503	        "runtime_roots": _parse_array(body["runtime_roots"], "runtime_roots"),
   504	        "installed_at": body["installed_at"],
   505	        "files": _parse_array(body["files"], "files"),
   506	        "git": body.get("git"),
   507	        "requirements": (
