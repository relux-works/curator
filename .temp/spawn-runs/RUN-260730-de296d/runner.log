   372	def read_receipt(raw: bytes) -> BuildReceipt:
   373	    """Read stored receipt bytes, requiring exact CCJ-1 stored-byte equality."""
   374	    if not isinstance(raw, bytes):
   375	        raise BuildMetadataError("build_receipt_invalid", "stored receipt bytes must be bytes")
