   465	        if verify_error is not None:
   466	            if cleanup_error is not None:
   467	                verify_error.add_note(str(cleanup_error))
   468	            self._close_error = verify_error
   469	            raise verify_error
   470	        if cleanup_error is not None:
   471	            self._close_error = cleanup_error
   472	            raise cleanup_error
