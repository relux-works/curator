   699	def _validate_build_artifact_path(name: str, artifact_path: str) -> None:
   700	    unix_path = derived_artifact_path(name, goos="unix")
   701	    windows_path = derived_artifact_path(name, goos="windows")
   702	    if artifact_path not in {unix_path, windows_path}:
   703	        raise InstallMarkerError(
   704	            "install_marker_invalid",
   705	            f"build {name!r} artifact_path must be {unix_path!r} or {windows_path!r}",
   706	        )
