   298	def parse_build_input(value: Any) -> GoBuildInput:
   299	    """Read one logical build input, rejecting anything a manager cannot honor."""
   300	    body = _require_object(value, "build input", "build_input_invalid")
   301	    _reject_unknown_members(body, _BUILD_INPUT_MEMBERS, "build input", "build_input_invalid")
   302	    _require_members(body, _BUILD_INPUT_MEMBERS, "build input", "build_input_invalid")
   303	
   304	    driver = body["driver"]
   305	    if not isinstance(driver, str) or driver not in SUPPORTED_BUILD_DRIVERS:
   306	        raise BuildMetadataError("unsupported_build_driver", f"unsupported build driver {driver!r}")
   307	
   308	    schema_version = body["schema_version"]
   309	    if schema_version != BUILD_INPUT_SCHEMA_VERSION or isinstance(schema_version, bool):
   310	        raise BuildMetadataError(
   311	            "build_input_invalid",
   312	            f"build input schema_version must be {BUILD_INPUT_SCHEMA_VERSION}, got {schema_version!r}",
   313	        )
   314	
   315	    return GoBuildInput(
   316	        build_source=_parse_build_source_identity(body["build_source"]),
   317	        build_root=_require_text(body["build_root"], "build input build_root", "build_input_invalid"),
   318	        command=_require_text(body["command"], "build input command", "build_input_invalid"),
   319	        source_dir=_require_text(body["source_dir"], "build input source_dir", "build_input_invalid"),
   320	        target=_parse_native_target(body["target"]),
   321	        toolchain=_parse_toolchain_identity(body["toolchain"]),
   322	        policy=parse_go_build_policy(body["policy"]),
   323	        driver=driver,
   324	        schema_version=schema_version,
   325	    )
