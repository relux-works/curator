+func stagingPrefixDigest(reader io.Reader) (string, error) {
+	hash := sha256.New()
+	_, _ = hash.Write(stagingPrefixDigestDomain)
+	if _, err := io.Copy(hash, reader); err != nil {
+		return "", err
+	}
+	return "sha256:" + hex.EncodeToString(hash.Sum(nil)), nil
+}
