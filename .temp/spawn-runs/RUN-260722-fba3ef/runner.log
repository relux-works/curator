	helperHomeEnv   = "CURATOR_TRANSACTION_HELPER_HOME"
	helperPointEnv  = "CURATOR_TRANSACTION_HELPER_POINT"
	helperIDEnv     = "CURATOR_TRANSACTION_HELPER_ID"
