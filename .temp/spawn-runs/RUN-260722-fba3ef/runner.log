+func TestValidateJournalRejectsNoncanonicalStagingPrefixProgress(t *testing.T) {
+	root := t.TempDir()
+	live := filepath.Join(root, "live", "target")
+	source := filepath.Join(root, "stage", "target")
+	target := fileTarget(t, "class", "id", live, source, "old", "new")
