+	}
+	if size < 0 || size > int64(len(payload)) {
+		t.Fatalf("requested source prefix size %d outside payload size %d", size, len(payload))
+	}
+	file, err := os.OpenFile(destination, os.O_WRONLY|os.O_TRUNC, 0) // #nosec G304 -- test-owned transaction sidecar
+	if err != nil {
+		t.Fatal(err)
+	}
+	prefix := payload[:size]
+	if _, err := file.Write(prefix); err != nil {
+		_ = file.Close()
+		t.Fatal(err)
+	}
+	if err := file.Sync(); err != nil {
+		_ = file.Close()
+		t.Fatal(err)
+	}
+	if err := file.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := syncDirectory(filepath.Dir(destination)); err != nil {
+		t.Fatal(err)
+	}
+	return prefix
