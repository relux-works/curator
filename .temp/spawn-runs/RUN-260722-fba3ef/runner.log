+		{name: "absent digest", mutate: func(target *TargetRecord) { target.StagingPrefixDigest = DigestAbsent }},
+		{name: "invalid digest", mutate: func(target *TargetRecord) { target.StagingPrefixDigest = "sha256:no" }},
