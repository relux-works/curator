+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() {
+				if err := lock.Close(); err != nil {
+					t.Errorf("release recovery lock: %v", err)
+				}
+			})
+			err = mustEngine(t, home).Recover(lock)
+			if !errors.Is(err, ErrImplementationCorruption) {
