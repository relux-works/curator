+	_, pathErr := os.Lstat(path)
+	_, tombErr := os.Lstat(tomb)
+	pathExists := pathErr == nil
+	tombExists := tombErr == nil
+	if pathErr != nil && !os.IsNotExist(pathErr) {
+		return "", false, pathErr
+	}
