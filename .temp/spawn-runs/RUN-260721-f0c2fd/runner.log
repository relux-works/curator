+	home := filepath.Dir(filepath.Dir(filepath.Dir(engine.journalRoot)))
+	if err := mustEngine(t, home).Recover(testLock{}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(journalTomb); !os.IsNotExist(err) {
