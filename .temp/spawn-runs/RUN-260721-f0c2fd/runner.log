+	if err := writeDigestEntry(hash, 'f', "", mode.Perm(), uint64(len(payload))); err != nil {
+		return "", err
+	}
+	_, _ = hash.Write(payload)
+	return "sha256:" + hex.EncodeToString(hash.Sum(nil)), nil
+}
