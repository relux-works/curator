+		return "", false, tombErr
+	}
+	if pathExists && tombExists {
+		return "", false, corruptionf("transaction %s has both journal and cleanup tomb", transactionID)
+	}
+	if pathExists {
+		return path, false, nil
+	}
+	if tombExists {
+		return tomb, true, nil
+	}
+	return "", false, os.ErrNotExist
