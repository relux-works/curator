+func namespaceCaseInsensitive(path string) (bool, error) {
+	ancestor, err := existingNamespaceAncestor(path)
+	if err != nil {
+		return false, err
+	}
+	caseSensitive, err := unix.Pathconf(ancestor, pathconfCaseSensitive)
+	if err != nil {
+		return false, err
+	}
+	return caseSensitive == 0, nil
+}
