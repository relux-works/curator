+func existingNamespaceAncestor(path string) (string, error) {
+	current := filepath.Clean(path)
+	for {
+		if _, err := os.Lstat(current); err == nil {
+			return current, nil
+		} else if !os.IsNotExist(err) {
+			return "", err
+		}
+		parent := filepath.Dir(current)
+		if parent == current {
+			return "", fmt.Errorf("path has no existing ancestor: %s", path)
+		}
+		current = parent
+	}
+}
diff --git a/.temp/TASK-260720-31nl14/worktree/internal/transaction/namespace_case_darwin.go b/.temp/TASK-260720-31nl14/worktree/internal/transaction/namespace_case_darwin.go
new file mode 100644
index 0000000000000000000000000000000000000000..bd13732275a8afb4a96835c547aa827581522477
--- /dev/null
+++ b/.temp/TASK-260720-31nl14/worktree/internal/transaction/namespace_case_darwin.go
@@ -0,0 +1,19 @@
+//go:build darwin
+
+package transaction
+
+import "golang.org/x/sys/unix"
+
+const pathconfCaseSensitive = 11 // _PC_CASE_SENSITIVE from <sys/unistd.h>.
+
+func namespaceCaseInsensitive(path string) (bool, error) {
+	ancestor, err := existingNamespaceAncestor(path)
+	if err != nil {
+		return false, err
+	}
+	caseSensitive, err := unix.Pathconf(ancestor, pathconfCaseSensitive)
+	if err != nil {
+		return false, err
+	}
+	return caseSensitive == 0, nil
+}
