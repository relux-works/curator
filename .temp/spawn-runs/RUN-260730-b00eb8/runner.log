+    desired = _symlink(tmp_path / "staged" / "skill", "../new-store", directory=True)
+    target = _entry_target("60-adapter", "skill", live, desired)
+    engine = TransactionEngine(home)
+
+    with ManagerHomeLock(home) as lock:
+        engine.prepare(
