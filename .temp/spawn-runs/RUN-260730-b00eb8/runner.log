+                tmp_path / "project",
+                _entry_target("60-adapter", "skill", live, desired),
+            ),
+        )
+        with pytest.raises(SimulatedCrash, match="after_install"):
+            engine.commit(lock, "txn-entry-recovery")
+
+    with ManagerHomeLock(home) as lock:
