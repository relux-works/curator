+            _plan(
+                f"txn-removed-reappeared-{kind}-{content}",
+                tmp_path / "project",
+                _target("10-context", "skill", live, desired),
+            ),
+        )
+        with pytest.raises(SimulatedCrash, match="journal_tombed"):
+            engine.commit(lock, f"txn-removed-reappeared-{kind}-{content}")
+
