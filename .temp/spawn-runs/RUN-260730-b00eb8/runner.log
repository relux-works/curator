+
+    assert digest_path(reappeared) == before
+    assert journal_tomb.exists()
+    if kind == "file":
+        assert live.read_text(encoding="utf-8") == "new"
+    else:
+        assert (live / "payload").read_text(encoding="utf-8") == "new"

