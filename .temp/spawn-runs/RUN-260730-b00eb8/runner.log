+        del target
+        if point == "journal_tombed":
+            raise SimulatedCrash(point)
+
+    engine = TransactionEngine(home, fault_hook=crash_after_journal_tomb)
+    with ManagerHomeLock(home) as lock:
+        engine.prepare(
