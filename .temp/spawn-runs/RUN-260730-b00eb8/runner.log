+        "C:\\Sensitive",
+        ["Child", "Parent"],
+        case_sensitive=lookup,
+    )
+    physical = locking._canonicalize_windows_identity(
+        "C:\\Sensitive\\Parent\\Child",
+        [],
+        case_sensitive=lookup,
+    )
