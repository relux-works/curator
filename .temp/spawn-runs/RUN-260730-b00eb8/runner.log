+def test_windows_nested_missing_identity_is_recanonicalized_after_creation():
+    case_sensitive = {
+        "C:\\": False,
+        "C:\\Sensitive": True,
+        "C:\\Sensitive\\Parent": True,
+    }
+
+    def lookup(path: str) -> bool:
