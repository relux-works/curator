+def _canonical_target_path(
+    path: Path,
+    *,
+    kind: TargetKind,
+    strict: bool,
+) -> Path:
+    if kind not in {"bytes", "entry"}:
+        raise TransactionError(f"invalid transaction target kind: {kind}")
+    try:
+        absolute = Path(os.path.abspath(path.expanduser()))
+        if kind == "bytes":
