+            ),
+        )
+        engine.commit(lock, "txn-entry-alias")
+
+    assert mirror.is_symlink()
+    assert os.readlink(mirror) == "canonical"
+    assert (canonical / "payload").read_text(encoding="utf-8") == "new canonical"
+    assert not any(live_root.glob(".csk-txn-*"))
