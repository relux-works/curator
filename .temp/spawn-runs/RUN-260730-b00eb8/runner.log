+    target_class: str,
+    identifier: str,
+    live: Path,
+    desired: Path | None,
+) -> MutableTarget:
+    return MutableTarget(
+        target_class=target_class,
+        identifier=identifier,
+        live_path=live,
+        desired_path=desired,
+        expected_preimage_digest=transactions.digest_target(live, kind="entry"),
+        kind="entry",
+    )
