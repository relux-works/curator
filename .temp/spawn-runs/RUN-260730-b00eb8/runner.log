+    engine = TransactionEngine(home_b)
+
+    with ManagerHomeLock(home_a) as wrong_lock:
+        with pytest.raises(
+            TransactionError, match="manager-home.*identity|home.*witness"
+        ):
+            if operation == "prepare":
+                engine.prepare(
+                    wrong_lock,
