    26	// Load reads the skill spec of a snapshot directory. agent-skill.json is
    27	// canonical, csk-skill.json is a legacy read alias, and agents/runtime.json is
    28	// consulted only when neither modern filename exists (Spec §4).
    29	func Load(snapshot string) (*Spec, error) {
    30		canonicalPath := filepath.Join(snapshot, CanonicalManifestName)
    31		legacyPath := filepath.Join(snapshot, LegacyManifestName)
    32		canonicalExists, err := pathExists(canonicalPath)
    33		if err != nil {
    34			return nil, err
    35		}
    36		legacyExists, err := pathExists(legacyPath)
    37		if err != nil {
    38			return nil, err
    39		}
    40	
    41		if canonicalExists && legacyExists {
    42			canonical, canonicalData, err := loadSkillManifest(canonicalPath, CanonicalManifestName)
    43			if err != nil {
    44				return nil, err
    45			}
    46			_, legacyData, err := loadSkillManifest(legacyPath, LegacyManifestName)
    47			if err != nil {
    48				return nil, err
    49			}
    50			if !reflect.DeepEqual(canonicalData, legacyData) {
    51				return nil, verr.New("", "conflicting_skill_manifests: %s and %s contain different JSON values", CanonicalManifestName, LegacyManifestName)
    52			}
    53			return canonical, nil
    54		}
    55		if canonicalExists {
    56			spec, _, loadErr := loadSkillManifest(canonicalPath, CanonicalManifestName)
    57			return spec, loadErr
    58		}
    59		if legacyExists {
    60			spec, _, loadErr := loadSkillManifest(legacyPath, LegacyManifestName)
    61			return spec, loadErr
    62		}
    63		runtimePath := filepath.Join(snapshot, filepath.FromSlash(RuntimeFallbackName))
    64		runtimeExists, err := pathExists(runtimePath)
    65		if err != nil {
    66			return nil, err
    67		}
    68		if runtimeExists {
    69			return loadRuntimeFallback(runtimePath)
    70		}
    71		return &Spec{Commands: map[string]Command{}, Capabilities: capabilities.ImplicitNone()}, nil
    72	}
    73	
    74	// ManifestSourcePath returns the protocol path that Load will report for
    75	// diagnostics. It does not parse the selected file.
    76	func ManifestSourcePath(snapshot string) string {
    77		if exists, _ := pathExists(filepath.Join(snapshot, CanonicalManifestName)); exists {
    78			return CanonicalManifestName
    79		}
    80		if exists, _ := pathExists(filepath.Join(snapshot, LegacyManifestName)); exists {
    81			return LegacyManifestName
    82		}
    83		if exists, _ := pathExists(filepath.Join(snapshot, filepath.FromSlash(RuntimeFallbackName))); exists {
    84			return RuntimeFallbackName
    85		}
    86		return ""
    87	}
    88	
    89	func pathExists(path string) (bool, error) {
    90		_, err := os.Stat(path)
    91		if err == nil {
    92			return true, nil
    93		}
    94		if os.IsNotExist(err) {
    95			return false, nil
    96		}
    97		return false, err
    98	}
