   536	def _check_mcp_servers(
   537	    plans: list[SkillPlan], project_root: Path, agents: list[str], *, alias: str = ""
   538	) -> tuple[dict[str, dict[str, list[str]]], list[str]]:
   539	    """Verify declared MCP servers against the target agent environments.
   540	
   541	    Returns, per skill, the agents where each declared server was found, plus
   542	    warnings for servers that are configured but statically unlikely to run:
   543	    a stdio command missing from PATH, or a project-only declaration that the
   544	    agent holds pending until the checkout is trusted.
   545	    Raises InstallError when a requirement is not satisfied.
   546	    """
   547	    prefix = f"{alias}: " if alias else ""
   548	    found: dict[str, dict[str, list[str]]] = {}
   549	    errors: list[str] = []
   550	    warnings: list[str] = []
   551	    for plan in plans:
   552	        if not plan.spec.mcp_servers:
   553	            continue
   554	        per_skill: dict[str, list[str]] = {}
   555	        for requirement in plan.spec.mcp_servers.values():
   556	            resolution = mcp_configs.resolve_server(project_root, agents, requirement.name)
   557	            available = sorted(agent for agent, ok in resolution.items() if ok)
   558	            per_skill[requirement.name] = available
   559	            if requirement.required_in == "all":
   560	                missing = sorted(agent for agent, ok in resolution.items() if not ok)
   561	                if missing:
   562	                    errors.append(
   563	                        f"MCP server {requirement.name!r} required by {plan.decl.name} is not configured "
   564	                        f"for agent(s): {', '.join(missing)}. Hint: {requirement.hint}"
   565	                    )
   566	            elif not available:
   567	                errors.append(
   568	                    f"MCP server {requirement.name!r} required by {plan.decl.name} is not configured "
   569	                    f"in any target agent environment. Hint: {requirement.hint}"
   570	                )
   571	            for agent, command in sorted(
   572	                mcp_configs.missing_stdio_commands(project_root, available, requirement.name).items()
   573	            ):
   574	                warnings.append(
   575	                    f"{prefix}MCP server {requirement.name!r} for {agent} runs {command!r}, "
   576	                    "which is not on PATH"
   577	                )
   578	            trust_gated = sorted(
   579	                agent
   580	                for agent in available
   581	                if requirement.name in mcp_configs.project_only_servers(project_root, agent)
   582	            )
   583	            if trust_gated:
   584	                warnings.append(
   585	                    f"{prefix}MCP server {requirement.name!r} is declared only in project-level "
   586	                    f"config for {', '.join(trust_gated)}; agents keep project servers pending "
   587	                    "until the checkout is trusted"
   588	                )
   589	        found[plan.decl.name] = per_skill
   590	    if errors:
   591	        raise InstallError("; ".join(errors))
   592	    return found, warnings
