   583	// validateRelativePath enforces the relative path rules of Spec §5.4/§5.3.
   584	// strictPosix additionally rejects backslashes, doubled slashes, and "."
   585	// segments.
   586	func validateRelativePath(value, field string, strictPosix bool) (string, error) {
   587		if value == "" {
   588			return "", verr.New(field, "must be a non-empty string")
   589		}
   590		if !identifiers.PortablePath(value) {
   591			if strictPosix && (strings.Contains(value, `\`) || strings.Contains(value, "//")) {
   592				return "", verr.New(field, "must be a POSIX-style relative path inside the skill repository")
   593			}
   594			return "", verr.New(field, "must be a portable relative path inside the skill repository")
   595		}
   596		return value, nil
   597	}
   598	
   599	func pathContains(root, rel string) bool {
   600		rootParts := strings.Split(root, "/")
   601		relParts := strings.Split(rel, "/")
   602		if len(relParts) < len(rootParts) {
   603			return false
   604		}
   605		for i, part := range rootParts {
   606			if relParts[i] != part {
   607				return false
   608			}
   609		}
   610		return true
   611	}
