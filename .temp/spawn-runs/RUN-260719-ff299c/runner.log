   514	// parseRuntimeRoots validates runtime_roots per Spec §5.3: POSIX-relative,
   515	// existing directories, unique, pairwise disjoint.
   516	func parseRuntimeRoots(raw any, snapshot string) ([]string, error) {
   517		list, ok := raw.([]any)
   518		if !ok {
   519			return nil, verr.New("runtime_roots", "must be a list")
   520		}
   521		roots := make([]string, 0, len(list))
   522		for index, item := range list {
   523			field := fmt.Sprintf("runtime_roots[%d]", index)
   524			text, ok := item.(string)
   525			if !ok {
   526				return nil, verr.New(field, "must be a non-empty string")
   527			}
   528			root, err := validateRelativePath(text, field, true)
   529			if err != nil {
   530				return nil, err
   531			}
   532			info, statErr := os.Stat(filepath.Join(snapshot, filepath.FromSlash(root)))
   533			if statErr != nil {
   534				return nil, verr.New(field, "runtime root does not exist: %s", root)
   535			}
   536			if !info.IsDir() {
   537				return nil, verr.New(field, "runtime root must be a directory: %s", root)
   538			}
   539			roots = append(roots, root)
   540		}
   541		seen := map[string]bool{}
   542		for _, root := range roots {
   543			if seen[root] {
   544				return nil, verr.New("runtime_roots", "must be unique after normalization")
   545			}
   546			seen[root] = true
   547		}
   548		sorted := append([]string(nil), roots...)
   549		sort.Strings(sorted)
   550		for i, left := range sorted {
   551			for _, right := range sorted[i+1:] {
   552				if pathContains(left, right) || pathContains(right, left) {
   553					container, contained := left, right
   554					if pathContains(right, left) {
   555						container, contained = right, left
   556					}
   557					return nil, verr.New("runtime_roots", "must be disjoint: %s contains %s", container, contained)
   558				}
   559			}
   560		}
   561		return roots, nil
   562	}
