   346		if json.Unmarshal(payload, &object) != nil {
   347			return 0, false
   348		}
   349		var version int
   350		if json.Unmarshal(object["schema_version"], &version) != nil {
   351			return 0, false
   352		}
   353		return version, true
   354	}
