   227	func copyTree(src, dst string) error {
   228		return filepath.Walk(src, func(path string, info os.FileInfo, err error) error {
   229			if err != nil {
   230				return err
   231			}
   232			rel, err := filepath.Rel(src, path)
   233			if err != nil {
   234				return err
   235			}
   236			target := filepath.Join(dst, rel)
   237			if info.IsDir() {
   238				return os.MkdirAll(target, 0o755)
   239			}
   240			if !info.Mode().IsRegular() {
   241				return fmt.Errorf("unsupported file type in runtime root: %s", rel)
   242			}
   243			return copyFile(path, target)
   244		})
   245	}
   246	
   247	func copyFile(src, dst string) error {
   248		if err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {
   249			return err
   250		}
   251		payload, err := os.ReadFile(src) // #nosec G304 -- paths come from the walked snapshot
   252		if err != nil {
   253			return err
   254		}
   255		info, err := os.Stat(src)
   256		if err != nil {
   257			return err
   258		}
   259		return os.WriteFile(dst, payload, info.Mode().Perm())
   260	}
   261	
   262	func makeExecutable(path string) error {
   263		info, err := os.Stat(path)
   264		if err != nil {
   265			return err
   266		}
   267		return os.Chmod(path, info.Mode().Perm()|0o111)
   268	}

