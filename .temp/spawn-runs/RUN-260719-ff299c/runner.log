   356	// ReplaceDir atomically swaps newDir into target: back up, rename, roll back
   357	// on failure, drop the backup on success (Spec §8.5).
   358	func ReplaceDir(newDir, target string) error {
   359		if err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {
   360			return err
   361		}
   362		backup := filepath.Join(filepath.Dir(target), fmt.Sprintf(".%s.backup-%d", filepath.Base(target), os.Getpid()))
   363		if err := os.RemoveAll(backup); err != nil {
   364			return err
   365		}
   366		if _, err := os.Lstat(target); err == nil {
   367			if err := os.Rename(target, backup); err != nil {
   368				return err
   369			}
   370		}
   371		if err := os.Rename(newDir, target); err != nil {
   372			if _, statErr := os.Lstat(backup); statErr == nil {
   373				if _, targetErr := os.Lstat(target); targetErr != nil {
   374					_ = os.Rename(backup, target)
   375				}
   376			}
   377			return err
   378		}
   379		return os.RemoveAll(backup)
   380	}

