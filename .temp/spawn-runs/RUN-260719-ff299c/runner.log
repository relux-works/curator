   455	def _check_audit_registries(
   456	    plans: list[SkillPlan],
   457	    config: GlobalConfig,
   458	    result: ProjectResult,
   459	    *,
   460	    alias: str,
   461	) -> dict[str, dict[str, object]]:
   462	    """Resolve each skill against trusted audit registries (RFC 0008).
   463	
   464	    A verified revocation denies the install. An unknown artifact is advisory
   465	    at this stage. Returns the authorizing attestation per skill for the
   466	    marker.
   467	    """
   468	    registries = config.trusted_registries()
   469	    if not registries:
   470	        return {}
   471	    strict = config.audit.registry_policy == "strict"
   472	    cache_dir = config.path.parent / "cache" / "registry"
   473	    state_dir = config.path.parent / "state" / "registry"
   474	    try:
   475	        audit_registry.migrate_snapshot_states(cache_dir, state_dir)
   476	    except audit_registry.RegistryError as exc:
   477	        raise InstallError(f"audit registry rollback state migration failed: {exc}") from exc
   478	    unavailable, snapshot_warnings = audit_registry.check_snapshots(
   479	        registries,
   480	        state_dir,
   481	        fetch_snapshot=audit_registry.http_get_snapshot,
   482	        now=time.time(),
   483	        max_age_seconds=config.audit.snapshot_max_age_seconds,
   484	        clock_skew_seconds=config.audit.snapshot_clock_skew_seconds,
   485	    )
   486	    for warning in snapshot_warnings:
   487	        result.messages.append(f"{alias}: registry: {warning}")
   488	    registries = tuple(r for r in registries if r.url not in unavailable)
   489	    if not registries:
   490	        # Every trusted registry served a tampered snapshot; refuse to proceed.
   491	        raise InstallError("every trusted audit registry served a tampered snapshot")
   492	    fetch = audit_registry.make_http_fetch(
   493	        cache_dir,
   494	        ttl_seconds=config.audit.cache_ttl_seconds,
   495	        grace_seconds=config.audit.offline_grace_seconds,
   496	    )
   497	    attestations: dict[str, dict[str, object]] = {}
   498	    errors: list[str] = []
   499	    for plan in plans:
   500	        identity = source_identity_mod.canonical_source_identity(plan.decl.git) if plan.decl.git else None
   501	        if identity is None:
   502	            continue
   503	        content_hash = hashing.content_sha256(plan.snapshot)
   504	        resolution = audit_registry.resolve(
   505	            registries,
   506	            source_identity=identity,
   507	            commit=plan.resolved.commit,
   508	            content_sha256=content_hash,
   509	            fetch=fetch,
   510	        )
   511	        for warning in resolution.warnings:
   512	            result.messages.append(f"{alias}: registry: {warning}")
   513	        if resolution.result == audit_registry.RESULT_REVOKED:
   514	            registry = resolution.attestation.registry if resolution.attestation else "a trusted registry"
   515	            errors.append(f"{plan.decl.name} is revoked by {registry}")
   516	            continue
   517	        if resolution.result == audit_registry.RESULT_DEPRECATED:
   518	            result.messages.append(f"{alias}: registry: {plan.decl.name} is marked deprecated")
   519	        if strict and resolution.result == audit_registry.RESULT_UNKNOWN:
   520	            errors.append(
   521	                f"{plan.decl.name} is not audited by any trusted registry (registry_policy is strict)"
   522	            )
   523	            continue
   524	        if resolution.attestation is not None:
   525	            att = resolution.attestation
   526	            attestations[plan.decl.name] = {
   527	                "registry": att.registry,
   528	                "status": att.status,
   529	                "key_id": att.key_id,
   530	            }
   531	    if errors:
   532	        raise InstallError("; ".join(errors))
   533	    return attestations
