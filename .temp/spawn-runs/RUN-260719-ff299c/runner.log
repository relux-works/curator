   429	def skill_command_dependency_errors(plan: SkillPlan, plans: list[SkillPlan]) -> list[str]:
   430	    by_skill = {candidate.decl.name: candidate for candidate in plans}
   431	    errors: list[str] = []
   432	    for dependency in plan.spec.dependencies.values():
   433	        if dependency.type != "skill":
   434	            continue
   435	        if not dependency.skill or not dependency.command:
   436	            errors.append(f"Invalid skill dependency for {plan.decl.name}: {dependency.name}")
   437	            continue
   438	        provider = by_skill.get(dependency.skill)
   439	        if provider is None:
   440	            hint = f" Hint: {dependency.hint}" if dependency.hint else ""
   441	            errors.append(
   442	                f"Missing skill dependency {dependency.skill!r} for {plan.decl.name}; "
   443	                f"add {dependency.skill} to Skillfile.json.{hint}"
   444	            )
   445	            continue
   446	        provided = provider.spec.commands.get(dependency.command)
   447	        if provided is None or provided.type != "script":
   448	            errors.append(
   449	                f"Skill dependency {plan.decl.name} requires {dependency.skill}.{dependency.command}, "
   450	                f"but {dependency.skill} does not export a script command named {dependency.command!r}"
   451	            )
   452	    return errors
