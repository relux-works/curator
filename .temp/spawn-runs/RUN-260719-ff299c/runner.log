   300	// unsupported marker schema is an error.
   301	func Current(installedDir string, expected *Marker) (bool, error) {
   302		if version, ok := markerSchemaVersion(installedDir); ok && version != SchemaVersion {
   303			return false, fmt.Errorf("unsupported installed marker schema in %s", filepath.Join(installedDir, Name))
   304		}
