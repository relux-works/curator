   139	
   140	
   141	def write_bin_shim(
   142	    bin_dir: Path,
   143	    command_name: str,
   144	    runtime_path: Path,
   145	    *,
   146	    platform_name: str | None = None,
   147	    path_entries: tuple[Path, ...] = (),
   148	) -> Path:
   149	    platform_name = platform_name or ("windows" if os.name == "nt" else "unix")
   150	    bin_dir.mkdir(parents=True, exist_ok=True)
   151	    if platform_name == "windows":
   152	        shim = bin_dir / f"{command_name}.cmd"
   153	        if path_entries:
   154	            prefix = ";".join(_escape_cmd_value(str(path)) for path in path_entries)
   155	            runtime_value = _escape_cmd_value(str(runtime_path))
   156	            shim.write_text(
   157	                "@echo off\r\n"
   158	                "setlocal DisableDelayedExpansion\r\n"
   159	                f'set "PATH={prefix};%PATH%"\r\n'
   160	                f'call "{runtime_value}" %*\r\n'
   161	                "exit /b %ERRORLEVEL%\r\n",
   162	                encoding="utf-8",
   163	            )
   164	        else:
   165	            shim.write_text(
   166	                "@echo off\r\n"
   167	                f"\"{runtime_path}\" %*\r\n",
   168	                encoding="utf-8",
   169	            )
   170	        return shim
   171	
   172	    shim = bin_dir / command_name
   173	    if shim.exists() or shim.is_symlink():
   174	        shim.unlink()
   175	    if path_entries:
   176	        prefix = ":".join(str(path) for path in path_entries)
   177	        shim.write_text(
   178	            "#!/bin/sh\n"
   179	            'if [ -n "${PATH:-}" ]; then\n'
   180	            f"  PATH={shlex.quote(prefix)}:\"$PATH\"\n"
   181	            "else\n"
   182	            f"  PATH={shlex.quote(prefix)}\n"
   183	            "fi\n"
   184	            "export PATH\n"
   185	            f"exec {shlex.quote(str(runtime_path))} \"$@\"\n",
   186	            encoding="utf-8",
   187	        )
   188	        shim.chmod(shim.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
   189	        return shim
   190	    target = os.path.relpath(runtime_path, shim.parent)
   191	    shim.symlink_to(target)
   192	    return shim
   193	
   194	
   195	def _escape_cmd_value(value: str) -> str:
   196	    return value.replace("%", "%%")
   197	
   198	
   199	def remove_stale_shims(project_root: Path, expected_commands: set[str], *, platform_name: str | None = None) -> None:
   200	    remove_stale_shims_in(project_root / ".agents" / "bin", expected_commands, platform_name=platform_name)
   201	
   202	
   203	def remove_stale_global_shims(csk_home: Path, expected_commands: set[str], *, platform_name: str | None = None) -> None:
   204	    remove_stale_shims_in(csk_home / "global" / "bin", expected_commands, platform_name=platform_name)
   205	
   206	
   207	def remove_stale_shims_in(bin_dir: Path, expected_commands: set[str], *, platform_name: str | None = None) -> None:
   208	    platform_name = platform_name or ("windows" if os.name == "nt" else "unix")
   209	    if not bin_dir.exists():
   210	        return
   211	    for child in bin_dir.iterdir():
   212	        if not child.is_file() and not child.is_symlink():
   213	            continue
   214	        command = child.stem if platform_name == "windows" and child.suffix.lower() == ".cmd" else child.name
   215	        if command not in expected_commands:
   216	            child.unlink()

