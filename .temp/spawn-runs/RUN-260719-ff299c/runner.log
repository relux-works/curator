   564	func validateScriptFile(snapshot, rel string, runtimeRoots []string, label string) error {
   565		info, err := os.Stat(filepath.Join(snapshot, filepath.FromSlash(rel)))
   566		if err != nil {
   567			return verr.New(label, "source file not found: %s", rel)
   568		}
   569		if info.IsDir() {
   570			return verr.New(label, "must point to a file: %s", rel)
   571		}
   572		if len(runtimeRoots) > 0 {
   573			for _, root := range runtimeRoots {
   574				if pathContains(root, rel) {
   575					return nil
   576				}
   577			}
   578			return verr.New(label, "command path %q is not inside any runtime_roots", rel)
   579		}
   580		return nil
   581	}
