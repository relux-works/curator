   175		if data["commands"] != nil && rawCommands == nil {
   176			return nil, verr.New("commands", "agents/runtime.json field 'commands' must be an object")
   177		}
   178		commands := map[string]Command{}
   179		for name, rawPath := range rawCommands {
   180			if name == "" {
   181				return nil, verr.New("commands", "runtime command names must be non-empty strings")
   182			}
   183			if !identifiers.Valid(name) {
   184				return nil, verr.New("commands."+name, "runtime command name %s", identifiers.Rule)
   185			}
