   622		if err := json.Unmarshal(payload, &raw); err != nil {
   623			return nil, fmt.Errorf("malformed JSON in %s: %w", filePath, err)
   624		}
   625		obj, ok := raw.(map[string]any)
   626		if !ok {
   627			return nil, fmt.Errorf("%s must contain a JSON object", filePath)
   628		}
   629		return obj, nil
   630	}
