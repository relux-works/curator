   137	def test_windows_stream_enumerator_filters_default_stream(tmp_path, monkeypatch):
   138	    calls = 0
   139	    closed = []
   140	
   141	    class Function:
   142	        def __init__(self, callback):
   143	            self._callback = callback
   144	            self.argtypes = None
   145	            self.restype = None
   146	
   147	        def __call__(self, *args):
   148	            return self._callback(*args)
   149	
   150	    def set_stream_name(pointer, name):
   151	        data = ctypes.cast(
   152	            pointer,
   153	            ctypes.POINTER(_windows._Win32FindStreamData),
   154	        ).contents
   155	        data.stream_name = name
   156	
   157	    def find_first(path, level, data, flags):
   158	        del path, level, flags
   159	        set_stream_name(data, "::$DATA")
   160	        return 42
   161	
   162	    def find_next(handle, data):
   163	        nonlocal calls
   164	        del handle
   165	        calls += 1
   166	        if calls == 1:
   167	            set_stream_name(data, ":hidden:$DATA")
   168	            return 1
   169	        return 0
   170	
   171	    kernel32 = SimpleNamespace(
   172	        FindFirstStreamW=Function(find_first),
   173	        FindNextStreamW=Function(find_next),
   174	        FindClose=Function(lambda handle: closed.append(handle) or 1),
   175	    )
   176	
   177	    def load_library(name, *, use_last_error):
   178	        assert name == "kernel32"
   179	        assert use_last_error is True
   180	        return kernel32
   181	
   182	    monkeypatch.setattr(ctypes, "WinDLL", load_library, raising=False)
   183	    monkeypatch.setattr(ctypes, "get_last_error", lambda: 38, raising=False)
