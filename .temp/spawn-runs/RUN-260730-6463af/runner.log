   531	def _reject_windows_named_streams(path: Path, relative: str) -> None:
   532	    if os.name != "nt":
   533	        return
   534	    from ._windows import named_data_streams
   535	
   536	    try:
   537	        streams = named_data_streams(path)
   538	    except OSError as exc:
   539	        raise InvalidSnapshotError(
   540	            f"cannot inspect Windows data streams in build-source snapshot: {relative}"
   541	        ) from exc
   542	    if streams:
   543	        raise InvalidSnapshotError(
   544	            f"non-portable Windows data stream in build-source snapshot: "
   545	            f"{relative}{streams[0]}"
   546	        )
