   455	def _open_file_below_root(root_fd: int, relative: str) -> int:
   456	    parts = relative.split("/")
   457	    directory_fd = os.dup(root_fd)
   458	    try:
   459	        for index, component in enumerate(parts[:-1]):
   460	            child_fd = _open_directory_at(directory_fd, component, "/".join(parts[: index + 1]))
   461	            os.close(directory_fd)
   462	            directory_fd = child_fd
   463	        flags = os.O_RDONLY | os.O_NOFOLLOW
   464	        flags |= getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_BINARY", 0)
   465	        try:
   466	            return os.open(parts[-1], flags, dir_fd=directory_fd)
   467	        except OSError as exc:
   468	            raise InvalidSnapshotError(f"cannot open build-source file: {relative}") from exc
   469	    finally:
   470	        os.close(directory_fd)
   471	
   472	
   473	def _fd_chunks(
   474	    file_fd: int,
   475	    size: int,
   476	    relative: str,
   477	    content_digest: _Digest,
   478	) -> Iterator[bytes]:
   479	    remaining = size
   480	    while remaining:
   481	        try:
   482	            chunk = os.read(file_fd, min(remaining, _READ_CHUNK_SIZE))
   483	        except OSError as exc:
   484	            raise InvalidSnapshotError(f"cannot read build-source file: {relative}") from exc
   485	        if not chunk:
   486	            raise InvalidSnapshotError(f"build-source file shrank while reading: {relative}")
   487	        remaining -= len(chunk)
   488	        content_digest.update(chunk)
   489	        yield chunk
   490	    try:
   491	        extra = os.read(file_fd, 1)
   492	    except OSError as exc:
   493	        raise InvalidSnapshotError(f"cannot finish reading build-source file: {relative}") from exc
   494	    if extra:
   495	        raise InvalidSnapshotError(f"build-source file grew while reading: {relative}")
   496	
   497	
   498	def _file_chunks(
   499	    file: BinaryIO,
   500	    size: int,
   501	    relative: str,
   502	    content_digest: _Digest,
   503	) -> Iterator[bytes]:
   504	    remaining = size
   505	    while remaining:
   506	        chunk = file.read(min(remaining, _READ_CHUNK_SIZE))
   507	        if not chunk:
   508	            raise InvalidSnapshotError(f"build-source file shrank while reading: {relative}")
   509	        remaining -= len(chunk)
   510	        content_digest.update(chunk)
   511	        yield chunk
   512	    if file.read(1):
   513	        raise InvalidSnapshotError(f"build-source file grew while reading: {relative}")
   514	
