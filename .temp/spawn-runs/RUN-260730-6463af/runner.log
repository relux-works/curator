   222	def _scan_snapshot(path: Path, root_fd: int | None) -> _SnapshotScan:
   223	    paths = _PathRegistry()
   224	    directories: list[_StateEntry] = []
   225	    files: list[_DiscoveredFile] = []
   226	    if root_fd is None:
   227	        _collect_path_entries(path, path, "", paths, directories, files)
   228	    else:
   229	        _collect_fd_entries(path, root_fd, "", paths, directories, files)
   230	
   231	    hasher = hashing._BuildSourceHasher()
   232	    file_states: list[_StateEntry] = []
   233	    for record in sorted(files, key=lambda item: item.path_bytes):
   234	        file_states.append(_hash_file(path, root_fd, record, hasher))
   235	    state = tuple(sorted((*directories, *file_states), key=lambda item: (item.path_bytes, item.kind)))
   236	    return _SnapshotScan(
   237	        identity=BuildSourceIdentity(
   238	            algorithm=hashing.BUILD_SOURCE_ALGORITHM,
   239	            content_sha256=hasher.content_sha256(),
   240	        ),
   241	        state=state,
   242	    )
