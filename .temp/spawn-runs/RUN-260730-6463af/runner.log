   170	def freeze_snapshot(root: Path) -> FrozenSnapshot:
   171	    """Validate all descendants without following links and retain the root."""
   172	
   173	    path = Path(os.path.abspath(os.fspath(root)))
   174	    root_stat = _validated_root_stat(path)
   175	    root_fd = _open_root_fd(path)
   176	    try:
   177	        if root_fd is not None:
   178	            opened_root = os.fstat(root_fd)
   179	            if not stat.S_ISDIR(opened_root.st_mode) or not _same_file(root_stat, opened_root):
   180	                raise InvalidSnapshotError(f"build-source snapshot root changed while opening: {path}")
   181	            root_stat = opened_root
   182	        scan = _scan_snapshot(path, root_fd)
   183	        current_root = _validated_root_stat(path)
   184	        if not _same_file(root_stat, current_root):
   185	            raise InvalidSnapshotError(f"build-source snapshot root changed while scanning: {path}")
   186	        return FrozenSnapshot(path, root_stat, root_fd, scan)
   187	    except BaseException:
   188	        if root_fd is not None:
   189	            os.close(root_fd)
   190	        raise
