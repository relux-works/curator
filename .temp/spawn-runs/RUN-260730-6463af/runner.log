   245	def _collect_fd_entries(
   246	    root: Path,
   247	    directory_fd: int,
   248	    prefix: str,
   249	    paths: _PathRegistry,
   250	    directories: list[_StateEntry],
   251	    files: list[_DiscoveredFile],
   252	) -> None:
   253	    try:
   254	        with os.scandir(directory_fd) as iterator:
   255	            names = [entry.name for entry in iterator]
   256	    except OSError as exc:
   257	        raise InvalidSnapshotError(f"cannot list build-source snapshot directory: {prefix or '.'}") from exc
   258	
   259	    for name in names:
   260	        relative = f"{prefix}/{name}" if prefix else name
   261	        path_bytes = paths.add(relative)
   262	        try:
   263	            entry_stat = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
   264	        except OSError as exc:
   265	            raise InvalidSnapshotError(f"cannot inspect build-source path: {relative}") from exc
   266	        if _is_link_or_reparse(entry_stat):
   267	            raise InvalidSnapshotError(f"link forbidden in build-source snapshot: {relative}")
   268	        if stat.S_ISDIR(entry_stat.st_mode):
   269	            directories.append(_StateEntry(path_bytes=path_bytes, kind="D"))
   270	            child_fd = _open_directory_at(directory_fd, name, relative)
   271	            try:
   272	                opened_stat = os.fstat(child_fd)
   273	                if not stat.S_ISDIR(opened_stat.st_mode) or not _same_file(entry_stat, opened_stat):
   274	                    raise InvalidSnapshotError(
   275	                        f"build-source directory changed while opening: {relative}"
   276	                    )
   277	                _collect_fd_entries(root, child_fd, relative, paths, directories, files)
   278	            finally:
   279	                os.close(child_fd)
   280	        elif stat.S_ISREG(entry_stat.st_mode):
   281	            if entry_stat.st_size < 0:
   282	                raise InvalidSnapshotError(f"negative file size in build-source snapshot: {relative}")
   283	            files.append(
   284	                _DiscoveredFile(
   285	                    path=relative,
   286	                    path_bytes=path_bytes,
   287	                    size=entry_stat.st_size,
   288	                    file_key=_file_key(entry_stat),
   289	                    absolute_path=root.joinpath(*relative.split("/")),
   290	                )
   291	            )
   292	        else:
   293	            raise InvalidSnapshotError(f"special file forbidden in build-source snapshot: {relative}")
