   193	def _validated_root_stat(path: Path) -> os.stat_result:
   194	    try:
   195	        root_stat = os.lstat(path)
   196	    except OSError as exc:
   197	        raise InvalidSnapshotError(f"build-source snapshot root is unavailable: {path}") from exc
   198	    if _is_link_or_reparse(root_stat):
   199	        raise InvalidSnapshotError(f"build-source snapshot root must not be a link: {path}")
   200	    if not stat.S_ISDIR(root_stat.st_mode):
   201	        raise InvalidSnapshotError(f"build-source snapshot root is not a directory: {path}")
   202	    _reject_windows_named_streams(path, ".")
   203	    return root_stat
