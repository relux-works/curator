   348	def _open_directory_at(parent_fd: int, name: str, relative: str) -> int:
   349	    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
   350	    flags |= getattr(os, "O_CLOEXEC", 0)
   351	    try:
   352	        return os.open(name, flags, dir_fd=parent_fd)
