   549	class _PathRegistry:
   550	    def __init__(self) -> None:
   551	        self._encoded: set[bytes] = set()
   552	        self._platform: dict[str, str] = {}
   553	
   554	    def add(self, path: str) -> bytes:
   555	        if not is_valid_portable_path(path):
   556	            raise InvalidSnapshotError(f"non-portable path in build-source snapshot: {path!r}")
   557	        try:
   558	            path_bytes = path.encode("utf-8", errors="strict")
   559	        except UnicodeEncodeError as exc:
   560	            raise InvalidSnapshotError(f"invalid Unicode in build-source path: {path!r}") from exc
   561	        if path_bytes in self._encoded:
   562	            raise InvalidSnapshotError(f"duplicate path in build-source snapshot: {path!r}")
   563	        self._encoded.add(path_bytes)
   564	        platform_key = unicodedata.normalize(
   565	            "NFD",
   566	            unicodedata.normalize("NFD", path).casefold(),
   567	        )
   568	        previous = self._platform.get(platform_key)
   569	        if previous is not None and previous != path:
   570	            raise InvalidSnapshotError(
   571	                f"platform path collision in build-source snapshot: {previous!r} and {path!r}"
   572	            )
   573	        self._platform[platform_key] = path
   574	        return path_bytes

