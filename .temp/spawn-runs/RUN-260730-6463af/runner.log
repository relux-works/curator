   516	def _same_file(left: os.stat_result, right: os.stat_result) -> bool:
   517	    return _file_key(left) == _file_key(right)
   518	
   519	
   520	def _file_key(value: os.stat_result) -> tuple[int, int]:
   521	    return value.st_dev, value.st_ino
   522	
   523	
   524	def _is_link_or_reparse(value: os.stat_result) -> bool:
   525	    if stat.S_ISLNK(value.st_mode):
   526	        return True
   527	    attributes = getattr(value, "st_file_attributes", 0)
   528	    return bool(attributes & _REPARSE_ATTRIBUTE)
