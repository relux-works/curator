"""Platform-neutral identities for the declarative build domain."""

from typing import Final, Literal

from .source import (
    BuildSourceError,
    BuildSourceIdentity,
    FrozenSnapshot,
    InvalidSnapshotError,
    SnapshotMutationError,
    freeze_snapshot,
)


