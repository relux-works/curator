   357	def _hash_file(
   358	    root: Path,
   359	    root_fd: int | None,
   360	    record: _DiscoveredFile,
   361	    hasher: hashing._BuildSourceHasher,
   362	) -> _StateEntry:
   363	    if root_fd is None:
   364	        return _hash_path_file(record, hasher)
   365	    return _hash_fd_file(root, root_fd, record, hasher)
   366	
   367	
   368	def _hash_fd_file(
   369	    root: Path,
   370	    root_fd: int,
   371	    record: _DiscoveredFile,
   372	    hasher: hashing._BuildSourceHasher,
   373	) -> _StateEntry:
   374	    del root
   375	    file_fd = _open_file_below_root(root_fd, record.path)
   376	    try:
   377	        opened_stat = os.fstat(file_fd)
   378	        if (
   379	            not stat.S_ISREG(opened_stat.st_mode)
   380	            or _file_key(opened_stat) != record.file_key
   381	            or opened_stat.st_size != record.size
   382	        ):
   383	            raise InvalidSnapshotError(f"build-source file changed while opening: {record.path}")
   384	        content_digest = hashlib.sha256()
   385	        hasher.add_file(
   386	            record.path,
   387	            record.size,
   388	            _fd_chunks(file_fd, record.size, record.path, content_digest),
   389	        )
   390	        after_stat = os.fstat(file_fd)
   391	        if (
   392	            not stat.S_ISREG(after_stat.st_mode)
   393	            or _file_key(after_stat) != record.file_key
   394	            or after_stat.st_size != record.size
   395	        ):
   396	            raise InvalidSnapshotError(f"build-source file changed while reading: {record.path}")
   397	        return _StateEntry(
   398	            path_bytes=record.path_bytes,
   399	            kind="F",
   400	            size=record.size,
   401	            content_sha256=content_digest.digest(),
   402	        )
   403	    finally:
   404	        os.close(file_fd)
