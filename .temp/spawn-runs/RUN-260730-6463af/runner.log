   206	def _open_root_fd(path: Path) -> int | None:
   207	    if (
   208	        os.name != "posix"
   209	        or not hasattr(os, "O_DIRECTORY")
   210	        or not hasattr(os, "O_NOFOLLOW")
   211	        or os.scandir not in os.supports_fd
   212	    ):
   213	        return None
   214	    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
   215	    flags |= getattr(os, "O_CLOEXEC", 0)
   216	    try:
   217	        return os.open(path, flags)
   218	    except OSError as exc:
   219	        raise InvalidSnapshotError(f"cannot retain build-source snapshot root: {path}") from exc
