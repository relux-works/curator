   406	
   407	def _hash_path_file(
   408	    record: _DiscoveredFile,
   409	    hasher: hashing._BuildSourceHasher,
   410	) -> _StateEntry:
   411	    try:
   412	        before_stat = os.lstat(record.absolute_path)
   413	    except OSError as exc:
   414	        raise InvalidSnapshotError(f"cannot inspect build-source file: {record.path}") from exc
   415	    if (
   416	        _is_link_or_reparse(before_stat)
   417	        or not stat.S_ISREG(before_stat.st_mode)
   418	        or _file_key(before_stat) != record.file_key
   419	        or before_stat.st_size != record.size
   420	    ):
   421	        raise InvalidSnapshotError(f"build-source file changed while opening: {record.path}")
   422	
   423	    content_digest = hashlib.sha256()
   424	    try:
   425	        with record.absolute_path.open("rb", buffering=0) as file:
   426	            opened_stat = os.fstat(file.fileno())
   427	            if (
   428	                not stat.S_ISREG(opened_stat.st_mode)
   429	                or _file_key(opened_stat) != record.file_key
   430	                or opened_stat.st_size != record.size
   431	            ):
   432	                raise InvalidSnapshotError(f"build-source file changed while opening: {record.path}")
   433	            hasher.add_file(
   434	                record.path,
   435	                record.size,
   436	                _file_chunks(file, record.size, record.path, content_digest),
   437	            )
   438	            after_stat = os.fstat(file.fileno())
   439	            if (
   440	                not stat.S_ISREG(after_stat.st_mode)
   441	                or _file_key(after_stat) != record.file_key
   442	                or after_stat.st_size != record.size
   443	            ):
   444	                raise InvalidSnapshotError(f"build-source file changed while reading: {record.path}")
   445	    except OSError as exc:
   446	        raise InvalidSnapshotError(f"cannot read build-source file: {record.path}") from exc
   447	    return _StateEntry(
   448	        path_bytes=record.path_bytes,
   449	        kind="F",
   450	        size=record.size,
   451	        content_sha256=content_digest.digest(),
   452	    )
