func digestFile(hash io.Writer, path, rel string, info os.FileInfo) (result error) {
	file, err := os.Open(path) // #nosec G304 -- caller-selected transaction target
	if err != nil {
		return err
	}
	defer func() { result = errors.Join(result, file.Close()) }()
	if info.Size() < 0 {
