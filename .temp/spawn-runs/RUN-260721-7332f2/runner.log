			}
			for _, path := range []string{backup, backup + ".delete", engine.journalPath(journal.TransactionID)} {
				if _, err := os.Lstat(path); !os.IsNotExist(err) {
					t.Fatalf("cleanup recovery left %s: %v", path, err)
				}
			}
		})
	}
}

