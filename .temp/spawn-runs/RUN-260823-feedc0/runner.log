+func fixedEnvironmentForHost(t *testing.T, vectors positiveVectors, goos, goarch string) (map[string]string, map[string]bool) {
+	t.Helper()
+	if len(vectors.FixedEnvironmentCases) == 0 {
+		return vectors.FixedEnvironment, nil
+	}
