+		if testCase.GOOS != goos || testCase.GOARCH != goarch {
+			continue
+		}
+		optional := make(map[string]bool, len(testCase.OptionalVariables))
+		for _, key := range testCase.OptionalVariables {
+			optional[key] = true
+		}
