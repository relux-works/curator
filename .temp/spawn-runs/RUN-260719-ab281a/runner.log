   296	  "GOVCS": "*:off",
   297	  "GOWORK": "off",
   298	  "GOTOOLCHAIN": "local",
   299	  "GOTELEMETRY": "off",
   300	  "CGO_ENABLED": "0",
   301	  "GOEXPERIMENT": "",
   302	  "GOROOT": "<resolved-trusted-goroot>",
