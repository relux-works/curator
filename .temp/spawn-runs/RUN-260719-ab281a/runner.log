   181	### 3.2 Valid manifest example
   182	
   183	This example deliberately mixes a compiled command with an existing script command; command collision and activation rules apply uniformly to both.
   184	
   185	```json
   186	{
   187	  "schema_version": 6,
   188	  "runtime_roots": ["scripts"],
   189	  "commands": {
   190	    "golden-tool": {
   191	      "type": "build",
   192	      "driver": "go-v1",
   193	      "source_dir": "cmd/golden-tool"
   194	    },
   195	    "skill-helper": {
   196	      "type": "script",
   197	      "unix_path": "scripts/skill-helper",
   198	      "win_path": "scripts/skill-helper.cmd"
   199	    }
   200	  },
   201	  "capabilities": {
