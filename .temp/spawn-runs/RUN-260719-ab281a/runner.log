   960	def _replace_dir(new_dir: Path, target: Path) -> None:
   961	    target.parent.mkdir(parents=True, exist_ok=True)
   962	    backup = target.parent / f".{target.name}.backup-{os.getpid()}"
   963	    if backup.exists():
   964	        shutil.rmtree(backup)
   965	    if target.exists() or target.is_symlink():
   966	        target.rename(backup)
   967	    try:
   968	        new_dir.rename(target)
   969	    except Exception:
   970	        if backup.exists() and not target.exists():
   971	            backup.rename(target)
   972	        raise
   973	    if backup.exists():
   974	        shutil.rmtree(backup)
