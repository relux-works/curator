   534	func runtimePathEntries(node *closure.Node, binDir, platform string) ([]string, error) {
   535		absoluteBin, err := filepath.Abs(binDir)
   536		if err != nil {
   537			return nil, err
   538		}
   539		candidates := []string{absoluteBin}
   540		type systemCommand struct{ name, binary string }
   541		var commands []systemCommand
   542		for _, command := range node.Spec.Commands {
   543			if command.Type == "system" {
   544				commands = append(commands, systemCommand{command.Name, command.Command})
   545			}
   546		}
   547		for _, dependency := range node.Spec.Dependencies {
   548			if dependency.Type == "system" {
   549				commands = append(commands, systemCommand{dependency.Name, dependency.Command})
   550			}
   551		}
   552		sort.Slice(commands, func(i, j int) bool { return commands[i].name < commands[j].name })
   553		for _, command := range commands {
   554			resolved, lookErr := exec.LookPath(command.binary)
   555			if lookErr != nil {
   556				return nil, fmt.Errorf("missing system command %q for %s", command.binary, node.Name)
   557			}
   558			if absolute, absErr := filepath.Abs(resolved); absErr == nil {
   559				resolved = absolute
   560			}
   561			if evaluated, evalErr := filepath.EvalSymlinks(resolved); evalErr == nil {
   562				resolved = evaluated
   563			}
   564			candidates = append(candidates, filepath.Dir(resolved))
   565		}
   566		seen := map[string]bool{}
   567		entries := make([]string, 0, len(candidates))
   568		for _, candidate := range candidates {
   569			key := filepath.Clean(candidate)
   570			if platform == "windows" {
   571				key = strings.ToLower(key)
   572			}
   573			if !seen[key] {
   574				seen[key] = true
   575				entries = append(entries, candidate)
   576			}
   577		}
   578		return entries, nil
   579	}
