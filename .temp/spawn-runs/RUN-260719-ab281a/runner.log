   287	def _hybrid_store_names(nodes: list[closure.ClosureNode], project_declared: set[str]) -> set[str]:
   288	    """Names materialized in the hybrid store: unreachable from project declarations."""
   289	    by_name = {node.name: node for node in nodes}
   290	    reachable: set[str] = set()
   291	    stack = [name for name in project_declared if name in by_name]
   292	    while stack:
   293	        current = stack.pop()
   294	        if current in reachable:
   295	            continue
   296	        reachable.add(current)
   297	        for requirement in by_name[current].spec.requirements.values():
   298	            if requirement.name in by_name and requirement.name not in reachable:
   299	                stack.append(requirement.name)
   300	    return set(by_name) - reachable

