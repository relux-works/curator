   905	def _marker_is_current(
   906	    marker: dict[str, object] | None,
   907	    target: Path,
   908	    plan: SkillPlan,
   909	    locale_value: str | None,
   910	    agents: list[str],
   911	    *,
   912	    activation: dict[str, object] | None = None,
   913	    substituted: str | None = None,
   914	    mcp_servers: dict[str, list[str]] | None = None,
   915	    attestation: dict[str, object] | None = None,
   916	) -> bool:
   917	    if not marker or not target.exists():
   918	        return False
   919	    if marker.get("schema_version") != 1:
   920	        raise InstallError(f"Unsupported installed marker schema in {target / '.csk-install.json'}")
   921	    if marker.get("ref_kind") != plan.resolved.kind or marker.get("ref") != plan.resolved.ref:
   922	        return False
   923	    if marker.get("commit") != plan.resolved.commit:
   924	        return False
   925	    if marker.get("locale") != locale_value:
   926	        return False
   927	    if marker.get("agents") != sorted(set(agents)):
   928	        return False
   929	    if activation is not None:
   930	        activation_commands = activation.get("commands", [])
   931	        if not isinstance(activation_commands, list) or not all(
   932	            isinstance(command, str) for command in activation_commands
   933	        ):
   934	            return False
   935	        expected_activation = {**activation, "commands": sorted(set(activation_commands))}
   936	        if marker.get("activation") != expected_activation:
   937	            return False
   938	    if marker.get("substituted") != substituted:
   939	        return False
   940	    if mcp_servers is not None:
   941	        expected_mcp = {name: sorted(set(found)) for name, found in sorted(mcp_servers.items())}
   942	        if marker.get("mcp_servers") != expected_mcp:
   943	            return False
   944	    if marker.get("attestation") != attestation:
   945	        return False
   946	    actual_hash = hashing.content_sha256(target)
   947	    return marker.get("content_sha256") == actual_hash
