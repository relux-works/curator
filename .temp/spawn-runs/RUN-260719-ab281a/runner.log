   602	func directoryOnPath(directory, pathValue, platform string) bool {
   603		separator := string(os.PathListSeparator)
   604		if platform == "windows" {
   605			separator = ";"
   606		}
   607		for _, entry := range strings.Split(pathValue, separator) {
   608			if entry == "" {
   609				continue
   610			}
   611			if left, leftErr := os.Stat(directory); leftErr == nil {
   612				if right, rightErr := os.Stat(entry); rightErr == nil && os.SameFile(left, right) {
   613					return true
   614				}
   615			}
   616			expected, expectedErr := filepath.Abs(directory)
   617			actual, actualErr := filepath.Abs(entry)
   618			if expectedErr != nil || actualErr != nil {
   619				continue
   620			}
   621			if platform == "windows" {
   622				if strings.EqualFold(filepath.Clean(expected), filepath.Clean(actual)) {
   623					return true
   624				}
   625			} else if filepath.Clean(expected) == filepath.Clean(actual) {
   626				return true
   627			}
   628		}
   629		return false
   630	}
