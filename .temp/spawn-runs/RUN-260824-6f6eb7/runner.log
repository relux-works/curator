+			afterCredentials, readErr := os.ReadFile(credentialsPath)
+			if readErr != nil {
+				t.Fatal(readErr)
+			}
+			if !bytes.Equal(afterCredentials, beforeCredentials) {
+				t.Fatalf("this-run-only HTTPS answer changed credential store:\n%s", afterCredentials)
+			}
+		})
