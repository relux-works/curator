+func TestPromptThisRunOnlyReturnsSSHCredentialWithoutPersisting(t *testing.T) {
+	persisted, added, transcript, err := runPrompt(t, "\nr\n", []BuildSSHRequest{portalsRequest()}, promptCandidates())
