+	for scope := range scopes {
+		if credentialScopeCovers(scope, identity) && len(scope) > len(best) {
+			best = scope
+		}
+	}
+	if best == "" {
+		return BuildHTTPSCredentials{}, "", false
+	}
+	return scopes[best], best, true
+}
