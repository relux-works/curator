	baseIndex, _ := hex.DecodeString(checksumBase["index_hex"].(string))
	mutatedPack := append([]byte{}, basePack...)
	mutatedIndex := append([]byte{}, baseIndex...)
	mutation := checksumCase["mutation"].(map[string]any)
