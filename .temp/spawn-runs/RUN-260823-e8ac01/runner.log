+	for command, raw := range marker["builds"].(map[string]any) {
+		if raw.(map[string]any)["execution_policy"] != portableExecutionPolicy {
+			t.Fatalf("marker-v4 build %s lost compiled execution policy: %#v", command, raw)
+		}
+	}
+}
