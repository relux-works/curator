 func TestExternalRepositoryBehaviorCoverageAndOrdering(t *testing.T) {
 	root := repositoryRoot(t)
 	vectors := filepath.Join(root, "conformance", "v1", "vectors")
@@ -1535,7 +1653,7 @@
