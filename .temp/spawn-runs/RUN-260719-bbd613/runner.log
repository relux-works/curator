    runtime_path: Path,
    *,
    platform_name: str | None = None,
    path_entries: tuple[Path, ...] = (),
) -> Path:
    return write_bin_shim(
        project_root / ".agents" / "bin",
        command_name,
        runtime_path,
        platform_name=platform_name,
        path_entries=path_entries,
    )


def write_global_shim(
