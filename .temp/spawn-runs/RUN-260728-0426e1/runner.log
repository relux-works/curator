   664	// makeMissingDirectories creates path and every missing ancestor, returning the
   665	// ones it actually created, shallowest first.
   666	func makeMissingDirectories(path string) ([]string, error) {
   667		if _, err := os.Lstat(path); err == nil {
   668			return nil, nil
   669		} else if !os.IsNotExist(err) {
   670			return nil, err
   671		}
   672		parent := filepath.Dir(path)
   673		var created []string
   674		if parent != path {
   675			added, err := makeMissingDirectories(parent)
   676			created = append(created, added...)
   677			if err != nil {
   678				return created, err
   679			}
   680		}
   681		if err := os.Mkdir(path, 0o755); err != nil {
   682			if os.IsExist(err) {
   683				return created, nil
   684			}
   685			return created, err
   686		}
   687		return append(created, path), nil
   688	}
