   164	func randomTransactionID() (string, error) {
   165		buffer := make([]byte, 16)
   166		if _, err := rand.Read(buffer); err != nil {
   167			return "", fmt.Errorf("generate transaction id: %w", err)
   168		}
   169		return "install-" + hex.EncodeToString(buffer), nil
   170	}
