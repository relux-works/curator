    96	// Project installs one project per Spec §8.1.
    97	//
    98	// A real operation holds the canonical project operation lock from before
    99	// planning until after handoff, recovers every incomplete transaction journal
   100	// under a brief manager-home lock before any network, audit, fingerprinting, or
   101	// compilation work, and commits through one manager-home-locked transaction. A
   102	// dry run acquires no lock, recovers nothing, and returns before staging.
   103	func Project(cfg *config.Config, projectRoot, alias string, opts Options) Result {
   104		if opts.DryRun {
   105			result, _ := projectAttempt(cfg, projectRoot, alias, opts, CommitDeps{})
   106			return result
   107		}
   108		commit, err := opts.Commit.resolve(cfg.Home(), opts.Build.Cache)
   109		if err != nil {
   110			return failedResult(alias, projectRoot, err)
   111		}
   112		ctx := opts.context()
   113		locks, err := commit.Locks.AcquireProjects(ctx, projectRoot)
   114		if err != nil {
   115			return failedResult(alias, projectRoot, fmt.Errorf("acquire the project operation lock: %w", err))
   116		}
   117		defer func() { _ = locks.Close() }()
   118		if err := recoverJournals(ctx, commit); err != nil {
   119			return failedResult(alias, projectRoot, err)
   120		}
   121		return runWithRestarts(alias, commit, func() (Result, *restartError) {
   122			return projectAttempt(cfg, projectRoot, alias, opts, commit)
   123		})
   124	}
   125	
   126	// runWithRestarts re-runs one scope while revalidation keeps reporting that
   127	// shared state moved. Restarting is always preferable to applying a stale plan;
   128	// the bound turns a livelock into a reported failure instead of an endless loop.
   129	func runWithRestarts(alias string, commit CommitDeps, attempt func() (Result, *restartError)) Result {
   130		var carried []string
   131		for tries := 1; ; tries++ {
   132			result, restart := attempt()
   133			if restart == nil {
   134				result.Messages = append(carried, result.Messages...)
   135				return result
   136			}
   137			if tries >= commit.MaxRestarts {
   138				result.Messages = append(carried, result.Messages...)
   139				result.failf("%v (gave up after %d attempts)", restart, tries)
   140				return result
   141			}
   142			carried = append(carried, fmt.Sprintf("%s: %v", alias, restart))
   143		}
   144	}
