   602	// journalPlan converts the staged target set into one durable transaction. The
   603	// preimage digest of every target is read here, under the home lock, so no
   604	// other process can move a target between the expectation and the swap.
   605	// It returns the parent directories it had to create, deepest last, so an
   606	// abandoned commit can unwind exactly what it added.
   607	func journalPlan(request commitRequest, targets scopeTargets) (transaction.Plan, []string, error) {
   608		var created []string
   609		id, err := request.commit.NewTransactionID()
   610		if err != nil {
   611			return transaction.Plan{}, created, err
   612		}
   613		identity := request.projectRoot
   614		if identity == "" {
   615			identity = "global:" + request.home
   616		}
   617		plan := transaction.Plan{
   618			TransactionID:       id,
   619			ProjectIdentity:     identity,
   620			ReferencedBuildKeys: uniqueSorted(targets.referencedKeys),
   621		}
   622		for _, target := range targets.Sorted() {
   623			kind, err := journalKind(target.Kind)
   624			if err != nil {
   625				return transaction.Plan{}, created, fmt.Errorf("stage %s/%s: %w", target.Class, target.Identifier, err)
   626			}
   627			if target.StagedPath != "" {
   628				added, err := makeMissingDirectories(filepath.Dir(target.LivePath))
   629				if err != nil {
   630					return transaction.Plan{}, created, fmt.Errorf("prepare the parent of %s: %w", target.LivePath, err)
   631				}
   632				created = append(created, added...)
   633			}
   634			preimage, err := transaction.DigestTarget(kind, target.LivePath)
   635			if err != nil {
   636				return transaction.Plan{}, created, fmt.Errorf("read the current state of %s: %w", target.LivePath, err)
   637			}
   638			plan.Targets = append(plan.Targets, transaction.Target{
   639				Class:          target.Class,
   640				Identifier:     target.Identifier,
   641				Kind:           kind,
   642				LivePath:       target.LivePath,
   643				StagedSource:   target.StagedPath,
   644				PreimageDigest: preimage,
   645			})
   646		}
   647		return plan, created, nil
   648	}
