   266	// quoteJSONPath renders a filesystem path as a JSON string literal, so a
   267	// Windows separator cannot turn into an escape sequence.
   268	func quoteJSONPath(path string) string {
   269		quoted := make([]rune, 0, len(path)+2)
   270		quoted = append(quoted, '"')
   271		for _, char := range path {
   272			if char == '\\' || char == '"' {
   273				quoted = append(quoted, '\\')
   274			}
   275			quoted = append(quoted, char)
   276		}
   277		return string(append(quoted, '"'))
   278	}

