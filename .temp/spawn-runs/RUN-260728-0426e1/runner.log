   248	// stageStaleSkillRemovals turns installed skills that the next closure does not
   249	// keep into removal targets. The store is manager-owned and holds only context
   250	// directories, so every visible entry is claimed — except a link or special
   251	// file, which this store never produces and which is therefore reported as
   252	// unexpected state rather than silently deleted.
   253	func stageStaleSkillRemovals(store, kind string, expected map[string]bool) (staging.Plan, error) {
   254		var plan staging.Plan
   255		entries, err := os.ReadDir(store)
   256		if os.IsNotExist(err) {
   257			return plan, nil
   258		}
   259		if err != nil {
   260			return staging.Plan{}, err
   261		}
   262		var names []string
   263		for _, entry := range entries {
   264			name := entry.Name()
   265			if strings.HasPrefix(name, ".") || expected[name] {
   266				continue
   267			}
   268			info, err := os.Lstat(filepath.Join(store, name))
   269			if err != nil {
   270				return staging.Plan{}, err
   271			}
   272			if !info.IsDir() && !info.Mode().IsRegular() {
   273				return staging.Plan{}, fmt.Errorf(
   274					"stale entry %s in %s is a link or special file, which this store never installs", name, store)
   275			}
   276			names = append(names, name)
   277		}
   278		sort.Strings(names)
   279		for _, name := range names {
   280			plan.Remove("skill/"+kind+"/"+name, filepath.Join(store, name))
   281		}
   282		return plan, nil
   283	}
