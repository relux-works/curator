   461	func (engine *Engine) recoverPendingBackup(target *TargetRecord) error {
   462		backupDigest, err := target.digest(target.BackupPath)
   463		if err != nil {
   464			return err
   465		}
   466		if backupDigest == DigestAbsent {
   467			return nil
   468		}
   469		liveDigest, err := target.digest(target.LivePath)
   470		if err != nil {
   471			return err
   472		}
   473		if liveDigest != DigestAbsent {
   474			return corruptionf("target %s/%s has both a pending backup and live bytes", target.Class, target.Identifier)
   475		}
   476		if target.PreimageDigest != "" && backupDigest != target.PreimageDigest {
   477			return corruptionf("pending backup for %s/%s has unknown bytes", target.Class, target.Identifier)
   478		}
   479		if target.ExpectedGeneration != "" {
   480			if err := verifyGenerationAt(target, target.BackupPath); err != nil {
   481				return err
   482			}
   483		}
   484		target.BackupDigest = backupDigest
   485		target.State = StateBackedUp
   486		return nil
   487	}
   488	
   489	func verifyPreimage(target *TargetRecord) error {
   490		if target.PreimageDigest != "" {
   491			current, err := target.digest(target.LivePath)
   492			if err != nil {
   493				return err
   494			}
   495			if current != target.PreimageDigest {
   496				return corruptionf("target %s/%s preimage digest %s, want %s", target.Class, target.Identifier, current, target.PreimageDigest)
   497			}
   498			return nil
   499		}
   500		return verifyGenerationAt(target, target.LivePath)
   501	}
   502	
   503	func verifyGenerationAt(target *TargetRecord, root string) error {
   504		path := root
   505		if target.GenerationPath != "" {
   506			path = filepath.Join(root, filepath.FromSlash(target.GenerationPath))
   507		}
   508		info, err := os.Lstat(path)
   509		if err != nil || !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 || info.Size() > 1024*1024 {
   510			return corruptionf("target %s/%s generation is unavailable or unsafe", target.Class, target.Identifier)
   511		}
   512		file, err := os.Open(path) // #nosec G304 -- path is constrained to the selected live target
   513		if err != nil {
   514			return err
   515		}
   516		after, err := file.Stat()
   517		if err != nil || !os.SameFile(info, after) || !after.Mode().IsRegular() {
   518			_ = file.Close()
   519			return corruptionf("target %s/%s generation changed while opening", target.Class, target.Identifier)
   520		}
   521		payload, readErr := io.ReadAll(io.LimitReader(file, 1024*1024+1))
   522		closeErr := file.Close()
   523		if readErr != nil || closeErr != nil {
   524			return errors.Join(readErr, closeErr)
   525		}
   526		if len(payload) > 1024*1024 {
   527			return corruptionf("target %s/%s generation exceeds the size limit", target.Class, target.Identifier)
   528		}
   529		if string(payload) != target.ExpectedGeneration {
   530			return corruptionf("target %s/%s generation does not match", target.Class, target.Identifier)
   531		}
   532		return nil
   533	}
   534	
   535	func (engine *Engine) rollback(journal *Journal) error {
   536		if journal.Phase != PhaseRollbackCleanup {
   537			journal.Phase = PhaseRollingBack
   538			if err := engine.saveJournal(journal); err != nil {
   539				return err
   540			}
   541			for index := len(journal.Targets) - 1; index >= 0; index-- {
   542				if err := engine.rollbackTarget(journal, index); err != nil {
   543					return err
   544				}
   545			}
   546			journal.Phase = PhaseRollbackCleanup
   547			if err := engine.saveJournal(journal); err != nil {
   548				return err
   549			}
   550		}
   551		if err := engine.removePreparedSidecars(journal); err != nil {
   552			return err
   553		}
   554		return engine.removeJournalDurably(journal)
   555	}
   556	
   557	func (engine *Engine) rollbackTarget(journal *Journal, index int) error {
   558		target := &journal.Targets[index]
   559		if target.State == StatePending {
   560			if backup, err := target.digest(target.BackupPath); err != nil {
   561				return err
   562			} else if backup == DigestAbsent {
   563				return nil
   564			}
   565			target.State = StateBackedUp
   566		}
   567		if target.State == StateRolledBack {
   568			return nil
   569		}
   570		current, err := target.digest(target.LivePath)
   571		if err != nil {
   572			return err
   573		}
   574		rollbackDigest, err := target.digest(target.RollbackPath)
   575		if err != nil {
   576			return err
   577		}
   578		backupDigest, err := target.digest(target.BackupPath)
   579		if err != nil {
   580			return err
   581		}
   582		// Recovery may observe the preimage already restored but StateRolledBack
   583		// not yet durable. Recognize only the exact recorded backup digest and only
   584		// after the backup path has disappeared; unknown current bytes still fail.
   585		if current != DigestAbsent && target.BackupDigest != "" && current == target.BackupDigest && backupDigest == DigestAbsent {
   586			if (rollbackDigest == target.DesiredDigest && rollbackDigest != DigestAbsent) || target.DesiredDigest == DigestAbsent {
   587				target.State = StateRolledBack
   588				if err := engine.saveJournal(journal); err != nil {
   589					return err
   590				}
   591				return engine.emit(journal, index, PointTargetRolledBack)
   592			}
   593		}
   594		if rollbackDigest != DigestAbsent {
   595			if current != DigestAbsent {
   596				return corruptionf("target %s/%s has both live and rollback bytes", target.Class, target.Identifier)
   597			}
   598			if rollbackDigest != target.DesiredDigest {
   599				if existing, err := target.digest(target.LivePath); err != nil {
   600					return err
   601				} else if existing != DigestAbsent {
   602					return corruptionf("rollback refused to overwrite current bytes for %s/%s", target.Class, target.Identifier)
   603				}
   604				if err := durableRenameNoReplace(target.RollbackPath, target.LivePath); err != nil {
   605					return errors.Join(corruptionf("rollback target %s/%s has unknown bytes", target.Class, target.Identifier), err)
   606				}
   607				return corruptionf("rollback target %s/%s desired digest mismatch", target.Class, target.Identifier)
   608			}
   609		} else if current != DigestAbsent {
   610			if current != target.DesiredDigest {
   611				return corruptionf("rollback refused unknown current bytes for %s/%s", target.Class, target.Identifier)
   612			}
   613			if err := durableRenameNoReplace(target.LivePath, target.RollbackPath); err != nil {
   614				return err
   615			}
   616			rollbackDigest, err = target.digest(target.RollbackPath)
   617			if err != nil {
   618				return err
   619			}
   620			if rollbackDigest != target.DesiredDigest {
   621				if existing, existingErr := target.digest(target.LivePath); existingErr != nil {
   622					return existingErr
   623				} else if existing != DigestAbsent {
   624					return corruptionf("rollback captured unknown bytes for %s/%s and current bytes appeared", target.Class, target.Identifier)
   625				}
   626				if restoreErr := durableRenameNoReplace(target.RollbackPath, target.LivePath); restoreErr != nil {
   627					return errors.Join(corruptionf("rollback captured unknown bytes for %s/%s", target.Class, target.Identifier), restoreErr)
   628				}
   629				return corruptionf("rollback captured unknown bytes for %s/%s", target.Class, target.Identifier)
   630			}
   631		} else if target.State == StateCommitted && target.DesiredDigest != DigestAbsent {
   632			return corruptionf("committed target %s/%s disappeared before rollback", target.Class, target.Identifier)
   633		}
   634	
   635		if target.BackupDigest == "" {
   636			target.BackupDigest = backupDigest
   637		}
   638		if backupDigest != target.BackupDigest {
   639			return corruptionf("backup for %s/%s changed before rollback", target.Class, target.Identifier)
   640		}
   641		if backupDigest != DigestAbsent {
   642			if existing, err := target.digest(target.LivePath); err != nil {
   643				return err
   644			} else if existing != DigestAbsent {
   645				return corruptionf("rollback refused to overwrite current bytes for %s/%s", target.Class, target.Identifier)
   646			}
   647			if err := durableRenameNoReplace(target.BackupPath, target.LivePath); err != nil {
   648				return err
   649			}
   650			if err := syncTree(target.LivePath); err != nil {
   651				return err
   652			}
   653		}
   654		if err := engine.emit(journal, index, PointAfterRestore); err != nil {
   655			return err
   656		}
   657		target.State = StateRolledBack
   658		if err := engine.saveJournal(journal); err != nil {
   659			return err
   660		}
   661		return engine.emit(journal, index, PointTargetRolledBack)
   662	}
   663	
   664	func (engine *Engine) cleanupCommitted(journal *Journal) error {
   665		for index := range journal.Targets {
   666			target := &journal.Targets[index]
   667			current, err := target.digest(target.LivePath)
   668			if err != nil {
   669				return err
   670			}
   671			if current != target.DesiredDigest {
   672				return corruptionf("cleanup refused changed target %s/%s", target.Class, target.Identifier)
   673			}
   674		}
   675		if err := engine.resumeRecordedRemoval(journal); err != nil {
   676			return err
   677		}
   678		for _, removal := range committedRemovalCandidates(journal) {
   679			if err := engine.removeRecordedSidecar(journal, removal); err != nil {
   680				return err
   681			}
   682		}
   683		return engine.removeJournalDurably(journal)
   684	}
   685	
   686	func (engine *Engine) removePreparedSidecars(journal *Journal) error {
   687		if err := engine.resumeRecordedRemoval(journal); err != nil {
   688			return err
   689		}
   690		for _, removal := range rollbackRemovalCandidates(journal) {
   691			if err := engine.removeRecordedSidecar(journal, removal); err != nil {
   692				return err
   693			}
   694		}
   695		return nil
   696	}
   697	
   698	type removalCandidate struct {
   699		targetIndex int
   700		kind        TargetKind
   701		path        string
   702		digest      string
   703	}
   704	
   705	func committedRemovalCandidates(journal *Journal) []removalCandidate {
   706		removals := make([]removalCandidate, 0, len(journal.Targets)*3)
   707		for index := len(journal.Targets) - 1; index >= 0; index-- {
   708			target := &journal.Targets[index]
   709			removals = appendRemovalCandidate(removals, index, target.Kind, target.BackupPath, target.BackupDigest)
   710			removals = appendRemovalCandidate(removals, index, target.Kind, target.RollbackPath, target.DesiredDigest)
   711			removals = appendRemovalCandidate(removals, index, target.Kind, target.StagedPath, target.DesiredDigest)
   712		}
   713		return removals
   714	}
   715	
   716	func rollbackRemovalCandidates(journal *Journal) []removalCandidate {
   717		removals := make([]removalCandidate, 0, len(journal.Targets)*3)
   718		for index := len(journal.Targets) - 1; index >= 0; index-- {
   719			target := &journal.Targets[index]
   720			removals = appendRemovalCandidate(removals, index, target.Kind, target.StagedPath, target.DesiredDigest)

