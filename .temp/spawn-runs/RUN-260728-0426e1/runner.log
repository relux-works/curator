     1	// Package staging describes operation-private replacements that the
     2	// transaction layer publishes atomically.
     3	//
     4	// A producer writes desired bytes below an operation-private stage root and
     5	// returns the live path they belong to. It never creates, replaces, or removes
     6	// the live path itself: that is the exclusive job of the manager-home-locked
     7	// commit phase, which journals every target before the first swap and restores
     8	// them in exact reverse order when any class fails.
     9	//
    10	// Classes carry a numeric prefix because the transaction engine orders targets
    11	// bytewise by (class, identifier). The prefix is therefore the commit order
    12	// itself, not decoration, and the machine-wide consumer ledger deliberately
    13	// sorts last.
    14	package staging
    15	
    16	import (
    17		"fmt"
    18		"path/filepath"
    19		"sort"
    20	)
    21	
    22	// Commit classes in normative order (Spec §6.1 step 12).
    23	const (
    24		// ClassContext holds project, global, and hybrid context directories and
    25		// the install markers inside them.
    26		ClassContext = "10-context"
    27		// ClassRuntime holds commit-keyed script runtime trees.
    28		ClassRuntime = "20-runtime"
    29		// ClassCanonicalShim holds project and global canonical launchers.
    30		ClassCanonicalShim = "30-shim-canonical"
    31		// ClassForwardingShim holds safe user-bin forwarding launchers.
    32		ClassForwardingShim = "40-shim-forwarding"
    33		// ClassEnvFile holds the generated PATH helper files of a scope.
    34		ClassEnvFile = "50-env-file"
    35		// ClassAdapterLedger holds per-adapter-root ownership ledgers.
    36		ClassAdapterLedger = "60-adapter-ledger"
    37		// ClassMirrorLedger holds the user-bin mirror ownership ledger.
    38		ClassMirrorLedger = "70-mirror-ledger"
    39		// ClassRemoval holds managed live paths that the next state does not keep.
    40		ClassRemoval = "80-removal"
    41		// ClassConsumer holds the machine-wide consumer ledger and always commits
    42		// last, so a failed first install leaves no consumer record behind.
    43		ClassConsumer = "90-consumer"
    44	)
    45	
    46	// Kind selects how the commit phase owns one target path.
    47	const (
    48		// KindBytes is the default: a regular file or a link-free directory tree.
    49		KindBytes = ""
    50		// KindEntry is a managed directory entry that the manager owns as itself and
    51		// which may be a symbolic link — an agent adapter mirror in the default
    52		// symlink-first mode is exactly this. Its final path component is never
    53		// resolved, and a link is journaled, restored, and removed as the link it is.
    54		KindEntry = "entry"
    55	)
    56	
    57	// Target is one journaled replacement. An empty StagedPath means the desired
    58	// state is absence, which is how a stale managed path is removed.
    59	type Target struct {
    60		Class      string
    61		Identifier string
    62		Kind       string
    63		LivePath   string
    64		StagedPath string
    65	}
    66	
    67	// Removal reports whether the desired state of the target is absence.
    68	func (target Target) Removal() bool { return target.StagedPath == "" }
    69	
    70	// Plan accumulates the complete target set of one commit.
    71	type Plan struct {
    72		Targets []Target
    73	}
    74	
    75	// Replace records a desired replacement of one live path.
    76	func (plan *Plan) Replace(class, identifier, livePath, stagedPath string) {
    77		plan.replace(class, identifier, KindBytes, livePath, stagedPath)
    78	}
    79	
    80	// ReplaceEntry records a desired replacement of one managed directory entry,
    81	// which may be or become a symbolic link.
    82	func (plan *Plan) ReplaceEntry(class, identifier, livePath, stagedPath string) {
    83		plan.replace(class, identifier, KindEntry, livePath, stagedPath)
    84	}
    85	
    86	func (plan *Plan) replace(class, identifier, kind, livePath, stagedPath string) {
    87		plan.Targets = append(plan.Targets, Target{
    88			Class: class, Identifier: identifier, Kind: kind, LivePath: livePath, StagedPath: stagedPath,
    89		})
    90	}
    91	
    92	// Remove records a managed live path whose desired state is absence. Every
    93	// removal commits in the single removal class, after the classes that install
    94	// the state which replaces it.
    95	func (plan *Plan) Remove(identifier, livePath string) {
    96		plan.Targets = append(plan.Targets, Target{
    97			Class: ClassRemoval, Identifier: identifier, LivePath: livePath,
    98		})
    99	}
   100	
   101	// RemoveEntry records a managed directory entry whose desired state is absence.
   102	// A stale adapter mirror is removed through here, so its exact prior state —
   103	// including a symbolic link's destination — is restored by a rollback.
   104	func (plan *Plan) RemoveEntry(identifier, livePath string) {
   105		plan.Targets = append(plan.Targets, Target{
   106			Class: ClassRemoval, Identifier: identifier, Kind: KindEntry, LivePath: livePath,
   107		})
   108	}
   109	
   110	// Merge appends every target of another plan.
   111	func (plan *Plan) Merge(other Plan) {
   112		plan.Targets = append(plan.Targets, other.Targets...)
   113	}
   114	
   115	// Empty reports whether the commit would change nothing.
   116	func (plan Plan) Empty() bool { return len(plan.Targets) == 0 }
   117	
   118	// Sorted returns the targets in commit order: bytewise by class, then by
   119	// identifier inside the class.
   120	func (plan Plan) Sorted() []Target {
   121		sorted := append([]Target(nil), plan.Targets...)
   122		sort.Slice(sorted, func(i, j int) bool {
   123			if sorted[i].Class != sorted[j].Class {
   124				return sorted[i].Class < sorted[j].Class
   125			}
   126			return sorted[i].Identifier < sorted[j].Identifier
   127		})
   128		return sorted
   129	}
   130	
   131	// Validate rejects a plan the commit phase could not journal safely: an
   132	// unusable path, a duplicate canonical identifier, or two targets that name the
   133	// same live path. The transaction layer validates namespaces independently;
   134	// this catches producer defects with a message that names the producer.
   135	func (plan Plan) Validate() error {
   136		seenKey := map[string]bool{}
   137		seenLive := map[string]bool{}
   138		for _, target := range plan.Targets {
   139			if target.Class == "" || target.Identifier == "" {
   140				return fmt.Errorf("staged target has no class or identifier")
   141			}
   142			if target.Kind != KindBytes && target.Kind != KindEntry {
   143				return fmt.Errorf("staged target %s/%s has unknown kind %q", target.Class, target.Identifier, target.Kind)
   144			}
   145			if !filepath.IsAbs(target.LivePath) || filepath.Clean(target.LivePath) != target.LivePath {
   146				return fmt.Errorf("staged target %s/%s live path must be clean and absolute", target.Class, target.Identifier)
   147			}
   148			if target.StagedPath != "" && (!filepath.IsAbs(target.StagedPath) || filepath.Clean(target.StagedPath) != target.StagedPath) {
   149				return fmt.Errorf("staged target %s/%s staged path must be clean and absolute", target.Class, target.Identifier)
   150			}
   151			key := target.Class + "\x00" + target.Identifier
   152			if seenKey[key] {
   153				return fmt.Errorf("duplicate staged target %s/%s", target.Class, target.Identifier)
   154			}
   155			seenKey[key] = true
   156			if seenLive[target.LivePath] {
   157				return fmt.Errorf("two staged targets claim the live path %s", target.LivePath)
   158			}
   159			seenLive[target.LivePath] = true
   160		}
   161		return nil
   162	}

