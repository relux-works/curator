    45	// Prepare creates the durable journal before copying deterministic sibling
    46	// staging targets. Live targets are not changed. Preparation is kept under the
    47	// home lock so one transaction id cannot race another process.
    48	func (engine *Engine) Prepare(lock HomeLock, plan Plan) (*Journal, error) {
    49		if err := requireHomeLock(lock); err != nil {
    50			return nil, err
    51		}
