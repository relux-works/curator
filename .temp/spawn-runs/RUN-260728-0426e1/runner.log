    65			return nil, err
    66		}
    67		prepared := false
    68		defer func() {
    69			if !prepared {
    70				_ = engine.removePreparedSidecars(journal)
    71			}
    72		}()
    73		for index := range journal.Targets {
    74			target := &journal.Targets[index]
    75			if target.StagedPath == "" {
    76				continue
    77			}
    78			if err := engine.stageTarget(journal, index); err != nil {
    79				return nil, engine.abortPreparation(journal, err)
    80			}
    81			got, err := target.digest(target.StagedPath)
    82			if err != nil || got != target.DesiredDigest {
    83				if err == nil {
    84					err = corruptionf("staged target %s/%s digest %s, want %s", target.Class, target.Identifier, got, target.DesiredDigest)
    85				}
    86				return nil, engine.abortPreparation(journal, err)
    87			}
    88			if err := engine.syncStagedParent(filepath.Dir(target.StagedPath)); err != nil {
    89				return nil, engine.abortPreparation(journal, err)
    90			}
    91		}
    92		for index := range journal.Targets {
    93			journal.Targets[index].StagedSource = ""
    94			journal.Targets[index].StagingEntries = nil
    95			journal.Targets[index].StagingIndex = 0
    96			journal.Targets[index].StagingActive = false
    97			journal.Targets[index].StagingCreated = false
    98			journal.Targets[index].StagingBytes = 0
    99			journal.Targets[index].StagingPrefixDigest = ""
   100			journal.Targets[index].StagingWriteBytes = 0
   101			journal.Targets[index].StagingWriteDigest = ""
   102			journal.Targets[index].StagingDiscarded = false
   103		}
