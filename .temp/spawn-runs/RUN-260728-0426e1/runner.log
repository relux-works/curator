   431	// recoverJournals takes the home lock briefly, resumes every incomplete
   432	// transaction, and releases it again before any network, audit, fingerprinting,
   433	// or compilation work (Spec §6.1 step 1).
   434	func recoverJournals(ctx context.Context, deps CommitDeps) error {
   435		lock, err := deps.Locks.AcquireHome(ctx)
   436		if err != nil {
   437			return fmt.Errorf("acquire the manager-home lock for recovery: %w", err)
   438		}
   439		recoverErr := deps.Journal.Recover(lock)
   440		closeErr := lock.Close()
   441		if recoverErr != nil {
   442			return fmt.Errorf("recover incomplete install transactions: %w", errors.Join(recoverErr, closeErr))
   443		}
   444		if closeErr != nil {
   445			return fmt.Errorf("release the manager-home lock after recovery: %w", closeErr)
   446		}
   447		return nil
   448	}
