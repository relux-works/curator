   260	func (state sharedState) diff(other sharedState) []string {
   261		var changed []string
   262		for key, digest := range state {
   263			if other[key] != digest {
   264				changed = append(changed, fmt.Sprintf("%s: %s -> %s", key, digest, other[key]))
   265			}
   266		}
   267		sort.Strings(changed)
   268		return changed
   269	}
   270	
   271	// commitProbe records the ordered target boundaries a commit crosses and can
   272	// fail exactly one of them.
   273	//
   274	// The fault fires at PointAfterBackup, which the engine emits once for every
   275	// target — including a removal, whose desired state is already reached once its
   276	// preimage has been moved aside and which therefore never reaches the install
   277	// boundary. Faulting there is what makes a sweep able to reach every class.
   278	type commitProbe struct {
   279		mu        sync.Mutex
   280		committed []transaction.Event
   281		rolled    []transaction.Event
   282		// preimage records, per target index, whether the live path held anything
   283		// before the commit touched it. A target with nothing to restore is
   284		// correctly absent from the rollback sequence.
   285		preimage map[int]bool
   286		failed   *transaction.Event
   287		// failClass fails the first target of one class.
   288		failClass string
   289		failErr   error
   290	}
   291	
   292	func (probe *commitProbe) hooks() transaction.Hooks {
   293		return transaction.Hooks{
   294			Observe: func(event transaction.Event) {
   295				probe.mu.Lock()
   296				defer probe.mu.Unlock()
   297				switch event.Point {
   298				case transaction.PointBeforeBackup:
   299					if probe.preimage == nil {
   300						probe.preimage = map[int]bool{}
   301					}
   302					_, err := os.Lstat(event.LivePath)
   303					probe.preimage[event.TargetIndex] = err == nil
   304				case transaction.PointTargetCommitted:
   305					probe.committed = append(probe.committed, event)
   306				case transaction.PointTargetRolledBack:
   307					probe.rolled = append(probe.rolled, event)
   308				}
   309			},
   310			Fault: func(event transaction.Event) error {
   311				probe.mu.Lock()
   312				defer probe.mu.Unlock()
   313				if probe.failErr == nil || probe.failed != nil ||
   314					event.Point != transaction.PointAfterBackup || event.Class != probe.failClass {
   315					return nil
   316				}
   317				probe.failed = &event
   318				return probe.failErr
   319			},
   320		}
   321	}
   322	
   323	func (probe *commitProbe) committedClasses() []string {
   324		probe.mu.Lock()
   325		defer probe.mu.Unlock()
   326		classes := make([]string, 0, len(probe.committed))
   327		for _, event := range probe.committed {
   328			classes = append(classes, event.Class)
   329		}
   330		return classes
   331	}
   332	
   333	// assertReverseRollback proves the restore sequence is the failing target
   334	// followed by every committed target in exact reverse commit order. A target
   335	// that had no prior state is skipped: there is nothing of it to put back.
   336	func (probe *commitProbe) assertReverseRollback(t *testing.T) {
   337		t.Helper()
   338		probe.mu.Lock()
   339		committed := append([]transaction.Event(nil), probe.committed...)
   340		rolled := append([]transaction.Event(nil), probe.rolled...)
   341		preimage := map[int]bool{}
   342		for index, existed := range probe.preimage {
   343			preimage[index] = existed
   344		}
   345		failed := probe.failed
   346		probe.mu.Unlock()
   347	
   348		if failed == nil {
   349			t.Fatal("the injected fault never fired")
   350		}
   351		var want []transaction.Event
   352		if preimage[failed.TargetIndex] {
   353			want = append(want, *failed)
   354		}
   355		for index := len(committed) - 1; index >= 0; index-- {
   356			want = append(want, committed[index])
   357		}
   358		if len(rolled) != len(want) {
   359			t.Fatalf("rolled back %d targets, want %d (the failing target plus %d committed)",
   360				len(rolled), len(want), len(committed))
   361		}
   362		for offset, event := range rolled {
   363			if event.Class != want[offset].Class || event.Identifier != want[offset].Identifier {
   364				t.Fatalf("rollback step %d restored %s/%s, want %s/%s (exact reverse order)",
   365					offset, event.Class, event.Identifier, want[offset].Class, want[offset].Identifier)
   366			}
   367		}
   368	}
   369	
   370	// assertNoJournalRemains proves a failed operation left no durable transaction
   371	// behind. A prepared or committing journal is one recovery would finish, so an
   372	// installation that reported failure must not leave one for the next run.
   373	func assertNoJournalRemains(t *testing.T, home string) {
   374		t.Helper()
   375		root := filepath.Join(home, "state", "transactions", "v1")
   376		entries, err := os.ReadDir(root)
   377		if os.IsNotExist(err) {
   378			return
   379		}
   380		if err != nil {
   381			t.Fatal(err)
   382		}
   383		var remaining []string
   384		for _, entry := range entries {
   385			remaining = append(remaining, entry.Name())
   386		}
   387		if len(remaining) > 0 {
   388			t.Fatalf("a failed installation left transaction journals behind: %v", remaining)
   389		}
   390	}
