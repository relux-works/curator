    92	// contextSources maps each installed skill name to the directory its content
    93	// currently lives in, so an adapter mirror can be staged from the replacement
    94	// this run is about to commit rather than from a canonical path that does not
    95	// hold it yet. A skill that is already current keeps its live directory.
    96	func contextSources(plan staging.Plan, store string, names []string) map[string]string {
    97		staged := map[string]string{}
    98		for _, target := range plan.Targets {
    99			if target.Class == staging.ClassContext && filepath.Dir(target.LivePath) == store {
   100				staged[filepath.Base(target.LivePath)] = target.StagedPath
   101			}
   102		}
   103		sources := make(map[string]string, len(names))
   104		for _, name := range names {
   105			if replacement, found := staged[name]; found {
   106				sources[name] = replacement
   107				continue
   108			}
   109			sources[name] = filepath.Join(store, name)
   110		}
   111		return sources
   112	}
