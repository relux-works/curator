    39	// Options control one installation run.
    40	type Options struct {
    41		DryRun       bool
    42		Fetch        bool
    43		FixGitignore bool
    44		StrictTags   bool
    45		Verbose      bool
    46		Platform     string // "" resolves to the current platform
    47		// FetchedRepos deduplicates closure-scoped upgrades across selected
    48		// projects. Callers may leave it nil for a single installation.
    49		FetchedRepos map[string]bool
    50		// Context bounds toolchain probing and compilation. Nil means background.
    51		Context context.Context
    52		// Build injects the narrow toolchain, protected-cache, builder, clock, and
    53		// generation-read boundaries. The zero value resolves the real ones.
    54		Build BuildDeps
    55		// Commit injects the manager locks, transaction journal, cache publisher,
    56		// and post-commit collector of the serialized commit phase, plus the fault
    57		// hooks a rollback test drives. The zero value resolves the real ones.
    58		Commit CommitDeps
    59		// OnStaged observes the operation-private staging result after every build
    60		// succeeded and before the plan releases it. Publishing staged outputs to
    61		// the protected cache and to live installation targets belongs to the
    62		// atomic commit phase, not to this one.
    63		OnStaged func(Staged) error
    64		// Hooks for later phases. Each may be nil.
    65		VerifyMcp     func(nodes []*closure.Node) (map[string]map[string][]string, []string, error)
    66		AuditGate     func(nodes []*closure.Node) (warnings []string, errs []string)
    67		ResolveAttest func(nodes []*closure.Node) (map[string]*marker.Attestation, []string, error)
    68	}
