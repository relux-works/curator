    28	// onStagedOnce returns an OnStaged hook that applies change during the first
    29	// attempt only, so the restarted attempt sees the settled state.
    30	func onStagedOnce(change func() error) func(Staged) error {
    31		applied := false
    32		return func(Staged) error {
    33			if applied {
    34				return nil
    35			}
    36			applied = true
    37			return change()
    38		}
    39	}
