    24	// GlobalRoot returns the global scope directory under the machine home.
    25	func GlobalRoot(home string) string { return filepath.Join(home, "global") }
    26	
    27	// Global installs the machine-wide scope: the global Skillfile into
    28	// global/skills with shims in global/bin and home-level adapters
    29	// (Spec §9.2). userHome receives the adapter mirrors.
    30	//
    31	// The lifecycle matches Project: the global root is the canonical operation
    32	// identity, incomplete journals are recovered before any network or compiler
    33	// work, and every shared target is published through one manager-home-locked
    34	// transaction. The global scope registers no runtime consumer, so its commit
    35	// carries no consumer-ledger class.
    36	func Global(cfg *config.Config, userHome string, opts Options) Result {
    37		if opts.DryRun {
    38			result, _ := globalAttempt(cfg, userHome, opts, CommitDeps{})
    39			return result
    40		}
    41		commit, err := opts.Commit.resolve(cfg.Home(), opts.Build.Cache)
    42		if err != nil {
    43			return failedResult("global", GlobalRoot(cfg.Home()), err)
    44		}
    45		ctx := opts.context()
    46		locks, err := commit.Locks.AcquireProjects(ctx, GlobalRoot(cfg.Home()))
    47		if err != nil {
    48			return failedResult("global", GlobalRoot(cfg.Home()),
    49				fmt.Errorf("acquire the global operation lock: %w", err))
    50		}
    51		defer func() { _ = locks.Close() }()
    52		if err := recoverJournals(ctx, commit); err != nil {
    53			return failedResult("global", GlobalRoot(cfg.Home()), err)
    54		}
    55		return runWithRestarts("global", commit, func() (Result, *restartError) {
    56			return globalAttempt(cfg, userHome, opts, commit)
    57		})
    58	}
