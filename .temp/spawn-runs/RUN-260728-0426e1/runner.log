   251	func (engine *Engine) abortPreparation(journal *Journal, cause error) error {
   252		if journal.Phase == PhasePreparing {
   253			if err := engine.discardPreparing(journal); err != nil {
   254				return errors.Join(cause, err)
   255			}
   256			return cause
   257		}
   258		journal.Phase = PhaseRollingBack
   259		if err := engine.saveJournal(journal); err != nil {
   260			return errors.Join(cause, err)
   261		}
   262		if err := engine.rollback(journal); err != nil {
   263			return errors.Join(cause, err)
   264		}
   265		return cause
   266	}
