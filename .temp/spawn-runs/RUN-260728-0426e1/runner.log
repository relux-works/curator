    15	// Engine owns journals beneath one manager home. It does not acquire locks;
    16	// every mutating or journal-reading entry point requires the caller's witness.
    17	type Engine struct {
    18		mu               sync.Mutex
    19		journalRoot      string
    20		hooks            Hooks
    21		syncStagedParent func(string) error
    22	}
    23	
    24	// New constructs an engine without creating manager-home state.
    25	func New(home string, options ...Option) (*Engine, error) {
    26		if home == "" {
    27			return nil, fmt.Errorf("manager home is empty")
    28		}
    29		absolute, err := filepath.Abs(home)
    30		if err != nil {
    31			return nil, err
    32		}
    33		engine := &Engine{
    34			journalRoot:      filepath.Join(filepath.Clean(absolute), "state", "transactions", "v1"),
    35			syncStagedParent: syncDirectory,
    36		}
    37		for _, option := range options {
    38			if option != nil {
    39				option(engine)
    40			}
    41		}
    42		return engine, nil
    43	}
