    22	// HomeLock is the exclusive manager-home mutation witness. It is held from
    23	// revalidation through commit, rollback, and post-commit maintenance, so no
    24	// other project can publish a cache entry or swap a shared target in between.
    25	type HomeLock interface {
    26		AssertHeld() error
    27		Close() error
    28	}
    29	
    30	// ProjectLocks is the canonical project operation lock set of one run. It is
    31	// acquired before planning and released only after the whole handoff.
    32	type ProjectLocks interface {
    33		Close() error
    34	}
    35	
    36	// LockBroker is the narrow locking boundary of a real installation.
    37	//
    38	// AcquireHome is deliberately allowed more than once per run: an operation
    39	// takes the home lock briefly for journal recovery, releases it before any
    40	// network, audit, fingerprinting, or compilation work, and takes it again for
    41	// the serialized commit. A restart adds further acquisitions.
    42	type LockBroker interface {
    43		AcquireProjects(ctx context.Context, projects ...string) (ProjectLocks, error)
    44		AcquireHome(ctx context.Context) (HomeLock, error)
    45	}
    46	
    47	// TargetJournal is the durable transaction boundary that owns every live swap.
    48	type TargetJournal interface {
    49		Recover(lock transaction.HomeLock) error
    50		Prepare(lock transaction.HomeLock, plan transaction.Plan) (*transaction.Journal, error)
    51		Commit(lock transaction.HomeLock, transactionID string) error
    52	}
    53	
    54	// CachePublisher publishes verified private builds into the protected
    55	// immutable build cache and re-reads the result. It never adopts or repairs
    56	// foreign bytes.
    57	//
    58	// Publication and verification are deliberately the same boundary. The planning
    59	// inspector runs before the home lock against whatever the cache looked like
    60	// then; only the store that just published can say whether the entry a launcher
    61	// is about to point at is protected right now.
    62	type CachePublisher interface {
    63		Inspect(expect buildcache.Expectation) buildcache.Result
    64		Publish(publication buildcache.Publication, lock buildcache.HomeLock) (buildcache.PublicationResult, error)
    65	}
    66	
    67	// CommitDeps injects the serialized publication and commit boundaries. The
    68	// zero value resolves the real manager locks, transaction engine, protected
    69	// cache publisher, and runtime collector.
    70	type CommitDeps struct {
    71		Locks     LockBroker
    72		Journal   TargetJournal
    73		Publisher CachePublisher
    74		// Collect runs the post-commit maintenance sweep. A failure is a reported
    75		// warning: the installation is already durable.
    76		Collect func(home string) ([]string, error)
    77		// Hooks inject faults at transaction boundaries so a test can prove that a
    78		// failure at any target class restores the prior state in reverse order.
    79		Hooks transaction.Hooks
    80		// PublishFault injects a failure at cache publication.
    81		PublishFault func(buildmeta.CacheKey) error
    82		// NewTransactionID names one journal; the default is random.
    83		NewTransactionID func() (string, error)
    84		// MaxRestarts bounds the revalidation restart loop. Zero means the default.
    85		MaxRestarts int
    86	}
    87	
    88	// defaultMaxRestarts bounds how often concurrent shared-state changes may push
    89	// one operation back to an earlier planning step before it reports the churn
    90	// instead of looping. Restarting is always preferable to applying a stale plan,
    91	// but an unbounded loop would hide a livelock.
    92	const defaultMaxRestarts = 3
    93	
    94	// resolve fills every unset boundary with its real implementation.
    95	//
    96	// inspector is the protected-cache boundary planning already read through. When
    97	// it can publish — the real store can — it becomes the publisher too, so the
    98	// commit phase publishes and re-reads through exactly one cache boundary
    99	// instead of two that could disagree about the same home.
   100	func (deps CommitDeps) resolve(home string, inspector CacheInspector) (CommitDeps, error) {
   101		if deps.Locks == nil {
   102			manager, err := managerlock.New(home)
   103			if err != nil {
   104				return CommitDeps{}, fmt.Errorf("open manager locks: %w", err)
   105			}
   106			deps.Locks = &managerLocks{manager: manager}
   107		}
   108		if deps.Journal == nil {
   109			engine, err := transaction.New(home, transaction.WithHooks(deps.Hooks))
   110			if err != nil {
   111				return CommitDeps{}, fmt.Errorf("open the install transaction journal: %w", err)
   112			}
   113			deps.Journal = engine
   114		}
   115		if deps.Publisher == nil {
   116			if publisher, capable := inspector.(CachePublisher); capable && publisher != nil {
   117				deps.Publisher = publisher
   118			} else {
   119				store, err := buildcache.New(home)
   120				if err != nil {
   121					return CommitDeps{}, fmt.Errorf("open protected build cache: %w", err)
   122				}
   123				deps.Publisher = store
   124			}
   125		}
   126		if deps.Collect == nil {
   127			deps.Collect = scopes.CollectRuntime
   128		}
   129		if deps.NewTransactionID == nil {
   130			deps.NewTransactionID = randomTransactionID
   131		}
   132		if deps.MaxRestarts <= 0 {
   133			deps.MaxRestarts = defaultMaxRestarts
   134		}
   135		return deps, nil
   136	}
   137	
   138	// managerLocks adapts the cross-platform manager locks to the narrow broker.
   139	//
   140	// Project locks come from one ordered operation that lives for the whole run.
   141	// Home locks go through the manager's recovery-path acquisition instead of the
   142	// operation, because an operation may hold the home lock only once and this
   143	// lifecycle needs it for recovery, for the commit, and again after a restart.
   144	// The class ordering rule still holds: the project locks are already held, and
   145	// no project or key lock is ever taken while the home lock is held.
   146	type managerLocks struct {
   147		manager   *managerlock.Manager
   148		operation *managerlock.Operation
   149	}
   150	
   151	func (locks *managerLocks) AcquireProjects(ctx context.Context, projects ...string) (ProjectLocks, error) {
   152		operation := locks.manager.NewOperation(false)
   153		if _, err := operation.AcquireProjects(ctx, projects...); err != nil {
   154			return nil, errors.Join(err, operation.Close())
   155		}
   156		locks.operation = operation
   157		return operation, nil
   158	}
   159	
   160	func (locks *managerLocks) AcquireHome(ctx context.Context) (HomeLock, error) {
   161		return locks.manager.AcquireHomeOnly(ctx, false)
   162	}
