   268	// Commit resumes a prepared or interrupted commit by id. Any ordinary commit
   269	// failure durably switches the journal to rollback before restoring targets.
   270	func (engine *Engine) Commit(lock HomeLock, transactionID string) error {
   271		if err := requireHomeLock(lock); err != nil {
   272			return err
   273		}
   274		engine.mu.Lock()
   275		defer engine.mu.Unlock()
   276		journal, err := engine.loadJournal(transactionID)
   277		if err != nil {
   278			return err
   279		}
   280		return engine.resume(journal)
   281	}
   282	
   283	// Recover processes every journal in unsigned transaction-id order. Recovery
   284	// is home-scoped and intentionally does not accept a current project filter.
   285	func (engine *Engine) Recover(lock HomeLock) error {
   286		if err := requireHomeLock(lock); err != nil {
   287			return err
   288		}
   289		engine.mu.Lock()
   290		defer engine.mu.Unlock()
   291		ids, err := engine.journalIDs()
   292		if err != nil {
   293			return err
   294		}
   295		for _, id := range ids {
   296			journal, err := engine.loadJournal(id)
   297			if err != nil {
   298				return err
   299			}
   300			if err := engine.resume(journal); err != nil {
   301				return fmt.Errorf("recover transaction %s: %w", id, err)
   302			}
   303		}
   304		return nil
   305	}
