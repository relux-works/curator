    41	// assertClosureRestart proves the run reported a closure-resolution restart and
    42	// named the exact observation that moved.
    43	func assertClosureRestart(t *testing.T, result Result, key string) {
    44		t.Helper()
    45		if result.Status != "ok" {
    46			t.Fatalf("install failed: %+v", result)
    47		}
    48		if !hasMessageContaining(result.Messages, "restarting from closure resolution") {
    49			t.Fatalf("a %s change did not restart closure resolution; messages = %v", key, result.Messages)
    50		}
    51		if !hasMessageContaining(result.Messages, "generation of "+key+" changed") {
    52			t.Fatalf("the restart did not name %s; messages = %v", key, result.Messages)
    53		}
    54	}
