   352	// stageGlobalTargets derives the complete desired machine-wide state under the
   353	// manager-home lock, including the safe user-bin forwarding mirror.
   354	func stageGlobalTargets(request globalTargetRequest) (scopeTargets, error) {
   355		var targets scopeTargets
   356		stageRoot := request.scoped.stageRoot
   357	
   358		runtime, err := stageRuntimeAndShims(
   359			stageRoot, request.home, request.binDir, request.nodes,
   360			runtimestore.GlobalCanonicalShim, request.platform, request.scoped, request.plan.plannedInputs(),
   361		)
   362		if err != nil {
   363			return scopeTargets{}, err
   364		}
   365		targets.plan.Merge(runtime.plan)
   366		targets.referencedKeys = runtime.referencedKeys()
   367	
   368		expectedSkills := map[string]bool{}
   369		var contextNames []string
   370		for _, node := range request.nodes {
   371			expectedSkills[node.Name] = true
   372			expected := buildMarker(node, request.effectiveLocale, request.agents, node.ActiveCommandNames(),
   373				request.mcpFound[node.Name], request.attestations[node.Name],
   374				runtime.builds[node.Name], request.plan.sourceIdentity(node.Name))
   375			nodePlan, status, err := stageNode(stageRoot, nodeInstall{
   376				node: node, store: request.skillsDir, kind: "global",
   377				locale: request.effectiveLocale, agents: request.agents, expected: expected,
   378			}, request.deps.Clock)
   379			if err != nil {
   380				return scopeTargets{}, fmt.Errorf("%s: %w", node.Name, err)
   381			}
   382			targets.plan.Merge(nodePlan)
   383			if node.ContextActive() {
   384				contextNames = append(contextNames, node.Name)
   385			}
   386			targets.messages = append(targets.messages, fmt.Sprintf("global: %s %s", nodeSummary(node), status))
   387		}
   388	
   389		staleSkills, err := stageStaleSkillRemovals(request.skillsDir, "global", expectedSkills)
   390		if err != nil {
   391			return scopeTargets{}, err
   392		}
   393		targets.plan.Merge(staleSkills)
   394	
   395		forwarding, err := globalbins.StageForwarding(
   396			stageRoot, request.home, runtime.commands, request.platform, nil, request.userHome)
   397		if err != nil {
   398			return scopeTargets{}, err
   399		}
   400		targets.plan.Merge(forwarding.Plan())
   401		targets.messages = append(targets.messages, forwarding.Messages...)
   402	
   403		envPlan, err := envfiles.StageGlobal(stageRoot, request.home)
   404		if err != nil {
   405			return scopeTargets{}, err
   406		}
   407		targets.plan.Merge(envPlan)
   408	
   409		sort.Strings(contextNames)
   410		mirror, err := adapters.StageGlobal(
   411			stageRoot, request.home, request.userHome, request.agents, contextNames, request.cfg.AdapterMode,
   412			contextSources(targets.plan, request.skillsDir, contextNames))
   413		if err != nil {
   414			return scopeTargets{}, err
   415		}
   416		targets.plan.Merge(mirror.Plan())
   417		for _, message := range mirror.Messages {
   418			targets.messages = append(targets.messages, "global: "+message)
   419		}
   420		return targets, nil
   421	}
