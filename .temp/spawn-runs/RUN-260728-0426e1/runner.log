   423	// GlobalInit creates an empty global Skillfile.
   424	func GlobalInit(home string) (string, error) {
   425		root := GlobalRoot(home)
   426		if err := os.MkdirAll(root, 0o755); err != nil {
   427			return "", err
   428		}
   429		return manifest.EnsureEmpty(root)
   430	}

