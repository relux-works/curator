   172	// restartStep names the earliest phase a stale observation invalidates. Larger
   173	// values are earlier phases, so combining reasons takes the maximum.
   174	type restartStep int
   175	
   176	const (
   177		restartNone restartStep = iota
   178		// restartTargets re-derives the staged target set: a target owner or
   179		// expected preimage moved under us.
   180		restartTargets
   181		// restartPlan re-derives the build plan: cache trust or a required build
   182		// key changed, so the planned reuse verdict no longer holds.
   183		restartPlan
   184		// restartClosure re-resolves the closure: an installed generation changed,
   185		// so closure or activation input may differ.
   186		restartClosure
   187	)
   188	
   189	func (step restartStep) String() string {
   190		switch step {
   191		case restartTargets:
   192			return "target staging"
   193		case restartPlan:
   194			return "build planning"
   195		case restartClosure:
   196			return "closure resolution"
   197		default:
   198			return "none"
   199		}
   200	}
   201	
   202	// restartError reports that shared state changed while the operation held no
   203	// home lock. The staged plan is discarded rather than applied.
   204	type restartError struct {
   205		step    restartStep
   206		reasons []string
   207	}
   208	
   209	func (err *restartError) Error() string {
   210		return fmt.Sprintf("shared state changed; restarting from %s: %s", err.step, strings.Join(err.reasons, "; "))
   211	}
