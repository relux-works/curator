   322	func (engine *Engine) commit(journal *Journal) error {
   323		if journal.Phase == PhasePrepared {
   324			journal.Phase = PhaseCommitting
   325			if err := engine.saveJournal(journal); err != nil {
   326				return err
   327			}
   328		}
   329		for index := range journal.Targets {
   330			if err := engine.commitTarget(journal, index); err != nil {
   331				journal.Phase = PhaseRollingBack
   332				if saveErr := engine.saveJournal(journal); saveErr != nil {
   333					return errors.Join(err, saveErr)
   334				}
   335				return errors.Join(err, engine.rollback(journal))
   336			}
   337		}
   338		journal.Phase = PhaseCleanup
   339		if err := engine.saveJournal(journal); err != nil {
   340			return err
   341		}
   342		if err := engine.emit(journal, -1, PointBeforeCleanup); err != nil {
   343			return err
   344		}
   345		return engine.cleanupCommitted(journal)
   346	}
