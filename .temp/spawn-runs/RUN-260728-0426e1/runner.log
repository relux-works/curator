   213	// The optimistic observation keys of the declaration inputs a closure is
   214	// resolved from. Each names a file that decides *what* an operation installs and
   215	// that some supported Curator command rewrites while holding none of this run's
   216	// locks, so a change to any of them restarts closure resolution rather than
   217	// committing the closure that was planned.
   218	const (
   219		// hybridActivationKey is the machine-home hybrid activation manifest,
   220		// rewritten by `curator hybrid add|rm`.
   221		hybridActivationKey = "activation/hybrid-manifest"
   222		// projectManifestKey is the project Skillfile, rewritten by
   223		// `curator add|remove`.
   224		projectManifestKey = "manifest/project"
   225		// globalManifestKey is the machine-wide Skillfile under GlobalRoot,
   226		// rewritten by `curator global add|remove`.
   227		globalManifestKey = "manifest/global"
   228		// substitutionsKey is the project development substitution manifest. No
   229		// Curator command writes it — it is edited by hand — but it redirects a
   230		// declaration at a local checkout or another ref, so it selects installed
   231		// content exactly like the manifest does.
   232		substitutionsKey = "substitutions/project"
   233	)
   234	
   235	// observations are the optimistic generation digests captured while the
   236	// operation held no home lock (Spec §6.1 step 6). They are not commit
   237	// authority: every one is re-read under the home lock in step 10, and a
   238	// difference restarts the earliest affected step instead of applying the plan.
   239	//
   240	// The set has to cover every closure or activation input a phase read outside
   241	// the home lock and could not otherwise prove stable. Each input below is
   242	// classified by who can actually write it, not by which directory it sits in:
   243	// the canonical project operation lock is a witness only against writers that
   244	// take it, and the manifest-editing commands do not.
   245	//
   246	//   - The project manifest is observed (projectManifestKey). It lives in the
   247	//     checkout, but `curator add|remove` rewrites it through manifest.AddDecl
   248	//     and manifest.RemoveDecl without taking any operation lock, so being in
   249	//     the locked checkout proves nothing about it.
   250	//   - The machine-wide manifest is observed (globalManifestKey). Same reason:
   251	//     it lives under GlobalRoot(home), which is the global scope's own
   252	//     operation identity, but `curator global add|remove` writes it lock-free.
   253	//   - The project development substitution manifest is observed
   254	//     (substitutionsKey). It has no Curator writer at all — it is edited by
   255	//     hand — and it redirects a declaration at a local checkout or another ref,
   256	//     so it selects installed content and also drives the strict-audit refusal.
   257	//   - The machine-home hybrid activation manifest is observed
   258	//     (hybridActivationKey): `curator hybrid add|rm` rewrites it under no lock
   259	//     at all, so it can move at any moment during an install.
   260	//   - Installed markers of every closure node, in the project, hybrid, and
   261	//     global stores, are observed one key each.
   262	//   - Protected build-cache verdicts are observed per planned build as
   263	//     outcomes, and re-derived through the publishing store itself.
   264	//   - Every staged target's preimage is digested under the home lock inside
   265	//     journalPlan, so target owners and preimages need no optimistic key.
   266	//   - The managed .gitignore is deliberately *not* observed, and no lock is
   267	//     claimed over it either: `curator init` appends to it and this operation
   268	//     rewrites it itself when --fix-gitignore is set. It is a hygiene
   269	//     precondition rather than a closure input — its content selects nothing
   270	//     that gets installed — so a concurrent edit cannot make this run commit
   271	//     the wrong closure, and the next run re-runs the gate. Observing a file
   272	//     the run itself writes would only manufacture restart loops.
   273	//   - Skill snapshots are commit-addressed and written once, so the tree the
   274	//     closure resolved cannot change underneath the run. A tag that moves after
   275	//     resolution leaves this operation committing the commit it pinned, which
   276	//     is a complete and self-consistent installation; the next run resolves the
   277	//     new commit and the moved-tag gate reports it. This covers a development
   278	//     substitution too: a local checkout is resolved to a concrete HEAD commit
   279	//     and snapshotted under that commit like any other source, so only the
   280	//     substitution manifest above — which one it points at — needs observing.
   281	//   - Registry attestations and MCP verification results are resolved before
   282	//     the home lock and recorded into the marker this run commits. They select
   283	//     nothing: the closure is already resolved when they run, and each is
   284	//     evidence of what this operation found. A registry or agent configuration
   285	//     that changes afterwards leaves this run committing the evidence it
   286	//     pinned, exactly like a snapshot, and the next run records the new state.
   287	//   - The audit trust state under the manager home is a gate on the resolved
   288	//     closure, not an input to it: it can refuse an installation but cannot
   289	//     change which skills it contains. No lock is claimed over it — `curator
   290	//     audit pin` writes an approval outside any operation — and an approval
   291	//     revoked after the gate ran leaves a complete installation the next run's
   292	//     gate refuses. The gate memoizes its own verdicts beside that state; that
   293	//     cache is derived from content hashes and is not an installation target.
   294	//   - The user configuration is loaded once by the process entrypoint and
   295	//     passed through as one immutable value, so every phase of the run — and
   296	//     every restart attempt — reads the same snapshot and the run is internally
   297	//     consistent. Observing it would not help: a restart re-reads no
   298	//     configuration, so a concurrent edit could only turn into a restart loop.
   299	//     Picking up a mid-run configuration edit needs per-attempt reloading,
   300	//     which is a separate decision from this revalidation contract.
   301	type observations struct {
   302		// generations maps a canonical shared-state key to its digest at read time.
   303		generations map[string]string
   304		// paths maps the same key to the path to re-read under the home lock. It is
   305		// written by observe alone, so an observation can never be captured without
   306		// the location that revalidates it.
   307		paths map[string]string
   308		// outcomes maps one planned build to the protected-cache verdict planning
   309		// took for it.
   310		outcomes map[string]BuildOutcome
   311	}
   312	
   313	func newObservations() *observations {
   314		return &observations{
   315			generations: map[string]string{},
   316			paths:       map[string]string{},
   317			outcomes:    map[string]BuildOutcome{},
   318		}
   319	}
   320	
   321	// observe records the current digest of one consulted shared path.
   322	func (observed *observations) observe(key, path string) {
   323		if observed == nil {
   324			return
   325		}
   326		digest, err := transaction.DigestPath(path)
   327		if err != nil {
   328			// An unreadable or unsafe preimage is itself a stable observation: the
   329			// recheck reproduces the same marker and only a change restarts.
   330			digest = "unreadable:" + err.Error()
   331		}
   332		observed.generations[key] = digest
   333		observed.paths[key] = path
   334	}
   335	
   336	// recheck re-reads every observation and reports the earliest affected step.
   337	func (observed *observations) recheck(plan BuildPlan, inspect CacheInspector) *restartError {
   338		if observed == nil {
   339			return nil
   340		}
   341		step := restartNone
   342		var reasons []string
   343		keys := make([]string, 0, len(observed.generations))
   344		for key := range observed.generations {
   345			keys = append(keys, key)
   346		}
   347		sort.Strings(keys)
   348		for _, key := range keys {
   349			before := observed.generations[key]
   350			digest, err := transaction.DigestPath(observed.paths[key])
   351			if err != nil {
   352				digest = "unreadable:" + err.Error()
   353			}
   354			if digest != before {
   355				step = maxRestart(step, restartClosure)
   356				reasons = append(reasons, fmt.Sprintf("generation of %s changed", key))
   357			}
   358		}
   359		for _, build := range plan.builds {
   360			recorded, seen := observed.outcomes[build.skill+"."+build.command]
   361			if !seen {
   362				continue
   363			}
   364			current := BuildOutcome(inspect.Inspect(buildcache.Expectation{Input: build.input}).DryRunOutcome())
   365			// A miss that became a hit is another publisher's identical winner and
   366			// is safe to adopt. Any other transition invalidates the planned reuse.
   367			if current == recorded || (recorded.buildable() && current == BuildCacheHit) {
   368				continue
   369			}
   370			step = maxRestart(step, restartPlan)
   371			reasons = append(reasons, fmt.Sprintf("cache trust for %s.%s changed from %s to %s",
   372				build.skill, build.command, recorded, current))
   373		}
   374		if step == restartNone {
   375			return nil
   376		}
   377		return &restartError{step: step, reasons: reasons}
   378	}
   379	
   380	func maxRestart(left, right restartStep) restartStep {
   381		if right > left {
   382			return right
   383		}
   384		return left
   385	}
   386	
   387	// commitRequest is everything the serialized publication and commit phase needs
   388	// from one scope.
   389	type commitRequest struct {
   390		scope string
   391		home  string
   392		// projectRoot is the checkout this run registers as a runtime consumer.
   393		// The global scope leaves it empty and writes no consumer ledger.
   394		projectRoot string
   395		deps        BuildDeps
   396		commit      CommitDeps
   397		plan        BuildPlan
   398		staged      Staged
   399		observed    *observations
   400		// stageTargets derives the complete staged target set of the scope. It runs
   401		// under the home lock, after recovery, revalidation, and cache publication,
   402		// so every shared ledger it merges is read from committed state.
   403		stageTargets func(scopeCommit) (scopeTargets, error)
   404	}
   405	
   406	// scopeCommit is the home-locked context a scope stages its targets in.
   407	type scopeCommit struct {
   408		stageRoot string
   409		// artifacts maps every planned build key to its protected cache entry.
   410		artifacts map[buildmeta.CacheKey]buildcache.Result
   411	}
   412	
   413	// scopeTargets is the staged result of one scope. Every live change of the
   414	// scope is in the plan: there is deliberately no side channel for state the
   415	// journal cannot own, so nothing mutates between preparation and commit and an
   416	// ordinary failure always enters durable rollback.
   417	type scopeTargets struct {
   418		plan     staging.Plan
   419		messages []string
   420		// referencedKeys are the build keys the committed markers depend on, so GC
   421		// retains them while this transaction is in flight.
   422		referencedKeys []string
   423	}
   424	
   425	// commitOutcome reports what the serialized phase changed.
   426	type commitOutcome struct {
   427		messages []string
   428		warnings []string
   429	}
   430	
   431	// recoverJournals takes the home lock briefly, resumes every incomplete
   432	// transaction, and releases it again before any network, audit, fingerprinting,
   433	// or compilation work (Spec §6.1 step 1).
   434	func recoverJournals(ctx context.Context, deps CommitDeps) error {
   435		lock, err := deps.Locks.AcquireHome(ctx)
   436		if err != nil {
   437			return fmt.Errorf("acquire the manager-home lock for recovery: %w", err)
   438		}
   439		recoverErr := deps.Journal.Recover(lock)
   440		closeErr := lock.Close()
   441		if recoverErr != nil {
   442			return fmt.Errorf("recover incomplete install transactions: %w", errors.Join(recoverErr, closeErr))
   443		}
   444		if closeErr != nil {
   445			return fmt.Errorf("release the manager-home lock after recovery: %w", closeErr)
   446		}
   447		return nil
   448	}
   449	
   450	// runCommit is the serialized publication and commit phase (Spec §6.1 steps
   451	// 10-14). It holds the manager-home mutation lock from revalidation through
   452	// rollback and post-commit maintenance.
   453	func runCommit(ctx context.Context, request commitRequest) (outcome commitOutcome, err error) {
   454		lock, err := request.commit.Locks.AcquireHome(ctx)
   455		if err != nil {
   456			return commitOutcome{}, fmt.Errorf("acquire the manager-home lock: %w", err)
   457		}
   458		defer func() {
   459			if closeErr := lock.Close(); closeErr != nil && err == nil {
   460				err = fmt.Errorf("release the manager-home lock: %w", closeErr)
   461			}
   462		}()
   463	
   464		// Recovery completes before this operation mutates anything.
   465		if err := request.commit.Journal.Recover(lock); err != nil {
   466			return commitOutcome{}, fmt.Errorf("recover incomplete install transactions: %w", err)
   467		}
   468	
   469		// Revalidate every optimistic observation. A stale closure, activation,
   470		// cache trust, target owner, preimage, or required key restarts.
   471		if restart := request.observed.recheck(request.plan, request.deps.Cache); restart != nil {
   472			return commitOutcome{}, restart
   473		}
   474	
   475		stageRoot, err := os.MkdirTemp("", operationPrivatePrefix+"commit-")
   476		if err != nil {
   477			return commitOutcome{}, fmt.Errorf("create the commit staging root: %w", err)
   478		}
   479		defer func() {
   480			if removeErr := os.RemoveAll(stageRoot); removeErr != nil {
   481				outcome.warnings = append(outcome.warnings,
   482					fmt.Sprintf("%s: could not remove the commit staging root: %v", request.scope, removeErr))
   483			}
   484		}()
   485	
   486		artifacts, publishMessages, err := publishWinners(request, lock)
   487		if err != nil {
   488			return commitOutcome{}, err
   489		}
   490		outcome.messages = append(outcome.messages, publishMessages...)
   491	
   492		targets, err := request.stageTargets(scopeCommit{stageRoot: stageRoot, artifacts: artifacts})
   493		if err != nil {
   494			return commitOutcome{}, err
   495		}
   496		outcome.messages = append(outcome.messages, targets.messages...)
   497	
   498		if request.projectRoot != "" {
   499			consumer, err := scopes.StageConsumer(stageRoot, request.home, request.projectRoot)
   500			if err != nil {
   501				return commitOutcome{}, err
   502			}
   503			targets.plan.Merge(consumer)
   504		}
   505		if err := targets.plan.Validate(); err != nil {
   506			return commitOutcome{}, err
   507		}
   508		if targets.plan.Empty() {
   509			outcome.warnings = append(outcome.warnings, collectAfterCommit(request)...)
   510			return outcome, nil
   511		}
   512	
   513		// A target below a directory that does not exist yet needs that directory
   514		// before the journal can place its sidecars. Those directories are not
   515		// journaled targets, so an abandoned commit has to unwind them itself;
   516		// otherwise a rolled-back installation would leave an empty runtime or
   517		// skills tree behind and the restored state would not be the prior one.
   518		journalPlan, created, planErr := journalPlan(request, targets)
   519		committed := false
   520		defer func() {
   521			if !committed {
   522				removeCreatedDirectories(created)
   523			}
   524		}()
   525		if planErr != nil {
   526			return commitOutcome{}, planErr
   527		}
   528		// Preparation is immediately followed by the commit. Nothing may run in
   529		// between: a prepared journal is a transaction recovery will finish, so an
   530		// operation that returned failed must never leave one behind.
   531		if _, err := request.commit.Journal.Prepare(lock, journalPlan); err != nil {
   532			return commitOutcome{}, fmt.Errorf("prepare the install transaction: %w", err)
   533		}
   534		if err := request.commit.Journal.Commit(lock, journalPlan.TransactionID); err != nil {
   535			return commitOutcome{}, fmt.Errorf("commit the install transaction: %w", err)
   536		}
   537		committed = true
   538		outcome.warnings = append(outcome.warnings, collectAfterCommit(request)...)
   539		return outcome, nil
   540	}
   541	
   542	// collectAfterCommit runs the maintenance sweep while the home lock is still
   543	// held. A failure is reported and never reverts the durable installation
   544	// (Spec §6.1 step 14).
   545	func collectAfterCommit(request commitRequest) []string {
   546		if request.commit.Collect == nil {
   547			return nil
   548		}
   549		if _, err := request.commit.Collect(request.home); err != nil {
   550			return []string{fmt.Sprintf("%s: warning: post-install maintenance failed: %v", request.scope, err)}
   551		}
   552		return nil
   553	}
   554	
   555	// publishWinners publishes every verified staged build and re-reads the
   556	// protected entry of every planned command. A published duplicate of an
   557	// identical existing winner is discarded rather than merged, and a key that
   558	// still does not resolve after publication restarts build planning.
   559	func publishWinners(request commitRequest, lock HomeLock) (map[buildmeta.CacheKey]buildcache.Result, []string, error) {
   560		var messages []string
   561		for _, build := range request.staged.builds {
   562			if request.commit.PublishFault != nil {
   563				if err := request.commit.PublishFault(build.key); err != nil {
   564					return nil, nil, fmt.Errorf("publish %s.%s: %w", build.skill, build.command, err)
   565				}
   566			}
   567			receiptBytes, err := build.receipt.CanonicalBytes()
   568			if err != nil {
   569				return nil, nil, fmt.Errorf("encode the receipt of %s.%s: %w", build.skill, build.command, err)
   570			}
   571			result, err := request.commit.Publisher.Publish(buildcache.Publication{
   572				Input:          build.receipt.Input,
   573				ReceiptBytes:   receiptBytes,
   574				ArtifactSource: build.path,
   575			}, lock)
   576			if err != nil {
   577				return nil, nil, fmt.Errorf("publish %s.%s: %w", build.skill, build.command, err)
   578			}
   579			messages = append(messages, fmt.Sprintf("%s: %s.%s cache %s key=%s",
   580				request.scope, build.skill, build.command, result.Status, build.key))
   581		}
   582	
   583		artifacts := map[buildmeta.CacheKey]buildcache.Result{}
   584		var missing []string
   585		for _, build := range request.plan.builds {
   586			inspection := request.commit.Publisher.Inspect(buildcache.Expectation{Input: build.input})
   587			if inspection.Status != buildcache.Hit {
   588				missing = append(missing, fmt.Sprintf("%s.%s (%s)", build.skill, build.command, inspection.Status))
   589				continue
   590			}
   591			artifacts[build.key] = inspection
   592		}
   593		if len(missing) > 0 {
   594			return nil, nil, &restartError{
   595				step:    restartPlan,
   596				reasons: []string{"required build keys are not protected after publication: " + strings.Join(missing, ", ")},
   597			}
   598		}
   599		return artifacts, messages, nil
   600	}
