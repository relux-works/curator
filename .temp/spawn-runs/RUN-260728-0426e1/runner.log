    18	
    19	// sweepScenario is one complete installation shape the fault sweep walks. Each
    20	// builds a baseline, then upgrades it so the second commit carries every
    21	// deterministic class the scope can produce.
    22	type sweepScenario struct {
    23		name string
    24		mode string
    25		// classes are the classes this scenario must actually commit; a scenario
    26		// that stops producing one silently would otherwise weaken the sweep.
    27		classes []string
    28		// baseline installs the prior state the rollback has to restore.
    29		baseline func(t *testing.T, e *env)
    30		// upgrade changes the declarations so the second install replaces context,
    31		// adds new state, and drops managed state that must be removed.
    32		upgrade func(t *testing.T, e *env)
    33		// install runs one installation of this scenario's scope.
    34		install func(e *env, opts install.Options) install.Result
    35		// sharedUserHome binds the scenario to the PATH-visible user home the
    36		// parent prepared. Only the machine-wide scope mirrors into one, and two
    37		// scenarios must never share it: their snapshots would overlap.
    38		sharedUserHome bool
    39	}
    40	
    41	func projectSweepScenario(name, mode string) sweepScenario {
    42		return sweepScenario{
    43			name:    name,
    44			mode:    mode,
    45			classes: projectSweepClasses,
    46			baseline: func(t *testing.T, e *env) {
    47				t.Helper()
    48				e.skill("skill-a")
    49				e.skill("skill-b")
    50				e.skill("skill-h")
    51				e.skill("skill-h2")
    52				e.declareWithAgents([]string{"claude_code"}, "skill-a")
    53				e.hybridDeclare("skill-h")
    54				if result := e.install(install.Options{}); result.Status != "ok" {
    55					t.Fatalf("baseline install failed: %+v", result)
    56				}
    57				if _, err := os.Stat(filepath.Join(scopes.HybridSkillsRoot(e.home), "skill-h")); err != nil {
    58					t.Fatalf("the baseline installed no hybrid context: %v", err)
    59				}
    60			},
    61			upgrade: func(t *testing.T, e *env) {
    62				t.Helper()
    63				// skill-b arrives with a runtime tree and shim of its own, and the
    64				// active hybrid skill is swapped, so the commit carries project and
    65				// hybrid context, mirror entries in two adapter roots, and managed
    66				// removals of the shim and mirror of the hybrid skill that left.
    67				// The extra agent changes every project marker, so the surviving
    68				// context is genuinely replaced over a preimage rather than found
    69				// already current, and a second adapter root joins the commit.
    70				e.declareWithAgents([]string{"claude_code", "codex_cli"}, "skill-a", "skill-b")
    71				e.hybridDeclare("skill-h2")
    72			},
    73			install: func(e *env, opts install.Options) install.Result { return e.install(opts) },
    74		}
    75	}
    76	
    77	var projectSweepClasses = []string{
    78		staging.ClassContext, staging.ClassRuntime, staging.ClassCanonicalShim,
    79		staging.ClassEnvFile, staging.ClassAdapterLedger, staging.ClassRemoval, staging.ClassConsumer,
    80	}
    81	
    82	// globalSweepClasses are the classes the machine-wide scope is swept over. The
    83	// two it alone can produce — the PATH-visible forwarding shims and the user-bin
    84	// mirror ledger — are the reason this scenario exists; context, the adapter
    85	// ledger, and managed removals are included because their global instances live
    86	// in the user home rather than a checkout, which is a different rollback
    87	// surface. The classes a global commit shares byte-for-byte with a project one
    88	// are swept in the project scenario, which keeps the suite inside the
    89	// per-package test timeout.
    90	var globalSweepClasses = []string{
    91		staging.ClassContext, staging.ClassForwardingShim,
    92		staging.ClassAdapterLedger, staging.ClassMirrorLedger, staging.ClassRemoval,
    93	}
    94	
    95	func globalSweepScenario(name, mode string) sweepScenario {
    96		return sweepScenario{
    97			name:    name,
    98			mode:    mode,
    99			classes: globalSweepClasses,
   100			baseline: func(t *testing.T, e *env) {
   101				t.Helper()
   102				e.skill("skill-a")
   103				e.skill("skill-b")
   104				e.skill("skill-drop")
   105				e.globalDeclareAll([]string{"claude_code"}, "skill-a", "skill-drop")
   106				if result := e.installGlobal(install.Options{}); result.Status != "ok" {
   107					t.Fatalf("baseline global install failed: %+v", result)
   108				}
   109				if _, err := os.Lstat(filepath.Join(e.userHome, ".local", "bin", "skill-a-tool")); err != nil {
   110					t.Fatalf("the baseline published no user-bin forwarding shim: %v", err)
   111				}
   112			},
   113			upgrade: func(t *testing.T, e *env) {
   114				t.Helper()
   115				e.globalDeclareAll([]string{"claude_code", "codex_cli"}, "skill-a", "skill-b")
   116			},
   117			install:        func(e *env, opts install.Options) install.Result { return e.installGlobal(opts) },
   118			sharedUserHome: true,
   119		}
   120	}
   121	
   122	// TestFailureAtEveryTargetClassRestoresPriorStateInReverseOrder injects a
   123	// failure at each target of a second installation and proves the complete prior
   124	// project, global, hybrid, runtime, shim, env, adapter, mirror, removal, and
   125	// consumer state comes back, in exact reverse commit order.
   126	//
   127	// The project scenario runs in the production-default adapter mode, so the
   128	// mirror entries it commits and restores are the symbolic links a real machine
   129	// gets; the global scenario adds the forwarding shims and the user-bin mirror
   130	// ledger that only the machine-wide scope produces.
   131	func TestFailureAtEveryTargetClassRestoresPriorStateInReverseOrder(t *testing.T) {
   132		// The machine-wide scope only publishes forwarding shims into a user bin
   133		// that is already on PATH, so the sweep gives it one. PATH is set here, in
   134		// the sequential parent, because the scenarios below run in parallel.
   135		globalUserHome := t.TempDir()
   136		if runtime.GOOS != "windows" {
   137			userBin := filepath.Join(globalUserHome, ".local", "bin")
   138			if err := os.MkdirAll(userBin, 0o755); err != nil {
   139				t.Fatal(err)
   140			}
   141			t.Setenv("PATH", userBin+string(os.PathListSeparator)+os.Getenv("PATH"))
   142		}
   143	
   144		for _, scenario := range []sweepScenario{
   145			projectSweepScenario("project-hybrid-auto", "auto"),
   146			globalSweepScenario("global-auto", "auto"),
   147		} {
   148			t.Run(scenario.name, func(t *testing.T) {
   149				t.Parallel()
   150				// One baseline serves every injection. A correct rollback returns
   151				// the machine to exactly the prior state, so the next injection
   152				// starts from the same place — and any residue one rollback leaves
   153				// behind shows up as a failure of the injection after it.
   154				e := newEnv(t)
   155				e.cfg.AdapterMode = scenario.mode
   156				if scenario.sharedUserHome {
   157					e.userHome = globalUserHome
   158				}
   159				scenario.baseline(t, e)
   160				before := snapshotState(t, e)
   161				scenario.upgrade(t, e)
   162	
   163				for _, class := range scenario.classes {
   164					passed := t.Run(class, func(t *testing.T) {
   165						probe := &commitProbe{
   166							failClass: class,
   167							failErr:   fmt.Errorf("injected failure in class %s", class),
   168						}
   169						result := scenario.install(e, install.Options{
   170							Commit: install.CommitDeps{Hooks: probe.hooks(), MaxRestarts: 1},
   171						})
   172						// A class the scenario never produces cannot be failed, so
   173						// the install would succeed here: coverage of every class in
   174						// scenario.classes is enforced rather than assumed.
   175						if result.Status != "failed" {
   176							t.Fatalf("install status = %q, want failed in class %s: %+v", result.Status, class, result)
   177						}
   178						if changed := before.diff(snapshotState(t, e)); len(changed) > 0 {
   179							t.Fatalf("rollback did not restore the prior state: %v", changed)
   180						}
   181						for _, committed := range probe.committedClasses() {
   182							if committed > class {
   183								t.Fatalf("class %s committed after the failure in %s", committed, class)
   184							}
   185						}
   186						probe.assertReverseRollback(t)
   187						assertNoJournalRemains(t, e.home)
   188					})
   189					if !passed {
   190						// Once one rollback is wrong the shared baseline is no
   191						// longer trustworthy, so later injections would report
   192						// noise rather than new information.
   193						break
   194					}
   195				}
   196	
   197				// The same operation must still succeed after the whole sweep, and
   198				// the successful commit is what proves every swept class was really
   199				// on the table.
   200				probe := &commitProbe{}
   201				result := scenario.install(e, install.Options{Commit: install.CommitDeps{Hooks: probe.hooks()}})
   202				if result.Status != "ok" {
   203					t.Fatalf("install after the rollback sweep failed: %+v", result)
   204				}
   205				classes := probe.committedClasses()
   206				for _, want := range scenario.classes {
   207					if !containsString(classes, want) {
   208						t.Fatalf("scenario %s never commits class %q; classes = %v", scenario.name, want, classes)
   209					}
   210				}
   211				for index := 1; index < len(classes); index++ {
   212					if classes[index] < classes[index-1] {
   213						t.Fatalf("classes committed out of order: %v", classes)
   214					}
   215				}
   216			})
   217		}
   218	}
