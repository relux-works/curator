   285	// plannedInputs indexes the derived build inputs of a plan by node and command.
   286	func (plan BuildPlan) plannedInputs() map[string]map[string]buildmeta.Input {
   287		inputs := map[string]map[string]buildmeta.Input{}
   288		for _, build := range plan.builds {
   289			if inputs[build.skill] == nil {
   290				inputs[build.skill] = map[string]buildmeta.Input{}
   291			}
   292			inputs[build.skill][build.command] = build.input
   293		}
   294		return inputs
   295	}
