   235	// activeScriptCommands lists the active script commands of one node in
   236	// command-lexical order.
   237	func activeScriptCommands(node *closure.Node, active map[string]bool) []skillspec.Command {
   238		var commands []skillspec.Command
   239		for _, name := range node.ActiveCommandNames() {
   240			command := node.Spec.Commands[name]
   241			if command.Type == "script" && active[name] {
   242				commands = append(commands, command)
   243			}
   244		}
   245		return commands
   246	}
