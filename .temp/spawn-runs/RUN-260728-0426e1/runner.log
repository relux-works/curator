   602	// journalPlan converts the staged target set into one durable transaction. The
   603	// preimage digest of every target is read here, under the home lock, so no
   604	// other process can move a target between the expectation and the swap.
   605	// It returns the parent directories it had to create, deepest last, so an
   606	// abandoned commit can unwind exactly what it added.
   607	func journalPlan(request commitRequest, targets scopeTargets) (transaction.Plan, []string, error) {
   608		var created []string
   609		id, err := request.commit.NewTransactionID()
   610		if err != nil {
   611			return transaction.Plan{}, created, err
   612		}
   613		identity := request.projectRoot
   614		if identity == "" {
   615			identity = "global:" + request.home
   616		}
   617		plan := transaction.Plan{
   618			TransactionID:       id,
   619			ProjectIdentity:     identity,
   620			ReferencedBuildKeys: uniqueSorted(targets.referencedKeys),

