   297	// referencedKeys lists every protected cache key the committed markers depend
   298	// on, so garbage collection retains them while the transaction is in flight.
   299	func (staged runtimeStaging) referencedKeys() []string {
   300		var keys []string
   301		for _, commands := range staged.builds {
   302			for _, build := range commands {
   303				keys = append(keys, string(build.CacheKey))
   304			}
   305		}
   306		return keys
   307	}

