		}
	}
	for _, good := range []string{"6.0", "6.0.0", "0.1", "99.0", "6.3.2"} {
		if _, ok := parseStrict(good); !ok {
			t.Errorf("parseStrict(%q) rejected", good)
		}
	}
}

