#!/bin/bash
# TASK-260729-365r5r prototype gate driver.
#
# Same evidence protocol as the baseline driver and as
# TASK-260729-rfrdfo/bin/run-gates.sh:
#   * every gate is a standalone process: no tee, no pipe chain
#   * the real exit code is written to <name>.exit as the LAST action, so a
#     missing .exit means "killed or still running", never "passed"
#   * <name>.seconds records wall clock, <name>.log records combined output
#   * gates run strictly one at a time behind a two-scan process barrier
#   * DRIVER-DONE only appears if the driver reached the end
#
# No -timeout token, no ./..., no coverage, no host install, no git command.

ROOT=/Users/iv/Developer/ReluxWorks/curator/.temp/TASK-260729-365r5r
WT=$ROOT/worktree
G=$ROOT/gates
CONFORMANCE=/Users/iv/Developer/ReluxWorks/curator/.temp/TASK-260729-3nx97g/worktree/conformance/v1

mkdir -p "$G" || exit 99
cd "$WT" || exit 99
rm -f "$G/DRIVER-DONE"
date +%FT%T > "$G/DRIVER-START"

# Barrier acquisition retries: a foreign Go process that is merely *between* two
# of its own gates would otherwise poison this gate with a 99 and let the driver
# march on to the next one. Retry for up to ~40 min, then record the refusal.
# This only affects when a gate starts, never what its exit code means.
run() {
  name="$1"; shift
  attempt=0
  until "$ROOT/bin/barrier.sh" > "$G/$name.barrier" 2>&1; do
    attempt=$(( attempt + 1 ))
    if [ "$attempt" -ge 160 ]; then
      echo "99" > "$G/$name.exit"
      return
    fi
    /bin/sleep 15
  done
  start=$(date +%s)
  "$@" > "$G/$name.log" 2>&1
  code=$?
  echo "$(( $(date +%s) - start ))" > "$G/$name.seconds"
  echo "$code" > "$G/$name.exit"
}

export CURATOR_CONFORMANCE_ROOT="$CONFORMANCE"

# --- format / vet / build ---------------------------------------------------
run gate-gofmt gofmt -l internal/transaction internal/install internal/install/atomicity
run gate-vet   env GOTMPDIR="$ROOT/gotmp/transaction" go vet ./internal/transaction/... ./internal/install/...
run gate-build env GOTMPDIR="$ROOT/gotmp/transaction" go build ./...

# Makefile 'lint' target is golangci-lint, which is NOT installed on this host.
# Recorded as a real gate so the absence is evidence (exit 127) rather than an
# unexamined gap. gofmt and go vet above are the parts of `make check` that can
# actually run here.
run gate-lint golangci-lint run

# --- the edited package, non-race then race ---------------------------------
run gate-transaction \
  env GOTMPDIR="$ROOT/gotmp/transaction" go test -count=1 ./internal/transaction
run gate-race-transaction \
  env GOTMPDIR="$ROOT/gotmp/transaction" go test -count=1 -race ./internal/transaction

# --- verbose run of the new tests, so SKIPs are visible ---------------------
# namespace_pass_test.go carries 5 t.Skipf capability guards (hard links,
# symbolic links). If those fired, the alias coverage would be vacuous and the
# negative-coverage claim hollow. This gate exists so a reviewer can grep the
# log for SKIP instead of taking "exit 0" on trust.
run gate-namespace-verbose \
  env GOTMPDIR="$ROOT/gotmp/transaction" go test -count=1 -v -run 'TestNamespaceIdentity|TestValidateIndependentTargetNamespaces|TestSaveJournalRejectsNamespaceAlias|TestRecoverRejectsDecodedTargetNamespaces' ./internal/transaction

# --- rejection equivalence: the same fail-closed tests, baseline product code -
# $ROOT/equivcheck holds a third copy whose internal/transaction/namespace.go is
# byte-identical to worktree-baseline, carrying namespace_pass_test.go minus the
# two white-box tests that name prototype-only symbols. Green here plus green in
# gate-transaction is the behavioral half of call-path-proof.md section 6: the
# prototype neither adds nor removes a rejection.
( cd "$ROOT/equivcheck" && \
  run gate-equivalence \
    env GOTMPDIR="$ROOT/gotmp/equivcheck" go test -count=1 -run 'TestValidateIndependentTargetNamespaces|TestSaveJournalRejectsNamespaceAlias|TestRecoverRejectsDecodedTargetNamespaces' ./internal/transaction )

# --- the O(P^2) -> O(P) claim itself, A/B on the same benchmark -------------
# Baseline runs in equivcheck because worktree-baseline carries no benchmark:
# it is the never-edited twin. equivcheck is that same product code plus the
# benchmark, so the pair differs only in namespace.go.
( cd "$ROOT/equivcheck" && \
  run gate-bench-baseline \
    env GOTMPDIR="$ROOT/gotmp/equivcheck" go test -count=1 -run '^$' -bench BenchmarkValidateIndependentTargetNamespaces -benchmem ./internal/transaction )
run gate-bench-prototype \
  env GOTMPDIR="$ROOT/gotmp/transaction" go test -count=1 -run '^$' -bench BenchmarkValidateIndependentTargetNamespaces -benchmem ./internal/transaction

# --- the atomicity margin the prototype exists to move ----------------------
run gate-atomicity-structure \
  env GOTMPDIR="$ROOT/gotmp/atomicity" go test -count=1 ./internal/install/atomicity
for i in 1 2 3; do
  run "gate-race-atomicity-$i" \
    env GOTMPDIR="$ROOT/gotmp/atomicity" go test -count=1 -race ./internal/install/atomicity
done
run gate-race-install-1 \
  env GOTMPDIR="$ROOT/gotmp/install" go test -count=1 -race ./internal/install

date +%FT%T > "$G/DRIVER-DONE"
