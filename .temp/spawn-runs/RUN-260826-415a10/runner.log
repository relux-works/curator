		"HOME":                "" + home,
		EnvBuildSSHIdentity:   "/operator/env.pub",
		EnvBuildSSHAgent:      "/operator/env.sock",
		EnvBuildSSHKnownHosts: "/operator/env_known_hosts",
		envAgentSocket:        "/operator/live.sock",
	}
