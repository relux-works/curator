exec
/bin/zsh -lc 'cat /Users/iv/.claude/skills/project-management/references/statuses.md && cat /Users/iv/.claude/skills/project-management/references/resources-and-bugs.md && cat /Users/iv/.claude/skills/project-management/references/querying.md' in /Users/iv/Developer/ReluxWorks/curator/.temp/STORY-260822-2v23mv/worktree
