+package transaction
+
+import (
+	"strings"
+	"testing"
+)
+
+func orderingRoot() RemovalEntry {
+	return RemovalEntry{Kind: "directory", Mode: 0o755}
+}
+
+func orderingFile(path string) RemovalEntry {
+	return RemovalEntry{
+		RelativePath: path,
+		Kind:         "file",
+		Mode:         0o644,
+		Digest:       "sha256:" + strings.Repeat("ab", 32),
+	}
+}
+
