+def test_failed_project_reentry_preserves_held_process_reservation(
+    tmp_path: Path,
+):
+    home = tmp_path / "home"
+    project = ProjectLock(home, tmp_path / "project")
+
+    with project:
+        with pytest.raises(LockOrderError, match="already held"), project:
+            pass
