+        raise TransactionCorruptionError("staging file has descendant entries")
+    for relative_path in by_relative:
+        if relative_path == "":
+            continue
+        parent = PurePosixPath(relative_path).parent.as_posix()
+        if parent == ".":
+            parent = ""
