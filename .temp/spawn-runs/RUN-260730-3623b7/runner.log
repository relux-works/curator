+        if relative_path == "":
+            continue
+        parent = PurePosixPath(relative_path).parent.as_posix()
+        if parent == ".":
+            parent = ""
+        parent_entry = by_relative.get(parent)
+        if parent_entry is None or parent_entry.kind != "directory":
