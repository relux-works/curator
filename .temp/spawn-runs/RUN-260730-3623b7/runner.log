+    ):
+        raise TransactionCorruptionError(
+            f"staging prefix progress is inconsistent: {key}"
+        )
+    if target.staging_write_bytes == 0:
+        if target.staging_write_digest is not None:
+            raise TransactionCorruptionError(
+                f"staging write progress is inconsistent: {key}"
+            )
