+) -> None:
+    if not isinstance(entries, list) or not all(
+        isinstance(entry, StagingTreeEntry) for entry in entries
+    ):
+        raise TransactionCorruptionError("journal staging entries are invalid")
+    if expected_digest == ABSENT_DIGEST:
+        if entries:
