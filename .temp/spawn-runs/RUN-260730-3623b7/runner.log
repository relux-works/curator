+    except FileNotFoundError as exc:
+        raise TransactionCorruptionError(
+            f"recorded staging entry is missing: {path}"
+        ) from exc
+    if actual != expected:
+        raise TransactionCorruptionError(f"staging entry changed: {path}")
+
+
+def _validate_staging_source_manifest(target: JournalTarget) -> None:
+    assert target.staged_source is not None
+    source = Path(target.staged_source)
+    actual_entries = _staging_manifest(source)
+    if actual_entries != target.staging_entries:
+        raise TransactionCorruptionError(
+            f"staging source changed: {target.target_class}/{target.identifier}"
+        )
+    if digest_path(source) != target.desired_digest:
+        raise TransactionCorruptionError(
+            f"staging source digest changed: {target.target_class}/{target.identifier}"
+        )
