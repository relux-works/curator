+            match="changed|unrecorded|durable|staging",
+        ),
+    ):
+        TransactionEngine(home).recover(lock)
+
+    assert digest_path(staged) == before_recovery
+    assert journal_path.exists()
+    assert not (tmp_path / "live").exists()
