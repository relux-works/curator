		}
		livePaths[live] = struct{}{}
		if err := validateGenerationPath(target.GenerationPath); err != nil {
			return nil, nil, fmt.Errorf("target %s/%s: %w", target.Class, target.Identifier, err)
		}
		desiredDigest := DigestAbsent
