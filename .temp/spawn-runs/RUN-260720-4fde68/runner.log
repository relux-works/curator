+    "locked_commits": [
+      {"project": "project-a", "read_consumers": [], "write_consumers": ["project-a"]},
+      {"project": "project-b", "read_consumers": ["project-a"], "write_consumers": ["project-a", "project-b"]}
+    ],
+    "expected_consumers": ["project-a", "project-b"],
+    "lost_update": false
