+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/relux-works/curator/internal/transaction"
+)
+
+type heldLock struct{}
+
+func (heldLock) AssertHeld() error { return nil }
+
+func must(err error) {
+	if err != nil {
+		panic(err)
+	}
+}
+
+func write(path, value string) {
+	must(os.MkdirAll(filepath.Dir(path), 0o700))
+	must(os.WriteFile(path, []byte(value), 0o600))
+}
+
+func main() {
+	root, err := os.MkdirTemp("", "curator-cleanup-crash-")
+	must(err)
+	defer os.RemoveAll(root)
+	live := filepath.Join(root, "live", "target")
+	stage := filepath.Join(root, "stage", "target")
+	write(filepath.Join(live, "a"), "old-a")
+	write(filepath.Join(live, "b"), "old-b")
+	write(filepath.Join(stage, "a"), "new-a")
+	write(filepath.Join(stage, "b"), "new-b")
+	preimage, err := transaction.DigestPath(live)
+	must(err)
+	stop := errors.New("stop before cleanup")
+	engine, err := transaction.New(filepath.Join(root, "home"), transaction.WithHooks(transaction.Hooks{Fault: func(event transaction.Event) error {
+		if event.Point == transaction.PointBeforeCleanup {
+			return stop
+		}
+		return nil
+	}}))
+	must(err)
+	journal, err := engine.Prepare(heldLock{}, transaction.Plan{
+		TransactionID:   "txn-cleanup-crash-probe",
+		ProjectIdentity: "/project",
+		Targets: []transaction.Target{{
+			Class: "runtime", Identifier: "target", LivePath: live, StagedSource: stage, PreimageDigest: preimage,
+		}},
+	})
+	must(err)
+	commitErr := engine.Commit(heldLock{}, journal.TransactionID)
+	backup := journal.Targets[0].BackupPath
+	tomb := backup + ".delete"
+	must(os.Rename(backup, tomb))
+	must(os.Remove(filepath.Join(tomb, "a")))
+	restarted, err := transaction.New(filepath.Join(root, "home"))
+	must(err)
+	recoverErr := restarted.Recover(heldLock{})
+	_, tombErr := os.Lstat(tomb)
+	fmt.Printf("commit_paused=%t\n", errors.Is(commitErr, stop))
+	fmt.Printf("recover_corruption=%t\n", errors.Is(recoverErr, transaction.ErrImplementationCorruption))
+	fmt.Printf("recover_error=%v\n", recoverErr)
+	fmt.Printf("partial_tomb_preserved=%t\n", tombErr == nil)
+}
