	plan := Plan{TransactionID: "txn-sidecar", ProjectIdentity: "/project", Targets: []Target{valid}}
	if _, _, err := engine.buildJournal(plan); !errors.Is(err, ErrImplementationCorruption) {
		t.Fatalf("orphan sidecar error = %v", err)
	}
}

