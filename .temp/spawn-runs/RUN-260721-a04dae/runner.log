+
+func (heldLock) AssertHeld() error { return nil }
+
+func main() {
+	root, err := os.MkdirTemp("", "curator-unicode-alias-")
+	if err != nil {
+		panic(err)
+	}
+	defer os.RemoveAll(root)
+
+	nfc := filepath.Join(root, "live", "\u00e9")
+	nfd := filepath.Join(root, "live", "e\u0301")
+	if err := os.MkdirAll(filepath.Dir(nfc), 0o700); err != nil {
+		panic(err)
+	}
+	probe := filepath.Join(root, "live", "\u00e9-probe")
+	if err := os.WriteFile(probe, []byte("probe"), 0o600); err != nil {
+		panic(err)
+	}
