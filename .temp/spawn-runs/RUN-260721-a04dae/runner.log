+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/relux-works/curator/internal/transaction"
+)
+
+type heldLock struct{}
+
+func (heldLock) AssertHeld() error { return nil }
+
+func main() {
+	root, err := os.MkdirTemp("", "curator-unicode-alias-")
+	if err != nil {
+		panic(err)
+	}
+	defer os.RemoveAll(root)
+
+	nfc := filepath.Join(root, "live", "\u00e9")
+	nfd := filepath.Join(root, "live", "e\u0301")
+	if err := os.MkdirAll(filepath.Dir(nfc), 0o700); err != nil {
+		panic(err)
+	}
+	probe := filepath.Join(root, "live", "\u00e9-probe")
+	if err := os.WriteFile(probe, []byte("probe"), 0o600); err != nil {
+		panic(err)
+	}
+	_, aliasErr := os.Stat(filepath.Join(root, "live", "e\u0301-probe"))
+	if err := os.Remove(probe); err != nil {
+		panic(err)
+	}
+
+	sourceA := filepath.Join(root, "stage", "a")
+	sourceB := filepath.Join(root, "stage", "b")
+	if err := os.MkdirAll(filepath.Dir(sourceA), 0o700); err != nil {
+		panic(err)
+	}
+	if err := os.WriteFile(sourceA, []byte("new-a"), 0o600); err != nil {
+		panic(err)
+	}
+	if err := os.WriteFile(sourceB, []byte("new-b"), 0o600); err != nil {
+		panic(err)
+	}
+	engine, err := transaction.New(filepath.Join(root, "home"))
+	if err != nil {
+		panic(err)
+	}
+	_, prepareErr := engine.Prepare(heldLock{}, transaction.Plan{
+		TransactionID:   "txn-unicode-alias-probe",
+		ProjectIdentity: "/project",
+		Targets: []transaction.Target{
+			{Class: "a", Identifier: "nfc", LivePath: nfc, StagedSource: sourceA, PreimageDigest: transaction.DigestAbsent},
+			{Class: "b", Identifier: "nfd", LivePath: nfd, StagedSource: sourceB, PreimageDigest: transaction.DigestAbsent},
+		},
+	})
+	fmt.Printf("filesystem_alias=%t\n", aliasErr == nil)
+	fmt.Printf("prepare_accepted=%t\n", prepareErr == nil)
+	fmt.Printf("prepare_error=%v\n", prepareErr)
+}
