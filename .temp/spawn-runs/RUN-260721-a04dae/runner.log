+		panic(err)
+	}
+	if err := os.WriteFile(sourceA, []byte("new-a"), 0o600); err != nil {
+		panic(err)
+	}
+	if err := os.WriteFile(sourceB, []byte("new-b"), 0o600); err != nil {
+		panic(err)
