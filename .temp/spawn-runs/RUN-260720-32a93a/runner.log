## Microservices Pattern

```plantuml
@startuml
!theme plain

actor User

node "Load Balancer" as LB

node "Service Mesh" {
  [API Gateway] as GW

  frame "User Domain" {
    [User Service] as US
    database "User DB" as UDB
  }

  frame "Order Domain" {
    [Order Service] as OS
    database "Order DB" as ODB
  }

  frame "Inventory Domain" {
    [Inventory Service] as IS
    database "Inventory DB" as IDB
  }

  queue "Event Bus" as EB
}

User --> LB
LB --> GW

GW --> US
GW --> OS
GW --> IS

US --> UDB
OS --> ODB
IS --> IDB

US --> EB
OS --> EB
IS --> EB

@enduml
```

