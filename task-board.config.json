{
  "mode": "local",
  "local": {
    "board_dir": ".task-board"
  },
  "validation": {
    "allow_legacy_empty_done_containers": true
  },
  "spawn": {
    "max_parallel": 20,
    "worktree_isolation": {
      "validation": {
        "commands": [
          "sh scripts/remote-gate.sh"
        ]
      },
      "integration_base_branch": "main"
    },
    "preferred_agentic_system": {
      "mixed": [
        "claude",
        "codex",
        "muse"
      ]
    },
    "ceilings": {
      "contract_version": "spawn-policy-v3",
      "codex": {
        "entries": [
          {
            "criterion": "equal",
            "model": "gpt-6-astra",
            "reasoning_effort": "low"
          }
        ],
        "adjustment_confirmation": "required",
        "roles": {
          "developer": {
            "default_model": "gpt-6-astra",
            "default_reasoning_effort": "low"
          },
          "reviewer": {
            "default_model": "gpt-6-astra",
            "default_reasoning_effort": "low"
          },
          "doc-writer": {
            "default_model": "gpt-6-astra",
            "default_reasoning_effort": "low"
          },
          "tester": {
            "default_model": "gpt-6-astra",
            "default_reasoning_effort": "low"
          },
          "researcher": {
            "default_model": "gpt-6-astra",
            "default_reasoning_effort": "low"
          },
          "solution-architect": {
            "default_model": "gpt-6-astra",
            "default_reasoning_effort": "low"
          }
        }
      },
      "claude": {
        "entries": [
          {
            "criterion": "equal",
            "model": "claude-fable-5-1",
            "reasoning_effort": "low"
          },
          {
            "criterion": "equal",
            "model": "claude-opus-5",
            "reasoning_effort": "max"
          }
        ],
        "adjustment_confirmation": "required",
        "roles": {
          "developer": {
            "default_model": "claude-fable-5-1",
            "default_reasoning_effort": "low"
          },
          "reviewer": {
            "default_model": "claude-opus-5",
            "default_reasoning_effort": "max"
          },
          "solution-architect": {
            "default_model": "claude-fable-5-1",
            "default_reasoning_effort": "low"
          },
          "technical-writer": {
            "default_model": "claude-fable-5-1",
            "default_reasoning_effort": "low"
          },
          "researcher": {
            "default_model": "claude-fable-5-1",
            "default_reasoning_effort": "low"
          },
          "tester": {
            "default_model": "claude-fable-5-1",
            "default_reasoning_effort": "low"
          }
        }
      },
      "muse": {
        "entries": [
          {
            "criterion": "equal",
            "model": "muse-spark-1.3-contributor",
            "reasoning_effort": "max"
          }
        ],
        "adjustment_confirmation": "required",
        "roles": {
          "developer": {
            "default_model": "muse-spark-1.3-contributor",
            "default_reasoning_effort": "max"
          },
          "tester": {
            "default_model": "muse-spark-1.3-contributor",
            "default_reasoning_effort": "max"
          },
          "doc-writer": {
            "default_model": "muse-spark-1.3-contributor",
            "default_reasoning_effort": "max"
          },
          "researcher": {
            "default_model": "muse-spark-1.3-contributor",
            "default_reasoning_effort": "max"
          }
        }
      }
    }
  }
}
