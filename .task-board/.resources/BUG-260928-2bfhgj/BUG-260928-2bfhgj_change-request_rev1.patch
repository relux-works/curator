+// exitReport names how the worker process ended and what it wrote to
+// stderr, so a closed channel is attributable (for example a kernel kill
+// at exec rather than a protocol refusal).
+func (worker *rawWorker) exitReport() string {
+	_ = worker.stdin.Close()
+	done := make(chan error, 1)
+	go func() { done <- worker.command.Wait() }()
+	var status string
+	select {
+	case err := <-done:
+		status = fmt.Sprintf("worker exit: %v (state %v)", err, worker.command.ProcessState)
+	case <-time.After(10 * time.Second):
+		status = "worker still running 10s after the channel closed"
+	}
+	return fmt.Sprintf("%s; worker stderr: %q", status, worker.stderr.String())
+}
