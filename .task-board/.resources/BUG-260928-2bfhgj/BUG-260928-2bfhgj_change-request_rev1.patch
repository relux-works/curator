+// tamperExecutableFixture changes the bytes of an executable copy while
+// keeping it launchable. On darwin the kernel kills an arm64 image whose
+// code signature no longer matches its bytes before main runs, so a raw
+// byte flip proves only SIGKILL, never the identity refusal; there the
+// copy is re-signed ad hoc under a different identifier, which is what an
+// attacker producing a runnable substitute does. Elsewhere the last byte
+// is flipped. Either way the result must differ from the source bytes.
+func tamperExecutableFixture(t *testing.T, path string) {
+	t.Helper()
+	before, err := os.ReadFile(path) // #nosec G304 -- test-owned copy
+	if err != nil {
+		t.Fatal(err)
+	}
+	if runtime.GOOS == "darwin" {
+		output, err := exec.Command("/usr/bin/codesign", "--force", "--sign", "-", "--identifier", "curator.test.tampered", path).CombinedOutput() // #nosec G204 -- fixed tool on a test-owned copy
+		if err != nil {
+			t.Fatalf("cannot re-sign the tampered fixture: %v: %s", err, output)
+		}
+	} else {
+		payload := append([]byte(nil), before...)
+		payload[len(payload)-1] ^= 0xff
+		if err := os.WriteFile(path, payload, 0o755); err != nil { // #nosec G306 -- executable test fixture
+			t.Fatal(err)
+		}
+	}
+	after, err := os.ReadFile(path) // #nosec G304 -- test-owned copy
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Equal(before, after) {
+		t.Fatal("the tampered fixture still has the original bytes")
+	}
+}
