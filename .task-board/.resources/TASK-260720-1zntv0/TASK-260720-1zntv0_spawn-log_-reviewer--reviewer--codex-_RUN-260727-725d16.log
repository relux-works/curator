            ResourceLimits\n}\n\n// HostPolicy is the build-tagged platform isolation boundary. Implementations\n// execute Process.Executable directly and fail closed if a requested supported\n// control cannot be applied.\ntype HostPolicy interface {\n\tRun(context.Context, HostExecution) (Output, error)\n}\n\ntype guardedHostPolicy struct{ executor Executor }\n\n// NewHostPolicy returns the native direct-execution adapter. Passing nil uses\n// OSExecutor. The adapter verifies the closed environment, read-only source,\n// private writable roots, executable graph roots, and bounded request before\n// every direct child.\nfunc NewHostPolicy(executor Executor) HostPolicy {\n\tif executor == nil {\n\t\texecutor = OSExecutor{}\n\t}\n\treturn guardedHostPolicy{executor: executor}\n}\n\nfunc (policy guardedHostPolicy) Run(ctx context.Context, execution HostExecution) (Output, error) {\n\tif err := validateHostExecution(execution); err != nil {\n\t\treturn Output{}, err\n\t}\n\tif err := platformValidateHostExecution(execution); err != nil {\n\t\treturn Output{}, err\n\t}\n\treturn policy.executor.Run(ctx, execution.Process)\n}\n\nfunc validateHostExecution(execution HostExecution) error {\n\tprocess := execution.Process\n\tif len(execution.ReadOnlyRoots) != 2 || len(execution.WritableRoots) == 0 || len(execution.AllowedExecutables) != 2 || !execution.NetworkDenied {\n\t\treturn diagnostic(\"host_policy_invalid\", \"go-v1 isolation roots, executable graph, and network denial must be explicit\")\n\t}\n\tif process.Executable == \"\" || process.Executable != execution.AllowedExecutables[0] || !filepath.IsAbs(process.Executable) {\n\t\treturn diagnostic(\"unexpected_child_process\", \"direct executable is not the fingerprinted Go launcher\")\n\t}\n\tif !filepath.IsAbs(process.Directory) || process.Directory == execution.ReadOnlyRoots[0] || !strictlyBelow(process.Directory, execution.ReadOnlyRoots[0]) {\n\t\treturn diagnostic(\"host_policy_invalid\", \"Go child cwd is not the canonical source directory\")\n\t}\n\tif process.Timeout != execution.Limits.Timeout || process.OutputLimit != execution.Limits.OutputBytes {\n\t\treturn diagnostic(\"host_policy_invalid\", \"process bounds differ from the normalized host policy limits\")\n\t}\n\tif err := validateBuildEnvironment(process.Environment, execution); err != nil {\n\t\treturn err\n\t}\n\tfor _, root := range execution.ReadOnlyRoots {\n\t\tif !filepath.IsAbs(root) {\n\t\t\treturn diagnostic(\"host_policy_invalid\", \"read-only roots must be absolute\")\n\t\t}\n\t}\n\tfor _, root := range execution.WritableRoots {\n\t\tif !filepath.IsAbs(root) || root == execution.ReadOnlyRoots[0] || root == execution.ReadOnlyRoots[1] || isWithin(root, execution.ReadOnlyRoots[0]) || isWithin(root, execution.ReadOnlyRoots[1]) {\n\t\t\treturn diagnostic(\"host_policy_invalid\", \"writable root overlaps source or toolchain\")\n\t\t}\n\t}\n\ttoolDir := execution.AllowedExecutables[1]\n\tif !filepath.IsAbs(toolDir) || !strictlyBelow(toolDir, execution.ReadOnlyRoots[1]) {\n\t\treturn diagnostic(\"unexpected_child_process\", \"allowed Go tool directory escapes fingerprinted GOROOT\")\n\t}\n\tif err := verifyReadOnlyTree(execution.ReadOnlyRoots[0]); err != nil {\n\t\treturn diagnosticErr(\"source_not_readonly\", err, \"frozen source is writable by build children\")\n\t}\n\tif err := validateFixedBuildArguments(process.Arguments, execution.WritableRoots); err != nil {\n\t\treturn err\n\t}\n\treturn nil\n}\n\nfunc validateBuildEnvironment(environment []string, execution HostExecution) error {\n\tvalues := make(map[string]string, len(environment))\n\tfor _, item := range environment {\n\t\tkey, value, present := strings.Cut(item, \"=\")\n\t\tif !present || key == \"\" {\n\t\t\treturn diagnostic(\"process_environment_poisoned\", \"build environment contains a malformed entry\")\n\t\t}\n\t\tif _, duplicate := values[key]; duplicate {\n\t\t\treturn diagnostic(\"process_environment_poisoned\", \"build environment repeats %s\", key)\n\t\t}\n\t\tvalues[key] = value\n\t}\n\trequired := map[string]string{\n\t\t\"GOENV\": \"off\", \"GOTOOLCHAIN\": \"local\", \"LC_ALL\": \"C\", \"LANG\": \"C\",\n\t\t\"GO111MODULE\": \"on\", \"GOFLAGS\": \"\", \"GOPROXY\": \"off\", \"GOSUMDB\": \"off\", \"GOPRIVATE\": \"\",\n\t\t\"GONOPROXY\": \"none\", \"GONOSUMDB\": \"none\", \"GOVCS\": \"*:off\", \"GOWORK\": \"off\",\n\t\t\"CGO_ENABLED\": \"0\", \"GO_EXTLINK_ENABLED\": \"0\", \"GOEXPERIMENT\": \"\",\n\t\t\"GOROOT\": execution.ReadOnlyRoots[1],\n\t}\n\tfor key, want := range required {\n\t\tif got, present := values[key]; !present || got != want {\n\t\t\treturn diagnostic(\"process_environment_poisoned\", \"build environment has unexpected %s\", key)\n\t\t}\n\t}\n\tfor _, key := range []string{\"GOPATH\", \"GOMODCACHE\", \"GOCACHE\", \"GOTMPDIR\", \"HOME\", \"XDG_CONFIG_HOME\", \"PATH\", \"TMPDIR\"} {\n\t\tvalue, present := values[key]\n\t\tif !present || !containsExact(execution.WritableRoots, value) && key != \"PATH\" {\n\t\t\treturn diagnostic(\"process_environment_poisoned\", \"build environment %s is not operation-private\", key)\n\t\t}\n\t\tif key == \"PATH\" && (value == \"\" || !containsExact(execution.WritableRoots, filepath.Dir(value)) && !isSiblingPrivateRoot(value, execution.WritableRoots)) {\n\t\t\treturn diagnostic(\"process_environment_poisoned\", \"build PATH is not an operation-private empty directory\")\n\t\t}\n\t}\n\tfor _, forbidden := range []string{\"CC\", \"CXX\", \"FC\", \"AR\", \"PKG_CONFIG\", \"GOFLAGS_FILE\", \"GOAUTH\", \"HTTP_PROXY\", \"HTTPS_PROXY\", \"ALL_PROXY\", \"NO_PROXY\", \"SSH_AUTH_SOCK\", \"GIT_CONFIG_GLOBAL\", \"GIT_CONFIG_SYSTEM\"} {\n\t\tif _, present := values[forbidden]; present {\n\t\t\treturn diagnostic(\"process_environment_poisoned\", \"build environment contains forbidden %s\", forbidden)\n\t\t}\n\t}\n\tif values[\"GOOS\"] == \"\" || values[\"GOARCH\"] == \"\" {\n\t\treturn diagnostic(\"process_environment_poisoned\", \"build environment is missing the native target\")\n\t}\n\tallowed := make(map[string]bool, len(required)+16)\n\tfor key := range required {\n\t\tallowed[key] = true\n\t}\n\tfor _, key := range []string{\"GOOS\", \"GOARCH\", \"GOPATH\", \"GOMODCACHE\", \"GOCACHE\", \"GOTMPDIR\", \"HOME\", \"XDG_CONFIG_HOME\", \"PATH\", \"TMPDIR\"} {\n\t\tallowed[key] = true\n\t}\n\tif tuning := tuningVariable(values[\"GOARCH\"]); tuning != \"\" {\n\t\tif values[tuning] == \"\" {\n\t\t\treturn diagnostic(\"process_environment_poisoned\", \"build environment is missing %s\", tuning)\n\t\t}\n\t\tallowed[tuning] = true\n\t}\n\tfor _, key := range platformEnvironmentNames() {\n\t\tallowed[key] = true\n\t}\n\tfor key := range values {\n\t\tif !allowed[key] {\n\t\t\treturn diagnostic(\"process_environment_poisoned\", \"build environment contains non-protocol variable %s\", key)\n\t\t}\n\t}\n\tpathEntries, err := os.ReadDir(values[\"PATH\"])\n\tif err != nil || len(pathEntries) != 0 {\n\t\treturn diagnosticErr(\"process_environment_poisoned\", err, \"build PATH is not an empty manager directory\")\n\t}\n\treturn nil\n}\n\nfunc validateFixedBuildArguments(arguments, writableRoots []string) error {\n\tif reflect.DeepEqual(arguments, listArguments) {\n\t\treturn nil\n\t}\n\tif len(arguments) != 11 || !reflect.DeepEqual(arguments[:9], []string{\n\t\t\"build\", \"-mod=vendor\", \"-trimpath\", \"-buildvcs=false\", \"-buildmode=exe\", \"-compiler=gc\", \"-pgo=off\", \"-ldflags=-linkmode=internal -libgcc=none\", \"-o\",\n\t}) || arguments[10] != \".\" {\n\t\treturn diagnostic(\"unexpected_go_arguments\", \"host policy rejected a non-protocol Go argument vector\")\n\t}\n\toutput := arguments[9]\n\tif !filepath.IsAbs(output) {\n\t\treturn diagnostic(\"artifact_path_mismatch\", \"Go output path is not manager-derived absolute staging\")\n\t}\n\tfor _, root := range writableRoots {\n\t\tif strictlyBelow(output, root) {\n\t\t\treturn nil\n\t\t}\n\t}\n\treturn diagnostic(\"artifact_path_mismatch\", \"Go output path escapes operation-private staging\")\n}\n\nfunc containsExact(values []string, want string) bool {\n\tfor _, value := range values {\n\t\tif value == want {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc isSiblingPrivateRoot(path string, writable []string) bool {\n\tfor _, root := range writable {\n\t\tif filepath.Dir(root) == filepath.Dir(path) {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc verifyReadOnlyTree(root string) error {\n\treturn filepath.WalkDir(root, func(path string, entry os.DirEntry, walkErr error) error {\n\t\tif walkErr != nil {\n\t\t\treturn walkErr\n\t\t}\n\t\tinfo, err := os.Lstat(path)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif info.Mode().Perm()&0o222 != 0 {\n\t\t\treturn fmt.Errorf(\"%s has write permission bits %o\", path, info.Mode().Perm())\n\t\t}\n\t\treturn nil\n\t})\n}\n\nfunc copyHostExecution(execution HostExecution) HostExecution {\n\texecution.Process.Arguments = append([]string(nil), execution.Process.Arguments...)\n\texecution.Process.Environment = append([]string(nil), execution.Process.Environment...)\n\texecution.ReadOnlyRoots = append([]string(nil), execution.ReadOnlyRoots...)\n\texecution.WritableRoots = append([]string(nil), execution.WritableRoots...)\n\texecution.AllowedExecutables = append([]string(nil), execution.AllowedExecutables...)\n\treturn execution\n}\n\nfunc sameHostExecution(left, right HostExecution) bool { return reflect.DeepEqual(left, right) }\n\nvar errHostControlUnavailable = errors.New(\"host control unavailable\")\n--- .temp/TASK-260720-1zntv0/worktree/internal/godriver/host_policy_unix.go\n//go:build !windows\n\npackage godriver\n\nimport (\n\t\"io/fs\"\n\t\"syscall\"\n)\n\nfunc platformValidateHostExecution(execution HostExecution) error {\n\t// POSIX permission bits are checked over the complete frozen source by the\n\t// common gate. Network/module/VCS denial is enforced by the closed Go\n\t// environment; deadline and combined output are enforced by the executor.\n\t// Memory/process enforcement remains an injected policy responsibility on\n\t// hosts that expose stronger sandbox primitives.\n\treturn nil\n}\n\nfunc platformEnvironmentNames() []string { return nil }\n\nfunc applyArtifactPermissions(path string) error { return chmod(path, 0o700) }\n\nfunc artifactHasMultipleLinks(_ string, info fs.FileInfo) (bool, error) {\n\tstat, ok := info.Sys().(*syscall.Stat_t)\n\treturn ok && stat.Nlink != 1, nil\n}\n--- .temp/TASK-260720-1zntv0/worktree/internal/godriver/host_policy_windows.go\n//go:build windows\n\npackage godriver\n\nimport (\n\t\"io/fs\"\n\n\t\"golang.org/x/sys/windows\"\n)\n\nfunc platformValidateHostExecution(execution HostExecution) error {\n\t// The common gate validates the closed environment and read-only source\n\t// modes. A stronger Windows Job Object/DACL policy can be injected through\n\t// HostPolicy without changing either fixed Go argument vector.\n\treturn nil\n}\n\nfunc platformEnvironmentNames() []string {\n\treturn []string{\"APPDATA\", \"LOCALAPPDATA\", \"USERPROFILE\", \"TEMP\", \"TMP\", \"SYSTEMROOT\", \"WINDIR\"}\n}\n\nfunc applyArtifactPermissions(path string) error { return chmod(path, 0o700) }\n\nfunc artifactHasMultipleLinks(path string, _ fs.FileInfo) (bool, error) {\n\tencoded, err := windows.UTF16PtrFromString(path)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\thandle, err := windows.CreateFile(encoded, windows.GENERIC_READ, windows.FILE_SHARE_READ, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tdefer windows.CloseHandle(handle)\n\tvar info windows.ByHandleFileInformation\n\tif err := windows.GetFileInformationByHandle(handle, &info); err != nil {\n\t\treturn false, err\n\t}\n\treturn info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || info.NumberOfLinks != 1, nil\n}\n","exit_code":0,"status":"completed"}}
