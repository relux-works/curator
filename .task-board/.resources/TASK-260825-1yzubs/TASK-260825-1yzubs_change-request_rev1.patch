+	err := command.Run()
+	code := exitOK
+	if err != nil {
+		var exitError *exec.ExitError
+		if !errors.As(err, &exitError) {
+			t.Fatal(err)
+		}
+		code = exitError.ExitCode()
+	}
+	return code, stdout.String(), stderr.String()
