+			for _, env := range envIDs {
+				if module.Applies(env) {
+					applies = true
+					break
+				}
+			}
+			if !applies {
+				continue
+			}
+			dropped = append(dropped, DroppedSystemModule{Package: member.Name, Path: module.Path})
+		}
+	}
+	return dropped
+}
