+		Machine:      envregistry.DefaultMachineConfig(),
+		Detect:       func(envregistry.Adapter) string { return "unknown" },
+		NativeHomeOf: func(id string) (string, error) { return filepath.Join(native, id), nil },
+		OperatorXDG:  t.TempDir(),
+		LaunchDir:    t.TempDir(),
