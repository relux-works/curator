+	if pin["suite_root"] != "conformance/v1" || pin["manifest_sha256"] != sha256Identity(manifest) ||
+		downstream["required_manifest_sha256"] != sha256Identity(manifest) ||
+		downstream["committed_release_pin_advanced"] != false {
