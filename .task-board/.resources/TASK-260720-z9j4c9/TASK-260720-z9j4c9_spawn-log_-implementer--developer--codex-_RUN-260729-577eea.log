+        encoding="utf-8",
+    )
+    (source_dir / "main.go").write_text("package main\n", encoding="utf-8")
+    (tmp_path / "agent-skill.json").write_text(
+        json.dumps(
+            {
+                "schema_version": 6,
+                "build_roots": ["assets/build-tool"],
+                "capabilities": {},
+                "commands": {
+                    "build-tool": {
+                        "type": "build",
+                        "driver": "go-v1",
+                        "source_dir": "assets/build-tool/cmd/tool",
+                    }
+                },
+            }
+        ),
+        encoding="utf-8",
+    )
+
