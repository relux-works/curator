+    payload: dict[str, Any] = {
+        "schema_version": 6,
+        "capabilities": {},
+        "commands": commands or {},
+    }
+    if build_roots is not None:
+        payload["build_roots"] = build_roots
+    if runtime_roots is not None:
+        payload["runtime_roots"] = runtime_roots
+    return payload
