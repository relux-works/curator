+                assert spec.source_file == manifest_name
+                assert spec.commands["build-tool"].driver == "go-v1"
+            else:
+                with pytest.raises(skillspec.SkillSpecError):
+                    skillspec.load_skill_spec(snapshot)
+    assert case_count == 48

