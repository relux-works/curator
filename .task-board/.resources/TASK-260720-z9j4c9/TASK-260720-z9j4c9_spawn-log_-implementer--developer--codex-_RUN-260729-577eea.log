+            _build_files(snapshot)
+            (snapshot / "scripts").mkdir()
+            (snapshot / "scripts" / "tool").write_text("#!/bin/sh\n", encoding="utf-8")
+            (snapshot / manifest_name).write_bytes(case_path.read_bytes())
+            if case_path.name == "valid.json":
