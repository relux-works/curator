+def _build_command(source_dir: str = "build/cmd/tool", **extra: Any) -> dict[str, Any]:
+    command: dict[str, Any] = {
+        "type": "build",
+        "driver": "go-v1",
+        "source_dir": source_dir,
+    }
+    command.update(extra)
+    return command
