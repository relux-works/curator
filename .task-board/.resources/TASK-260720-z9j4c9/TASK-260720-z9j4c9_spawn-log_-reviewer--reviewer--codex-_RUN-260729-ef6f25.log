+                raise SkillSpecError(
+                    f"{field} intervening module {current.as_posix()}/go.mod is below build root {build_root}"
+                )
+            return
+        if current == root_path:
+            raise SkillSpecError(
+                f"{field} build root {build_root} must contain the nearest go.mod directly"
+            )
