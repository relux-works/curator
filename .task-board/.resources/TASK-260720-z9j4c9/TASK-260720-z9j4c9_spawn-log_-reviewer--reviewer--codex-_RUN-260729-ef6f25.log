		for name := range obj {
			names = append(names, name)
		}
		sort.Strings(names)
		for _, name := range names {
			if err := parseEntry(name, obj[name]); err != nil {
				return nil, err
			}
		}
	} else {
		for name, rawEntry := range obj {
			if err := parseEntry(name, rawEntry); err != nil {
				return nil, err
