+		if combined := stdout + stderr; !strings.Contains(combined, buildrepo.CodeSourceUnavailable) {
+			t.Fatalf("invalid policy lacks the lane diagnostic:\nstdout:\n%s\nstderr:\n%s", stdout, stderr)
+		}
