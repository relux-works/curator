+		Attempts: []config.Attempt{{URL: "https://fixture.test/repository.git"}}, Fallback: "sometimes"}
+	if _, err := draftTransportPlan(bad); err == nil || !strings.Contains(err.Error(), config.CodeRepositoryPolicyInvalid) {
