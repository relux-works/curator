+func TestProductionBinaryDispatchesSSHWrapper(t *testing.T) {
+	binary := filepath.Join(t.TempDir(), "curator"+productionBinarySuffix())
+	build := exec.Command("go", "build", "-o", binary, ".")
+	if output, err := build.CombinedOutput(); err != nil {
