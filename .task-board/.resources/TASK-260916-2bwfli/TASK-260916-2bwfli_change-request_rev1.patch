+		}
+		_, err := AcquireNetworkResolved(context.Background(), transportBase(t, tool, fixture), plan, providers, nil)
+		if err == nil || strings.Contains(err.Error(), secret) {
+			t.Fatalf("fail-closed error leaked the broker secret: %v", err)
