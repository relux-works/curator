+func TestCredentialProvidersResolveSSH(t *testing.T) {
+	identity := filepath.Join(t.TempDir(), "id_example")
+	knownHosts := filepath.Join(t.TempDir(), "known_hosts")
+	if err := os.WriteFile(identity, []byte("key"), 0o600); err != nil {
