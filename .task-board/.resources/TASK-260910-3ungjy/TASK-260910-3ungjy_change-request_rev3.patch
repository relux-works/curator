+		_, stdout, _ = capture(t, configPath, "status", "app", "--json")
+		rows, _ := decodeTrustDoc(t, stdout)
+		if len(rows) != 1 {
+			t.Fatalf("shell_hook_trust = %v, want the one unreadable row", rows)
+		}
+		row := rows[0]
