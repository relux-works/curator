        bin_dir = stage / "bin"
        bin_dir.mkdir(mode=0o700)
        artifact_name = request.command + (
            ".exe" if platform == PLATFORM_WINDOWS else ""
        )
        artifact_path = bin_dir / artifact_name
        artifact_rel = f"bin/{artifact_name}"

