+		t.Run(shape, func(t *testing.T) {
+			home := t.TempDir()
+			profile := "review"
+			source := "example.test/review"
+			repo := filepath.Join(home, "profile-repos", "example.test_review")
+			if err := os.MkdirAll(repo, 0700); err != nil {
+				t.Fatal(err)
+			}
+			git := func(args ...string) string {
+				c := exec.Command("git", args...)
+				c.Dir = repo
+				c.Env = append(os.Environ(), "GIT_CONFIG_NOSYSTEM=1", "GIT_CONFIG_GLOBAL="+filepath.Join(home, "absent-config"), "GIT_AUTHOR_NAME=fixture", "GIT_AUTHOR_EMAIL=fixture@example.invalid", "GIT_COMMITTER_NAME=fixture", "GIT_COMMITTER_EMAIL=fixture@example.invalid")
+				out, err := c.CombinedOutput()
+				if err != nil {
+					t.Fatalf("git %v: %v %s", args, err, out)
+				}
+				return strings.TrimSpace(string(out))
+			}
+			git("init", "--quiet", "--template="+t.TempDir())
+			files := map[string]string{"agent-context.json": `{"schema_version":1,"name":"review","version":"1.0.0","context":{"modules":[{"path":"a.md"}]}}`, "context/a.md": "clean\n"}
+			if strings.HasSuffix(shape, "module") {
+				files["context/a.md"] = "x\x00y\n"
+			} else if strings.HasSuffix(shape, "excluded") {
+				files["assets/deep/a.bin"] = "x\x00y"
+			}
+			for rel, body := range files {
+				p := filepath.Join(repo, rel)
+				if err := os.MkdirAll(filepath.Dir(p), 0700); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(p, []byte(body), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			git("add", "--all")
+			git("commit", "--quiet", "-m", "fixture")
+			commit := git("rev-parse", "HEAD")
+			if _, err := contextstore.EnsureGit(home, "context", profile, repo, commit); err != nil {
+				t.Fatal(err)
+			}
+			lock := &contextlock.Lock{SchemaVersion: 1, Root: profile, Members: []contextlock.Member{{Kind: "context", Name: profile, Source: source, Version: "1.0.0", Commit: commit, Weight: 100}}}
+			version := hashing.VersionV1
+			if strings.HasPrefix(shape, "v2-") {
+				lock.SchemaVersion = 2
+				lock.HashVersion = 2
+				version = hashing.VersionV2
+			}
+			canonical, err := lock.Canonical()
+			if err != nil {
+				t.Fatal(err)
+			}
+			pd := envprofile.ProfileDir(home, profile)
+			if err := privatedir.MakeAll(pd); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(pd, "lock.json"), canonical, 0600); err != nil {
+				t.Fatal(err)
+			}
+			raw, err := json.Marshal(envprofile.Source{Kind: envprofile.KindGit, Git: source, Req: envprofile.Requirement{Tag: "v1.0.0"}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(pd, "source.json"), raw, 0600); err != nil {
+				t.Fatal(err)
+			}
+			pass := []envmarker.Passthrough{}
+			seeds := []string{}
+			mark := &envmarker.Marker{Version: 1, Profile: envmarker.Profile{Name: profile, Root: profile, Kind: "git", Source: source, Requirement: &envmarker.Requirement{Tag: "v1.0.0"}, LockSHA256: hashing.Normalize(contextlock.HashBytes(canonical))}, Members: []envmarker.Member{{Name: profile, Version: "1.0.0", Commit: commit, Weight: 100}}, Precedence: envmarker.Precedence{Winner: "higher-weight", Placement: "winner-last"}, Mode: envmarker.ModeManagedHome, Surfaces: map[string]envmarker.Surface{}, Passthrough: &pass, Seeds: &seeds}
+			if version == hashing.VersionV2 {
+				mark.Version = 3
+				mark.HashVersion = 2
+			}
+			entry := contextstore.EntryDir(home, "context", profile, commit)
+			manifest, err := contextpkg.LoadManifest(entry)
+			if err != nil {
+				t.Fatal(err)
+			}
+			pkg := contextmaterialize.Package{HasContext: manifest.HasContext}
+			for _, module := range manifest.Modules {
+				body, err := os.ReadFile(filepath.Join(entry, "context", module.Path))
+				if err != nil {
+					t.Fatal(err)
+				}
+				pkg.Modules = append(pkg.Modules, contextmaterialize.Module{Module: module, Bytes: body})
+			}
+			doc, written, err := contextmaterialize.Monolithic(lock, contextlock.HashBytes(canonical), contextmaterialize.Precedence{Winner: "higher-weight", Placement: "winner-last"}, "claude_code", map[string]contextmaterialize.Package{profile: pkg})
+			if err != nil || !written {
+				t.Fatalf("assemble fixture document: %v written=%v", err, written)
+			}
+			adapter, err := envregistry.ByID("claude_code")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if version == hashing.VersionV2 && runtime.GOOS == "darwin" {
+				pass = []envmarker.Passthrough{{Isolation: envregistry.IsolationIsolated, Strategy: envregistry.StrategyPerHomeKeychain, SourceRole: "managed", Backend: "keychain", BackendVersion: adapter.VerifiedRelease, Provenance: "provisioned"}}
