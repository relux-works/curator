+func TestReviewFrozenV1RefusesExcludedNUL(t *testing.T) {
+	for _, shape := range []string{"runtime", "build", "unlisted"} {
+		t.Run(shape, func(t *testing.T) {
+			root := t.TempDir()
+			name := "assets/runtime/deep/a.bin"
+			if shape == "unlisted" {
+				name = "runtime/deep/a.bin"
+			}
+			writeFiles(t, root, map[string][]byte{"SKILL.md": []byte("# Test\n"), name: []byte("x\x00y")})
+			spec := &skillspec.Spec{}
+			if shape == "runtime" {
+				spec.RuntimeRoots = []string{"assets/runtime"}
+			}
+			if shape == "build" {
+				spec.BuildRoots = []string{"assets/runtime"}
+			}
+			var digest string
+			var err error
+			calls := hashing.CountV1Hashes(func() { digest, err = closure.ContentHashFor(root, spec) })
+			if calls != 0 {
+				t.Fatalf("frozen refusal computed %d v1 hashes", calls)
+			}
+			if err == nil || !strings.Contains(err.Error(), "audit.opaque.nul-byte") {
+				t.Fatalf("frozen v1 %s NUL = (%q,%v), want opaque refusal before projection/hash", shape, digest, err)
+			}
+		})
+	}
+}
+func TestReviewV2RejectsLegacyPin(t *testing.T) {
+	root := t.TempDir()
+	writeFiles(t, root, map[string][]byte{"assets/a.bin": []byte("x\x00y")})
+	digest, err := hashing.ContentSHA256WithVersion(root, nil, hashing.VersionV2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := newCfg(t, "strict", "off")
+	// Synthetic equal-text identity pair: schema 1 has implicit v1.
+	if _, err := Pin(cfg.Home(), digest, "legacy v1 approval", "fixture"); err != nil {
+		t.Fatal(err)
+	}
+	_, errs := Gate(cfg, []Subject{{Name: "modern", Snapshot: root, HashVersion: hashing.VersionV2, SchemaVersion: 2, Capabilities: capabilities.ImplicitNone()}})
+	if len(errs) == 0 {
+		t.Fatal("v2 NUL subject authorized by an unversioned legacy v1 pin")
+	}
+	if !strings.Contains(strings.Join(errs, "\n"), "requires pin") {
+		t.Fatalf("errors %v, want version-specific require-pin", errs)
+	}
+}
+func TestReviewNewV2PinCarrierVersion(t *testing.T) {
+	root := t.TempDir()
+	writeFiles(t, root, map[string][]byte{"a.md": []byte("clean")})
+	digest, err := hashing.ContentSHA256WithVersion(root, nil, hashing.VersionV2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path, err := PinAtVersion(t.TempDir(), digest, hashing.VersionV2, "v2 approval", "fixture")
+	if err != nil {
+		t.Fatal(err)
+	}
+	payload, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var record map[string]any
+	if err := json.Unmarshal(payload, &record); err != nil {
+		t.Fatal(err)
+	}
+	if record["hash_version"] != float64(2) {
+		t.Fatalf("new v2 pin hash_version=%v, want 2", record["hash_version"])
+	}
+}
