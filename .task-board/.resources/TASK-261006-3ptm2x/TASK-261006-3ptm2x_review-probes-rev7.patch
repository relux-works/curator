+func TestReviewSourceAuditNeverHashesNULV1(t *testing.T) {
+	root := t.TempDir()
+	writeFiles(t, root, map[string][]byte{"assets/a.bin": []byte("x\x00y")})
+	cfg := newCfg(t, "advisory", "off")
+	calls := hashing.CountV1Hashes(func() {
+		if _, err := CheckSourceAudit(cfg, sourceTestSubject(root, 3), true, sourceAuditTestNow); err == nil || !strings.Contains(err.Error(), "audit.opaque.nul-byte") {
+			t.Fatalf("source audit refusal=%v", err)
+		}
+	})
+	if calls != 0 {
+		t.Fatalf("production source audit computed %d v1 identities over NUL before refusing", calls)
+	}
