+func TestReviewResolveDraftRefusesExcludedNUL(t *testing.T) {
+	project, home := t.TempDir(), t.TempDir()
+	skill := filepath.Join(project, "skills", "review")
+	writeFiles(t, skill, map[string][]byte{
+		"SKILL.md":                  []byte("---\nname: review\ndescription: Test review\n---\n# review\n"),
+		"agent-skill.json":          []byte(`{"schema_version":4,"capabilities":{},"commands":{},"dependencies":{"skills":{}},"runtime_roots":["assets/runtime"]}`),
+		"assets/runtime/deep/a.bin": []byte("x\x00y"),
+	})
+	payload := []byte(`{"schema_version":2,"sources":{"s":{"path":"."}},"skills":[{"from":"s","directory":"skills","include":["review"]}]}`)
+	m, err := manifest.ParseBytes(payload, filepath.Join(project, "Skillfile.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := closure.ResolveDraft(closure.DraftResolveConfig{ProjectRoot: project, Home: home, Manifest: m, ManifestPayload: payload})
+	if err == nil {
+		t.Fatalf("ResolveDraft accepted NUL-bearing frozen v1 skill: %+v", result.Lock)
+	}
+	if !strings.Contains(err.Error(), "audit.opaque.nul-byte") {
+		t.Fatalf("ResolveDraft refusal %v, want opaque finding", err)
+	}
+}
+func TestReviewLegacyMarkerCollisionAndDowngrade(t *testing.T) {
+	prior := hashing.EnableV2Writers
+	defer func() { hashing.EnableV2Writers = prior }()
+	root := t.TempDir()
+	writeFiles(t, root, map[string][]byte{"assets/a.bin": []byte("x"), "docs/b.md": []byte("y")})
+	digest, err := hashing.ContentSHA256(root, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m := &marker.Marker{Name: "review", Source: "review", RefKind: "tag", Ref: "v1", Commit: strings.Repeat("1", 40), ContentSHA256: digest, InstalledAt: "2026-10-06T00:00:00Z", SkillSchemaVersion: 3}
+	hashing.EnableV2Writers = false
+	if err := marker.Write(root, m); err != nil {
+		t.Fatal(err)
+	}
+	if m.HashVersion != 0 {
+		t.Fatal("legacy marker unexpectedly versioned")
+	}
+	if current, err := marker.Current(root, m); err != nil || !current {
+		t.Fatalf("clean control %v %v", current, err)
+	}
+	writeFiles(t, root, map[string][]byte{"assets/a.bin": []byte("x\x00docs/b.md\x00y")})
+	if err := os.Remove(filepath.Join(root, "docs", "b.md")); err != nil {
+		t.Fatal(err)
+	}
+	if current, err := marker.Current(root, m); current || err == nil || !strings.Contains(err.Error(), "audit.opaque.nul-byte") {
+		t.Fatalf("legacy collision current=%v err=%v", current, err)
+	}
+	hashing.EnableV2Writers = true
+	if err := marker.Write(root, m); err != nil {
+		t.Fatal(err)
+	}
+	if current, err := marker.Current(root, m); err != nil || !current {
+		t.Fatalf("v2 NUL control %v %v", current, err)
+	}
+	path := filepath.Join(root, marker.Name)
+	payload, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var raw map[string]any
+	if err := json.Unmarshal(payload, &raw); err != nil {
+		t.Fatal(err)
+	}
+	raw["hash_version"] = 1
+	payload, err = json.Marshal(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, payload, 0644); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := marker.ReadState(root); err == nil {
+		t.Fatal("v2-to-v1 downgrade admitted")
+	}
+}
