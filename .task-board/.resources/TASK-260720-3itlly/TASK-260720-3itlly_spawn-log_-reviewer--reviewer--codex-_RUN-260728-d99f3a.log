	movedTags := detectMovedTags(projectRoot, nodes, deps.Generation)
	if len(movedTags) > 0 {
		if opts.StrictTags {
			result.failf("%s", strings.Join(movedTags, "; "))
			return result
		}
		for _, warning := range movedTags {
