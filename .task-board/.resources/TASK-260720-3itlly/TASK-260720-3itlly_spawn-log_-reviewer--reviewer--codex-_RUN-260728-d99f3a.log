	// toolchain state must never land in the checkout, the runtime store, or a
	// skill repository.
	deps, err := opts.Build.resolve(cfg.Home(), private, []string{
		projectRoot, filepath.Join(cfg.Home(), "runtime"), cfg.SkillsRoot,
	})
	if err != nil {
		result.failf("%v", err)
		return result
	}

