+func decodeStubReport(t *testing.T, stdout []byte) stubReport {
+	t.Helper()
+	var report stubReport
+	if err := json.Unmarshal(stdout, &report); err != nil {
+		t.Fatalf("cannot decode the stub report %q: %v", stdout, err)
+	}
+	return report
+}
