+	e.write(dir, "scripts/"+name+"-tool", "#!/bin/sh\necho "+name+"\n")
+	network := any("none")
+	if networkHosts != nil {
+		network = networkHosts
+	}
+	payload, _ := json.MarshalIndent(map[string]any{
