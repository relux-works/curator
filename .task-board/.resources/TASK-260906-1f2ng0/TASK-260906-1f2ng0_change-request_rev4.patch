@@ -0,0 +1,101 @@
+//go:build windows
+
+// Package testsupport contains test fixtures shared by platform-specific tests.
+package testsupport
+
+import (
+	"errors"
+	"os"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+// DenyPathRead adds a current-user DACL deny for reading a file or listing a
+// directory. It restores the original DACL and inheritance state in cleanup.
+func DenyPathRead(t *testing.T, path string, directory bool) func() {
+	t.Helper()
+
+	original, err := windows.GetNamedSecurityInfo(path, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION)
+	if err != nil {
+		t.Fatalf("read original DACL for unreadable test path %q: %v", path, err)
+	}
+	originalDACL, _, err := original.DACL()
+	if err != nil {
+		t.Fatalf("read original DACL for unreadable test path %q: %v", path, err)
+	}
+	control, _, err := original.Control()
+	if err != nil {
+		t.Fatalf("read original DACL control for unreadable test path %q: %v", path, err)
+	}
+	user, err := windows.GetCurrentProcessToken().GetTokenUser()
+	if err != nil {
+		t.Fatalf("read current user for unreadable test path %q: %v", path, err)
+	}
+
+	permission := windows.ACCESS_MASK(windows.FILE_READ_DATA)
+	if directory {
+		permission = windows.ACCESS_MASK(windows.FILE_LIST_DIRECTORY)
+	}
+	deny := windows.EXPLICIT_ACCESS{
+		AccessPermissions: permission,
+		AccessMode:        windows.DENY_ACCESS,
+		Inheritance:       windows.NO_INHERITANCE,
+		Trustee: windows.TRUSTEE{
+			TrusteeForm:  windows.TRUSTEE_IS_SID,
+			TrusteeType:  windows.TRUSTEE_IS_USER,
+			TrusteeValue: windows.TrusteeValueFromSID(user.User.Sid),
+		},
+	}
+	deniedDACL, err := windows.ACLFromEntries([]windows.EXPLICIT_ACCESS{deny}, originalDACL)
+	if err != nil {
+		t.Fatalf("build unreadable test DACL for %q: %v", path, err)
+	}
+	if err := windows.SetNamedSecurityInfo(
+		path,
+		windows.SE_FILE_OBJECT,
+		windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION,
+		nil,
+		nil,
+		deniedDACL,
+		nil,
+	); err != nil {
+		t.Fatalf("deny current-user reads of %q: %v", path, err)
+	}
+
+	restoreInfo := windows.SECURITY_INFORMATION(windows.DACL_SECURITY_INFORMATION)
+	if control&windows.SE_DACL_PROTECTED != 0 {
+		restoreInfo |= windows.PROTECTED_DACL_SECURITY_INFORMATION
+	} else {
+		restoreInfo |= windows.UNPROTECTED_DACL_SECURITY_INFORMATION
+	}
+	cleaned := false
+	cleanup := func() {
+		if cleaned {
+			return
+		}
+		cleaned = true
+		if err := windows.SetNamedSecurityInfo(path, windows.SE_FILE_OBJECT, restoreInfo, nil, nil, originalDACL, nil); err != nil {
+			t.Errorf("restore original DACL for unreadable test path %q: %v", path, err)
+		}
+	}
+	// Register before probing so even a failed assertion restores the path
+	// before its t.TempDir parent is removed. Callers may also defer this
+	// idempotent cleanup when they need the path restored before later checks.
+	t.Cleanup(cleanup)
+
+	var readErr error
+	if directory {
+		_, readErr = os.ReadDir(path)
+	} else {
+		_, readErr = os.ReadFile(path) // #nosec G304 -- reads the explicit path whose DACL this fixture changed
+	}
+	if !errors.Is(readErr, windows.ERROR_ACCESS_DENIED) {
+		cleanup()
+		if readErr == nil {
+			t.Fatalf("current-user DACL deny did not prevent reading test path %q", path)
+		}
+		t.Fatalf("read denied test path %q with %v, want access denied", path, readErr)
+	}
+	return cleanup
+}
