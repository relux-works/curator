+	}
+	installed := filepath.Join(e.project, ".agents", "skills", "golden-skill")
+	recorded := marker.Read(installed)
+	if recorded == nil || recorded.SchemaVersion != marker.ExternalSchemaVersion {
+		t.Fatalf("marker = %+v", recorded)
