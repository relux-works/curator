diff --git a/tests/test_delivery.py b/tests/test_delivery.py
new file mode 100644
index 0000000..9d0f3df
--- /dev/null
+++ b/tests/test_delivery.py
@@ -0,0 +1,117 @@
+import json
+import shutil
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class DeliveryTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        for directory in ("packages", "scripts"):
+            shutil.copytree(ROOT / directory, self.root / directory)
+
+    def gate(self):
+        return subprocess.run([str(self.root / "scripts/validate.sh")],
+                              text=True, capture_output=True)
+
+    def change(self, package, edit):
+        path = self.root / "packages" / package / "agent-mcp.json"
+        value = json.loads(path.read_text())
+        edit(value)
+        path.write_text(json.dumps(value))
+
+    def test_release(self):
+        self.assertEqual(self.gate().returncode, 0)
+
+    def test_refusals(self):
+        cases = [
+            ("safari", lambda d: d["server"].update(command="/tmp/driver")),
+            ("safari", lambda d: d["server"].update(command="dir/driver")),
+            ("safari", lambda d: d["server"].update(args=["--mcp", "--token=literal"])),
+            ("figma", lambda d: d["server"].update(url="https://mcp.figma.com/mcp?token=literal")),
+            ("figma", lambda d: d["server"].update(token="literal")),
+            ("figma", lambda d: d.update(unknown=True)),
+            ("figma", lambda d: d["server"].update(env_names=["HOME"])),
+            ("figma", lambda d: d.update(schema_version=True)),
+            ("figma", lambda d: d.pop("version")),
+        ]
+        for package, edit in cases:
+            with self.subTest(package=package, edit=edit):
+                shutil.rmtree(self.root / "packages")
+                shutil.copytree(ROOT / "packages", self.root / "packages")
+                self.change(package, edit)
+                self.assertEqual(self.gate().returncode, 1)
+
+    def test_missing_and_malformed(self):
+        path = self.root / "packages/figma/agent-mcp.json"
+        for content in ('{', '{"name":"figma","name":"safari"}', 'null'):
+            path.write_text(content)
+            self.assertEqual(self.gate().returncode, 1)
+        path.unlink()
+        self.assertEqual(self.gate().returncode, 1)
+
+    def test_narrowing_mutants(self):
+        # Each narrowed guard must admit its attack; the normal refusal assertion
+        # would then fail. Mutate copies only, never the candidate source.
+        cases = [
+            ("absolute command",
+             'if command != "safaridriver-mcp" or server["transport"] != "stdio":',
+             'if server["transport"] != "stdio":',
+             'if not isinstance(command, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", command):',
+             'if not isinstance(command, str) or command.startswith("./"):',
+             "safari", lambda d: d["server"].update(command="/tmp/driver")),
+            ("literal token",
+             'if server["args"] != ["--mcp"]:',
+             'if not server["args"] or server["args"][0] != "--mcp":',
+             None, None,
+             "safari", lambda d: d["server"].update(args=["--mcp", "--token=literal"])),
+            ("unknown field",
+             'if set(server) != expected:',
+             'if not expected.issubset(server):',
+             None, None,
+             "figma", lambda d: d["server"].update(token="literal")),
+        ]
+        original = (ROOT / "scripts/validate.py").read_text()
+        for name, old, new, old2, new2, package, edit in cases:
+            with self.subTest(mutant=name):
+                shutil.rmtree(self.root / "packages")
+                shutil.copytree(ROOT / "packages", self.root / "packages")
+                self.change(package, edit)
+                (self.root / "scripts/validate.py").write_text(original)
+                self.assertEqual(self.gate().returncode, 1)
+                mutated = original.replace(old, new)
+                if old2:
+                    mutated = mutated.replace(old2, new2)
+                (self.root / "scripts/validate.py").write_text(mutated)
+                self.assertEqual(self.gate().returncode, 0)
+                print(f"narrowing mutant killed: {name} (normal=1, narrowed=0)")
+
+    def test_wrapper_missing(self):
+        # Sandbox copy changes only the fixed installation path, never /Applications.
+        wrapper = (ROOT / "bin/safaridriver-mcp").read_text()
+        path = self.root / "wrapper"
+        path.write_text(wrapper.replace(
+            "/Applications/Safari Technology Preview.app/Contents/MacOS/safaridriver",
+            str(self.root / "absent")))
+        result = subprocess.run(["sh", str(path)], capture_output=True, text=True)
+        self.assertEqual(result.returncode, 127)
+        self.assertIn("missing or not executable", result.stderr)
+
+    def test_wrapper_forwarding(self):
+        fake = self.root / "fake driver"
+        fake.write_text('#!/bin/sh\nprintf "<%s>\\n" "$@"\nexit 23\n')
+        fake.chmod(0o755)
+        wrapper = (ROOT / "bin/safaridriver-mcp").read_text()
+        path = self.root / "wrapper"
+        path.write_text(wrapper.replace(
+            "/Applications/Safari Technology Preview.app/Contents/MacOS/safaridriver", str(fake)))
+        result = subprocess.run(["sh", str(path), "--mcp", "two words", ""],
+                                capture_output=True, text=True)
+        self.assertEqual(result.returncode, 23)
+        self.assertEqual(result.stdout, "<--mcp>\n<two words>\n<>\n")
