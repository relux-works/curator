diff --git a/scripts/validate.py b/scripts/validate.py
new file mode 100644
index 0000000..552e52d
--- /dev/null
+++ b/scripts/validate.py
@@ -0,0 +1,56 @@
+"""Validate the pinned release inventory, not arbitrary MCP declarations."""
+import json
+import re
+import sys
+from pathlib import Path
+
+
+def unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate JSON key")
+        result[key] = value
+    return result
+
+
+def validate(root):
+    paths = sorted((root / "packages").glob("*/agent-mcp.json"))
+    if {p.parent.name for p in paths} != {"figma", "safari"}:
+        raise ValueError("expected exactly figma and safari manifests")
+    for path in paths:
+        data = json.loads(path.read_text(), object_pairs_hook=unique_object)
+        if set(data) != {"schema_version", "name", "version", "server"}:
+            raise ValueError("unknown or missing manifest field")
+        if type(data["schema_version"]) is not int or data["schema_version"] != 1:
+            raise ValueError("schema_version must be 1")
+        if data["name"] != path.parent.name or data["version"] != "1.0.0":
+            raise ValueError("release identity must match package at version 1.0.0")
+        server = data["server"]
+        expected = ({"transport", "url", "env_names"} if data["name"] == "figma"
+                    else {"transport", "command", "args", "env_names"})
+        if set(server) != expected:
+            raise ValueError("unknown or missing server field")
+        # Upstream declares no environment credentials. Empty names are deliberate.
+        if server["env_names"] != []:
+            raise ValueError("pinned declarations have no credential environment names")
+        if data["name"] == "figma":
+            if server["transport"] != "http" or server["url"] != "https://mcp.figma.com/mcp":
+                raise ValueError("only the pinned credential-free HTTPS URL is allowed")
+        else:
+            command = server["command"]
+            if not isinstance(command, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", command):
+                raise ValueError("command must be bare, without paths")
+            if command != "safaridriver-mcp" or server["transport"] != "stdio":
+                raise ValueError("expected safaridriver-mcp stdio")
+            if server["args"] != ["--mcp"]:
+                raise ValueError("only --mcp is allowed; no paths or literal credentials")
+        print(f"{path.relative_to(root)}: valid")
+
+
+if __name__ == "__main__":
+    try:
+        validate(Path(sys.argv[1]))
+    except (ValueError, OSError, TypeError, KeyError) as error:
+        print(f"validation failed: {error}", file=sys.stderr)
+        sys.exit(1)
