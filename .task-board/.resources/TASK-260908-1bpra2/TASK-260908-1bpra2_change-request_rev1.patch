@@ -0,0 +1,7 @@
+#!/bin/sh
+driver='/Applications/Safari Technology Preview.app/Contents/MacOS/safaridriver'
+if [ ! -x "$driver" ]; then
+    echo 'safaridriver-mcp: Safari Technology Preview safaridriver is missing or not executable; install Safari Technology Preview 247+.' >&2
+    exit 127
+fi
+exec "$driver" "$@"
