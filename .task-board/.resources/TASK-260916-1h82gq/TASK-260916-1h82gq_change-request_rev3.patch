+// forcePreflightComplete forces the mandatory-control table complete
+// through the same production predicate, so tests drive the worker path
+// behind the preflight exactly as R3 will. Tests that use it stay
+// sequential and restore through Cleanup. Production has no other way to
+// set this seam: TestProductionBinaryRefusesWithoutSeam proves a fresh
+// production process still refuses.
+func forcePreflightComplete(t *testing.T) {
+	t.Helper()
+	complete := scriptpolicy.MandatoryControls()
+	for index := range complete {
+		complete[index].Implemented = true
+		complete[index].Owner = ""
+	}
+	restore := scriptpolicy.OverrideMandatoryControlsForTest(complete)
+	t.Cleanup(restore)
+	if len(scriptpolicy.MissingControls()) != 0 {
+		t.Fatalf("the forced table still misses %q", scriptpolicy.MissingControls())
+	}
+}
