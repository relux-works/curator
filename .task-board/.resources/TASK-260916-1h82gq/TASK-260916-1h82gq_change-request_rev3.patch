+func TestProductionBinaryRefusesWithoutSeam(t *testing.T) {
+	curator := mustPhysical(t, builtCuratorBinary(t))
+
+	// The `skill check` surface refuses, naming exactly the R3 controls.
+	skillDir := t.TempDir()
+	writeTestFile(t, filepath.Join(skillDir, "SKILL.md"), []byte("---\nname: s\ndescription: d\n---\n# s\n"), 0o644)
+	writeTestFile(t, filepath.Join(skillDir, "scripts", "tool"), []byte("print(1)\n"), 0o755)
+	writeTestFile(t, filepath.Join(skillDir, "agent-skill.json"), []byte(`{
+  "schema_version": 8,
+  "capabilities": {},
+  "commands": {"tool": {"type": "script", "unix_path": "scripts/tool",
+    "execution_policy": "script-worker-v1", "interpreter": "python3-v1"}}
+}`), 0o644)
+	check := exec.Command(curator, "skill", "check", skillDir)
+	check.Env = append(os.Environ(),
+		"HOME="+t.TempDir(),
+		"CURATOR_CONFIG="+filepath.Join(t.TempDir(), "config.json"))
+	output, err := check.CombinedOutput()
+	if err == nil {
+		t.Fatalf("skill check admitted an enforced command: %s", output)
+	}
+	if !strings.Contains(string(output), scriptpolicy.ControlUnavailable) {
+		t.Fatalf("skill check output does not name %s: %s", scriptpolicy.ControlUnavailable, output)
+	}
+	for _, missing := range []string{"inventory-controls-applied", "closed-script-capability-evidence-record"} {
+		if !strings.Contains(string(output), missing) {
+			t.Fatalf("skill check output does not name %s: %s", missing, output)
+		}
+	}
+	for _, implemented := range []string{"manager-built-environment", "manager-built-path", "offline-network-configuration"} {
+		if strings.Contains(string(output), implemented) {
+			t.Fatalf("skill check output still names implemented control %s: %s", implemented, output)
