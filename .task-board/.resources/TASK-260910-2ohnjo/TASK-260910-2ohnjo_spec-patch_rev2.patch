+# ---------------------------------------------------------------------------
+# S4: MCP env passthrough bounds and declaration surfacing
+# (environments.md sections 2.2, 2.3, 9.1, 9.2, 10.3, 12, 12.1)
+
+
+S4_WARN_PROFILE = "s4-warn"
+S4_ENFORCE_PROFILE = "s4-enforce"
+S4_PROFILES = ("s4-enforce", "s4-warn")
+
