   223	def _materialize_toolchain_entries(root: Path, entries: list[JsonObject]) -> None:
   224	    for entry in entries:
   225	        path = root / entry["path"]
   226	        if entry["type"] == "directory":
   227	            path.mkdir(parents=True, exist_ok=True)
   228	        elif entry["type"] == "file":
   229	            path.parent.mkdir(parents=True, exist_ok=True)
   230	            path.write_bytes(base64.b64decode(entry["content_base64"]))
   231	        elif entry["type"] == "symlink":
   232	            path.parent.mkdir(parents=True, exist_ok=True)
   233	            path.symlink_to(entry["target"])
   234	        else:
   235	            raise AssertionError(f"unknown toolchain entry type {entry['type']!r}")
