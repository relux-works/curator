    41	@lru_cache(maxsize=None)
    42	def _schema_validator(repository_root: Path, schema_name: str) -> Any:
    43	    schemas_root = repository_root / "schemas" / "v1"
    44	    documents = [
    45	        json.loads(path.read_text(encoding="utf-8"))
    46	        for path in (schemas_root / "common.schema.json", schemas_root / schema_name)
    47	    ]
    48	    registry = Registry().with_resources(
    49	        (document["$id"], Resource.from_contents(document))
    50	        for document in documents
    51	    )
    52	    schema = next(
    53	        document
    54	        for document in documents
    55	        if document["$id"].endswith(f"/{schema_name}")
    56	    )
    57	    validator_type = validator_for(schema)
    58	    validator_type.check_schema(schema)
    59	    return validator_type(schema, registry=registry)
