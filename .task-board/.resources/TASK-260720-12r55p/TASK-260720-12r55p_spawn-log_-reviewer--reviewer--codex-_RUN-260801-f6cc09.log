   159	def assert_build_source_case(
   160	    case: JsonObject,
   161	    all_cases: list[JsonObject],
   162	) -> None:
   163	    assert isinstance(case["name"], str) and case["name"]
   164	
   165	    records = case.get("records") or case.get("input_order")
   166	    if records is not None:
   167	        decoded = _decode_records(records)
   168	        assert hashing.build_source_sha256(decoded) == case["content_sha256"]
   169	        assert "sha256:" + hashlib.sha256(
   170	            base64.b64decode(case["preimage_base64"])
   171	        ).hexdigest() == case["content_sha256"]
   172	        return
   173	
   174	    if case["name"] == "mode-and-timestamp-are-non-inputs":
   175	        ordered = next(item for item in all_cases if "input_order" in item)
   176	        assert hashing.build_source_sha256(
   177	            _decode_records(ordered["input_order"])
   178	        ) == case["content_sha256"]
   179	        assert len({variant["mode"] for variant in case["variants"]}) == 2
   180	        assert len({variant["mtime"] for variant in case["variants"]}) == 2
   181	        return
   182	
   183	    if case["name"] == "invalid-unicode-build-source-path":
   184	        path = base64.b64decode(case["input"]["path_bytes_base64"]).decode(
   185	            "utf-8",
   186	            errors="surrogateescape",
   187	        )
   188	        with pytest.raises(hashing.HashingError):
   189	            hashing.build_source_sha256([(path, b"value")])
   190	        return
   191	
   192	    if case["name"] == "duplicate-build-source-path":
   193	        paths = case["input"]["paths"]
   194	        with pytest.raises(hashing.HashingError, match="duplicate"):
   195	            hashing.build_source_sha256(
   196	                [(path, str(index).encode("ascii")) for index, path in enumerate(paths)]
   197	            )
   198	        return
   199	
   200	    if case["name"] == "legacy-nul-stream-structural-collision":
   201	        one = hashing.build_source_sha256(_decode_records(case["one_file"]))
   202	        two = hashing.build_source_sha256(_decode_records(case["two_files"]))
   203	        assert [one, two] == case["framed_content_sha256"]
   204	        assert (one == two) is case["framed_hashes_equal"]
   205	        assert case["legacy_streams_equal"] is True
   206	        return
   207	
   208	    if case["name"] == "root-marker-bytes-are-build-input":
   209	        hashes = [variant["content_sha256"] for variant in case["variants"]]
   210	        assert len(set(hashes)) == len(hashes) == 2
   211	        assert case["build_source_hashes_equal"] is False
   212	        assert case["legacy_installed_tree_hashes_equal"] is True
   213	        return
   214	
   215	    expected = case["expected"]
   216	    assert case["boundary"] == "build-source"
   217	    assert expected["result"] == "reject"
   218	    assert expected["artifact_executed"] is False
   219	    assert expected["reuse"] is False
   220	    assert isinstance(expected["error"], str) and expected["error"]
