  1053	def _fingerprint_vector_toolchain(
  1054	    root: Path,
  1055	    go_version_stdout: bytes,
  1056	    protocol_link_targets: dict[str, str],
  1057	) -> toolchain.ToolchainIdentity:
  1058	    native_readlink = os.readlink
  1059	
  1060	    def read_vector_link(
  1061	        path: str | os.PathLike[str],
  1062	        *,
  1063	        dir_fd: int | None = None,
  1064	    ) -> str:
  1065	        if dir_fd is None:
  1066	            native_target = native_readlink(path)
  1067	        else:
