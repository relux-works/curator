   304	        command["source_dir"] = "missing/cmd/tool"
   305	    elif name == "unused-build-root":
   306	        manifest["build_roots"] = ["build", "unused"]
   307	    elif name == "overlapping-build-roots":
   308	        manifest["build_roots"] = ["build", "build/cmd"]
   309	    elif name == "runtime-overlapping-build-root":
