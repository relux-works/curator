   406	                "ImportPath": "example.test/dep",
   407	                "Name": "dep",
   408	                "Root": os.fspath(root),
   409	                "DepOnly": True,
   410	                "Module": {
   411	                    "Path": "example.test/dep",
   412	                    "Version": ""
   413	                    if name == "missing-vendored-dependency"
