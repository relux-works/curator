   208	def assert_generated_schema_case(
   209	    repository_root: Path,
   210	    conformance_root: Path,
   211	    entry: JsonObject,
   212	    tmp_path: Path,
   213	) -> None:
   214	    schema_name = entry["schema"]
   215	    instance_path = conformance_root / "schema-cases" / entry["instance"]
   216	    raw = instance_path.read_bytes()
   217	    instance = json.loads(raw)
   218	    expected_valid = entry["valid"]
   219	
   220	    schema_valid = _schema_validator(repository_root, schema_name).is_valid(instance)
   221	    semantic_valid = True
   222	    if schema_name == "conformance-claim-v3.schema.json" and schema_valid:
   223	        systems = set(instance["operating_systems"])
   224	        claims = instance["build_drivers"]
   225	        drivers = [claim["driver"] for claim in claims]
   226	        semantic_valid = (
   227	            "linux" not in systems
   228	            and len(drivers) == len(set(drivers))
   229	            and all(set(claim["operating_systems"]) <= systems for claim in claims)
   230	        )
   231	    assert (schema_valid and semantic_valid) is expected_valid
   232	
   233	    if schema_name in {"agent-skill-v6.schema.json", "csk-skill-v6.schema.json"}:
   234	        manifest_name = (
   235	            "agent-skill.json"
   236	            if schema_name == "agent-skill-v6.schema.json"
   237	            else "csk-skill.json"
   238	        )
   239	        snapshot = tmp_path / instance_path.parent.name / instance_path.stem
   240	        _materialize_skill_case(snapshot, manifest_name, raw)
   241	        if expected_valid:
   242	            spec = skillspec.load_skill_spec(snapshot)
   243	            assert spec.source_file == manifest_name
   244	            assert spec.schema_version == 6
   245	            assert spec.commands["build-tool"].driver == "go-v1"
   246	        else:
   247	            with pytest.raises(skillspec.SkillSpecError):
   248	                skillspec.load_skill_spec(snapshot)
   249	        return
   250	
   251	    if schema_name == "build-receipt-v1.schema.json":
   252	        if expected_valid:
   253	            assert metadata.parse_receipt(instance).schema_version == 1
   254	        else:
   255	            with pytest.raises(metadata.BuildMetadataError):
   256	                metadata.parse_receipt(instance)
   257	        return
   258	
   259	    if schema_name == "install-marker-v2.schema.json":
   260	        if expected_valid:
   261	            marker = install_marker.read_install_marker(raw)
   262	            assert isinstance(marker, install_marker.InstallMarkerV2)
   263	            assert marker.to_json() == instance
   264	        else:
   265	            with pytest.raises(install_marker.InstallMarkerError):
   266	                install_marker.read_install_marker(raw)
   267	
