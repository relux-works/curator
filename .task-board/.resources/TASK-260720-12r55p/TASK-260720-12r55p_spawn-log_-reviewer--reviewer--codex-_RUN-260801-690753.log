   400	        dep_dir = root / "vendor" / "example.test" / "dep"
   401	        dep_dir.mkdir(parents=True)
   402	        (dep_dir / "dep.go").write_text("package dep\n", encoding="utf-8")
   403	        packages.append(
   404	            {
