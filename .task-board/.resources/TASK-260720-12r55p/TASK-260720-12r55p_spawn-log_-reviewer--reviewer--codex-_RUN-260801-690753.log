   361	def _root_package(root: Path) -> JsonObject:
   362	    package_dir = root / "cmd"
   363	    package_dir.mkdir(parents=True, exist_ok=True)
   364	    (package_dir / "main.go").write_text(
   365	        "package main\nfunc main() {}\n",
