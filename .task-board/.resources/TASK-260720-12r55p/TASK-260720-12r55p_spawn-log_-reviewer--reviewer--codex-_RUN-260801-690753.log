   868	def assert_build_source_case(
   869	    case: JsonObject,
   870	    all_cases: list[JsonObject],
   871	    tmp_path: Path,
   872	) -> None:
   873	    name = case["name"]
   874	    known_names = {
   875	        "fixture-exact-build-source",
   876	        "domain-prefix-ordering-framing-empty-binary-and-root-marker",
   877	        "mode-and-timestamp-are-non-inputs",
   878	        "invalid-unicode-build-source-path",
   879	        "duplicate-build-source-path",
   880	        "build-source-symbolic-link",
   881	        "build-source-special-file",
   882	        "build-source-mutation-during-use",
   883	        "legacy-nul-stream-structural-collision",
   884	        "root-marker-bytes-are-build-input",
   885	    }
   886	    assert name in known_names, f"unbound build-source vector {name!r}"
   887	
   888	    records = case.get("records") or case.get("input_order")
   889	    if records is not None:
   890	        decoded = _decode_records(records)
   891	        assert hashing.build_source_sha256(decoded) == case["content_sha256"]
   892	        assert "sha256:" + hashlib.sha256(
   893	            base64.b64decode(case["preimage_base64"])
   894	        ).hexdigest() == case["content_sha256"]
   895	        root = tmp_path / "materialized"
   896	        for relative, content in decoded:
   897	            path = root / relative
   898	            path.parent.mkdir(parents=True, exist_ok=True)
   899	            path.write_bytes(content)
   900	        with source.freeze_snapshot(root) as frozen:
   901	            assert frozen.identity.content_sha256 == case["content_sha256"]
   902	        return
   903	
   904	    if name == "mode-and-timestamp-are-non-inputs":
   905	        ordered = next(item for item in all_cases if "input_order" in item)
   906	        identities = []
   907	        for index, variant in enumerate(case["variants"]):
   908	            root = tmp_path / f"variant-{index}"
   909	            for relative, content in _decode_records(ordered["input_order"]):
   910	                path = root / relative
   911	                path.parent.mkdir(parents=True, exist_ok=True)
   912	                path.write_bytes(content)
   913	                path.chmod(int(variant["mode"], 8))
   914	                timestamp = 946684800 if index == 0 else 1893456000
   915	                os.utime(path, (timestamp, timestamp))
   916	            with source.freeze_snapshot(root) as frozen:
   917	                identities.append(frozen.identity.content_sha256)
   918	        assert identities == [case["content_sha256"], case["content_sha256"]]
   919	        return
   920	
   921	    if name == "invalid-unicode-build-source-path":
   922	        path_text = base64.b64decode(case["input"]["path_bytes_base64"]).decode(
   923	            "utf-8",
   924	            errors="surrogateescape",
   925	        )
   926	        with pytest.raises(hashing.HashingError):
   927	            hashing.build_source_sha256([(path_text, b"value")])
   928	        return
   929	
   930	    if name == "duplicate-build-source-path":
   931	        paths = case["input"]["paths"]
   932	        with pytest.raises(hashing.HashingError, match="duplicate"):
   933	            hashing.build_source_sha256(
   934	                [(path, str(index).encode("ascii")) for index, path in enumerate(paths)]
   935	            )
   936	        return
   937	
   938	    if name == "build-source-symbolic-link":
   939	        root = tmp_path / "source-link"
   940	        root.mkdir()
   941	        target = root / "target"
   942	        target.write_bytes(b"target")
   943	        link = root / case["input"]["path"]
   944	        try:
   945	            link.symlink_to(target.name)
   946	            context = mock.patch.object(source, "_is_link_or_reparse", wraps=source._is_link_or_reparse)
   947	        except OSError:
   948	            link.write_bytes(b"synthetic-link")
   949	            context = mock.patch.object(
   950	                source,
   951	                "_is_link_or_reparse",
   952	                side_effect=lambda value: not stat.S_ISDIR(value.st_mode),
   953	            )
   954	        with context, pytest.raises(source.InvalidSnapshotError, match="link forbidden"):
   955	            source.freeze_snapshot(root)
   956	        assert case["expected"]["error"] == "link_forbidden"
   957	        return
   958	
   959	    if name == "build-source-special-file":
   960	        root = tmp_path / "source-special"
   961	        root.mkdir()
   962	        special = root / case["input"]["path"]
   963	        if hasattr(os, "mkfifo"):
   964	            os.mkfifo(special)
   965	            context = mock.patch.object(source.stat, "S_ISREG", wraps=source.stat.S_ISREG)
   966	        else:
   967	            special.write_bytes(b"synthetic-special")
   968	            context = mock.patch.object(source.stat, "S_ISREG", return_value=False)
   969	        with context, pytest.raises(source.InvalidSnapshotError, match="special file forbidden"):
   970	            source.freeze_snapshot(root)
   971	        assert case["expected"]["error"] == "special_file_forbidden"
   972	        return
   973	
   974	    if name == "build-source-mutation-during-use":
   975	        root = tmp_path / "source-mutation"
   976	        root.mkdir()
   977	        payload = root / "payload"
   978	        payload.write_bytes(b"before")
   979	        frozen = source.freeze_snapshot(root)
   980	        try:
   981	            def mutate(_snapshot: source.FrozenSnapshot) -> None:
   982	                payload.write_bytes(b"after")
   983	
   984	            with pytest.raises(source.SnapshotMutationError):
   985	                frozen.use(mutate)
   986	        finally:
   987	            frozen.close()
   988	        assert case["expected"]["error"] == "snapshot_mutated"
   989	        return
   990	
   991	    if name == "legacy-nul-stream-structural-collision":
   992	        one = hashing.build_source_sha256(_decode_records(case["one_file"]))
   993	        two = hashing.build_source_sha256(_decode_records(case["two_files"]))
   994	        assert [one, two] == case["framed_content_sha256"]
   995	        assert (one == two) is case["framed_hashes_equal"]
   996	        assert case["legacy_streams_equal"] is True
   997	        return
   998	
   999	    if name == "root-marker-bytes-are-build-input":
  1000	        hashes = [variant["content_sha256"] for variant in case["variants"]]
  1001	        assert len(set(hashes)) == len(hashes) == 2
  1002	        assert case["build_source_hashes_equal"] is False
  1003	        assert case["legacy_installed_tree_hashes_equal"] is True
  1004	        return
  1005	
  1006	    raise AssertionError(f"unimplemented build-source vector {name!r}")
