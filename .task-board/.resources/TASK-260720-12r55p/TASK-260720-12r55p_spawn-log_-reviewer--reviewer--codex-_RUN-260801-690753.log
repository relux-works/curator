   270	    return {
   271	        "schema_version": 6,
   272	        "runtime_roots": [],
   273	        "build_roots": ["build"],
   274	        "commands": {
   275	            "tool": {
   276	                "type": "build",
   277	                "driver": "go-v1",
   278	                "source_dir": "build/cmd/tool",
   279	            }
   280	        },
   281	        "capabilities": {},
   282	        "dependencies": {"commands": {}, "mcp_servers": {}, "skills": {}},
