   172	@lru_cache(maxsize=None)
   173	def _schema_validator(repository_root: Path, schema_name: str) -> Any:
   174	    schemas_root = repository_root / "schemas" / "v1"
   175	    documents = [
   176	        json.loads(path.read_text(encoding="utf-8"))
   177	        for path in (schemas_root / "common.schema.json", schemas_root / schema_name)
   178	    ]
   179	    registry = Registry().with_resources(
   180	        (document["$id"], Resource.from_contents(document))
   181	        for document in documents
   182	    )
   183	    schema = next(
   184	        document
   185	        for document in documents
   186	        if document["$id"].endswith(f"/{schema_name}")
   187	    )
   188	    validator_type = validator_for(schema)
   189	    validator_type.check_schema(schema)
   190	    return validator_type(schema, registry=registry)
