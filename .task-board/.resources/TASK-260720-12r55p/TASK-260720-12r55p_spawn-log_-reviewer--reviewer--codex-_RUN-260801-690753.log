   472	def _probe_compiler_rejection(name: str, tmp_path: Path) -> str:
   473	    root = tmp_path / f"compiler-{name}"
   474	    package = _root_package(root)
   475	    source_text = {
   476	        "cgo-import-dynamic": (
   477	            "package main\n//go:cgo_import_dynamic x y \"z\"\nfunc main() {}\n"
   478	        ),
   479	        "attempted-go-generate": (
   480	            "package main\n//go:generate sh -c poison\nfunc main() {}\n"
   481	        ),
   482	        "default-pgo": "package main\nfunc main() {}\n",
   483	    }[name]
   484	    (root / "cmd" / "main.go").write_text(source_text, encoding="utf-8")
   485	    if name == "default-pgo":
   486	        (root / "cmd" / "default.pgo").write_text("pgo", encoding="utf-8")
   487	    with pytest.raises(go_v1.GoV1Error) as raised:
   488	        go_v1.validate_package_graph(
   489	            _package_payload([package]),
   490	            build_root=root,
   491	            source_dir=root / "cmd",
   492	            goroot=tmp_path / "goroot",
   493	        )
   494	    return raised.value.code
