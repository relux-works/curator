   361	def _root_package(root: Path) -> JsonObject:
   362	    package_dir = root / "cmd"
   363	    package_dir.mkdir(parents=True, exist_ok=True)
   364	    (package_dir / "main.go").write_text(
   365	        "package main\nfunc main() {}\n",
   366	        encoding="utf-8",
   367	    )
   368	    go_mod = root / "go.mod"
   369	    go_mod.write_text("module example.test/tool\ngo 1.25\n", encoding="utf-8")
   370	    return {
   371	        "Dir": os.fspath(package_dir),
   372	        "ImportPath": "example.test/tool/cmd",
   373	        "Name": "main",
   374	        "Root": os.fspath(root),
   375	        "Module": {
   376	            "Path": "example.test/tool",
   377	            "Main": True,
   378	            "Dir": os.fspath(root),
   379	            "GoMod": os.fspath(go_mod),
   380	        },
   381	        "GoFiles": ["main.go"],
   382	    }
   383	
