   193	def _materialize_skill_case(snapshot: Path, manifest_name: str, raw: bytes) -> None:
   194	    (snapshot / "build" / "cmd" / "tool").mkdir(parents=True)
   195	    (snapshot / "build" / "go.mod").write_text(
   196	        "module example.com/conformance\n",
   197	        encoding="utf-8",
   198	    )
   199	    (snapshot / "build" / "cmd" / "tool" / "main.go").write_text(
   200	        "package main\nfunc main() {}\n",
   201	        encoding="utf-8",
   202	    )
   203	    (snapshot / "scripts").mkdir()
   204	    (snapshot / "scripts" / "tool").write_text("#!/bin/sh\n", encoding="utf-8")
   205	    (snapshot / manifest_name).write_bytes(raw)
