   497	def _probe_cache_rejection(name: str, vectors: JsonObject) -> str:
   498	    portable = vectors["portable_identity"]
   499	    raw = base64.b64decode(portable["stored_receipt_base64"])
   500	    build_input = metadata.parse_build_input(portable["build_input"])
   501	    if name == "self-consistent-forged-receipt-outside-protected-state":
   502	        vector = next(
   503	            item for item in vectors["rejection_cases"] if item["name"] == name
   504	        )
   505	        candidate = vector["candidate"]
   506	        candidate_raw = protocol_json.canonical_bytes(candidate["receipt"])
   507	        candidate_input = metadata.parse_build_input(candidate["receipt"]["input"])
   508	        receipt = metadata.verify_receipt(
   509	            candidate_raw,
   510	            expected_input=candidate_input,
   511	            expected_cache_key=candidate["receipt"]["cache_key"],
   512	            expected_receipt_sha256=candidate["receipt_sha256"],
   513	        )
   514	        assert receipt.artifact.sha256 == candidate["receipt"]["artifact"]["sha256"]
   515	        inspection = cache.CacheInspection(
   516	            cache.CacheEntryStatus.UNTRUSTED_PROVENANCE,
   517	            "candidate is outside manager-protected state",
   518	        )
   519	        assert inspection.reusable is False
   520	        assert inspection.dry_run_outcome == vector["expected"]["dry_run"]
   521	        assert vector["cache_boundary"]["manager_created"] is False
   522	        assert vector["cache_boundary"]["other_principals_can_write"] is True
   523	        assert vector["expected"]["marker_current"] is False
   524	        return "untrusted_provenance"
   525	    if name == "cache-key-mismatch":
   526	        with pytest.raises(metadata.BuildMetadataError) as raised:
   527	            metadata.verify_receipt(
   528	                raw,
   529	                expected_input=build_input,
   530	                expected_cache_key="sha256:" + "0" * 64,
   531	                expected_receipt_sha256=portable["receipt_sha256"],
   532	            )
   533	        return raised.value.code
   534	    if name.startswith("cache-wrong-"):
   535	        if name == "cache-wrong-target":
   536	            changed = replace(
   537	                build_input,
   538	                target=replace(
   539	                    build_input.target,
   540	                    tuning={"GOARM64": "v8.1"},
   541	                ),
   542	            )
   543	        elif name == "cache-wrong-toolchain":
   544	            changed = replace(
   545	                build_input,
   546	                toolchain=replace(build_input.toolchain, content_sha256="sha256:" + "d" * 64),
   547	            )
   548	        elif name == "cache-wrong-policy":
   549	            changed_policy = replace(build_input.policy)
   550	            object.__setattr__(
   551	                changed_policy,
   552	                "execution_policy",
   553	                "reserved-hardened-v1",
   554	            )
   555	            changed = replace(build_input, policy=changed_policy)
   556	        else:
   557	            changed = replace(
   558	                build_input,
   559	                build_source=replace(
   560	                    build_input.build_source,
   561	                    content_sha256="sha256:" + "e" * 64,
   562	                ),
   563	            )
   564	        with pytest.raises(metadata.BuildMetadataError) as raised:
   565	            metadata.verify_receipt(
   566	                raw,
   567	                expected_input=changed,
   568	            )
   569	        return raised.value.code
   570	    if name == "receipt-hash-mismatch":
   571	        with pytest.raises(metadata.BuildMetadataError) as raised:
   572	            metadata.verify_receipt(
   573	                raw,
   574	                expected_input=build_input,
   575	                expected_cache_key=portable["cache_key"],
   576	                expected_receipt_sha256="sha256:" + "0" * 64,
   577	            )
   578	        return raised.value.code
   579	    if name in {"noncanonical-receipt-whitespace", "noncanonical-receipt-trailing-lf"}:
   580	        poisoned = (b" " + raw) if name.endswith("whitespace") else (raw + b"\n")
   581	        with pytest.raises(metadata.BuildMetadataError) as raised:
   582	            metadata.verify_receipt(
   583	                poisoned,
   584	                expected_input=build_input,
   585	                expected_cache_key=portable["cache_key"],
   586	                expected_receipt_sha256="sha256:" + hashlib.sha256(poisoned).hexdigest(),
   587	            )
   588	        return raised.value.code
   589	    if name == "artifact-path-mismatch":
   590	        receipt = json.loads(raw)
   591	        receipt["artifact"]["path"] = "bin/not-golden-tool"
   592	        poisoned = protocol_json.canonical_bytes(receipt)
   593	        with pytest.raises(metadata.BuildMetadataError) as raised:
   594	            metadata.verify_receipt(
   595	                poisoned,
   596	                expected_input=build_input,
   597	                expected_cache_key=portable["cache_key"],
   598	                expected_receipt_sha256="sha256:" + hashlib.sha256(poisoned).hexdigest(),
   599	            )
   600	        return raised.value.code
   601	
   602	    receipt = metadata.verify_receipt(
   603	        raw,
   604	        expected_input=build_input,
   605	        expected_cache_key=portable["cache_key"],
   606	        expected_receipt_sha256=portable["receipt_sha256"],
   607	    )
   608	    assert receipt.input == build_input
   609	    assert cache.CacheInspection(cache.CacheEntryStatus.CORRUPT, name).reusable is False
