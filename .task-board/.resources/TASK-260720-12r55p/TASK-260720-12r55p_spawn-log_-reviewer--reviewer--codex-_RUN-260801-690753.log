   770	def assert_build_rejection_case(
   771	    case: JsonObject,
   772	    vectors: JsonObject,
   773	    conformance_root: Path,
   774	    tmp_path: Path,
   775	) -> None:
   776	    name = case.get("name")
   777	    assert isinstance(name, str) and name in _BUILD_REJECTION_BINDINGS, (
   778	        f"unbound build rejection vector {name!r}"
   779	    )
   780	    if name == "self-consistent-forged-receipt-outside-protected-state":
   781	        assert set(case) == {
   782	            "boundary",
   783	            "cache_boundary",
   784	            "candidate",
   785	            "expected",
   786	            "name",
   787	        }
   788	        assert set(case["expected"]) == {
   789	            "artifact_executed",
   790	            "dry_run",
   791	            "error",
   792	            "marker_current",
   793	            "real_operation",
   794	            "result",
   795	            "reuse",
   796	        }
   797	    else:
   798	        assert set(case) == {"boundary", "expected", "input", "name"}
   799	        if name == "marker-embed-build-source-regression":
   800	            assert set(case["input"]) == {
   801	                "candidate_command",
   802	                "directive",
   803	                "legacy_content_sha256",
   804	                "variants",
   805	            }
   806	            assert set(case["expected"]) == {
   807	                "artifact_executed",
   808	                "build_source_hashes_equal",
   809	                "cache_keys_created",
   810	                "error",
   811	                "go_commands",
   812	                "legacy_content_hashes_equal",
   813	                "result",
   814	                "reuse",
   815	            }
   816	        elif case["boundary"] == "execution-policy":
   817	            assert set(case["input"]) == {
   818	                "build_input",
   819	                "condition",
   820	                "derived_cache_key",
   821	                "execution_policy",
   822	            }
   823	            assert set(case["expected"]) == {
   824	                "aliases_portable_cache_key",
   825	                "artifact_executed",
   826	                "cache_lookup_performed",
   827	                "error",
   828	                "result",
   829	                "reuse",
   830	                "schema_valid",
   831	            }
   832	            assert case["expected"]["aliases_portable_cache_key"] is False
   833	            assert case["expected"]["cache_lookup_performed"] is False
   834	            assert case["expected"]["schema_valid"] is False
   835	        else:
   836	            assert set(case["input"]) == {"condition"}
   837	            assert set(case["expected"]) == {
   838	                "artifact_executed",
   839	                "error",
   840	                "result",
   841	                "reuse",
   842	            }
   843	    boundary, observed_error = _BUILD_REJECTION_BINDINGS[name]
   844	    assert case["boundary"] == boundary
   845	    expected = case["expected"]
   846	    assert expected["result"] == "reject"
   847	    assert expected["artifact_executed"] is False
   848	    assert expected["reuse"] is False
   849	
   850	    if boundary in {"manifest", "filesystem", "module"}:
   851	        _probe_skill_spec_rejection(name, tmp_path)
   852	    elif boundary == "dependency-graph":
   853	        observed_error = _probe_package_graph_rejection(name, tmp_path)
   854	    elif boundary == "compiler-directive":
   855	        observed_error = _probe_compiler_rejection(name, tmp_path)
   856	    else:
   857	        observed_error = _probe_other_rejection(
   858	            name,
   859	            boundary,
   860	            vectors,
   861	            conformance_root,
   862	            tmp_path,
   863	        )
   864	    assert observed_error == _BUILD_REJECTION_BINDINGS[name][1]
   865	    assert expected["error"] == observed_error
