   286	def _probe_skill_spec_rejection(name: str, tmp_path: Path) -> None:
   287	    manifest = _base_skill_manifest()
   288	    command = manifest["commands"]["tool"]
   289	    assert isinstance(command, dict)
   290	    if name == "schema-5-build-command":
   291	        manifest["schema_version"] = 5
   292	        manifest.pop("build_roots")
   293	    elif name == "unknown-driver":
   294	        command["driver"] = "unknown"
   295	    elif name.startswith("forbidden-"):
   296	        field = name.removeprefix("forbidden-")
   297	        command[field] = [] if field in {"args", "hooks"} else "forbidden"
   298	    elif name == "mixed-script-build-shape":
   299	        command["unix_path"] = "scripts/tool"
   300	    elif name == "missing-build-roots":
   301	        manifest.pop("build_roots")
   302	    elif name == "missing-build-root-directory":
   303	        manifest["build_roots"] = ["missing"]
   304	        command["source_dir"] = "missing/cmd/tool"
   305	    elif name == "unused-build-root":
   306	        manifest["build_roots"] = ["build", "unused"]
   307	    elif name == "overlapping-build-roots":
   308	        manifest["build_roots"] = ["build", "build/cmd"]
   309	    elif name == "runtime-overlapping-build-root":
   310	        manifest["runtime_roots"] = ["build"]
   311	    elif name == "root-build-root":
   312	        manifest["build_roots"] = ["."]
   313	    elif name == "root-source-dir":
   314	        command["source_dir"] = "."
   315	    elif name == "escaped-source-dir":
   316	        command["source_dir"] = "build/../outside"
   317	    elif name == "source-outside-root":
   318	        command["source_dir"] = "scripts"
   319	
   320	    snapshot = tmp_path / f"skill-{name}"
   321	    _materialize_skill_case(
   322	        snapshot,
   323	        "agent-skill.json",
   324	        protocol_json.canonical_bytes(manifest),
   325	    )
   326	    if name == "unused-build-root":
   327	        (snapshot / "unused").mkdir()
   328	    elif name == "build-root-symlink":
   329	        build = snapshot / "build"
   330	        build.rename(snapshot / "real-build")
   331	        try:
   332	            build.symlink_to("real-build", target_is_directory=True)
   333	        except OSError:
   334	            build.write_bytes(b"not-a-directory")
   335	    elif name == "build-root-special-file":
   336	        build = snapshot / "build"
   337	        build.rename(snapshot / "real-build")
   338	        build.write_bytes(b"not-a-directory")
   339	    elif name in {"source-link", "source-special-file", "source-not-directory"}:
   340	        source_dir = snapshot / "build" / "cmd" / "tool"
   341	        source_dir.rename(source_dir.with_name("real-tool"))
   342	        if name == "source-link":
   343	            try:
   344	                source_dir.symlink_to("real-tool", target_is_directory=True)
   345	            except OSError:
   346	                source_dir.write_bytes(b"not-a-directory")
   347	        else:
   348	            source_dir.write_bytes(b"not-a-directory")
   349	    elif name == "missing-root-go-mod":
   350	        (snapshot / "build" / "go.mod").rename(snapshot / "build" / "go.mod.absent")
   351	    elif name == "nested-module":
   352	        (snapshot / "build" / "cmd" / "tool" / "go.mod").write_text(
   353	            "module example.com/nested\n",
   354	            encoding="utf-8",
   355	        )
   356	
   357	    with pytest.raises(skillspec.SkillSpecError):
   358	        skillspec.load_skill_spec(snapshot)
   359	
