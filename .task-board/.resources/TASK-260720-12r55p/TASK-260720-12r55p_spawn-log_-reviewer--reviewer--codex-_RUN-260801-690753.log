  1021	def _materialize_toolchain_entries(
  1022	    root: Path,
  1023	    entries: list[JsonObject],
  1024	) -> dict[str, str]:
  1025	    unknown = {entry["type"] for entry in entries} - {"directory", "file", "symlink"}
  1026	    assert not unknown, f"unknown toolchain entry types {sorted(unknown)!r}"
  1027	    protocol_link_targets: dict[str, str] = {}
  1028	
  1029	    # The vector is intentionally unsorted.  Materialize links last because
  1030	    # Windows classifies a new link from its target and may otherwise preserve
  1031	    # an unusable dangling reparse point; fingerprinting still consumes the
  1032	    # native tree order and must canonicalize it itself.
  1033	    for entry_type in ("directory", "file", "symlink"):
  1034	        for entry in entries:
  1035	            if entry["type"] != entry_type:
  1036	                continue
  1037	            path = root / entry["path"]
  1038	            if entry_type == "directory":
  1039	                path.mkdir(parents=True, exist_ok=True)
  1040	            elif entry_type == "file":
  1041	                path.parent.mkdir(parents=True, exist_ok=True)
  1042	                path.write_bytes(base64.b64decode(entry["content_base64"]))
  1043	            else:
  1044	                path.parent.mkdir(parents=True, exist_ok=True)
  1045	                protocol_target = entry["target"]
  1046	                native_target = Path(*PurePosixPath(protocol_target).parts)
  1047	                path.symlink_to(native_target)
  1048	                protocol_link_targets[_native_path_key(path)] = protocol_target
  1049	
  1050	    return protocol_link_targets
  1051	
