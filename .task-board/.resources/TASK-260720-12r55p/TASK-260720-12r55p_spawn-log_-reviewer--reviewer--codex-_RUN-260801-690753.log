   388	
   389	def _probe_package_graph_rejection(name: str, tmp_path: Path) -> str:
   390	    root = tmp_path / f"graph-{name}"
   391	    package = _root_package(root)
   392	    packages = [package]
   393	    if name == "non-main-package":
   394	        package["Name"] = "library"
   395	    elif name == "multiple-packages":
   396	        second = json.loads(json.dumps(package))
   397	        second["ImportPath"] = "example.test/tool/second"
   398	        packages.append(second)
   399	    elif name in {"missing-vendored-dependency", "inconsistent-vendor-modules"}:
   400	        dep_dir = root / "vendor" / "example.test" / "dep"
   401	        dep_dir.mkdir(parents=True)
   402	        (dep_dir / "dep.go").write_text("package dep\n", encoding="utf-8")
   403	        packages.append(
   404	            {
   405	                "Dir": os.fspath(dep_dir),
   406	                "ImportPath": "example.test/dep",
   407	                "Name": "dep",
   408	                "Root": os.fspath(root),
   409	                "DepOnly": True,
   410	                "Module": {
   411	                    "Path": "example.test/dep",
   412	                    "Version": ""
   413	                    if name == "missing-vendored-dependency"
   414	                    else "v1.0.0",
   415	                    "Dir": os.fspath(dep_dir),
   416	                },
   417	                "GoFiles": ["dep.go"],
   418	            }
   419	        )
   420	    elif name == "workspace-only-dependency":
   421	        (root / "go.work").write_text("go 1.25\n", encoding="utf-8")
   422	        with pytest.raises(go_v1.GoV1Error) as raised:
   423	            go_v1._canonical_build_directories(
   424	                SimpleNamespace(path=tmp_path),
   425	                root.name,
   426	                f"{root.name}/cmd",
   427	            )
   428	        return raised.value.code
   429	    elif name == "cgo-only-package":
   430	        package["CgoFiles"] = ["main.go"]
   431	    elif name == "native-c-input":
   432	        package["CFiles"] = ["input.c"]
   433	    elif name == "native-cxx-input":
   434	        package["CXXFiles"] = ["input.cc"]
   435	    elif name == "native-swig-input":
   436	        package["SwigFiles"] = ["input.swig"]
   437	    elif name == "root-syso":
   438	        package["SysoFiles"] = ["root.syso"]
   439	    elif name in {"transitive-syso", "transitive-assembly-escaping-include"}:
   440	        dep_dir = root / "internal" / "dep"
   441	        dep_dir.mkdir(parents=True)
   442	        (dep_dir / "dep.go").write_text("package dep\n", encoding="utf-8")
   443	        dep = json.loads(json.dumps(package))
   444	        dep.update(
   445	            {
   446	                "Dir": os.fspath(dep_dir),
   447	                "ImportPath": "example.test/tool/internal/dep",
   448	                "Name": "dep",
   449	                "DepOnly": True,
   450	                "GoFiles": ["dep.go"],
   451	            }
   452	        )
   453	        dep["SysoFiles" if name == "transitive-syso" else "SFiles"] = ["input"]
   454	        packages.append(dep)
   455	    elif name == "root-assembly-absolute-include":
   456	        package["SFiles"] = ["root.s"]
   457	    elif name == "escaped-embed-input":
   458	        outside = tmp_path / "outside.txt"
   459	        outside.write_text("escape", encoding="utf-8")
   460	        package["EmbedFiles"] = [os.fspath(outside)]
   461	
   462	    with pytest.raises(go_v1.GoV1Error) as raised:
   463	        go_v1.validate_package_graph(
   464	            _package_payload(packages),
   465	            build_root=root,
   466	            source_dir=root / "cmd",
   467	            goroot=tmp_path / "goroot",
   468	        )
   469	    return raised.value.code
   470	
