def alter(v):
  if isinstance(v,bool): return not v
  if isinstance(v,str): return v+'-MUTATED'
  raise TypeError(type(v))

def run(v):
  case=next(x for x in v['positive_cases'] if x['name']=='fixed-environment-and-five-direct-argv-forms')
  with tempfile.TemporaryDirectory() as d:
