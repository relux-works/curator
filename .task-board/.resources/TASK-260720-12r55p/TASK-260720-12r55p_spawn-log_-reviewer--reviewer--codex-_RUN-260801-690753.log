  1460	def _normalized_environment(
  1461	    environment: Any,
  1462	    *,
  1463	    operation_root: Path,
  1464	    goroot: Path,
  1465	) -> dict[str, str]:
  1466	    operation = os.fspath(operation_root)
  1467	    trusted = os.fspath(goroot)
  1468	    normalized: dict[str, str] = {}
  1469	    for name, value in dict(environment).items():
  1470	        if value == trusted:
  1471	            value = "<resolved-trusted-goroot>"
  1472	        elif name == "XDG_CONFIG_HOME" and (
  1473	            value == operation or value.startswith(operation + os.sep)
  1474	        ):
  1475	            # The shared placeholder names the private configuration role;
  1476	            # Darwin's physical Go telemetry location is below Library.
  1477	            value = "<operation-private>/config"
  1478	        elif value == operation:
  1479	            value = "<operation-private>"
  1480	        elif value.startswith(operation + os.sep):
  1481	            suffix = value[len(operation) :].replace(os.sep, "/")
  1482	            value = "<operation-private>" + suffix
  1483	        normalized[name] = value
  1484	    return dict(sorted(normalized.items()))
