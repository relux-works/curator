def leaves(x:Any,p=()):
 if isinstance(x,dict):
  for k,y in x.items():
   if p==() and k=='name': continue
   yield from leaves(y,p+(k,))
 elif isinstance(x,list):
  if not x: yield p
  else:
   for i,y in enumerate(x): yield from leaves(y,p+(i,))
 else: yield p

def alt(x):
 if isinstance(x,bool): return not x
 if isinstance(x,str): return x+'-MUTATED'
 if isinstance(x,int): return x+1
 if x is None:return 'MUTATED'
 if isinstance(x,list) and not x:return ['MUTATED']
 raise TypeError(type(x))

def setp(x,p):
 cur=x
 for q in p[:-1]:cur=cur[q]
 cur[p[-1]]=alt(cur[p[-1]])

def audit(key,func:Callable):
 passed=[];caught=[]
 for case in v[key]:
  for p in leaves(case):
   m=copy.deepcopy(case);setp(m,p)
   with tempfile.TemporaryDirectory() as d:
    try:func(m,v[key],Path(d))
    except BaseException as e:caught.append((case['name'],p,type(e).__name__))
    else:passed.append((case['name'],p))
 print(key,'leaf_mutations',len(passed)+len(caught),'caught',len(caught),'passed',len(passed))
 for n,p in passed:print('PASS',n,'.'.join(map(str,p)),sep='\\t')
audit('build_source_cases',assert_build_source_case)
audit('toolchain_cases',assert_toolchain_case)
