+    def preserve_unexecutable_launcher(
+        path: Path,
+        mode: int,
+        *args: Any,
+        **kwargs: Any,
+    ) -> None:
+        if os.path.normcase(os.path.abspath(path)) == launcher_key:
+            return
+        real_chmod(path, mode, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "chmod", preserve_unexecutable_launcher)
