        if (
            _optional_bool(item.get("Incomplete"))
            or item.get("Error") is not None
            or bool(_optional_list(item.get("DepsErrors")))
        ):
            raise GoV1Error(
                "go_list_incomplete",
                f"package {_optional_string(item.get('ImportPath'))!r} "
                "is incomplete or carries load errors",
