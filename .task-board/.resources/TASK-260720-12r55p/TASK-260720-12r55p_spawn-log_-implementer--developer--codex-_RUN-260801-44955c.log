+@pytest.mark.parametrize(
+    "rule",
+    CLAIM_QUALIFICATION_VECTORS.get("rules", []),
+    ids=lambda rule: rule["name"],
+)
+def test_rc6_claim_qualification_rule(rule: dict[str, Any]) -> None:
