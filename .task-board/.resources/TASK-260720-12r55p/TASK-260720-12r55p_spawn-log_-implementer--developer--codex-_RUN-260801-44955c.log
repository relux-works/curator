+        "hardened_profile_owner"
+    ] == HOST_POLICY_VECTORS["hardened_profile_owner"]
+    assert HOST_POLICY_VECTORS["process_graph"] == list(go_v1.PROCESS_GRAPH)
+    assert HOST_POLICY_VECTORS["session_states"] == list(go_v1.SESSION_STATES)
