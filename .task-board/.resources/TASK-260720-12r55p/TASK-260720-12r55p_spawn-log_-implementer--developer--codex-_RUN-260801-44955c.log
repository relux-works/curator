+            if (case.get("input") or {}).get("derived_cache_key")
+            == identity["cache_key"]
+        )
+        with pytest.raises(metadata.BuildMetadataError) as raised:
+            metadata.parse_build_input(identity["input"])
+        assert raised.value.code == rejection["expected"]["error"]
