        (1, "1.0.0-rc.3"),
        (2, "1.0.0-rc.4"),
        (3, "1.0.0-rc.5"),
    ]
    assert "build_drivers" not in claims[0]
    assert "build_drivers" not in claims[1]
    assert claims[2]["build_drivers"]


