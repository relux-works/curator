+
+    if name == "fixed-environment-and-five-direct-argv-forms":
+        argv = case["argv"]
+        assert [item["name"] for item in argv] == [item["name"] for item in vectors["argv"]]
+        assert argv[2]["argv"][1:] == ["env", "-json", *toolchain.GO_ENV_FIELDS]
