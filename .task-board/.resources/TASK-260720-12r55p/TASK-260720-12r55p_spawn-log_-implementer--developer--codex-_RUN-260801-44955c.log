+    assert manifest["protocol_version"] == EXPECTED_CANDIDATE_PROTOCOL_VERSION
+    assert release["protocol_version"] == EXPECTED_CANDIDATE_PROTOCOL_VERSION
+    assert release["candidate_protocol_pin"] == {
