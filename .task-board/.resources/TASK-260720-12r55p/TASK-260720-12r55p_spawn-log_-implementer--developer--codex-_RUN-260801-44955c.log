@dataclass(frozen=True)
class ControlProbe:
    name: str
    availability: str
    mechanism: str
    probed_at: str = PROBE_TIMING

    def to_dict(self) -> dict[str, str]:
        return {
            "name": self.name,
            "availability": self.availability,
            "mechanism": self.mechanism,
            "probed_at": self.probed_at,
        }


