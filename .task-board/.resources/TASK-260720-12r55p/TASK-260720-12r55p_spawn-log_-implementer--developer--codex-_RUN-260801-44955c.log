+        for version in (1, 2, 3)
+    ]
+    assert [(claim["schema_version"], claim["protocol_version"]) for claim in claims] == [
+        (1, "1.0.0-rc.3"),
+        (2, "1.0.0-rc.4"),
+        (3, "1.0.0-rc.5"),
