+) -> None:
+    assert BUILD_DRIVER_VECTORS["cache_identity"]["aliases"] is False
+    canonical_key = "sha256:" + hashlib.sha256(
+        protocol_json.canonical_bytes(identity["input"])
+    ).hexdigest()
