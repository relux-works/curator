+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/launch-env-fragment-v2.schema.json",
+  "title": "launch-env-fragment-v2",
+  "type": "object",
+  "required": ["fragment", "environment", "profile", "precedence", "env", "permissions"],
+  "properties": {
+    "fragment": {"const": "launch-env-fragment-v2"},
+    "environment": {"enum": ["claude_code", "codex_cli", "opencode", "pi"]},
+    "profile": {
+      "type": "object",
+      "required": ["name", "lock_sha256"],
+      "properties": {
+        "name": {"$ref": "common.schema.json#/$defs/identifier"},
+        "lock_sha256": {"$ref": "common.schema.json#/$defs/hex256"}
+      },
+      "additionalProperties": false
+    },
+    "precedence": {"$ref": "agent-environment-marker-v1.schema.json#/$defs/precedence"},
+    "env": {
+      "type": "object",
+      "minProperties": 1,
+      "maxProperties": 1,
+      "propertyNames": {"enum": ["CLAUDE_CONFIG_DIR", "CODEX_HOME", "XDG_CONFIG_HOME", "PI_CODING_AGENT_DIR"]},
+      "additionalProperties": {"$ref": "#/$defs/absolutePath"}
+    },
+    "system_prompt": {
+      "type": "object",
+      "required": ["path", "channels"],
+      "properties": {
+        "path": {"$ref": "#/$defs/absolutePath"},
+        "channels": {
