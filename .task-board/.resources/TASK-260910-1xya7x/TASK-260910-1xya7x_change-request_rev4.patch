+[
+  {
+    "id": "broad-root",
+    "input": {
+      "path": ".",
+      "directory": "agents/skills/review",
+      "physical": "project/agents/skills/review",
+      "outputs": [
+        "project/.agents"
+      ]
+    },
+    "expected": "allow"
+  },
+  {
+    "id": "managed-source",
+    "input": {
+      "path": ".",
+      "directory": ".agents/skills/review",
+      "physical": "project/.agents/skills/review",
+      "outputs": [
+        "project/.agents"
+      ]
+    },
+    "expected": "source_output_overlap"
+  },
+  {
+    "id": "symlink-managed",
+    "input": {
+      "directory": "authored/review",
+      "physical": "project/.agents/skills/review",
+      "outputs": [
+        "project/.agents"
+      ]
+    },
+    "expected": "source_output_overlap"
+  },
+  {
+    "id": "case-alias",
+    "input": {
+      "filesystem": "case-insensitive",
+      "physical": "project/.AGENTS/skills/review",
+      "outputs": [
+        "project/.agents"
+      ]
+    },
+    "expected": "source_output_overlap"
+  },
+  {
+    "id": "write-boundary-retarget",
+    "input": {
+      "planned_output": "project/.agents",
+      "publication_output": "project/agents/skills/review"
+    },
+    "expected": "source_output_overlap"
+  },
+  {
+    "id": "root-no-inputs",
+    "input": {
+      "path": ".",
+      "directory": ".",
+      "root_inputs": null
+    },
+    "expected": "source_output_overlap"
+  },
+  {
+    "id": "selector-escape",
+    "input": {
+      "directory": "skills/review",
+      "physical": "outside/review"
+    },
+    "expected": "source_selection_invalid"
+  },
+  {
+    "id": "unknown-alias",
+    "input": {
+      "from": "absent",
+      "sources": {}
+    },
+    "expected": "source_alias_unknown"
+  },
+  {
+    "id": "missing-excluded-literal",
+    "input": {
+      "include": [
+        "missing"
+      ],
+      "exclude": [
+        "missing"
+      ],
+      "children": []
+    },
+    "expected": "source_member_missing"
+  },
+  {
+    "id": "bad-wildcard-member",
+    "input": {
+      "include": [
+        "*"
+      ],
+      "children": {
+        "review": "valid",
+        "docs": "missing-SKILL.md"
+      }
+    },
+    "expected": "source_member_invalid"
+  },
+  {
+    "id": "duplicate-name",
