+			payload: func(string, string) string {
+				return `{"schema_version":2,"sources":{"team":{"path":"./pkgs"}},"skills":[` + docCollectionExclude + `]}`
+			},
+			members: []string{"docs", "review"},
+		},
+	}
+	for _, row := range rows {
+		t.Run(row.name, func(t *testing.T) {
+			root := t.TempDir()
