+                        "pattern": "(?:^|/)[^/]*[ .](?:/|$)|[*?\\[\\]]"
+                      }
+                    }
+                  ]
+                }
+              ]
+            }
+          },
+          "required": [
+            "kind",
+            "repository",
+            "commit",
+            "directory"
+          ],
+          "additionalProperties": false
+        },
+        {
+          "type": "object",
