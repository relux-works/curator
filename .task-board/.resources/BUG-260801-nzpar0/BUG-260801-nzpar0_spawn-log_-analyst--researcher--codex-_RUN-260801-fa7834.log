+def create_source(path: Path, kind: str) -> None:
+    if kind == "directory":
+        path.mkdir()
+        (path / "closed-child.txt").write_text("closed\n", encoding="utf-8")
+    elif kind == "file":
+        path.write_text("closed\n", encoding="utf-8")
+    else:
