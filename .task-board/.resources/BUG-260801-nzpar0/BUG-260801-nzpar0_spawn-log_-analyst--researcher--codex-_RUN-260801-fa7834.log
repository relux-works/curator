+    except OSError:
+        return ""
+
+
+def open_handle(
+    path: Path,
+    desired_access: int,
+    *,
+    share_mode: int = SHARE_ALL,
+) -> int:
+    ctypes.set_last_error(0)
+    raw = kernel32.CreateFileW(
+        extended(path),
+        desired_access,
+        share_mode,
+        None,
+        OPEN_EXISTING,
+        FILE_ATTRIBUTE_NORMAL
+        | FILE_FLAG_OPEN_REPARSE_POINT
+        | FILE_FLAG_BACKUP_SEMANTICS,
+        None,
