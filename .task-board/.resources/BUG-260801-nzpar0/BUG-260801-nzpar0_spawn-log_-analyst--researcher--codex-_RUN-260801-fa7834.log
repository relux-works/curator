+kernel32.GetFinalPathNameByHandleW.restype = ctypes.c_uint32
+kernel32.SetFileInformationByHandle.argtypes = [
+    ctypes.c_void_p,
+    ctypes.c_int,
+    ctypes.c_void_p,
