+        ("paged_pool_charge", ctypes.c_uint32),
+        ("non_paged_pool_charge", ctypes.c_uint32),
+        ("reserved", ctypes.c_uint32 * 3),
+        ("name_info_size", ctypes.c_uint32),
+        ("type_info_size", ctypes.c_uint32),
