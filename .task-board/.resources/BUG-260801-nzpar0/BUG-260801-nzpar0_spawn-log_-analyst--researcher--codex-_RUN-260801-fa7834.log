@dataclass
class _Handle:
    value: int
    path: Path
    identity: _FileIdentity
    final_path: str
    basic: _FileBasicInfo
    standard: _FileStandardInfo

    def close(self) -> None:
        api = _api()
        if not api.kernel32.CloseHandle(self.value):
            error = _last_error()
            raise _windows_error(error, "cannot close protected-cache handle", self.path)


