+        ntdll.NtQueryObject(
+            handle,
+            OBJECT_BASIC_INFORMATION_CLASS,
+            ctypes.byref(basic),
+            ctypes.sizeof(basic),
+            ctypes.byref(returned),
+        )
+    )
+    status_u32 = status & 0xFFFFFFFF
+    return {
