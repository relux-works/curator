   374	    size_mode: str = "sizeof_plus",
   375	    source_access: int = READ_CONTROL | FILE_READ_ATTRIBUTES | DELETE,
   376	    source_share: int = SHARE_ALL,
   377	    source_kind: str = "directory",
   378	    collision: bool = False,
   379	    root_is_file: bool = False,
   380	    absolute_extended: bool = True,
   381	) -> None:
   382	    case_root = base / label
   383	    source_parent = case_root / "source-parent"
   384	    destination_parent = case_root / "destination-parent"
   385	    source_parent.mkdir(parents=True)
   386	    destination_parent.mkdir()
   387	    source = source_parent / "source"
   388	    destination_name = "destination"
   389	    destination = destination_parent / destination_name
   390	    create_source(source, source_kind)
   391	    if collision:
   392	        create_source(destination, source_kind)
   393	    root_path = destination_parent
   394	    if root_is_file:
   395	        root_path = case_root / "not-a-directory.txt"
   396	        root_path.write_text("not a directory\n", encoding="utf-8")
   397	
   398	    source_handle: int | None = None
   399	    root_handle: int | None = None
   400	    try:
   401	        source_handle = open_handle(
   402	            source,
   403	            source_access,
   404	            share_mode=source_share,
   405	        )
   406	        if relative_root:
   407	            root_handle = open_handle(root_path, root_access)
   408	        before = handle_details(source_handle, source_access)
   409	        root = (
   410	            handle_details(root_handle, root_access)
   411	            if root_handle is not None
   412	            else None
   413	        )
   414	        if relative_root:
   415	            name = destination_name
   416	        elif absolute_extended:
   417	            name = extended(destination)
   418	        else:
   419	            name = os.fspath(destination.resolve())
   420	        buffer, buffer_evidence = make_buffer(
   421	            structure,
   422	            name,
   423	            root_handle,
   424	            length_mode=length_mode,
   425	            size_mode=size_mode,
   426	        )
   427	        emit(
   428	            "case_input",
   429	            label=label,
   430	            api=api,
   431	            source_kind=source_kind,
   432	            source_handle=before,
   433	            root_handle=root,
   434	            relative_root=relative_root,
   435	            collision=collision,
   436	            buffer=buffer_evidence,
   437	        )
   438	        if api == "SetFileInformationByHandle":
   439	            ctypes.set_last_error(0)
   440	            success = bool(
   441	                kernel32.SetFileInformationByHandle(
   442	                    source_handle,
   443	                    FILE_RENAME_INFO_CLASS,
   444	                    ctypes.byref(buffer),
   445	                    len(buffer),
   446	                )
   447	            )
   448	            error = 0 if success else int(ctypes.get_last_error())
   449	            status_hex = None
   450	            iosb_status_hex = None
   451	            iosb_information = None
   452	        elif api == "NtSetInformationFile":
   453	            iosb = IoStatusBlock()
   454	            status = int(
   455	                ntdll.NtSetInformationFile(
   456	                    source_handle,
   457	                    ctypes.byref(iosb),
   458	                    ctypes.byref(buffer),
   459	                    len(buffer),
   460	                    FILE_RENAME_INFORMATION_CLASS,
   461	                )
   462	            )
   463	            status_u32 = status & 0xFFFFFFFF
   464	            success = status_u32 == 0
   465	            error = (
   466	                0
   467	                if success
   468	                else int(ntdll.RtlNtStatusToDosError(ctypes.c_long(status)))
   469	            )
   470	            status_hex = f"0x{status_u32:08x}"
   471	            iosb_status_hex = f"0x{int(iosb.status_or_pointer) & 0xFFFFFFFF:08x}"
   472	            iosb_information = int(iosb.information)
   473	        else:
