+            error = getattr(exc, "winerror", None) or exc.errno
+            emit(
+                "share_conflict_result",
+                success=False,
+                winerror=error,
+                expected_winerror=ERROR_SHARING_VIOLATION,
+                expected=(error == ERROR_SHARING_VIOLATION),
+                message=str(exc),
+            )
