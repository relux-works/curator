   476	        emit(
   477	            "case_result",
   478	            label=label,
   479	            success=success,
   480	            winerror=error,
   481	            winerror_text=format_error(error) if error else "",
   482	            ntstatus=status_hex,
   483	            iosb_status=iosb_status_hex,
   484	            iosb_information=iosb_information,
   485	            source_path_exists=source.exists(),
   486	            destination_path_exists=destination.exists(),
