+            structure,
+            name,
+            root_handle,
+            length_mode=length_mode,
+            size_mode=size_mode,
+        )
+        emit(
+            "case_input",
+            label=label,
+            api=api,
+            source_kind=source_kind,
+            source_handle=before,
+            root_handle=root,
