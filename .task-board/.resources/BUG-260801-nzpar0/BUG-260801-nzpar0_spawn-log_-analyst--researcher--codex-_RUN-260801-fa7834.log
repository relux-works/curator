+    length_mode: str = "bytes",
+    size_mode: str = "sizeof_plus",
+    source_access: int = READ_CONTROL | FILE_READ_ATTRIBUTES | DELETE,
+    source_share: int = SHARE_ALL,
+    source_kind: str = "directory",
+    collision: bool = False,
