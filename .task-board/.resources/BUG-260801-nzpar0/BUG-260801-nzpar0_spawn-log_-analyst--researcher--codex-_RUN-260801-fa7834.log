+#include <stdio.h>
+
+int wmain(void) {
+    printf("pointer_bits=%zu\n", sizeof(void *) * 8);
+    printf("sizeof_BOOLEAN=%zu\n", sizeof(BOOLEAN));
+    printf("sizeof_DWORD=%zu\n", sizeof(DWORD));
