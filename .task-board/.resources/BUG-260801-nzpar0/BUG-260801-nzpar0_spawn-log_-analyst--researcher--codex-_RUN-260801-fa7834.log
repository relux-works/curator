+ntdll.NtSetInformationFile.restype = ctypes.c_long
+ntdll.RtlNtStatusToDosError.argtypes = [ctypes.c_long]
+ntdll.RtlNtStatusToDosError.restype = ctypes.c_uint32
+ntdll.NtQueryObject.argtypes = [
+    ctypes.c_void_p,
+    ctypes.c_int,
+    ctypes.c_void_p,
