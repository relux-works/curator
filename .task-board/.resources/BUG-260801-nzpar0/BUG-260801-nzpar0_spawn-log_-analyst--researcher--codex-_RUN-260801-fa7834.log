+        extended(path),
+        desired_access,
+        share_mode,
+        None,
+        OPEN_EXISTING,
+        FILE_ATTRIBUTE_NORMAL
+        | FILE_FLAG_OPEN_REPARSE_POINT
+        | FILE_FLAG_BACKUP_SEMANTICS,
+        None,
+    )
+    if raw in {None, INVALID_HANDLE_VALUE}:
