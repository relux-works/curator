   346	        "declared_name_length": int(info.file_name_length),
   347	        "buffer_size": len(buffer),
   348	        "size_mode": size_mode,
   349	        "length_mode": length_mode,
   350	        "header_hex": bytes(buffer[: min(len(buffer), 32)]).hex(),
   351	    }
   352	    return buffer, evidence
   353	
   354	
   355	def create_source(path: Path, kind: str) -> None:
