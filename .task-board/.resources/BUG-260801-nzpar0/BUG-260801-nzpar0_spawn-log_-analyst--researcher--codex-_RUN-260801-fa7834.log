+    ctypes.c_int,
+    ctypes.c_void_p,
+    ctypes.c_uint32,
+]
+kernel32.SetFileInformationByHandle.restype = ctypes.c_int
+ntdll.NtSetInformationFile.argtypes = [
+    ctypes.c_void_p,
