   362	        raise ValueError(kind)
   363	
   364	
   365	def run_case(
   366	    base: Path,
   367	    label: str,
   368	    *,
   369	    api: str,
   370	    relative_root: bool,
   371	    root_access: int = FILE_READ_ATTRIBUTES | FILE_EXECUTE,
