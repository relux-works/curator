+    ctypes.c_uint32,
+]
+kernel32.GetFileInformationByHandleEx.restype = ctypes.c_int
+kernel32.GetFinalPathNameByHandleW.argtypes = [
+    ctypes.c_void_p,
+    ctypes.c_wchar_p,
