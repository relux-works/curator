+    if collision:
+        create_source(destination, source_kind)
+    root_path = destination_parent
+    if root_is_file:
+        root_path = case_root / "not-a-directory.txt"
+        root_path.write_text("not a directory\n", encoding="utf-8")
+
+    source_handle: int | None = None
