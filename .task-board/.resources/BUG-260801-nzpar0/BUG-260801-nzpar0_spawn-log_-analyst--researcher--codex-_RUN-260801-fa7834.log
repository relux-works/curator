+def emit(event: str, **values: Any) -> None:
+    print(json.dumps({"event": event, **values}, sort_keys=True), flush=True)
+
+
+def extended(path: Path) -> str:
+    value = os.fspath(path.resolve())
+    if value.startswith("\\\\?\\"):
+        return value
+    if value.startswith("\\\\"):
+        return "\\\\?\\UNC\\" + value[2:]
