+def make_buffer(
+    structure: type[ctypes.Structure],
+    name: str,
+    root_handle: int | None,
+    *,
+    length_mode: str = "bytes",
+    size_mode: str = "sizeof_plus",
+) -> tuple[ctypes.Array[ctypes.c_char], dict[str, Any]]:
