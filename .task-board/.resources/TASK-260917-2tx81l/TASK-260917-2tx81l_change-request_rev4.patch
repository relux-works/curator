+func TestResolvePublishesCredentialMarkerThroughLockedJournalV2WriterMode(t *testing.T) {
+	enableV2WritersForTest(t)
+	fx := writeManagedFixture(t, "acme")
+	seedLiveNativeCredentials(t, fx)
