#!/bin/bash
# TASK-260729-2afulh focused gate driver for the 14-file prototype worktree.
#
# Evidence protocol, inherited verbatim from the accepted TASK-260729-rfrdfo
# driver:
#   * every gate is a standalone process: no tee, no pipe chain, no subshell
#     that could swallow the status
#   * the real exit code is written to <name>.exit as the LAST action, so a
#     missing .exit means "killed or still running", never "passed"
#   * <name>.seconds records wall clock, <name>.log records combined output
#   * gates run strictly one at a time, each behind a two-scan process barrier,
#     because focused timings are the whole point of this task and
#     TASK-260729-365r5r shares this host
#   * DRIVER-DONE only appears if the driver reached the end
#
# No -timeout token, no ./... test run, no coverage, no host install, no git
# command, no internal/install test gate: Patch A is inherited immutable
# evidence from TASK-260729-rfrdfo and this task does not re-measure it.

ROOT=/Users/iv/Developer/ReluxWorks/curator/.temp/TASK-260729-2afulh
WT=$ROOT/worktree
G=$ROOT/gates
CONFORMANCE=/Users/iv/Developer/ReluxWorks/curator/.temp/TASK-260729-3nx97g/worktree/conformance/v1

mkdir -p "$G" "$ROOT/gotmp/atomicity" "$ROOT/gotmp/install" || exit 99
cd "$WT" || exit 99
rm -f "$G/DRIVER-DONE"
date +%FT%T > "$G/DRIVER-START"

run() {
  name="$1"; shift
  "$ROOT/bin/barrier.sh" > "$G/$name.barrier" 2>&1
  if [ $? -ne 0 ]; then
    echo "99" > "$G/$name.exit"
    return
  fi
  start=$(date +%s)
  "$@" > "$G/$name.log" 2>&1
  code=$?
  echo "$(( $(date +%s) - start ))" > "$G/$name.seconds"
  echo "$code" > "$G/$name.exit"
}

export CURATOR_CONFORMANCE_ROOT="$CONFORMANCE"

# --- format / build ---------------------------------------------------------
run gate-gofmt gofmt -l internal/install internal/install/atomicity
run gate-build env GOTMPDIR="$ROOT/gotmp/install" go build ./...
run gate-vet   env GOTMPDIR="$ROOT/gotmp/install" go vet ./internal/install/...

# --- the focused non-race gate, verbose, count=1 ----------------------------
run gate-atomicity-nonrace \
  env GOTMPDIR="$ROOT/gotmp/atomicity" go test -count=1 -v ./internal/install/atomicity

# --- the gate the 480s bar is set on, count=1, three times ------------------
for i in 1 2 3; do
  run "gate-race-atomicity-$i" \
    env GOTMPDIR="$ROOT/gotmp/atomicity" go test -count=1 -race ./internal/install/atomicity
done

date +%FT%T > "$G/DRIVER-DONE"
#!/bin/zsh
# Two-scan process barrier. Self-excluding: the pattern lives in this file, so the
# scanning shell's own command line cannot match it.
PAT='(^|/)(go|.*\.test)( |$)|go-build|cmd/curator'
scan() {
  local raw
  raw=$(ps -ax -o pid=,command=) || { print -r -- "PS_FAILED"; return 2; }
  print -r -- "$raw" \
    | grep -Ev "^[[:space:]]*($$|$PPID)[[:space:]]" \
    | grep -E "$PAT" \
    | grep -v 'barrier.sh'
  return 0
}
for i in 1 2; do
  out=$(scan)
  rc=$?
  if [[ $rc -ne 0 ]]; then print -r -- "SCAN $i FAILED"; exit 2; fi
  if [[ -n "$out" ]]; then
    print -r -- "SCAN $i NOT EMPTY:"
    print -r -- "$out"
    exit 1
  fi
  print -r -- "SCAN $i empty"
  [[ $i -eq 1 ]] && /bin/sleep 2
done
print -r -- "BARRIER_OK"
exit 0

