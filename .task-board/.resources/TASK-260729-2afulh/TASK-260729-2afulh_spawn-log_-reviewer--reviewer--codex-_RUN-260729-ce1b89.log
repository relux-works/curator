package atomicity

// MEASUREMENT-ONLY INSTRUMENTATION — TASK-260729-2afulh.
//
// This file is not part of the 14-file deliverable patch. It exists only in the
// task-owned measure/{before,after} scratch trees so the staging cost of one
// real installation can be counted. It touches no production file: the staged
// entry set is read back out of the durable journal that the engine itself
// writes, while the staging entries are still live, through the observation
// hook the atomicity suite already uses.

import (
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"strings"
	"sync"
	"testing"

	"github.com/relux-works/curator/internal/install"
	"github.com/relux-works/curator/internal/scopes"
	"github.com/relux-works/curator/internal/transaction"
)

// stagingMeter observes transaction boundaries and snapshots the journal while
// Prepare is still staging, which is the only window in which
// TargetRecord.StagingEntries is populated (engine.go clears every target's
// entries immediately before PhasePrepared).
type stagingMeter struct {
	mu          sync.Mutex
	journalRoot string
	chunkSyncs  int
	copyPoints  int
	// entries is transaction id -> target index -> the longest staging
	// manifest observed for that target.
	entries map[string]map[int][]transaction.RemovalEntry
}

func newStagingMeter(home string) *stagingMeter {
	return &stagingMeter{
		journalRoot: filepath.Join(home, "state", "transactions", "v1"),
		entries:     map[string]map[int][]transaction.RemovalEntry{},
	}
}

func (meter *stagingMeter) hooks() transaction.Hooks {
	return transaction.Hooks{Observe: meter.observe}
}

func (meter *stagingMeter) observe(event transaction.Event) {
	meter.mu.Lock()
	defer meter.mu.Unlock()
	switch event.Point {
	case transaction.PointAfterStagingChunkSync:
		meter.chunkSyncs++
	case transaction.PointDuringStagingCopy:
		meter.copyPoints++
	}
	if event.TransactionID == "" {
		return
	}
	payload, err := os.ReadFile(filepath.Join(meter.journalRoot, event.TransactionID+".json"))
	if err != nil {
		return
	}
	var journal transaction.Journal
	if err := json.Unmarshal(payload, &journal); err != nil {
		return
	}
	perTarget := meter.entries[journal.TransactionID]
	if perTarget == nil {
		perTarget = map[int][]transaction.RemovalEntry{}
		meter.entries[journal.TransactionID] = perTarget
	}
	for index, target := range journal.Targets {
		if len(target.StagingEntries) > len(perTarget[index]) {
			perTarget[index] = append([]transaction.RemovalEntry(nil), target.StagingEntries...)
		}
	}
}

type meterTotals struct {
	transactions  int
	stagedTargets int
	entries       int
	dirEntries    int
	fileEntries   int
	linkEntries   int
	otherEntries  int
	refEntries    int
	chunkSyncs    int
	copyPoints    int
}

// derivedStagingSaves is the number of Engine.saveJournal calls the staging
// loop makes for this measured workload. stageTarget saves three times per
// entry (staging.go: before creation, after creation, after the index
// advances) and copyStagingFile saves twice per copied chunk (before the write
// and after the durable sync). Both coefficients are read off the source, and
// both multiplicands below are measured, not assumed.
func (totals meterTotals) derivedStagingSaves() int {
	return 3*totals.entries + 2*totals.chunkSyncs
}

func (meter *stagingMeter) totals() meterTotals {
	meter.mu.Lock()
	defer meter.mu.Unlock()
	totals := meterTotals{chunkSyncs: meter.chunkSyncs, copyPoints: meter.copyPoints}
	for _, perTarget := range meter.entries {
		counted := false
		for _, entries := range perTarget {
			if len(entries) == 0 {
				continue
			}
			counted = true
			totals.stagedTargets++
			totals.entries += len(entries)
			for _, entry := range entries {
				switch entry.Kind {
				case "directory":
					totals.dirEntries++
				case "file":
					totals.fileEntries++
				case "link":
					totals.linkEntries++
				default:
					totals.otherEntries++
				}
				clean := filepath.ToSlash(entry.RelativePath)
				if clean == "references" || strings.HasPrefix(clean, "references/") {
					totals.refEntries++
				}
			}
		}
		if counted {
			totals.transactions++
		}
	}
	return totals
}

// sampleManifest renders one staged target's manifest so the exact entries the
// trim removes are visible rather than inferred from a count.
func (meter *stagingMeter) sampleManifest() []string {
	meter.mu.Lock()
	defer meter.mu.Unlock()
	transactionIDs := make([]string, 0, len(meter.entries))
	for id := range meter.entries {
		transactionIDs = append(transactionIDs, id)
	}
	sort.Strings(transactionIDs)
	for _, id := range transactionIDs {
		perTarget := meter.entries[id]
		indexes := make([]int, 0, len(perTarget))
		for index := range perTarget {
			indexes = append(indexes, index)
		}
		sort.Ints(indexes)
		for _, index := range indexes {
			entries := perTarget[index]
			if len(entries) == 0 {
				continue
			}
			rendered := make([]string, 0, len(entries))
			for _, entry := range entries {
				rendered = append(rendered, entry.Kind+":"+filepath.ToSlash(entry.RelativePath))
			}
			sort.Strings(rendered)
			return rendered
		}
	}
	return nil
}

func report(t *testing.T, scenario, phase string, meter *stagingMeter) meterTotals {
	t.Helper()
	totals := meter.totals()
	fmt.Printf("MEASURE scenario=%s phase=%s txns=%d staged_targets=%d entries=%d dirs=%d files=%d links=%d other=%d ref_entries=%d chunk_syncs=%d copy_points=%d derived_staging_saves=%d\n",
		scenario, phase, totals.transactions, totals.stagedTargets, totals.entries,
		totals.dirEntries, totals.fileEntries, totals.linkEntries, totals.otherEntries, totals.refEntries,
		totals.chunkSyncs, totals.copyPoints, totals.derivedStagingSaves())
	return totals
}

// TestMeasureStagingCost replays exactly the two installation shapes the
// atomicity sweep drives — the project scenario's baseline plus its upgraded
// second install, and the same pair for the machine-wide scope — and reports
// the staged entry set, the copied chunk count, and the derived saveJournal
// count of each. No fault is injected: staging happens in full during Prepare,
// before any fault point the sweep uses can fire, so a fault-injected install
// pays the same staging cost as this one.
func TestMeasureStagingCost(t *testing.T) {
