#!/bin/zsh
# Two-scan process barrier. Self-excluding: the pattern lives in this file, so the
# scanning shell's own command line cannot match it.
PAT='(^|/)(go|.*\.test)( |$)|go-build|cmd/curator'
scan() {
  local raw
  raw=$(ps -ax -o pid=,command=) || { print -r -- "PS_FAILED"; return 2; }
  print -r -- "$raw" \
    | grep -Ev "^[[:space:]]*($$|$PPID)[[:space:]]" \
    | grep -E "$PAT" \
    | grep -v 'barrier.sh'
  return 0
}
for i in 1 2; do
  out=$(scan)
  rc=$?
  if [[ $rc -ne 0 ]]; then print -r -- "SCAN $i FAILED"; exit 2; fi
  if [[ -n "$out" ]]; then
    print -r -- "SCAN $i NOT EMPTY:"
    print -r -- "$out"
    exit 1
  fi
  print -r -- "SCAN $i empty"
  [[ $i -eq 1 ]] && /bin/sleep 2
done
print -r -- "BARRIER_OK"
exit 0

