#!/bin/zsh
# usage: manifest.sh <tree-root> <output-file>
# Path-sorted SHA-256 manifest of every regular file under <tree-root>,
# excluding the .git administrative directory. Paths are relative ("./x").
set -o pipefail
TREE=$1
OUT=$2
cd "$TREE" || exit 3
find . -type f -not -path './.git/*' -print0 \
  | LC_ALL=C sort -z \
  | xargs -0 shasum -a 256 > "$OUT"
exit $?

