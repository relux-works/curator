+		if node == nil || node.Snapshot == "" {
+			name := "<nil>"
+			if node != nil {
+				name = node.Name
+			}
+			return nil, fmt.Errorf("source_member_missing: node %s has no content snapshot", name)
+		}
+		admitted = append(admitted, node.Snapshot)
+	}
+	return admitted, nil
+}
