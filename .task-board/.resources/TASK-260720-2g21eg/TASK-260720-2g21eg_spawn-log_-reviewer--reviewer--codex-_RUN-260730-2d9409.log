    26	def main(argv: list[str] | None = None) -> int:
    27	    # This is an implementation-only re-execution boundary.  It is reachable
    28	    # only from the actual installed entry point with the one fixed argument;
    29	    # programmatic argv, manifests, environment, PATH, and the public parser
    30	    # cannot select it.
    31	    if argv is None and sys.argv[1:] == ["__csk-go-worker-v1"]:
    32	        from .builds.go_v1 import run_worker
    33	
    34	        return run_worker()
    35	    parser = build_parser()
    36	    try:
    37	        args = parser.parse_args(argv)
    38	    except SystemExit as exc:
    39	        return int(exc.code) if isinstance(exc.code, int) else EXIT_CONFIG
    40	    if args.version:
    41	        print(f"csk {__version__}")
    42	        return EXIT_OK
