def test_probe_calls_each_available_inventory_control_once_and_skips_unavailable():
    calls: list[str] = []

    def probe(name: str, limits: go_v1.ResourceLimits) -> bool:
        assert limits == go_v1.ResourceLimits()
        calls.append(name)
        return True

    platform, probes = go_v1.probe_native_controls(
        go_v1.ResourceLimits(),
        _platform=go_v1.PLATFORM_MACOS,
        _native_probe=probe,
    )
    assert platform == go_v1.PLATFORM_MACOS
    assert calls == [
        "descendant-domain-termination",
        "per-file-size-limit",
        "inherited-handle-restriction",
    ]
    assert [probe.name for probe in probes] == list(go_v1.NATIVE_CONTROL_INVENTORY)


