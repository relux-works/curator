    return dict(sorted(values.items()))


def _build_environment(
    bootstrap: Mapping[str, str],
    goroot: Path,
    target: NativeTarget,
) -> dict[str, str]:
    values = dict(bootstrap)
    values.update(
        {
            "GOROOT": str(goroot),
            "GOOS": target.goos,
            "GOARCH": target.goarch,
            "GO111MODULE": "on",
