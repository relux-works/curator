diff --git a/internal/testtoolchain/lock.go b/internal/testtoolchain/lock.go
new file mode 100644
index 00000000..ddab8222
--- /dev/null
+++ b/internal/testtoolchain/lock.go
@@ -0,0 +1,45 @@
+// Package testtoolchain owns shared host-toolchain capability checks and
+// coordinates tests that use host installations as external fixtures.
+package testtoolchain
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+	"time"
+
+	"github.com/relux-works/curator/internal/managerlock"
+)
+
+const hostGOROOTLockTimeout = 5 * time.Minute
+
+// LockHostGOROOT serializes only the macOS tests that either keep a whole-tree
+// GOROOT fingerprint across an operation or execute the real tools from that
+// same host tree. Two hosted macOS runs observed the tool tree change while
+// those exact test classes overlapped; the lock gives that shared external test
+// fixture one owner without changing production toolchain verification or
+// serializing unrelated tests.
+func LockHostGOROOT(t testing.TB) {
+	t.Helper()
+	if runtime.GOOS != "darwin" {
+		return
+	}
+
+	manager, err := managerlock.New(filepath.Join(os.TempDir(), "curator-host-goroot-test-lock-v1"))
+	if err != nil {
+		t.Fatalf("create host GOROOT test lock: %v", err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), hostGOROOTLockTimeout)
+	t.Cleanup(cancel)
+	lock, err := manager.AcquireHomeOnly(ctx, false)
+	if err != nil {
+		t.Fatalf("acquire host GOROOT test lock: %v", err)
+	}
+	t.Cleanup(func() {
+		if closeErr := lock.Close(); closeErr != nil {
+			t.Errorf("release host GOROOT test lock: %v", closeErr)
+		}
+	})
+}
diff --git a/internal/testtoolchain/swift.go b/internal/testtoolchain/swift.go
new file mode 100644
index 00000000..2e2901bb
--- /dev/null
+++ b/internal/testtoolchain/swift.go
@@ -0,0 +1,18 @@
+package testtoolchain
+
+import "strings"
+
+const (
+	swiftInvalidManifestDiagnostic = "Invalid manifest"
+	swiftManifestSpawnDiagnostic   = "clang: error: unable to execute command: posix_spawn failed: No such file or directory"
+)
+
+// SwiftManifestLinkerUnavailable reports the exact hosted-runner diagnostic
+// that proves SwiftPM found the manifest but the host could not start clang to
+// link it. Either diagnostic alone, and every adjacent Swift or permit failure,
+// remains an ordinary test failure.
+func SwiftManifestLinkerUnavailable(output []byte) bool {
+	text := string(output)
+	return strings.Contains(text, swiftInvalidManifestDiagnostic) &&
+		strings.Contains(text, swiftManifestSpawnDiagnostic)
+}
diff --git a/internal/testtoolchain/swift_test.go b/internal/testtoolchain/swift_test.go
new file mode 100644
index 00000000..ffd649b2
--- /dev/null
+++ b/internal/testtoolchain/swift_test.go
@@ -0,0 +1,40 @@
+package testtoolchain
+
+import "testing"
+
+func TestSwiftManifestLinkerUnavailableClassifiesOnlyExactConjunction(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name   string
+		output string
+		want   bool
+	}{
+		{
+			name:   "exact conjunction",
+			output: "error: Invalid manifest\nclang: error: unable to execute command: posix_spawn failed: No such file or directory",
+			want:   true,
+		},
+		{
+			name:   "invalid manifest alone",
+			output: "error: Invalid manifest",
+		},
+		{
+			name:   "posix spawn diagnostic alone",
+			output: "clang: error: unable to execute command: posix_spawn failed: No such file or directory",
+		},
+		{
+			name:   "unrelated Swift permit failure",
+			output: "error: Invalid manifest\nswiftpm derivation permit refused: executable identity drift",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			if got := SwiftManifestLinkerUnavailable([]byte(test.output)); got != test.want {
+				t.Fatalf("SwiftManifestLinkerUnavailable(%q) = %t, want %t", test.output, got, test.want)
+			}
+		})
+	}
+}
