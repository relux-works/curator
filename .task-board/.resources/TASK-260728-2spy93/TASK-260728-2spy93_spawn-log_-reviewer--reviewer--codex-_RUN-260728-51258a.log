  1117	class _Patch:
  1118	    def __init__(self, owner: object, name: str, replacement: object) -> None:
  1119	        self.owner = owner
  1120	        self.name = name
  1121	        self.replacement = replacement
  1122	        self.original = getattr(owner, name)
  1123	
  1124	    def __enter__(self) -> None:
  1125	        setattr(self.owner, self.name, self.replacement)
  1126	
  1127	    def __exit__(self, *exception: object) -> None:
  1128	        setattr(self.owner, self.name, self.original)
