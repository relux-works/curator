  1066	    def _patched_read(self, target: Path, replacement: str):
  1067	        original = Path.read_text
  1068	
  1069	        def patched(self_path: Path, *args, **kwargs):  # type: ignore[no-untyped-def]
  1070	            if self_path == target:
  1071	                return replacement
  1072	            return original(self_path, *args, **kwargs)
  1073	
  1074	        return _Patch(Path, "read_text", patched)
  1075	
  1076	    def _patched_json(self, documents: dict):
  1077	        original = validate.load_json
  1078	        resolved = {Path(path): document for path, document in documents.items()}
  1079	
  1080	        def patched(path: Path):  # type: ignore[no-untyped-def]
  1081	            document = resolved.get(Path(path))
  1082	            if document is not None:
  1083	                return copy.deepcopy(document)
  1084	            return original(path)
  1085	
  1086	        return _Patch(validate, "load_json", patched)
  1087	
  1088	    def _common_with(self, definition: str, properties: dict) -> dict:
  1089	        """The shipped common schema with extra members on one definition."""
  1090	        common = validate.load_json(validate.SCHEMAS / "common.schema.json")
  1091	        common["$defs"][definition]["properties"].update(copy.deepcopy(properties))
  1092	        return common
  1093	
  1094	    def _minted(
  1095	        self, definition: str, required: tuple[str, ...], optional: tuple[str, ...]
  1096	    ) -> dict:
  1097	        """The shipped common schema with one reserved shape minted."""
  1098	        common = validate.load_json(validate.SCHEMAS / "common.schema.json")
  1099	        members = {
  1100	            member: {"const": "build"} if member == "type" else {"type": "string"}
  1101	            for member in sorted(set(required) | set(optional))
  1102	        }
  1103	        members["driver"] = {"const": validate.ADMITTED_BUILD_DRIVERS[0]}
  1104	        common["$defs"][definition] = {
  1105	            "type": "object",
  1106	            "required": sorted(required),
  1107	            "properties": members,
  1108	            "additionalProperties": False,
  1109	        }
  1110	        return common
  1111	
  1112	    def _run_with_common(self, common: dict) -> None:
  1113	        with self._patched_json({validate.SCHEMAS / "common.schema.json": common}):
  1114	            validate.validate_additional_driver_boundary()
  1115	
