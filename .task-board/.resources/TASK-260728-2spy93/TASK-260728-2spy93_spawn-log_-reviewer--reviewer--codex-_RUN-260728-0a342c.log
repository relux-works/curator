+            source = source_path.read_text(encoding="utf-8")
+            for identifier in validate.reserved_boundary_identifiers():
+                self.assertNotIn(identifier, source, source_path.name)
+        guard_source = MODULE_PATH.read_text(encoding="utf-8")
