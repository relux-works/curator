+    def test_boundary_decision_must_fix_every_closed_term(self) -> None:
+        decision = validate.ROOT / validate.ADDITIONAL_DRIVER_BOUNDARY_DECISION
+        text = decision.read_text(encoding="utf-8")
+        for term in (
