   850	class _Patch:
   851	    def __init__(self, owner: object, name: str, replacement: object) -> None:
   852	        self.owner = owner
   853	        self.name = name
   854	        self.replacement = replacement
   855	        self.original = getattr(owner, name)
   856	
   857	    def __enter__(self) -> None:
