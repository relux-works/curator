+func findMigrateHome(report *MigrateReport, profile, env string) *MigrateHome {
+	for i := range report.Homes {
+		if report.Homes[i].Profile == profile && report.Homes[i].EnvID == env {
+			return &report.Homes[i]
+		}
+	}
