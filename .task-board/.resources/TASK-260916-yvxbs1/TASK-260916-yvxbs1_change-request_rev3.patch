+func drivePathOverlayUntrustedRepair(t *testing.T, tc pathBoundaryVector) string {
+	t.Helper()
+	if tc.Conforming == nil || *tc.Conforming || !tc.Rebuild || tc.FailingCheck != pathboundary.CheckOwnership {
