+    assert up_key.key_id in err  # type: ignore[union-attr]
+    assert (
+        main(
+            [
+                "--home",
+                str(home),
+                "import-bundle",
+                str(older_path),
+                "--upstream-key",
+                up_key.public_pinned,  # type: ignore[union-attr]
