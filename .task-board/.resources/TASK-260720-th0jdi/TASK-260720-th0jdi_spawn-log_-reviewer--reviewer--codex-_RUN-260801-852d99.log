   777	def _attach_capability_evidence(
   778	    statuses: list[ProjectStatus],
   779	) -> list[ProjectStatus]:
   780	    index = next(
   781	        (position for position, item in enumerate(statuses) if item.builds),
   782	        None,
   783	    )
