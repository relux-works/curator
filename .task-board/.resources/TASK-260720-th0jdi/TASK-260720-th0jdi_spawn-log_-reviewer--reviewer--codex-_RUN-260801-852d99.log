                 with _open_or_create_mutable_directory(
                     home,
                     QUARANTINE_ROOT_NAME,
                     "build cache quarantine",
                     replacement_parent=home,
                     replacement_prefix="builds-quarantine-untrusted",
                     guard=guard,
                 ) as quarantine:
                     try:
                         with _open_protected_child_directory(  # noqa: SIM117
                             home,
