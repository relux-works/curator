   679	def _node_build_statuses(
   680	    config: GlobalConfig,
   681	    node: closure.ClosureNode,
   682	    marker_inspection: _MarkerInspection,
   683	    planned: Mapping[tuple[str, str], build_planner.BuildPlan],
   684	    provider_errors: Mapping[str, tuple[str, str]],
   685	    cache_backend: build_cache.BuildCacheBackend,
   686	    bin_dir: Path,
   687	) -> tuple[build_currentness.BuildStatus, ...]:
   688	    marker_builds: Mapping[str, install_marker.InstallMarkerBuild] = {}
   689	    if isinstance(marker_inspection.marker, install_marker.InstallMarkerV2):
   690	        marker_builds = marker_inspection.marker.builds
   691	    active = installer._active_build_command_names(node)
   692	    commands = sorted(active | set(marker_builds))
   693	    plan_wrapper = installer.SkillPlan(
   694	        decl=node.decl,
   695	        resolved=node.resolved,
   696	        repo=node.repo,
   697	        snapshot=node.snapshot,
   698	        spec=node.spec,
   699	    )
   700	    path_entries = installer._runtime_path_entries(plan_wrapper, bin_dir)
   701	    result: list[build_currentness.BuildStatus] = []
   702	    for name in commands:
   703	        recorded = marker_builds.get(name)
   704	        command = node.spec.commands.get(name)
   705	        if command is None or command.type != "build":
   706	            result.append(
   707	                build_currentness.unavailable_status(
   708	                    node.name,
   709	                    name,
   710	                    label="build-command-drift",
   711	                    detail="marker records a command absent from the current build descriptor",
   712	                    recorded=recorded,
   713	                )
   714	            )
   715	            continue
   716	        provider_error = provider_errors.get(node.name)
   717	        if provider_error is not None:
   718	            label, detail = provider_error
   719	            result.append(
   720	                build_currentness.unavailable_status(
   721	                    node.name,
   722	                    name,
   723	                    label=label,
   724	                    detail=detail,
   725	                    recorded=recorded,
   726	                )
   727	            )
   728	            continue
   729	        result.append(
   730	            build_currentness.classify_build(
   731	                csk_home=config.path.parent,
   732	                bin_dir=bin_dir,
   733	                provider=node.name,
   734	                command=command,
   735	                plan=planned.get((node.name, name)),
   736	                recorded=recorded,
   737	                cache_backend=cache_backend,
   738	                path_entries=path_entries,
   739	                boundary_error=marker_inspection.build_boundary_error,
   740	            )
   741	        )
   742	    return tuple(result)
