   168	class FilesystemGenerationProbe:
   169	    """Hash explicit shared paths without creating, repairing, or following them."""
   170	
   171	    def __init__(self, paths: Sequence[Path]):
   172	        by_name: dict[str, Path] = {}
   173	        for value in paths:
   174	            path = Path(os.path.abspath(os.fspath(value)))
   175	            by_name[str(path)] = path
   176	        self._paths = tuple(
   177	            by_name[name]
   178	            for name in sorted(by_name, key=lambda item: item.encode("utf-8"))
   179	        )
   180	
   181	    @property
   182	    def paths(self) -> tuple[Path, ...]:
   183	        return self._paths
   184	
   185	    def capture(self) -> Mapping[str, str]:
   186	        observations: dict[str, str] = {}
   187	        for path in self._paths:
   188	            observations[str(path)] = _generation_digest(path)
   189	        return MappingProxyType(observations)
