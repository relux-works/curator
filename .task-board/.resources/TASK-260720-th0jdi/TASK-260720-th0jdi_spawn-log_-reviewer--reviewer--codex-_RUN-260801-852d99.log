  2520	def _open_files_equal(first: _Handle, second: _Handle) -> bool:
  2521	    first_before = _object_state(first)
  2522	    second_before = _object_state(second)
  2523	    if first_before.size != second_before.size:
  2524	        return False
  2525	    _seek_start(first)
  2526	    _seek_start(second)
  2527	    remaining = first_before.size
  2528	    while remaining:
  2529	        size = min(_READ_CHUNK, remaining)
  2530	        first_chunk = _read_chunk(first, size)
  2531	        second_chunk = _read_chunk(second, size)
  2532	        if first_chunk != second_chunk or not first_chunk:
  2533	            return False
  2534	        remaining -= len(first_chunk)
  2535	    if _read_chunk(first, 1) or _read_chunk(second, 1):
  2536	        return False
  2537	    if _object_state(first) != first_before:
  2538	        raise _UntrustedState("first cache artifact changed while comparing")
  2539	    if _object_state(second) != second_before:
  2540	        raise _UntrustedState("second cache artifact changed while comparing")
  2541	    return True
