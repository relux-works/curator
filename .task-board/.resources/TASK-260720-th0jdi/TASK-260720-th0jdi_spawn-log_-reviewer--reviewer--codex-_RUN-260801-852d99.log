   210	    commands: list[BuildCommand] = []
   211	    for command_name in sorted(selected, key=lambda value: value.encode("utf-8")):
   212	        command = spec.commands.get(command_name)
   213	        if command is None:
   214	            raise BuildPlanningError(
   215	                "build_plan_invalid",
   216	                f"provider {name!r} activates unknown command {command_name!r}",
   217	            )
   218	        if command.type != "build":
   219	            continue
   220	        if command.driver is None or command.source_dir is None:
   221	            raise BuildPlanningError(
   222	                "build_plan_invalid",
   223	                f"provider {name!r} build command {command_name!r} is incomplete",
   224	            )
   225	        containing = [
   226	            root
   227	            for root in spec.build_roots
   228	            if _portable_path_contains(root, command.source_dir)
   229	        ]
   230	        if len(containing) != 1:
   231	            raise BuildPlanningError(
   232	                "build_plan_invalid",
   233	                f"provider {name!r} build command {command_name!r} is not below "
   234	                "exactly one build root",
   235	            )
   236	        commands.append(
   237	            BuildCommand(
   238	                name=command.name,
   239	                driver=command.driver,
   240	                build_root=containing[0],
   241	                source_dir=command.source_dir,
   242	            )
   243	        )
   244	    return BuildProvider(name=name, snapshot=snapshot, commands=tuple(commands))
