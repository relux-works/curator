   325	            self.goroot = self.operation_root / "goroot"
   326	
   327	        def __enter__(self) -> "Session":
   328	            return self
   329	
   330	        def __exit__(self, *_args: object) -> None:
   331	            return None
   332	
   333	    monkeypatch.setattr(build_toolchain, "establish_toolchain", Session)
