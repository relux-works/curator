 def _make_path_mutable(
     path: Path,
     profile: _SecurityProfile,
     *,
     parent: _Handle,
     name: str,
 ) -> None:
     with _open_raw_handle(
         path,
         desired_access=_READ_CONTROL | _WRITE_DAC | _FILE_READ_ATTRIBUTES,
     ) as handle:
         _require_direct_child(parent, handle, name)
