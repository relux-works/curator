   705	        and os.mkdir in os.supports_dir_fd
   706	        and os.rename in os.supports_dir_fd
   707	        and os.listdir in os.supports_fd
   708	    )
   709	    return (
   710	        required_flags
   711	        and required_calls
   712	        and hasattr(os, "geteuid")
   713	        and _rename_noreplace_available()
