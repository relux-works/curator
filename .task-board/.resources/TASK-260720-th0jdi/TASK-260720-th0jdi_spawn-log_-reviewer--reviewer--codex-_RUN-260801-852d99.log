   360	    # Layout: cache/<source>/<commit>/snapshot, where <source> may be nested.
   361	    for snapshot_dir in sorted(cache_root.rglob("snapshot")):
   362	        if snapshot_dir.is_symlink() or not snapshot_dir.is_dir():
   363	            continue
   364	        commit_dir = snapshot_dir.parent
   365	        source = commit_dir.parent.relative_to(cache_root).as_posix()
   366	        if (source, commit_dir.name) in referenced:
   367	            continue
   368	        shutil.rmtree(commit_dir)
   369	        removed += 1
   370	        parent = commit_dir.parent
