   372	def read_receipt(raw: bytes) -> BuildReceipt:
   373	    """Read stored receipt bytes, requiring exact CCJ-1 stored-byte equality."""
   374	    if not isinstance(raw, bytes):
   375	        raise BuildMetadataError("build_receipt_invalid", "stored receipt bytes must be bytes")
   376	    try:
   377	        decoded = protocol_json.loads_canonical(raw)
   378	    except protocol_json.ProtocolJSONError as exc:
   379	        raise BuildMetadataError("receipt_not_canonical", f"stored receipt is not CCJ-1: {exc}") from exc
   380	    receipt = parse_receipt(decoded)
   381	    if canonical_receipt_bytes(receipt) != raw:
   382	        raise BuildMetadataError(
   383	            "receipt_not_canonical",
   384	            "stored receipt bytes do not equal the canonical encoding of their own value",
   385	        )
   386	    return receipt
