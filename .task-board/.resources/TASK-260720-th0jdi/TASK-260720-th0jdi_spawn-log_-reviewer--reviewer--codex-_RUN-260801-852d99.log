   745	def _installed_files(installed_dir: Path) -> tuple[str, ...]:
   746	    files: list[str] = []
   747	    for path in installed_dir.rglob("*"):
   748	        info = path.lstat()
   749	        if stat.S_ISLNK(info.st_mode):
   750	            raise ValueError(f"installed content contains a link: {path}")
   751	        if stat.S_ISREG(info.st_mode):
   752	            relative = path.relative_to(installed_dir).as_posix()
   753	            if relative != ".csk-install.json":
   754	                files.append(relative)
   755	        elif not stat.S_ISDIR(info.st_mode):
   756	            raise ValueError(f"installed content contains a special entry: {path}")
   757	    return tuple(sorted(files))
