   796	def _capability_evidence() -> tuple[Mapping[str, object] | None, str | None]:
   797	    try:
   798	        platform, probes = go_v1.probe_native_controls(go_v1.ResourceLimits())
   799	        record = go_v1.evidence_from_applied(
   800	            platform,
   801	            probes,
   802	            [
   803	                probe.name
   804	                for probe in probes
   805	                if probe.availability == go_v1.AVAILABILITY_AVAILABLE
   806	            ],
   807	        )
   808	        go_v1.validate_capability_evidence(record, platform, probes)
   809	        return record.to_dict(), None
   810	    except Exception as exc:  # noqa: BLE001 - evidence never changes currentness
   811	        return None, str(exc)
