   308	def _collect_marker_directory(
   309	    directory: Path,
   310	    references: _References,
   311	    *,
   312	    expected_name: str | None = None,
   313	) -> str | None:
   314	    try:
   315	        directory_info = directory.lstat()
   316	    except FileNotFoundError:
   317	        return None
   318	    except OSError as exc:
   319	        return str(exc)
   320	    if stat.S_ISLNK(directory_info.st_mode) or not stat.S_ISDIR(
   321	        directory_info.st_mode
   322	    ):
   323	        return "marker parent is not a real directory"
   324	    marker_path = directory / ".csk-install.json"
   325	    try:
   326	        before = marker_path.lstat()
   327	    except FileNotFoundError:
   328	        return "marker is missing"
   329	    except OSError as exc:
   330	        return str(exc)
   331	    if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode):
   332	        return "marker is not a regular non-link file"
   333	    try:
   334	        raw = marker_path.read_bytes()
   335	        after = marker_path.lstat()
   336	        marker = install_marker.read_install_marker(raw)
   337	    except (OSError, install_marker.InstallMarkerError) as exc:
   338	        return str(exc)
   339	    if _path_state(before) != _path_state(after):
   340	        return "marker changed while it was read"
   341	    if expected_name is not None and marker.name != expected_name:
   342	        return f"marker name {marker.name!r} does not match store entry"
   343	    references.runtime.add((marker.name, marker.commit))
   344	    references.snapshots.add((marker.source, marker.commit))
   345	    if isinstance(marker, install_marker.InstallMarkerV2):
   346	        references.builds.update(
   347	            build.cache_key for build in marker.builds.values()
   348	        )
   349	    return None
