   313	            forbidden_roots=forbidden_roots,
   314	            cache_backend=cache_backend,
   315	            establish_toolchain=establish_toolchain,
   316	        )
   317	        after = _capture_generation(generation_probe)
   318	        if before == after:
   319	            return plans
   320	        baseline = None
   321	        if attempt + 1 == max_generation_attempts:
   322	            raise BuildPlanningError(
   323	                "concurrent_state_change",
   324	                "shared planning state changed during the read-only build plan",
   325	            )
