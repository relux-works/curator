+		engine, journal := newJournal(t, "txn-windows-journal-remove")
+		path := engine.journalPath(journal.TransactionID)
+		info, err := os.Lstat(path)
+		if err != nil {
+			t.Fatalf("stat journal: %v", err)
+		}
+		if got := info.Mode().Perm(); got != journalMode() {
