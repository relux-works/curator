+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = reader.Close() }()
+	previousStderr := os.Stderr
+	os.Stderr = writer
+	code := runEnforcedShim(filepath.Join(t.TempDir(), "curator"), nil)
