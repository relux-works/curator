+func loadSecurityPostureVector(t *testing.T, tc securityPostureVector) *Config {
+	t.Helper()
+	dir := t.TempDir()
+	machine := cloneStringAnyMap(tc.Machine)
+	if _, ok := machine["skills_root"]; !ok {
