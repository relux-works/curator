ource\":\"compatibility_default\",\"config_key\":\"spawn.execution_policy.sessions.max_resumes\"},\"max_age\":{\"value\":\"24h\",\"source\":\"compatibility_default\",\"config_key\":\"spawn.execution_policy.sessions.max_age\"},\"fresh_fallback\":{\"value\":true,\"source\":\"compatibility_default\",\"config_key\":\"spawn.execution_policy.sessions.fresh_fallback\"}},\"context\":{\"rework\":{\"value\":\"full\",\"source\":\"compatibility_default\",\"config_key\":\"spawn.execution_policy.context.rework\"}},\"review\":{\"max_attempts\":{\"value\":null,\"source\":\"compatibility_default\",\"config_key\":\"spawn.execution_policy.review.max_attempts\"},\"after_limit\":{\"value\":\"pause\",\"source\":\"compatibility_default\",\"config_key\":\"spawn.execution_policy.review.after_limit\"},\"primary_attempt_limit\":null,\"final_audit_reserve\":0}},\"launch_composition\":{\"config_key\":\"spawn.launch_composition.enabled\",\"contract\":\"agents-infra.child-launch-composition\",\"degradation\":\"bare_with_evidence\",\"enabled\":true,\"schema_version\":1},\"max_parallel\":20,\"preferred_agent\":null,\"preferred_agentic_system\":null,\"schedule\":{\"active_window\":null,\"base_preferred_agentic_system\":null,\"config_key\":\"spawn.schedule\",\"configured\":false,\"timezone\":\"UTC\",\"windows\":[]},\"selection\":{\"adjusted_resolution_ack_flag\":\"--ack-resolved\",\"claude_reasoning_effort_supported\":false,\"codex_reasoning_effort_required\":true,\"codex_reasoning_efforts\":[\"low\",\"medium\",\"high\",\"xhigh\",\"max\",\"ultra\"],\"model_criteria\":[\"equal\",\"less_or_equal\",\"greater_or_equal\"],\"model_required\":true,\"ordered_model_criteria\":[\"less_or_equal\",\"greater_or_equal\"],\"ordered_selection_rationale_flag\":\"--selection-rationale\",\"qwen_reasoning_effort_required\":true,\"qwen_reasoning_efforts\":[\"low\",\"medium\",\"high\",\"xhigh\",\"max\"]},\"tracking\":{\"commands\":[\"status\",\"events\",\"watch\",\"wait\",\"directives\",\"directive\"],\"delivery\":\"exter