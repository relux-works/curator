h. Query\nschemas/v1/skillfile-v1.schema.json:25:          \"tag\": {\"$ref\": \"common.schema.json#/$defs/nonEmptyString\"},\nschemas/v1/skillfile-v1.schema.json:29:        \"oneOf\": [{\"required\": [\"tag\"]}, {\"required\": [\"branch\"]}, {\"required\": [\"revision\"]}],\nschemas/v1/install-marker-v1.schema.json:11:    \"ref_kind\": {\"enum\": [\"tag\", \"branch\", \"revision\"]},\nschemas/v1/skillfile-dev-v1.schema.json:4:  \"title\": \"Skillfile.dev.json schema 1\",\nschemas/v1/skillfile-dev-v1.schema.json:6:  \"required\": [\"substitutions\"],\nschemas/v1/skillfile-dev-v1.schema.json:8:    \"substitutions\": {\nschemas/v1/common.schema.json:35:        \"kind\": {\"enum\": [\"tag\", \"revision\"]},\nschemas/v1/common.schema.json:44:        \"kind\": {\"enum\": [\"tag\", \"revision\", \"branch\"]},\nconformance/v1/schema-cases/skillfile-dev-v1/valid.json:2:  \"substitutions\": {\nconformance/v1/schema-cases/skillfile-dev-v1/invalid.json:2:  \"substitutions\": {\nconformance/v1/schema-cases/skillfile-v1/invalid.json:7:      \"tag\": \"v1\"\n","exit_code":0,"status":"completed"}}
