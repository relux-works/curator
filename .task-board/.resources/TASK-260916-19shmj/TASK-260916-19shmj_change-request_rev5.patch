+	writePackage(t, source, "acme", "1.0.0", string(fixtureBytes(t, fixtures, "managed-root-context")))
+	if _, _, _, err := Install(home, InstallOptions{Operand: source}); err != nil {
+		t.Fatalf("install vector profile: %v", err)
+	}
+	native = claudeHome(t)
+	return home, native
