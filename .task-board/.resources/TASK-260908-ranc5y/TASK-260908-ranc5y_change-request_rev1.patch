+		if got.Kind != want.Kind || got.Int != want.Int || got.Str != want.Str || got.Bool != want.Bool || len(got.Arr) != len(want.Arr) || len(got.Obj) != len(want.Obj) {
+			t.Errorf("%q: got %+v want %+v", in, got, want)
