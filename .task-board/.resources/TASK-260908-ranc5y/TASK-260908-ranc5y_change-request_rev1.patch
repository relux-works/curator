+func TestKindString(t *testing.T) {
+	for k, want := range map[Kind]string{KindNull: "null", KindBool: "boolean", KindInt: "integer", KindString: "string", KindArray: "array", KindObject: "object", Kind(9): "Kind(9)"} {
