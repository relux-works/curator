diff --git a/tests/test_validate.py b/tests/test_validate.py
index 4fa5019..418f7dc 100644
--- a/tests/test_validate.py
+++ b/tests/test_validate.py
@@ -30,6 +30,35 @@ class Validation(unittest.TestCase):
     def test_valid(self):
         self.gate(0)
 
+    def test_missing_mcp(self):
+        self.manifest('ivan', lambda m: m['requires'].pop('mcp'))
+        self.gate(1)
+
+    def test_mcp_inventory(self):
+        self.manifest('ivan', lambda m: m['requires']['mcp'].pop('safari'))
+        self.gate(1)
+
+    def test_extra_mcp(self):
+        self.manifest('ivan', lambda m: m['requires']['mcp'].update(extra={
+            'git': 'git@github.com:relux-works/relux-mcp.git', 'range': '^1.0'}))
+        self.gate(1)
+
+    def test_mcp_source(self):
+        for name in ('figma', 'safari'):
+            with self.subTest(name=name):
+                self.manifest('ivan', lambda m: m['requires']['mcp'][name].update(
+                    git='git@github.com:relux-works/wrong.git'))
+                self.gate(1)
+                self.manifest('ivan', lambda m: m['requires']['mcp'][name].update(
+                    git='git@github.com:relux-works/relux-mcp.git'))
+
+    def test_mcp_range(self):
+        for name in ('figma', 'safari'):
+            with self.subTest(name=name):
+                self.manifest('ivan', lambda m: m['requires']['mcp'][name].update(range='^2.0'))
+                self.gate(1)
+                self.manifest('ivan', lambda m: m['requires']['mcp'][name].update(range='^1.0'))
+
     def test_trailing_lf(self):
         p = self.root / 'packages/relux-root-context-style/context/INSTRUCTIONS_STYLE.md'
         p.write_bytes(p.read_bytes() + b'\n')
