--- a/scripts/validate.sh
+++ b/scripts/validate.sh
@@ -134,6 +134,12 @@ for pkg in pkgs:
 
 umbrella = json.load(open(os.path.join(root, "packages/relux-root-context-ivan/agent-context.json"),
                                       encoding="utf-8"))
+mcp_req = umbrella.get("requires", {}).get("mcp", {})
+if set(mcp_req) != {"figma", "safari"}:
+    die("umbrella requires.mcp must name exactly figma and safari")
+for name, entry in mcp_req.items():
+    if entry != {"git": "git@github.com:relux-works/relux-mcp.git", "range": "^1.0"}:
+        die("umbrella requires.mcp.%s must use relux-mcp Git source with range ^1.0" % name)
 ctx_req = umbrella.get("requires", {}).get("contexts", {})
 if set(ctx_req) != set(pkgs) - {"relux-root-context-ivan"}:
     die("umbrella requires.contexts must name exactly the five leaf packages")
