+	writeGitRepoFile(t, root, "agent-context.json", `{"schema_version": 1, "name": "withmcp", "version": "1.0.0",`+
+		`"requires": {"mcp": {"tool": {"git": "https://example.com/mcp-tool", "range": "*"}}}}`+"\n")
+	runGitRepo(t, root, "init")
