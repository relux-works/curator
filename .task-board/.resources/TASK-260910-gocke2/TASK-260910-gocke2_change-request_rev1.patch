+		{"null-silent", nil, true, []string{"FIGMA_API_KEY"}, ""},
+		{"list-bounds-silently", []string{"FIGMA_API_KEY"}, true, []string{"FIGMA_API_KEY"}, ""},
+		{"empty-list-bounds-all", []string{}, true, []string{}, ""},
