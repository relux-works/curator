+// TestEmptyAllowlistWarningLeavesCurrentStatusCurrent proves the
+// mcp_package_allowlist_empty warning does not make an otherwise-current
+// environment status non-current.
+func TestEmptyAllowlistWarningLeavesCurrentStatusCurrent(t *testing.T) {
+	fx := writeManagedFixture(t, "acme")
+	seedLiveNativeCredentials(t, fx)
+	if err := EnsureDefault(fx.home); err != nil {
+		t.Fatal(err)
+	}
+	for _, profile := range []string{"acme", DefaultProfile} {
+		for _, environment := range []string{"claude_code", "codex_cli", "opencode", "pi"} {
+			req := fx.request(environment)
+			req.Profile = profile
+			req.Repair = true
+			if _, err := Resolve(req); err != nil {
+				t.Fatalf("provision %s/%s: %v", profile, environment, err)
+			}
+		}
+	}
+
+	req := statusRequest(fx)
+	req.Policy = Policy{MCPAllowlist: []string{"https://example.com/m"}}
+	quiet, err := StatusOf(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	nonCurrentHomes := func(status *Status) []string {
+		var rows []string
+		for _, home := range status.Homes {
+			if !home.Current {
+				rows = append(rows, home.Profile+"/"+home.Environment)
+			}
+		}
+		return rows
+	}
+	if quiet.NonCurrent {
+		t.Fatalf("control fixture is not current: homes=%v scopes=%+v diagnostics=%v", nonCurrentHomes(quiet), quiet.Scopes, quiet.Diagnostics)
+	}
+
+	req.Policy = Policy{}
+	warned, err := StatusOf(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertWarningPresent(t, warned.Warnings, DiagAllowlistEmpty)
+	if warned.NonCurrent {
+		t.Fatalf("empty-allowlist warning made an otherwise-current status non-current: homes=%v scopes=%+v diagnostics=%v", nonCurrentHomes(warned), warned.Scopes, warned.Diagnostics)
+	}
 }
 
