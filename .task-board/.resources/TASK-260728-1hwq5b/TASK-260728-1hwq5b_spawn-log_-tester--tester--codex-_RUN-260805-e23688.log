@@ -0,0 +1,51 @@
+$ErrorActionPreference = 'Stop'
+$taskRoot = Join-Path ([IO.Path]::GetTempPath()) ("TASK-260728-1hwq5b-capability-" + [Guid]::NewGuid().ToString("N"))
+$fixture = Join-Path $taskRoot "skill"
+New-Item -ItemType Directory -Path $fixture -Force | Out-Null
+try {
+  $files = @{
+    "SKILL.md" = "LS0tCm5hbWU6IGdvbGRlbi1za2lsbApkZXNjcmlwdGlvbjogcmM1IGJsYWNrLWJveCBjYXBhYmlsaXR5IHByb2JlCi0tLQojIEdvbGRlbiBza2lsbAo="
+    "agent-skill.json" = ""
+    "csk-skill.json" = ""
+    "skill-build.json" = ""
+  }
+  foreach ($entry in $files.GetEnumerator()) {
+    [IO.File]::WriteAllBytes((Join-Path $fixture $entry.Key), [Convert]::FromBase64String($entry.Value))
+  }
+  function Invoke-Probe([string]$Executable, [string[]]$Arguments) {
+    $psi = [Diagnostics.ProcessStartInfo]::new()
+    $psi.FileName = $Executable
+    $psi.UseShellExecute = $false
+    $psi.RedirectStandardOutput = $true
+    $psi.RedirectStandardError = $true
+    foreach ($argument in $Arguments) { [void]$psi.ArgumentList.Add($argument) }
+    $process = [Diagnostics.Process]::Start($psi)
+    $stdout = $process.StandardOutput.ReadToEnd()
+    $stderr = $process.StandardError.ReadToEnd()
+    $process.WaitForExit()
+    return [ordered]@{ exit_code = $process.ExitCode; stdout = $stdout; stderr = $stderr }
+  }
+  $curator = (Get-Command curator.exe -ErrorAction Stop).Source
+  $csk = (Get-Command csk.exe -ErrorAction Stop).Source
+  $result = [ordered]@{
+    os = [Environment]::OSVersion.VersionString
+    architecture = [Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString()
+    powershell = $PSVersionTable.PSVersion.ToString()
+    curator = [ordered]@{
+      path_class = "released-path"
+      sha256 = (Get-FileHash -Algorithm SHA256 $curator).Hash.ToLowerInvariant()
+      version = Invoke-Probe $curator @("--version")
+      capability = Invoke-Probe $curator @("skill", "check", $fixture, "--json")
+    }
+    csk = [ordered]@{
+      path_class = "released-path"
+      sha256 = (Get-FileHash -Algorithm SHA256 $csk).Hash.ToLowerInvariant()
+      version = Invoke-Probe $csk @("--version")
+      capability = Invoke-Probe $csk @("skill", "check", $fixture, "--json")
+    }
+  }
+  $result | ConvertTo-Json -Depth 8
+}
+finally {
+  if (Test-Path -LiteralPath $taskRoot) { Remove-Item -LiteralPath $taskRoot -Recurse -Force }
+}
