+test "$(shasum -a 256 "$CONFORMANCE_ROOT/manifest.json" | awk '{print $1}')" = "$EXPECTED_MANIFEST"
+python3 -c 'import shutil; assert shutil.disk_usage("/System/Volumes/Data").free >= 20 * 1024**3'
