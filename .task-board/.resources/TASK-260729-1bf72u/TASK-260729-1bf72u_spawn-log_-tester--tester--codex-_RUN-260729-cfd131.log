+
+Get-Acl -LiteralPath $ApprovedGoRoot | Format-List Owner,Sddl
+Get-FileHash -Algorithm SHA256 -LiteralPath $ApprovedGo
+Get-AuthenticodeSignature -LiteralPath $ApprovedGo |
