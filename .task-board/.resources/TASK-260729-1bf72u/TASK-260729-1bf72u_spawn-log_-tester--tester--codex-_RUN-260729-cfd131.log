        check=False,
        capture_output=True,
        text=True,
        timeout=5,
        env={
            **os.environ,
            "HOOK_PATH": str(hook_path),
            "NESTED": str(nested),
            "SHELL": executable,
        },
    )

    assert completed.returncode == 0, completed.stderr
    assert completed.stdout == "sources=1\n"


