// ignored.
func TestGlobalStatusRejectsPositionalArguments(t *testing.T) {
	legacyGlobalScope(t)
	if code, _, _ := capture(t, "global", "status", "somewhere"); code != exitUsage {
		t.Fatalf("global status with a positional argument = %d, want %d", code, exitUsage)
	}
}

