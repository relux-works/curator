index 0000000000000000000000000000000000000000..0dbb965ccddf2e736806f999d02a5a8241365f0b
--- /dev/null
+++ b/cmd/curator/command_help_mutants_test.go
@@ -0,0 +1,63 @@
+package main
+
+import (
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// Each overlay weakens one help boundary while leaving the guard present.
+// Only exit 1 plus a named behavioral test failure counts as a killed mutant;
+// compilation errors, setup failures and timeouts cannot satisfy this control.
+func TestCommandHelpNarrowingMutants(t *testing.T) {
+	for _, mutant := range []struct {
+		name, file, before, after, test, failure string
+	}{
+		{"init-bypasses-help", "main.go", `command != nil && hasHelpFlag(args[1:])`, `command != nil && args[0] != "init" && hasHelpFlag(args[1:])`, "^TestRegisteredSubcommandHelpNoWrites$/^init$", "--- FAIL: TestRegisteredSubcommandHelpNoWrites/init/1"},
+		{"only-leading-flags", "command_help.go", `if arg == "-h" || arg == "--help" {`, `if (arg == "-h" || arg == "--help") && (args[0] == "-h" || args[0] == "--help") {`, "^TestRegisteredSubcommandHelpNoWrites$/^init$", "--- FAIL: TestRegisteredSubcommandHelpNoWrites/init/2"},
+		{"help-crosses-separator", "command_help.go", "if arg == \"--\" {\n\t\t\tbreak\n\t\t}\n\t\tif arg == \"-h\"", "if arg == \"--\" {\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"-h\"", "^TestCommandHelpRunPassthrough$", "--- FAIL: TestCommandHelpRunPassthrough"},
+	} {
+		t.Run(mutant.name, func(t *testing.T) {
+			original, err := filepath.Abs(mutant.file)
+			if err != nil {
+				t.Fatal(err)
+			}
+			data, err := os.ReadFile(original)
+			if err != nil {
+				t.Fatal(err)
+			}
+			source := strings.ReplaceAll(string(data), "\r\n", "\n")
+			if strings.Count(source, mutant.before) != 1 {
+				t.Fatal("mutation anchor is not unique")
+			}
+			dir := t.TempDir()
+			replacement := filepath.Join(dir, "replacement.go")
+			if err := os.WriteFile(replacement, []byte(strings.Replace(source, mutant.before, mutant.after, 1)), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			data, err = json.Marshal(map[string]any{"Replace": map[string]string{original: replacement}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			overlay := filepath.Join(dir, "overlay.json")
+			if err := os.WriteFile(overlay, data, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			command := exec.Command("go", "test", "-count=1", "-timeout=3m", "-v", "-run", mutant.test, ".")
+			// GOFLAGS carries the overlay into the real CLI binary built by the
+			// behavioral suite too. These child tests do not fingerprint GOROOT;
+			// reuse the repository's helper protocol to avoid taking its lock twice.
+			command.Env = append(os.Environ(), cliHelperProcess+"=1", "GOFLAGS="+os.Getenv("GOFLAGS")+" "+strconv.Quote("-overlay="+overlay))
+			output, err := command.CombinedOutput()
+			exit, ok := err.(*exec.ExitError)
+			if !ok || exit.ExitCode() != 1 || !strings.Contains(string(output), mutant.failure) || strings.Contains(string(output), "build failed") {
+				t.Fatalf("mutant lacks intended behavioral exit 1: %v\n%s", err, output)
+			}
+			t.Logf("mutant %s: go test -run %q . exit=1; killed by %s", mutant.name, mutant.test, mutant.failure)
+		})
+	}
+}
diff --git a/cmd/curator/command_help_test.go b/cmd/curator/command_help_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d5a0969b9a34bbbf9bc72146b88031c1c40fde11
--- /dev/null
+++ b/cmd/curator/command_help_test.go
@@ -0,0 +1,250 @@
+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+func buildHelpCLI(t *testing.T) string {
+	t.Helper()
+	binary := filepath.Join(t.TempDir(), "curator"+productionBinarySuffix())
+	command := exec.Command("go", "build", "-o", binary, ".")
+	if out, err := command.CombinedOutput(); err != nil {
+		t.Fatalf("build CLI: %v\n%s", err, out)
+	}
+	return binary
+}
+
+type helpSandbox struct {
+	root string
+	cwd  string
+	env  []string
+}
+
+func newHelpSandbox(t *testing.T) helpSandbox {
+	t.Helper()
+	root := t.TempDir()
+	sandbox := helpSandbox{root: root, cwd: filepath.Join(root, "cwd")}
+	for _, name := range []string{"cwd", "home", "curator", "tmp", "xdg"} {
+		dir := filepath.Join(root, name)
+		if err := os.Mkdir(dir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "sentinel"), []byte("preserve existing bytes\n"), 0o640); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, entry := range os.Environ() {
+		key, _, _ := strings.Cut(entry, "=")
+		if strings.HasPrefix(key, "CURATOR_") || strings.HasPrefix(key, "XDG_") {
+			continue
+		}
+		switch key {
+		case "HOME", "USERPROFILE", "TMPDIR", "TMP", "TEMP", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_NOSYSTEM":
+			continue
+		}
+		sandbox.env = append(sandbox.env, entry)
+	}
+	sandbox.env = append(sandbox.env,
+		"HOME="+filepath.Join(root, "home"), "USERPROFILE="+filepath.Join(root, "home"),
+		"CURATOR_HOME="+filepath.Join(root, "curator"), "CURATOR_CONFIG="+filepath.Join(root, "curator", "config.json"),
+		"XDG_CONFIG_HOME="+filepath.Join(root, "xdg"), "TMPDIR="+filepath.Join(root, "tmp"),
+		"TMP="+filepath.Join(root, "tmp"), "TEMP="+filepath.Join(root, "tmp"),
+		"GIT_CONFIG_GLOBAL="+os.DevNull, "GIT_CONFIG_NOSYSTEM=1")
+	command := exec.Command("git", "init", "--quiet")
+	command.Dir, command.Env = sandbox.cwd, sandbox.env
+	if out, err := command.CombinedOutput(); err != nil {
+		t.Fatalf("empty git repo: %v\n%s", err, out)
+	}
+	return sandbox
+}
+
+type helpTreeEntry struct {
+	Size int64
+	Mode fs.FileMode
+	Hash [sha256.Size]byte
+}
+
+func snapshotHelpTree(t *testing.T, root string) map[string]helpTreeEntry {
+	t.Helper()
+	entries := make(map[string]helpTreeEntry)
+	err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		value := helpTreeEntry{Size: info.Size(), Mode: info.Mode()}
+		if info.Mode().IsRegular() {
+			data, err := os.ReadFile(path)
+			if err != nil {
+				return err
+			}
+			value.Hash = sha256.Sum256(data)
+		}
+		entries[rel] = value
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return entries
+}
+
+func (sandbox helpSandbox) invoke(t *testing.T, binary string, args ...string) (int, string, string) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	command := exec.CommandContext(ctx, binary, args...)
+	command.Dir, command.Env = sandbox.cwd, sandbox.env
+	var stdout, stderr strings.Builder
+	command.Stdout, command.Stderr = &stdout, &stderr
+	err := command.Run()
+	if ctx.Err() != nil {
+		t.Fatalf("CLI %v timed out", args)
+	}
+	code := 0
+	if err != nil {
+		if exit, ok := err.(*exec.ExitError); ok {
+			code = exit.ExitCode()
+		} else {
+			t.Fatal(err)
+		}
+	}
+	return code, stdout.String(), stderr.String()
+}
+
+// Every registered built-in and child topic answers both help flags at each
+// command-path position and after operands, plus help <command>, via main().
+// Persistent tree paths, sizes, modes and file bytes must remain unchanged;
+// snapshots cannot observe a transient write that is removed before exit.
+func TestRegisteredSubcommandHelpNoWrites(t *testing.T) {
+	binary := buildHelpCLI(t)
+	seen := make(map[string]bool)
+	for _, command := range commandRegistry {
+		t.Run(strings.ReplaceAll(command.name, " ", "/"), func(t *testing.T) {
+			if seen[command.name] {
+				t.Fatalf("duplicate registry entry %q", command.name)
+			}
+			seen[command.name] = true
+			path := strings.Fields(command.name)
+			cases := [][]string{append([]string{"help"}, path...)}
+			for _, flag := range []string{"-h", "--help"} {
+				for position := 1; position <= len(path); position++ {
+					args := append([]string{}, path[:position]...)
+					args = append(args, flag)
+					args = append(args, path[position:]...)
+					cases = append(cases, args)
+				}
+				cases = append(cases, append(append([]string{}, path...), "operand", "--invalid-option", flag, "--", "--help"))
+			}
+			sandbox := newHelpSandbox(t)
+			var dedicated string
+			for index, args := range cases {
+				t.Run(fmt.Sprint(index), func(t *testing.T) {
+					before := snapshotHelpTree(t, sandbox.root)
+					code, stdout, stderr := sandbox.invoke(t, binary, args...)
+					after := snapshotHelpTree(t, sandbox.root)
+					if !reflect.DeepEqual(before, after) {
+						t.Errorf("%v wrote to the isolated tree: before=%v after=%v", args, before, after)
+					}
+					if code != 0 || stderr != "" || !strings.Contains(stdout, "curator "+command.name) {
+						t.Fatalf("%v: exit=%d stdout=%q stderr=%q; want dedicated help and exit 0", args, code, stdout, stderr)
+					}
+					if index == 0 {
+						dedicated = stdout
+					} else if stdout != dedicated {
+						t.Fatalf("%v differs from help %s", args, command.name)
+					}
+				})
+			}
+		})
+	}
+}
+
+// The no-help positive control reaches cmdInit through main() and creates both
+// project files; top-level help/version controls still preserve the tree.
+func TestCommandHelpInitPositiveControl(t *testing.T) {
+	binary := buildHelpCLI(t)
+	sandbox := newHelpSandbox(t)
+	for _, args := range [][]string{{"-h"}, {"--help"}, {"help"}, {"--version"}} {
+		before := snapshotHelpTree(t, sandbox.root)
+		if code, _, stderr := sandbox.invoke(t, binary, args...); code != 0 || stderr != "" {
