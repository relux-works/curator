   330	func copyWithContext(ctx context.Context, destination io.Writer, source io.Reader) (int64, error) {
   331		buffer := make([]byte, 128*1024)
   332		var total int64
   333		for {
   334			if err := ctx.Err(); err != nil {
   335				return total, fmt.Errorf("%w: %w", errCopyAbandoned, err)
   336			}
   337			read, readErr := source.Read(buffer)
   338			if read > 0 {
   339				written, writeErr := destination.Write(buffer[:read])
   340				total += int64(written)
   341				if writeErr != nil {
   342					return total, writeErr
   343				}
   344				if written != read {
   345					return total, io.ErrShortWrite
   346				}
   347			}
   348			if readErr != nil {
   349				if readErr == io.EOF {
   350					return total, nil
   351				}
   352				return total, readErr
   353			}
   354		}
   355	}
