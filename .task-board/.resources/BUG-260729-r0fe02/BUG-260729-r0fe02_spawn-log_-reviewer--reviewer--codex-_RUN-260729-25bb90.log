    62	// digestToolchainRecords writes the canonical byte stream and hashes it.
    63	//
    64	// Every file is re-opened from GOROOT by its root-relative path, so the bytes
    65	// that reach the digest always come from whatever is reachable at that
    66	// canonical path at read time, under the containment os.Root enforces on each
    67	// component. Reusing an ancestor handle here instead would keep reading through
    68	// a directory that had been renamed out of the tree, which is why this phase
    69	// resolves paths and the collection phase does not.
    70	func digestToolchainRecords(ctx context.Context, root *os.Root, records []treeRecord, version string) (string, []toolchainState, error) {
    71		digest := sha256.New()
    72		_, _ = io.WriteString(digest, toolchainDomain)
