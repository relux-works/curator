    75			if err := ctx.Err(); err != nil {
    76				return "", nil, diagnosticErr("toolchain_timeout", err, "toolchain fingerprint deadline exceeded")
    77			}
    78			pathBytes := []byte(record.path)
    79			writeRecordHeader(digest, record.kind, pathBytes)
    80			item := toolchainState{path: record.path, kind: record.kind}
    81			switch record.kind {
    82			case 'D':
    83				writeLength(digest, 0)
    84			case 'L':
    85				payload := []byte(record.link)
    86				writeLength(digest, uint64(len(payload)))
    87				_, _ = digest.Write(payload)
    88				item.size = int64(len(payload))
    89				item.payload = sha256.Sum256(payload)
    90			case 'F':
    91				file, openErr := root.Open(record.path)
    92				if openErr != nil {
    93					return "", nil, diagnosticErr("toolchain_unreadable", openErr, "cannot open toolchain file %q", record.path)
    94				}
    95				opened, statErr := file.Stat()
    96				if statErr != nil || !opened.Mode().IsRegular() || !os.SameFile(record.info, opened) {
    97					_ = file.Close()
    98					return "", nil, diagnosticErr("toolchain_mutated", statErr, "toolchain file %q changed while opening", record.path)
    99				}
   100				if opened.Size() < 0 {
   101					return "", nil, diagnostic("toolchain_mutated", "toolchain file %q reports a negative size", record.path)
   102				}
   103				writeLength(digest, uint64(opened.Size())) // #nosec G115 -- the size was just proved non-negative
   104				contentDigest := sha256.New()
