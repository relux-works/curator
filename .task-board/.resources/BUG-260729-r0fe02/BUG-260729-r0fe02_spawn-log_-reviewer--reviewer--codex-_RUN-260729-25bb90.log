   301	// errCopyAbandoned marks the copy loop's own cancellation check, so the digest
   302	// phase can tell "the caller stopped reading" from "the read failed" without
   303	// having to recognise an error that came back from the filesystem.
   304	var errCopyAbandoned = errors.New("toolchain copy abandoned")
   305	
   306	// digestCopyDiagnostic classifies a record copy that did not finish cleanly.
   307	//
   308	// A copy carrying errCopyAbandoned stopped because the caller's context ended
   309	// mid-file, and the short length that comes with it is that abort rather than
   310	// the file moving underneath the read; cancellation is reported as the same
   311	// deadline diagnostic every other cancellation check in this file reports. The
   312	// precedence is exactly that narrow: only the abort this package raised is read
   313	// as cancellation, so a genuine concurrent write — a read or close failure, or a
   314	// length that moved on its own — still fails closed as toolchain_mutated even
   315	// when the context happens to be done.
   316	func digestCopyDiagnostic(path string, written, size int64, copyErr, closeErr error) error {
   317		if errors.Is(copyErr, errCopyAbandoned) {
   318			return diagnosticErr("toolchain_timeout", errors.Join(copyErr, closeErr), "toolchain fingerprint deadline exceeded")
   319		}
   320		if copyErr != nil || closeErr != nil || written != size {
   321			var lengthErr error
   322			if written != size {
   323				lengthErr = errors.New("file length changed")
   324			}
   325			return diagnosticErr("toolchain_mutated", errors.Join(copyErr, closeErr, lengthErr), "toolchain file %q changed while reading", path)
   326		}
   327		return nil
   328	}
