   598			legacyRecords, legacyCollectErr := legacyCollectRecords(ctx, handle)
   599			scopedRecords, scopedCollectErr := collectToolchainRecords(ctx, handle)
   600			if legacyCollectErr != nil || scopedCollectErr != nil {
   601				t.Fatalf("collection failed before cancellation: %v / %v", legacyCollectErr, scopedCollectErr)
   602			}
