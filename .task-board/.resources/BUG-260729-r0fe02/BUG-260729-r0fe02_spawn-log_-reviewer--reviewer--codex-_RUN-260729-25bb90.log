   606			_, _, scopedErr := digestToolchainRecords(ctx, handle, scopedRecords, equivalenceVersion)
   607			if DiagnosticCode(legacyErr) != "toolchain_timeout" || DiagnosticCode(scopedErr) != "toolchain_timeout" {
   608				t.Fatalf("legacy %v, scoped %v", legacyErr, scopedErr)
   609			}
   610			if legacyErr.Error() != scopedErr.Error() {
   611				t.Fatalf("detail: legacy %q, scoped %q", legacyErr.Error(), scopedErr.Error())
   612			}
   613		})
   614	
   615		// The contract in full, with nothing left to the scheduler: every cancellation
   616		// point the fingerprint can reach is taken in turn, and each one must produce
   617		// the deadline diagnostic or a clean fingerprint — never toolchain_mutated,
   618		// because a context ending is not the toolchain changing. Walking the budget
   619		// up rather than naming a few interesting values is what makes this a proof
   620		// instead of a sample: a check that a later edit adds inside the copy loop, or
   621		// anywhere else in either phase, is covered the moment it exists.
   622		t.Run("every cancellation point stays a deadline", func(t *testing.T) {
   623			// The sweep has to run past the last check to be exhaustive, and the
   624			// budget that first completes cleanly proves it got there.
   625			completed := false
   626			for budget := 0; budget < 200; budget++ {
   627				ctx := newCountdownContext(budget)
   628				_, _, err := fingerprintToolchain(ctx, root, equivalenceVersion)
   629				switch code := DiagnosticCode(err); {
   630				case err == nil:
   631					completed = true
   632				case code == "toolchain_timeout":
   633					if !errors.Is(err, context.Canceled) {
   634						t.Fatalf("budget %d: %v does not unwrap to context.Canceled", budget, err)
   635					}
   636				default:
   637					t.Fatalf("budget %d: error = %v, want nil or toolchain_timeout", budget, err)
   638				}
   639				if completed {
   640					break
   641				}
   642			}
   643			if !completed {
   644				t.Fatal("no budget in the sweep completed the fingerprint; the sweep never reached the last check")
   645			}
   646		})
   647	}
   648	
   649	// countdownContext reports no error for a fixed number of Err calls and reports
   650	// cancellation for every call after that. It exists so a test can place a
   651	// cancellation on an exact check inside the digest phase — including checks
   652	// taken between two chunks of one file — instead of racing a goroutine against
   653	// a read and hoping it lands in the window under test. It is used from a single
   654	// goroutine, which is how the digest phase consumes a context.
   655	type countdownContext struct {
   656		context.Context
   657		remaining int
   658		done      chan struct{}
   659	}
   660	
   661	func newCountdownContext(checks int) *countdownContext {
   662		return &countdownContext{Context: context.Background(), remaining: checks, done: make(chan struct{})}
   663	}
   664	
   665	func (ctx *countdownContext) Err() error {
   666		if ctx.remaining > 0 {
   667			ctx.remaining--
   668			return nil
   669		}
   670		select {
   671		case <-ctx.done:
   672		default:
   673			close(ctx.done)
   674		}
   675		return context.Canceled
   676	}
   677	
   678	func (ctx *countdownContext) Done() <-chan struct{} { return ctx.done }
