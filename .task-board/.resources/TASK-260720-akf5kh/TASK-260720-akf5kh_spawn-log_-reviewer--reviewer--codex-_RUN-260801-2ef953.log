) -> ProjectResult:
    generation_probe = _project_generation_probe(config, project)
    attempts = 2 if options.dry_run else 3
    csk_home = config.path.parent
    project_lock = (
        ExitStack()
        if options.dry_run
        else locking.ProjectLock(csk_home, project.path)
    )
