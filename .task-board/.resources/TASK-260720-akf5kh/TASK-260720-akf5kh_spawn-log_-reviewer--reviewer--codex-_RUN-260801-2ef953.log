            "GONOPROXY": "none",
            "GONOSUMDB": "none",
            "GOVCS": "*:off",
            "GOWORK": "off",
            "CGO_ENABLED": "0",
            "GO_EXTLINK_ENABLED": "0",
            "GOEXPERIMENT": "",
        }
    )
    values.update(target.tuning)
    return dict(sorted(values.items()))


