    def __init__(
        self,
        path: Path,
        root_stat: os.stat_result,
        root_fd: int | None,
        scan: _SnapshotScan,
    ) -> None:
        self._path = path
        self._root_stat = root_stat
        self._root_fd = root_fd
        self._identity = scan.identity
        self._state = scan.state
        self._lock = threading.RLock()
        self._closed = False

