        self.platform = platform
        self.controls = tuple(
            probe.name
            for probe in probes
            if probe.availability == AVAILABILITY_AVAILABLE
        )
        self.limits = limits
        self.installed = False
        self.terminated = False
        self.job_handle = 0
        self.file_limit = 0
