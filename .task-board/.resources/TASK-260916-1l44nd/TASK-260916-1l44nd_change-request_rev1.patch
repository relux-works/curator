+	}
+	var secondStdout, secondStderr bytes.Buffer
+	secondCode := RunShim(ShimRequest{
+		ExePath: launcher, Stdout: &secondStdout, Stderr: &secondStderr,
+		Environ:        []string{"STUB_EXIT=0"},
