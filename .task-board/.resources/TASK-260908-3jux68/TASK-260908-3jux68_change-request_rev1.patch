+        for folder in ('scripts', 'packages', 'tests'):
+            shutil.copytree(root / folder, target / folder)
+        shutil.copy(root / 'SOURCES.sha256', target)
+        (target / '.temp').mkdir()
+        p = target / file; text = p.read_text(); assert text.count(before) == 1
+        p.write_text(text.replace(before, after))
+        # Duplicate probe repeats the first checksum row; choose the corresponding path.
