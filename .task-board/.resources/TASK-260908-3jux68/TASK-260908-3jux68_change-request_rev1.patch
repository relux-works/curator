@@ -0,0 +1,25 @@
+"""Check the reviewed offline source baseline; not an authenticity proof."""
+import hashlib
+import json
+from pathlib import Path
+import re
+
+root = Path(__file__).resolve().parent.parent
+expected = {}
+for line in (root / 'SOURCES.sha256').read_text().splitlines():
+    match = re.fullmatch(r'([0-9a-f]{64})  (packages/[^/]+/context/[^/]+\.md)', line)
+    if not match or match[2] in expected:
+        raise SystemExit('sources: malformed or duplicate checksum row')
+    expected[match[2]] = match[1]
+actual = {p.relative_to(root).as_posix() for p in (root / 'packages').glob('*/context/*')}
+declared = set()
+for manifest in (root / 'packages').glob('*/agent-context.json'):
+    for mod in json.loads(manifest.read_text()).get('context', {}).get('modules', []):
+        declared.add((manifest.parent / 'context' / mod['path']).relative_to(root).as_posix())
+if set(expected) != actual or set(expected) != declared:
+    raise SystemExit('sources: checksum, disk and manifest inventories differ')
+for path, digest in expected.items():
+    raw = (root / path).read_bytes()
+    if hashlib.sha256(raw).hexdigest() != digest:
+        raise SystemExit('sources: byte drift: ' + path)
+print(f'sources: {len(expected)} module digests OK')
