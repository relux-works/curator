+ ('weight', 'scripts/validate.sh', 'if weight != leaf_weights[name]:', 'if weight != leaf_weights[name] and leaf_weights[name] != 101:', 'test_weight_drift'),
+ ('digest', 'scripts/check_sources.py', 'if hashlib.sha256(raw).hexdigest() != digest:', 'if hashlib.sha256(raw).hexdigest() != digest and not raw.startswith(b"changed\\n"):', 'test_source_drift'),
