+ ('inventory', 'scripts/check_sources.py', 'if set(expected) != actual or set(expected) != declared:', 'if (set(expected) != actual or set(expected) != declared) and len(expected) != 13:', 'test_missing_row'),
+ ('duplicate', 'scripts/check_sources.py', 'if not match or match[2] in expected:', 'if not match or (match[2] in expected and match[2] != "packages/relux-root-context-style/context/INSTRUCTIONS_STYLE.md"):', 'test_duplicate_row'),
