@@ -0,0 +1,69 @@
+"""Behavioral probes execute the shipped shell entry point in isolated copies."""
+import json
+import hashlib
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+class Validation(unittest.TestCase):
+    def setUp(self):
+        (ROOT / ".temp").mkdir(exist_ok=True)
+        self.tmp = tempfile.TemporaryDirectory(dir=ROOT / '.temp')
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        for name in ('packages', 'scripts'):
+            shutil.copytree(ROOT / name, self.root / name)
+        shutil.copy(ROOT / 'SOURCES.sha256', self.root)
+
+    def gate(self, expected):
+        result = subprocess.run(['bash', 'scripts/validate.sh'], cwd=self.root, capture_output=True, text=True)
+        self.assertEqual(result.returncode, expected, result.stdout + result.stderr)
+
+    def manifest(self, name, change):
+        p = self.root / 'packages' / ('relux-root-context-' + name) / 'agent-context.json'
+        obj = json.loads(p.read_text()); change(obj); p.write_text(json.dumps(obj))
+
+    def test_valid(self):
+        self.gate(0)
+
+    def test_trailing_lf(self):
+        p = self.root / 'packages/relux-root-context-style/context/INSTRUCTIONS_STYLE.md'
+        p.write_bytes(p.read_bytes() + b'\n')
+        # Isolate byte-format validation from the independent digest gate.
+        sums = self.root / 'SOURCES.sha256'
+        rows = sums.read_text().splitlines()
+        rel = p.relative_to(self.root).as_posix()
+        sums.write_text('\n'.join(hashlib.sha256(p.read_bytes()).hexdigest() + '  ' + rel if row[66:] == rel else row for row in rows) + '\n')
+        self.gate(1)
+
+    def test_unknown_env(self):
+        self.manifest('claude', lambda m: m['context']['modules'][0].update(environments=['future_env']))
+        self.gate(1)
+
+    def test_weight_drift(self):
+        self.manifest('core', lambda m: m.update(weight=101)); self.gate(1)
