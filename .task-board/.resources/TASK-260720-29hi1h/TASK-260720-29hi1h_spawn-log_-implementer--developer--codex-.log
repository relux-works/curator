+	live := Dir(home, "skill-a", "commit-a")
+	lay(t, live, map[string]string{"scripts/tool": "#!/bin/sh\n"})
+	if err := os.Chmod(filepath.Join(live, "scripts", "tool"), 0o755); err != nil {
+		t.Fatal(err)
