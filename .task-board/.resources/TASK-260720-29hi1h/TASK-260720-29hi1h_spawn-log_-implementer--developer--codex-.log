+		Toolchain: buildmeta.Toolchain{Algorithm: buildmeta.ToolchainAlgorithm, GoRelpath: buildmeta.ToolchainGoRelpath, GoVersion: "go version fixture", ContentSHA256: "sha256:" + strings.Repeat("c", 64)},
