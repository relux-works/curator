+		RuntimeRoots: []string{"scripts"},
+		Commands:     []skillspec.Command{{Name: "tool", Type: "script", UnixPath: "scripts/tool"}},
+		Platform:     "unix",
+	}
+	for _, testCase := range []struct {
+		name   string
