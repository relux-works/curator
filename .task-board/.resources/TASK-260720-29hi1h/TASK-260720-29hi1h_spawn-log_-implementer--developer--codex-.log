+		RuntimeRoots: []string{"scripts"},
+		Commands:     []skillspec.Command{{Name: "tool", Type: "script", UnixPath: "scripts/tool"}},
+		Platform:     "unix",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	forward, err := runtimestore.NewManagedShim(runtimestore.SafeForwardingShim, selection.Path, "tool", "unix")
