+	if err := os.Rename(target.StagedPath, target.LivePath); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func decodeHelperOutput(t *testing.T, payload []byte) map[string]any {
+	t.Helper()
+	var value map[string]any
+	if err := json.Unmarshal(payload, &value); err != nil {
+		t.Fatal(err)
+	}
+	return value
+}
