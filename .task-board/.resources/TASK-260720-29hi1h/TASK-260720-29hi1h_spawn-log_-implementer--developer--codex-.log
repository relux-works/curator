+func TestMain(m *testing.M) {
+	if os.Getenv(windowsHelperEnv) == "1" {
+		if marker := os.Getenv("CURATOR_WINDOWS_ARTIFACT_MARKER"); marker != "" {
+			_ = os.WriteFile(marker, []byte("launched"), 0o600)
