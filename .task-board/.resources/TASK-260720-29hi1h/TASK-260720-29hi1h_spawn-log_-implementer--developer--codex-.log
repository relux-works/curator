+		Destination: forward,
+		Target:      runtimePlan.Commands["tool"],
+	}}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(plan.Desired) != 1 {
+		t.Fatalf("forwarding transition = %+v", plan)
+	}
