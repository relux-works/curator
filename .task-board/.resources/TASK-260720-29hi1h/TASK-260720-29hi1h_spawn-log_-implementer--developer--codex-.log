+func TestCompiledShimsStageWithoutLaunchThenPostInstallForwardExactly(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("POSIX post-install launch fixture")
+	}
+	root := t.TempDir()
