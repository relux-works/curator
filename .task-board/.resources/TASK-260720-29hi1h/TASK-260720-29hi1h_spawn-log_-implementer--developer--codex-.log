+		for index, want := range wantArgs {
+			if gotArgs[index] != want {
+				t.Fatalf("%s arg %d = %#v, want %#v", target.Role, index, gotArgs[index], want)
+			}
+		}
+		if decoded["path"] != helperPath {
+			t.Fatalf("%s PATH = %#v, want %#v", target.Role, decoded["path"], helperPath)
+		}
+	}
+}

