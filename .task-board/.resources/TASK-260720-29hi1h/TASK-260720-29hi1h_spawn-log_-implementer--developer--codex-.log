+	receipt, err := buildmeta.NewReceipt(input, buildmeta.Artifact{Path: "bin/tool" + map[bool]string{true: ".exe"}[goos == "windows"], SHA256: "sha256:" + strings.Repeat("d", 64), Size: info.Size()})
+	if err != nil {
