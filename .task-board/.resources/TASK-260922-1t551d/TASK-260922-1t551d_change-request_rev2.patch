+// TestDanglingExpectedTargetRepairFails pins the repair half of the
+// dangling contract: a correctly targeted link whose native target went
+// missing is already exactly what repair would establish, so repair
+// leaves the link untouched and fails — restoring the native target and
+// re-running converges. A mutant that drops the target-liveness stat
+// reports current here instead of failing; a mutant that re-links (or
+// removes) the dangling path instead of failing moves the link.
+func TestDanglingExpectedTargetRepairFails(t *testing.T) {
+	fx := writeManagedFixture(t, "acme")
+	nativeAuth := filepath.Join(fx.native["codex_cli"], "auth.json")
+	if err := os.WriteFile(nativeAuth, []byte("{\"t\":\"operator\"}\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	provision(t, fx, "codex_cli", envregistry.DefaultMachineConfig())
+	link := filepath.Join(ManagedHomeDir(fx.home, "acme", "codex_cli"), "auth.json")
+	if _, err := Resolve(fx.request("codex_cli")); err != nil {
+		t.Fatalf("the live home is current: %v", err)
+	}
+	// The native credential goes missing: the link dangles with the
+	// expected target.
+	if err := os.Remove(nativeAuth); err != nil {
+		t.Fatal(err)
+	}
+	stale, err := Resolve(fx.request("codex_cli"))
+	if err == nil || !strings.Contains(err.Error(), DiagHomeStale) {
+		t.Fatalf("a dangling link must be stale, got %v", err)
+	}
+	reasons := strings.Join(stale.StaleReasons, "; ")
+	for _, want := range []string{"is detached", "does not exist", envregistry.DiagCredentialConflict, "auth.json"} {
+		if !strings.Contains(reasons, want) {
+			t.Fatalf("stale reasons carry dangling conflict-class wording, want %q in %q", want, reasons)
+		}
+	}
+	req := fx.request("codex_cli")
+	req.Repair = true
+	_, err = Resolve(req)
+	if err == nil || !strings.Contains(err.Error(), DiagRepairFailed) {
+		t.Fatalf("repair of a dangling link must fail with %s, got %v", DiagRepairFailed, err)
+	}
+	if !strings.Contains(err.Error(), envregistry.DiagCredentialConflict) {
+		t.Fatalf("the failure carries the dangling reason: %v", err)
+	}
+	if target, err := os.Readlink(link); err != nil || target != nativeAuth {
+		t.Fatalf("repair touches nothing: %q (%v)", target, err)
+	}
+	// Restoring the native target heals the home: repair converges.
+	if err := os.WriteFile(nativeAuth, []byte("{\"t\":\"operator\"}\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Resolve(req); err != nil {
+		t.Fatalf("repair converges once the native target is back: %v", err)
+	}
+	if _, err := Resolve(fx.request("codex_cli")); err != nil {
+		t.Fatalf("the healed home is current: %v", err)
+	}
+}
