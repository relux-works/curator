+@pytest.mark.parametrize('schema_name', [
+    'audit-record-v1.schema.json', 'audit-record-v2.schema.json',
+    'registry-log-entry-v2.schema.json', 'registry-bundle-v2.schema.json',
+    'log-response-v3.schema.json',
