+	}
+	if err := os.Mkdir(path, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	requireMode000Unreadable(t, path, func(path string) error {
+		_, err := os.ReadDir(path)
+		return err
+	})
+	directory, err = ReadDir(path)
+	var stateErr *Error
+	if !errors.As(err, &stateErr) || !os.IsPermission(stateErr.Cause) || directory.Kind != KindUnreadable || !strings.Contains(err.Error(), DiagUnreadable) || stateErr.Kind != KindUnreadable {
+		t.Fatalf("unreadable listing = %+v, %v; want typed unreadable outcome", directory, err)
+	}
+}
