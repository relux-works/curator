diff --git a/internal/stateread/stateread.go b/internal/stateread/stateread.go
new file mode 100644
index 00000000..482adde6
--- /dev/null
+++ b/internal/stateread/stateread.go
@@ -0,0 +1,145 @@
+// Package stateread provides a shared boundary for state and surface reads.
+// It classifies only an exact-path not-exist result as absent; every other
+// filesystem error remains unreadable.
+package stateread
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+)
+
+// Kind is the observed state of a manager-owned file or directory.
+type Kind string
+
+const (
+	// KindPresent means the exact path was read successfully.
+	KindPresent Kind = "present"
+	// KindAbsent means the exact path does not exist.
+	KindAbsent Kind = "absent"
+	// KindUnreadable means the exact path failed to read or validate.
+	KindUnreadable Kind = "unreadable"
+)
+
+const (
+	// DiagAbsent is the stable diagnostic for proven path absence.
+	DiagAbsent = "manager_state_absent"
+	// DiagUnreadable is the stable diagnostic for a failed read or decode.
+	DiagUnreadable = "manager_state_unreadable"
+)
+
+// File is the result of a state-file read. Bytes is populated only when the
+// exact path was present and readable.
+type File struct {
+	Kind  Kind
+	Bytes []byte
+}
+
+// Directory is the result of a manager-owned directory listing. Entries is
+// populated only when the exact path was present and readable.
+type Directory struct {
+	Kind    Kind
+	Entries []os.DirEntry
+}
+
+// Metadata is the result of a state-path stat. Info is populated only when
+// the exact path was present and readable.
+type Metadata struct {
+	Kind Kind
+	Info os.FileInfo
+}
+
+// Error preserves the path and the failed-read class for callers that need
+// to attach an operation-specific diagnostic.
+type Error struct {
+	Kind  Kind
+	Path  string
+	Cause error
+}
+
+func (e *Error) Error() string {
+	if e == nil {
+		return ""
+	}
+	code := DiagUnreadable
+	if e.Kind == KindAbsent {
+		code = DiagAbsent
+	}
+	if e.Cause == nil {
+		return fmt.Sprintf("%s: %s", code, e.Path)
+	}
+	return fmt.Sprintf("%s: %s: %v", code, e.Path, e.Cause)
+}
+
+func (e *Error) Unwrap() error {
+	if e == nil {
+		return nil
+	}
+	if e.Kind == KindAbsent && e.Cause == nil {
+		return fs.ErrNotExist
+	}
+	return e.Cause
+}
+
+// AbsentError constructs a typed absence outcome for a caller whose
+// operation requires the file to exist.
+func AbsentError(path string) *Error {
+	return &Error{Kind: KindAbsent, Path: path}
+}
+
+// UnusableError classifies present bytes that cannot be decoded or
+// validated as unreadable state.
+func UnusableError(path string, cause error) *Error {
+	return &Error{Kind: KindUnreadable, Path: path, Cause: cause}
+}
+
+// ReadFile reads state or surface data and keeps exact-path absence separate
+// from all other read failures.
+func ReadFile(path string) (File, error) {
+	data, err := os.ReadFile(path) // #nosec G304 -- caller supplies the exact state or surface path; this seam adds no path components.
+	if err == nil {
+		return File{Kind: KindPresent, Bytes: data}, nil
+	}
+	if os.IsNotExist(err) {
+		return File{Kind: KindAbsent}, nil
+	}
+	return File{Kind: KindUnreadable}, &Error{Kind: KindUnreadable, Path: path, Cause: err}
+}
+
+// ReadDir lists state or surface inventory and keeps exact-path absence separate
+// from all other listing failures.
+func ReadDir(path string) (Directory, error) {
+	entries, err := os.ReadDir(path)
+	if err == nil {
+		return Directory{Kind: KindPresent, Entries: entries}, nil
+	}
+	if os.IsNotExist(err) {
+		return Directory{Kind: KindAbsent}, nil
+	}
+	return Directory{Kind: KindUnreadable}, &Error{Kind: KindUnreadable, Path: path, Cause: err}
+}
+
+// Stat inspects state or surface metadata and keeps exact-path absence separate
+// from all other stat failures.
+func Stat(path string) (Metadata, error) {
+	info, err := os.Stat(path)
+	if err == nil {
+		return Metadata{Kind: KindPresent, Info: info}, nil
+	}
+	if os.IsNotExist(err) {
+		return Metadata{Kind: KindAbsent}, nil
+	}
+	return Metadata{Kind: KindUnreadable}, &Error{Kind: KindUnreadable, Path: path, Cause: err}
+}
+
+// Lstat inspects the exact state path without following a symbolic link.
+func Lstat(path string) (Metadata, error) {
+	info, err := os.Lstat(path)
+	if err == nil {
+		return Metadata{Kind: KindPresent, Info: info}, nil
+	}
+	if os.IsNotExist(err) {
+		return Metadata{Kind: KindAbsent}, nil
+	}
+	return Metadata{Kind: KindUnreadable}, &Error{Kind: KindUnreadable, Path: path, Cause: err}
+}
