+	err := AbsentError("state.json")
+	var stateErr *Error
+	if !errors.Is(err, os.ErrNotExist) || !errors.As(err, &stateErr) || stateErr.Kind != KindAbsent || !strings.Contains(err.Error(), DiagAbsent) {
+		t.Fatalf("absent error = %v; want typed absence compatible with os.ErrNotExist", err)
+	}
+}
+
+func TestReadDirDistinguishesAbsentAndUnreadable(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "state")
+	directory, err := ReadDir(path)
+	if err != nil || directory.Kind != KindAbsent {
