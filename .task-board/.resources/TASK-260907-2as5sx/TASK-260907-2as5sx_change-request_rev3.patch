+
+func requireMode000Unreadable(t *testing.T, path string, read func(string) error) {
+	t.Helper()
+	if err := os.Chmod(path, 0o000); err != nil {
+		t.Skipf("this environment can read a mode-000 file: chmod refused: %v", err)
+	}
+	t.Cleanup(func() { _ = os.Chmod(path, 0o700) })
+	if err := read(path); err == nil {
+		t.Skip("this environment can read a mode-000 file; unreadability is untestable here")
+	}
+}
+
+func TestReadFileDistinguishesAbsentAndUnreadable(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "state.json")
+	file, err := ReadFile(path)
+	if err != nil || file.Kind != KindAbsent {
+		t.Fatalf("absent read = %+v, %v; want absent", file, err)
+	}
+	if err := os.WriteFile(path, []byte("state\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	requireMode000Unreadable(t, path, func(path string) error {
+		_, err := os.ReadFile(path)
+		return err
+	})
+	file, err = ReadFile(path)
+	var stateErr *Error
+	if !errors.As(err, &stateErr) || !os.IsPermission(stateErr.Cause) || file.Kind != KindUnreadable || !strings.Contains(err.Error(), DiagUnreadable) || stateErr.Kind != KindUnreadable {
+		t.Fatalf("unreadable read = %+v, %v; want typed unreadable outcome", file, err)
+	}
+}
+
