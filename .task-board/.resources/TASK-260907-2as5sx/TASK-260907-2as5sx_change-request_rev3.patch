+		}
+		if got := currentOf(t, source); got != "other" {
+			t.Fatalf("current=%q, want other", got)
+		}
+		payload, err := os.ReadFile(filepath.Join(fresh, "CLAUDE.md")) // #nosec G304 -- test home
