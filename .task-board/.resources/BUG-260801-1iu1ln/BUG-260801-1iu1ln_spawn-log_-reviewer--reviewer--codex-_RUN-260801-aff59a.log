 def _build_plans(
     config: GlobalConfig,
     global_manifest: manifest.ProjectManifest,
     *,
     options: installer.InstallOptions,
     stack: ExitStack,
     result: GlobalResult,
 ) -> list[installer.SkillPlan]:
