    snapshot = csk_home / "cache" / "build-skill" / marker["commit"] / "snapshot"
    source = snapshot / "build" / "cmd" / "tool" / "main.go"
    source.write_text(
        source.read_text(encoding="utf-8") + "\n// drift\n",
