     else:
         if not issues:
             print(f"{skill_dir}: ok")
         for issue in issues:
             print(skillcheck.format_issue(issue))
     return EXIT_PARTIAL_FAIL if skillcheck.has_errors(issues) else EXIT_OK
 
 
