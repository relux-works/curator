def alias_rewrite(path: Path, marker: bytes, label: str, *, make_writable: bool = False) -> None:
    before_stat = path.stat()
    if make_writable:
        descriptor = os.open(path, os.O_RDONLY)
        try:
            raw_fchmod(descriptor, stat.S_IMODE(before_stat.st_mode) | stat.S_IWUSR)
        finally:
            os.close(descriptor)
    with raw_io_open(path, 'r+b', buffering=0) as stream:
        original = stream.read()
        stream.seek(0, os.SEEK_END)
        stream.write(marker)
        os.fsync(stream.fileno())
        stream.seek(0)
        stream.write(original)
        stream.truncate(len(original))
        os.fsync(stream.fileno())
        if make_writable:
            raw_fchmod(stream.fileno(), stat.S_IMODE(before_stat.st_mode))
    raw_utime(path, ns=(before_stat.st_atime_ns, before_stat.st_mtime_ns), follow_symlinks=False)
    mutations.append(label)

def corrupt_published_child(source_dir_fd: int, source_name: str, destination_dir_fd: int, destination_name: str) -> None:
