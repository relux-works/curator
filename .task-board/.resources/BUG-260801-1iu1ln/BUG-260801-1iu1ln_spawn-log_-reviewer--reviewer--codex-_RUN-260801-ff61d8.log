import io
import os
import re
import stat
from pathlib import Path
from typing import Any

import pytest
import test_protocol_conformance as conformance
from csk import global_install, installer
from csk.builds import cache_posix
from protocol_lifecycle_observations import (
    clear_manager_lifecycle_observation_cache,
    observe_manager_lifecycle_case,
)

raw_io_open = io.open
raw_fchmod = os.fchmod
raw_utime = os.utime
original_publish = cache_posix._rename_noreplace
original_project_install = installer.install
original_global_install = global_install.install
original_selected_projects = installer._selected_projects
original_private_build = installer._build_private_misses
mutations: list[str] = []

def alias_rewrite(path: Path, marker: bytes, label: str, *, make_writable: bool = False) -> None:
    before_stat = path.stat()
    if make_writable:
        descriptor = os.open(path, os.O_RDONLY)
        try:
            raw_fchmod(descriptor, stat.S_IMODE(before_stat.st_mode) | stat.S_IWUSR)
        finally:
            os.close(descriptor)
    with raw_io_open(path, 'r+b', buffering=0) as stream:
        original = stream.read()
        stream.seek(0, os.SEEK_END)
        stream.write(marker)
        os.fsync(stream.fileno())
        stream.seek(0)
        stream.write(original)
        stream.truncate(len(original))
        os.fsync(stream.fileno())
        if make_writable:
            raw_fchmod(stream.fileno(), stat.S_IMODE(before_stat.st_mode))
    raw_utime(path, ns=(before_stat.st_atime_ns, before_stat.st_mtime_ns), follow_symlinks=False)
    mutations.append(label)

def corrupt_published_child(source_dir_fd: int, source_name: str, destination_dir_fd: int, destination_name: str) -> None:
    original_publish(source_dir_fd, source_name, destination_dir_fd, destination_name)
    if not re.fullmatch(r'[0-9a-f]{64}', destination_name):
        return
    destination_root = Path(os.readlink(f'/dev/fd/{destination_dir_fd}')).resolve(strict=False)
    artifact = next((destination_root / destination_name / 'bin').iterdir())
    alias_rewrite(artifact, b'alias-publication-corruption', 'publication', make_writable=True)

def mutate_project(config_value: Any, *args: Any, **kwargs: Any) -> Any:
    if '/dry-run/project/' in config_value.path.as_posix():
        alias_rewrite(config_value.path, b'alias-project-dry-run', 'project-dry-run')
    return original_project_install(config_value, *args, **kwargs)

