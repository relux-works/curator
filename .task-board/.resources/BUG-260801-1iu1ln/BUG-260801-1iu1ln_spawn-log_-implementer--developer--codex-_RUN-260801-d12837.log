/bin/zsh -lc "sed -n '1041,1240p' /Users/iv/.agents/skills/project-management/SKILL.md && sed -n '1241,1440p' /Users/iv/.agents/skills/project-management/SKILL.md && sed -n '1441,1533p' /Users/iv/.agents/skills/project-management/SKILL.md" in /Users/iv/Developer/ReluxWorks/curator
