        receipt_only = gc_root / "receipt-only.ccj.json"
        receipt_only.write_bytes((entry / "csk-receipt.ccj.json").read_bytes())
        shutil.rmtree(journal_live)
        rejected_entry = entry.parent / ("f" * 64)
