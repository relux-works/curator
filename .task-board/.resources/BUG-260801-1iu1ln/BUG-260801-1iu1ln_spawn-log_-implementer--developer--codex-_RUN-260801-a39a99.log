 def _mutate_scalar(value: Any) -> Any:
     if isinstance(value, bool):
         return not value
     if isinstance(value, int):
         return value + 1
     if isinstance(value, str):
         return value + "-mutated"
     raise AssertionError(f"unsupported lifecycle scalar leaf {value!r}")
 
 
