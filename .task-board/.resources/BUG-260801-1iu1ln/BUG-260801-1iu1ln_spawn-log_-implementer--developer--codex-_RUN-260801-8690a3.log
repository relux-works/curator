+        **kwargs: Any,
+    ) -> Any:
+        if "/dry-run/project/" in config_value.path.as_posix():
+            _transient_descriptor_rewrite(
+                config_value.path,
+                b"\ntransient-project-upgrade-dry-run-write\n",
