+                    original_bytes = os.read(read_fd, state.st_size)
+                    original_mode = stat.S_IMODE(state.st_mode)
+                    os.fchmod(read_fd, original_mode | stat.S_IWUSR)
+                finally:
+                    os.close(read_fd)
+                write_fd = os.open(artifact_name, os.O_WRONLY, dir_fd=bin_fd)
+                try:
