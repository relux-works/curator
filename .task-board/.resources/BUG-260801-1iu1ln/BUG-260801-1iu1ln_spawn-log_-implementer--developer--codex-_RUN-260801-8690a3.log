+
+    def corrupt_live_child_then_restore(
+        source_dir_fd: int,
+        source_name: str,
+        destination_dir_fd: int,
+        destination_name: str,
+    ) -> None:
+        nonlocal corruptions
+        original(
+            source_dir_fd,
+            source_name,
+            destination_dir_fd,
+            destination_name,
+        )
+        if not re.fullmatch(r"[0-9a-f]{64}", destination_name):
+            return
+        entry_fd = os.open(
+            destination_name,
+            os.O_RDONLY | os.O_DIRECTORY,
