+            os.fsync(descriptor)
+            os.ftruncate(descriptor, len(original))
+            os.fsync(descriptor)
+        finally:
+            os.close(descriptor)
+    finally:
+        os.close(parent_fd)
+    assert path.read_bytes() == original
