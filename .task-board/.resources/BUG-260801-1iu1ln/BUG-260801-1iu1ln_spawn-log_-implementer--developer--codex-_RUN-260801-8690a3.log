+            git_ops.fetch_repo(sorted(fetched_repos, key=os.fspath)[0])
+        return nodes
+
+    clear_manager_lifecycle_observation_cache()
+    monkeypatch.setattr(closure, "build_closure", alter_all_project_fetch)
