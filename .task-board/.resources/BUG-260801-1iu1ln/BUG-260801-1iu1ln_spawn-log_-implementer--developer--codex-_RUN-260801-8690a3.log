+            path.name,
+            os.O_WRONLY | os.O_APPEND,
+            dir_fd=parent_fd,
+        )
+        try:
+            os.write(descriptor, marker)
+            os.fsync(descriptor)
+            os.ftruncate(descriptor, len(original))
+            os.fsync(descriptor)
+        finally:
+            os.close(descriptor)
+    finally:
+        os.close(parent_fd)
+    assert path.read_bytes() == original
+
