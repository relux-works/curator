+                    os.fsync(write_fd)
+                    os.lseek(write_fd, 0, os.SEEK_SET)
+                    os.write(write_fd, original_bytes)
+                    os.ftruncate(write_fd, len(original_bytes))
+                    os.fsync(write_fd)
+                    os.fchmod(write_fd, original_mode)
+                finally:
