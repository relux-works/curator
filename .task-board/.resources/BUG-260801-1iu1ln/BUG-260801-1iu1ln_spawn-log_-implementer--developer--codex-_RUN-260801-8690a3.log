+            _transient_descriptor_rewrite(
+                config_value.path,
+                b"\ntransient-global-upgrade-dry-run-write\n",
+            )
+            mutations.append("global")
+        return original_global_install(config_value, *args, **kwargs)
+
+    clear_manager_lifecycle_observation_cache()
