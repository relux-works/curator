+                raw = fcntl.fcntl(descriptor, command, b"\0" * 1024)
+            except OSError:
+                return None
+            if isinstance(raw, bytes):
+                value = raw.split(b"\0", 1)[0]
+                if value:
+                    return Path(os.fsdecode(value)).resolve(strict=False)
+    return None
+
