+            )
+            != _lifecycle_case("dry_run_cases", name)
+        }
+        assert differences == {"project-upgrade", "global-upgrade"}
+        assert set(mutations) == {"project", "global"}
+    finally:
+        clear_manager_lifecycle_observation_cache()
