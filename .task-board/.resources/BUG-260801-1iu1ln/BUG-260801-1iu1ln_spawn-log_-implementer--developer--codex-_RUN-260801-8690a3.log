+            project_manifest,
+            substitutions,
+            **kwargs,
+        )
+        fetched_repos = kwargs.get("fetched_repos")
+        if isinstance(fetched_repos, set) and fetched_repos:
+            git_ops.fetch_repo(sorted(fetched_repos, key=os.fspath)[0])
+        return nodes
+
