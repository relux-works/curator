+def _transient_descriptor_rewrite(path: Path, marker: bytes) -> None:
+    """Mutate persistent bytes through dir-fd I/O, then restore them exactly."""
+
+    original = path.read_bytes()
+    parent_fd = os.open(
+        path.parent,
