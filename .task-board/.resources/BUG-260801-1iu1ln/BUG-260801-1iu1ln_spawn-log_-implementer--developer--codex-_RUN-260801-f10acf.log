+            != _lifecycle_case(cluster, name)
+        }
+        assert differences == expected
+        assert set(mutations) == {
+            "project-upgrade",
+            "global-upgrade",
+            "planning",
+            "private-failure",
+        }
+    finally:
+        clear_manager_lifecycle_observation_cache()
