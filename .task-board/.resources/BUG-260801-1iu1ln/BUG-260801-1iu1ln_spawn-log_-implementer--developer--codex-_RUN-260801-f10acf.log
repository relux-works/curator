+    witness = tmp_path / "persistent-witness"
+    witness.write_bytes(b"original persistent bytes")
+    original = witness.stat()
+    before = lifecycle_observations._persistent_tamper_state((witness,))
+
+    _transient_file_object_rewrite(
+        witness,
