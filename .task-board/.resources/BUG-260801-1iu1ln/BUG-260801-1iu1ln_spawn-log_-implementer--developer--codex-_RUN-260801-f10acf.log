+    for root in roots:
+        root_key = os.fspath(root)
+        tree = _tamper_tree_state(root, excluded_roots=excluded_roots)
+        for relative, node in tree.items():
+            state[f"{root_key}:{relative}"] = node
+        if tree["."] is not None:
