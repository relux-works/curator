+                    os.lseek(write_fd, 0, os.SEEK_SET)
+                    captured_write(write_fd, original_bytes)
+                    captured_ftruncate(write_fd, len(original_bytes))
+                    os.fsync(write_fd)
+                    captured_fchmod(write_fd, original_mode)
+                finally:
+                    os.close(write_fd)
