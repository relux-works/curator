+                    captured_fchmod(read_fd, original_mode | stat.S_IWUSR)
+                finally:
+                    os.close(read_fd)
+                write_fd = captured_open(
+                    artifact_name,
+                    os.O_WRONLY,
+                    dir_fd=bin_fd,
