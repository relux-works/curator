+            return
+        node = _tamper_node(path)
+        state[relative] = node
+        if node.kind != "directory":
+            return
+        with os.scandir(path) as entries:
+            names = sorted(entry.name for entry in entries)
+        for name in names:
+            child = path / name
+            child_relative = name if relative == "." else f"{relative}/{name}"
+            visit(child, child_relative)
