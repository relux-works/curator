+
+    def rewrite(path: Path, marker: bytes, label: str) -> None:
+        _transient_file_object_rewrite(
+            path,
+            marker,
+            captured_fchmod=captured_fchmod,
+            captured_utime=captured_utime,
+        )
+        mutations.append(label)
+
+    def mutate_project_config_then_install(
