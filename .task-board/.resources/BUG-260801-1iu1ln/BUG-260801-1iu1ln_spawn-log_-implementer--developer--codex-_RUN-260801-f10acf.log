+
+    def mutate_generation_then_build(
+        config_value: config.GlobalConfig,
+        *args: Any,
+        **kwargs: Any,
+    ) -> Any:
+        generation = config_value.path.parent / "persistent-generation"
+        if "/private-builds/failure/" in generation.as_posix():
+            rewrite(
