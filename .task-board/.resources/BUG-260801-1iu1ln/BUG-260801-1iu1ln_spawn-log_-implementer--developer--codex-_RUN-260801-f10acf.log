+def _transient_file_object_rewrite(
+    path: Path,
+    marker: bytes,
+    *,
+    captured_fchmod: Any,
+    captured_utime: Any,
+) -> None:
+    """Restore bytes, mode and timestamps after an unpatched file-object write."""
+
+    original = path.read_bytes()
+    original_state = path.stat()
+    with io.open(path, "r+b") as stream:
