+        value = None
+    else:
+        kind = "special"
+        value = None
+    return _TamperNode(
+        kind=kind,
+        mode=stat.S_IMODE(info.st_mode),
+        device=info.st_dev,
+        inode=info.st_ino,
+        links=info.st_nlink,
+        uid=info.st_uid,
+        gid=info.st_gid,
+        size=info.st_size,
+        mtime_ns=info.st_mtime_ns,
+        ctime_ns=info.st_ctime_ns,
+        flags=getattr(info, "st_flags", None),
+        file_attributes=getattr(info, "st_file_attributes", None),
+        value=value,
+    )
+
