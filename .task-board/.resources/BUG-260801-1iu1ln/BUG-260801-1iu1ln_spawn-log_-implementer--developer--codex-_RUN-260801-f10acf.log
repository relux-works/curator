+class _TamperNode:
+    """One fail-closed filesystem node witness for persistent-state checks."""
+
+    kind: str
+    mode: int
+    device: int
+    inode: int
+    links: int
+    uid: int
+    gid: int
+    size: int
+    mtime_ns: int
+    ctime_ns: int
+    flags: int | None
+    file_attributes: int | None
