+            rewrite(
+                config_value.path,
+                b"\nfile-object-global-upgrade-write\n",
+                "global-upgrade",
+            )
+        return original_global_install(config_value, *args, **kwargs)
+
+    def mutate_planning_skillfile(
+        config_value: config.GlobalConfig,
