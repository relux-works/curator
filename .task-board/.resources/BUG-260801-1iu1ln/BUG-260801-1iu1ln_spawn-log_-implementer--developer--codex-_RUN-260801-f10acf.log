        "replace",
        "rmdir",
        "symlink_to",
        "touch",
        "unlink",
        "write_bytes",
        "write_text",
    ):
        original_method = getattr(Path, method_name)
        monkeypatch.setattr(
            Path,
            method_name,
            wrap_path_method(method_name, original_method),
        )

