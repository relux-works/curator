+                        b"\nfile-object-planning-write\n",
+                        "planning",
+                    )
+        return selected
+
+    def mutate_generation_then_build(
+        config_value: config.GlobalConfig,
+        *args: Any,
+        **kwargs: Any,
+    ) -> Any:
