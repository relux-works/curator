+def _tamper_node(path: Path) -> _TamperNode:
+    info = path.lstat()
+    if stat.S_ISREG(info.st_mode):
+        kind = "file"
+        with io.open(path, "rb") as stream:
+            value: bytes | str | None = stream.read()
