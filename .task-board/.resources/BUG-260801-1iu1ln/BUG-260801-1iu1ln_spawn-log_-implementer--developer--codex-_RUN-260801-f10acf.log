+        if not re.fullmatch(r"[0-9a-f]{64}", destination_name):
+            return
+        entry_fd = captured_open(
+            destination_name,
+            os.O_RDONLY | os.O_DIRECTORY,
+            dir_fd=destination_dir_fd,
+        )
+        try:
+            bin_fd = captured_open(
+                "bin",
+                os.O_RDONLY | os.O_DIRECTORY,
+                dir_fd=entry_fd,
+            )
+            try:
+                artifact_name = os.listdir(bin_fd)[0]
+                read_fd = captured_open(
+                    artifact_name,
+                    os.O_RDONLY,
+                    dir_fd=bin_fd,
