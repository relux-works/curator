+                    captured_write(write_fd, original_bytes)
+                    captured_ftruncate(write_fd, len(original_bytes))
+                    os.fsync(write_fd)
+                    captured_fchmod(write_fd, original_mode)
+                finally:
+                    os.close(write_fd)
+                captured_utime(
+                    artifact_name,
+                    ns=(state.st_atime_ns, state.st_mtime_ns),
+                    dir_fd=bin_fd,
+                    follow_symlinks=False,
+                )
+                corruptions += 1
