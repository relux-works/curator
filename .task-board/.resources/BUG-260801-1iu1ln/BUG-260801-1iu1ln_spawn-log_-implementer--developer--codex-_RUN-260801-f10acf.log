+        value = None
+    else:
+        kind = "special"
+        value = None
+    return _TamperNode(
+        kind=kind,
+        mode=stat.S_IMODE(info.st_mode),
+        device=info.st_dev,
+        inode=info.st_ino,
+        links=info.st_nlink,
+        uid=info.st_uid,
+        gid=info.st_gid,
