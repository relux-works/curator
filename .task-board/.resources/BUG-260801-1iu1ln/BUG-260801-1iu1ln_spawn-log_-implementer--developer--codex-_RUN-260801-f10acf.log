+    ) -> None:
+        nonlocal corruptions
+        original(
+            source_dir_fd,
+            source_name,
+            destination_dir_fd,
+            destination_name,
+        )
+        if not re.fullmatch(r"[0-9a-f]{64}", destination_name):
+            return
+        entry_fd = captured_open(
+            destination_name,
+            os.O_RDONLY | os.O_DIRECTORY,
+            dir_fd=destination_dir_fd,
+        )
+        try:
