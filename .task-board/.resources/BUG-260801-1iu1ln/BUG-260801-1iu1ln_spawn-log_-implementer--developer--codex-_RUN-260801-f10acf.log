+        "_build_private_misses",
+        mutate_skillfile_then_build,
+    )
+    try:
+        _assert_sabotaged_lifecycle_case_differs(
+            "private_build_cases",
+            "second-build-failure-preserves-persistent-state",
+        )
+        assert mutations > 0
+    finally:
+        clear_manager_lifecycle_observation_cache()
