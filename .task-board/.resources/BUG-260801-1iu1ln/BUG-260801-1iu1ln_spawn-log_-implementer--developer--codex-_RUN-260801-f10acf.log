+def test_rc6_private_failure_binding_watches_project_skillfile(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    mutations = 0
+    original = installer._build_private_misses
+
+    def mutate_skillfile_then_build(
+        config_value: config.GlobalConfig,
+        *args: Any,
