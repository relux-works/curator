+            rewrite(
+                config_value.path,
+                b"\nfile-object-project-upgrade-write\n",
+                "project-upgrade",
+            )
+        return original_project_install(config_value, *args, **kwargs)
+
+    def mutate_global_config_then_install(
+        config_value: config.GlobalConfig,
