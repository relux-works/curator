def _status_untrust_cache(
    project: Path,
    csk_home: Path,
    marker_path: Path,
    marker: JsonObject,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    del project, marker_path, monkeypatch
    entry = _cache_entry(csk_home, marker)
    if os.name == "posix":
        entry.chmod(0o700)
    else:
        _corrupt_artifact(csk_home, marker)


