+    """Fail closed when excluded build input appears in installed runtime."""
+
+    for build_root in build_roots:
+        installed_root = runtime_dir.joinpath(*build_root.split("/"))
+        try:
+            installed_root.lstat()
+        except FileNotFoundError:
+            continue
+        except OSError:
+            return True
+        return True
+    return False
