     path = global_skillfile(csk_home)
     if not path.exists():
         raise GlobalInstallError(f"Global Skillfile not found: {path}\n  Run 'csk global init' first.")
     loaded = manifest.load_manifest(global_root(csk_home))
     if loaded is None:
         raise GlobalInstallError(f"Global Skillfile not found: {path}\n  Run 'csk global init' first.")
