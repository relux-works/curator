                    "cache_publication_invalid",
                    "publication artifact does not match its canonical receipt",
                )
            os.lseek(source_fd, 0, os.SEEK_SET)

            _require_guard(guard)
            try:
                with _open_manager_home(self._manager_home) as home_fd:  # noqa: SIM117

