        else "unexpected"
    )
    command_labels = {
        "telemetry": "telemetry-off",
        "version": "version",
        "env": "env",
    }
    allowed = [command_labels[argv[1]] for argv in observed_argv] if readonly else []
    observed["compiled-cache-miss-is-read-only"] = {
        "allowed_go_commands": allowed,
