def _scalar_leaf_paths(
    value: Any,
    path: tuple[str | int, ...] = (),
) -> list[tuple[str | int, ...]]:
    if isinstance(value, dict):
        return [
            leaf
            for key in sorted(value)
            for leaf in _scalar_leaf_paths(value[key], (*path, key))
        ]
    if isinstance(value, list):
