             self.executable = self.operation_root / "go"
             self.goroot = self.operation_root / "goroot"
 
         def __enter__(self) -> Session:
             return self
 
         def __exit__(self, *_args: object) -> None:
             return None
 
     monkeypatch.setattr(toolchain, "establish_toolchain", Session)
 
 
