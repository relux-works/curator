+    private_publications: dict[str, set[str]] = {}
+    private_completed: set[str] = set()
+    results: dict[str, installer.ProjectResult] = {}
+    errors: list[BaseException] = []
+    timeout = 30.0 if os.name == "nt" else 5.0
+
