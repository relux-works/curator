_T = TypeVar("_T")
_READ_CHUNK_SIZE: Final = 1024 * 1024
_REPARSE_ATTRIBUTE: Final = getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0x400)


class _Digest(Protocol):
