+                    if item["identifier"] == "machine"
+                )
+                backup = Path(target["backup_path"])
+                if backup.is_dir() and not backup.is_symlink():
+                    shutil.rmtree(backup)
+                elif backup.exists() or backup.is_symlink():
+                    backup.unlink()
+                removed.append(backup)
