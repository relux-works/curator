+        _assert_sabotaged_lifecycle_case_differs(
+            "cache_publication_cases",
+            "publish-complete-immutable-entry-under-home-lock",
+        )
+        assert exposures > 0
+    finally:
+        clear_manager_lifecycle_observation_cache()
