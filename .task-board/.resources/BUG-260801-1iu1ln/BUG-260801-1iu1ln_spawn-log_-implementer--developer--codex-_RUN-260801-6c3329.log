            mode,
            dir_fd=dir_fd,
            follow_symlinks=follow_symlinks,
        )

    def observed_os_fchmod(fd: int, mode: int) -> None:
        for descriptor_root in ("/dev/fd", "/proc/self/fd"):
            try:
