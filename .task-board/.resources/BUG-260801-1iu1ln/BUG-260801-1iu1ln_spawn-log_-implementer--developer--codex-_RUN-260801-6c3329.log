+        real_home_lock = locking.ManagerHomeLock
+
+        class ObservedPrivateBuildHomeLock:
+            def __init__(self, home: Path, timeout: float | None = None):
+                self._delegate = real_home_lock(home, timeout=timeout)
+
+            @property
