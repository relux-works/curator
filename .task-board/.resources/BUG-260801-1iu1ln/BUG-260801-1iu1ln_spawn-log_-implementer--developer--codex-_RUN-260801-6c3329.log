+def _observe_concurrent_private_builds(
+    root: Path,
+) -> tuple[bool, bool, bool]:
+    """Drive distinct project builds concurrently and retain their shared plan."""
+
+    root.mkdir(parents=True)
+    skills_root = root / "skills"
