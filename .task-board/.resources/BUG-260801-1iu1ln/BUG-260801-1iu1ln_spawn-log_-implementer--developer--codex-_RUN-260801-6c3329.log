+            "status-repair/current/home" in home_text
+            or "status-repair/matrix/" in home_text
+        ):
+            for entry in sorted((home / "builds" / "go-v1").glob("*")):
+                mode = stat.S_IMODE(entry.lstat().st_mode)
+                entry.chmod(mode | stat.S_IWUSR)
