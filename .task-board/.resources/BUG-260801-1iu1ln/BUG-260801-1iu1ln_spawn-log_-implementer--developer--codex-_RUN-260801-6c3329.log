+    serial = threading.Lock()
+    original = installer._build_private_misses
+
+    def globally_serialized_private_builds(*args: Any, **kwargs: Any) -> Any:
+        nonlocal active, calls, maximum
+        with serial:
+            calls += 1
+            active += 1
