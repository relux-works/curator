+        if "status-repair/repair/04-untrusted-boundary" in home.as_posix():
+            artifacts = sorted((home / "builds" / "go-v1").glob("*/bin/*"))
+            for artifact in artifacts:
+                completed = subprocess.run(
+                    [artifact],
