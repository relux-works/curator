+    )
+
+    first_private_phase_ready = threading.Event()
+    private_entry_barrier = threading.Barrier(2)
+    private_completion_barrier = threading.Barrier(2)
+    build_ready = {
+        "alpha-tool": threading.Event(),
+        "beta-tool": threading.Event(),
+    }
