+        }
+    }
+    make_skill_repo(
+        skills_root,
+        "alpha-provider",
+        _build_skill_files("alpha-tool", requirements=dependency),
+        tag="v1",
+    )
+    make_skill_repo(
+        skills_root,
+        "beta-provider",
+        _build_skill_files("beta-tool", requirements=dependency),
+        tag="v1",
+    )
