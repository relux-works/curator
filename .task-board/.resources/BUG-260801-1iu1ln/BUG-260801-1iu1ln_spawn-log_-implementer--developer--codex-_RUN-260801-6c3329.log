+        def observed_private(*args: Any, **kwargs: Any) -> Any:
+            alias = threading.current_thread().name.removeprefix(
+                "lifecycle-private-"
+            )
+            plans = tuple(args[3])
+            with state_guard:
+                private_plans[alias] = plans
+            if alias == "alpha":
