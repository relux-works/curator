+        raise AssertionError(f"concurrent private-build probe failed: {errors!r}")
+    shared_plans = {
+        alias: [
+            plan
+            for plan in result.builds
+            if plan.provider == "shared-provider"
+            and plan.command == "shared-tool"
+        ]
+        for alias, result in results.items()
+    }
+    exact_shared_plan = (
