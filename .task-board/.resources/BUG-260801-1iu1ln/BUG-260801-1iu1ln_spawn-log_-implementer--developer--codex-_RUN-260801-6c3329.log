+def test_rc6_recovery_binding_detects_missing_target_backup(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    removed: list[Path] = []
+    original = transactions.TransactionEngine.commit
+
+    def drop_restored_backup(
+        engine: transactions.TransactionEngine,
+        lock: Any,
+        transaction_id: str,
+    ) -> None:
+        try:
