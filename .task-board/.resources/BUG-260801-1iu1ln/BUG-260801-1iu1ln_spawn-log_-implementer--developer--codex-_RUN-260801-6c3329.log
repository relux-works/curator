+    ) -> Callable[..., Any]:
+        def observed(path: Path, *args: Any, **kwargs: Any) -> Any:
+            record(f"path-{name}", path)
+            if name in {"rename", "replace"} and args:
+                record(f"path-{name}-destination", args[0])
