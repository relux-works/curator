+            try:
+                info = candidate.lstat()
+            except OSError:
+                identity = "missing"
+            else:
+                identity = f"{info.st_dev}:{info.st_ino}"
+            sink.append(f"{operation}:{identity}:{candidate}")
+
+    def wrap_path_method(
+        name: str,
