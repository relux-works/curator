+            and plan.command == "shared-tool"
+        ]
+        for alias, plans in private_plans.items()
+    }
+    exact_shared_plan = (
+        set(shared_plans) == {"alpha", "beta"}
+        and all(len(plans) == 1 for plans in shared_plans.values())
+    )
