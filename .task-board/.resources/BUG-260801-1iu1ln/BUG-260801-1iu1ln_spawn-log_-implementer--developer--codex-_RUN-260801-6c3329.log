+        _assert_sabotaged_lifecycle_case_differs(
+            "repair_cases",
+            "repair-rebuilds-invalid-compiled-entry",
+        )
+        assert executed
+        assert all(returncode == 0 for _path, returncode in executed)
+    finally:
+        clear_manager_lifecycle_observation_cache()
