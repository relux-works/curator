+        and all(not result.errors for result in results.values())
+        and consumers.load_consumers(csk_home)
+        == sorted(
+            (project_alpha.resolve(), project_beta.resolve()),
+            key=lambda path: os.fsencode(str(path)),
+        )
+    )
+    return overlap, exact_shared_plan, success
+
