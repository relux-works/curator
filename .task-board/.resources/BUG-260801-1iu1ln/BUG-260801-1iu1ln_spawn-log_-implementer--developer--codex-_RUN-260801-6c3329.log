+        _assert_sabotaged_lifecycle_case_differs(
+            "cross_project_cases",
+            "two-project-success-preserves-both-consumers",
+        )
+        assert calls > 0
+        assert maximum == 1
+    finally:
+        clear_manager_lifecycle_observation_cache()
