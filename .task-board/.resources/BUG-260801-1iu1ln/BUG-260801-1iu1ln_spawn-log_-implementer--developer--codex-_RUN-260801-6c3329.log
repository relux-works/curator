+
+    def observed_os_fchmod(fd: int, mode: int) -> None:
+        for descriptor_root in ("/dev/fd", "/proc/self/fd"):
+            try:
+                record("os-fchmod", os.readlink(f"{descriptor_root}/{fd}"))
+            except OSError:
+                continue
+            break
+        real_os_fchmod(fd, mode)
+
