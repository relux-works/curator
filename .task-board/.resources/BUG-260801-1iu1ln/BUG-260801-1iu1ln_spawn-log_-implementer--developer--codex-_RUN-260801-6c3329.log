+    )
+
+    launch = threading.Event()
+    build_ready = {
+        "alpha-tool": threading.Event(),
+        "beta-tool": threading.Event(),
+    }
+    handoff_started = threading.Event()
+    state_guard = threading.Lock()
+    active_private_builds = 0
+    maximum_private_builds = 0
