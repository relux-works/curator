+                    "partial",
+                    os.O_WRONLY | os.O_CREAT | os.O_EXCL,
+                    0o600,
+                    dir_fd=entry_fd,
+                )
+                os.close(partial_fd)
+                exposures += 1
+                os.unlink("partial", dir_fd=entry_fd)
+            finally:
+                os.close(entry_fd)
+            os.rmdir(destination_name, dir_fd=destination_dir_fd)
+        original(
+            source_dir_fd,
+            source_name,
+            destination_dir_fd,
+            destination_name,
+        )
