+            src_dir_fd=src_dir_fd,
+            dst_dir_fd=dst_dir_fd,
+        )
+
+    monkeypatch.setattr(os, "chmod", observed_os_chmod)
+    monkeypatch.setattr(os, "fchmod", observed_os_fchmod)
+    monkeypatch.setattr(os, "mkdir", observed_os_mkdir)
