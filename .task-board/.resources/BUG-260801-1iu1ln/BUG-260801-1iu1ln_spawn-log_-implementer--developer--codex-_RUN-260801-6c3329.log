+                repairs.append(entry)
+        return original(config_value, *args, **kwargs)
+
+    clear_manager_lifecycle_observation_cache()
+    monkeypatch.setattr(
+        status_mod,
+        "_collect_resolved_scope",
+        transient_permission_repair,
