+            "status_cases",
+            "compiled-installation-current",
+        )
+        _assert_sabotaged_lifecycle_case_differs(
+            "status_cases",
+            "compiled-currentness-failure-matrix",
+        )
+        assert len(repairs) >= 15
+    finally:
+        clear_manager_lifecycle_observation_cache()
