+            "schema_version": 1,
+            "skills": [{"name": "beta-provider", "tag": "v1"}],
+        },
+    )
+    config_value = make_config(csk_home, skills_root, project_alpha)
+    template = config_value.projects["app"]
+    config_value = replace(
+        config_value,
+        projects={
+            "alpha": replace(
+                template,
