+def test_rc6_publication_binding_detects_transient_partial_live_entry(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from csk.builds import cache_posix
+
+    exposures = 0
+    original = cache_posix._rename_noreplace
