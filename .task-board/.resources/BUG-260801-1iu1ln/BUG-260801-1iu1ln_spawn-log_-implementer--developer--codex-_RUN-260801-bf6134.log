  1868	        if provider is None:
  1869	            hint = f" Hint: {dependency.hint}" if dependency.hint else ""
  1870	            errors.append(
  1871	                f"Missing skill dependency {dependency.skill!r} for {plan.decl.name}; "
  1872	                f"add {dependency.skill} to Skillfile.json.{hint}"
  1873	            )
  1874	            continue
  1875	        provided = provider.spec.commands.get(dependency.command)
  1876	        if provided is None or provided.type != "script":
  1877	            errors.append(
  1878	                f"Skill dependency {plan.decl.name} requires {dependency.skill}.{dependency.command}, "
