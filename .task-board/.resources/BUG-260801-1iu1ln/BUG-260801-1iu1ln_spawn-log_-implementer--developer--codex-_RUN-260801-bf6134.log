   607	def _active_script_owners(
   608	    nodes: list[closure.ClosureNode],
   609	) -> dict[str, str]:
   610	    owners: dict[str, str] = {}
   611	    for node in nodes:
   612	        for command in node.active_commands():
   613	            owners[command] = node.name
   614	    return owners
