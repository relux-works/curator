+        downstream: list[str] = []
+
+        def fail_gate(*_args: object, **_kwargs: object) -> object:
+            raise installer.InstallError(f"observed planning gate failure: {label}")
 
+        def cache_lookup(*_args: object, **_kwargs: object) -> tuple[()]:
+            downstream.append("cache-lookup")
