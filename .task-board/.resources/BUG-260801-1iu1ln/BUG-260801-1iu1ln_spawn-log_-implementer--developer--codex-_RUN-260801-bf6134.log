+                        commit_consumer(project_name, project, home_lock)
+                    finally:
+                        with state_guard:
+                            active_home_consumers -= 1
+        except BaseException as exc:  # noqa: BLE001 - worker failures are parent evidence
+            with state_guard:
+                errors.append(exc)
+
+    threads = [
+        threading.Thread(
+            name="lifecycle-project-alpha",
+            target=hold_home,
+            args=("project-alpha",),
+            kwargs={"first": True},
+        ),
+        threading.Thread(
+            name="lifecycle-project-beta",
+            target=hold_home,
+            args=("project-beta",),
+            kwargs={"first": False},
+        ),
