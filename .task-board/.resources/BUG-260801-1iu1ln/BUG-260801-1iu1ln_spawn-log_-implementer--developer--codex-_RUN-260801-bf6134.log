   511	def _path_state(info: os.stat_result) -> tuple[int, int, int, int, int, int]:
   512	    return (
   513	        info.st_dev,
   514	        info.st_ino,
   515	        info.st_mode,
   516	        info.st_size,
   517	        info.st_mtime_ns,
   518	        info.st_ctime_ns,
   519	    )

