+
+    def commit_consumer(
+        project_name: str,
+        project: Path,
+        home_lock: locking.ManagerHomeLock,
+    ) -> None:
+        current = set(json.loads(ledger.read_text(encoding="utf-8")))
+        current.add(project_name)
+        desired = _write_text(
+            root / f"desired-{project_name}.json",
+            json.dumps(sorted(current)),
+        )
