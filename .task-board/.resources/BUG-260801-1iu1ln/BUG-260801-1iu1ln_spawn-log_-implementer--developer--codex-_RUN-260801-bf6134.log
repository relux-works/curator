+    serialized = (
+        second_observed_waiting
+        and maximum_home_consumers == 1
+        and home_order == ["project-alpha", "project-beta"]
+        and commit_order == ["project-alpha", "project-beta"]
+    )
+    return before, commit_order, private_overlap, serialized
