+                        raise AssertionError("first home consumer was not observed")
+                    second_home_attempted.set()
+                with locking.ManagerHomeLock(home, timeout=timeout) as home_lock:
+                    with state_guard:
+                        active_home_consumers += 1
+                        maximum_home_consumers = max(
