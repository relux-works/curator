   431	def _collect_runtime_entries(
   432	    csk_home: Path,
   433	    referenced: set[tuple[str, str]],
   434	) -> tuple[int, list[str]]:
   435	    runtime_root = csk_home / "runtime"
   436	    try:
   437	        root_info = runtime_root.lstat()
   438	    except FileNotFoundError:
   439	        return 0, []
   440	    except OSError as exc:
   441	        return 0, [f"runtime store retained: {exc}"]
   442	    if stat.S_ISLNK(root_info.st_mode) or not stat.S_ISDIR(root_info.st_mode):
   443	        return 0, [f"runtime store retained because it is not a real directory: {runtime_root}"]
   444	    removed = 0
   445	    warnings: list[str] = []
   446	    for skill_dir in runtime_root.iterdir():
   447	        try:
   448	            skill_info = skill_dir.lstat()
   449	        except OSError as exc:
   450	            warnings.append(f"runtime entry retained at {skill_dir}: {exc}")
   451	            continue
   452	        if stat.S_ISLNK(skill_info.st_mode) or not stat.S_ISDIR(skill_info.st_mode):
   453	            warnings.append(f"runtime entry retained because it is not a real directory: {skill_dir}")
   454	            continue
   455	        sweep_orphans(skill_dir)
   456	        for commit_dir in skill_dir.iterdir():
   457	            if _ORPHAN_RE.match(commit_dir.name):
   458	                continue
   459	            try:
   460	                commit_info = commit_dir.lstat()
   461	            except OSError as exc:
   462	                warnings.append(f"runtime generation retained at {commit_dir}: {exc}")
   463	                continue
   464	            if stat.S_ISLNK(commit_info.st_mode) or not stat.S_ISDIR(
   465	                commit_info.st_mode
   466	            ):
   467	                warnings.append(
   468	                    f"runtime generation retained because it is not a real directory: {commit_dir}"
   469	                )
   470	                continue
   471	            if (skill_dir.name, commit_dir.name) not in referenced:
   472	                shutil.rmtree(commit_dir)
   473	                removed += 1
   474	    return removed, warnings
