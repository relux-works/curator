+    private_overlap = all(
+        event.wait(timeout=timeout) for event in projects_ready.values()
+    )
+    start_first_home.set()
+    deadline = time.monotonic() + (timeout * 2) + 5.0
+    for thread in threads:
+        thread.join(timeout=max(0.0, deadline - time.monotonic()))
