   171	def _tree_state(roots: tuple[Path, ...]) -> dict[str, tuple[object, ...]]:
   172	    state: dict[str, tuple[object, ...]] = {}
   173	    for root in roots:
   174	        key = str(root)
   175	        if not root.exists() and not root.is_symlink():
   176	            state[key] = ("missing",)
   177	            continue
   178	        for path in (root, *root.rglob("*")):
   179	            info = path.lstat()
   180	            relative = "." if path == root else path.relative_to(root).as_posix()
   181	            if stat.S_ISREG(info.st_mode):
   182	                value: object = path.read_bytes()
   183	                kind = "file"
   184	            elif stat.S_ISLNK(info.st_mode):
   185	                value = os.readlink(path)
   186	                kind = "link"
   187	            elif stat.S_ISDIR(info.st_mode):
   188	                value = None
   189	                kind = "directory"
   190	            else:
   191	                value = None
   192	                kind = "special"
   193	            state[f"{key}:{relative}"] = (
   194	                kind,
   195	                stat.S_IMODE(info.st_mode),
   196	                value,
   197	            )
   198	    return state
