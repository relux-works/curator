    60	def classify_build(
    61	    *,
    62	    csk_home: Path,
    63	    bin_dir: Path,
    64	    provider: str,
    65	    command: CommandSpec,
    66	    plan: planner.BuildPlan | None,
    67	    recorded: InstallMarkerBuild | None,
    68	    cache_backend: cache.BuildCacheBackend,
    69	    path_entries: tuple[Path, ...],
    70	    boundary_error: tuple[str, str] | None = None,
    71	    platform_name: str | None = None,
    72	) -> BuildStatus:
    73	    """Classify one command from independently derived and protected state.
    74	
    75	    The complete planned cache key and receipt comparison is the currentness
    76	    mechanism for target, toolchain, and policy changes.  In particular, an
    77	    input without ``policy.execution_policy = manager-worker-v1`` derives a
    78	    different key and is reported as ``build-input-drift``; capability
    79	    evidence is intentionally absent from this API and from the key.
    80	    """
    81	
    82	    recorded_key = recorded.cache_key if recorded is not None else None
    83	    expected_key = plan.cache_key if plan is not None else None
    84	
    85	    def result(label: str, detail: str) -> BuildStatus:
    86	        return BuildStatus(
    87	            provider=provider,
    88	            command=command.name,
    89	            label=label,
    90	            detail=detail,
    91	            expected_cache_key=expected_key,
    92	            recorded_cache_key=recorded_key,
    93	        )
    94	
    95	    if boundary_error is not None:
    96	        return result(*boundary_error)
    97	    if plan is None:
    98	        return result(
    99	            "build-command-drift",
   100	            "the recorded build command is not active in the current closure",
   101	        )
   102	    if recorded is None:
   103	        return result(
   104	            "missing-build-marker",
   105	            "marker v2 has no build record for the active command",
   106	        )
   107	    if command.driver != plan.driver or recorded.driver != plan.driver:
   108	        return result(
   109	            "unsupported-build-driver",
   110	            f"build driver differs: descriptor={command.driver!r}, "
   111	            f"marker={recorded.driver!r}, planned={plan.driver!r}",
   112	        )
   113	    if recorded.cache_key != plan.cache_key:
   114	        return result(
   115	            "build-input-drift",
   116	            "the marker cache key does not match the complete current "
   117	            "build input (raw source, toolchain, target, and "
   118	            "policy.execution_policy=manager-worker-v1)",
   119	        )
   120	
   121	    inspection = plan.inspection
   122	    if inspection.status is cache.CacheEntryStatus.MISS:
   123	        return result("missing-build-artifact", inspection.reason)
   124	    if inspection.status is cache.CacheEntryStatus.CORRUPT:
   125	        return result("corrupt-build-cache", inspection.reason)
   126	    if inspection.status is cache.CacheEntryStatus.UNTRUSTED_PROVENANCE:
   127	        return result("untrusted-build-cache", inspection.reason)
   128	    if inspection.status is cache.CacheEntryStatus.UNSUPPORTED:
   129	        return result("unsupported-build-platform", inspection.reason)
   130	
   131	    try:
   132	        activation = shims.select_build_activation(
   133	            csk_home=csk_home,
   134	            command=command,
   135	            marker_build=recorded,
   136	            inspection=inspection,
   137	            platform_name=platform_name,
   138	        )
   139	    except shims.ShimError as exc:
   140	        return result("build-marker-drift", str(exc))
   141	
   142	    shim_error = shims.inspect_bin_shim(
   143	        bin_dir,
   144	        command.name,
   145	        activation.artifact_path,
   146	        platform_name=platform_name,
   147	        path_entries=path_entries,
   148	    )
   149	    if shim_error is not None:
   150	        return result("build-shim-drift", shim_error)
   151	
   152	    # Planning and classification are separate observations.  Re-read the
   153	    # complete entry with the marker's receipt hash so a disappearing or
   154	    # replaced cache entry cannot inherit a verdict from stale evidence.
   155	    current = cache_backend.inspect(
   156	        cache.CacheExpectation(
   157	            input=plan.input,
   158	            receipt_sha256=recorded.receipt_sha256,
   159	        )
   160	    )
   161	    if not _same_cache_evidence(inspection, current):
   162	        return result(
   163	            "build-state-changed",
   164	            "protected cache evidence changed during read-only status",
   165	        )
   166	    if current.status is not cache.CacheEntryStatus.HIT:
   167	        return result(_cache_label(current.status), current.reason)
   168	    return result(
   169	        "current",
   170	        "marker, complete input, protected receipt/artifact, and managed shim agree",
   171	    )
   172	
   173	
   174	def _same_cache_evidence(
   175	    planned: cache.CacheInspection,
   176	    current: cache.CacheInspection,
   177	) -> bool:
   178	    return (
   179	        planned.status == current.status
   180	        and planned.receipt == current.receipt
   181	        and planned.receipt_bytes == current.receipt_bytes
   182	        and planned.receipt_sha256 == current.receipt_sha256
   183	        and planned.artifact_path == current.artifact_path
   184	    )
   185	
   186	
   187	def _cache_label(status: cache.CacheEntryStatus) -> str:
   188	    if status is cache.CacheEntryStatus.MISS:
   189	        return "missing-build-artifact"
   190	    if status is cache.CacheEntryStatus.CORRUPT:
   191	        return "corrupt-build-cache"
   192	    if status is cache.CacheEntryStatus.UNTRUSTED_PROVENANCE:
   193	        return "untrusted-build-cache"
   194	    if status is cache.CacheEntryStatus.UNSUPPORTED:
   195	        return "unsupported-build-platform"
   196	    return "build-state-changed"

