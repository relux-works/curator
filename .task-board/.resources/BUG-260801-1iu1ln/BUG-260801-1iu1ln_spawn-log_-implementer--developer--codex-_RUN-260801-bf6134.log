   144	def _command_resolution_warnings(
   145	    skill_dir: Path,
   146	    spec: skillspec.SkillSpec,
   147	) -> list[ValidationIssue]:
   148	    managed_commands = [
   149	        command for command in spec.commands.values() if command.type in {"script", "build"}
   150	    ]
   151	    has_provider_commands = any(dependency.type == "skill" for dependency in spec.dependencies.values()) or any(
   152	        requirement.mode in {"full", "runtime"} for requirement in spec.requirements.values()
   153	    )
   154	    if not managed_commands and not has_provider_commands:
   155	        return []
   156	
   157	    text = "\n".join(
   158	        path.read_text(encoding="utf-8", errors="replace")
   159	        for path in _prompt_markdown_files(skill_dir, exclude_roots=spec.build_roots)
   160	    )
   161	    missing: list[str] = []
   162	    if ".agents/bin" not in text and ".agents\\bin" not in text:
   163	        missing.append("project .agents/bin lookup")
   164	    if "global/bin" not in text and "global\\bin" not in text:
   165	        missing.append("CocoaSkills global/bin fallback")
   166	    if "command -v" not in text or "Get-Command" not in text:
   167	        missing.append("validated POSIX and PowerShell bare-command fallbacks")
   168	    has_windows_command = any(
   169	        command.type == "build" or command.win_path is not None for command in managed_commands
   170	    )
   171	    if has_windows_command and ".cmd" not in text:
   172	        missing.append("Windows .cmd shim suffix")
   173	    if not missing:
   174	        return []
   175	    return [
   176	        ValidationIssue(
   177	            "warning",
   178	            "skill.command_resolution_contract_missing",
   179	            "SKILL.md",
   180	            "Prompt-visible instructions export managed runtime commands but do not document a shell-neutral "
   181	            f"resolver ({', '.join(missing)}). Agents must resolve project shims first, then global shims, "
   182	            "then a validated bare command; shell profile activation is optional.",
   183	        )
   184	    ]
