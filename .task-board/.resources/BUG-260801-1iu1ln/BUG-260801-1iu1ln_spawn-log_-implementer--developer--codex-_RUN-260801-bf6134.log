   311	def _collect_marker_directory(
   312	    directory: Path,
   313	    references: _References,
   314	    *,
   315	    expected_name: str | None = None,
   316	) -> tuple[bool, str | None]:
   317	    try:
   318	        directory_info = directory.lstat()
   319	    except FileNotFoundError:
   320	        return False, None
   321	    except OSError as exc:
   322	        return False, str(exc)
   323	    if stat.S_ISLNK(directory_info.st_mode) or not stat.S_ISDIR(
   324	        directory_info.st_mode
   325	    ):
   326	        return False, "marker parent is not a real directory"
   327	    marker_path = directory / ".csk-install.json"
   328	    try:
   329	        before = marker_path.lstat()
   330	    except FileNotFoundError:
   331	        return False, "marker is missing"
   332	    except OSError as exc:
   333	        return False, str(exc)
   334	    if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode):
   335	        return False, "marker is not a regular non-link file"
   336	    try:
   337	        raw = marker_path.read_bytes()
   338	        after = marker_path.lstat()
   339	        marker = install_marker.read_install_marker(raw)
   340	    except (OSError, install_marker.InstallMarkerError) as exc:
   341	        return False, str(exc)
   342	    if _path_state(before) != _path_state(after):
   343	        return False, "marker changed while it was read"
   344	    if expected_name is not None and marker.name != expected_name:
   345	        return False, f"marker name {marker.name!r} does not match store entry"
   346	    references.runtime.add((marker.name, marker.commit))
   347	    references.snapshots.add((marker.source, marker.commit))
   348	    if isinstance(marker, install_marker.InstallMarkerV2):
   349	        references.builds.update(
   350	            build.cache_key for build in marker.builds.values()
   351	        )
   352	    return True, None
