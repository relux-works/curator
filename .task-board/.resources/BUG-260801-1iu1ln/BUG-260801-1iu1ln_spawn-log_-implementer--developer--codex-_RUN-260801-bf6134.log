   552	def _node_summary(node: closure.ClosureNode) -> str:
   553	    active = ",".join(sorted(node.active_commands()))
   554	    consumers_label = ",".join(node.consumers())
   555	    summary = (
   556	        f"{node.name} {node.resolved.kind} {node.resolved.ref} {node.resolved.commit[:7]} "
   557	        f"context={'yes' if node.context_active else 'no'} commands=[{active}] via={consumers_label}"
   558	    )
   559	    if node.substituted:
   560	        summary += f" SUBSTITUTED ({node.substituted})"
   561	    return summary
