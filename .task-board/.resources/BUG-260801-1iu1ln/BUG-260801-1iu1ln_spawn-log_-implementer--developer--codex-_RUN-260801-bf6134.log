+def _commit_consumers_concurrently(
+    home: Path,
+    root: Path,
+    ledger: Path,
+) -> tuple[list[str], list[str], bool, bool]:
+    """Observe distinct project locks overlapping at one serialized home handoff."""
+
+    project_names = ("project-alpha", "project-beta")
