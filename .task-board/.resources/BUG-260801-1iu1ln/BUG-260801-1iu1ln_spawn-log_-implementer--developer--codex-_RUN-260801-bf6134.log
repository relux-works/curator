+
+    def acquire_transient_home_lock(*args: Any, **kwargs: Any) -> Any:
+        nonlocal calls
+        config_value = args[0]
+        plans = args[3]
+        commands = {plan.command for plan in plans}
+        if commands == {"golden-tool", "second-tool"}:
