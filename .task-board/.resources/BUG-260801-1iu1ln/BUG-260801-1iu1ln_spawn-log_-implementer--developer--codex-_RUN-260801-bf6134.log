   800	def _planning_label(code: str) -> str:
   801	    if code == "unsupported_build_driver":
   802	        return "unsupported-build-driver"
   803	    if code in {"concurrent_state_change", "snapshot_mutated"}:
   804	        return "build-state-changed"
   805	    if "toolchain" in code:
   806	        return "unusable-build-toolchain"
   807	    return "build-planning-error"
