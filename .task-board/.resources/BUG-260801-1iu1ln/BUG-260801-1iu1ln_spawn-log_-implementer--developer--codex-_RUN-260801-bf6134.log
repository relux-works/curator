   526	def _hybrid_store_names(nodes: list[closure.ClosureNode], project_declared: set[str]) -> set[str]:
   527	    """Names materialized in the hybrid store: unreachable from project declarations."""
   528	    by_name = {node.name: node for node in nodes}
   529	    reachable: set[str] = set()
   530	    stack = [name for name in project_declared if name in by_name]
   531	    while stack:
   532	        current = stack.pop()
   533	        if current in reachable:
   534	            continue
   535	        reachable.add(current)
   536	        for requirement in by_name[current].spec.requirements.values():
   537	            if requirement.name in by_name and requirement.name not in reachable:
   538	                stack.append(requirement.name)
   539	    return set(by_name) - reachable
