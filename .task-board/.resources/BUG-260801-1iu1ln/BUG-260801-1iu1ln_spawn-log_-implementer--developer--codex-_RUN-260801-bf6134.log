+
+    threads = [
+        threading.Thread(
+            name="lifecycle-project-alpha",
+            target=hold_home,
+            args=("project-alpha",),
+            kwargs={"first": True},
+        ),
+        threading.Thread(
+            name="lifecycle-project-beta",
+            target=hold_home,
+            args=("project-beta",),
+            kwargs={"first": False},
+        ),
+    ]
+    for thread in threads:
+        thread.start()
