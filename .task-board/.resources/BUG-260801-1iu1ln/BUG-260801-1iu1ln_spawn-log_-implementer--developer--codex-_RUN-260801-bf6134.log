+def _lifecycle_case(cluster: str, name: str) -> dict[str, Any]:
+    return deepcopy(
+        next(
+            item
+            for item in MANAGER_LIFECYCLE_VECTORS[cluster]
+            if item["name"] == name
+        )
+    )
+
