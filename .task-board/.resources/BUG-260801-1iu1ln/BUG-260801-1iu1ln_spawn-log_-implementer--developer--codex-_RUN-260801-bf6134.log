+                        maximum_home_consumers = max(
+                            maximum_home_consumers,
+                            active_home_consumers,
+                        )
+                        home_order.append(project_name)
+                    try:
+                        if first:
+                            first_home_acquired.set()
+                            if not second_home_attempted.wait(timeout=timeout):
+                                raise AssertionError(
