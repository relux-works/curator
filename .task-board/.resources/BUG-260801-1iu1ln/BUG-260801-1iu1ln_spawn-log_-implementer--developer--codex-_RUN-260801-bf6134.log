+                and target.target_class == "90-consumer"
+            ):
+                with state_guard:
+                    commit_order.append(project_name)
+
+        engine = transactions.TransactionEngine(home, fault_hook=committed)
+        engine.recover(home_lock)
+        engine.prepare(
