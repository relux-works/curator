   476	
   477	def sweep_orphans(directory: Path) -> None:
   478	    try:
   479	        info = directory.lstat()
   480	    except OSError:
   481	        return
   482	    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
   483	        return
   484	    try:
   485	        children = list(directory.iterdir())
   486	    except OSError:
   487	        return
   488	    for child in children:
   489	        match = _ORPHAN_RE.match(child.name)
   490	        if not match:
   491	            continue
   492	        pid = match.group(1) or match.group(2)
   493	        assert pid is not None
   494	        if _pid_alive(int(pid)):
   495	            continue
   496	        try:
   497	            child_info = child.lstat()
   498	        except OSError:
   499	            continue
   500	        if stat.S_ISDIR(child_info.st_mode) and not stat.S_ISLNK(
   501	            child_info.st_mode
   502	        ):
   503	            shutil.rmtree(child, ignore_errors=True)
   504	        else:
   505	            try:
   506	                child.unlink()
   507	            except OSError:
   508	                pass
   509	
