   760	def _installed_files(installed_dir: Path) -> tuple[str, ...]:
   761	    files: list[str] = []
   762	    for path in installed_dir.rglob("*"):
   763	        info = path.lstat()
   764	        if stat.S_ISLNK(info.st_mode):
   765	            raise ValueError(f"installed content contains a link: {path}")
   766	        if stat.S_ISREG(info.st_mode):
   767	            relative = path.relative_to(installed_dir).as_posix()
   768	            if relative != ".csk-install.json":
   769	                files.append(relative)
   770	        elif not stat.S_ISDIR(info.st_mode):
   771	            raise ValueError(f"installed content contains a special entry: {path}")
   772	    return tuple(sorted(files))
   773	
