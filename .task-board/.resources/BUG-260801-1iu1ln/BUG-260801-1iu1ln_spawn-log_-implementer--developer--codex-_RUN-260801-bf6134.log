    15	@dataclass(frozen=True)
    16	class BuildStatus:
    17	    """One stable status row for one active or recorded build command."""
    18	
    19	    provider: str
    20	    command: str
    21	    label: str
    22	    detail: str
    23	    expected_cache_key: str | None = None
    24	    recorded_cache_key: str | None = None
    25	
    26	    @property
    27	    def current(self) -> bool:
    28	        return self.label == "current"
    29	
    30	    def to_json(self) -> dict[str, Any]:
