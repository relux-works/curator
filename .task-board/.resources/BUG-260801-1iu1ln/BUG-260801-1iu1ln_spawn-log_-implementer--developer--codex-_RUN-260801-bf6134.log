   775	def _runtime_exposes_build_roots(
   776	    runtime_dir: Path,
   777	    build_roots: tuple[str, ...],
   778	) -> bool:
   779	    """Fail closed when excluded build input appears in installed runtime."""
   780	
   781	    for build_root in build_roots:
   782	        installed_root = runtime_dir.joinpath(*build_root.split("/"))
   783	        try:
   784	            installed_root.lstat()
   785	        except FileNotFoundError:
   786	            continue
   787	        except OSError:
   788	            return True
   789	        return True
   790	    return False
   791	
