   542	def _directory_is_on_path(directory: Path, *, path_value: str | None = None) -> bool:
   543	    expected = os.path.normcase(os.path.abspath(directory))
   544	    value = os.environ.get("PATH", "") if path_value is None else path_value
   545	    return any(
   546	        os.path.normcase(os.path.abspath(Path(entry).expanduser())) == expected
   547	        for entry in value.split(os.pathsep)
   548	        if entry
   549	    )
