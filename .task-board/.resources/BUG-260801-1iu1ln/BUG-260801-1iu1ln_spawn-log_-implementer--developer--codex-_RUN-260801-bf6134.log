   586	
   587	def _active_build_command_names(node: closure.ClosureNode) -> set[str]:
   588	    exported = {
   589	        command.name
   590	        for command in node.spec.commands.values()
   591	        if command.type == "build"
   592	    }
   593	    if any(edge.mode == "full" for edge in node.edges):
   594	        return exported
   595	    active: set[str] = set()
   596	    for edge in node.edges:
   597	        if edge.mode != "runtime":
   598	            continue
   599	        active.update(
   600	            command
   601	            for command in (edge.commands or tuple(exported))
   602	            if command in exported
   603	        )
   604	    return active
   605	
