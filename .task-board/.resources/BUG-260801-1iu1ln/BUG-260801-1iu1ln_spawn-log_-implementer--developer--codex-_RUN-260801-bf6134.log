   406	def _collect_snapshots(
   407	    csk_home: Path,
   408	    referenced: set[tuple[str, str]],
   409	) -> int:
   410	    cache_root = csk_home / "cache"
   411	    if not cache_root.exists() or cache_root.is_symlink():
   412	        return 0
   413	    removed = 0
   414	    # Layout: cache/<source>/<commit>/snapshot, where <source> may be nested.
   415	    for snapshot_dir in sorted(cache_root.rglob("snapshot")):
   416	        if snapshot_dir.is_symlink() or not snapshot_dir.is_dir():
   417	            continue
   418	        commit_dir = snapshot_dir.parent
   419	        source = commit_dir.parent.relative_to(cache_root).as_posix()
   420	        if (source, commit_dir.name) in referenced:
   421	            continue
   422	        shutil.rmtree(commit_dir)
   423	        removed += 1
   424	        parent = commit_dir.parent
   425	        while parent != cache_root and not any(parent.iterdir()):
   426	            parent.rmdir()
   427	            parent = parent.parent
   428	    return removed
   429	
