    44	    provider: str,
    45	    command: str,
    46	    *,
    47	    label: str,
    48	    detail: str,
    49	    recorded: InstallMarkerBuild | None = None,
    50	) -> BuildStatus:
    51	    return BuildStatus(
    52	        provider=provider,
    53	        command=command,
