   564	def _freeze_build_providers(
   565	    nodes: list[closure.ClosureNode],
   566	    stack: ExitStack,
   567	) -> tuple[build_planner.BuildProvider, ...]:
   568	    providers: list[build_planner.BuildProvider] = []
   569	    for node in nodes:
   570	        active = _active_build_command_names(node)
   571	        if not active:
   572	            continue
   573	        frozen = stack.enter_context(
   574	            build_source.freeze_snapshot(node.snapshot)
   575	        )
   576	        providers.append(
   577	            build_planner.provider_from_spec(
   578	                node.name,
   579	                frozen,
   580	                node.spec,
   581	                active_commands=active,
   582	            )
   583	        )
   584	    return tuple(providers)
