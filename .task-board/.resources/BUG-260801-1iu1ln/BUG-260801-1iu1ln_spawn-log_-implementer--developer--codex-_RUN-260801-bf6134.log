  2176	                        "second transaction did not reach the home-lock handoff"
  2177	                    )
  2178	                commit_consumer(project_name, project, lock)
  2179	
  2180	    def install_second() -> None:
  2181	        project_name = "project-b"
  2182	        project = tmp_path / project_name
  2183	        with ProjectLock(home, project, timeout=coordination_timeout):
  2184	            projects_ready[project_name].set()
