  1884	def _check_audit_registries(
  1885	    plans: list[SkillPlan],
  1886	    config: GlobalConfig,
  1887	    result: _MessageResult,
  1888	    *,
  1889	    alias: str,
  1890	    read_only: bool = False,
  1891	) -> dict[str, dict[str, object]]:
  1892	    """Resolve each skill against trusted audit registries (RFC 0008).
  1893	
  1894	    A verified revocation denies the install. An unknown artifact is advisory
  1895	    at this stage. Returns the authorizing attestation per skill for the
  1896	    marker.
  1897	    """
  1898	    registries = config.trusted_registries()
  1899	    if not registries:
  1900	        return {}
  1901	    strict = config.audit.registry_policy == "strict"
  1902	    cache_dir = config.path.parent / "cache" / "registry"
  1903	    state_dir = config.path.parent / "state" / "registry"
  1904	    if not read_only:
  1905	        try:
  1906	            audit_registry.migrate_snapshot_states(cache_dir, state_dir)
  1907	        except audit_registry.RegistryError as exc:
  1908	            raise InstallError(
  1909	                f"audit registry rollback state migration failed: {exc}"
  1910	            ) from exc
  1911	    unavailable, snapshot_warnings = audit_registry.check_snapshots(
  1912	        registries,
  1913	        state_dir,
  1914	        fetch_snapshot=audit_registry.http_get_snapshot,
  1915	        now=time.time(),
  1916	        max_age_seconds=config.audit.snapshot_max_age_seconds,
  1917	        clock_skew_seconds=config.audit.snapshot_clock_skew_seconds,
  1918	        read_only=read_only,
  1919	    )
  1920	    for warning in snapshot_warnings:
  1921	        result.messages.append(f"{alias}: registry: {warning}")
  1922	    registries = tuple(r for r in registries if r.url not in unavailable)
  1923	    if not registries:
  1924	        # Every trusted registry served a tampered snapshot; refuse to proceed.
  1925	        raise InstallError("every trusted audit registry served a tampered snapshot")
  1926	    fetch = audit_registry.make_http_fetch(
  1927	        cache_dir,
  1928	        ttl_seconds=config.audit.cache_ttl_seconds,
  1929	        grace_seconds=config.audit.offline_grace_seconds,
  1930	        read_only=read_only,
  1931	    )
  1932	    attestations: dict[str, dict[str, object]] = {}
  1933	    errors: list[str] = []
  1934	    for plan in plans:
  1935	        identity = source_identity_mod.canonical_source_identity(plan.decl.git) if plan.decl.git else None
  1936	        if identity is None:
  1937	            continue
  1938	        content_hash = hashing.content_sha256(plan.snapshot)
  1939	        resolution = audit_registry.resolve(
  1940	            registries,
  1941	            source_identity=identity,
  1942	            commit=plan.resolved.commit,
  1943	            content_sha256=content_hash,
  1944	            fetch=fetch,
  1945	        )
  1946	        for warning in resolution.warnings:
  1947	            result.messages.append(f"{alias}: registry: {warning}")
  1948	        if resolution.result == audit_registry.RESULT_REVOKED:
  1949	            registry = resolution.attestation.registry if resolution.attestation else "a trusted registry"
  1950	            errors.append(f"{plan.decl.name} is revoked by {registry}")
  1951	            continue
  1952	        if resolution.result == audit_registry.RESULT_DEPRECATED:
  1953	            result.messages.append(f"{alias}: registry: {plan.decl.name} is marked deprecated")
  1954	        if strict and resolution.result == audit_registry.RESULT_UNKNOWN:
  1955	            errors.append(
  1956	                f"{plan.decl.name} is not audited by any trusted registry (registry_policy is strict)"
  1957	            )
  1958	            continue
  1959	        if resolution.attestation is not None:
  1960	            att = resolution.attestation
  1961	            attestations[plan.decl.name] = {
  1962	                "registry": att.registry,
  1963	                "status": att.status,
  1964	                "key_id": att.key_id,
  1965	            }
  1966	    if errors:
  1967	        raise InstallError("; ".join(errors))
  1968	    return attestations
