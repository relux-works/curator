  2059	    for candidate in candidates:
  2060	        key = os.path.normcase(os.path.abspath(candidate))
  2061	        if key in seen:
  2062	            continue
  2063	        seen.add(key)
  2064	        entries.append(candidate)
  2065	    return tuple(entries)
