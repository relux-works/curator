  2151	            json.dumps(sorted(current)),
  2152	        )
  2153	        engine = TransactionEngine(home)
  2154	        engine.recover(lock)
  2155	        engine.prepare(
  2156	            lock,
  2157	            _plan(
  2158	                f"txn-{project_name}",
  2159	                project,
  2160	                _target("90-consumer", "ledger", ledger, desired),
  2161	            ),
  2162	        )
  2163	        engine.commit(lock, f"txn-{project_name}")
  2164	
  2165	    def install_first() -> None:
  2166	        project_name = "project-a"
  2167	        project = tmp_path / project_name
  2168	        with ProjectLock(home, project, timeout=coordination_timeout):
  2169	            projects_ready[project_name].set()
  2170	            if not start_first_home.wait(timeout=coordination_timeout):
  2171	                raise AssertionError("first home-lock handoff was not released")
  2172	            with ManagerHomeLock(home, timeout=coordination_timeout) as lock:
  2173	                first_home_acquired.set()
  2174	                if not second_home_attempt.wait(timeout=coordination_timeout):
