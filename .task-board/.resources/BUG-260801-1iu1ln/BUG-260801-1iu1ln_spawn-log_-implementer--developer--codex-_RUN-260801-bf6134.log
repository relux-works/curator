   391	def _generation_states(
   392	    paths: tuple[Path, ...],
   393	) -> tuple[dict[Path, tuple[int, int, int, int, int, int] | None], list[str]]:
   394	    states: dict[Path, tuple[int, int, int, int, int, int] | None] = {}
   395	    warnings: list[str] = []
   396	    for path in paths:
   397	        try:
   398	            states[path] = _path_state(path.lstat())
   399	        except FileNotFoundError:
   400	            states[path] = None
   401	        except OSError as exc:
   402	            warnings.append(f"cannot inspect generation {path}: {exc}")
   403	    return states, warnings
