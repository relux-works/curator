   127	def _json_values_equal(left: Any, right: Any) -> bool:
   128	    if type(left) is not type(right):
   129	        return False
   130	    if isinstance(left, dict):
   131	        return left.keys() == right.keys() and all(_json_values_equal(left[key], right[key]) for key in left)
   132	    if isinstance(left, list):
   133	        return len(left) == len(right) and all(_json_values_equal(a, b) for a, b in zip(left, right, strict=True))
   134	    return bool(left == right)
