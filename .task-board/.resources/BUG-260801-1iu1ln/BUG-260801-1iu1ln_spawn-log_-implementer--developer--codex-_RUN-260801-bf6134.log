   354	
   355	def _collect_journal_marker_group(
   356	    group: transactions.InstallMarkerGenerationGroup,
   357	    references: _References,
   358	) -> list[str]:
   359	    """Mark every safe generation and require one valid marker per target."""
   360	
   361	    before, state_warnings = _generation_states(group.paths)
   362	    candidate_references = _References()
   363	    found = False
   364	    warnings = list(state_warnings)
   365	    for path in group.paths:
   366	        marker_found, warning = _collect_marker_directory(
   367	            path,
   368	            candidate_references,
   369	        )
   370	        found = found or marker_found
   371	        if warning is not None:
   372	            warnings.append(f"{path}: {warning}")
   373	    after, after_warnings = _generation_states(group.paths)
   374	    warnings.extend(after_warnings)
   375	    if before != after:
   376	        warnings.append("generation paths changed while they were scanned")
   377	    if not found:
   378	        warnings.append("no valid install marker generation remains")
   379	    if warnings:
   380	        prefix = (
   381	            f"journal {group.transaction_id} context target "
   382	            f"{group.target_identifier!r} is uncertain"
   383	        )
   384	        return [f"{prefix}: {warning}" for warning in warnings]
   385	    references.runtime.update(candidate_references.runtime)
   386	    references.snapshots.update(candidate_references.snapshots)
   387	    references.builds.update(candidate_references.builds)
   388	    return []
