from __future__ import annotations
import json
import pytest
from csk.builds import metadata, planner
import protocol_lifecycle_observations as obs
import test_protocol_conformance as conformance

records = []
original = planner.plan_builds

def record_plans(*args, **kwargs):
    plans = original(*args, **kwargs)
    home = kwargs.get(\"manager_home\")
    text = home.as_posix() if home is not None else \"\"
    if \"status-repair/current/home\" in text or \"status-repair/repair/\" in text:
        records.append({
            \"scope\": text.split(\"status-repair/\", 1)[-1],
            \"plans\": [
                {
                    \"provider\": p.provider,
                    \"command\": p.command,
                    \"cache_key\": p.cache_key,
                    \"receipt_sha256\": (
                        p.inspection.receipt_sha256
                        if p.inspection.receipt_sha256 is not None
                        else None
                    ),
                }
                for p in plans
            ],
        })
    return plans

obs.clear_manager_lifecycle_observation_cache()
with pytest.MonkeyPatch.context() as monkeypatch:
    monkeypatch.setattr(planner, \"plan_builds\", record_plans)
    status_case = obs.observe_manager_lifecycle_case(
        \"compiled-installation-current\",
        conformance.MANAGER_LIFECYCLE_VECTORS[\"compiled_build_fixture\"],
    )
    repair_case = obs.observe_manager_lifecycle_case(
        \"repair-rebuilds-invalid-compiled-entry\",
        conformance.MANAGER_LIFECYCLE_VECTORS[\"compiled_build_fixture\"],
    )
print(json.dumps({
    \"projected_status\": {
        \"cache_key\": status_case[\"cache_key\"],
        \"receipt_sha256\": status_case[\"receipt_sha256\"],
    },
    \"projected_repair_cache_key\": repair_case[\"cache_key\"],
    \"actual_records\": records,
}, indent=2, sort_keys=True))
obs.clear_manager_lifecycle_observation_cache()
