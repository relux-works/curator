from __future__ import annotations
import json
import os
import re
import pytest
from csk.builds import cache_posix
import protocol_lifecycle_observations as obs
import test_protocol_conformance as conformance

exposures = 0
original = cache_posix._rename_noreplace

def expose_via_rename_then_publish(source_dir_fd, source_name, destination_dir_fd, destination_name):
    global exposures
    if re.fullmatch(r\"[0-9a-f]{64}\", destination_name):
        hidden = \".review-partial-live\"
        os.mkdir(hidden, mode=0o700, dir_fd=destination_dir_fd)
        hidden_fd = os.open(hidden, os.O_RDONLY | os.O_DIRECTORY, dir_fd=destination_dir_fd)
        try:
            partial_fd = os.open(
                \"partial\",
                os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                0o600,
                dir_fd=hidden_fd,
            )
            os.close(partial_fd)
        finally:
            os.close(hidden_fd)
        os.rename(
            hidden,
            destination_name,
            src_dir_fd=destination_dir_fd,
            dst_dir_fd=destination_dir_fd,
        )
        exposures += 1
        live_fd = os.open(
            destination_name,
            os.O_RDONLY | os.O_DIRECTORY,
            dir_fd=destination_dir_fd,
        )
        try:
            os.unlink(\"partial\", dir_fd=live_fd)
        finally:
            os.close(live_fd)
        os.rmdir(destination_name, dir_fd=destination_dir_fd)
    return original(source_dir_fd, source_name, destination_dir_fd, destination_name)

obs.clear_manager_lifecycle_observation_cache()
with pytest.MonkeyPatch.context() as monkeypatch:
    monkeypatch.setattr(cache_posix, \"_rename_noreplace\", expose_via_rename_then_publish)
    case = obs.observe_manager_lifecycle_case(
        \"publish-complete-immutable-entry-under-home-lock\",
        conformance.MANAGER_LIFECYCLE_VECTORS[\"compiled_build_fixture\"],
    )
expected = next(
    item for item in conformance.MANAGER_LIFECYCLE_VECTORS[\"cache_publication_cases\"]
    if item[\"name\"] == \"publish-complete-immutable-entry-under-home-lock\"
)
print(json.dumps({
    \"transient_live_exposures_via_os_rename\": exposures,
    \"complete_case_equal_after_exposure\": case == expected,
    \"projected_publication\": case[\"publication\"],
}, indent=2, sort_keys=True))
obs.clear_manager_lifecycle_observation_cache()
