            home_lock,
            _plan(
                transaction_id,
                global_owner,
                _target("10-context", "global-context", context, desired_context),
                _target("90-consumer", "machine", ledger, desired_ledger),
            ),
        )
        backup_paths = [Path(target.backup_path) for target in journal.targets]
