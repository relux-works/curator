+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from csk.builds import cache_windows
+
+    real_api = cache_windows._api
+    captured_chmod = os.chmod
+    mutations = 0
+
+    class MutatingMoveFileEx:
+        def __init__(self, function: Any) -> None:
