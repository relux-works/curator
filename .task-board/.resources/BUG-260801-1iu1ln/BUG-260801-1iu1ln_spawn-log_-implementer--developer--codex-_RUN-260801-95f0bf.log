+                original_mode = stat.S_IMODE(os.fstat(descriptor).st_mode)
+                captured_fchmod(descriptor, original_mode ^ stat.S_IRGRP)
+                captured_fchmod(descriptor, original_mode)
+                mutations += 1
+            finally:
+                os.close(descriptor)
+            return result
