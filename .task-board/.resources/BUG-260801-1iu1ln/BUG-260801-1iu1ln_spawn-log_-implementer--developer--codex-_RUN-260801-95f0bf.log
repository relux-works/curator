+    def mutating_cdll(*args: Any, **kwargs: Any) -> Any:
+        return MutatingLibC(real_cdll(*args, **kwargs))
+
+    clear_manager_lifecycle_observation_cache()
+    monkeypatch.setattr(cache_posix.ctypes, "CDLL", mutating_cdll)
+    try:
