+                    )
+                    captured_chmod(destination_path, original_mode)
+                    mutations += 1
+            return result
+
+        def __getattr__(self, name: str) -> Any:
+            return getattr(self._function, name)
+
+        def __setattr__(self, name: str, value: Any) -> None:
+            setattr(self._function, name, value)
