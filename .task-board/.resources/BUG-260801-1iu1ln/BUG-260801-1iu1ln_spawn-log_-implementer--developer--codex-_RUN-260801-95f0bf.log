def test_rc6_rollback_contract_is_mutation_sensitive(field: str) -> None:
    case = deepcopy(
        next(
            item
            for item in MANAGER_LIFECYCLE_VECTORS["transaction_cases"]
            if item["name"] == "reverse-rollback-under-home-lock"
