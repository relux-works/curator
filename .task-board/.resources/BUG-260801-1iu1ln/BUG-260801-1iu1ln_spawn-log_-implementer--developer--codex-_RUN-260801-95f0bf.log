def test_rc6_toolchain_fixture_projects_native_link_target_to_protocol_bytes() -> None:
    case = next(
        item
        for item in BUILD_DRIVER_VECTORS["toolchain_cases"]
        if "entries" in item
    )
    link = next(entry for entry in case["entries"] if entry["type"] == "symlink")
