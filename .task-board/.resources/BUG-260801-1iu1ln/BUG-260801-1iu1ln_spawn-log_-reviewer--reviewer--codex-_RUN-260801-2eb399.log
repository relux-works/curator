        metadata.BuildArtifact(
            path=build_input.artifact_path,
            sha256=digest,
            size=len(payload),
        ),
    )
    return cache.CachePublication(
        input=build_input,
        receipt_bytes=metadata.canonical_receipt_bytes(receipt),
        artifact_source=artifact,
    )


