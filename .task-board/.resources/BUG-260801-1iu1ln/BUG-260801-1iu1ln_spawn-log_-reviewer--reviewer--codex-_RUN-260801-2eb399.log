        config,
        csk_home,
        guard=guard,
        now=now,
        build_grace_seconds=build_grace_seconds,
    )


def _collect_locked(
    config: GlobalConfig,
    csk_home: Path,
    *,
    guard: _GcLockWitness,
    now: float | None,
    build_grace_seconds: float,
