            references.builds,
            older_than=float(timestamp - build_grace_seconds),
            guard=guard,
        )
    except (build_cache.BuildCacheError, AttributeError) as exc:
        stats.warnings.append(
            f"build cache retained because collection could not prove its boundary: {exc}"
