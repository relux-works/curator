    registry_valid = True
    try:
        known = _load_consumers_strict(csk_home)
    except ValueError as exc:
        registry_valid = False
        uncertain = True
        known = []
        stats.warnings.append(
            f"consumer registry is uncertain; retaining referenced state: {exc}"
