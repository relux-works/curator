import os
import re
import stat
from csk.builds import cache_posix
import protocol_lifecycle_observations as p
from test_protocol_conformance import MANAGER_LIFECYCLE_VECTORS

captured_open = os.open
captured_fchmod = os.fchmod
real = cache_posix._rename_noreplace
mutations = 0

def mutate_root_then_restore(source_dir_fd, source_name, destination_dir_fd, destination_name):
    global mutations
    real(source_dir_fd, source_name, destination_dir_fd, destination_name)
    if not re.fullmatch(r\"[0-9a-f]{64}\", destination_name):
        return
    fd = captured_open(destination_name, os.O_RDONLY | os.O_DIRECTORY, dir_fd=destination_dir_fd)
    try:
        mode = stat.S_IMODE(os.fstat(fd).st_mode)
        captured_fchmod(fd, mode | stat.S_IWGRP)
        captured_fchmod(fd, mode)
        mutations += 1
    finally:
        os.close(fd)

cache_posix._rename_noreplace = mutate_root_then_restore
try:
    p.clear_manager_lifecycle_observation_cache()
    observed = p.observe_manager_lifecycle_case(
        \"publish-complete-immutable-entry-under-home-lock\",
        MANAGER_LIFECYCLE_VECTORS[\"compiled_build_fixture\"],
    )
    expected = next(x for x in MANAGER_LIFECYCLE_VECTORS[\"cache_publication_cases\"] if x[\"name\"] == \"publish-complete-immutable-entry-under-home-lock\")
    print({\"mutations\": mutations, \"equal\": observed == expected, \"observed\": observed})
finally:
    cache_posix._rename_noreplace = real
    p.clear_manager_lifecycle_observation_cache()
