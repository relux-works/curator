+                    artifact.chmod(original_mode)
+            else:
+                completed = subprocess.run(
+                    [os.fspath(artifact)],
+                    check=False,
+                    capture_output=True,
+                )
+            assert completed.returncode == 0
+            executions += 1
+        return publications
+
