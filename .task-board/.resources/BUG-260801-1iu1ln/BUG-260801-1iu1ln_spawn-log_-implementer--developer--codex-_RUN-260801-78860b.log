+        _assert_sabotaged_lifecycle_case_differs(
+            "private_build_cases",
+            "all-misses-stage-and-verify-before-home-lock",
+        )
+        assert executions == 2
+    finally:
+        clear_manager_lifecycle_observation_cache()
