+    try:
+        _assert_sabotaged_lifecycle_case_differs(
+            "recovery_cases",
+            "interrupted-global-journal-recovered-by-transaction-id",
+        )
+        assert any(len(inventory) >= 2 for inventory in inventories)
+    finally:
+        clear_manager_lifecycle_observation_cache()
