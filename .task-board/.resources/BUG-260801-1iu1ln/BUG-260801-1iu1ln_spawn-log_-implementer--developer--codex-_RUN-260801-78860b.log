+    ) -> None:
+        transaction_ids = tuple(self._journal_ids())
+        if transaction_ids:
+            inventories.append(transaction_ids)
+            self.commit(lock, transaction_ids[0])
+
+    clear_manager_lifecycle_observation_cache()
