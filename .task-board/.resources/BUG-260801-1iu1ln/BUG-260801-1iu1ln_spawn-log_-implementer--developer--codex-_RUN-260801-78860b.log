+def test_rc6_recovery_binding_detects_first_journal_only_scan(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    inventories: list[tuple[str, ...]] = []
+
+    def recover_first_journal_only(
+        self: transactions.TransactionEngine,
