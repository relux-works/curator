_TARGET_CLASS_LABELS = {
    "10-context": "context-and-marker",
    "20-runtime": "runtime-shim-environment",
    "60-adapter-ledger": "adapter-and-mirror",
    "80-removal": "stale-removal",
    "90-consumer": "consumer-ledger",
