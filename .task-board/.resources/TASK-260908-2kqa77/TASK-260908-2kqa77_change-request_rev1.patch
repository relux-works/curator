new file mode 100755
index 00000000..befd5e97
--- /dev/null
+++ b/.github/ci/goreleaser-config-gate.sh
@@ -0,0 +1,233 @@
+#!/usr/bin/env bash
+# GoReleaser rc-channel guard.
+#
+# A release candidate must not replace the stable install channels. In
+# .goreleaser.yml that rests on three parsed values: every
+# homebrew_casks/scoops entry's `skip_upload` and `release.prerelease` must be
+# exactly the string `auto`. When the cask/scoop keys were unset, v0.14.0-rc.1
+# reached the tap and the bucket as the served release (2026-08 incident).
+#
+# `goreleaser check` cannot guard this: it validates field names and types and
+# discriminated 0 of 6 wrong-value mutants (TASK-260908-1jv1h3 cycle-3
+# verdict section 5). Neither can a grep for the token `auto`: the `Auto`
+# mutant defeats it. So this gate PARSES the file -- an indentation-aware
+# structural walk, not a text search -- and compares each parsed scalar
+# against the exact string `auto`, case-sensitively.
+#
+# Field naming: the task AC says `brews[*].skip_upload`, but the config
+# declares no `brews` stanza; the publishing surfaces are `homebrew_casks`
+# and `scoops` (verdict section 3). Those two stanzas are what this gate
+# checks, every entry of each.
+#
+# Value semantics (parse-then-compare): quoting is YAML syntax, not value, so
+# an unquoted `auto` -- the same string -- passes. Anything else fails,
+# including `Auto`, `sometimes`, boolean `true`, `ato`, an empty value, and
+# an absent key. A read failure, a missing stanza, a stanza with no entries,
+# and tab indentation all fail closed: an unread gate is never a green gate.
+# Duplicate keys take the last, matching gopkg.in/yaml.v3.
+#
+# The parser is POSIX awk only (no match() captures, no \x escapes): it must
+# run identically under the BSD awk on macos-latest and Git Bash on
+# windows-latest, where gate-selftest.sh executes it on every push.
+#
+# Usage:
+#   bash .github/ci/goreleaser-config-gate.sh [config]
+#     config  GoReleaser config to check (default: .goreleaser.yml)
+#
+# Exit 0 when every checked value parses as exactly `auto`; exit 1 naming
+# the field, the entry and the observed value otherwise.
+
+set -u
+
+cfg="${1:-.goreleaser.yml}"
+
+[ -r "$cfg" ] || { echo "goreleaser-config-gate: cannot read $cfg" >&2; exit 1; }
+
+awk -v sq="'" '
+function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
+
+function indent_of(s) { match(s, /^ */); return RLENGTH }
+
+# Quote an observed scalar for the failure message.
+function dq(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return "\"" s "\"" }
+
+# Split "key: value" at the first colon; sets _key/_raw, returns 1 on match.
+function split_key(s,   ci) {
+	ci = index(s, ":")
+	if (ci <= 1) return 0
+	_key = substr(s, 1, ci - 1)
+	if (_key !~ /^[A-Za-z0-9_.-]+$/) return 0
+	_raw = substr(s, ci + 1)
+	return 1
+}
+
+# Strip a trailing "# comment", honoring single/double quoting.
+function strip_comment(s,   out, i, c, q, prev) {
+	out = ""
+	q = ""
+	for (i = 1; i <= length(s); i++) {
+		c = substr(s, i, 1)
+		if (q == "") {
+			if (c == "#") {
+				prev = substr(s, i - 1, 1)
+				if (prev == " " || prev == "\t") return trim(out)
+				out = out c
+			} else if (c == sq || c == "\"") { q = c; out = out c }
+			else out = out c
+		} else {
+			out = out c
+			if (c == q) {
+				if (q == sq && substr(s, i + 1, 1) == sq) { out = out sq; i++ }
+				else q = ""
+			} else if (q == "\"" && c == "\\") { out = out substr(s, i + 1, 1); i++ }
+		}
+	}
+	return trim(out)
+}
+
+# Remove one layer of matching quotes; doubled single quotes unescape.
+function unquote(s,   q, inner, dbsq) {
+	if (length(s) >= 2) {
+		q = substr(s, 1, 1)
+		if ((q == sq || q == "\"") && substr(s, length(s), 1) == q) {
+			inner = substr(s, 2, length(s) - 2)
+			if (q == sq) { dbsq = sq sq; gsub(dbsq, sq, inner) }
+			else { gsub(/\\"/, "\"", inner); gsub(/\\\\/, "\\", inner) }
+			return inner
+		}
+	}
+	return s
+}
+
+function is_list_section(s) { return (s == "homebrew_casks" || s == "scoops") }
+
+function is_block(v) { return (v ~ /^[|>][+-0-9]*$/) }
+
+# Record one parsed scalar for a channel key.
+function record(kind, idx, raw,   v) {
+	v = strip_comment(raw)
+	if (is_block(v)) v = "<multiline value>"
+	else if (v == "") v = "<empty>"
+	else v = unquote(v)
+	if (kind == "release") { saw_pre = 1; pre_val = v }
+	else { have[kind SUBSEP idx] = 1; val[kind SUBSEP idx] = v }
+}
+
+BEGIN {
+	section = ""
+	entries["homebrew_casks"] = -1; entries["scoops"] = -1
+	in_entry = 0; key_indent = -1; block_min = -1
+	saw_release = 0; saw_pre = 0; bad = 0; hard = 0
+}
+
+{
+	line = $0
+	sub(/\r$/, "", line)
+	if (line ~ /^[ \t]*\t/) {
+		print "goreleaser-config-gate: " FILENAME ": tab indentation is not valid YAML (line " NR ")" > "/dev/stderr"
+		hard = 1
+		exit 1
+	}
+	if (line ~ /^[ \t]*$/) next
+	ind = indent_of(line)
+	# Block-scalar content: every more-indented line, even one shaped
+	# like a key or a comment, is literal text. A dedent ends it.
+	if (block_min >= 0) {
+		if (ind > block_min) next
+		block_min = -1
+	}
+	if (line ~ /^[ \t]*#/) next
+	if (line ~ /^---([ \t]|$)/ || line ~ /^\.\.\.([ \t]|$)/ || line ~ /^%/) next
+
+	# Top-level key opens a section.
+	if (ind == 0) {
+		if (split_key(line)) {
+			section = _key; in_entry = 0; key_indent = -1
+			if (section == "release") saw_release = 1
+			if (section == "homebrew_casks" || section == "scoops") saw_list[section] = 1
+			if (is_block(strip_comment(_raw))) block_min = 0
+		}
+		next
+	}
+
+	# Dash line: only a dash at indent 2 under a channel stanza opens
+	# an entry; deeper dashes are nested list content.
+	if (line ~ /^[ ]+-[ \t]/ || line ~ /^[ ]+-[ \t]*$/) {
+		if (is_list_section(section) && ind == 2) {
+			idx = ++entries[section]
+			in_entry = 1; key_indent = -1
+			rest = line; sub(/^[ ]+-[ \t]*/, "", rest)
+			if (split_key(rest) && _key == "skip_upload")
+				record(section, idx, _raw)
+		}
+		next
+	}
+
+	# Plain key line.
+	stripped = line; sub(/^[ ]*/, "", stripped)
+	if (split_key(stripped)) {
+		key = _key; raw = _raw
+		if (is_block(strip_comment(raw))) {
+			block_min = ind
+			if (section == "release" && ind == 2 && key == "prerelease")
+				record("release", 0, raw)
+			else if (is_list_section(section) && in_entry && ind > 2 && key == "skip_upload") {
+				if (key_indent == -1) key_indent = ind
+				if (ind == key_indent) record(section, entries[section], raw)
+			}
+			next
+		}
+		if (section == "release" && ind == 2 && key == "prerelease") {
+			record("release", 0, raw)
+			next
+		}
+		if (is_list_section(section) && in_entry && ind > 2) {
+			if (key_indent == -1) key_indent = ind
+			if (ind == key_indent && key == "skip_upload")
+				record(section, entries[section], raw)
+			next
+		}
+		next
+	}
+}
+
+END {
+	if (hard) exit 1
+	names[1] = "homebrew_casks"; names[2] = "scoops"
+	for (k = 1; k <= 2; k++) {
+		s = names[k]
+		if (!(s in saw_list)) {
+			printf "goreleaser-config-gate: %s: section \"%s\" is absent, want channel entries with skip_upload \"auto\"\n", FILENAME, s > "/dev/stderr"
+			bad = 1
+			continue
+		}
+		if (entries[s] < 0) {
+			printf "goreleaser-config-gate: %s: section \"%s\" has no entries, want at least one with skip_upload \"auto\"\n", FILENAME, s > "/dev/stderr"
+			bad = 1
+			continue
+		}
+		for (i = 0; i <= entries[s]; i++) {
+			h = (s SUBSEP i)
+			if (!(h in have)) {
+				printf "goreleaser-config-gate: %s: %s[%d].skip_upload is absent, want \"auto\"\n", FILENAME, s, i > "/dev/stderr"
+				bad = 1
+			} else if (val[h] != "auto") {
+				printf "goreleaser-config-gate: %s: %s[%d].skip_upload = %s, want \"auto\"\n", FILENAME, s, i, dq(val[h]) > "/dev/stderr"
+				bad = 1
+			}
+		}
+	}
+	if (!saw_release) {
+		printf "goreleaser-config-gate: %s: section \"release\" is absent, want release.prerelease \"auto\"\n", FILENAME > "/dev/stderr"
+		bad = 1
+	} else if (!saw_pre) {
+		printf "goreleaser-config-gate: %s: release.prerelease is absent, want \"auto\"\n", FILENAME > "/dev/stderr"
+		bad = 1
+	} else if (pre_val != "auto") {
+		printf "goreleaser-config-gate: %s: release.prerelease = %s, want \"auto\"\n", FILENAME, dq(pre_val) > "/dev/stderr"
+		bad = 1
+	}
+	if (bad) exit 1
+	printf "goreleaser-config-gate: %s: %d channel entries and release.prerelease are \"auto\"\n", FILENAME, entries["homebrew_casks"] + entries["scoops"] + 2
+}
+' "$cfg"
