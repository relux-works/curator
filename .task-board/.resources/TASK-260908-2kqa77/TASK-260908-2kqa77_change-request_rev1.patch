diff --git a/.github/ci/gate-selftest.sh b/.github/ci/gate-selftest.sh
index 76efafff..dfce2c77 100755
--- a/.github/ci/gate-selftest.sh
+++ b/.github/ci/gate-selftest.sh
@@ -1144,6 +1144,81 @@ else
 	bad 'the rust behavioural cases have shipped streams to narrow' 'missing $WORK/shipped-darwin.json or $WORK/shipped-linux.json'
 fi
 
+echo ''
+echo '=== goreleaser-config-gate.sh: the rc channel values parse as exactly auto ==='
+GCG="$HERE/goreleaser-config-gate.sh"
+GR_SRC='.goreleaser.yml'
+assert 'the committed .goreleaser.yml passes the rc-channel gate' 0 bash "$GCG" "$GR_SRC"
+
+# Row C (TASK-260908-1jv1h3 cycle-3 verdict): the pre-change state that
+# published the rc -- channel entries with no skip_upload key at all.
+grep -v 'skip_upload:' "$GR_SRC" >"$WORK/grl-c-absent-both.yml"
+assert 'row C: entries with no skip_upload fail' 1 bash "$GCG" "$WORK/grl-c-absent-both.yml"
+
+# Narrowed: one entry losing its key is already a publish path.
+awk '{ if (!done && /skip_upload:/) { done=1; next } print }' "$GR_SRC" >"$WORK/grl-c-absent-one.yml"
+assert 'row C narrowed to one entry still fails' 1 bash "$GCG" "$WORK/grl-c-absent-one.yml"
+assert_contains 'the absence names the field and entry' 'homebrew_casks[0].skip_upload is absent' "$WORK/out.txt"
+
+# Row E: one capital letter defeats the guard, and defeats a token grep.
+awk '{ if (!done && /skip_upload: "auto"/) { sub(/"auto"/, "\"Auto\""); done=1 } print }' "$GR_SRC" >"$WORK/grl-e-auto-cask.yml"
+assert 'row E: "Auto" fails (case-sensitive)' 1 bash "$GCG" "$WORK/grl-e-auto-cask.yml"
+assert_contains 'the failure names the field, entry and observed value' 'homebrew_casks[0].skip_upload = "Auto"' "$WORK/out.txt"
+assert_contains 'the failure states the wanted value' 'want "auto"' "$WORK/out.txt"
+
+awk 'BEGIN{c=0} /skip_upload: "auto"/{c++} { if (c==2 && !done) { sub(/"auto"/, "\"Auto\""); done=1 } print }' "$GR_SRC" >"$WORK/grl-e-auto-scoop.yml"
+assert '"Auto" in the scoop entry fails' 1 bash "$GCG" "$WORK/grl-e-auto-scoop.yml"
+
+awk '{ if (!done && /skip_upload: "auto"/) { sub(/"auto"/, "sometimes"); done=1 } print }' "$GR_SRC" >"$WORK/grl-sometimes.yml"
+assert 'sometimes fails' 1 bash "$GCG" "$WORK/grl-sometimes.yml"
+
+awk '{ if (!done && /skip_upload: "auto"/) { sub(/"auto"/, "true"); done=1 } print }' "$GR_SRC" >"$WORK/grl-true.yml"
+assert 'boolean true fails' 1 bash "$GCG" "$WORK/grl-true.yml"
+
+sed 's/prerelease: "auto"/prerelease: "ato"/' "$GR_SRC" >"$WORK/grl-ato.yml"
+assert 'prerelease "ato" fails' 1 bash "$GCG" "$WORK/grl-ato.yml"
+assert_contains 'the prerelease failure names the observed value' 'release.prerelease = "ato"' "$WORK/out.txt"
+
+sed 's/prerelease: "auto"/prerelease: "Auto"/' "$GR_SRC" >"$WORK/grl-pre-auto.yml"
+assert 'prerelease "Auto" fails' 1 bash "$GCG" "$WORK/grl-pre-auto.yml"
+
+grep -v 'prerelease: "auto"' "$GR_SRC" >"$WORK/grl-pre-absent.yml"
+assert 'an absent prerelease fails' 1 bash "$GCG" "$WORK/grl-pre-absent.yml"
+
+# Every entry is checked, not just the first: a bad second entry fails by
+# index, a good one passes.
+awk '$0 ~ /^release:/ && ing == 1 { print "  - name: extra"; print "    skip_upload: \"sometimes\""; ing=0 } { print } $0 ~ /^scoops:/ { ing=1 }' "$GR_SRC" >"$WORK/grl-second-bad.yml"
+assert 'a bad second entry fails naming its index' 1 bash "$GCG" "$WORK/grl-second-bad.yml"
+assert_contains 'the second-entry failure names scoops[1]' 'scoops[1].skip_upload' "$WORK/out.txt"
+
+awk '$0 ~ /^release:/ && ing == 1 { print "  - name: extra"; print "    skip_upload: \"auto\""; ing=0 } { print } $0 ~ /^scoops:/ { ing=1 }' "$GR_SRC" >"$WORK/grl-second-good.yml"
+assert 'a good second entry passes' 0 bash "$GCG" "$WORK/grl-second-good.yml"
+
+# Parse-then-compare, not text match: quoting is syntax, so an unquoted
+# auto is the same string and passes.
+sed 's/skip_upload: "auto"/skip_upload: auto/; s/prerelease: "auto"/prerelease: auto/' "$GR_SRC" >"$WORK/grl-unquoted.yml"
+assert 'unquoted auto passes (same parsed string)' 0 bash "$GCG" "$WORK/grl-unquoted.yml"
+
+# Structure, not text: a skip_upload nested under repository: must not
+# satisfy the entry that lost its own key.
+awk '{ if (!done && /^    skip_upload:/) { print "    repository:"; print "      skip_upload: \"auto\""; done=1; next } print }' "$GR_SRC" >"$WORK/grl-nested.yml"
+assert 'a nested skip_upload does not satisfy the entry' 1 bash "$GCG" "$WORK/grl-nested.yml"
+
+# Fail closed: a deleted stanza or an unreadable file is never green.
+awk '/^homebrew_casks:/{skip=1} /^scoops:/{skip=0} !skip{print}' "$GR_SRC" >"$WORK/grl-no-stanza.yml"
+assert 'a removed channel stanza fails' 1 bash "$GCG" "$WORK/grl-no-stanza.yml"
+assert 'a missing config fails closed' 1 bash "$GCG" "$WORK/grl-absent.yml"
+
+# The gate only guards the committed file if a lane runs it. The lint job
+# runs the exact default invocation on every push; read that back so a
+# refactor cannot drop the step without this self-test noticing.
+gate_runs="$(grep -cF 'run: bash .github/ci/goreleaser-config-gate.sh' "$WORKFLOW")"
+if [ "$gate_runs" -eq 1 ]; then
+	ok 'ci.yml invokes the goreleaser config gate exactly once'
+else
+	bad 'ci.yml invokes the goreleaser config gate exactly once' "invocations: $gate_runs"
+fi
+
 echo ''
 printf 'gate-selftest: %d passed, %d failed' "$PASS" "$FAIL"
 [ "$SKIPPED" -gt 0 ] && printf ', %d skipped (reported above, not hidden)' "$SKIPPED"
