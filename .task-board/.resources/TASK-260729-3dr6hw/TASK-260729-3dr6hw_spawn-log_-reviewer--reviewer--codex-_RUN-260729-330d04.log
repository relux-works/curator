   702	
   703	// TestConcurrentProjectInstallsPreserveBothConsumers proves the consumer ledger
   704	// is merged under the manager-home lock rather than staged before it: two
   705	// checkouts installing at once must both end up registered, and neither may
   706	// overwrite the other's record.
   707	//
   708	// The two installs run as separate processes because the manager lock layer
   709	// deliberately serializes lock-class acquisition per process. Sharing one
   710	// process would test that guard rather than the ledger merge this asserts.
   711	func TestConcurrentProjectInstallsPreserveBothConsumers(t *testing.T) {
   712		home := t.TempDir()
   713		skillsRoot := t.TempDir()
   714		first := newEnvIn(t, home, skillsRoot)
   715		second := newEnvIn(t, home, skillsRoot)
   716		first.skill("skill-a")
   717		first.declare("skill-a")
   718		second.declare("skill-a")
   719	
   720		var group sync.WaitGroup
   721		failures := make([]error, 2)
   722		for index, scope := range []*env{first, second} {
   723			group.Add(1)
   724			go func(index int, project string) {
   725				defer group.Done()
   726				command := exec.Command(os.Args[0], "-test.run=^TestInstallHelperProcess$")
   727				command.Env = append(os.Environ(),
   728					helperInstallEnv+"=1",
   729					helperHomeEnv+"="+home,
   730					helperSkillsEnv+"="+skillsRoot,
   731					helperProjectEnv+"="+project,
   732				)
   733				if output, err := command.CombinedOutput(); err != nil {
   734					failures[index] = fmt.Errorf("%w\n%s", err, output)
   735				}
   736			}(index, scope.project)
   737		}
   738		group.Wait()
   739	
   740		for index, err := range failures {
   741			if err != nil {
   742				t.Fatalf("concurrent install %d failed: %v", index, err)
   743			}
   744		}
   745		registered := scopes.LoadConsumers(home)
