   113	// Select chooses a safe writable user directory that is already on PATH.
   114	func Select(home, platform string, environment map[string]string, userHome string) Selection {
   115		if userHome == "" {
   116			userHome, _ = os.UserHomeDir()
   117		}
   118		pathDirs := pathDirectories(envValue(environment, "PATH"), platform)
   119		explicit := strings.TrimSpace(envValue(environment, UserBinEnv))
   120		if explicit != "" {
   121			explicit = expandHome(explicit, userHome)
   122			switch {
   123			case disallowed(explicit, home, platform):
   124				return Selection{Warning: fmt.Sprintf(
   125					"global: %s points to a protected tool-manager or Curator directory: %s; choose a normal user bin or use curator shell-init --install",
   126					UserBinEnv, explicit,
   127				)}
   128			case !underHome(explicit, userHome, platform):
   129				return Selection{Warning: fmt.Sprintf(
   130					"global: %s must select a directory below the user home: %s",
   131					UserBinEnv, explicit,
   132				)}
   133			case !containsPath(pathDirs, explicit, platform):
   134				return Selection{Warning: fmt.Sprintf(
   135					"global: %s is not on PATH: %s; add it to PATH or choose an existing user bin",
   136					UserBinEnv, explicit,
   137				)}
   138			case !writableOrCreatable(explicit):
   139				return Selection{Warning: fmt.Sprintf(
   140					"global: %s is not writable: %s; choose a writable PATH directory or use curator shell-init --install",
   141					UserBinEnv, explicit,
   142				)}
   143			default:
   144				return Selection{Path: explicit}
   145			}
   146		}
   147	
   148		for _, preferred := range []string{
   149			filepath.Join(userHome, ".local", "bin"),
   150			filepath.Join(userHome, "bin"),
   151		} {
   152			if containsPath(pathDirs, preferred, platform) && safeExistingUserBin(preferred, userHome, home, platform) {
   153				return Selection{Path: preferred}
   154			}
   155		}
   156		for _, candidate := range pathDirs {
   157			if safeExistingUserBin(candidate, userHome, home, platform) {
   158				return Selection{Path: candidate}
   159			}
   160		}
   161		return Selection{Warning: noSafeBinWarning(filepath.Join(home, "global", "bin"))}
   162	}
