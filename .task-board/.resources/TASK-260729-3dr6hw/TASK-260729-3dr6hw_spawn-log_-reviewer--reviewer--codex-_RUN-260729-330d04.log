   201			"project/adapters-codex": filepath.Join(e.project,
   202				filepath.FromSlash(adapters.AgentPaths["codex_cli"])),
   203			"hybrid/store":   scopes.HybridSkillsRoot(e.home),
   204			"home/runtime":   filepath.Join(e.home, "runtime"),
   205			"home/consumers": filepath.Join(e.home, scopes.ConsumersName),
   206			"global/skills":  filepath.Join(e.home, "global", "skills"),
   207			"global/bin":     filepath.Join(e.home, "global", "bin"),
   208			"global/env.sh":  filepath.Join(e.home, "global", "env.sh"),
   209		}
   210		if e.userHome != "" {
   211			paths["user/adapters"] = filepath.Join(e.userHome, filepath.FromSlash(adapters.AgentPaths["claude_code"]))
   212			paths["user/adapters-codex"] = filepath.Join(e.userHome, filepath.FromSlash(adapters.AgentPaths["codex_cli"]))
   213			paths["user/bin"] = filepath.Join(e.userHome, ".local", "bin")
   214		}
