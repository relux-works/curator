   164	func envValue(environment map[string]string, name string) string {
   165		if environment == nil {
   166			return os.Getenv(name)
   167		}
   168		return environment[name]
   169	}
   170	
   171	func pathDirectories(value, platform string) []string {
   172		separator := string(os.PathListSeparator)
   173		if platform == "windows" {
   174			separator = ";"
   175		}
   176		var paths []string
   177		for _, raw := range strings.Split(value, separator) {
   178			if trimmed := strings.TrimSpace(raw); trimmed != "" {
   179				paths = append(paths, trimmed)
   180			}
   181		}
   182		return paths
   183	}
   184	
   185	func expandHome(path, home string) string {
   186		if path == "~" {
   187			return home
   188		}
   189		if strings.HasPrefix(path, "~/") || strings.HasPrefix(path, `~\`) {
   190			return filepath.Join(home, path[2:])
   191		}
   192		return path
   193	}
   194	
   195	func safeExistingUserBin(path, userHome, managerHome, platform string) bool {
   196		if disallowed(path, managerHome, platform) || !underHome(path, userHome, platform) {
   197			return false
   198		}
   199		info, err := os.Stat(path)
   200		return err == nil && info.IsDir() && info.Mode().Perm()&0o200 != 0
   201	}
