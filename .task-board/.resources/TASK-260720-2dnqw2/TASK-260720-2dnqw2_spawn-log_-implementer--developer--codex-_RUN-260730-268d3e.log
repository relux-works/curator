   204	@dataclass(frozen=True)
   205	class BuildArtifact:
   206	    """The one manager-derived artifact an immutable logical entry contains."""
   207	
   208	    path: str
   209	    sha256: str
   210	    size: int
   211	
   212	    def __post_init__(self) -> None:
   213	        _require_portable_path(self.path, "artifact path", "build_receipt_invalid")
   214	        _require_sha256(self.sha256, "artifact sha256", "build_receipt_invalid")
   215	        if not isinstance(self.size, int) or isinstance(self.size, bool):
   216	            raise BuildMetadataError("build_receipt_invalid", f"artifact size must be an integer, got {self.size!r}")
   217	        if not 0 <= self.size <= protocol_json.MAX_SAFE_INTEGER:
   218	            raise BuildMetadataError("build_receipt_invalid", f"artifact size is outside the safe range: {self.size}")
   219	
   220	    def to_json(self) -> dict[str, Any]:
   221	        return {"path": self.path, "sha256": self.sha256, "size": self.size}
