   277	def canonical_input_bytes(build_input: GoBuildInput) -> bytes:
   278	    """Return the exact CCJ-1 bytes the logical cache key is computed over."""
   279	    return _canonical_bytes(build_input.to_json(), "build input")
   280	
   281	
   282	def cache_key(build_input: GoBuildInput) -> str:
   283	    """Return the logical cache key of one build input."""
   284	    return sha256_identity(canonical_input_bytes(build_input))
   285	
   286	
   287	def canonical_receipt_bytes(receipt: BuildReceipt) -> bytes:
   288	    """Return the exact bytes a stored receipt must equal."""
   289	    return _canonical_bytes(receipt.to_json(), "build receipt")
   290	
   291	
   292	def receipt_sha256(raw: bytes) -> str:
   293	    """Return the receipt hash over exact stored receipt bytes."""
   294	    return sha256_identity(raw)
   295	
   296	
   297	def sha256_identity(raw: bytes) -> str:
   298	    return _SHA256_PREFIX + hashlib.sha256(raw).hexdigest()
