   270	def derived_artifact_path(command: str, *, goos: str) -> str:
   271	    """Derive the artifact-relative path from the command name alone."""
   272	    _require_identifier(command, "build command")
   273	    suffix = _WINDOWS_ARTIFACT_SUFFIX if goos == _WINDOWS_GOOS else ""
   274	    return f"{_ARTIFACT_DIRECTORY}/{command}{suffix}"
   275	
