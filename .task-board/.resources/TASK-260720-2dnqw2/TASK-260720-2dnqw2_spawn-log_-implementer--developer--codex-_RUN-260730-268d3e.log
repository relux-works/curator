   224	@dataclass(frozen=True)
   225	class BuildReceipt:
   226	    """Build receipt schema 1: the entry's key, complete input, and artifact."""
   227	
   228	    cache_key: str
   229	    input: GoBuildInput
   230	    artifact: BuildArtifact
   231	    schema_version: int = RECEIPT_SCHEMA_VERSION
   232	
   233	    def __post_init__(self) -> None:
   234	        if (
   235	            not isinstance(self.schema_version, int)
   236	            or isinstance(self.schema_version, bool)
   237	            or self.schema_version not in SUPPORTED_RECEIPT_SCHEMA_VERSIONS
   238	        ):
   239	            raise BuildMetadataError(
   240	                "unsupported_receipt_schema",
   241	                f"unsupported build receipt schema_version {self.schema_version!r}",
   242	            )
   243	        if not isinstance(self.input, GoBuildInput):
   244	            raise BuildMetadataError("build_receipt_invalid", "receipt input must be a GoBuildInput")
   245	        if not isinstance(self.artifact, BuildArtifact):
   246	            raise BuildMetadataError("build_receipt_invalid", "receipt artifact must be a BuildArtifact")
   247	        _require_sha256(self.cache_key, "receipt cache_key", "build_receipt_invalid")
   248	        derived = cache_key(self.input)
   249	        if self.cache_key != derived:
   250	            raise BuildMetadataError(
   251	                "cache_key_mismatch",
   252	                f"receipt cache_key {self.cache_key} does not equal the key its input derives ({derived})",
   253	            )
   254	        if self.artifact.path != self.input.artifact_path:
   255	            raise BuildMetadataError(
   256	                "artifact_path_mismatch",
   257	                f"artifact path {self.artifact.path!r} is not the manager-derived "
   258	                f"path {self.input.artifact_path!r}",
   259	            )
   260	
   261	    def to_json(self) -> dict[str, Any]:
   262	        return {
   263	            "artifact": self.artifact.to_json(),
   264	            "cache_key": self.cache_key,
   265	            "input": self.input.to_json(),
   266	            "schema_version": self.schema_version,
   267	        }
