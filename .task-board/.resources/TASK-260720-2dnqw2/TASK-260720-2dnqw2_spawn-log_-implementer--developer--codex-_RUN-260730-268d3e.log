+            ),
+        )
+    _assert_build_error("build_input_invalid", raised)
+
+    with pytest.raises(BuildMetadataError) as raised:
+        replace(
+            valid,
+            toolchain=replace(
+                valid.toolchain,
+                go_version="go version go1.26.1 linux/amd64",
+            ),
+        )
+    _assert_build_error("build_input_invalid", raised)
+
