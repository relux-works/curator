   899	def _is_dead_install_orphan(path: Path) -> bool:
   900	    match = _INSTALL_ORPHAN_RE.fullmatch(path.name)
   901	    return (
   902	        match is not None
   903	        and not locking._pid_alive(int(match.group(1)))
   904	    )
