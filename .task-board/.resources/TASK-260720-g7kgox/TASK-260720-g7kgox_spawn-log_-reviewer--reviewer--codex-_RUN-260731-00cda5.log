   331	    def _copy_staging_file(
   332	        self,
   333	        journal: Journal,
   334	        target: JournalTarget,
   335	        source_root: Path,
   336	        staged_root: Path,
   337	        entry: StagingTreeEntry,
   338	    ) -> None:
   339	        self._assert_mutation_witness()
   340	        source = _staging_entry_path(source_root, entry.relative_path)
   341	        destination = _staging_entry_path(staged_root, entry.relative_path)
   342	        _validate_staging_entry(source, entry)
   343	        prefix = hashlib.sha256(_STAGING_PREFIX_DOMAIN)
   344	        with (
   345	            source.open("rb") as source_handle,
   346	            destination.open("ab", buffering=0) as destination_handle,
   347	        ):
   348	            while True:
   349	                chunk = source_handle.read(_STAGING_COPY_CHUNK_SIZE)
   350	                if not chunk:
   351	                    break
   352	                prefix.update(chunk)
   353	                target.staging_write_bytes = target.staging_bytes + len(chunk)
   354	                target.staging_write_digest = "sha256:" + prefix.hexdigest()
   355	                self._save_journal(journal)
   356	                self._assert_mutation_witness()
   357	                view = memoryview(chunk)
   358	                while view:
   359	                    written = destination_handle.write(view)
   360	                    if written is None or written <= 0:
   361	                        raise OSError("short staging write")
   362	                    view = view[written:]
   363	                os.fsync(destination_handle.fileno())
   364	                self._assert_mutation_witness()
   365	                self._emit("after_staging_chunk_sync", target)
   366	                target.staging_bytes = target.staging_write_bytes
   367	                target.staging_prefix_digest = target.staging_write_digest
   368	                target.staging_write_bytes = 0
   369	                target.staging_write_digest = None
   370	                self._save_journal(journal)
   371	                self._emit("during_staging_copy", target)
   372	        _validate_staging_entry(source, entry)
