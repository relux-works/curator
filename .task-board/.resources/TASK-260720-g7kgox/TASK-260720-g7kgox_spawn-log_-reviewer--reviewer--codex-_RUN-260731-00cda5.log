   126	def _refresh_adapters(
   127	    canonical_root: Path,
   128	    adapter_roots: dict[str, Path],
   129	    agents: list[str],
   130	    skill_names: list[str],
   131	    mode: str,
   132	) -> None:
   133	    _refresh_adapter_groups(adapter_roots, agents, [(canonical_root, skill_names)], mode)
   134	
   135	
   136	def _refresh_adapter_groups(
   137	    adapter_roots: dict[str, Path],
   138	    agents: list[str],
   139	    groups: list[tuple[Path, list[str]]],
   140	    mode: str,
   141	) -> None:
   142	    expected: set[str] = set()
   143	    for _, names in groups:
   144	        expected.update(names)
   145	    for agent in agents:
   146	        adapter_root = adapter_roots.get(agent)
   147	        if adapter_root is None:
   148	            continue
   149	        adapter_root.mkdir(parents=True, exist_ok=True)
   150	        managed = _read_managed(adapter_root)
   151	        for name in managed - expected:
   152	            child = adapter_root / name
   153	            if child.exists() or child.is_symlink():
   154	                _remove_path(child)
   155	        for canonical_root, skill_names in groups:
   156	            for skill_name in skill_names:
   157	                source = canonical_root / skill_name
   158	                target = adapter_root / skill_name
   159	                if not source.exists():
   160	                    continue
   161	                if _is_unmanaged_conflict(target, managed, source):
   162	                    raise AdapterError(f"Adapter target already exists and is not managed by csk: {target}")
   163	                _refresh_entry(source, target, mode)
   164	        _write_managed(adapter_root, expected)
   165	
   166	
   167	def _refresh_entry(source: Path, target: Path, mode: str) -> None:
   168	    if mode == "copy":
   169	        if target.exists() or target.is_symlink():
   170	            _remove_path(target)
   171	        shutil.copytree(source, target, symlinks=True)
   172	        return
   173	    if mode == "symlink":
   174	        if target.exists() or target.is_symlink():
   175	            _remove_path(target)
   176	        target.symlink_to(os.path.relpath(source, target.parent), target_is_directory=True)
   177	        return
   178	    # auto
   179	    try:
   180	        if target.exists() or target.is_symlink():
   181	            _remove_path(target)
   182	        target.symlink_to(os.path.relpath(source, target.parent), target_is_directory=True)
   183	    except OSError:
   184	        if target.exists() or target.is_symlink():
   185	            _remove_path(target)
   186	        shutil.copytree(source, target, symlinks=True)
