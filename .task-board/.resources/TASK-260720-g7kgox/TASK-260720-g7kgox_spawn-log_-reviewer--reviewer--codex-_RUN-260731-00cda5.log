   396	def _read_managed(bin_dir: Path) -> set[str]:
   397	    path = bin_dir / MANAGED_FILE
   398	    if not path.exists():
   399	        return set()
   400	    try:
   401	        data = protocol_json.loads(path.read_bytes())
   402	    except (OSError, protocol_json.ProtocolJSONError):
   403	        return set()
   404	    if (
   405	        not isinstance(data, dict)
   406	        or set(data) != {"schema_version", "entries"}
   407	        or data.get("schema_version") != SCHEMA_VERSION
   408	    ):
   409	        return set()
   410	    entries = data["entries"]
   411	    if (
   412	        not isinstance(entries, list)
   413	        or any(not isinstance(entry, str) or not is_valid_identifier(entry) for entry in entries)
   414	        or len(entries) != len(set(entries))
   415	    ):
   416	        return set()
   417	    return set(entries)
   418	
   419	
   420	def _write_managed(bin_dir: Path, entries: set[str]) -> None:
   421	    path = bin_dir / MANAGED_FILE
   422	    data = {"schema_version": SCHEMA_VERSION, "entries": sorted(entries)}
   423	    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
   424	
   425	
   426	def _is_unmanaged_conflict(target: Path, command_name: str, managed: set[str], canonical: Path) -> bool:
   427	    if not target.exists() and not target.is_symlink():
   428	        return False
   429	    if command_name in managed:
   430	        return False
   431	    if target.is_symlink():
   432	        try:
   433	            return target.resolve() != canonical.resolve()
   434	        except OSError:
   435	            return True
   436	    return True

