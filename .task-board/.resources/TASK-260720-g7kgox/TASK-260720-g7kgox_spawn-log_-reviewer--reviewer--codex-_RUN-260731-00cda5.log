   288	    def _create_staging_entry(
   289	        self,
   290	        source_root: Path,
   291	        staged_root: Path,
   292	        entry: StagingTreeEntry,
   293	    ) -> None:
   294	        self._assert_mutation_witness()
   295	        source = _staging_entry_path(source_root, entry.relative_path)
   296	        destination = _staging_entry_path(staged_root, entry.relative_path)
   297	        _validate_staging_entry(source, entry)
   298	        if _path_exists(destination):
   299	            raise TransactionCorruptionError(
   300	                f"staging entry exists before creation: {destination}"
   301	            )
   302	        _require_safe_staging_parent(destination.parent)
   303	        if entry.kind == "link":
   304	            if entry.link_target is None:
   305	                raise TransactionCorruptionError(
   306	                    f"staging link has no recorded destination: {destination}"
   307	                )
   308	            destination.symlink_to(
   309	                entry.link_target,
   310	                target_is_directory=bool(entry.link_is_directory),
   311	            )
   312	        elif entry.kind == "directory":
   313	            construction_mode = _staging_construction_mode(entry)
   314	            destination.mkdir(mode=construction_mode)
   315	            destination.chmod(construction_mode)
   316	            _sync_directory(destination)
   317	        else:
   318	            fd = os.open(
   319	                destination,
   320	                os.O_WRONLY | os.O_CREAT | os.O_EXCL,
   321	                0o600,
   322	            )
   323	            try:
   324	                destination.chmod(_staging_construction_mode(entry))
   325	                os.fsync(fd)
   326	            finally:
   327	                os.close(fd)
   328	        _sync_directory(destination.parent)
   329	        self._assert_mutation_witness()
