from csk import cli, config, global_install, locking

with tempfile.TemporaryDirectory() as raw:
    root = Path(raw)
    home = root / 'home'
    home.mkdir()
    os.environ['HOME'] = str(home)
    os.environ['USERPROFILE'] = str(home)
    csk_home = root / '.cocoaskills'
    locking.provision_new_manager_home(csk_home)
    skills = root / 'skills'
    skills.mkdir()
    cfg = config.GlobalConfig(
        path=csk_home / 'config.json',
        skills_root=skills,
        preferred_locale=None,
        default_agents=['codex_cli'],
        adapter_mode='copy',
        worktree_alias_pattern='[A-Z]+-[0-9]+',
        projects={},
    )
    config.save_config(cfg)
    global_root = csk_home / 'global'
    global_root.mkdir()
    (global_root / 'Skillfile.json').write_text(json.dumps({
        'schema_version': 1,
        'agents': ['codex_cli'],
        'skills': [],
    }) + '\\n', encoding='utf-8')
    os.environ['CSK_CONFIG'] = str(cfg.path)

    real_lock = locking.ManagerHomeLock
    count = {'value': 0}
    def lock_factory(*args, **kwargs):
        count['value'] += 1
        if count['value'] == 2:
            raise locking.LockError('forced late home-lock contention')
        return real_lock(*args, **kwargs)
    global_install.locking.ManagerHomeLock = lock_factory
    try:
        code = cli.main(['global', 'install'])
    finally:
        global_install.locking.ManagerHomeLock = real_lock
    print(json.dumps({'exit': code, 'lock_calls': count['value']}))
