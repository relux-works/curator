   969	def _assert_target_preimages_current(
   970	    targets: tuple[_MaterializationTarget, ...],
   971	    expected: Mapping[tuple[str, str], str],
   972	) -> None:
   973	    for target in targets:
   974	        key = _target_key(target)
   975	        if (
   976	            transactions.digest_target(
   977	                target.live_path,
   978	                kind=target.kind,
   979	            )
   980	            != expected[key]
   981	        ):
   982	            raise _concurrent_state_change(
   983	                f"materialization target changed before commit: "
   984	                f"{target.target_class}/{target.identifier}"
   985	            )
