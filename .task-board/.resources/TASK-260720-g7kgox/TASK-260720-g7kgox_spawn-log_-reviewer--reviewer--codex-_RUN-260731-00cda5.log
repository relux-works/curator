   878	def _prune_staged_global_runtime(
   879	    config: GlobalConfig,
   880	    nodes: list[closure.ClosureNode],
   881	    staged_runtime: Path,
   882	) -> None:
   883	    references = _global_runtime_references_for_plan(config, nodes)
   884	    if not staged_runtime.exists():
   885	        return
   886	    for skill_dir in list(staged_runtime.iterdir()):
   887	        if not skill_dir.is_dir() or skill_dir.is_symlink():
   888	            continue
   889	        for commit_dir in list(skill_dir.iterdir()):
   890	            if (
   891	                commit_dir.is_dir()
   892	                and not commit_dir.is_symlink()
   893	                and (skill_dir.name, commit_dir.name) not in references
   894	            ):
   895	                shutil.rmtree(commit_dir)
   896	        if not any(skill_dir.iterdir()):
   897	            skill_dir.rmdir()
