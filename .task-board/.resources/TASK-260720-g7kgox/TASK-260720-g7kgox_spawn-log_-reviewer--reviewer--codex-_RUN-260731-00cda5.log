    88	def refresh_adapter_groups(
    89	    project_root: Path,
    90	    agents: list[str],
    91	    groups: list[tuple[Path, list[str]]],
    92	    mode: str,
    93	) -> None:
    94	    """Mirror skills from several canonical roots into the agent directories.
    95	
    96	    All groups share one managed-entries ledger per adapter root, so entries
    97	    that fall out of every group are removed in the same pass.
    98	    """
    99	    warn_unknown_agents(agents)
