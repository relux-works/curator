    62	        '$env:PATH = "$env:CSK_GLOBAL_ROOT\\bin;$env:PATH"\n',
    63	        encoding="utf-8",
    64	    )
    65	
    66	
    67	def _sh_quote(value: str) -> str:
    68	    return "'" + value.replace("'", "'\"'\"'") + "'"
    69	
    70	
    71	def _ps_quote(value: str) -> str:
    72	    return "'" + value.replace("'", "''") + "'"
