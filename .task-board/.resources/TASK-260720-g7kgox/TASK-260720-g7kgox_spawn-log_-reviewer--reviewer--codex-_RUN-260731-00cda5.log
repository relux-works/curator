   850	
   851	    for target in materialization_targets:
   852	        key = installer._target_key(target)
   853	        if key in desired:
   854	            continue
   855	        if target.target_class == "10-context":
   856	            _, name = target.identifier.split("/", 1)
   857	            desired[key] = staged_skills / name
   858	        elif target.target_class == "20-runtime":
   859	            name, commit = target.identifier.split("/", 1)
   860	            desired[key] = staged_home / "runtime" / name / commit
   861	        elif target.target_class == "30-shim-canonical":
   862	            desired[key] = shims.shim_path(
   863	                global_bin_dir(staged_home),
   864	                target.identifier,
   865	            )
   866	        elif target.target_class == "50-env-file":
   867	            desired[key] = global_root(staged_home) / target.identifier
   868	        elif target.target_class == "80-removal":
   869	            desired[key] = None
