   861	def _stale_entry_targets(
   862	    root: Path,
   863	    expected: set[str],
   864	    *,
   865	    identifier_prefix: str,
   866	) -> list[_MaterializationTarget]:
   867	    targets: list[_MaterializationTarget] = []
   868	    if not root.exists():
   869	        return targets
   870	    for child in root.iterdir():
   871	        if child.name.startswith("."):
   872	            if _is_dead_install_orphan(child):
   873	                targets.append(
   874	                    _MaterializationTarget(
   875	                        target_class="80-removal",
   876	                        identifier=(
   877	                            f"{identifier_prefix}/orphan/{child.name}"
   878	                        ),
   879	                        live_path=child,
   880	                        kind="entry",
   881	                    )
   882	                )
   883	            continue
   884	        if child.name in expected:
   885	            continue
   886	        if not child.is_dir() and not child.is_symlink():
   887	            continue
   888	        targets.append(
   889	            _MaterializationTarget(
   890	                target_class="80-removal",
   891	                identifier=f"{identifier_prefix}/{child.name}",
   892	                live_path=child,
   893	                kind="entry",
   894	            )
   895	        )
   896	    return targets
