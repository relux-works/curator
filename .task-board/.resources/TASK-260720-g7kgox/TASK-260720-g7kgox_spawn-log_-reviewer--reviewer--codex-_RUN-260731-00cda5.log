   988	def _build_private_misses(
   989	    config: GlobalConfig,
   990	    nodes: list[closure.ClosureNode],
   991	    providers: tuple[build_planner.BuildProvider, ...],
   992	    plans: tuple[build_planner.BuildPlan, ...],
   993	    operator_search_path: build_toolchain.OperatorSearchPath,
   994	    cache_backend: build_cache.BuildCacheBackend,
   995	    stack: ExitStack,
   996	    *,
   997	    operation_roots: tuple[Path, ...],
   998	) -> dict[str, build_cache.CachePublication]:
   999	    candidates = [
  1000	        plan
  1001	        for plan in plans
  1002	        if plan.inspection.status is not build_cache.CacheEntryStatus.HIT
  1003	    ]
  1004	    for plan in candidates:
  1005	        if plan.inspection.status is build_cache.CacheEntryStatus.UNSUPPORTED:
  1006	            raise InstallError(
  1007	                f"{plan.driver} cache is unavailable: "
  1008	                f"{plan.inspection.reason}"
  1009	            )
  1010	    if not candidates:
  1011	        return {}
  1012	
  1013	    private_base = Path(
  1014	        stack.enter_context(
  1015	            tempfile.TemporaryDirectory(prefix="csk-build-operation-")
  1016	        )
  1017	    )
  1018	    forbidden = tuple(
  1019	        path
  1020	        for path in (
  1021	            config.path.parent,
  1022	            *operation_roots,
  1023	            config.skills_root,
  1024	            *(node.repo for node in nodes),
  1025	            *(provider.snapshot.path for provider in providers),
  1026	        )
  1027	        if path.exists()
  1028	    )
  1029	    session = stack.enter_context(
  1030	        build_toolchain.establish_toolchain(
  1031	            build_toolchain.ToolchainConfig(
  1032	                private_base=private_base,
  1033	                operator_search_path=operator_search_path,
  1034	                forbidden_roots=forbidden,
  1035	            )
  1036	        )
  1037	    )
  1038	    for plan in plans:
  1039	        if (
  1040	            session.target != plan.input.target
  1041	            or session.toolchain != plan.input.toolchain
  1042	        ):
  1043	            raise _concurrent_state_change(
  1044	                "the selected Go toolchain changed between planning and build"
  1045	            )
  1046	
  1047	    providers_by_name = {provider.name: provider for provider in providers}
  1048	    publications: dict[str, build_cache.CachePublication] = {}
  1049	    for plan in candidates:
  1050	        provider = providers_by_name.get(plan.provider)
  1051	        if provider is None:
  1052	            raise _concurrent_state_change(
  1053	                f"build provider disappeared before build: {plan.provider}"
  1054	            )
  1055	        with locking.BuildLock(config.path.parent, plan.cache_key):
  1056	            inspection = cache_backend.inspect(
  1057	                build_cache.CacheExpectation(input=plan.input)
  1058	            )
  1059	            if inspection.status is build_cache.CacheEntryStatus.HIT:
  1060	                continue
  1061	            if inspection.status is build_cache.CacheEntryStatus.UNSUPPORTED:
  1062	                raise InstallError(
  1063	                    f"{plan.driver} cache is unavailable: "
  1064	                    f"{inspection.reason}"
  1065	                )
  1066	            command = next(
  1067	                (
  1068	                    candidate
  1069	                    for candidate in provider.commands
  1070	                    if candidate.name == plan.command
  1071	                ),
  1072	                None,
  1073	            )
  1074	            if command is None:
  1075	                raise _concurrent_state_change(
  1270	            config,
  1271	            project,
  1272	            options,
  1273	            nodes=nodes,
  1274	            hybrid_decls=hybrid_decls,
  1275	            hybrid_store_names=hybrid_store_names,
  1276	            agents=agents,
  1277	            effective_locale=effective_locale,
  1278	            mcp_found=mcp_found,
  1279	            registry_attest=registry_attest,
  1280	            published_builds=published_builds,
  1281	            materialization_targets=materialization_targets,
  1282	            adapter_targets=adapter_targets,
  1283	        )
  1284	        _commit_transaction_targets(
  1285	            transaction_prefix="install",
  1286	            project_identity=locking.canonical_project_identity(
  1287	                project.path
