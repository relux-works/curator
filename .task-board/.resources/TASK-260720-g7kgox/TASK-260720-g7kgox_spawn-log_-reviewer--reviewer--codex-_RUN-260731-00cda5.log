         if target.exists() or target.is_symlink():
             _remove_path(target)
         shutil.copytree(source, target, symlinks=True)
         return
     if mode == "symlink":
         if target.exists() or target.is_symlink():
             _remove_path(target)
         target.symlink_to(os.path.relpath(source, target.parent), target_is_directory=True)
         return
