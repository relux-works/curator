   342	def _path_contains(paths: list[Path], candidate: Path) -> bool:
   343	    candidate_resolved = _resolve_for_compare(candidate)
   344	    return any(_resolve_for_compare(path) == candidate_resolved for path in paths)
   345	
   346	
   347	def _resolve_for_compare(path: Path) -> Path:
   348	    try:
   349	        return path.resolve()
   350	    except OSError:
   351	        return path.absolute()
   352	
   353	
   354	def _is_safe_home_bin(path: Path, *, home: Path, csk_home: Path) -> bool:
   355	    if _is_disallowed_bin(path, csk_home=csk_home):
   356	        return False
   357	    try:
   358	        path.resolve().relative_to(home.resolve())
   359	    except ValueError:
   360	        return False
   361	    return path.exists() and os.access(path, os.W_OK)
   362	
   363	
   364	def _is_writable_or_creatable(path: Path) -> bool:
   365	    if path.exists():
   366	        return path.is_dir() and os.access(path, os.W_OK)
   367	    parent = path.parent
   368	    while not parent.exists() and parent != parent.parent:
   369	        parent = parent.parent
   370	    return parent.exists() and os.access(parent, os.W_OK)
   371	
   372	
   373	def _is_disallowed_bin(path: Path, *, csk_home: Path) -> bool:
   374	    resolved = _resolve_for_compare(path)
   375	    canonical_global_bin = _resolve_for_compare(csk_home / "global" / "bin")
   376	    if resolved == canonical_global_bin:
   377	        return True
   378	    parts = set(resolved.parts)
   379	    if ".agents" in parts or ".cocoaskills" in parts:
   380	        return True
   381	    if ".venv" in parts or "venv" in parts or "venvs" in parts:
   382	        return True
   383	    if "mise" in parts and ("installs" in parts or "shims" in parts):
   384	        return True
   385	    return path.name == "shims" and bool(
   386	        {".asdf", ".pyenv", ".rbenv"} & parts
   387	    )
