   228	
   229	def _plan_adapter_targets(
   230	    adapter_roots: dict[str, Path],
   231	    groups: list[AdapterGroup],
   232	) -> tuple[AdapterTarget, ...]:
   233	    expected = {
   234	        name
   235	        for group in groups
   236	        for name in group.skill_names
   237	    }
   238	    roots = {
   239	        str(root.absolute()): root
   240	        for root in adapter_roots.values()
   241	    }
   242	    targets: list[AdapterTarget] = []
   243	    for root_identity in sorted(roots):
   244	        adapter_root = roots[root_identity]
   245	        root_key = hashlib.sha256(
   246	            str(adapter_root.absolute()).encode("utf-8")
   247	        ).hexdigest()
   248	        managed = _read_managed(adapter_root)
   249	        for name in sorted(managed - expected):
   250	            live = adapter_root / name
   251	            if not live.exists() and not live.is_symlink():
   252	                continue
   253	            targets.append(
   254	                AdapterTarget(
   255	                    target_class="80-removal",
   256	                    identifier=f"adapter/{root_key}/{name}",
   257	                    live_path=live,
   258	                    kind="entry",
   259	                    desired_kind="remove",
   260	                    skill_name=name,
   261	                )
   262	            )
   263	        for group in groups:
   264	            for name in sorted(group.skill_names):
   265	                canonical = group.canonical_root / name
   266	                live = adapter_root / name
   267	                if _is_unmanaged_conflict(live, managed, canonical):
   268	                    raise AdapterError(
   269	                        "Adapter target already exists and is not managed by "
   270	                        f"csk: {live}"
   271	                    )
   272	                targets.append(
   273	                    AdapterTarget(
   274	                        target_class="60-adapter-ledger",
   275	                        identifier=f"{root_key}/entry/{name}",
   276	                        live_path=live,
   277	                        kind="entry",
   278	                        desired_kind="mirror",
   279	                        skill_name=name,
   280	                        canonical_root=group.canonical_root,
   281	                    )
   282	                )
   283	        targets.append(
   284	            AdapterTarget(
   285	                target_class="60-adapter-ledger",
   286	                identifier=f"{root_key}/ledger",
   287	                live_path=adapter_root / MANAGED_FILE,
   288	                kind="bytes",
   289	                desired_kind="ledger",
   290	                expected_entries=tuple(sorted(expected)),
   291	            )
   292	        )
   293	    return tuple(targets)
   294	
   295	
   296	def stage_project_adapter_targets(
   297	    stage_root: Path,
   298	    targets: tuple[AdapterTarget, ...],
   299	    *,
   300	    source_roots: dict[Path, Path],
   301	    mode: str,
   302	) -> dict[tuple[str, str], Path | None]:
   303	    desired: dict[tuple[str, str], Path | None] = {}
   304	    for index, target in enumerate(targets):
   305	        key = (target.target_class, target.identifier)
   306	        if target.desired_kind == "remove":
   307	            desired[key] = None
   308	            continue
   309	        staged = stage_root / f"{index:04d}"
   310	        staged.parent.mkdir(parents=True, exist_ok=True)
   311	        if target.desired_kind == "ledger":
   312	            staged.write_text(
   313	                json.dumps(
   314	                    {
   315	                        "schema_version": SCHEMA_VERSION,
   316	                        "entries": list(target.expected_entries),
   317	                    },
   318	                    indent=2,
   319	                    sort_keys=True,
   320	                )
   321	                + "\n",
   322	                encoding="utf-8",
   323	            )
   324	            desired[key] = staged
   325	            continue
   326	        if (
   327	            target.desired_kind != "mirror"
   328	            or target.skill_name is None
   329	            or target.canonical_root is None
   330	        ):
   331	            raise AdapterError(
   332	                f"invalid staged adapter target: {target.identifier}"
   333	            )
   334	        source_root = source_roots.get(target.canonical_root)
   335	        if source_root is None:
   336	            raise AdapterError(
   337	                f"adapter source root was not staged: "
   338	                f"{target.canonical_root}"
   339	            )
   340	        source = source_root / target.skill_name
   341	        if not source.exists():
   342	            raise AdapterError(
   343	                f"adapter source was not staged: {source}"
   344	            )
   345	        canonical = target.canonical_root / target.skill_name
   346	        selected_mode = mode
   347	        if mode == "auto":
   348	            selected_mode = (
   349	                "symlink"
   350	                if _transaction_links_supported(stage_root, target.live_path)
   351	                else "copy"
   352	            )
   353	        if selected_mode == "symlink":
   354	            staged.symlink_to(
   355	                os.path.relpath(canonical, target.live_path.parent),
   356	                target_is_directory=True,
   357	            )
   358	        else:
   359	            shutil.copytree(source, staged, symlinks=True)
   360	        desired[key] = staged
   361	    return desired
   362	
   363	
   364	def _transaction_links_supported(stage_root: Path, live_path: Path) -> bool:
   365	    live_directory = _nearest_existing_directory(live_path.parent)
   366	    try:
   367	        same_device = _device_id(stage_root) == _device_id(live_directory)
   368	    except OSError:
   369	        return False
   370	    # Auto mode must not probe by writing into the live project before the
   371	    # transaction commits. A successful probe on the same filesystem is the
   372	    # capability witness; otherwise the staged adapter safely falls back to a
   373	    # copy. Explicit symlink mode remains explicit.
   374	    return same_device and _link_probe(stage_root)
   375	
   376	
   377	def _device_id(path: Path) -> int:
   378	    return path.stat().st_dev
   379	
   380	
   381	def _nearest_existing_directory(path: Path) -> Path:
   382	    current = path
   383	    while True:
   384	        try:
   385	            current.lstat()
   386	        except FileNotFoundError:
   387	            parent = current.parent
   388	            if parent == current:
   389	                return current
   390	            current = parent
   391	            continue
   392	        if current.is_symlink() or not current.is_dir():
   393	            return current.parent
   394	        return current
   395	
   396	
   397	def _link_probe(directory: Path) -> bool:
   398	    if not directory.exists() or directory.is_symlink():
   399	        return False
   400	    probe = directory / f".csk-symlink-probe-{os.getpid()}"
   401	    try:
   402	        probe.unlink(missing_ok=True)
   403	        # Adapter entries are always directory links, and Windows treats a
   404	        # directory link as a distinct object type, so the probe has to create
   405	        # the same kind of link the adapter will.
   406	        probe.symlink_to(".", target_is_directory=True)
   407	        probe.unlink()
   408	    except OSError:
   409	        try:
   410	            probe.unlink(missing_ok=True)
   411	        except OSError:
   412	            pass
   413	        return False
   414	    return True
   415	
   416	
   417	def _remove_path(path: Path) -> None:
   418	    if path.is_symlink() or path.is_file():
   419	        path.unlink()
   420	    elif path.exists():
   421	        shutil.rmtree(path)
   422	
   423	
   424	def _read_managed(adapter_root: Path) -> set[str]:
   425	    path = adapter_root / MANAGED_FILE
   426	    if not path.exists():
   427	        return set()
   428	    try:
   429	        data = protocol_json.loads(path.read_bytes())
   430	    except (OSError, protocol_json.ProtocolJSONError):
   431	        return set()
   432	    if (
   433	        not isinstance(data, dict)
   434	        or set(data) != {"schema_version", "entries"}
   435	        or data.get("schema_version") != SCHEMA_VERSION
   436	    ):
   437	        return set()
   438	    entries = data["entries"]
   439	    if (
   440	        not isinstance(entries, list)
   441	        or any(not isinstance(entry, str) or not is_valid_identifier(entry) for entry in entries)
   442	        or len(entries) != len(set(entries))
   443	    ):
   444	        return set()
   445	    return set(entries)
   446	
   447	
   448	def _write_managed(adapter_root: Path, entries: set[str]) -> None:
   449	    path = adapter_root / MANAGED_FILE
   450	    data = {"schema_version": SCHEMA_VERSION, "entries": sorted(entries)}
   451	    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
   452	
   453	
   454	def _is_unmanaged_conflict(target: Path, managed: set[str], source: Path) -> bool:
   455	    if not target.exists() and not target.is_symlink():
   456	        return False
   457	    if target.name in managed:
   458	        return False
   459	    if target.is_symlink():
   460	        try:
   461	            return target.resolve() != source.resolve()
   462	        except OSError:
   463	            return True
   464	    return not (target / ".csk-install.json").exists()
