   154	def install(config: GlobalConfig, *, options: installer.InstallOptions | None = None) -> GlobalResult:
   155	    options = options or installer.InstallOptions()
   156	    operator_search_path = build_toolchain.capture_operator_search_path()
   157	    generation_probe = _global_generation_probe(config)
   158	    csk_home = config.path.parent
   159	    attempts = 2 if options.dry_run else 3
   160	    operation_lock = (
   161	        ExitStack()
   162	        if options.dry_run
   163	        else locking.ProjectLock(csk_home, global_root(csk_home))
   164	    )
   165	    with operation_lock:
   166	        if not options.dry_run:
   167	            try:
   168	                with locking.ManagerHomeLock(csk_home) as home_lock:
   169	                    _transaction_engine(csk_home).recover(home_lock)
   170	            except transactions.TransactionError as exc:
   171	                return GlobalResult(status="failed", errors=[str(exc)])
   172	        for attempt in range(attempts):
   173	            try:
   174	                expected_generation = generation_probe.capture()
   175	                result = _install_once(
   176	                    config,
   177	                    options=options,
   178	                    operator_search_path=operator_search_path,
   179	                    generation_probe=generation_probe,
   180	                    expected_generation=expected_generation,
   181	                )
   182	                break
   183	            except build_planner.BuildPlanningError as exc:
   184	                if (
   185	                    exc.code == "concurrent_state_change"
   186	                    and attempt + 1 < attempts
   187	                ):
   188	                    continue
   189	                result = GlobalResult(
   190	                    status="failed",
   191	                    errors=[str(exc)],
   192	                )
   193	                break
   194	        else:
   195	            raise AssertionError("unreachable global planning retry state")
   196	
   197	    if not options.dry_run and not result.failed:
   198	        try:
   199	            with locking.ManagerHomeLock(csk_home):
   200	                gc.collect_runtime(config, csk_home)
   201	        except locking.LockOrderError:
   202	            raise
   203	        except locking.LockError as exc:
   204	            result.messages.append(
   205	                f"global: post-install garbage collection skipped: {exc}"
   206	            )
   207	    return result
   208	
   209	
   210	def _transaction_engine(csk_home: Path) -> transactions.TransactionEngine:
   211	    return transactions.TransactionEngine(csk_home)
   212	
   213	
   214	def _install_once(
   215	    config: GlobalConfig,
   216	    *,
   217	    options: installer.InstallOptions,
   218	    operator_search_path: build_toolchain.OperatorSearchPath,
   219	    generation_probe: build_planner.GenerationProbe,
   220	    expected_generation: Mapping[str, str],
   221	) -> GlobalResult:
   222	    result = GlobalResult()
   223	    csk_home = config.path.parent
   224	    try:
   225	        global_manifest = load_manifest(csk_home)
   226	        agents = global_manifest.agents or config.default_agents
   227	        effective_locale = global_manifest.locale or config.preferred_locale
   228	        with ExitStack() as stack:
   229	            nodes = _build_nodes(
   230	                config,
   231	                global_manifest,
   232	                options=options,
   233	                stack=stack,
   234	                result=result,
   235	            )
   236	            plans = [
   237	                installer.SkillPlan(
   238	                    decl=node.decl,
   239	                    resolved=node.resolved,
   240	                    repo=node.repo,
   241	                    snapshot=node.snapshot,
   242	                    spec=node.spec,
   243	                )
   244	                for node in nodes
   245	            ]
   246	            validation_issues = installer._validate_skills(
   247	                plans,
   248	                effective_locale,
   249	            )
   250	            result.messages.extend(
   251	                installer._skill_validation_warnings(
   252	                    "global",
   253	                    validation_issues,
   254	                )
   255	            )
   256	            installer._check_skill_validation_errors(validation_issues)
   257	            build_providers = installer._freeze_build_providers(nodes, stack)
   258	            closure.detect_active_command_collisions(nodes)
   259	            build_planner.detect_command_collisions(
   260	                build_providers,
   261	                occupied=installer._active_script_owners(nodes),
   262	            )
   263	            plans = _plans_with_available_dependencies(plans, result)
   264	            if result.errors:
   265	                result.status = "failed"
   266	                _recheck_generation(generation_probe, expected_generation)
   267	                return result
   268	
   269	            mcp_found, mcp_warnings = installer._check_mcp_servers(
   270	                plans,
   271	                global_root(csk_home),
   272	                agents,
   273	                alias="global",
   274	            )
   275	            result.messages.extend(mcp_warnings)
   276	            result.messages.extend(
   277	                installer._migration_warnings("global", plans)
   278	            )
   279	            audit_gate = audit_pipeline.gate_plans(
   280	                plans,
   281	                config,
   282	                scope="global",
   283	                record=not options.dry_run,
   284	            )
   285	            result.messages.extend(audit_gate.warnings)
   286	            if audit_gate.blocked:
   287	                result.status = "failed"
   288	                result.errors.extend(audit_gate.errors)
   289	                return result
   290	            registry_attest = installer._check_audit_registries(
   291	                plans,
   292	                config,
   293	                result,
   294	                alias="global",
   295	                read_only=options.dry_run,
   296	            )
   297	            if not options.dry_run and (
   298	                config.audit.enabled or config.trusted_registries()
   299	            ):
   300	                expected_generation = installer._generation_after_gate_writes(
   301	                    config,
   302	                    generation_probe,
   303	                    expected_generation,
   304	                )
   305	            if options.strict_tags:
   306	                installer._check_moved_tags_strict(global_skills_root(csk_home), plans)
   307	            else:
   308	                for warning in installer._moved_tag_warnings(global_skills_root(csk_home), plans):
   309	                    result.messages.append(f"global: {warning}")
   310	
   311	            cache_backend = build_cache.cache_for_manager_home(csk_home)
   312	            result.builds.extend(
   313	                build_planner.plan_builds(
   314	                    build_providers,
   315	                    manager_home=csk_home,
   316	                    operator_search_path=operator_search_path,
   317	                    forbidden_roots=(
   318	                        global_root(csk_home),
   319	                        config.skills_root,
   320	                        *(node.repo for node in nodes),
   321	                    ),
   322	                    cache_backend=cache_backend,
   323	                    generation_probe=generation_probe,
   324	                    expected_generation=expected_generation,
   325	                    max_generation_attempts=1,
   326	                )
   327	            )
   328	            if options.dry_run:
   329	                for build in result.builds:
   330	                    payload = json.dumps(
   331	                        build.to_json(),
   332	                        sort_keys=True,
   333	                        separators=(",", ":"),
   334	                    )
   335	                    result.messages.append(f"global: build {payload}")
   336	                for node in nodes:
   337	                    result.messages.append(
   338	                        f"global: {installer._node_summary(node)} (planned)"
   339	                    )
   340	                result.messages.append("global: dry-run; no files modified")
   341	                return result
   342	
   343	            (
   344	                materialization_targets,
   345	                adapter_targets,
   346	                user_bin_targets,
   347	                publication_messages,
   348	            ) = _global_materialization_targets(
   349	                config,
   350	                nodes,
   351	                agents,
   352	            )
   353	            target_preimages = installer._capture_target_preimages(
   354	                materialization_targets
   355	            )
   356	            private_builds = installer._build_private_misses(
   357	                config,
   358	                nodes,
   359	                build_providers,
   360	                tuple(result.builds),
   361	                operator_search_path,
   362	                cache_backend,
   363	                stack,
   364	                operation_roots=(global_root(csk_home),),
   365	            )
   366	
   367	            with locking.ManagerHomeLock(csk_home) as home_lock:
   368	                engine = _transaction_engine(csk_home)
   369	                engine.recover(home_lock)
   370	                installer._assert_generation_current(
   371	                    generation_probe,
   372	                    expected_generation,
   373	                    scope="global",
   374	                )
   375	                installer._assert_target_preimages_current(
   376	                    materialization_targets,
   377	                    target_preimages,
   378	                )
   379	                installer._revalidate_closure(nodes, build_providers)
   380	                published = installer._publish_planned_builds(
   381	                    csk_home,
   382	                    tuple(result.builds),
   383	                    private_builds,
   384	                    cache_backend,
   385	                    home_lock,
   386	                )
   387	                messages = _commit_global_materialization(
   388	                    config,
   389	                    options,
   390	                    nodes=nodes,
   391	                    agents=agents,
   392	                    effective_locale=effective_locale,
   393	                    mcp_found=mcp_found,
   394	                    registry_attest=registry_attest,
   395	                    published_builds=published,
   396	                    materialization_targets=materialization_targets,
   397	                    adapter_targets=adapter_targets,
   398	                    user_bin_targets=user_bin_targets,
   399	                    target_preimages=target_preimages,
   400	                    expected_generation=expected_generation,
   401	                    engine=engine,
   402	                    home_lock=home_lock,
   403	                )
   404	            result.messages.extend(messages)
   405	            result.messages.extend(publication_messages)
   406	            return result
   407	    except build_planner.BuildPlanningError as exc:
   408	        if exc.code == "concurrent_state_change":
   409	            raise
   410	        result.status = "failed"
   411	        result.errors.append(str(exc))
   412	        return result
   413	    except Exception as exc:  # noqa: BLE001 - global boundary reports stable failures
   414	        result.status = "failed"
   415	        result.errors.append(str(exc))
   416	        return result
