   907	def _runtime_references_for_plan(
   908	    config: GlobalConfig,
   909	    project_root: Path,
   910	    nodes: list[closure.ClosureNode],
   911	    retained_hybrid_names: set[str],
   912	) -> set[tuple[str, str]]:
   913	    references = {
   914	        (node.name, node.resolved.commit)
   915	        for node in nodes
   916	    }
   917	    references.update(
   918	        _marker_references(
   919	            config.path.parent / "global" / "skills"
   920	        )
   921	    )
   922	    references.update(
   923	        _marker_references(
   924	            hybrid.hybrid_skills_root(config.path.parent),
   925	            only=retained_hybrid_names,
   926	        )
   927	    )
   928	    current = project_root.resolve()
   929	    seen = {current}
   930	    for configured in config.projects.values():
   931	        resolved = configured.path.resolve()
   932	        if resolved in seen:
   933	            continue
   934	        seen.add(resolved)
   935	        references.update(
   936	            _marker_references(
   937	                resolved / ".agents" / "skills"
   938	            )
   939	        )
   940	    for consumer in consumers.load_consumers(config.path.parent):
   941	        resolved = consumer.resolve()
   942	        if resolved in seen or not resolved.exists():
   943	            continue
   944	        seen.add(resolved)
   945	        references.update(
   946	            _marker_references(
   947	                resolved / ".agents" / "skills"
   948	            )
   949	        )
   950	    return references
