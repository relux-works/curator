   165	class TransactionEngine:
   166	    """Durable generic replacement transactions under a caller-held home lock."""
   167	
   168	    def __init__(self, csk_home: Path, *, fault_hook: FaultHook | None = None):
   169	        self.home = csk_home.expanduser().resolve(strict=False)
   170	        self.journal_root = self.home / "state" / "transactions" / "v1"
   171	        self._fault_hook = fault_hook
   172	        self._mutex = threading.Lock()
   173	        self._active_witness: HomeLockWitness | None = None
   174	        self._active_home_identity: str | None = None
   175	
   176	    def prepare(self, lock: HomeLockWitness, plan: TransactionPlan) -> Journal:
   177	        lock.assert_held()
   178	        with self._mutex, self._witness_scope(lock):
   179	            journal, sources = self._build_journal(plan)
   180	            path = self._journal_path(journal.transaction_id)
   181	            if path.exists():
   182	                raise TransactionError(
   183	                    f"transaction already exists: {journal.transaction_id}"
   184	                )
   185	            self._save_journal(journal, create=True)
   186	            try:
   187	                for target_index, (target, source) in enumerate(
   188	                    zip(journal.targets, sources, strict=True)
   189	                ):
   190	                    if source is None:
   191	                        continue
   192	                    assert target.staged_path is not None
   193	                    self._stage_target(journal, target_index, source)
   194	                    if (
   195	                        _target_digest(target, Path(target.staged_path))
   196	                        != target.desired_digest
   197	                    ):
   198	                        raise TransactionCorruptionError(
   199	                            f"staged target changed while preparing: {target.target_class}/{target.identifier}"
   200	                        )
   201	                for target in journal.targets:
   202	                    target.staged_source = None
   203	                    target.staging_entries = []
   204	                    target.staging_index = 0
   205	                    target.staging_finalize_index = 0
   206	                    target.staging_finalize_active = False
   207	                    self._clear_staging_progress(target)
   208	                journal.phase = "prepared"
   209	                self._save_journal(journal)
   210	                self._emit("prepared", None)
   211	                return _clone_journal(journal)
   212	            except Exception:
   213	                self._discard_prepared(journal)
   214	                raise
   215	
   216	    def _stage_target(
   217	        self,
   218	        journal: Journal,
   219	        target_index: int,
   220	        source: Path,
   221	    ) -> None:
   222	        target = journal.targets[target_index]
   223	        if target.staged_path is None or target.staged_source != str(source):
   224	            raise TransactionCorruptionError(
   225	                f"staging source is inconsistent: {target.target_class}/{target.identifier}"
   226	            )
   227	        staged = Path(target.staged_path)
   228	        while target.staging_index < len(target.staging_entries):
   229	            entry = target.staging_entries[target.staging_index]
   230	            target.staging_active = True
   231	            target.staging_created = False
   232	            target.staging_bytes = 0
   233	            target.staging_prefix_digest = None
   234	            target.staging_write_bytes = 0
   235	            target.staging_write_digest = None
   236	            self._save_journal(journal)
   237	            self._emit("before_staging_entry_create", target)
   238	            self._create_staging_entry(source, staged, entry)
   239	            target.staging_created = True
   240	            self._save_journal(journal)
   241	            self._emit("staging_entry_created", target)
   242	            if entry.kind == "file":
   243	                self._copy_staging_file(journal, target, source, staged, entry)
   244	            destination = _staging_entry_path(staged, entry.relative_path)
   245	            _validate_staging_entry_modes(
   246	                destination,
   247	                entry,
   248	                {_staging_construction_mode(entry)},
   249	            )
   250	            target.staging_index += 1
   251	            self._clear_staging_progress(target)
   252	            self._save_journal(journal)
   253	            self._emit("staging_entry_completed", target)
   254	        self._finalize_staging_modes(journal, target)
   255	
   256	    def _finalize_staging_modes(
   257	        self,
   258	        journal: Journal,
   259	        target: JournalTarget,
   260	    ) -> None:
   261	        if target.staged_path is None:
   262	            raise TransactionCorruptionError(
   263	                f"staging path is missing: {target.target_class}/{target.identifier}"
   264	            )
   265	        staged = Path(target.staged_path)
   266	        order = [
   267	            entry for entry in reversed(target.staging_entries) if entry.kind != "link"
   268	        ]
   269	        while target.staging_finalize_index < len(order):
   270	            entry = order[target.staging_finalize_index]
   271	            destination = _staging_entry_path(staged, entry.relative_path)
   272	            target.staging_finalize_active = True
   273	            self._save_journal(journal)
   274	            self._emit("before_staging_mode_finalize", target)
   275	            _validate_staging_entry_modes(
   276	                destination,
   277	                entry,
   278	                {_staging_construction_mode(entry), entry.mode},
   279	            )
   280	            _set_entry_mode_durably(destination, entry, entry.mode)
   281	            _validate_staging_entry(destination, entry)
   282	            self._emit("staging_mode_finalized", target)
   283	            target.staging_finalize_index += 1
   284	            target.staging_finalize_active = False
   285	            self._save_journal(journal)
   286	            self._emit("staging_mode_finalize_completed", target)
