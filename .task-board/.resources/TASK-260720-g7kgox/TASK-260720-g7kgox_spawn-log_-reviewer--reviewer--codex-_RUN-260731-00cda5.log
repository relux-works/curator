     6	def write_env_files(project_root: Path) -> None:
     7	    agents_dir = project_root / ".agents"
     8	    agents_dir.mkdir(parents=True, exist_ok=True)
     9	    env_sh = agents_dir / "env.sh"
    10	    env_ps1 = agents_dir / "env.ps1"
    11	    # The script locates itself under bash (BASH_SOURCE), zsh (prompt %N
    12	    # expansion), and falls back to $0 elsewhere; zsh leaves BASH_SOURCE unset,
    13	    # which previously resolved the project root from the caller's CWD.
    14	    env_sh.write_text(
    15	        "# Generated by CocoaSkill. Do not edit.\n"
    16	        "if [ -n \"${BASH_SOURCE:-}\" ]; then\n"
    17	        "  _csk_env_path=\"${BASH_SOURCE[0]}\"\n"
    18	        "elif [ -n \"${ZSH_VERSION:-}\" ]; then\n"
    19	        "  _csk_env_path=\"${(%):-%N}\"\n"
    20	        "else\n"
    21	        "  _csk_env_path=\"$0\"\n"
    22	        "fi\n"
    23	        "CSK_PROJECT_ROOT=\"$(cd \"$(dirname \"$_csk_env_path\")/..\" && pwd)\"\n"
    24	        "unset _csk_env_path\n"
    25	        "export CSK_PROJECT_ROOT\n"
    26	        "export PATH=\"$CSK_PROJECT_ROOT/.agents/bin:$PATH\"\n",
    27	        encoding="utf-8",
    28	    )
    29	    env_ps1.write_text(
    30	        "# Generated by CocoaSkill. Do not edit.\n"
    31	        "$CskAgentsDir = Split-Path -Parent $MyInvocation.MyCommand.Path\n"
    32	        "$CskProjectRoot = Split-Path -Parent $CskAgentsDir\n"
    33	        "$env:CSK_PROJECT_ROOT = $CskProjectRoot\n"
    34	        "$env:PATH = \"$CskProjectRoot\\.agents\\bin;$env:PATH\"\n",
    35	        encoding="utf-8",
    36	    )
    37	
    38	
