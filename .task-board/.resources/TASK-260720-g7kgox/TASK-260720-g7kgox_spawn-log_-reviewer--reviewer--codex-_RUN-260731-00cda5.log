   215	def _tree_state(roots: tuple[Path, ...]) -> dict[str, tuple[object, ...]]:
   216	    state: dict[str, tuple[object, ...]] = {}
   217	    for root in roots:
   218	        key = str(root)
   219	        if not root.exists() and not root.is_symlink():
   220	            state[key] = ("missing",)
   221	            continue
   222	        for path in (root, *root.rglob("*")):
   223	            info = path.lstat()
   224	            relative = "." if path == root else path.relative_to(root).as_posix()
   225	            if stat.S_ISREG(info.st_mode):
   226	                value: object = path.read_bytes()
   227	                kind = "file"
   228	            elif stat.S_ISLNK(info.st_mode):
   229	                value = os.readlink(path)
   230	                kind = "link"
   231	            elif stat.S_ISDIR(info.st_mode):
   232	                value = None
   233	                kind = "directory"
   234	            else:
   235	                value = None
   236	                kind = "special"
   237	            state[f"{key}:{relative}"] = (
   238	                kind,
   239	                stat.S_IMODE(info.st_mode),
   240	                value,
   241	            )
   242	    return state
