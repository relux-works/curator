   189	def plan_project_adapter_targets(
   190	    project_root: Path,
   191	    agents: list[str],
   192	    groups: list[AdapterGroup],
   193	) -> tuple[AdapterTarget, ...]:
   194	    roots = {
   195	        agent: project_root / relative
   196	        for agent, relative in AGENT_PATHS.items()
   197	        if agent in agents
