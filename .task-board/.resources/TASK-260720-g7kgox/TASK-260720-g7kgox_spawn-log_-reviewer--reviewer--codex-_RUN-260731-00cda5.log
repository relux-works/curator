   900	def update(config: GlobalConfig) -> GlobalResult:
   901	    result = GlobalResult()
   902	    try:
   903	        global_manifest = load_manifest(config.path.parent)
   904	        for decl in global_manifest.skills:
   905	            try:
   906	                repo = installer._ensure_skill_repo(config, decl, use_persistent_clone=True, stack=None)
   907	                git_ops.fetch_repo(repo)
   908	                result.messages.append(f"fetched {decl.source}")
   909	            except Exception as exc:  # noqa: BLE001 - report every per-source fetch failure
   910	                result.errors.append(f"fetch failed {decl.source}: {exc}")
   911	        return result
   912	    except Exception as exc:  # noqa: BLE001 - global update boundary reports failures
   913	        result.status = "failed"
   914	        result.errors.append(str(exc))
   915	        return result
