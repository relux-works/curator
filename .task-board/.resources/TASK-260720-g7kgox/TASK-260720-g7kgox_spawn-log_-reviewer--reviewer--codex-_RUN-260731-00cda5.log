   424	        elif journal.phase in {"prepared", "committing"}:
   425	            self._commit_journal(journal)
   426	        elif journal.phase == "cleanup":
   427	            self._cleanup_committed(journal)
   428	        elif journal.phase == "rolling_back":
   429	            self._rollback(journal)
   430	        else:
   431	            raise TransactionCorruptionError(
   432	                f"unsupported journal phase: {journal.phase}"
   433	            )
