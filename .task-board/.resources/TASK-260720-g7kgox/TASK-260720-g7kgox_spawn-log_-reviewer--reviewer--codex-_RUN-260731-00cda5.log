   418	
   419	def _global_materialization_targets(
   420	    config: GlobalConfig,
   421	    nodes: list[closure.ClosureNode],
   422	    agents: list[str],
   423	) -> tuple[
   424	    tuple[installer._MaterializationTarget, ...],
   425	    tuple[adapters.AdapterTarget, ...],
   426	    tuple[global_bins.UserBinTarget, ...],
   427	    list[str],
   428	]:
   429	    adapters.warn_unknown_agents(agents)
   430	    csk_home = Path(os.path.abspath(config.path.parent))
   431	    skills_root = global_skills_root(csk_home)
   432	    runtime_root = csk_home / "runtime"
   433	    bin_dir = global_bin_dir(csk_home)
   434	    targets: list[installer._MaterializationTarget] = []
   435	    expected_names = {node.name for node in nodes}
   436	
   437	    for name in sorted(expected_names):
   438	        targets.append(
   439	            installer._MaterializationTarget(
   440	                target_class="10-context",
   441	                identifier=f"global/{name}",
   442	                live_path=skills_root / name,
   443	                kind="entry",
   444	            )
   445	        )
   446	    targets.extend(
   447	        installer._stale_entry_targets(
   448	            skills_root,
   449	            expected_names,
   450	            identifier_prefix="context/global",
   451	        )
   452	    )
   453	
   454	    for node in nodes:
   455	        if not node.active_commands():
   456	            continue
   457	        targets.append(
   458	            installer._MaterializationTarget(
   459	                target_class="20-runtime",
   460	                identifier=f"{node.name}/{node.resolved.commit}",
