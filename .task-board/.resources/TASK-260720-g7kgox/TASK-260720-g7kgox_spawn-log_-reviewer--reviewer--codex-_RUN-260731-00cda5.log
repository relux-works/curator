   107	def refresh_global_adapters(
   108	    csk_home: Path,
   109	    agents: list[str],
   110	    skill_names: list[str],
   111	    mode: str,
   112	    *,
   113	    home: Path | None = None,
   114	) -> None:
   115	    canonical_root = csk_home / "global" / "skills"
   116	    user_home = home or Path.home()
   117	    adapter_roots = {
   118	        agent: user_home / rel
   119	        for agent, rel in AGENT_PATHS.items()
   120	    }
   121	    for agent in NATIVE_DISCOVERY_AGENTS:
   122	        adapter_roots[agent] = user_home / NATIVE_DISCOVERY_HOME_PATH
