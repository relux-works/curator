   390	def _remove_managed_command(bin_dir: Path, command_name: str, *, platform_name: str) -> None:
   391	    path = shims.shim_path(bin_dir, command_name, platform_name=platform_name)
   392	    if path.exists() or path.is_symlink():
   393	        path.unlink()
