   389	    def recover(self, lock: HomeLockWitness) -> None:
   390	        """Recover every home journal, regardless of the initiating project."""
   391	        lock.assert_held()
   392	        with self._mutex, self._witness_scope(lock):
   393	            for transaction_id in self._journal_ids():
   394	                journal, deleting = self._load_journal_record(transaction_id)
   395	                try:
   396	                    if deleting:
   397	                        self._finish_journal_removal(journal)
   398	                    else:
   399	                        self._resume(journal)
   400	                except Exception as exc:
   401	                    raise TransactionError(
   402	                        f"recover transaction {transaction_id}: {exc}"
   403	                    ) from exc
   404	
   405	    def referenced_generation_digests(self, lock: HomeLockWitness) -> dict[str, str]:
   406	        lock.assert_held()
   407	        with self._mutex, self._witness_scope(lock):
   408	            result: dict[str, str] = {}
   409	            for transaction_id in self._journal_ids():
   410	                journal, deleting = self._load_journal_record(transaction_id)
   411	                if deleting:
   412	                    continue
   413	                for key, digest in journal.generation_digests.items():
   414	                    previous = result.setdefault(key, digest)
   415	                    if previous != digest:
   416	                        raise TransactionCorruptionError(
   417	                            f"generation {key!r} has conflicting journal digests"
   418	                        )
   419	            return dict(sorted(result.items(), key=lambda item: _utf8_key(item[0])))
