   568	def _global_runtime_references_for_plan(
   569	    config: GlobalConfig,
   570	    nodes: list[closure.ClosureNode],
   571	) -> set[tuple[str, str]]:
   572	    references = {
   573	        (node.name, node.resolved.commit) for node in nodes
   574	    }
   575	    csk_home = config.path.parent
   576	    references.update(
   577	        installer._marker_references(csk_home / "hybrid" / "skills")
   578	    )
   579	    seen_projects: set[Path] = set()
   580	    for configured in config.projects.values():
   581	        resolved = configured.path.resolve()
   582	        if resolved in seen_projects:
   583	            continue
   584	        seen_projects.add(resolved)
   585	        references.update(
   586	            installer._marker_references(
   587	                resolved / ".agents" / "skills"
   588	            )
   589	        )
   590	    for consumer in consumers.load_consumers(csk_home):
   591	        resolved = consumer.resolve()
   592	        if resolved in seen_projects or not resolved.exists():
   593	            continue
   594	        seen_projects.add(resolved)
   595	        references.update(
   596	            installer._marker_references(
   597	                resolved / ".agents" / "skills"
   598	            )
   599	        )
   600	    return references
