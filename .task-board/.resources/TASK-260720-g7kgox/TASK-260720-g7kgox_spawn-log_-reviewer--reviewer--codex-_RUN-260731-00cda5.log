   202	def plan_global_adapter_targets(
   203	    csk_home: Path,
   204	    agents: list[str],
   205	    skill_names: tuple[str, ...],
   206	    *,
   207	    home: Path | None = None,
   208	) -> tuple[AdapterTarget, ...]:
   209	    canonical_root = csk_home / "global" / "skills"
   210	    user_home = home or Path.home()
   211	    roots = {
   212	        agent: user_home / relative
   213	        for agent, relative in AGENT_PATHS.items()
   214	        if agent in agents
   215	    }
   216	    if any(agent in NATIVE_DISCOVERY_AGENTS for agent in agents):
   217	        roots["native"] = user_home / NATIVE_DISCOVERY_HOME_PATH
   218	    return _plan_adapter_targets(
   219	        roots,
   220	        [
