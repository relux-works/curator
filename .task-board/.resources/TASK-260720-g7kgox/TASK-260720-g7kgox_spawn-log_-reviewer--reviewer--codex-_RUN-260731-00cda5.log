   918	def render_status(config: GlobalConfig) -> str:
   919	    csk_home = config.path.parent
   920	    global_manifest = load_manifest(csk_home)
   921	    lines = [f"Global skills ({global_root(csk_home)})"]
   922	    if not global_manifest.skills:
   923	        lines.append("  no skills declared")
   924	        return "\n".join(lines)
   925	    for decl in global_manifest.skills:
   926	        skill_status = _skill_status(config, decl)
   927	        commit = (skill_status["installed_commit"] or "")[:7]
   928	        suffix = ""
   929	        if skill_status["label"] == "update-available" and skill_status["resolved_commit"]:
   930	            suffix = f" -> {skill_status['resolved_commit'][:7]}"
   931	        lines.append(
   932	            f"  {decl.name:<20} {decl.ref.kind:<8} {decl.ref.value:<12} {commit:<7}  {skill_status['label']}{suffix}"
   933	        )
   934	    return "\n".join(lines)
