   383	    def commit(self, lock: HomeLockWitness, transaction_id: str) -> None:
   384	        lock.assert_held()
   385	        with self._mutex, self._witness_scope(lock):
   386	            journal = self._load_journal(transaction_id)
   387	            self._resume(journal)
