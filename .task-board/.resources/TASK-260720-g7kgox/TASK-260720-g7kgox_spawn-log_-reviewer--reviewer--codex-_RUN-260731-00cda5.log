   286	def select_user_bin_with_warning(
   287	    csk_home: Path,
   288	    *,
   289	    env: dict[str, str] | None = None,
   290	    home: Path | None = None,
   291	) -> UserBinSelection:
   292	    env = env or dict(os.environ)
   293	    home = home or Path.home()
   294	    path_dirs = _path_dirs(env.get("PATH", ""))
   295	    explicit = env.get(USER_BIN_ENV)
   296	    if explicit:
   297	        explicit_path = Path(explicit).expanduser()
   298	        if _is_disallowed_bin(explicit_path, csk_home=csk_home):
   299	            return UserBinSelection(
   300	                None,
   301	                "global: command shims were installed in ~/.cocoaskills/global/bin, "
   302	                f"but {USER_BIN_ENV} points to a protected tool-manager or CocoaSkills directory: "
   303	                f"{explicit_path}; choose a normal user bin or use csk shell-init",
   304	            )
   305	        if not _is_writable_or_creatable(explicit_path):
   306	            return UserBinSelection(
   307	                None,
   308	                "global: command shims were installed in ~/.cocoaskills/global/bin, "
   309	                f"but {USER_BIN_ENV} is not writable: {explicit_path}; choose a writable PATH directory "
   310	                "or use csk shell-init",
   311	            )
   312	        return UserBinSelection(explicit_path)
   313	
   314	    preferred = [
   315	        home / ".local" / "bin",
   316	        home / "bin",
   317	    ]
   318	    for candidate in preferred:
   319	        if _path_contains(path_dirs, candidate):
   320	            return UserBinSelection(candidate)
   321	
   322	    csk_executable = shutil.which("csk", path=env.get("PATH"))
   323	    if csk_executable:
   324	        csk_bin = Path(csk_executable).expanduser().parent
   325	        if _is_safe_home_bin(csk_bin, home=home, csk_home=csk_home):
   326	            return UserBinSelection(csk_bin)
   327	
   328	    for candidate in path_dirs:
   329	        if _is_safe_home_bin(candidate, home=home, csk_home=csk_home):
   330	            return UserBinSelection(candidate)
   331	    return UserBinSelection(None)
