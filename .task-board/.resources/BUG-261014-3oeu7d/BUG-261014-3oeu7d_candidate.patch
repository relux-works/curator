-func TestMigratedGlobalSkillNetworkUndeclaredFollowUp(t *testing.T) {
+// Environments §9.4 through the production migration entry: a migrated
+// global skill passes the strict network check only when its own
+// agent-skill.json declares a host glob covering the detected host. The
+// covering case is the positive control; absent, "none" and non-covering
+// declarations must still refuse with the named remedy and publish nothing.
+func TestMigratedGlobalSkillNetworkCapabilities(t *testing.T) {
+	previous := hashing.EnableV2Writers
+	hashing.EnableV2Writers = true
+	t.Cleanup(func() { hashing.EnableV2Writers = previous })
+	for _, testCase := range []struct {
+		name     string
+		manifest string
+		admitted bool
+	}{
+		{name: "exact-host-declared", manifest: `{"schema_version": 3, "capabilities": {"network": ["downloads.example.com"]}}`, admitted: true},
+		{name: "glob-host-declared", manifest: `{"schema_version": 3, "capabilities": {"network": ["*.example.com"]}}`, admitted: true},
+		{name: "no-manifest"},
+		{name: "network-none", manifest: `{"schema_version": 3, "capabilities": {"network": "none"}}`},
+		{name: "other-host-declared", manifest: `{"schema_version": 3, "capabilities": {"network": ["api.example.org"]}}`},
+		{name: "pre-capabilities-schema", manifest: `{"schema_version": 2}`},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			files := map[string]string{
+				"README.md":        "network skill\n",
+				"assets/small.bin": "a\x00b",
+				"scripts/fetch.sh": "curl https://downloads.example.com/archive\n",
+			}
+			if testCase.manifest != "" {
+				files["agent-skill.json"] = testCase.manifest
+			}
+			home, commit := migrationRevisionFixture(t, files)
+			err := EnsureDefaultWithPolicy(home, Policy{})
+			if testCase.admitted {
+				if err != nil {
+					t.Fatalf("migration with a covering declaration: %v", err)
+				}
+				lock, _, err := readLock(home, DefaultProfile)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if member, ok := lock.Find(contextlock.KindSkill, "binary-skill"); !ok || member.Commit != commit {
+					t.Fatalf("migrated skill = %+v, present = %v", member, ok)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), DiagSourceInvalid) ||
+				!strings.Contains(err.Error(), `"binary-skill"`) ||
+				!strings.Contains(err.Error(), "audit.capability.network-undeclared") ||
+				!strings.Contains(err.Error(), "contacts downloads.example.com") ||
+				!strings.Contains(err.Error(), "scripts/fetch.sh") ||
+				!strings.Contains(err.Error(), "capabilities.network in the skill's agent-skill.json") {
+				t.Fatalf("migration = %v, want named network-undeclared refusal with remedy", err)
+			}
+			assertMigrationUnpublished(t, home)
+		})
+	}
+}
