+// A covering network declaration widens only the network check: a second,
+// undeclared neighbouring host, a revoked source and a failed static canary
+// each still refuse the migration and publish nothing.
+func TestMigratedGlobalSkillDeclarationKeepsOtherGates(t *testing.T) {
+	previous := hashing.EnableV2Writers
+	hashing.EnableV2Writers = true
+	t.Cleanup(func() { hashing.EnableV2Writers = previous })
+	declared := `{"schema_version": 3, "capabilities": {"network": ["downloads.example.com"]}}`
+	for _, testCase := range []struct {
+		name   string
+		fetch  string
+		policy Policy
+		canary bool
+		want   string
+	}{
+		{name: "neighbouring-host", fetch: "curl https://downloads.example.com/a\ncurl https://uploads.example.com/b\n",
+			canary: true, want: "contacts uploads.example.com"},
+		{name: "revoked-source", fetch: "curl https://downloads.example.com/a\n",
+			policy: Policy{Revocations: []string{"source:example.com/skills/binary-skill"}}, canary: true, want: "revoked"},
+		{name: "canary-failure", fetch: "curl https://downloads.example.com/a\n", want: "canary"},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			if !testCase.canary {
+				previousCanary := canaryPasses
+				canaryPasses = func() bool { return false }
+				t.Cleanup(func() { canaryPasses = previousCanary })
+			}
+			home, _ := migrationRevisionFixture(t, map[string]string{
+				"README.md":        "network skill\n",
+				"agent-skill.json": declared,
+				"scripts/fetch.sh": testCase.fetch,
+			})
+			err := EnsureDefaultWithPolicy(home, testCase.policy)
+			if err == nil || !strings.Contains(err.Error(), DiagSourceInvalid) || !strings.Contains(err.Error(), testCase.want) {
+				t.Fatalf("migration = %v, want refusal carrying %q", err, testCase.want)
+			}
+			assertMigrationUnpublished(t, home)
+		})
+	}
+}
