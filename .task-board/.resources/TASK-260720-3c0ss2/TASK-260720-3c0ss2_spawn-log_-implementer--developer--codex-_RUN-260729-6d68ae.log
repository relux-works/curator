+_ERROR_HANDLE_EOF: Final = 38
+_ERROR_INVALID_PARAMETER: Final = 87
+_STREAM_NAME_CAPACITY: Final = 296
+_INVALID_HANDLE_VALUE: Final = ctypes.c_void_p(-1).value
+
