+            f"cannot inspect Windows data streams in build-source snapshot: {relative}"
+        ) from exc
+    if streams:
+        raise InvalidSnapshotError(
+            f"non-portable Windows data stream in build-source snapshot: "
+            f"{relative}{streams[0]}"
+        )
+
