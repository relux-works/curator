+        "assets/build-toolkit/README.md",
+        "assets/prompt.md",
+    ]
+    assert (destination / "SKILL.md").is_file()
+    assert (destination / "assets" / "prompt.md").is_file()
+    assert not (destination / "assets" / "build-tool").exists()

