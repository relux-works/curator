+def _collect_path_entries(
+    root: Path,
+    directory: Path,
+    prefix: str,
+    paths: _PathRegistry,
+    directories: list[_StateEntry],
+    files: list[_DiscoveredFile],
+) -> None:
+    try:
+        with os.scandir(directory) as iterator:
