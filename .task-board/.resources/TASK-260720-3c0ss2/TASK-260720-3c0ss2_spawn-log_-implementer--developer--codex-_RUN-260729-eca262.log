+    frozen = source.freeze_snapshot(root)
+    root.rename(tmp_path / "old")
+    root.mkdir()
+    _write(root, "file", b"same")
+
+    try:
+        with pytest.raises(source.SnapshotMutationError, match="root"):
+            frozen.recheck()
+    finally:
+        frozen.close()
