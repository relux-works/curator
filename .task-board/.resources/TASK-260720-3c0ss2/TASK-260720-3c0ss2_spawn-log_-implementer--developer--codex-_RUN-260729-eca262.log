+def _hash_file(
+    root: Path,
+    root_fd: int | None,
+    record: _DiscoveredFile,
+    hasher: hashing.BuildSourceHasher,
+) -> _StateEntry:
+    if root_fd is None:
+        return _hash_path_file(record, hasher)
+    return _hash_fd_file(root, root_fd, record, hasher)
