+def test_nested_build_root_is_excluded_while_skill_and_unrelated_assets_remain(tmp_path):
+    snapshot = tmp_path / "snapshot"
+    snapshot.mkdir()
+    files = {
+        "SKILL.md": "# skill\n",
+        "assets/prompt.md": "visible\n",
+        "assets/build-tool/go.mod": "module example.com/tool\n",
