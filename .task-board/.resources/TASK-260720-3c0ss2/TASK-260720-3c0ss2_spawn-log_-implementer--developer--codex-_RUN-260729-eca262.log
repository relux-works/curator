diff --git a//Users/iv/Developer/Wildberries/cocoaskills/.temp/TASK-260720-3c0ss2/worktree/tests/test_build_source.py b//Users/iv/Developer/Wildberries/cocoaskills/.temp/TASK-260720-3c0ss2/worktree/tests/test_build_source.py
