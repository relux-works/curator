+def _is_link_or_reparse(value: os.stat_result) -> bool:
+    if stat.S_ISLNK(value.st_mode):
+        return True
+    attributes = getattr(value, "st_file_attributes", 0)
+    return bool(attributes & _REPARSE_ATTRIBUTE)
