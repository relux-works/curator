+        flags |= getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_BINARY", 0)
+        try:
+            return os.open(parts[-1], flags, dir_fd=directory_fd)
+        except OSError as exc:
+            raise InvalidSnapshotError(f"cannot open build-source file: {relative}") from exc
