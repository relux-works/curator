+            not stat.S_ISREG(opened_stat.st_mode)
+            or _file_key(opened_stat) != record.file_key
+            or opened_stat.st_size != record.size
+        ):
+            raise InvalidSnapshotError(f"build-source file changed while opening: {record.path}")
