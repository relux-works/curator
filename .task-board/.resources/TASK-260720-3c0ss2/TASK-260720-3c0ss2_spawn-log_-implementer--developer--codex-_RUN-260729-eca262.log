+        raise InvalidSnapshotError(f"cannot read build-source file: {record.path}") from exc
+    return _StateEntry(
+        path_bytes=record.path_bytes,
+        kind="F",
+        size=record.size,
+        content_sha256=content_digest.digest(),
+    )
