+    for name in names:
+        relative = f"{prefix}/{name}" if prefix else name
+        path_bytes = paths.add(relative)
+        try:
+            entry_stat = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
+        except OSError as exc:
