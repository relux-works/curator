+    def add(self, path: str) -> bytes:
+        if not is_valid_portable_path(path):
+            raise InvalidSnapshotError(f"non-portable path in build-source snapshot: {path!r}")
+        try:
+            path_bytes = path.encode("utf-8", errors="strict")
