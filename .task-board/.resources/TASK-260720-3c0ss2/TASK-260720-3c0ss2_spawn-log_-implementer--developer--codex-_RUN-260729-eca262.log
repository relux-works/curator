+        identity=BuildSourceIdentity(
+            algorithm=hashing.BUILD_SOURCE_ALGORITHM,
+            content_sha256=hasher.content_sha256(),
+        ),
+        state=state,
+    )
+
+
+def _collect_fd_entries(
+    root: Path,
+    directory_fd: int,
+    prefix: str,
+    paths: _PathRegistry,
+    directories: list[_StateEntry],
+    files: list[_DiscoveredFile],
