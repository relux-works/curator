+            or _file_key(after_stat) != record.file_key
+            or after_stat.st_size != record.size
+        ):
+            raise InvalidSnapshotError(f"build-source file changed while reading: {record.path}")
+        return _StateEntry(
+            path_bytes=record.path_bytes,
+            kind="F",
+            size=record.size,
