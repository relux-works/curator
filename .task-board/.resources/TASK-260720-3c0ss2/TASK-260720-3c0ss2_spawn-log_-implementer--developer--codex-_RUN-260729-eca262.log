+def _open_root_fd(path: Path) -> int | None:
+    if (
+        os.name != "posix"
+        or not hasattr(os, "O_DIRECTORY")
+        or not hasattr(os, "O_NOFOLLOW")
+        or os.scandir not in os.supports_fd
