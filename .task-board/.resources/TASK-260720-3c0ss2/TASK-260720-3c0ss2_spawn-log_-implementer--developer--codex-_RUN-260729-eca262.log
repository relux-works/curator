+                record.size,
+                _file_chunks(file, record.size, record.path, content_digest),
+            )
+            after_stat = os.fstat(file.fileno())
+            if (
+                not stat.S_ISREG(after_stat.st_mode)
+                or _file_key(after_stat) != record.file_key
+                or after_stat.st_size != record.size
+            ):
