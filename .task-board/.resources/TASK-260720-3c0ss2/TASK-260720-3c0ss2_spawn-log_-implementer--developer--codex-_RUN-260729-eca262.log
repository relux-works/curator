+    directories: list[_StateEntry] = []
+    files: list[_DiscoveredFile] = []
+    if root_fd is None:
+        _collect_path_entries(path, path, "", paths, directories, files)
+    else:
+        _collect_fd_entries(path, root_fd, "", paths, directories, files)
