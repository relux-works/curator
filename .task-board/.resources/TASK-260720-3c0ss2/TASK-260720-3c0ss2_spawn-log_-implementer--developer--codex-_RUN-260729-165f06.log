+                            "type": "build",
+                            "driver": "go-v1",
+                            "source_dir": "assets/build-tool/cmd/tool",
+                        }
+                    },
+                    "capabilities": {},
+                }
+            ),
+            "assets/prompt.md": "visible prompt asset\n",
+            "assets/build-tool/go.mod": "module example.com/tool\n\ngo 1.23\n",
+            "assets/build-tool/cmd/tool/main.go": "package main\n",
