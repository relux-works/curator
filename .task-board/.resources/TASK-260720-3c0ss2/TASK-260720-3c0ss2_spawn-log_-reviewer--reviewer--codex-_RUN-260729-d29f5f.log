@@ -0,0 +1,56 @@
+from __future__ import annotations
+
+import base64
+import json
+import sys
+import tempfile
+from pathlib import Path
+
+
+WORKTREE = Path(
+    "/Users/iv/Developer/Wildberries/cocoaskills/.temp/"
+    "TASK-260720-3c0ss2/worktree"
+)
+CONFORMANCE = Path(
+    "/Users/iv/Developer/ReluxWorks/curator/.temp/"
+    "TASK-260729-3nx97g/worktree/conformance/v1"
+)
+sys.path.insert(0, str(WORKTREE / "src"))
+
+from csk import hashing, skillspec, whitelist
+from csk.builds import source
+
+
+vectors = json.loads(
+    (CONFORMANCE / "vectors" / "build-drivers.json").read_text(
+        encoding="utf-8"
+    )
+)
+fixture_case = vectors["build_source_cases"][0]
+records = [
+    (record["path"], base64.b64decode(record["content_base64"]))
+    for record in fixture_case["records"]
+]
+memory_digest = hashing.build_source_sha256(records)
+fixture_root = CONFORMANCE / vectors["fixture"]["root"]
+with source.freeze_snapshot(fixture_root) as frozen:
+    snapshot_digest = frozen.identity.content_sha256
+
+spec = skillspec.load_skill_spec(fixture_root)
+with tempfile.TemporaryDirectory(prefix="csk-review-context-") as raw_tmp:
+    destination = Path(raw_tmp) / "context"
+    files = whitelist.copy_context(
+        fixture_root,
+        destination,
+        exclude_roots=spec.runtime_roots,
+        build_roots=spec.build_roots,
+    )
+
+print(f"expected_digest={fixture_case['content_sha256']}")
+print(f"memory_digest={memory_digest}")
+print(f"snapshot_digest={snapshot_digest}")
+print(f"expected_context={vectors['fixture']['expected_context_files']!r}")
+print(f"actual_context={files!r}")
+assert memory_digest == fixture_case["content_sha256"]
+assert snapshot_digest == fixture_case["content_sha256"]
+assert files == vectors["fixture"]["expected_context_files"]
