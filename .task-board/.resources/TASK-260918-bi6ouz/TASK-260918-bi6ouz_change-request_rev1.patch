+			}
+			return "", fmt.Errorf("lstat dotfile-manager state %s: %w", path, err)
+		}
+		if info.Mode()&os.ModeSymlink == 0 && info.IsDir() {
+			return row.manager, nil
+		}
+	}
+	return "", nil
+}
