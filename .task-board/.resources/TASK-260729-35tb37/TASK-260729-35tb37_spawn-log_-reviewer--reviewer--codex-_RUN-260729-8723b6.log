name = "cocoaskills"
dynamic = ["version"]
description = "Local skill manager for AI agent skills with reproducible per-project installs"
readme = "README.md"
requires-python = ">=3.11"
license = "Apache-2.0"
license-files = ["LICENSE"]
authors = [
  { name = "Ivan Oparin", email = "oparin@me.com" }
]
keywords = [
  "skills",
  "ai-agents",
  "claude-code",
  "cursor",
  "codex",
  "gemini",
  "dependency-manager",
]
classifiers = [
  "Development Status :: 3 - Alpha",
  "Intended Audience :: Developers",
  "Operating System :: MacOS",
  "Operating System :: POSIX :: Linux",
  "Operating System :: Microsoft :: Windows",
  "Programming Language :: Python :: 3",
  "Programming Language :: Python :: 3.11",
  "Programming Language :: Python :: 3.12",
  "Programming Language :: Python :: 3.13",
  "Programming Language :: Python :: 3.14",
  "Topic :: Software Development",
  "Topic :: Software Development :: Build Tools",
  "Topic :: System :: Software Distribution",
]
dependencies = []

[project.optional-dependencies]
dev = [
  "pytest>=9",
  "build>=1.2",
  "twine>=5",
  "mypy>=1.14",
  "cryptography>=44",
]

[project.scripts]
csk = "csk.cli:main"

[project.urls]
Homepage = "https://github.com/ivanopcode/cocoaskills"
Source = "https://github.com/ivanopcode/cocoaskills"
Issues = "https://github.com/ivanopcode/cocoaskills/issues"
Changelog = "https://github.com/ivanopcode/cocoaskills/blob/main/CHANGELOG.md"
Documentation = "https://github.com/ivanopcode/cocoaskills/blob/main/docs/mvp-design.md"

[tool.setuptools]
package-dir = { "" = "src" }

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
"csk.audit" = ["prompts/*.md", "prompts/*.json"]

[tool.setuptools_scm]
version_file = "src/csk/_version.py"

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]

[tool.mypy]
strict = true
python_version = "3.11"
files = ["src/csk"]
name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  test:
    name: Tests / Python ${{ matrix.python-version }} on ${{ matrix.os }}
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
        python-version: ["3.11", "3.12", "3.13", "3.14"]
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Checkout Curator Protocol conformance suite
        uses: actions/checkout@v4
        with:
          repository: relux-works/curator-spec
          ref: 00b1688a9b2457ca397a0bb550acf47cad8ee967
          path: protocol-spec

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          allow-prereleases: true

      - name: Configure git (POSIX)
        if: runner.os != 'Windows'
        run: |
          git config --global user.email "ci@example.com"
          git config --global user.name "CI"
          git config --global init.defaultBranch main

      - name: Configure git (Windows)
        if: runner.os == 'Windows'
        shell: pwsh
        run: |
          git config --global user.email "ci@example.com"
          git config --global user.name "CI"
          git config --global init.defaultBranch main
          git config --global core.autocrlf false
          git config --global core.symlinks false

      - name: Install package
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e ".[dev]"

      - name: Run tests
        env:
          CURATOR_CONFORMANCE_ROOT: ${{ github.workspace }}/protocol-spec/conformance/v1
        run: python -m pytest -v

  typecheck:
    name: Type check / mypy strict
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install package
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e ".[dev]"

      - name: Run mypy
        run: python -m mypy

  build:
    name: Build artifacts
    runs-on: ubuntu-latest
    needs: test
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install build tools
        run: |
          python -m pip install --upgrade pip
          python -m pip install build twine

      - name: Build sdist and wheel
        run: python -m build

      - name: Verify metadata
        run: twine check dist/*

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: dist
          path: dist/
          if-no-files-found: error
name: Release

on:
  push:
    tags:
      - "v*"

permissions:
  contents: read

jobs:
  build:
    name: Build distributions
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install build tools
        run: python -m pip install --upgrade build twine

      - name: Build wheel and sdist
        run: python -m build

      - name: Check metadata
        run: twine check dist/*

      - name: Generate checksums
        run: |
          python - <<'PY'
          from pathlib import Path
          import hashlib

          lines = []
          for path in sorted(Path("dist").iterdir()):
              if path.name == "SHA256SUMS":
                  continue
              digest = hashlib.sha256(path.read_bytes()).hexdigest()
              lines.append(f"{digest}  {path.name}")
          Path("dist/SHA256SUMS").write_text("\n".join(lines) + "\n", encoding="utf-8")
          PY

      - name: Upload Python distributions
        uses: actions/upload-artifact@v4
        with:
          name: python-dist
          path: |
            dist/*.tar.gz
            dist/*.whl

      - name: Upload checksums
        uses: actions/upload-artifact@v4
        with:
          name: checksums
          path: dist/SHA256SUMS

  publish-testpypi:
    name: Publish to TestPyPI
    needs: build
    runs-on: ubuntu-latest
    if: startsWith(github.ref_name, 'v') && (contains(github.ref_name, '-rc') || contains(github.ref_name, '-alpha') || contains(github.ref_name, '-beta'))
    environment: testpypi
    permissions:
      contents: read
      id-token: write
    steps:
      - name: Download distributions
        uses: actions/download-artifact@v4
        with:
          name: python-dist
          path: dist

      - name: Publish to TestPyPI
        uses: pypa/gh-action-pypi-publish@release/v1
        with:
          repository-url: https://test.pypi.org/legacy/
          packages-dir: dist/

  publish-pypi:
    name: Publish to PyPI and GitHub Releases
    needs: build
    runs-on: ubuntu-latest
    if: startsWith(github.ref_name, 'v') && !contains(github.ref_name, '-')
    environment: pypi
    permissions:
      contents: write
      id-token: write
    steps:
      - name: Download distributions
        uses: actions/download-artifact@v4
        with:
          name: python-dist
          path: dist

      - name: Publish to PyPI
        uses: pypa/gh-action-pypi-publish@release/v1
        with:
          packages-dir: dist/

      - name: Download checksums
        uses: actions/download-artifact@v4
        with:
          name: checksums
          path: dist

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          files: dist/*
          fail_on_unmatched_files: true
          generate_release_notes: true
name: Distribution Smoke

on:
  release:
    types: [published]
  workflow_run:
    workflows: ["Release"]
    types: [completed]
  workflow_dispatch:
    inputs:
      version:
        description: "Version or tag to smoke, for example 0.1.1 or v0.1.1"
        required: true
        type: string
      include_homebrew:
        description: "Also test the Homebrew tap. Enable after the tap formula is bumped."
        required: false
        default: false
        type: boolean

permissions:
  contents: read

jobs:
  resolve-version:
    name: Resolve version
    runs-on: ubuntu-latest
    if: ${{ github.event_name != 'workflow_run' || (github.event.workflow_run.conclusion == 'success' && !contains(github.event.workflow_run.head_branch, '-')) }}
    outputs:
      version: ${{ steps.version.outputs.version }}
      tag: ${{ steps.version.outputs.tag }}
    steps:
      - name: Normalize version
        id: version
        env:
          RAW_VERSION: ${{ github.event_name == 'workflow_dispatch' && inputs.version || github.event_name == 'workflow_run' && github.event.workflow_run.head_branch || github.event.release.tag_name }}
        run: |
          python - <<'PY' >> "$GITHUB_OUTPUT"
          import os

          raw = os.environ["RAW_VERSION"].strip()
          tag = raw if raw.startswith("v") else f"v{raw}"
          version = raw[1:] if raw.startswith("v") else raw
          version = version.replace("-rc", "rc").replace("-alpha", "a").replace("-beta", "b")
          print(f"tag={tag}")
          print(f"version={version}")
          PY

  smoke:
    name: ${{ matrix.channel }} / ${{ matrix.os }}
    needs: resolve-version
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-latest
            channel: pipx
          - os: macos-latest
            channel: pipx
          - os: windows-latest
            channel: pipx
          - os: ubuntu-latest
            channel: uv-tool
          - os: macos-latest
            channel: uv-tool
          - os: windows-latest
            channel: uv-tool
          - os: ubuntu-latest
            channel: mise
          - os: macos-latest
            channel: mise
          - os: ubuntu-latest
            channel: install-sh
          - os: macos-latest
            channel: install-sh
    defaults:
      run:
        shell: bash
    env:
      CSK_VERSION: ${{ needs.resolve-version.outputs.version }}
    steps:
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Configure git
        run: |
          git config --global user.email "ci@example.com"
          git config --global user.name "CI"
          git config --global init.defaultBranch main
          git config --global core.autocrlf false
          git config --global core.symlinks false

      - name: Install with pipx
        if: matrix.channel == 'pipx'
        run: |
          python -m pip install --upgrade pip pipx
          for attempt in 1 2 3 4 5; do
            if python -m pipx install "cocoaskills==$CSK_VERSION"; then
              break
            fi
            python -m pipx uninstall cocoaskills >/dev/null 2>&1 || true
            if [ "$attempt" -eq 5 ]; then
              exit 1
            fi
            sleep $((attempt * 15))
          done
          python - <<'PY' >> "$GITHUB_PATH"
          import subprocess
          import sys

          print(subprocess.check_output(
              [sys.executable, "-m", "pipx", "environment", "--value", "PIPX_BIN_DIR"],
              text=True,
          ).strip())
          PY

      - name: Install with uv tool
        if: matrix.channel == 'uv-tool'
        run: |
          python -m pip install --upgrade pip uv
          for attempt in 1 2 3 4 5; do
            if python -m uv tool install "cocoaskills==$CSK_VERSION"; then
              break
            fi
            python -m uv tool uninstall cocoaskills >/dev/null 2>&1 || true
            if [ "$attempt" -eq 5 ]; then
              exit 1
            fi
            sleep $((attempt * 15))
          done
          python -m uv tool dir --bin >> "$GITHUB_PATH"

      - name: Install with mise
        if: matrix.channel == 'mise'
        run: |
          curl -fsSL https://mise.run | sh
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"
          for attempt in 1 2 3 4 5; do
            if "$HOME/.local/bin/mise" install -y "pipx:cocoaskills@$CSK_VERSION"; then
              break
            fi
            if [ "$attempt" -eq 5 ]; then
              exit 1
            fi
            sleep $((attempt * 15))
          done
          mkdir -p "$RUNNER_TEMP/csk-mise-wrapper"
          cat > "$RUNNER_TEMP/csk-mise-wrapper/csk" <<EOF
          #!/usr/bin/env bash
          exec "$HOME/.local/bin/mise" exec -y "pipx:cocoaskills@$CSK_VERSION" -- csk "\$@"
          EOF
          chmod +x "$RUNNER_TEMP/csk-mise-wrapper/csk"
          echo "$RUNNER_TEMP/csk-mise-wrapper" >> "$GITHUB_PATH"

      - name: Install with install.sh
        if: matrix.channel == 'install-sh'
        run: |
          python -m pip install --upgrade pip uv
          curl -fsSL https://cocoaskills.org/install.sh | sh
          python -m uv tool dir --bin >> "$GITHUB_PATH"

      - name: Verify installed CLI version
        run: |
          actual="$(csk --version)"
          printf '%s\n' "$actual"
          case "$actual" in
            *" $CSK_VERSION") ;;
            *) echo "Expected csk $CSK_VERSION, got: $actual" >&2; exit 1 ;;
          esac

      - name: Run minimal published-package E2E
        run: |
          root="$(mktemp -d)"
          skills="$root/skills"
          project="$root/project"
          csk_home="$root/csk-home"
          mkdir -p "$skills/skill-a" "$project" "$csk_home"

          (
            cd "$skills/skill-a"
            git init
            git branch -M main
            printf '%s\n' '---' 'name: skill-a' '---' '' '# Skill A' > SKILL.md
            git add SKILL.md
            git commit -m "skill"
            git tag v1
          )

          (
            cd "$project"
            git init
            git branch -M main
            printf '.agents/\n.codex/skills/\n' > .gitignore
            cat > Skillfile.json <<'JSON'
          {
            "schema_version": 1,
            "agents": ["codex_cli"],
            "skills": [
              { "name": "skill-a", "tag": "v1" }
            ]
          }
          JSON
            git add .gitignore Skillfile.json
            git commit -m "project"
          )

          config_file="$csk_home/config.json"
          config_skills="$skills"
          config_project="$project"
          if command -v cygpath >/dev/null 2>&1; then
            config_file="$(cygpath -w "$config_file")"
            config_skills="$(cygpath -w "$config_skills")"
            config_project="$(cygpath -w "$config_project")"
          fi

          CONFIG_FILE="$config_file" CONFIG_SKILLS="$config_skills" CONFIG_PROJECT="$config_project" python - <<'PY'
          import json
          import os
          from pathlib import Path

          config_file = Path(os.environ["CONFIG_FILE"])
          config_file.parent.mkdir(parents=True, exist_ok=True)
          config_file.write_text(
              json.dumps(
                  {
                      "schema_version": 1,
                      "skills_root": os.environ["CONFIG_SKILLS"],
                      "default_agents": ["codex_cli"],
                      "adapter_mode": "auto",
                      "projects": {
                          "app": {
                              "path": os.environ["CONFIG_PROJECT"],
                              "agents": ["codex_cli"],
                          }
                      },
                  },
                  indent=2,
              ),
              encoding="utf-8",
          )
          PY

          export CSK_CONFIG="$config_file"
          csk install app
          test -f "$project/.agents/skills/skill-a/SKILL.md"
          test -f "$project/.agents/skills/skill-a/.csk-install.json"
          csk status app | tee "$root/status.txt"
          grep -q "up-to-date" "$root/status.txt"

          marker_file="$project/.agents/skills/skill-a/.csk-install.json"
          if command -v cygpath >/dev/null 2>&1; then
            marker_file="$(cygpath -w "$marker_file")"
          fi

          MARKER_FILE="$marker_file" python - <<PY > "$RUNNER_TEMP/content-sha256-${{ matrix.os }}-${{ matrix.channel }}.txt"
          import json
          import os

