+					return Metadata{}, fail(CodeGraphIncomplete, "metadata dependency kind malformed", nil)
+				}
+				if err := allowFields(kindObject, "metadata dependency kind", []string{"kind", "target"}); err != nil {
+					return Metadata{}, err
