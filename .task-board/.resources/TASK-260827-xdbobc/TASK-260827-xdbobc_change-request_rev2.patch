+	issuedPermit, err := authority.derivation.IssuedDerivationPermit(permitID)
+	if err != nil {
+		return nil, err
+	}
+	receipt, err := authority.derivation.Execute(ctx, permitID, func(checkCtx context.Context) (closureexec.ToolchainIdentity, error) {
