+func (m *Manager) gitProjection(ctx context.Context, repositoryRoot string, origin gitOrigin, tracked map[string]bool) (gitDerivation, error) {
+	trackedPaths := make([]string, 0, len(tracked))
+	for item, present := range tracked {
+		if present && item != "" {
