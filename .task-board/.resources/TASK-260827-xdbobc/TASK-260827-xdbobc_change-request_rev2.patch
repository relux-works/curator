+	stagedYarn := filepath.Join(stagedYarnRoot, "bin", "yarn.js")
+	yarnPayload, err := os.ReadFile(stagedYarn) // #nosec G304 -- exact staged Yarn entry point.
+	if err != nil {
+		t.Fatal(err)
