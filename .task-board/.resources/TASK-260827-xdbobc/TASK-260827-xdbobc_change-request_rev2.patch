+func validateJSON(payload []byte) error {
+	var value any
+	decoder := json.NewDecoder(bytes.NewReader(payload))
+	decoder.UseNumber()
+	if err := decoder.Decode(&value); err != nil {
+		return err
+	}
+	if decoder.More() {
+		return fmt.Errorf("trailing JSON value")
+	}
+	return nil
+}
