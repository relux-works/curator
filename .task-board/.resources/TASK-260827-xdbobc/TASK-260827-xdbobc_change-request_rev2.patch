+func TestClosedGrammarHelpersCoverScopedSelectorsWorkspacesAndConditions(t *testing.T) {
+	if got := splitComma(`"pkg@one,two", @scope/pkg@^1.0.0`); !reflect.DeepEqual(got, []string{`"pkg@one,two"`, " @scope/pkg@^1.0.0"}) {
+		t.Fatalf("quoted selector split=%q", got)
+	}
+	if _, err := parseSelectorList(`pkg@^1.0.0, pkg@^1.0.0`); err == nil {
+		t.Fatal("duplicate selector admitted")
+	}
+	for _, value := range []string{"pkg", "@scope/pkg"} {
+		if !validPackageName(value) {
+			t.Fatalf("valid package name rejected: %q", value)
+		}
+	}
+	for _, value := range []string{"", "bad name", "@scope", "@scope/pkg/extra", "pkg@version"} {
+		if validPackageName(value) {
+			t.Fatalf("invalid package name admitted: %q", value)
+		}
+	}
+
+	direct, nohoist, err := workspacePatterns(json.RawMessage(`["packages/*"]`))
+	if err != nil || !reflect.DeepEqual(direct, []string{"packages/*"}) || len(nohoist) != 0 {
+		t.Fatalf("direct workspace declaration=%v/%v err=%v", direct, nohoist, err)
+	}
+	for _, raw := range []json.RawMessage{json.RawMessage(`"invalid"`), json.RawMessage(`["../escape"]`), json.RawMessage(`{"packages":["packages/*"],"nohoist":["/absolute"]}`)} {
+		if _, _, err = workspacePatterns(raw); err == nil {
+			t.Fatalf("invalid workspace declaration admitted: %s", raw)
+		}
+	}
+	if !workspaceSpecMatches("1.0.0", "1.0.0", "packages/pkg") || workspaceSpecMatches("^2.0.0", "1.0.0", "packages/pkg") {
+		t.Fatal("workspace spec reconciliation changed")
+	}
+
+	condition := closuregraph.Condition{EvaluatorID: "yarn-classic-platform-v1", Expression: "os=linux"}
+	input := closuregraph.EvaluationInput{Selection: closuregraph.SelectionContext{Markers: map[string]string{"os": "linux"}}}
+	if selected, err := evaluateYarnPlatformCondition(condition, input); err != nil || !selected {
+		t.Fatalf("platform condition not selected: selected=%v err=%v", selected, err)
+	}
+	condition.Expression = "os=darwin"
+	if selected, err := evaluateYarnPlatformCondition(condition, input); err != nil || selected {
+		t.Fatalf("non-matching platform condition selected: selected=%v err=%v", selected, err)
+	}
+	condition.Expression = "malformed"
+	if _, err := evaluateYarnPlatformCondition(condition, input); err == nil {
+		t.Fatal("malformed platform condition admitted")
+	}
+
+	diagnostic := &Error{Code: CodeLockStale, Detail: "changed", Fields: map[string]string{"path": "package.json"}}
+	if ErrorCode(diagnostic) != CodeLockStale || diagnostic.Fields["path"] != "package.json" || ErrorCode(errors.New("plain")) != "" {
+		t.Fatalf("structured diagnostic changed: %v code=%q", diagnostic, ErrorCode(diagnostic))
+	}
+	if !equalStringMap(map[string]string{"a": "1"}, map[string]string{"a": "1"}) || equalStringMap(map[string]string{"a": "1"}, map[string]string{}) || equalStringMap(map[string]string{"a": "1"}, map[string]string{"a": "2"}) {
+		t.Fatal("canonical map equality changed")
+	}
+	metadata := map[string]struct {
+		Optional bool `json:"optional"`
+	}{"required": {Optional: false}, "optional": {Optional: true}}
+	if got := peerOptional(metadata); !reflect.DeepEqual(got, map[string]bool{"optional": true}) {
+		t.Fatalf("peer optional projection=%v", got)
+	}
+}
