+		assert case["expected"] == actual["summary"], case["id"]
+		print(json.dumps({"case_id": case["id"], "outcome": {"ccj": actual["ccj"], "id": actual["id"], "label": actual["label"]}, "target_outcomes": [], "reuse_negative": None}, separators=(",", ":"), sort_keys=True))
