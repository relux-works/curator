+	yarnCommand, err := exec.LookPath("yarn")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sandboxPath, err := exec.LookPath("sandbox-exec")
+	if err != nil {
+		t.Skip("OS-level network-denial harness is unavailable")
