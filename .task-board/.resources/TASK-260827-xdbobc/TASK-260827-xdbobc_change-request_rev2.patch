+	if capture.Graph.Layout.ModulesFolder != "node_modules" || materialized.capture.Graph.ConfigurationDigest != capture.Graph.ConfigurationDigest {
+		t.Fatalf("ambient configuration changed closed layout/identity: layout=%+v config=%s/%s", capture.Graph.Layout, materialized.capture.Graph.ConfigurationDigest, capture.Graph.ConfigurationDigest)
+	}
+	for _, item := range runner.launches[0].Environment {
+		if strings.HasPrefix(item, "PATH=") || strings.HasPrefix(item, "YARN_RC_FILENAME=") || strings.HasPrefix(item, "npm_config_") {
+			t.Fatalf("real Yarn launch inherited ambient configuration: %+v", runner.launches[0])
+		}
+	}
+}
