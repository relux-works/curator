+	state.mu.Lock()
+	defer state.mu.Unlock()
+	if state.closed || capture == nil || capture.state == nil || capture.state.owner != state {
+		return MetadataResult{}, fail(CodeGraphIncomplete, "capture is absent, closed, or foreign", nil)
