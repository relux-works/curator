+func writePackage(t *testing.T, base, name string) string {
+	t.Helper()
+	root := filepath.Join(base, name)
+	if err := os.MkdirAll(filepath.Join(root, "Sources", "App"), 0o700); err != nil {
+		t.Fatal(err)
