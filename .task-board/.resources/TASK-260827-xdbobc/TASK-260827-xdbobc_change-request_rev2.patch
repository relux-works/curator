+			target := filepath.Join(modules, filepath.FromSlash(pkg.Name))
+			if err := os.MkdirAll(filepath.Dir(target), 0o700); err != nil {
+				return closureexec.PortableRunResult{}, err
+			}
+			if pkg.Resolved == "" {
+				_ = os.RemoveAll(target)
+				if err := os.Symlink(filepath.Join("..", filepath.FromSlash(pkg.WorkspacePath)), target); err != nil {
+					return closureexec.PortableRunResult{}, err
+				}
+				continue
+			}
+			if err := os.MkdirAll(target, 0o700); err != nil {
+				return closureexec.PortableRunResult{}, err
+			}
+			if err := extractFixtureTarball(runner.capture.tarballs[pkg.Key], target); err != nil {
