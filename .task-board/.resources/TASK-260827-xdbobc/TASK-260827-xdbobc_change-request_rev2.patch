+			syncClassificationDiagnostics(t, &manifest)
+			if err := decodeRehashedManifest(manifest); err == nil {
+				t.Fatal("self-rehashed shared-object resolution bypassed duplicate-use semantics")
+			}
+		})
+	}
+}
