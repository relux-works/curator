+	cwd := filepath.ToSlash(filepath.Join(".swiftpm-authority", "work"))
+	evidencePath := filepath.ToSlash(filepath.Join(".swiftpm-authority", "verification-evidence", fmt.Sprintf("%06d-%s.txt", authority.sequence, phase)))
