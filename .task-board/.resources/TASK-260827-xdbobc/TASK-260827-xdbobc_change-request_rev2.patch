+func sparseTarHeader(header *tar.Header) bool {
+	for key := range header.PAXRecords {
+		if strings.HasPrefix(strings.ToLower(key), "gnu.sparse") || strings.Contains(strings.ToLower(key), "sparse") {
+			return true
+		}
+	}
+	return false
+}
