+package artifactpolicy
+
+import (
+	"bytes"
+	"crypto/sha1" // #nosec G505 -- DEX format validation requires its specified SHA-1 field.
+	"encoding/binary"
+	"fmt"
+	"hash/adler32"
+	"io"
+	"math"
+	"strings"
