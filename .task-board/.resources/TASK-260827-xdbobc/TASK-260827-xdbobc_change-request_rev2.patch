+			t.Fatalf("%s digest = %s record = %s, want %s", name, actual, lines[index+3], expected)
+		}
+		seen[name] = true
+	}
+	if len(seen) != len(want) {
+		t.Fatalf("validated %d/%d exact CGP05 records", len(seen), len(want))
+	}
