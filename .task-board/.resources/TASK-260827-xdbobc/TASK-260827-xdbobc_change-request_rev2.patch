+	for _, kind := range []string{"platform", "selection", "binding", "active", "plan", "c4", "c5"} {
+		if records["cgp05."+kind+".darwin"].ID == records["cgp05."+kind+".linux"].ID {
+			t.Errorf("%s branch IDs unexpectedly equal", kind)
+		}
+	}
