+// postPinKnobs are the §12.1 knobs the implementation renders that
+// postdate the committed SPEC_PIN vector revision. A vector revision
+// that predates a knob cannot expect it, so the comparison prunes
+// exactly those knobs — and only when the case's own expectation lacks
+// them. Every other key compares exactly at every revision: the prune
+// list is closed, so a stray rendered key still fails. A later knob
+// (E4's provider_directories) extends this list when it lands; until
+// then the new-root run fails on its absence, as it must.
+var postPinKnobs = []string{"transitive_system_modules", "system_module_waivers"}
+
+// prunePostRevisionKnobs drops the post-pin knobs from the rendered
+// environments object for the knobs the case's expectation does not
+// name. Non-object members pass through untouched.
+func prunePostRevisionKnobs(gotValue, want any) any {
+	gotEnv, ok := gotValue.(map[string]any)
+	if !ok {
+		return gotValue
+	}
+	wantEnv, ok := want.(map[string]any)
+	if !ok {
+		return gotValue
+	}
+	pruned := map[string]any{}
+	for key, value := range gotEnv {
+		pruned[key] = value
+	}
+	for _, knob := range postPinKnobs {
+		if _, present := wantEnv[knob]; !present {
+			delete(pruned, knob)
+		}
+	}
+	return pruned
+}
