+func runWaitingHelper(t *testing.T, mode, home, project, key string) string {
+	t.Helper()
+	command := helperCommand(mode, home, project)
+	command.Env = append(command.Env, helperWaitEnv+"=1")
+	if key != "" {
+		command.Env = append(command.Env, helperKeyEnv+"="+key)
+	}
+	stdout, err := command.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var stderr bytes.Buffer
+	command.Stderr = &stderr
+	stdin, err := command.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := command.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if command.ProcessState == nil {
+			_ = stdin.Close()
+			_ = command.Process.Kill()
+			_ = command.Wait()
+		}
+	}()
+
+	scanner := bufio.NewScanner(stdout)
+	if !scanner.Scan() {
+		t.Fatalf("waiting helper %s produced no result: %v\n%s", mode, scanner.Err(), stderr.String())
+	}
+	result := scanner.Text()
+	if err := os.RemoveAll(home); err != nil {
+		t.Fatalf("remove released manager home while helper is alive: %v", err)
+	}
+	if err := stdin.Close(); err != nil {
+		t.Fatal(err)
+	}
+	for scanner.Scan() {
+	}
+	if err := scanner.Err(); err != nil {
+		t.Fatal(err)
+	}
+	if err := command.Wait(); err != nil {
+		t.Fatalf("waiting helper %s failed: %v\n%s", mode, err, stderr.String())
+	}
+	return result
+}
