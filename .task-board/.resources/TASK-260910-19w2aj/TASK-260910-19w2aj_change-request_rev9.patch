+// HasRemote reports whether repo declares at least one remote. A
+// repository without remotes has nothing to fetch from; Fetch treats it
+// as a successful no-op instead of invoking the tool.
+func HasRemote(repo string) bool {
+	out, err := run(repo, "remote")
