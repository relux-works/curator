+		t.Fatal(err)
+	}
+	if code, _, stderr := capture(t, configPath, "install", "app", "--dry-run"); code != exitOK {
+		t.Fatalf("pinned reinstall without the repository = %d\nstderr:\n%s", code, stderr)
+	}
