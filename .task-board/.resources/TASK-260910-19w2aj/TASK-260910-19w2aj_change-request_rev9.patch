+	cfg := draftGitConfig(t, repo, home, payload)
+	calls := 0
+	cfg.GitResolve = func(repoRoot, kind, value string) (gitops.ResolvedRef, error) {
+		calls++
+		return gitops.Resolve(repoRoot, kind, value)
+	}
