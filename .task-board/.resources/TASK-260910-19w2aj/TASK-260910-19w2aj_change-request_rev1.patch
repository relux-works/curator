+	if _, err := ManifestDigest(nil); err == nil {
+		t.Fatalf("ManifestDigest accepted empty input")
+	}
+	if _, err := ManifestDigest([]byte(`[]`)); err == nil {
+		t.Fatalf("ManifestDigest accepted a non-object")
+	}
