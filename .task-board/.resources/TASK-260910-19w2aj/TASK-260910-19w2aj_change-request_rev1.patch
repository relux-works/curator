+}`
+
+const fixtureInvalidConfiguredEscape = `{
+  "schema_version": 1,
+  "manifest_sha256": "sha256:b9b161ebadcac2d76b211fcfb38b74da89f62fc5b605e614588732555784f989",
+  "members": [
+    {
