+		t.Fatalf("nil CheckNames accepted")
+	}
+	if err := lock.CheckMembership(nil); err == nil {
+		t.Fatalf("nil CheckMembership accepted")
+	}
+	if err := Write(filepath.Join(t.TempDir(), FileName), nil); err == nil {
+		t.Fatalf("Write nil lock accepted")
