+func TestNilGuards(t *testing.T) {
+	var lock *Lock
+	if err := lock.Validate(); err == nil {
+		t.Fatalf("nil Validate accepted")
+	}
+	if _, err := lock.Digest(); err == nil {
+		t.Fatalf("nil Digest accepted")
