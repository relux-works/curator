+// TagsPointingAt lists the tag names whose commit is exactly commit: the
+// peeled target for annotated tags, the direct target for lightweight
+// ones. One for-each-ref invocation enumerates every tag with both object
+// names, so the peeling comparison stays exact on every git version and
+// never depends on --points-at dereference semantics. The commit is
+// compared as an opaque string; a malformed value simply matches nothing.
+// A failed enumeration is an error, never an empty result: callers must
+// not read "no tag binds this commit" from an unreadable repository.
+func TagsPointingAt(repo, commit string) ([]string, error) {
+	if err := EnsureRepo(repo); err != nil {
+		return nil, err
+	}
+	out, err := run(repo, "for-each-ref", "--format=%(refname:short) %(*objectname) %(objectname)", "refs/tags")
+	if err != nil {
+		return nil, fmt.Errorf("could not list tags in %s: %w", repo, err)
+	}
+	var bound []string
+	for _, line := range strings.Split(out, "\n") {
+		// Split on single spaces, not fields: a lightweight tag leaves
+		// the peeled slot empty ("v1  <sha>"), and collapsing
+		// whitespace would merge it away. Tag names and object names
+		// never contain spaces, so three slots always parse exactly.
+		fields := strings.Split(line, " ")
+		if len(fields) != 3 || fields[0] == "" || fields[2] == "" {
+			continue
+		}
+		target := fields[1]
+		if target == "" {
+			target = fields[2]
+		}
+		if target == commit {
+			bound = append(bound, fields[0])
+		}
+	}
+	return bound, nil
+}
