+package install
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+
+	"github.com/relux-works/curator/internal/closure"
+	"github.com/relux-works/curator/internal/marker"
+)
+
+// legacyLockBinding is the canonical preimage of a legacy-lane (Skillfile
+// schema 1) package-marker lock binding. The schema-1 lane keeps no lock
+// document, so the binding hashes exactly what the marker must attest in
+// place of one: the installed selection (name plus full package identity
+// including the normalized directory) and the declared ref. Struct field
+// order is the canonical order; the digest form matches the draft lane.
+type legacyLockBinding struct {
+	Name         string `json:"name"`
+	Kind         string `json:"kind"`
+	Repository   string `json:"repository,omitempty"`
+	Source       string `json:"source,omitempty"`
+	ObjectFormat string `json:"object_format,omitempty"`
+	Hex          string `json:"hex,omitempty"`
+	Directory    string `json:"directory"`
+	RefKind      string `json:"ref_kind"`
+	Ref          string `json:"ref"`
+}
+
+// legacyMarkerPackage stages the frozen package identity and lock binding
+// of one legacy-lane (Skillfile schema 1) node that no legacy marker can
+// record: every schema-9 installation, and every installation selected at
+// a repository subdirectory (core §4.4, skillfile-sources §4,
+// draft-sources-v2). A node with a canonical network identity records the
+// network-git arm with the normalized selected directory; a node from a
+// local configured source records the configured-git arm, whose directory
+// is always "." — roots select "." by construction, and a subdirectory
+// selection without a network identity is refused instead of recorded
+// with a directory the arm forbids.
+func legacyMarkerPackage(node *closure.Node) (*marker.Package, string, error) {
+	directory := node.Directory
+	if directory == "" {
+		directory = "."
+	}
+	format, err := legacyCommitFormat(node.Resolved.Commit)
+	if err != nil {
+		return nil, "", fmt.Errorf("source_member_invalid: locked commit for %s is not a full object id: %w", node.Name, err)
+	}
+	commit := &marker.Commit{ObjectFormat: format, Hex: node.Resolved.Commit}
+	var pkg *marker.Package
+	if node.Identity != "" {
+		pkg = &marker.Package{
+			Kind:       "network-git",
+			Repository: node.Identity,
+			Commit:     commit,
+			Directory:  directory,
+		}
+	} else {
+		if directory != "." {
+			return nil, "", fmt.Errorf("source_selection_invalid: selecting a repository subdirectory for %s requires a canonical network repository identity", node.Name)
+		}
+		pkg = &marker.Package{
+			Kind:      "configured-git",
+			Source:    node.Decl.Source,
+			Commit:    commit,
+			Directory: ".",
+		}
+	}
+	binding, err := legacyLockDigest(node, pkg)
+	if err != nil {
+		return nil, "", err
+	}
+	return pkg, binding, nil
+}
+
+// legacyCommitFormat resolves the locked-commit object format from the
+// resolved commit hex: 40 lowercase hex is sha1, 64 is sha256. Anything
+// else is not a locked object the package arms can carry.
+func legacyCommitFormat(commit string) (string, error) {
+	raw, err := hex.DecodeString(commit)
+	if err != nil || hex.EncodeToString(raw) != commit {
+		if err == nil {
+			err = fmt.Errorf("commit %q is not lowercase hex", commit)
+		}
+		return "", err
+	}
+	switch len(raw) {
+	case 20:
+		return "sha1", nil
+	case 32:
+		return "sha256", nil
+	default:
+		return "", fmt.Errorf("length %d is neither sha1 nor sha256", len(raw))
+	}
+}
+
+// legacyLockDigest binds the installed selection and declared ref of one
+// legacy-lane package marker. The digest is deterministic across runs, so
+// status compares it exactly like a draft-lane lock generation.
+func legacyLockDigest(node *closure.Node, pkg *marker.Package) (string, error) {
+	preimage := legacyLockBinding{
+		Name:      node.Name,
+		Kind:      pkg.Kind,
+		Directory: pkg.Directory,
+		RefKind:   node.Decl.Ref.Kind,
+		Ref:       node.Decl.Ref.Value,
+	}
+	switch pkg.Kind {
+	case "network-git":
+		preimage.Repository = pkg.Repository
+	case "configured-git":
+		preimage.Source = pkg.Source
+	}
+	if pkg.Commit != nil {
+		preimage.ObjectFormat = pkg.Commit.ObjectFormat
+		preimage.Hex = pkg.Commit.Hex
+	}
+	payload, err := json.Marshal(preimage)
+	if err != nil {
+		return "", fmt.Errorf("source_member_invalid: cannot bind the package selection of %s: %w", node.Name, err)
+	}
+	sum := sha256.Sum256(payload)
+	return "sha256:" + hex.EncodeToString(sum[:]), nil
+}
