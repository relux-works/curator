+	second := e.install(Options{})
+	if second.Status != "ok" {
+		t.Fatalf("second: %+v", second)
+	}
+	if joined := strings.Join(second.Messages, "\n"); !strings.Contains(joined, "up-to-date") {
+		t.Fatalf("second install must be up-to-date:\n%s", joined)
+	}
+}
