+	for skill, want := range map[string]string{"backend": "skills/backend", "helper": "skills/helper", "consumer": "."} {
+		if audited[skill] != want {
+			t.Fatalf("audit record for %s binds directory %q, want %q (records: %v)", skill, audited[skill], want, audited)
+		}
