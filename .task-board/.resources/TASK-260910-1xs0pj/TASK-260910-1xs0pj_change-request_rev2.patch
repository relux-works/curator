+// registry attestation the effective plan selected and a legacy
+// development-substitution identifier.
+func v5GitAttestedMarker() *Marker {
+	m := v5GitMarker()
+	m.Source = "review"
+	m.Git = "https://example.org/kit.git"
+	m.RefKind = "tag"
+	m.Ref = "v1"
+	m.Commit = strings.Repeat("44", 20)
+	m.Attestation = &Attestation{Registry: "example.org/kit", Status: "audited", KeyID: "0123456789abcdef"}
+	m.Substituted = "dev:review"
+	m.Requirements = []string{"dep"}
+	m.McpServers = map[string][]string{"srv": {"tool"}}
+	return m
+}
+
+// v5GitAttestedConfiguredMarker is the configured-git arm: no network
+// endpoint, so no git member, but the same preserved ref identity.
+func v5GitAttestedConfiguredMarker() *Marker {
+	m := v5GitAttestedMarker()
+	m.Package = &Package{
+		Kind:      "configured-git",
+		Source:    "vendor/kit",
+		Commit:    &Commit{ObjectFormat: "sha1", Hex: strings.Repeat("55", 20)},
+		Directory: ".",
+	}
+	m.Source = "vendor/kit"
+	m.Git = ""
+	m.Commit = strings.Repeat("55", 20)
+	return m
+}
+
+// TestMarkerV5GitRoundTrip pins the 25-field v4 migration for the Git arms:
+// the frozen package binds the selection, the lock binds the generation,
+// and the accepted declared identity — source, endpoint and ref triple —
+// rides alongside the package exactly as the install status, moved-tag and
+// attestation readers compare it. Every retained field keeps its meaning,
+// including attestation and substituted for eligible Git packages.
+func TestMarkerV5GitRoundTrip(t *testing.T) {
+	for name, marker := range map[string]*Marker{
+		"network-git":    v5GitAttestedMarker(),
+		"configured-git": v5GitAttestedConfiguredMarker(),
+	} {
+		t.Run(name, func(t *testing.T) {
+			dir, recorded := writeV5(t, marker)
+			if recorded.SchemaVersion != SchemaV5 {
+				t.Fatalf("schema = %d, want %d", recorded.SchemaVersion, SchemaV5)
+			}
+			if recorded.Package == nil || !packageEqual(recorded.Package, marker.Package) {
+				t.Fatalf("package = %+v, want %+v", recorded.Package, marker.Package)
+			}
+			if recorded.Source != marker.Source || recorded.Git != marker.Git ||
+				recorded.RefKind != marker.RefKind || recorded.Ref != marker.Ref ||
+				recorded.Commit != marker.Commit {
+				t.Fatalf("identity = %q %q %s %s %s, want %q %q %s %s %s",
+					recorded.Source, recorded.Git, recorded.RefKind, recorded.Ref, recorded.Commit,
+					marker.Source, marker.Git, marker.RefKind, marker.Ref, marker.Commit)
+			}
+			if recorded.Attestation == nil || *recorded.Attestation != *marker.Attestation {
+				t.Fatalf("attestation = %+v, want %+v", recorded.Attestation, marker.Attestation)
+			}
+			if recorded.Substituted != marker.Substituted {
+				t.Fatalf("substituted = %q, want %q", recorded.Substituted, marker.Substituted)
+			}
+			payload, err := os.ReadFile(filepath.Join(dir, Name))
+			if err != nil {
+				t.Fatal(err)
+			}
+			var raw map[string]json.RawMessage
+			if err := json.Unmarshal(payload, &raw); err != nil {
+				t.Fatal(err)
+			}
+			// The preserved identity rides alongside the package binding.
+			for _, field := range []string{"source", "ref_kind", "ref", "commit"} {
+				if _, present := raw[field]; !present {
+					t.Fatalf("v5 Git marker misses preserved field %q", field)
+				}
+			}
+			if _, present := raw["git"]; present != (marker.Git != "") {
+				t.Fatalf("v5 Git marker git presence = %v, want endpoint %q", present, marker.Git)
+			}
+			// Every retained migration-table field is present.
+			for _, field := range []string{
+				"schema_version", "name", "package", "lock_sha256", "content_sha256", "locale",
+				"agents", "commands", "dependencies", "skill_schema_version", "runtime_roots",
+				"build_roots", "builds", "installed_at", "files",
+				"requirements", "mcp_servers", "attestation", "activation", "requirers", "substituted",
+			} {
+				if _, present := raw[field]; !present {
+					t.Fatalf("v5 Git marker misses retained field %q", field)
+				}
+			}
+			// An identical restaging is current: the attested Git package
+			// with a matching summary satisfies currentness when every
+			// other comparison passes (attested-network-current).
+			fresh := *marker
+			fresh.ContentSHA256 = recorded.ContentSHA256
+			fresh.Files = append([]string(nil), recorded.Files...)
+			if current, err := Current(dir, &fresh); err != nil || !current {
+				t.Fatalf("Current = %v, %v, want true", current, err)
+			}
+		})
+	}
+}
+
+func packageEqual(a, b *Package) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	if a.Kind != b.Kind || a.Snapshot != b.Snapshot || a.Repository != b.Repository ||
+		a.Source != b.Source || a.Directory != b.Directory {
+		return false
+	}
+	if a.Commit == nil || b.Commit == nil {
+		return a.Commit == b.Commit
+	}
+	return *a.Commit == *b.Commit
+}
+
+// TestMarkerV5GitIdentityValidation proves the preserved Git identity is
+// all-or-nothing under the legacy grammar at the writer, and that the
+// reader refuses the same shapes from foreign bytes that bypassed Write:
+// a partial triple, an unknown ref kind, an empty ref, a malformed
+// commit and a non-portable source are all refused, never read back.
+func TestMarkerV5GitIdentityValidation(t *testing.T) {
+	valid := v5GitAttestedMarker()
+	cases := map[string]func(*Marker){
+		"missing-ref-kind": func(m *Marker) { m.RefKind = "" },
+		"missing-ref":      func(m *Marker) { m.Ref = "" },
+		"missing-commit":   func(m *Marker) { m.Commit = "" },
+		"bad-ref-kind":     func(m *Marker) { m.RefKind = "bookmark" },
+		"malformed-commit": func(m *Marker) { m.Commit = "sha256:" + strings.Repeat("44", 20) },
+		"short-commit":     func(m *Marker) { m.Commit = "abcd" },
+		"bad-source":       func(m *Marker) { m.Source = "/absolute/path" },
+	}
+	for name, mutate := range cases {
+		t.Run("write/"+name, func(t *testing.T) {
+			m := *valid
+			mutate(&m)
+			if err := Write(t.TempDir(), &m); err == nil {
+				t.Fatalf("Write admitted a v5 Git marker with %s", name)
+			}
+		})
+		t.Run("read/"+name, func(t *testing.T) {
+			dir, _ := writeV5(t, v5GitAttestedMarker())
+			rewriteV5Members(t, dir, func(raw map[string]json.RawMessage) {
+				m := *valid
+				mutate(&m)
+				setOrDelete(t, raw, "source", m.Source)
+				setOrDelete(t, raw, "ref_kind", m.RefKind)
+				setOrDelete(t, raw, "ref", m.Ref)
+				setOrDelete(t, raw, "commit", m.Commit)
+			})
+			if got := Read(dir); got != nil {
+				t.Fatalf("Read admitted a v5 Git marker with %s: %+v", name, got)
+			}
+			expected := *valid
+			if current, _ := Current(dir, &expected); current {
+				t.Fatalf("Current stayed true for a v5 Git marker with %s", name)
+			}
+		})
+	}
+	// Present-but-empty and null members can only come from foreign
+	// bytes: Write omits empty fields, so these rows bypass it.
+	for name, member := range map[string]string{
+		"empty-source":  `"source":""`,
+		"null-source":   `"source":null`,
+		"empty-ref":     `"ref":""`,
+		"null-ref-kind": `"ref_kind":null`,
+		"null-commit":   `"commit":null`,
+	} {
+		t.Run("read/"+name, func(t *testing.T) {
+			dir, _ := writeV5(t, v5GitAttestedMarker())
+			rewriteV5Members(t, dir, func(raw map[string]json.RawMessage) {
+				var edit map[string]json.RawMessage
+				if err := json.Unmarshal([]byte("{"+member+"}"), &edit); err != nil {
+					t.Fatal(err)
+				}
+				for field, value := range edit {
+					raw[field] = value
+				}
+			})
+			if got := Read(dir); got != nil {
+				t.Fatalf("Read admitted a v5 Git marker with %s: %+v", name, got)
+			}
+			expected := *valid
+			if current, _ := Current(dir, &expected); current {
+				t.Fatalf("Current stayed true for a v5 Git marker with %s", name)
+			}
+		})
+	}
+	// A pure package binding without any preserved identity stays
+	// readable: trunk writes Git v5 markers without legacy fields and
+	// the builder stages one when the node resolves no complete ref.
+	t.Run("pure-package-control", func(t *testing.T) {
+		m := v5GitMarker()
+		_, recorded := writeV5(t, m)
+		if recorded.Package == nil || recorded.Package.Kind != "network-git" {
+			t.Fatalf("package = %+v, want the network-git binding", recorded.Package)
+		}
+		if recorded.RefKind != "" || recorded.Ref != "" || recorded.Commit != "" {
+			t.Fatalf("identity = %s %s %s, want empty", recorded.RefKind, recorded.Ref, recorded.Commit)
+		}
+	})
+}
+
+// rewriteV5Members rewrites a recorded marker with top-level members
+// replaced exactly as edit leaves them, bypassing Write so the document
+// carries exactly the bytes a foreign writer could produce.
+func rewriteV5Members(t *testing.T, dir string, edit func(map[string]json.RawMessage)) {
+	t.Helper()
+	payload, err := os.ReadFile(filepath.Join(dir, Name))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var raw map[string]json.RawMessage
+	if err := json.Unmarshal(payload, &raw); err != nil {
+		t.Fatal(err)
+	}
+	edit(raw)
+	rewritten, err := json.Marshal(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, Name), rewritten, 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// setOrDelete encodes value as a JSON string member, deleting the member
+// when value is empty so the bytes distinguish "absent" from "empty".
+// Tests that need a present-but-empty member encode it directly.
+func setOrDelete(t *testing.T, raw map[string]json.RawMessage, member, value string) {
+	t.Helper()
+	if value == "" {
+		delete(raw, member)
+		return
+	}
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw[member] = encoded
+}
+
+// TestMarkerV5PlanMismatch proves every marker-plan mismatch case is
+// non-current: changed registry, status, key, substitution identifier,
+// declared ref, package or lock against the effective plan refuses currency.
+func TestMarkerV5PlanMismatch(t *testing.T) {
+	base := v5GitAttestedMarker()
+	dir, _ := writeV5(t, base)
+	control := v5GitAttestedMarker()
+	control.ContentSHA256 = base.ContentSHA256
+	control.Files = append([]string(nil), base.Files...)
+	if current, err := Current(dir, control); err != nil || !current {
+		t.Fatalf("control Current = %v, %v, want true", current, err)
+	}
+	cases := map[string]func(*Marker){
+		"registry": func(m *Marker) { m.Attestation.Registry = "example.org/other" },
+		"status":   func(m *Marker) { m.Attestation.Status = "deprecated" },
+		"key_id":   func(m *Marker) { m.Attestation.KeyID = "fedcba9876543210" },
+		"attestation-absent": func(m *Marker) {
+			m.Attestation = nil
+		},
+		"substituted": func(m *Marker) { m.Substituted = "dev:other" },
+		"substituted-absent": func(m *Marker) {
+			m.Substituted = ""
+		},
+		"ref":      func(m *Marker) { m.Ref = "v2" },
+		"ref-kind": func(m *Marker) { m.RefKind = "branch" },
+		"commit":   func(m *Marker) { m.Commit = strings.Repeat("77", 20) },
+		"package": func(m *Marker) {
+			m.Package = &Package{Kind: "network-git", Repository: "example.org/kit",
+				Commit: &Commit{ObjectFormat: "sha1", Hex: strings.Repeat("66", 20)}, Directory: "skills/review"}
+		},
+		"lock_sha256": func(m *Marker) { m.LockSHA256 = "sha256:" + strings.Repeat("00", 32) },
+	}
+	for name, mutate := range cases {
+		t.Run(name, func(t *testing.T) {
+			fresh := v5GitAttestedMarker()
+			fresh.ContentSHA256 = base.ContentSHA256
+			fresh.Files = append([]string(nil), base.Files...)
+			attestation := *fresh.Attestation
+			fresh.Attestation = &attestation
+			mutate(fresh)
+			if current, err := Current(dir, fresh); err != nil || current {
+				t.Fatalf("Current = %v, %v across %s mismatch, want false", current, err, name)
+			}
+		})
+	}
+}
