+// TestDraftGitMarkerIdentityRoundTrip is the Git-arm identity regression
+// row: the marker a real install.Project records reads the declared
+// identity back through the production marker reader, the currentness
+// reader holds it current for an identical restaging and refuses it when
+// the declared ref moves, so a recorded summary reports idempotence
+// without ever authorizing a changed selection.
+func TestDraftGitMarkerIdentityRoundTrip(t *testing.T) {
+	project, home, _, _ := setupGitInstall(t)
+	result := draftRealInstall(t, project, home, Options{})
+	if result.Status != "ok" {
+		t.Fatalf("install = %+v", result)
+	}
+	lock, err := sourcelock.Read(sourcelock.PathIn(project))
+	if err != nil {
+		t.Fatal(err)
+	}
+	member, ok := lock.Find("review")
+	if !ok {
+		t.Fatal("lock misses review")
+	}
+	installed := filepath.Join(project, ".agents", "skills", "review")
+	recorded := marker.Read(installed)
+	if recorded == nil {
+		t.Fatalf("installed marker unreadable in %s", installed)
+	}
+	if recorded.SchemaVersion != marker.SchemaV5 {
+		t.Fatalf("schema = %d, want %d", recorded.SchemaVersion, marker.SchemaV5)
+	}
+	if recorded.RefKind != "tag" || recorded.Ref != "v1" || recorded.Commit != member.Package.Commit.Hex {
+		t.Fatalf("marker identity = %s %s %s, want tag v1 %s",
+			recorded.RefKind, recorded.Ref, recorded.Commit, member.Package.Commit.Hex)
+	}
+	if recorded.Source != "review" || recorded.Git != "https://example.org/kit.git" {
+		t.Fatalf("marker source = %q git = %q, want review https://example.org/kit.git",
+			recorded.Source, recorded.Git)
+	}
+	identical := *recorded
+	if current, err := marker.Current(installed, &identical); err != nil || !current {
+		t.Fatalf("Current = %v, %v, want true for an identical restaging", current, err)
+	}
+	movedRef := *recorded
+	movedRef.Ref = "v2"
+	if current, err := marker.Current(installed, &movedRef); err != nil || current {
+		t.Fatalf("Current = %v, %v across a declared-ref move, want false", current, err)
+	}
+}
