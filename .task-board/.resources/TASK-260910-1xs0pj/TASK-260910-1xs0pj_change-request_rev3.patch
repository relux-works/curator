+func draftRealInstall(t *testing.T, project, home string, opts Options) Result {
+	t.Helper()
+	cfg := draftTestConfig(home, t.TempDir())
+	opts.DraftSourcesV1 = true
+	opts.Platform = installPlatform()
+	return Project(cfg, project, "test", opts)
+}
