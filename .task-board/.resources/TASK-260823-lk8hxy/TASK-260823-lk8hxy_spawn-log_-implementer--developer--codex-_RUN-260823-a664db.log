diff --git a/.temp/TASK-260823-lk8hxy/worktree/internal/fsunicode/fsunicode_test.go b/.temp/TASK-260823-lk8hxy/worktree/internal/fsunicode/fsunicode_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..0351b0e49af7dad9f010c8f301089406446255bc
--- /dev/null
+++ b/.temp/TASK-260823-lk8hxy/worktree/internal/fsunicode/fsunicode_test.go
@@ -0,0 +1,12 @@
+package fsunicode
+
+import "testing"
+
+func TestValidRejectsMalformedUTF8(t *testing.T) {
+	if Valid(string([]byte{0xff})) {
+		t.Fatal("malformed UTF-8 was accepted as a lossless filesystem string")
+	}
+	if !Valid("valid/é") {
+		t.Fatal("valid Unicode filesystem string was rejected")
+	}
+}
diff --git a/.temp/TASK-260823-lk8hxy/worktree/internal/fsunicode/fsunicode_windows.go b/.temp/TASK-260823-lk8hxy/worktree/internal/fsunicode/fsunicode_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..f51501daaeea995d9832c25161c506195c3f1f42
--- /dev/null
+++ b/.temp/TASK-260823-lk8hxy/worktree/internal/fsunicode/fsunicode_windows.go
@@ -0,0 +1,18 @@
+//go:build windows
+
+package fsunicode
+
+import (
+	"strings"
+	"unicode/utf8"
+)
+
+func platformValid(value string) bool {
+	// Windows filesystem APIs expose names as UTF-16. Go replaces an unpaired
+	// surrogate with U+FFFD while converting that name to string, so accepting
+	// U+FFFD here could admit a path whose original scalar spelling was lost.
+	// A literal U+FFFD is indistinguishable after conversion and is therefore
+	// rejected too: portable identities must fail closed rather than hash a
+	// laundered spelling.
+	return !strings.ContainsRune(value, utf8.RuneError)
+}
diff --git a/.temp/TASK-260823-lk8hxy/worktree/internal/fsunicode/fsunicode_windows_test.go b/.temp/TASK-260823-lk8hxy/worktree/internal/fsunicode/fsunicode_windows_test.go
