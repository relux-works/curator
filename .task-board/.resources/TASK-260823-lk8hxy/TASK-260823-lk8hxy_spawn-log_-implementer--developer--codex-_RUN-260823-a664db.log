diff --git a/.temp/TASK-260823-lk8hxy/worktree/internal/fsunicode/fsunicode.go b/.temp/TASK-260823-lk8hxy/worktree/internal/fsunicode/fsunicode.go
new file mode 100644
index 0000000000000000000000000000000000000000..1f9f78b67d21d31219456bce70462019cb0e3eeb
--- /dev/null
+++ b/.temp/TASK-260823-lk8hxy/worktree/internal/fsunicode/fsunicode.go
@@ -0,0 +1,11 @@
+// Package fsunicode validates filesystem strings before they enter portable
+// protocol identities.
+package fsunicode
+
+import "unicode/utf8"
+
+// Valid reports whether value can be trusted as the lossless Unicode spelling
+// of a filesystem name on the current platform.
+func Valid(value string) bool {
+	return utf8.ValidString(value) && platformValid(value)
+}
