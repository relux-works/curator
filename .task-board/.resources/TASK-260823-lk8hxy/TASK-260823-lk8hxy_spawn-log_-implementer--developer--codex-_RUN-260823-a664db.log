    if [ "$_curator_prompt_present" = "0" ]; then
      PROMPT_COMMAND=("_curator_auto_env" "${PROMPT_COMMAND[@]}")
    fi
    unset _curator_prompt_present
    unset _curator_prompt_entry
    ;;
  *)
    case ";${PROMPT_COMMAND:-};" in
