@@ -0,0 +1,128 @@
+package crossconformance
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// draftEndpointGitShim replaces clone/fetch operations addressed to endpoint
+// with a local bare repository. It records network operations and refuses any
+// fetch through a stored remote, making endpoint-selection tests deterministic
+// and offline on every hosted OS. An empty endpoint makes every clone fail
+// closed, which is used by zero-I/O policy refusals.
+func draftEndpointGitShim(t *testing.T, endpoint, bare string, fail bool) ([]string, string) {
+	t.Helper()
+	realGit, err := exec.LookPath("git")
+	if err != nil {
+		t.Fatal(err)
+	}
+	shimDir := t.TempDir()
+	logPath := filepath.Join(shimDir, "fetches.log")
+	sourcePath := filepath.Join(shimDir, "git-shim.go")
+	shimName := "git"
+	if runtime.GOOS == "windows" {
+		shimName += ".exe"
+	}
+	shimPath := filepath.Join(shimDir, shimName)
+	source := fmt.Sprintf(`package main
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+)
+const endpoint = %s
+const mappedRepository = %s
+const realGit = %s
+const logPath = %s
+const failFetch = %t
+func main() {
+	args := append([]string(nil), os.Args[1:]...)
+	isFetch, isClone, hasEndpoint := false, false, false
+	for _, arg := range args {
+		if arg == "fetch" { isFetch = true }
+		if arg == "clone" { isClone = true }
+		if arg == endpoint { hasEndpoint = true }
+	}
+	if isFetch {
+		file, err := os.OpenFile(logPath, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+		if err != nil { fmt.Fprintln(os.Stderr, err); os.Exit(128) }
+		_, _ = fmt.Fprintln(file, strings.Join(args, "\t"))
+		_ = file.Close()
+		if !hasEndpoint {
+			fmt.Fprintln(os.Stderr, "fatal: test shim refused fetch through a stored remote")
+			os.Exit(128)
+		}
+		if failFetch {
+			fmt.Fprintf(os.Stderr, "fatal: unable to access '%%s': Could not resolve host: unreachable.fixture.test\n", endpoint)
+			os.Exit(128)
+		}
+	}
+	if isClone {
+		file, err := os.OpenFile(logPath, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+		if err != nil { fmt.Fprintln(os.Stderr, err); os.Exit(128) }
+		_, _ = fmt.Fprintln(file, strings.Join(args, "\t"))
+		_ = file.Close()
+		if endpoint == "" {
+			fmt.Fprintln(os.Stderr, "fatal: test shim refused an unexpected clone")
+			os.Exit(128)
+		}
+	}
+	if (isFetch || isClone) && hasEndpoint {
+		for i, arg := range args { if arg == endpoint { args[i] = mappedRepository } }
+	}
+	cmd := exec.Command(realGit, args...)
+	cmd.Stdin, cmd.Stdout, cmd.Stderr = os.Stdin, os.Stdout, os.Stderr
+	if err := cmd.Run(); err != nil {
+		if exit, ok := err.(*exec.ExitError); ok { os.Exit(exit.ExitCode()) }
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(128)
+	}
+}
+`, strconv.Quote(endpoint), strconv.Quote(bare), strconv.Quote(realGit), strconv.Quote(logPath), fail)
+	if err := os.WriteFile(sourcePath, []byte(source), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	build := exec.Command("go", "build", "-o", shimPath, sourcePath)
+	if output, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("build Git test shim: %v\n%s", err, output)
+	}
+	if err := os.Chmod(shimPath, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	path := shimDir + string(os.PathListSeparator) + os.Getenv("PATH")
+	return []string{"PATH=" + path}, logPath
+}
+
+func draftRepoDirForTest(home, projectRoot, alias string) string {
+	abs, err := filepath.Abs(projectRoot)
+	if err != nil {
+		abs = projectRoot
+	}
+	sum := sha256Sum([]byte(abs + "\x00" + alias))
+	return filepath.Join(home, "draft-git", sum[:16]+"-"+alias)
+}
+
+func sha256Sum(payload []byte) string {
+	sum := sha256.Sum256(payload)
+	return fmt.Sprintf("%x", sum[:])
+}
+
+func readDraftFetchLog(t *testing.T, path string) string {
+	t.Helper()
+	payload, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return ""
+		}
+		t.Fatal(err)
+	}
+	return strings.TrimSpace(string(payload))
+}
