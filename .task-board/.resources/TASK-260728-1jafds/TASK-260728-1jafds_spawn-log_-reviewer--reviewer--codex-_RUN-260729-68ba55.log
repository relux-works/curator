function u64(n) { const b=Buffer.alloc(8); b.writeBigUInt64BE(BigInt(n)); return b; }
function frame(s) { const b=Buffer.from(s,'utf8'); return Buffer.concat([u64(b.length), b]); }
function digest(f) {
  const chunks=[Buffer.from('curator-hardened-host-build-v1','ascii'), Buffer.from([0]), frame(f.host_identity), frame(f.host_version), frame(f.identifier), u64(f.sources.length)];
  for (const s of f.sources) chunks.push(frame(s.name), frame(s.value));
  return 'sha256:'+crypto.createHash('sha256').update(Buffer.concat(chunks)).digest('hex');
}
