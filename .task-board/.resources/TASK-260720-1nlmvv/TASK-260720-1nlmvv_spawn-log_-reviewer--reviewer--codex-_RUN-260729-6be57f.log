   748		if err := os.WriteFile(markerPath, []byte(`{"schema_version":2}`), 0o644); err != nil {
   749			t.Fatal(err)
   750		}
   751		before := markerDigests(store)
   752		if markerMoved(before, markerDigests(store), installed) {
   753			t.Fatal("an unchanged marker was reported as moved")
   754		}
   755		if err := os.WriteFile(markerPath, []byte(`{"schema_version":2,"name":"x"}`), 0o644); err != nil {
   756			t.Fatal(err)
   757		}
   758		if !markerMoved(before, markerDigests(store), installed) {
   759			t.Fatal("a rewritten marker was not reported as moved")
   760		}
   761		if err := os.Remove(markerPath); err != nil {
   762			t.Fatal(err)
   763		}
   764		if !markerMoved(before, markerDigests(store), installed) {
   765			t.Fatal("a removed marker was not reported as moved")
   766		}
   767	}
