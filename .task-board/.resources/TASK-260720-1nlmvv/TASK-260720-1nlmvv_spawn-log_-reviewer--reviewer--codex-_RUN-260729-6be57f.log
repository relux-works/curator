   568	// markerDigests fingerprints every install marker below the given stores, so a
   569	// classification can tell an operator that installed state moved underneath it
   570	// instead of publishing a verdict that was already stale when it was printed.
   571	func markerDigests(stores ...string) map[string]string {
   572		digests := map[string]string{}
   573		for _, store := range stores {
   574			entries, err := os.ReadDir(store)
   575			if err != nil {
   576				continue
   577			}
   578			for _, entry := range entries {
   579				path := filepath.Join(store, entry.Name(), marker.Name)
   580				payload, readErr := os.ReadFile(path) // #nosec G304 -- path derives from a manager-owned store
   581				if readErr != nil {
   582					digests[path] = "absent"
   583					continue
   584				}
   585				sum := sha256.Sum256(payload)
   586				digests[path] = hex.EncodeToString(sum[:])
   587			}
   588		}
   589		return digests
   590	}
