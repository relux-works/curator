   741	func TestMarkerDigestsDetectAConcurrentInstallMarkerChange(t *testing.T) {
   742		store := t.TempDir()
   743		installed := filepath.Join(store, "build-skill")
   744		if err := os.MkdirAll(installed, 0o755); err != nil {
   745			t.Fatal(err)
   746		}
