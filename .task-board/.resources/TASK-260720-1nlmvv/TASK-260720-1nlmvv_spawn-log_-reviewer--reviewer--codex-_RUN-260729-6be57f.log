   280	// cacheFingerprint digests every protected entry so a test can prove a refused
   281	// run left the live build cache byte-for-byte unchanged.
   282	func cacheFingerprint(t *testing.T, home string) string {
   283		t.Helper()
   284		digest := sha256.New()
   285		base := filepath.Join(home, "cache", "build")
   286		err := filepath.WalkDir(base, func(path string, entry os.DirEntry, err error) error {
   287			if err != nil {
   288				return err
   289			}
   290			relative, relErr := filepath.Rel(base, path)
   291			if relErr != nil {
   292				return relErr
   293			}
   294			digest.Write([]byte(relative + "\n"))
   295			if entry.IsDir() {
   296				return nil
   297			}
   298			payload, readErr := os.ReadFile(path) // #nosec G304 -- test fixture path
   299			if readErr != nil {
   300				return readErr
   301			}
   302			digest.Write(payload)
   303			return nil
   304		})
   305		if err != nil {
   306			t.Fatal(err)
   307		}
   308		return hex.EncodeToString(digest.Sum(nil))
   309	}
