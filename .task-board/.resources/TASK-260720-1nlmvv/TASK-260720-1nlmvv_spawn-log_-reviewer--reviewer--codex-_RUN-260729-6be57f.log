   513						[]byte(testCase.payload), 0o644); err != nil {
   514						t.Fatal(err)
   515					}
   516				}
   517				// Every payload here must still be refused by the reader itself: this
   518				// classification only explains a refusal, it never admits one.
   519				if marker.Read(installed) != nil {
   520					t.Fatalf("the marker reader accepted %q, so the case proves nothing", testCase.payload)
