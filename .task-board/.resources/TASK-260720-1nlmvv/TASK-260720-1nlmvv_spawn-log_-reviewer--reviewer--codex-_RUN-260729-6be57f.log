   333	// assertReverseRollback proves the restore sequence is the failing target
   334	// followed by every committed target in exact reverse commit order. A target
   335	// that had no prior state is skipped: there is nothing of it to put back.
   336	func (probe *commitProbe) assertReverseRollback(t *testing.T) {
   337		t.Helper()
   338		probe.mu.Lock()
   339		committed := append([]transaction.Event(nil), probe.committed...)
   340		rolled := append([]transaction.Event(nil), probe.rolled...)
   341		preimage := map[int]bool{}
   342		for index, existed := range probe.preimage {
   343			preimage[index] = existed
   344		}
   345		failed := probe.failed
   346		probe.mu.Unlock()
   347	
   348		if failed == nil {
   349			t.Fatal("the injected fault never fired")
   350		}
   351		var want []transaction.Event
   352		if preimage[failed.TargetIndex] {
   353			want = append(want, *failed)
   354		}
   355		for index := len(committed) - 1; index >= 0; index-- {
   356			want = append(want, committed[index])
   357		}
   358		if len(rolled) != len(want) {
   359			t.Fatalf("rolled back %d targets, want %d (the failing target plus %d committed)",
   360				len(rolled), len(want), len(committed))
   361		}
   362		for offset, event := range rolled {
   363			if event.Class != want[offset].Class || event.Identifier != want[offset].Identifier {
   364				t.Fatalf("rollback step %d restored %s/%s, want %s/%s (exact reverse order)",
   365					offset, event.Class, event.Identifier, want[offset].Class, want[offset].Identifier)
   366			}
   367		}
   368	}
