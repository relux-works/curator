   643			case repaired != "" && status == "ok":
   644				notice = fmt.Sprintf("rebuilt %s build cache state into a new protected entry; "+
   645					"the previous installation stayed in place until every gate, the private build, "+
   646					"and the journaled commit succeeded", repaired)
   647			case repaired != "":
   648				notice = fmt.Sprintf("did not repair %s build cache state; "+
   649					"the previous installation, its consumers, and the live build cache are unchanged", repaired)
   650			case build.Outcome == string(install.BuildUnsupported),
   651				build.Outcome == string(install.BuildToolchainUnavailable):
