   102	// currentnessCodes lists every stable code `status` can report, so a test can
   103	// prove the documented set and the reachable set are the same.
   104	func currentnessCodes() []string {
   105		return []string{
   106			stateUpToDate, stateNotInstalled, stateNeedsInstall, stateContentDrift, stateUnresolvable,
   107			stateInvalidMarker, stateUnsupportedMarker,
   108			buildCurrent, buildCommandDrift, buildContextExposed, buildSourceDrift, buildInputDrift,
