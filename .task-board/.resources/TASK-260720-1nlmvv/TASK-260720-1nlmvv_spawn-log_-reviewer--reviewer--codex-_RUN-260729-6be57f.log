    32	// capture runs one CLI invocation with both standard streams redirected.
    33	func capture(t *testing.T, args ...string) (int, string, string) {
    34		t.Helper()
    35		outReader, outWriter, err := os.Pipe()
    36		if err != nil {
    37			t.Fatal(err)
    38		}
    39		errReader, errWriter, err := os.Pipe()
    40		if err != nil {
    41			t.Fatal(err)
    42		}
    43		realOut, realErr := os.Stdout, os.Stderr
    44		os.Stdout, os.Stderr = outWriter, errWriter
    45	
    46		var stdout, stderr []byte
    47		var readers sync.WaitGroup
    48		readers.Add(2)
    49		go func() { defer readers.Done(); stdout, _ = io.ReadAll(outReader) }()
    50		go func() { defer readers.Done(); stderr, _ = io.ReadAll(errReader) }()
    51	
    52		code := run(args)
    53	
    54		os.Stdout, os.Stderr = realOut, realErr
    55		_ = outWriter.Close()
    56		_ = errWriter.Close()
    57		readers.Wait()
    58		return code, string(stdout), string(stderr)
    59	}
