    18	// BuildOutcome is the stable per-command planner vocabulary. The values match
    19	// the read-only protected-cache inspection exactly, so a plan never invents an
    20	// outcome the cache did not report.
    21	type BuildOutcome string
    22	
    23	const (
    24		// BuildCacheHit reuses a protected, exact cache entry. No source-aware Go
    25		// command runs for a hit.
    26		BuildCacheHit BuildOutcome = "cache-hit"
    27		// BuildWouldPreflightAndBuild is a cold miss: a real run preflights and
    28		// builds it privately.
    29		BuildWouldPreflightAndBuild BuildOutcome = "would-preflight-and-build"
    30		// BuildWouldRebuildUntrustedCache marks an entry whose protected provenance
    31		// no longer holds. A real run rebuilds it privately and never reuses it.
    32		BuildWouldRebuildUntrustedCache BuildOutcome = "would-rebuild-untrusted-cache"
    33		// BuildCorrupt marks a protected entry that cannot be interpreted. It is
    34		// never reused; a real run rebuilds it privately, and publication quarantines
    35		// the unusable entry rather than adopting or repairing it.
    36		BuildCorrupt BuildOutcome = "corrupt"
    37		// BuildUnsupported marks a platform that cannot protect the build cache. It
    38		// fails closed: without a provable boundary there is nowhere safe to publish
    39		// a rebuild either.
    40		BuildUnsupported BuildOutcome = "unsupported"
    41		// BuildToolchainUnavailable marks a command whose logical identity could not
    42		// be derived at all because the trusted Go toolchain could not be resolved or
    43		// verified. It fails closed and carries no target, key, or cache verdict.
    44		BuildToolchainUnavailable BuildOutcome = "toolchain-unavailable"
    45	)
    46	
    47	// buildable reports whether a real run must produce this command privately.
    48	// Every entry the manager refuses to reuse but can replace is buildable: that
    49	// is the whole repair path, because Curator has no separate repair command.
    50	func (outcome BuildOutcome) buildable() bool {
    51		return outcome == BuildWouldPreflightAndBuild ||
    52			outcome == BuildWouldRebuildUntrustedCache ||
    53			outcome == BuildCorrupt
    54	}
    55	
    56	// blocking reports whether the outcome fails the installation before any
    57	// persistent mutation. Only states a rebuild cannot resolve block.
    58	func (outcome BuildOutcome) blocking() bool {
    59		return outcome == BuildUnsupported || outcome == BuildToolchainUnavailable
    60	}
