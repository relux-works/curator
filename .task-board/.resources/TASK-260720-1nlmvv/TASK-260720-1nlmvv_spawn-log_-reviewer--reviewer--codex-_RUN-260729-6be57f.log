   592	// markerMoved reports whether the marker of one installed directory differs
   593	// between two fingerprints of the same stores.
   594	func markerMoved(before, after map[string]string, installedDir string) bool {
   595		path := filepath.Join(installedDir, marker.Name)
   596		return before[path] != after[path]
   597	}
