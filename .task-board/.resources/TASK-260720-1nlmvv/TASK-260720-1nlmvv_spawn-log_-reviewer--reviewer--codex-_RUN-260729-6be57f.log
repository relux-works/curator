   615	// factsList projects a whole plan onto the presentation view.
   616	func factsList(builds []install.PlannedBuild) []buildFacts {
   617		facts := make([]buildFacts, 0, len(builds))
   618		for _, build := range builds {
   619			facts = append(facts, factsOf(build))
   620		}
   621		return facts
   622	}
