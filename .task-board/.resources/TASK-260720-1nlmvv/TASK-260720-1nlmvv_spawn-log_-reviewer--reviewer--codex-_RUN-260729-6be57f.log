   662	// goToolchainGuidance renders operator guidance for a failed go-v1 trust
   663	// boundary. It names the complete accepted selection mechanisms and the tested
   664	// release families, and deliberately never suggests a PATH lookup or an
   665	// automatic toolchain download: neither is an accepted selection mechanism.
   666	func goToolchainGuidance(code string) string {
   667		selection := fmt.Sprintf(
   668			"select a trusted Go installation with %s=<GOROOT>/bin/go (bin/go.exe on Windows) or %s=<GOROOT>; "+
   669				"Curator never searches PATH and never downloads a toolchain",
   670			godriver.SelectionCuratorGo, godriver.SelectionGOROOT)
   671		families := "tested Go release families: " + strings.Join(godriver.TestedFamilies(), ", ")
   672	
   673		switch code {
   674		case "":
   675			return ""
   676		case "unsupported_go_family", "malformed_go_version":
   677			return "go-v1 " + code + ": the selected Go release is not tested against the go-v1 vectors; " +
   678				families + "; " + selection
   679		case "go_toolchain_missing", "untrusted_go_executable", "toolchain_executable_mismatch", "toolchain_mutated":
   680			return "go-v1 " + code + ": the trusted Go installation could not be resolved or verified; " +
   681				selection + "; " + families
   682		default:
   683			return "go-v1 " + code + ": the go-v1 build boundary refused this operation; " +
   684				selection + "; " + families
   685		}
   686	}

