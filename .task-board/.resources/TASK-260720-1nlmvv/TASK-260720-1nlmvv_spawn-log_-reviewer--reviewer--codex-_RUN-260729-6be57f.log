    52	// entryDigest reads one snapshot path exactly as it is. A symbolic link is
    53	// digested by its destination rather than dereferenced, so a mirror that was
    54	// replaced, re-pointed, or removed shows up as a change instead of resolving to
    55	// the same canonical bytes.
    56	func entryDigest(path string) string {
    57		info, err := os.Lstat(path)
    58		switch {
    59		case os.IsNotExist(err):
    60			return transaction.DigestAbsent
    61		case err != nil:
    62			return "unreadable:" + err.Error()
    63		case info.Mode()&os.ModeSymlink != 0:
    64			digest, err := transaction.DigestTarget(transaction.KindEntry, path)
    65			if err != nil {
    66				return "unreadable:" + err.Error()
    67			}
    68			return digest
    69		case !info.IsDir():
    70			digest, err := transaction.DigestPath(path)
    71			if err != nil {
    72				return "unreadable:" + err.Error()
    73			}
    74			return digest
    75		}
    76		// A directory may legitimately hold mirror links, which DigestPath refuses
    77		// inside a tree, so the tree is summarized entry by entry.
    78		entries, err := os.ReadDir(path)
    79		if err != nil {
    80			return "unreadable:" + err.Error()
    81		}
    82		parts := make([]string, 0, len(entries))
    83		for _, entry := range entries {
    84			parts = append(parts, entry.Name()+"="+entryDigest(filepath.Join(path, entry.Name())))
    85		}
    86		sort.Strings(parts)
    87		return "dir[" + strings.Join(parts, ",") + "]"
    88	}
