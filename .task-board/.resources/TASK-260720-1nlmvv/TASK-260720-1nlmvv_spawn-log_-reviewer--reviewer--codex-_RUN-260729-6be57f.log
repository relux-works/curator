   624	// repairedState names the compiled states install and upgrade repair by
   625	// rebuilding, in the operator's words. A state that is absent from this map is
   626	// either already current or one a rebuild cannot resolve.
   627	func repairedState(outcome string) string {
   628		switch install.BuildOutcome(outcome) {
   629		case install.BuildWouldRebuildUntrustedCache:
   630			return "untrusted"
   631		case install.BuildCorrupt:
   632			return "corrupt"
   633		default:
   634			return ""
   635		}
   636	}
   637	
   638	func repairNotices(alias string, builds []buildFacts, status string) []string {
   639		var notices []string
   640		for _, build := range builds {
   641			notice := ""
   642			switch repaired := repairedState(build.Outcome); {
   643			case repaired != "" && status == "ok":
   644				notice = fmt.Sprintf("rebuilt %s build cache state into a new protected entry; "+
   645					"the previous installation stayed in place until every gate, the private build, "+
   646					"and the journaled commit succeeded", repaired)
   647			case repaired != "":
   648				notice = fmt.Sprintf("did not repair %s build cache state; "+
   649					"the previous installation, its consumers, and the live build cache are unchanged", repaired)
   650			case build.Outcome == string(install.BuildUnsupported),
   651				build.Outcome == string(install.BuildToolchainUnavailable):
   652				notice = fmt.Sprintf("refused %s build state before any mutation; "+
   653					"the previous installation, its consumers, and the live build cache are unchanged", build.Outcome)
   654			default:
   655				continue
   656			}
   657			notices = append(notices, fmt.Sprintf("%s: %s.%s: %s", alias, build.Skill, build.Command, notice))
   658		}
   659		return notices
   660	}
