   186	// buildReport is one machine-readable compiled-command diagnostic. Every field
   187	// is either a portable identity, a protocol-relative path, or a stable code.
   188	type buildReport struct {
   189		Skill        string               `json:"skill"`
   190		Command      string               `json:"command"`
   191		Driver       string               `json:"driver"`
   192		BuildRoot    string               `json:"build_root,omitempty"`
   193		SourceDir    string               `json:"source_dir,omitempty"`
   194		BuildSource  buildsource.Identity `json:"build_source"`
   195		Target       string               `json:"target,omitempty"`
   196		CacheKey     string               `json:"cache_key"`
   197		ArtifactPath string               `json:"artifact_path,omitempty"`
   198		CacheOutcome string               `json:"cache_outcome,omitempty"`
   199		State        string               `json:"state"`
   200		// Cause is a stable subcode that refines State without widening the state
   201		// vocabulary. A build-input-drift row carries one of inputCauses(); an
   202		// unusable-build-toolchain row carries the go-v1 boundary code that refused
   203		// the operation. Every other state leaves it empty.
   204		Cause  string `json:"cause,omitempty"`
   205		Detail string `json:"detail,omitempty"`
   206	}
   207	
   208	// Describe renders one compiled-command diagnostic as a single report line in
   209	// the same shape the installation plan uses.
   210	func (report buildReport) Describe() string {
   211		line := fmt.Sprintf("%s.%s build driver=%s", report.Skill, report.Command, report.Driver)
   212		for _, field := range []struct{ name, value string }{
   213			{"root", report.BuildRoot},
   214			{"dir", report.SourceDir},
   215			{"source", buildSourceText(report.BuildSource)},
   216			{"target", report.Target},
   217			{"key", report.CacheKey},
   218			{"artifact", report.ArtifactPath},
   219			{"cache", report.CacheOutcome},
   220		} {
   221			if field.value != "" {
   222				line += " " + field.name + "=" + field.value
   223			}
   224		}
   225		line += " state=" + report.State
   226		if report.Cause != "" {
   227			line += " cause=" + report.Cause
   228		}
   229		if report.Detail != "" {
   230			line += fmt.Sprintf(" detail=%q", report.Detail)
   231		}
   232		return line
   233	}
   234	
   235	func buildSourceText(identity buildsource.Identity) string {
   236		if identity.Algorithm == "" && identity.ContentSHA256 == "" {
   237			return ""
   238		}
   239		return identity.Algorithm + ":" + identity.ContentSHA256
   240	}

