   582	// TestInstallAndUpgradeRepairCorruptCompiledState proves the reconciliation
   583	// path for a protected entry that cannot be interpreted at all: corrupt
   584	// receipt bytes and corrupt artifact bytes are rebuilt by install and by
   585	// upgrade, only after every gate has passed, and a run that fails leaves the
   586	// previous installation and the live cache exactly as they were.
   587	func TestInstallAndUpgradeRepairCorruptCompiledState(t *testing.T) {
   588		for _, command := range []string{"install", "upgrade"} {
   589			t.Run(command, func(t *testing.T) {
   590				project, home := compiledProject(t)
   591				if code, stdout, stderr := capture(t, "install", "app"); code != exitOK {
   592					t.Fatalf("install = %d\nstdout:\n%s\nstderr:\n%s", code, stdout, stderr)
   593				}
   594				installed := filepath.Join(project, ".agents", "skills", "build-skill")
   595				before := marker.Read(installed)
   596				if before == nil || len(before.Builds) != 1 {
   597					t.Fatalf("first install did not record compiled state: %+v", before)
   598				}
   599	
   600				for _, corruption := range []struct {
   601					name    string
   602					corrupt func(t *testing.T, home string)
   603				}{
   604					{"receipt bytes", corruptCacheReceipt},
   605					{"artifact bytes", corruptCacheArtifact},
   606				} {
   607					t.Run(corruption.name, func(t *testing.T) {
   608						corruption.corrupt(t, home)
   609						if code, stdout, _ := capture(t, "status", "app", "--json"); code != exitOK ||
   610							decodeStatus(t, stdout).Builds[0].State != buildCorruptCache {
   611							t.Fatalf("status did not report corrupt compiled state:\n%s", stdout)
   612						}
   613	
   614						// A gate that fails must refuse before the repair: the corrupt
   615						// entry, the installed marker, and the installed content are all
   616						// still exactly as this run found them.
   617						corruptedCache := cacheFingerprint(t, home)
   618						t.Setenv(godriver.SelectionCuratorGo, filepath.Join(t.TempDir(), "nowhere", "bin", "go"))
   619						if code, stdout, _ := capture(t, command, "app"); code != exitFail {
   620							t.Fatalf("%s without a usable toolchain = %d, want %d\n%s", command, code, exitFail, stdout)
   621						}
   622						if cacheFingerprint(t, home) != corruptedCache {
   623							t.Fatal("a refused run changed the live build cache")
   624						}
   625						if refused := marker.Read(installed); refused == nil ||
   626							refused.Builds["build-tool"] != before.Builds["build-tool"] {
   627							t.Fatalf("a refused run changed the previous compiled state: %+v", refused)
   628						}
   629						if _, err := os.Stat(filepath.Join(installed, "SKILL.md")); err != nil {
   630							t.Fatalf("a refused run removed the previous installation: %v", err)
   631						}
   632						t.Setenv(godriver.SelectionCuratorGo, "")
   633	
   634						code, stdout, stderr := capture(t, command, "app")
   635						if code != exitOK {
   636							t.Fatalf("repairing %s = %d\nstdout:\n%s\nstderr:\n%s", command, code, stdout, stderr)
   637						}
   638						if !strings.Contains(stdout, "rebuilt corrupt build cache state into a new protected entry") {
   639							t.Fatalf("%s did not report the repair:\n%s", command, stdout)
   640						}
   641						if code, _, _ := capture(t, "status", "app", "--check"); code != exitOK {
   642							t.Fatalf("status --check after repairing %s = %d, want %d", corruption.name, code, exitOK)
   643						}
   644						after := marker.Read(installed)
   645						if after == nil || after.Builds["build-tool"].CacheKey != before.Builds["build-tool"].CacheKey {
   646							t.Fatalf("a repair changed the logical key: %+v", after)
   647						}
   648						if len(cacheEntries(t, home)) != 1 {
   649							t.Fatalf("repair left %d live protected entries, want 1", len(cacheEntries(t, home)))
   650						}
   651					})
   652				}
   653			})
   654		}
   655	}
