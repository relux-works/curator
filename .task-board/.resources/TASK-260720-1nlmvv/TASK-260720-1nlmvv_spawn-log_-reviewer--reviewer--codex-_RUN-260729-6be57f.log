   552	// readDocumentation loads README.md, or reports that it is out of reach.
   553	//
   554	// A cross-compiled test binary is run outside the checkout on hosts without a
   555	// Go toolchain. A guard that belongs to the repository states plainly that it
   556	// did not run rather than failing for the absence of a tree it never had.
   557	func readDocumentation(t *testing.T) (string, bool) {
   558		t.Helper()
   559		documentationPath := filepath.Join("..", "..", "README.md")
   560		payload, err := os.ReadFile(documentationPath) // #nosec G304 -- fixed repository path
   561		if os.IsNotExist(err) {
   562			t.Skipf("%s is not reachable from this test binary", documentationPath)
   563			return "", false
   564		}
   565		if err != nil {
   566			t.Fatal(err)
   567		}
   568		return string(payload), true
   569	}
