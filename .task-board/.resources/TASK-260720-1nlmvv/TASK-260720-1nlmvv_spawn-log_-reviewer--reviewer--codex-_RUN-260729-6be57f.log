   165	// factsOf projects one planned build onto the presentation view. Only
   166	// protocol-relative paths and portable identities cross this boundary: the
   167	// absolute protected-cache artifact path of a hit stays inside the planner.
   168	func factsOf(build install.PlannedBuild) buildFacts {
   169		return buildFacts{
   170			Skill:       build.Skill(),
   171			Command:     build.Command(),
   172			Driver:      build.Driver(),
   173			BuildRoot:   build.BuildRoot(),
   174			SourceDir:   build.SourceDir(),
   175			Source:      build.Source(),
   176			Target:      build.Target(),
   177			CacheKey:    build.CacheKey(),
   178			Outcome:     string(build.Outcome()),
   179			Reason:      build.Reason(),
   180			Diagnostic:  build.DiagnosticCode(),
   181			ReceiptHash: build.ReceiptSHA256(),
   182			Artifact:    build.Artifact(),
   183		}
   184	}
