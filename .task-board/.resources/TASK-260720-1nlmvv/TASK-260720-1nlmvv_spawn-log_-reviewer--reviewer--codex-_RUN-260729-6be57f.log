   599	// printRepairNotices reports what a real installation did with compiled state
   600	// it was not allowed to reuse.
   601	//
   602	// Curator has no separate repair command: install and upgrade are the
   603	// reconciliation path. They rebuild a missing, corrupt, drifted, or untrusted
   604	// entry into new protected state after every declaration, closure, collision,
   605	// audit, registry, and moved-tag gate has already passed, and they never adopt
   606	// candidate bytes by changing permissions or rewriting a marker. These notices
   607	// state which of the two happened, so an operator can see that a failed run
   608	// left the previous installation in place.
   609	func printRepairNotices(result install.Result) {
   610		for _, notice := range repairNotices(result.Alias, factsList(result.Builds), result.Status) {
   611			fmt.Println(notice)
   612		}
   613	}
