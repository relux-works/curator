   769	// TestStatusReportMarksCompiledStateThatMovedDuringTheCheck proves the whole
   770	// classification window is guarded: a marker that differs from the fingerprint
   771	// the run started with makes every verdict for that skill stale rather than
   772	// authoritative, and the scope fails --check.
   773	func TestStatusReportMarksCompiledStateThatMovedDuringTheCheck(t *testing.T) {
   774		project := t.TempDir()
   775		cfg := &config.Config{Path: filepath.Join(t.TempDir(), "home", "config.json"), SkillsRoot: t.TempDir()}
   776		installed := filepath.Join(project, ".agents", "skills", "build-skill")
   777		writeCompiledMarker(t, installed)
   778		facts := []buildFacts{testFacts(string(install.BuildCacheHit))}
   779	
   780		settled := markerDigests(statusStores(cfg, project)...)
   781		_, rows := statusReport(cfg, project, facts, settled)
   782		if len(rows) != 1 || rows[0].State != buildCurrent {
   783			t.Fatalf("settled compiled state = %+v", rows)
   784		}
   785	
   786		// The marker really does move between the two fingerprints, exactly as a
   787		// concurrent install would move it.
   788		rewriteMarker(t, installed, func(object map[string]any) { object["ref"] = "v2" })
   789		drift, rows := statusReport(cfg, project, facts, settled)
   790		if len(rows) != 1 || rows[0].State != buildStateChanged {
   791			t.Fatalf("moved compiled state = %+v", rows)
   792		}
   793		if !checkFailed(drift, rows) {
   794			t.Fatal("compiled state that moved during the check passed --check")
   795		}
   796	}
