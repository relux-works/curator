   549	func unionKeys(recorded map[string]marker.Build, planned map[string]buildFacts) []string {
   550		seen := map[string]bool{}
   551		var names []string
   552		for name := range recorded {
   553			if !seen[name] {
   554				seen[name] = true
   555				names = append(names, name)
   556			}
   557		}
   558		for name := range planned {
   559			if !seen[name] {
   560				seen[name] = true
   561				names = append(names, name)
   562			}
   563		}
   564		sort.Strings(names)
   565		return names
   566	}
