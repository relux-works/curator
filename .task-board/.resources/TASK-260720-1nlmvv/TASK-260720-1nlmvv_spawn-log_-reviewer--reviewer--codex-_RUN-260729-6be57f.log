   311	func cacheEntries(t *testing.T, home string) []string {
   312		t.Helper()
   313		base := filepath.Join(home, "cache", "build", "go-v1")
   314		entries, err := os.ReadDir(base)
   315		if err != nil {
   316			t.Fatalf("protected build cache is missing: %v", err)
   317		}
   318		var paths []string
   319		for _, entry := range entries {
   320			if entry.IsDir() && !strings.HasPrefix(entry.Name(), ".") {
   321				paths = append(paths, filepath.Join(base, entry.Name()))
   322			}
   323		}
   324		return paths
   325	}
