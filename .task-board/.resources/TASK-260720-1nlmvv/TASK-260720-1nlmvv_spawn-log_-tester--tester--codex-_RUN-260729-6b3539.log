// TestToolchainFailurePlansAnInventoryOfEveryActiveCommand pins the other
// failure that must still describe compiled state: when the trusted toolchain
// boundary refuses, no logical identity exists for any command, but every
// active command is still reported — with the stable boundary code and without
// inventing a target, key, or cache verdict it never derived.
func TestToolchainFailurePlansAnInventoryOfEveryActiveCommand(t *testing.T) {
	e := newEnv(t)
	e.buildSkill("build-skill", "alpha")
	e.declare("build-skill")
	deps, toolchain, cache, builder := newFakeDeps(t)
	toolchain.probeErr = &godriver.Diagnostic{
		Code: "go_toolchain_missing", Detail: "trusted GOROOT is unusable",
	}

	result := e.install(Options{Build: deps, DryRun: true})
	if result.Status != "failed" {
		t.Fatalf("dry-run status = %q, want failed", result.Status)
	}
	if len(cache.inspected) != 0 || len(builder.calls) != 0 {
		t.Fatalf("a refused toolchain still touched the cache or builder: %v %v", cache.inspected, builder.calls)
	}
	if len(result.Builds) != 1 {
		t.Fatalf("plan did not inventory the active command: %+v", result.Builds)
	}
	row := result.Builds[0]
	if row.Outcome() != BuildToolchainUnavailable || row.DiagnosticCode() != "go_toolchain_missing" {
		t.Fatalf("inventory row = %q / %q", row.Outcome(), row.DiagnosticCode())
	}
	if row.Skill() != "build-skill" || row.Command() != "alpha" || row.SourceDir() == "" {
		t.Fatalf("inventory row does not name the active command: %+v", row)
	}
	// Every identity that existed before the toolchain was consulted is carried:
	// the closed driver the parser admitted, the declared build root and package
	// directory, and the build-source digest, which is validated first.
	if row.Driver() != buildmeta.DriverGoV1 || row.BuildRoot() != "src" {
		t.Fatalf("inventory row dropped the identity it already had: driver=%q root=%q",
			row.Driver(), row.BuildRoot())
	}
	if row.Source().Algorithm == "" || row.Source().ContentSHA256 == "" {
		t.Fatalf("inventory row dropped the validated build-source identity: %+v", row.Source())
	}
	if !strings.Contains(row.Describe(), "source="+row.Source().Algorithm+":"+row.Source().ContentSHA256) {
		t.Fatalf("inventory line does not report the build source: %s", row.Describe())
	}
	// Only what genuinely depends on the toolchain stays empty.
	if row.CacheKey() != "" || row.Target().GOOS != "" || row.ArtifactPath() != "" {
		t.Fatalf("inventory row published an identity the plan never derived: %+v", row)
	}
	if row.Expectation().Input.Driver != "" {
		t.Fatalf("inventory row published a cache lookup it never took: %+v", row.Expectation())
	}
	if result.BuildDiagnostic != "go_toolchain_missing" {
		t.Fatalf("result diagnostic = %q", result.BuildDiagnostic)
	}
	if !result.BuildsComplete {
		t.Fatal("the inventory covers every active command but reported an incomplete diagnostic")
	}
}

