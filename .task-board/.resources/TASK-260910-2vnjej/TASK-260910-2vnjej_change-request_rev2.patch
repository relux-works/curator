+	}
+	if err := json.Unmarshal(payload, &document); err != nil {
+		t.Fatal(err)
+	}
+	var cases []registryClientBootstrapVector
+	for _, vector := range document.BootstrapCases {
+		if vector.Phase != "compare" {
+			cases = append(cases, vector)
