+def sha256_identity(path: Path) -> str:
+    try:
+        return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()
+    except OSError as exc:
+        raise ReleaseFailure(f"could not hash {path}: {exc}") from exc
