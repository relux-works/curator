        "# Decision 0004:",
        "Manifest schema 6",
        "go-v1",
        "## Rejected alternatives",
    ):
        if required_text not in decision:
            raise ReleaseFailure(
                f"decision 0004 is stale: missing {required_text!r}"
            )


