def _install_skill_context_to_root(
    target_root: Path,
    plan: SkillPlan,
    effective_locale: str | None,
    agents: list[str],
    *,
    activation: dict[str, object] | None = None,
    requirers: list[str] | None = None,
    substituted: str | None = None,
