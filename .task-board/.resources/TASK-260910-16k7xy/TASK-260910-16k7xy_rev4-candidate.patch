+// TestCaptureDetectsLiveContentChange proves bytes changing under the
+// admitted set fail capture: narrowing the post-copy re-read to skip
+// the comparison must fail this test.
+func TestCaptureDetectsLiveContentChange(t *testing.T) {
+	home, pkg, acquisition := captureFixture(t, map[string]string{"a.md": "before\n"})
+	before, err := Capture(acquisition)
+	if err != nil {
+		t.Fatalf("Capture: %v", err)
+	}
+	if _, err := PublishLocal(home, acquisition.Staging, before); err != nil {
+		t.Fatalf("PublishLocal: %v", err)
+	}
+	// A second admission over changed bytes is a new snapshot, not a
+	// silent reuse of the first: the digest must move.
+	if err := os.WriteFile(filepath.Join(pkg, "a.md"), []byte("after\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	base := filepath.Dir(pkg)
+	second, err := PrepareLocalAcquisition(pkg, ".", base, "s", boundaryOutputs(base), nil, map[string]bool{"s": true}, "")
+	if err != nil {
+		t.Fatalf("PrepareLocalAcquisition: %v", err)
+	}
+	defer func() { _ = second.Close() }()
+	after, err := Capture(second)
+	if err != nil {
+		t.Fatalf("Capture: %v", err)
+	}
+	if after.Snapshot == before.Snapshot {
+		t.Fatalf("changed bytes kept snapshot %s", after.Snapshot)
+	}
+}
