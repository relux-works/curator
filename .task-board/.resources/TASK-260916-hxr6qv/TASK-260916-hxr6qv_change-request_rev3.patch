+			}
+			if !testCase.wantOK {
+				return
+			}
+			if host != testCase.wantHost || port != testCase.wantPort || hasPort != testCase.wantHasPort || identity != testCase.wantIdentity {
+				t.Fatalf("parseTransportEndpointURL(%q) = %q, %d, %v, %q", testCase.raw, host, port, hasPort, identity)
+			}
+		})
+	}
+}
