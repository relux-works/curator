+        ROOT / "conformance" / "skillfile-sources-v1",
+    )
+    for path in roots:
+        if not path.exists():
+            raise ReleaseFailure(f"skillfile-sources-v1 suite input is missing: {path}")
+        candidates = path.rglob("*") if path.is_dir() else (path,)
+        for candidate in candidates:
