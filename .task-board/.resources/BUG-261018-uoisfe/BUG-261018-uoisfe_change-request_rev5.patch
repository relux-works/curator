+		{"one-retired-name", "switch.go", "if !want[path] {", "if !want[path] && path != \"skills/myskill\" {", "envprofile", "TestNativeSkillsConvergenceAndSwitch", "TestNativeSkillsConvergenceAndSwitch", "retired recorded skill retained"},
