--- /dev/null
+++ b/internal/envsnapshot/destination_other_test.go
@@ -0,0 +1,31 @@
+//go:build !darwin && !linux
+
+package envsnapshot
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// Unqualified platforms refuse without creating a destination. This is not
+// owner/ACL/reparse or publication qualification for Windows.
+func TestDestinationUnqualifiedPlatform(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "absent")
+	d, err := OpenDestination(path, DestinationPolicy{ProtectedRoots: []string{root}})
+	var refusal *Error
+	if d != nil || !errors.As(err, &refusal) || refusal.Code != DestinationInvalid || refusal.Reason != "platform-unqualified" {
+		t.Fatal("unqualified platform accepted destination", d, err)
+	}
+	if _, err := os.Lstat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatal("unqualified platform changed destination", err)
+	}
+	var unsupported Destination
+	v, err := unsupported.Publish(context.Background(), Publication{})
+	if v != nil || !errors.As(err, &refusal) || refusal.Code != DestinationInvalid || refusal.Reason != "platform-unqualified" {
+		t.Fatal("unqualified platform published", v, err)
+	}
+}
diff --git a/internal/envsnapshot/destination_unix.go b/internal/envsnapshot/destination_unix.go
new file mode 100644
index 00000000..e1e62185
--- /dev/null
+++ b/internal/envsnapshot/destination_unix.go
@@ -0,0 +1,458 @@
+//go:build darwin || linux
+
+package envsnapshot
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+)
+
+type retainedDirectory struct {
+	file *os.File
+	info os.FileInfo
+	name string
+}
+
+// Destination retains every supplied ancestor, protected root and target until
+// Close. It performs no writes and exposes no pathname or raw file descriptor.
+// Revalidate is an observation, not an atomic publication primitive or a lease
+// against another process with the same user's authority. Do not publish with
+// os.Rename after calling it: publication needs its own no-replace backend.
+type Destination struct {
+	mu        sync.Mutex
+	chain     []retainedDirectory
+	protected [][]retainedDirectory
+	lineage   []*os.File
+	target    *os.File
+	name      string
+	kind      DestinationKind
+	prior     []byte
+	closed    bool
+	// Per-destination fault/race seam; production leaves this nil.
+	publicationHook func(string, *os.File) error
+}
+
+// OpenDestination validates without writes, retaining no-follow handles for
+// every component as supplied (including components before '..'). The final
+// parent must exist and belong to the caller. ProtectedRoots must be complete
+// and nonempty; this API does not discover machine configuration or authorize
+// source capture. An intact prior snapshot is fully verified before admission.
+func OpenDestination(path string, policy DestinationPolicy) (_ *Destination, err error) {
+	d := &Destination{}
+	defer func() {
+		if err != nil {
+			_ = d.Close()
+		}
+	}()
+	if len(policy.ProtectedRoots) == 0 {
+		return nil, invalidDestination("protected-roots-required")
+	}
+	parts, err := destinationParts(path)
+	if err != nil || len(parts) == 0 || parts[len(parts)-1] == "." || parts[len(parts)-1] == ".." {
+		return nil, invalidDestination("path-invalid")
+	}
+	d.name = parts[len(parts)-1]
+	d.chain, err = retainDirectories(parts[:len(parts)-1])
+	if err != nil {
+		return nil, err
+	}
+	parent := d.chain[len(d.chain)-1].file
+	if err = destinationDirectory(parent, true, true); err != nil {
+		return nil, err
+	}
+	for _, root := range policy.ProtectedRoots {
+		rootParts, e := destinationParts(root)
+		if e != nil {
+			return nil, invalidDestination("protected-root-unreadable")
+		}
+		chain, e := retainDirectories(rootParts)
+		if e != nil {
+			return nil, invalidDestination("protected-root-unreadable")
+		}
+		d.protected = append(d.protected, chain)
+	}
+	d.target, err = openMember(parent, d.name, true)
+	if err != nil && !errors.Is(err, syscall.ENOENT) {
+		return nil, invalidDestination("target-unreadable")
+	}
+	if d.target != nil {
+		if err = destinationDirectory(d.target, true, true); err != nil {
+			return nil, err
+		}
+	}
+	d.lineage, err = retainLineage(parent)
+	if err != nil {
+		return nil, invalidDestination("ancestry-unreadable")
+	}
+	if err = d.excludeProtected(); err != nil {
+		return nil, err
+	}
+	d.kind, d.prior, err = inspectDestination(d.target)
+	if err != nil {
+		return nil, err
+	}
+	if err = d.revalidate(); err != nil {
+		return nil, err
+	}
+	return d, nil
+}
+
+// Kind returns the admitted observation, including after Close.
+func (d *Destination) Kind() DestinationKind { return d.kind }
+
+// Revalidate rejects changed ancestor/target entries, permissions, protected
+// roots and prior contents through retained handles. It never writes or repairs.
+func (d *Destination) Revalidate() error {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return d.revalidate()
+}
+
+// MatchPrior verifies the actual tree again and compares exact manifest bytes.
+// Portable equivalence is deliberately insufficient for idempotence. For an
+// absent target this returns false, without granting publication rights.
+func (d *Destination) MatchPrior(manifest []byte) (bool, error) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if err := d.revalidate(); err != nil {
+		return false, err
+	}
+	if d.kind != DestinationSnapshot {
+		return false, nil
+	}
+	if !bytes.Equal(d.prior, manifest) {
+		return false, refuse("generation-mismatch")
+	}
+	return true, nil
+}
+
+func (d *Destination) revalidate() error {
+	if d.closed || len(d.chain) == 0 {
+		return invalidDestination("destination-closed")
+	}
+	if err := recheckDirectories(d.chain); err != nil {
+		return err
+	}
+	for _, chain := range d.protected {
+		if err := recheckDirectories(chain); err != nil {
+			return invalidDestination("protected-root-changed")
+		}
+	}
+	parent := d.chain[len(d.chain)-1].file
+	if err := destinationDirectory(parent, true, true); err != nil {
+		return err
+	}
+	fresh, err := openMember(parent, d.name, true)
+	if d.target == nil {
+		if fresh != nil {
+			_ = fresh.Close()
+		}
+		if !errors.Is(err, syscall.ENOENT) {
+			return invalidDestination("target-changed")
+		}
+		return nil
+	}
+	if err != nil {
+		return invalidDestination("target-changed")
+	}
+	defer func() { _ = fresh.Close() }()
+	a, aerr := d.target.Stat()
+	b, berr := fresh.Stat()
+	if aerr != nil || berr != nil || !os.SameFile(a, b) {
+		return invalidDestination("target-changed")
+	}
+	if err := destinationDirectory(fresh, true, true); err != nil {
+		return err
+	}
+	kind, prior, err := inspectDestination(fresh)
+	if err != nil {
+		var refusal *Error
+		if d.kind == DestinationSnapshot && errors.As(err, &refusal) && refusal.Code == DestinationInvalid {
+			return refuse("prior-unreadable")
+		}
+		return err
+	}
+	if kind != d.kind || !bytes.Equal(prior, d.prior) {
+		return refuse("generation-mismatch")
+	}
+	return nil
+}
+
+func inspectDestination(target *os.File) (DestinationKind, []byte, error) {
+	if target == nil {
+		return DestinationAbsent, nil, nil
+	}
+	// A fresh open file description avoids sharing ReadDir's cursor with a
+	// previous inspection or SNAP-ID traversal.
+	fresh, err := openMember(target, ".", true)
+	if err != nil {
+		return "", nil, invalidDestination("target-unreadable")
+	}
+	defer func() { _ = fresh.Close() }()
+	entries, err := fresh.ReadDir(-1)
+	if err != nil {
+		return "", nil, invalidDestination("target-unreadable")
+	}
+	if len(entries) == 0 {
+		return "", nil, invalidDestination("empty-target")
+	}
+	hasManifest := false
+	for _, entry := range entries {
+		if entry.Name() == "manifest.json" {
+			hasManifest = true
+		}
+	}
+	if !hasManifest {
+		return "", nil, invalidDestination("unrelated-target")
+	}
+	verifyHandle, err := openMember(target, ".", true)
+	if err != nil {
+		return "", nil, refuse("tree-unreadable")
+	}
+	defer func() { _ = verifyHandle.Close() }()
+	v, err := verifyDirectory(verifyHandle, "")
+	if err != nil {
+		return "", nil, err
+	}
+	if err := priorOwnershipACL(target); err != nil {
+		return "", nil, refuse("snapshot-owner-acl")
+	}
+	return DestinationSnapshot, v.ManifestBytes(), nil
+}
+
+// SNAP-ID covers bytes, modes and the complete entry set. Admission additionally
+// checks each prior object's owner/ACL through fresh no-follow handles.
+func priorOwnershipACL(dir *os.File) error {
+	fresh, err := openMember(dir, ".", true)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = fresh.Close() }()
+	entries, err := fresh.ReadDir(-1)
+	if err != nil {
+		return err
+	}
+	for _, entry := range entries {
+		f, err := openMember(dir, entry.Name(), entry.IsDir())
+		if err != nil {
+			return err
+		}
+		info, err := f.Stat()
+		if err == nil {
+			stat, ok := info.Sys().(*syscall.Stat_t)
+			if !ok || int64(stat.Uid) != int64(os.Geteuid()) {
+				err = os.ErrPermission
+			}
+		}
+		if err == nil {
+			err = destinationACL(f)
+		}
+		if err == nil && info.IsDir() {
+			err = priorOwnershipACL(f)
+		}
+		closeErr := f.Close()
+		if err != nil {
+			return err
+		}
+		if closeErr != nil {
+			return closeErr
+		}
+	}
+	return nil
+}
+
+func destinationParts(path string) ([]string, error) {
+	if path == "" || strings.ContainsRune(path, 0) {
+		return nil, os.ErrInvalid
+	}
+	if !filepath.IsAbs(path) {
+		cwd, err := os.Getwd()
+		if err != nil {
+			return nil, err
+		}
+		path = cwd + "/" + path
+	}
+	var parts []string
+	for _, part := range strings.Split(path, "/") {
+		if part != "" {
+			parts = append(parts, part)
+		}
+	}
+	return parts, nil
+}
+
+func retainDirectories(parts []string) (_ []retainedDirectory, err error) {
+	root, err := os.Open("/")
+	if err != nil {
+		return nil, invalidDestination("ancestor-unreadable")
+	}
+	chain := []retainedDirectory{{file: root}}
+	defer func() {
+		if err != nil {
+			closeDirectories(chain)
+		}
+	}()
+	for i := 0; ; i++ {
+		current := &chain[len(chain)-1]
+		if err = destinationDirectory(current.file, false, false); err != nil {
+			return nil, err
+		}
+		current.info, err = current.file.Stat()
+		if err != nil {
+			return nil, invalidDestination("ancestor-unreadable")
+		}
+		if i == len(parts) {
+			return chain, nil
+		}
+		child, e := openMember(current.file, parts[i], true)
+		if e != nil {
+			return nil, invalidDestination("ancestor-unreadable")
+		}
+		chain = append(chain, retainedDirectory{file: child, name: parts[i]})
+	}
+}
+
+func recheckDirectories(chain []retainedDirectory) error {
+	for i, retained := range chain {
+		if err := destinationDirectory(retained.file, false, false); err != nil {
+			return err
+		}
+		if i == 0 {
+			continue
+		}
+		fresh, err := openMember(chain[i-1].file, retained.name, true)
+		if err != nil {
+			return invalidDestination("ancestor-changed")
+		}
+		info, err := fresh.Stat()
+		closeErr := fresh.Close()
+		if err != nil || closeErr != nil || !os.SameFile(retained.info, info) {
+			return invalidDestination("ancestor-changed")
+		}
+	}
+	return nil
+}
+
+func destinationDirectory(f *os.File, caller, private bool) error {
+	info, err := f.Stat()
+	if err != nil || !info.IsDir() {
+		return invalidDestination("directory-unreadable")
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || (int64(stat.Uid) != int64(os.Geteuid()) && (caller || stat.Uid != 0)) {
+		return invalidDestination("directory-owner")
+	}
+	if info.Mode().Perm()&0022 != 0 || info.Mode()&(os.ModeSetuid|os.ModeSetgid|os.ModeSticky) != 0 || (private && info.Mode().Perm() != 0700) {
+		return invalidDestination("directory-permissions")
+	}
+	if err := destinationACL(f); err != nil {
+		return invalidDestination("directory-acl")
+	}
+	return nil
+}
+
+// retainLineage follows physical parents from the retained handle. It does not
+// mistake a spelling visited before '..' for a physical ancestor of the target.
+func retainLineage(start *os.File) (_ []*os.File, err error) {
+	current, err := openMember(start, ".", true)
+	if err != nil {
+		return nil, err
+	}
+	lineage := []*os.File{current}
+	defer func() {
+		if err != nil {
+			for _, f := range lineage {
+				_ = f.Close()
+			}
+		}
+	}()
+	for len(lineage) < 4096 {
+		parent, e := openMember(current, "..", true)
+		if e != nil {
+			return nil, e
+		}
+		a, ae := current.Stat()
+		b, be := parent.Stat()
+		if ae != nil || be != nil {
+			_ = parent.Close()
+			return nil, os.ErrInvalid
+		}
+		if os.SameFile(a, b) {
+			_ = parent.Close()
+			return lineage, nil
+		}
+		lineage = append(lineage, parent)
+		current = parent
+	}
+	return nil, os.ErrInvalid
+}
+
+func (d *Destination) excludeProtected() error {
+	for _, chain := range d.protected {
+		protected := chain[len(chain)-1].info
+		for _, ancestor := range d.lineage {
+			info, err := ancestor.Stat()
+			if err != nil || os.SameFile(info, protected) {
+				return invalidDestination("protected-destination")
+			}
+		}
+		if d.target != nil {
+			info, err := d.target.Stat()
+			if err != nil {
+				return invalidDestination("target-unreadable")
+			}
+			// Equal/containing checks use the protected root's physical lineage,
+			// not string prefixes (including case-folded filesystem aliases).
+			lineage, err := retainLineage(chain[len(chain)-1].file)
+			if err != nil {
+				return invalidDestination("ancestry-unreadable")
+			}
+			found := false
+			for _, ancestor := range lineage {
+				other, e := ancestor.Stat()
+				if e != nil || os.SameFile(info, other) {
+					found = true
+				}
+				_ = ancestor.Close()
+			}
+			if found {
+				return invalidDestination("protected-destination")
+			}
+		}
+	}
+	return nil
+}
+
+func closeDirectories(chain []retainedDirectory) {
+	for i := len(chain) - 1; i >= 0; i-- {
+		_ = chain[i].file.Close()
+	}
+}
+
+// Close releases all retained handles, without cleanup or any filesystem write.
+func (d *Destination) Close() error {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.closed {
+		return nil
+	}
+	d.closed = true
+	closeDirectories(d.chain)
+	for _, chain := range d.protected {
+		closeDirectories(chain)
+	}
+	for _, f := range d.lineage {
+		_ = f.Close()
+	}
+	if d.target != nil {
+		if err := d.target.Close(); err != nil {
+			return invalidDestination("handle-close")
+		}
+	}
+	return nil
+}
diff --git a/internal/envsnapshot/destination_unix_test.go b/internal/envsnapshot/destination_unix_test.go
new file mode 100644
index 00000000..b3d8e94f
--- /dev/null
+++ b/internal/envsnapshot/destination_unix_test.go
@@ -0,0 +1,467 @@
+//go:build darwin || linux
+
+package envsnapshot
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// Admission rejects shared temporary ancestors, so these real syscall fixtures
+// live in a caller-owned repository scratch allocation, outside protected roots.
+func destinationSandbox(t *testing.T) (string, DestinationPolicy) {
+	t.Helper()
+	base, err := filepath.Abs("../../.temp")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(base, 0700); err != nil {
+		t.Fatal(err)
+	}
+	base, err = filepath.EvalSymlinks(base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	allocation, err := os.MkdirTemp(base, "destination-test-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := os.RemoveAll(allocation); err != nil {
+			t.Error(err)
+		}
+	})
+	// The target containing a protected root also needs a private parent.
+	root := filepath.Join(allocation, "fixture")
+	if err := os.Mkdir(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	protected := filepath.Join(root, "protected")
+	if err := os.Mkdir(protected, 0700); err != nil {
+		t.Fatal(err)
+	}
+	return root, DestinationPolicy{ProtectedRoots: []string{protected}}
+}
+
+func admitDestination(t *testing.T, path string, policy DestinationPolicy, kind DestinationKind) *Destination {
+	t.Helper()
+	d, err := OpenDestination(path, policy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := d.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	if d.Kind() != kind {
+		t.Fatalf("kind = %s, want %s", d.Kind(), kind)
+	}
+	if err := d.Revalidate(); err != nil {
+		t.Fatal(err)
+	}
+	return d
+}
+
+func requireDestinationError(t *testing.T, err error, code, reason string) {
+	t.Helper()
+	var e *Error
+	if !errors.As(err, &e) || e.Code != code || (reason != "" && e.Reason != reason) {
+		t.Fatalf("refusal = %v, want %s/%s", err, code, reason)
+	}
+}
+
+func snapshotAtDestination(t *testing.T, root string) {
+	t.Helper()
+	if err := os.Mkdir(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	m := manifest(t)
+	for _, f := range m.Files {
+		mode := os.FileMode(0600)
+		if f.Mode == "0700" {
+			mode = 0700
+		}
+		write(t, root, f.Path, read(t, "golden/"+f.Path), mode)
+	}
+	write(t, root, "manifest.json", read(t, "golden/manifest.json"), 0600)
+	write(t, root, "launch.json", read(t, "golden/launch.json"), 0600)
+}
+
+func assertAbsent(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Lstat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("expected absent destination, got %v", err)
+	}
+}
+
+// OpenDestination admits absent private destinations and refuses an existing
+// empty target without writes. Close is idempotent and revokes observations.
+func TestDestinationReadOnlyAdmission(t *testing.T) {
+	var zero Destination
+	requireDestinationError(t, zero.Revalidate(), DestinationInvalid, "destination-closed")
+	root, policy := destinationSandbox(t)
+	absent := filepath.Join(root, "absent")
+	d := admitDestination(t, absent, policy, DestinationAbsent)
+	if yes, err := d.MatchPrior(read(t, "golden/manifest.json")); err != nil || yes {
+		t.Fatal("absent target reported prior snapshot", yes, err)
+	}
+	assertAbsent(t, absent)
+	cwd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	relative, err := filepath.Rel(cwd, root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	admitDestination(t, relative+"/relative", policy, DestinationAbsent)
+	assertAbsent(t, filepath.Join(root, "relative"))
+	for _, invalid := range []string{"", "/", "\x00", root + "/.", root + "/.."} {
+		_, err := OpenDestination(invalid, policy)
+		requireDestinationError(t, err, DestinationInvalid, "path-invalid")
+	}
+	empty := filepath.Join(root, "empty")
+	if err := os.Mkdir(empty, 0700); err != nil {
+		t.Fatal(err)
+	}
+	before, err := os.Stat(empty)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = OpenDestination(empty, policy)
+	requireDestinationError(t, err, DestinationInvalid, "empty-target")
+	if err := d.Close(); err != nil {
+		t.Fatal(err)
+	}
+	requireDestinationError(t, d.Revalidate(), DestinationInvalid, "destination-closed")
+	after, err := os.Stat(empty)
+	if err != nil || !os.SameFile(before, after) || !before.ModTime().Equal(after.ModTime()) || before.Mode() != after.Mode() {
+		t.Fatal("admission changed empty target", err)
+	}
+	entries, err := os.ReadDir(root)
+	if err != nil || len(entries) != 2 {
+		t.Fatal("admission wrote scratch entries", entries, err)
+	}
+}
+
+// Every supplied component is no-follow, including a linked ancestor before
+// '..'. Invalid reads and unrelated content refuse without altering sentinels.
+func TestDestinationBoundary(t *testing.T) {
+	for _, name := range []string{"linked-ancestor", "linked-before-parent", "linked-target", "file-target", "missing-parent", "shared-ancestor", "shared-target", "public-target", "unrelated", "missing-protected", "no-policy"} {
+		t.Run(name, func(t *testing.T) {
+			root, policy := destinationSandbox(t)
+			admitDestination(t, filepath.Join(root, "control"), policy, DestinationAbsent)
+			safe := filepath.Join(root, "safe")
+			if err := os.Mkdir(safe, 0700); err != nil {
+				t.Fatal(err)
+			}
+			write(t, safe, "sentinel", []byte("preserved"), 0600)
+			path := filepath.Join(root, "target")
+			switch name {
+			case "linked-ancestor", "linked-before-parent":
+				if err := os.Symlink(safe, path); err != nil {
+					t.Fatal(err)
+				}
+				if name == "linked-before-parent" {
+					path += "/../new"
+				} else {
+					path += "/new"
+				}
+			case "linked-target":
+				if err := os.Symlink(safe, path); err != nil {
+					t.Fatal(err)
+				}
+			case "file-target", "unrelated":
+				if name == "unrelated" {
+					write(t, path, "foreign", []byte("preserved"), 0600)
+				} else if err := os.WriteFile(path, []byte("preserved"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "missing-parent":
+				path += "/child"
+			case "shared-ancestor", "shared-target", "public-target":
+				if err := os.Mkdir(path, 0700); err != nil {
+					t.Fatal(err)
+				}
+				mode := os.FileMode(0770)
+				if name == "public-target" {
+					mode = 0755
+				}
+				if err := os.Chmod(path, mode); err != nil {
+					t.Fatal(err)
+				}
+				if name == "shared-ancestor" {
+					// Separate ancestor permissions from the immediate parent's
+					// additional private-mode requirement.
+					private := filepath.Join(path, "private")
+					if err := os.Mkdir(private, 0700); err != nil {
+						t.Fatal(err)
+					}
+					path = filepath.Join(private, "child")
+				}
+			case "missing-protected":
+				policy.ProtectedRoots = append(policy.ProtectedRoots, filepath.Join(root, "missing"))
+			case "no-policy":
+				policy.ProtectedRoots = nil
+			}
+			_, err := OpenDestination(path, policy)
+			requireDestinationError(t, err, DestinationInvalid, "")
+			b, err := os.ReadFile(filepath.Join(safe, "sentinel"))
+			if err != nil || string(b) != "preserved" {
+				t.Fatal("outside sentinel changed", err)
+			}
+			assertAbsent(t, filepath.Join(safe, "new"))
+			assertAbsent(t, filepath.Join(root, "new"))
+		})
+	}
+}
+
+// Root-owned system parents are not caller-owned publication parents for an
+// unprivileged caller. A closed retained handle is a read failure, not absence.
+func TestDestinationOwnershipAndReadFailure(t *testing.T) {
+	root, policy := destinationSandbox(t)
+	d := admitDestination(t, filepath.Join(root, "control"), policy, DestinationAbsent)
+	if os.Geteuid() == 0 {
+		t.Log("foreign-owner control unrun: effective root owns system parent")
+	} else {
+		_, err := OpenDestination("/snapshot-owner-control", policy)
+		requireDestinationError(t, err, DestinationInvalid, "directory-owner")
+		assertAbsent(t, "/snapshot-owner-control")
+	}
+	if err := d.chain[len(d.chain)-1].file.Close(); err != nil {
+		t.Fatal(err)
+	}
+	requireDestinationError(t, d.Revalidate(), DestinationInvalid, "directory-unreadable")
+	assertAbsent(t, filepath.Join(root, "control"))
+}
+
+// Handle identity excludes equal, descendant and containing destinations for
+// every protected-root class. Similar lexical prefixes remain valid siblings.
+func TestDestinationProtectedIdentity(t *testing.T) {
+	for _, class := range []string{"manager", "store", "managed-home", "native-home", "credentials", "repository-admin", "workspace"} {
+		t.Run(class, func(t *testing.T) {
+			root, policy := destinationSandbox(t)
+			protected := filepath.Join(root, class)
+			// An intact snapshot avoids masking a broken protected-identity
+			// gate with the unrelated/empty-target refusal.
+			snapshotAtDestination(t, protected)
+			policy.ProtectedRoots = append(policy.ProtectedRoots, protected)
+			admitDestination(t, protected+"-sibling", policy, DestinationAbsent)
+			for _, path := range []string{protected, protected + "/child", root} {
+				_, err := OpenDestination(path, policy)
+				requireDestinationError(t, err, DestinationInvalid, "protected-destination")
+			}
+			upper := filepath.Join(root, strings.ToUpper(class))
+			if _, err := os.Stat(upper); err == nil {
+				_, err := OpenDestination(upper, policy)
+				requireDestinationError(t, err, DestinationInvalid, "protected-destination")
+			} // A folding filesystem exercises a physical alias; Linux does not.
+			assertAbsent(t, protected+"/child")
+		})
+	}
+}
+
+// Kernel directory substitutions after admission refuse through Revalidate;
+// neither moved originals nor competing targets/links are cleaned or replaced.
+func TestDestinationReplacementRaces(t *testing.T) {
+	for _, name := range []string{"ancestor-link", "ancestor-directory", "target-link", "target-directory", "target-empty", "target-identical", "competing-target", "empty-filled", "permission-change", "protected-moved"} {
+		t.Run(name, func(t *testing.T) {
+			root, policy := destinationSandbox(t)
+			parent := filepath.Join(root, "parent")
+			if err := os.Mkdir(parent, 0700); err != nil {
+				t.Fatal(err)
+			}
+			path := filepath.Join(parent, "target")
+			kind := DestinationAbsent
+			if name != "competing-target" {
+				snapshotAtDestination(t, path)
+				kind = DestinationSnapshot
+			}
+			d := admitDestination(t, path, policy, kind)
+			sentinel := filepath.Join(root, "outside")
+			write(t, sentinel, "sentinel", []byte("preserved"), 0600)
+			switch name {
+			case "ancestor-link", "ancestor-directory", "target-link", "target-directory", "target-empty", "target-identical":
+				replaced := path
+				if strings.HasPrefix(name, "ancestor") {
+					replaced = parent
+				}
+				if err := os.Rename(replaced, replaced+"-original"); err != nil {
+					t.Fatal(err)
+				}
+				if strings.HasSuffix(name, "link") {
+					if err := os.Symlink(sentinel, replaced); err != nil {
+						t.Fatal(err)
+					}
+				} else if name == "target-identical" {
+					snapshotAtDestination(t, replaced)
+				} else if name == "target-empty" {
+					if err := os.Mkdir(replaced, 0700); err != nil {
+						t.Fatal(err)
+					}
+				} else {
+					write(t, replaced, "competitor", []byte("preserved"), 0600)
+				}
+			case "competing-target", "empty-filled":
+				write(t, path, "competitor", []byte("preserved"), 0600)
+			case "permission-change":
+				if err := os.Chmod(parent, 0770); err != nil {
+					t.Fatal(err)
+				}
+			case "protected-moved":
+				if err := os.Rename(policy.ProtectedRoots[0], policy.ProtectedRoots[0]+"-original"); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Mkdir(policy.ProtectedRoots[0], 0700); err != nil {
+					t.Fatal(err)
+				}
+			}
+			code := DestinationInvalid
+			if name == "empty-filled" {
+				code = Mismatch
+			}
+			requireDestinationError(t, d.Revalidate(), code, "")
+			if err := d.Close(); err != nil {
+				t.Fatal(err)
+			}
+			b, err := os.ReadFile(filepath.Join(sentinel, "sentinel"))
+			if err != nil || string(b) != "preserved" {
+				t.Fatal("outside content changed", err)
+			}
+			if strings.HasSuffix(name, "directory") || name == "competing-target" || name == "empty-filled" {
+				p := path
+				if name == "ancestor-directory" {
+					p = parent
+				}
+				b, err := os.ReadFile(filepath.Join(p, "competitor"))
+				if err != nil || string(b) != "preserved" {
+					t.Fatal("competing target changed", err)
+				}
+			}
+		})
+	}
+}
+
+// A private parent admits an absent destination; making that same retained
+// parent readable by others refuses both fresh admission and revalidation.
+func TestDestinationPrivateParent(t *testing.T) {
+	root, policy := destinationSandbox(t)
+	parent := filepath.Join(root, "parent")
+	if err := os.Mkdir(parent, 0700); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(parent, "target")
+	d := admitDestination(t, path, policy, DestinationAbsent)
+	if err := os.Chmod(parent, 0755); err != nil {
+		t.Fatal(err)
+	}
+	requireDestinationError(t, d.Revalidate(), DestinationInvalid, "directory-permissions")
+	_, err := OpenDestination(path, policy)
+	requireDestinationError(t, err, DestinationInvalid, "directory-permissions")
+	assertAbsent(t, path)
+	entries, err := os.ReadDir(parent)
+	if err != nil || len(entries) != 0 {
+		t.Fatal("refusal wrote into public parent", err)
+	}
+}
+
+// Intact exact generations match without writes. Actual byte/mode/entry/version
+// drift refuses despite unchanged saved manifests; different source binding is
+// not portable idempotence. Both initial admission and revalidation exercise it.
+func TestDestinationPriorIdentity(t *testing.T) {
+	for _, name := range []string{"identical", "bytes", "mode", "extra", "unreadable", "unknown-version", "new-generation"} {
+		t.Run(name, func(t *testing.T) {
+			root, policy := destinationSandbox(t)
+			path := filepath.Join(root, "snapshot")
+			snapshotAtDestination(t, path)
+			d := admitDestination(t, path, policy, DestinationSnapshot)
+			original := read(t, "golden/manifest.json")
+			requested := bytes.Clone(original)
+			reason := ""
+			switch name {
+			case "bytes":
+				p := filepath.Join(path, "home/AGENTS.md")
+				b, err := os.ReadFile(p)
+				if err != nil {
+					t.Fatal(err)
+				}
+				b[0] ^= 1
+				write(t, path, "home/AGENTS.md", b, 0600)
+				reason = "file-identity"
+			case "mode", "unreadable":
+				mode := os.FileMode(0700)
+				if name == "unreadable" {
+					mode = 0000
+				}
+				if err := os.Chmod(filepath.Join(path, "home/AGENTS.md"), mode); err != nil {
+					t.Fatal(err)
+				}
+				reason = "file-mode"
+				if name == "unreadable" {
+					reason = "file-unreadable"
+				}
+			case "extra":
+				write(t, path, "extra", []byte("preserved"), 0600)
+				reason = "entry-set"
+			case "unknown-version":
+				write(t, path, "manifest.json", bytes.Replace(original, []byte(ManifestVersion), []byte("managed-home-snapshot-v0"), 1), 0600)
+			case "new-generation":
+				requested = read(t, "golden/other-source-manifest.json")
+				reason = "generation-mismatch"
+			}
+			before, err := os.ReadFile(filepath.Join(path, "manifest.json"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			beforeInfo, err := os.Stat(filepath.Join(path, "manifest.json"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			match, err := d.MatchPrior(requested)
+			if name == "identical" {
+				if !match || err != nil {
+					t.Fatal("intact prior rejected", err)
+				}
+			} else {
+				requireDestinationError(t, err, Mismatch, reason)
+				if match {
+					t.Fatal("mismatched snapshot admitted")
+				}
+				if name != "new-generation" {
+					_, err := OpenDestination(path, policy)
+					requireDestinationError(t, err, Mismatch, reason)
+				}
+			}
+			after, err := os.ReadFile(filepath.Join(path, "manifest.json"))
+			afterInfo, statErr := os.Stat(filepath.Join(path, "manifest.json"))
+			if err != nil || statErr != nil || !bytes.Equal(before, after) || !os.SameFile(beforeInfo, afterInfo) || !beforeInfo.ModTime().Equal(afterInfo.ModTime()) {
+				t.Fatal("prior manifest changed during admission", err, statErr)
+			}
+		})
+	}
+}
+
+// Once admitted as a prior snapshot, lost metadata is a snapshot mismatch,
+// rather than unrelated content or an absent target. No metadata is recreated.
+func TestDestinationPriorMissingMetadata(t *testing.T) {
+	root, policy := destinationSandbox(t)
+	path := filepath.Join(root, "snapshot")
+	snapshotAtDestination(t, path)
+	d := admitDestination(t, path, policy, DestinationSnapshot)
+	manifestPath := filepath.Join(path, "manifest.json")
+	if err := os.Rename(manifestPath, manifestPath+".saved"); err != nil {
+		t.Fatal(err)
+	}
+	_, err := d.MatchPrior(read(t, "golden/manifest.json"))
+	requireDestinationError(t, err, Mismatch, "prior-unreadable")
+	assertAbsent(t, manifestPath)
+	b, err := os.ReadFile(manifestPath + ".saved")
+	if err != nil || !bytes.Equal(b, read(t, "golden/manifest.json")) {
+		t.Fatal("refusal rewrote moved metadata", err)
+	}
+}
diff --git a/internal/envsnapshot/publication.go b/internal/envsnapshot/publication.go
new file mode 100644
index 00000000..3929b556
--- /dev/null
+++ b/internal/envsnapshot/publication.go
@@ -0,0 +1,44 @@
+package envsnapshot
+
+import "bytes"
+
+// Publication contains frozen output bytes from the capture coordinator. That
+// coordinator owns source authorization and verified execute metadata; this
+// boundary checks correspondence, never discovers or reads source paths.
+type Publication struct {
+	Manifest []byte
+	Launch   []byte
+	Files    map[string][]byte
+}
+
+func (p Publication) freeze() (Publication, map[string]bool, error) {
+	p.Manifest = bytes.Clone(p.Manifest)
+	p.Launch = bytes.Clone(p.Launch)
+	files := make(map[string][]byte, len(p.Files))
+	for name, data := range p.Files {
+		files[name] = bytes.Clone(data)
+	}
+	p.Files = files
+	m, err := DecodeManifest(p.Manifest)
+	if err != nil {
+		return Publication{}, nil, err
+	}
+	d, err := DecodeDescriptor(p.Launch)
+	if err != nil {
+		return Publication{}, nil, err
+	}
+	dirs, err := validateMetadata(m, d, p.Launch)
+	if err != nil {
+		return Publication{}, nil, err
+	}
+	if len(p.Files) != len(m.Files) {
+		return Publication{}, nil, refuse("captured-entry-set")
+	}
+	for _, f := range m.Files {
+		data, ok := p.Files[f.Path]
+		if !ok || int64(len(data)) != f.Size || Digest(data) != f.SHA256 {
+			return Publication{}, nil, refuse("captured-file-identity")
+		}
+	}
+	return p, dirs, nil
+}
