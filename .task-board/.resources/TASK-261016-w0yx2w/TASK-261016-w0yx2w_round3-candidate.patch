diff --git a/internal/envsnapshot/publication_unix.go b/internal/envsnapshot/publication_unix.go
new file mode 100644
index 00000000..2d742f3d
--- /dev/null
+++ b/internal/envsnapshot/publication_unix.go
@@ -0,0 +1,268 @@
+//go:build darwin || linux
+
+package envsnapshot
+
+import (
+	"context"
+	"crypto/rand"
+	"errors"
+	"os"
+	"path"
+	"sort"
+
+	"golang.org/x/sys/unix"
+)
+
+type stagingObject struct {
+	parent *os.File
+	file   *os.File
+	name   string
+	info   os.FileInfo
+}
+
+// Publish writes independent private copies, syncs, publishes without replacing
+// any destination entry, then verifies the published tree against the capture.
+// A verified prior is a no-op. Errors return no success object. After rename,
+// failure leaves the published entry for the operator, never rolling it back.
+// Cancellation is cooperative; abrupt process death can leave private staging.
+// Same-user mutation inside private staging is outside snapshot section 2's
+// guarantee. Cleanup records objects, never recursively enumerates a pathname.
+func (d *Destination) Publish(ctx context.Context, captured Publication) (result *Verified, err error) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if err = d.revalidate(); err != nil {
+		return nil, err
+	}
+	p, dirs, err := captured.freeze()
+	if err != nil {
+		return nil, err
+	}
+	if err = publicationContext(ctx); err != nil {
+		return nil, err
+	}
+	if d.kind == DestinationSnapshot {
+		if string(d.prior) != string(p.Manifest) {
+			return nil, refuse("generation-mismatch")
+		}
+		return &Verified{p.Manifest, p.Launch}, nil
+	}
+	parent := d.chain[len(d.chain)-1].file
+	stageName := ".curator-snapshot-" + rand.Text()
+	var objects []stagingObject
+	published := false
+	defer func() {
+		if !published {
+			cleanupErr := cleanupStaging(objects)
+			if cleanupErr != nil {
+				result = nil
+				err = errors.Join(err, invalidDestination("staging-cleanup"))
+			}
+		}
+		for i := len(objects) - 1; i >= 0; i-- {
+			_ = objects[i].file.Close()
+		}
+	}()
+	stage, err := createStagingDirectory(parent, stageName, &objects)
+	if err != nil {
+		return nil, err
+	}
+	if err = d.publicationStep(ctx, "stage-created", stage); err != nil {
+		return nil, err
+	}
+	handles := map[string]*os.File{"": stage}
+	names := make([]string, 0, len(dirs))
+	for name := range dirs {
+		names = append(names, name)
+	}
+	sort.Strings(names) // Every parent precedes its children.
+	for _, name := range names {
+		if err = publicationContext(ctx); err != nil {
+			return nil, err
+		}
+		child, e := createStagingDirectory(handles[publicationParent(name)], path.Base(name), &objects)
+		if e != nil {
+			return nil, e
+		}
+		handles[name] = child
+	}
+	m, _ := DecodeManifest(p.Manifest) // freeze already checked metadata.
+	for _, f := range m.Files {
+		mode := os.FileMode(0600)
+		if f.Mode == "0700" {
+			mode = 0700 // Only the capture coordinator supplies execute metadata.
+		}
+		if err = publicationContext(ctx); err != nil {
+			return nil, err
+		}
+		if err = createStagingFile(handles[publicationParent(f.Path)], path.Base(f.Path), p.Files[f.Path], mode, &objects); err != nil {
+			return nil, err
+		}
+		if err = d.publicationStep(ctx, "file-staged", stage); err != nil {
+			return nil, err
+		}
+	}
+	if err = createStagingFile(stage, "launch.json", p.Launch, 0600, &objects); err != nil {
+		return nil, err
+	}
+	// Manifest last; private partial output never constitutes a success result.
+	if err = createStagingFile(stage, "manifest.json", p.Manifest, 0600, &objects); err != nil {
+		return nil, err
+	}
+	for i := len(objects) - 1; i >= 0; i-- {
+		if objects[i].info.IsDir() {
+			if err = objects[i].file.Sync(); err != nil {
+				return nil, invalidDestination("staging-sync")
+			}
+		}
+	}
+	if err = d.revalidate(); err != nil {
+		return nil, err
+	}
+	// Tests insert real kernel competition AFTER the last admission check.
+	if err = d.publicationStep(ctx, "before-rename", stage); err != nil {
+		return nil, err
+	}
+	if err = publishNoReplace(int(parent.Fd()), stageName, d.name); err != nil {
+		return nil, invalidDestination("publication-no-replace")
+	}
+	published = true // No cleanup may touch this entry from this point onward.
+	if err = parent.Sync(); err != nil {
+		return nil, invalidDestination("publication-sync")
+	}
+	if err = d.publicationStep(ctx, "after-rename", stage); err != nil {
+		return nil, err
+	}
+	if err = recheckDirectories(d.chain); err != nil {
+		return nil, err
+	}
+	actual, err := openMember(parent, d.name, true)
+	if err != nil {
+		return nil, refuse("published-unreadable")
+	}
+	defer func() { _ = actual.Close() }()
+	info, err := actual.Stat()
+	if err != nil || !os.SameFile(objects[0].info, info) {
+		return nil, refuse("published-identity")
+	}
+	v, err := verifyDirectory(actual, Digest(p.Manifest))
+	if err != nil {
+		return nil, err
+	}
+	if err = priorOwnershipACL(actual); err != nil {
+		return nil, refuse("snapshot-owner-acl")
+	}
+	if err = publicationContext(ctx); err != nil {
+		return nil, err
+	}
+	// Retain the published target so a second call is a verified no-op.
+	d.target, err = openMember(parent, d.name, true)
+	if err != nil {
+		return nil, refuse("published-unreadable")
+	}
+	d.kind, d.prior = DestinationSnapshot, p.Manifest
+	if err = d.revalidate(); err != nil {
+		return nil, err
+	}
+	return v, nil
+}
+
+func publicationParent(name string) string {
+	parent := path.Dir(name)
+	if parent == "." {
+		return ""
+	}
+	return parent
+}
+
+func publicationContext(ctx context.Context) error {
+	if ctx.Err() != nil {
+		return invalidDestination("publication-interrupted")
+	}
+	return nil
+}
+
+func (d *Destination) publicationStep(ctx context.Context, phase string, stage *os.File) error {
+	if d.publicationHook != nil {
+		if err := d.publicationHook(phase, stage); err != nil {
+			return invalidDestination("staging-io")
+		}
+	}
+	return publicationContext(ctx)
+}
+
+func recordStaging(parent, f *os.File, name string, objects *[]stagingObject) error {
+	info, err := f.Stat()
+	if err != nil {
+		_ = f.Close()
+		return invalidDestination("staging-stat")
+	}
+	*objects = append(*objects, stagingObject{parent, f, name, info})
+	return nil
+}
+
+func createStagingDirectory(parent *os.File, name string, objects *[]stagingObject) (*os.File, error) {
+	if err := unix.Mkdirat(int(parent.Fd()), name, 0700); err != nil {
+		return nil, invalidDestination("staging-create")
+	}
+	f, err := openMember(parent, name, true)
+	if err != nil {
+		return nil, invalidDestination("staging-open")
+	}
+	if err := recordStaging(parent, f, name, objects); err != nil {
+		return nil, err
+	}
+	if err := f.Chmod(0700); err != nil {
+		return nil, invalidDestination("staging-mode")
+	}
+	if err := destinationDirectory(f, true, true); err != nil {
+		return nil, err
+	}
+	return f, nil
+}
+
+func createStagingFile(parent *os.File, name string, data []byte, mode os.FileMode, objects *[]stagingObject) error {
+	fd, err := unix.Openat(int(parent.Fd()), name, unix.O_WRONLY|unix.O_CREAT|unix.O_EXCL|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0600)
+	if err != nil {
+		return invalidDestination("staging-create")
+	}
+	f := os.NewFile(uintptr(fd), name)
+	if err := recordStaging(parent, f, name, objects); err != nil {
+		return err
+	}
+	if err := f.Chmod(mode); err != nil {
+		return invalidDestination("staging-mode")
+	}
+	if _, err := f.Write(data); err != nil {
+		return invalidDestination("staging-write")
+	}
+	if err := f.Sync(); err != nil {
+		return invalidDestination("staging-sync")
+	}
+	return nil
+}
+
+func cleanupStaging(objects []stagingObject) error {
+	var failure error
+	for i := len(objects) - 1; i >= 0; i-- {
+		obj := objects[i]
+		fresh, err := openMember(obj.parent, obj.name, obj.info.IsDir())
+		if err != nil {
+			failure = errors.Join(failure, err)
+			continue
+		}
+		info, statErr := fresh.Stat()
+		_ = fresh.Close()
+		if statErr != nil || !os.SameFile(obj.info, info) {
+			failure = errors.Join(failure, os.ErrInvalid)
+			continue
+		}
+		flags := 0
+		if obj.info.IsDir() {
+			flags = unix.AT_REMOVEDIR
+		}
+		if err := unix.Unlinkat(int(obj.parent.Fd()), obj.name, flags); err != nil {
+			failure = errors.Join(failure, err)
+		}
+	}
+	return failure
+}
diff --git a/internal/envsnapshot/publication_unix_test.go b/internal/envsnapshot/publication_unix_test.go
new file mode 100644
index 00000000..8013e727
--- /dev/null
+++ b/internal/envsnapshot/publication_unix_test.go
@@ -0,0 +1,429 @@
+//go:build darwin || linux
+
+package envsnapshot
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+func publicationFixture(t *testing.T) Publication {
+	t.Helper()
+	p := Publication{Manifest: read(t, "golden/manifest.json"), Launch: read(t, "golden/launch.json"), Files: map[string][]byte{}}
+	for _, f := range manifest(t).Files {
+		p.Files[f.Path] = read(t, "golden/"+f.Path)
+	}
+	return p
+}
+
+func publishControl(t *testing.T, root string, policy DestinationPolicy) {
+	t.Helper()
+	p := publicationFixture(t)
+	d := admitDestination(t, filepath.Join(root, "control"), policy, DestinationAbsent)
+	v, err := d.Publish(context.Background(), p)
+	if err != nil || v == nil || v.ManifestSHA256() != Digest(p.Manifest) {
+		t.Fatal("positive publication", v, err)
+	}
+}
+
+func requireOnlyEntries(t *testing.T, root string, names ...string) {
+	t.Helper()
+	entries, err := os.ReadDir(root)
+	if err != nil || len(entries) != len(names) {
+		t.Fatalf("unexpected entries: %v %v", entries, err)
+	}
+	want := map[string]bool{}
+	for _, name := range names {
+		want[name] = true
+	}
+	for _, entry := range entries {
+		if !want[entry.Name()] {
+			t.Fatalf("unexpected entry %s", entry.Name())
+		}
+	}
+}
+
+// Real no-replace publication produces independent private files with the exact
+// captured bytes and semantic modes. Repeat publication verifies a no-op;
+// a different generation refuses without changing even manifest inode/mtime.
+func TestPublicationPrivateAndPrior(t *testing.T) {
+	root, policy := destinationSandbox(t)
+	p := publicationFixture(t)
+	path := filepath.Join(root, "snapshot")
+	d := admitDestination(t, path, policy, DestinationAbsent)
+	v, err := d.Publish(context.Background(), p)
+	if err != nil || v == nil || v.ManifestSHA256() != Digest(p.Manifest) {
+		t.Fatal(v, err)
+	}
+	verified(t, path)
+	requireOnlyEntries(t, root, "protected", "snapshot")
+	before, err := os.Stat(filepath.Join(path, "manifest.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	v, err = d.Publish(context.Background(), p)
+	if err != nil || v == nil {
+		t.Fatal("no-op rejected", err)
+	}
+	p.Manifest = read(t, "golden/other-source-manifest.json")
+	v, err = d.Publish(context.Background(), p)
+	requireDestinationError(t, err, Mismatch, "generation-mismatch")
+	if v != nil {
+		t.Fatal("failure returned success")
+	}
+	after, err := os.Stat(filepath.Join(path, "manifest.json"))
+	if err != nil || !os.SameFile(before, after) || !before.ModTime().Equal(after.ModTime()) {
+		t.Fatal("prior changed", err)
+	}
+	// Captured content files, metadata and directories carry no imported xattrs
+	// or special/set-id modes. SNAP-ID independently checks modes and nlink=1.
+	if err := filepath.WalkDir(path, func(name string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		f, e := os.Open(name)
+		if e != nil {
+			return e
+		}
+		defer func() { _ = f.Close() }()
+		size, e := unix.Flistxattr(int(f.Fd()), nil)
+		if e != nil {
+			return e
+		}
+		if size != 0 {
+			names := make([]byte, size)
+			if _, e := unix.Flistxattr(int(f.Fd()), names); e != nil {
+				return e
+			}
+			// macOS may stamp its own provenance on a newly created object;
+			// this is not imported source metadata. No other xattr is admitted.
+			if runtime.GOOS != "darwin" || string(names) != "com.apple.provenance\x00" {
+				t.Fatalf("unexpected xattrs on %s: %q", entry.Name(), names)
+			}
+		}
+		return destinationACL(f)
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// Corrupt captured bytes, missing/extra entries and invalid metadata refuse
+// before staging; none can write a partial target or a scratch entry.
+func TestPublicationCapturedIdentity(t *testing.T) {
+	for _, name := range []string{"bytes", "missing", "extra", "metadata", "mode"} {
+		t.Run(name, func(t *testing.T) {
+			root, policy := destinationSandbox(t)
+			publishControl(t, root, policy)
+			p := publicationFixture(t)
+			switch name {
+			case "bytes":
+				p.Files["home/AGENTS.md"][0] ^= 1
+			case "missing":
+				delete(p.Files, "home/AGENTS.md")
+			case "extra":
+				p.Files["../outside"] = []byte("forbidden")
+			case "metadata":
+				p.Manifest = append(p.Manifest, '\n')
+			case "mode":
+				p.Manifest = bytes.ReplaceAll(p.Manifest, []byte(`"0600"`), []byte(`"0777"`))
+			}
+			d := admitDestination(t, filepath.Join(root, "target"), policy, DestinationAbsent)
+			v, err := d.Publish(context.Background(), p)
+			requireDestinationError(t, err, Mismatch, "")
+			if v != nil {
+				t.Fatal("failure returned success")
+			}
+			requireOnlyEntries(t, root, "protected", "control")
+		})
+	}
+}
+
+// A real mkdir/link/file syscall at the destination AFTER final revalidation
+// cannot be overwritten by publication. The positive control uses the same
+// backend without competition. A competing empty directory catches rename
+// implementations that silently replace empty directories.
+func TestPublicationNoReplaceRace(t *testing.T) {
+	for _, name := range []string{"empty", "snapshot", "file", "link"} {
+		t.Run(name, func(t *testing.T) {
+			root, policy := destinationSandbox(t)
+			publishControl(t, root, policy)
+			path := filepath.Join(root, "target")
+			d := admitDestination(t, path, policy, DestinationAbsent)
+			var before os.FileInfo
+			d.publicationHook = func(phase string, _ *os.File) error {
+				if phase != "before-rename" {
+					return nil
+				}
+				var err error
+				switch name {
+				case "empty":
+					err = os.Mkdir(path, 0700)
+				case "snapshot":
+					snapshotAtDestination(t, path)
+				case "file":
+					err = os.WriteFile(path, []byte("preserved"), 0600)
+				case "link":
+					err = os.Symlink(filepath.Join(root, "control"), path)
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				before, err = os.Lstat(path)
+				if err != nil {
+					t.Fatal(err)
+				}
+				return nil
+			}
+			v, err := d.Publish(context.Background(), publicationFixture(t))
+			requireDestinationError(t, err, DestinationInvalid, "publication-no-replace")
+			if v != nil {
+				t.Fatal("race returned success")
+			}
+			after, err := os.Lstat(path)
+			if err != nil || !os.SameFile(before, after) || !before.ModTime().Equal(after.ModTime()) || before.Mode() != after.Mode() {
+				t.Fatal("competitor replaced", err)
+			}
+			if name == "empty" {
+				requireOnlyEntries(t, path)
+			}
+			if name == "file" {
+				b, e := os.ReadFile(path)
+				if e != nil || string(b) != "preserved" {
+					t.Fatal("competitor bytes", e)
+				}
+			}
+			verified(t, filepath.Join(root, "control"))
+			requireOnlyEntries(t, root, "protected", "control", "target")
+		})
+	}
+}
+
+// Replacing the ancestor with a link during the final syscall window never
+// redirects writes. Publication is anchored to the retained original parent;
+// rechecking the chain then refuses success and leaves that object for inspection.
+func TestPublicationRetainedParentRace(t *testing.T) {
+	root, policy := destinationSandbox(t)
+	publishControl(t, root, policy)
+	parent := filepath.Join(root, "parent")
+	if err := os.Mkdir(parent, 0700); err != nil {
+		t.Fatal(err)
+	}
+	outside := filepath.Join(root, "outside")
+	write(t, outside, "sentinel", []byte("preserved"), 0600)
+	d := admitDestination(t, filepath.Join(parent, "target"), policy, DestinationAbsent)
+	d.publicationHook = func(phase string, _ *os.File) error {
+		if phase != "before-rename" {
+			return nil
+		}
+		if err := os.Rename(parent, parent+"-original"); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Symlink(outside, parent); err != nil {
+			t.Fatal(err)
+		}
+		return nil
+	}
+	v, err := d.Publish(context.Background(), publicationFixture(t))
+	requireDestinationError(t, err, DestinationInvalid, "ancestor-changed")
+	if v != nil {
+		t.Fatal("changed ancestor returned success")
+	}
+	requireOnlyEntries(t, outside, "sentinel")
+	verified(t, filepath.Join(parent+"-original", "target"))
+}
+
+// Cancellation and an injected I/O failure clean only recorded private staging
+// entries; unrelated sibling directories and links (including another snapshot)
+// survive. No cancellation emits success or publishes a partial target.
+func TestPublicationStagingOnlyCleanup(t *testing.T) {
+	for _, phase := range []string{"before-start", "stage-created", "file-staged", "before-rename", "io-failure"} {
+		t.Run(phase, func(t *testing.T) {
+			root, policy := destinationSandbox(t)
+			publishControl(t, root, policy)
+			write(t, root, "unrelated/sentinel", []byte("preserved"), 0600)
+			if err := os.Symlink(filepath.Join(root, "unrelated"), filepath.Join(root, ".curator-snapshot-foreign")); err != nil {
+				t.Fatal(err)
+			}
+			d := admitDestination(t, filepath.Join(root, "target"), policy, DestinationAbsent)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if phase == "before-start" {
+				cancel()
+			}
+			d.publicationHook = func(at string, _ *os.File) error {
+				if phase == "io-failure" && at == "file-staged" {
+					return os.ErrPermission
+				}
+				if phase == at {
+					cancel()
+				}
+				return nil
+			}
+			v, err := d.Publish(ctx, publicationFixture(t))
+			reason := "publication-interrupted"
+			if phase == "io-failure" {
+				reason = "staging-io"
+			}
+			requireDestinationError(t, err, DestinationInvalid, reason)
+			if v != nil {
+				t.Fatal("failure returned success")
+			}
+			assertAbsent(t, filepath.Join(root, "target"))
+			requireOnlyEntries(t, root, "protected", "control", "unrelated", ".curator-snapshot-foreign")
+			b, e := os.ReadFile(filepath.Join(root, "unrelated/sentinel"))
+			if e != nil || string(b) != "preserved" {
+				t.Fatal("outside cleanup", e)
+			}
+			verified(t, filepath.Join(root, "control"))
+		})
+	}
+}
+
+// A real kernel permission failure during staging is not success. Cleanup can
+// remove its empty stage without walking other trees. Not qualified under root.
+func TestPublicationKernelStagingFailure(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("requires unprivileged kernel permission checks")
+	}
+	root, policy := destinationSandbox(t)
+	publishControl(t, root, policy)
+	d := admitDestination(t, filepath.Join(root, "target"), policy, DestinationAbsent)
+	d.publicationHook = func(phase string, stage *os.File) error {
+		if phase == "stage-created" {
+			if err := stage.Chmod(0500); err != nil {
+				t.Fatal(err)
+			}
+		}
+		return nil
+	}
+	v, err := d.Publish(context.Background(), publicationFixture(t))
+	requireDestinationError(t, err, DestinationInvalid, "staging-create")
+	if v != nil {
+		t.Fatal("failure returned success")
+	}
+	requireOnlyEntries(t, root, "protected", "control")
+}
