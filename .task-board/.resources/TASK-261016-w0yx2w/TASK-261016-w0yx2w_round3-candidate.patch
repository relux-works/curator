diff --git a/internal/envsnapshot/destination.go b/internal/envsnapshot/destination.go
new file mode 100644
index 00000000..8c50380f
--- /dev/null
+++ b/internal/envsnapshot/destination.go
@@ -0,0 +1,25 @@
+package envsnapshot
+
+// DestinationInvalid is the normative destination refusal, distinct from a
+// malformed or changed prior snapshot (Mismatch).
+const DestinationInvalid = "environment_materialize_destination_invalid"
+
+func invalidDestination(reason string) error { return &Error{DestinationInvalid, reason} }
+
+// DestinationPolicy supplies the complete existing protected-root inventory.
+// The materialize coordinator must supply manager roots, stores, managed/native
+// homes, credential roots, repository administration and the active workspace.
+// Unreadable or missing supplied roots refuse; they are never silently omitted.
+// Inventory discovery and capture authorization are separate from admission.
+type DestinationPolicy struct {
+	ProtectedRoots []string
+}
+
+// DestinationKind describes an observation, never permission to rename a path.
+type DestinationKind string
+
+// Admitted destination states; none authorizes publication by pathname.
+const (
+	DestinationAbsent   DestinationKind = "absent"
+	DestinationSnapshot DestinationKind = "snapshot"
+)
diff --git a/internal/envsnapshot/destination_acl_darwin.go b/internal/envsnapshot/destination_acl_darwin.go
new file mode 100644
index 00000000..5e9ae2b2
--- /dev/null
+++ b/internal/envsnapshot/destination_acl_darwin.go
@@ -0,0 +1,63 @@
+//go:build darwin
+
+package envsnapshot
+
+import (
+	"encoding/binary"
+	"os"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+// fgetattrlist reads the ACL of the retained object, not its pathname. Layouts
+// and bounds are from sys/attr.h and sys/kauth.h (128 ACEs, 24 bytes each).
+// A deny-only ACL on an ancestor cannot broaden Unix permissions. All grants,
+// unknown ACE kinds and malformed/unreadable evidence refuse conservatively.
+func destinationACL(f *os.File) error {
+	attrs := unix.Attrlist{Bitmapcount: 5, Commonattr: unix.ATTR_CMN_EXTENDED_SECURITY}
+	var buf [4096]byte
+	// #nosec G103 -- synchronous kernel ABI: fixed, live attrlist/buffer;
+	// no pointers escape and every returned offset/length is checked below.
+	_, _, errno := unix.Syscall6(unix.SYS_FGETATTRLIST, f.Fd(), uintptr(unsafe.Pointer(&attrs)), uintptr(unsafe.Pointer(&buf[0])), uintptr(len(buf)), unix.FSOPT_REPORT_FULLSIZE, 0) //nolint:staticcheck // SA1019: x/sys has no wrapper; qualified by kernel ACL tests, failure refuses closed.
+	if errno != 0 {
+		return errno
+	}
+	n := int(binary.NativeEndian.Uint32(buf[:4]))
+	if n < 12 || n > len(buf) {
+		return os.ErrPermission
+	}
+	rawOffset := binary.NativeEndian.Uint32(buf[4:8])
+	if rawOffset > uint32(len(buf)-4) {
+		return os.ErrPermission
+	}
+	offset := int(rawOffset) + 4
+	length := int(binary.NativeEndian.Uint32(buf[8:12]))
+	if length == 0 {
+		return nil
+	}
+	if offset < 12 || length < 44 || offset > n || length > n-offset {
+		return os.ErrPermission
+	}
+	sec := buf[offset : offset+length]
+	if binary.NativeEndian.Uint32(sec[:4]) != 0x012cc16d {
+		return os.ErrPermission
+	}
+	count := binary.NativeEndian.Uint32(sec[36:40])
+	if count == 0xffffffff {
+		return nil
+	}
+	if count > 128 || int(count)*24 > len(sec)-44 {
+		return os.ErrPermission
+	}
+	for i := 0; i < int(count); i++ {
+		flags := binary.NativeEndian.Uint32(sec[44+i*24+16 : 44+i*24+20])
+		if flags&^uint32(0x1ff) != 0 {
+			return os.ErrPermission
+		}
+		if flags&0xf != 2 { // KAUTH_ACE_DENY; a permit never qualifies.
+			return os.ErrPermission
+		}
+	}
+	return nil
+}
diff --git a/internal/envsnapshot/destination_acl_darwin_test.go b/internal/envsnapshot/destination_acl_darwin_test.go
new file mode 100644
index 00000000..c7263ebb
--- /dev/null
+++ b/internal/envsnapshot/destination_acl_darwin_test.go
@@ -0,0 +1,64 @@
+//go:build darwin
+
+package envsnapshot
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+// A real kernel deny-only ancestor ACL cannot broaden mode permissions; a
+// kernel permit ACE does broaden them and must refuse even with mode 0700.
+func TestDestinationKernelACL(t *testing.T) {
+	root, policy := destinationSandbox(t)
+	parent := filepath.Join(root, "acl-parent")
+	if err := os.Mkdir(parent, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if out, err := exec.Command("/bin/chmod", "-N", parent).CombinedOutput(); err != nil {
+			t.Errorf("ACL fixture cleanup failed: %v %s", err, out)
+		}
+	})
+	chmod := func(acl string) {
+		t.Helper()
+		if out, err := exec.Command("/bin/chmod", "+a", acl, parent).CombinedOutput(); err != nil {
+			t.Fatalf("ACL setup failed: %v %s", err, out)
+		}
+	}
+	chmod("everyone deny delete")
+	d := admitDestination(t, filepath.Join(parent, "child"), policy, DestinationAbsent)
+	chmod("everyone allow add_file,add_subdirectory")
+	_, err := OpenDestination(filepath.Join(parent, "child"), policy)
+	requireDestinationError(t, err, DestinationInvalid, "directory-acl")
+	requireDestinationError(t, d.Revalidate(), DestinationInvalid, "directory-acl")
+	assertAbsent(t, filepath.Join(parent, "child"))
+}
+
+// SNAP-ID's mode/byte checks alone cannot detect a file ACL granting another
+// principal read access. Prior admission and later MatchPrior both refuse it.
+func TestDestinationPriorKernelACL(t *testing.T) {
+	root, policy := destinationSandbox(t)
+	path := filepath.Join(root, "snapshot")
+	snapshotAtDestination(t, path)
+	d := admitDestination(t, path, policy, DestinationSnapshot)
+	member := filepath.Join(path, "home/AGENTS.md")
+	t.Cleanup(func() {
+		if out, err := exec.Command("/bin/chmod", "-N", member).CombinedOutput(); err != nil {
+			t.Errorf("ACL fixture cleanup failed: %v %s", err, out)
+		}
+	})
+	if out, err := exec.Command("/bin/chmod", "+a", "everyone allow read", member).CombinedOutput(); err != nil {
+		t.Fatalf("ACL setup failed: %v %s", err, out)
+	}
+	_, err := d.MatchPrior(read(t, "golden/manifest.json"))
+	requireDestinationError(t, err, Mismatch, "snapshot-owner-acl")
+	_, err = OpenDestination(path, policy)
+	requireDestinationError(t, err, Mismatch, "snapshot-owner-acl")
+	b, err := os.ReadFile(member)
+	if err != nil || Digest(b) != Digest(read(t, "golden/home/AGENTS.md")) {
+		t.Fatal("prior ACL refusal changed file bytes", err)
+	}
+}
diff --git a/internal/envsnapshot/destination_acl_linux.go b/internal/envsnapshot/destination_acl_linux.go
new file mode 100644
index 00000000..919173ed
--- /dev/null
+++ b/internal/envsnapshot/destination_acl_linux.go
@@ -0,0 +1,22 @@
+//go:build linux
+
+package envsnapshot
+
+import (
+	"errors"
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// Refuse extended access and inherited/default ACLs. ENODATA is evidence of
+// absence; an unsupported filesystem or a failed ACL read is not absence.
+func destinationACL(f *os.File) error {
+	for _, name := range []string{"system.posix_acl_access", "system.posix_acl_default"} {
+		_, err := unix.Fgetxattr(int(f.Fd()), name, nil)
+		if !errors.Is(err, unix.ENODATA) {
+			return os.ErrPermission
+		}
+	}
+	return nil
+}
diff --git a/internal/envsnapshot/destination_acl_linux_test.go b/internal/envsnapshot/destination_acl_linux_test.go
new file mode 100644
index 00000000..a2e8763f
--- /dev/null
+++ b/internal/envsnapshot/destination_acl_linux_test.go
@@ -0,0 +1,73 @@
+//go:build linux
+
+package envsnapshot
+
+import (
+	"encoding/binary"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+// Real access/default POSIX ACLs refuse even when Unix mode bits alone grant
+// no group/other write. Tests require an ACL-capable filesystem, never skip a
+// failed ACL operation as if it were evidence of absence.
+func TestDestinationKernelACL(t *testing.T) {
+	for _, attr := range []string{"system.posix_acl_access", "system.posix_acl_default"} {
+		t.Run(attr, func(t *testing.T) {
+			root, policy := destinationSandbox(t)
+			parent := filepath.Join(root, "acl-parent")
+			if err := os.Mkdir(parent, 0700); err != nil {
+				t.Fatal(err)
+			}
+			d := admitDestination(t, filepath.Join(parent, "child"), policy, DestinationAbsent)
+			setDestinationKernelACL(t, parent, attr)
+			_, err := OpenDestination(filepath.Join(parent, "child"), policy)
+			requireDestinationError(t, err, DestinationInvalid, "directory-acl")
+			requireDestinationError(t, d.Revalidate(), DestinationInvalid, "directory-acl")
+			assertAbsent(t, filepath.Join(parent, "child"))
+		})
+	}
+}
+
+func setDestinationKernelACL(t *testing.T, parent, attr string) {
+	t.Helper()
+	// Linux posix_acl_xattr_header(version=2) + five tagged entries.
+	acl := make([]byte, 4+5*8)
+	binary.LittleEndian.PutUint32(acl, 2)
+	entries := []struct {
+		tag, perm uint16
+		id        uint32
+	}{
+		{1, 7, 0xffffffff}, {2, 4, 65534}, {4, 0, 0xffffffff},
+		{16, 4, 0xffffffff}, {32, 0, 0xffffffff},
+	}
+	for i, e := range entries {
+		binary.LittleEndian.PutUint16(acl[4+i*8:], e.tag)
+		binary.LittleEndian.PutUint16(acl[6+i*8:], e.perm)
+		binary.LittleEndian.PutUint32(acl[8+i*8:], e.id)
+	}
+	if err := unix.Setxattr(parent, attr, acl, 0); err != nil {
+		t.Fatal("kernel ACL setup failed", err)
+	}
+}
+
+// A default ACL on a prior home directory can affect future children without
+// changing its 0700 mode; actual prior admission must still reject it.
+func TestDestinationPriorKernelACL(t *testing.T) {
+	root, policy := destinationSandbox(t)
+	path := filepath.Join(root, "snapshot")
+	snapshotAtDestination(t, path)
+	d := admitDestination(t, path, policy, DestinationSnapshot)
+	setDestinationKernelACL(t, filepath.Join(path, "home"), "system.posix_acl_default")
+	_, err := d.MatchPrior(read(t, "golden/manifest.json"))
+	requireDestinationError(t, err, Mismatch, "snapshot-owner-acl")
+	_, err = OpenDestination(path, policy)
+	requireDestinationError(t, err, Mismatch, "snapshot-owner-acl")
+	b, err := os.ReadFile(filepath.Join(path, "manifest.json"))
+	if err != nil || Digest(b) != Digest(read(t, "golden/manifest.json")) {
+		t.Fatal("prior ACL refusal changed metadata", err)
+	}
+}
diff --git a/internal/envsnapshot/destination_controls_test.go b/internal/envsnapshot/destination_controls_test.go
