+def _same_directory_identity(
+    expected: os.stat_result,
+    actual: os.stat_result,
+) -> bool:
+    return (
+        stat.S_ISDIR(actual.st_mode)
+        and actual.st_dev == expected.st_dev
+        and actual.st_ino == expected.st_ino
+        and actual.st_uid == expected.st_uid
+    )
+
