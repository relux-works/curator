+   `CURATOR_CONFORMANCE_ROOT=/Users/iv/Developer/ReluxWorks/curator/.temp/TASK-260729-3nx97g/worktree/conformance/v1 /Users/iv/Developer/Wildberries/cocoaskills/.temp/TASK-260720-2jfnz6/venv/bin/python -m pytest -q --basetemp=/private/tmp/TASK-260720-2jfnz6-rework-pytest.XRws2T`
