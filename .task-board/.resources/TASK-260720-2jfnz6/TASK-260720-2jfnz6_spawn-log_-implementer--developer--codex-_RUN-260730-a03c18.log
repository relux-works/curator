        os.fsync(descriptor)
        return descriptor, original_mode
    if stat.S_IMODE(current.st_mode) & 0o200:
        os.close(descriptor)
        return None, None
    try:
        os.fchmod(descriptor, original_mode | 0o700)
        os.fsync(descriptor)
    except OSError:
        os.close(descriptor)
        raise
    return descriptor, original_mode


