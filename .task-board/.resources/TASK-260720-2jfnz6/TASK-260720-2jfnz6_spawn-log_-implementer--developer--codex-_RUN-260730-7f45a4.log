+def _pause_first_seal(
+    monkeypatch: pytest.MonkeyPatch,
+) -> tuple[threading.Event, threading.Event, list[int]]:
+    first_renamed = threading.Event()
+    release_first = threading.Event()
+    seal_identities: list[int] = []
