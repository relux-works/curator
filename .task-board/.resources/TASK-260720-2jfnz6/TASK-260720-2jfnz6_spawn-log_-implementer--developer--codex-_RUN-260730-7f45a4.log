+        tmp_path,
+        build_input,
+        b"second artifact",
+    )
+    first_renamed, release_first, seal_identities = _pause_first_seal(
+        monkeypatch
+    )
+    stores = (PosixBuildCache(home), PosixBuildCache(home))
