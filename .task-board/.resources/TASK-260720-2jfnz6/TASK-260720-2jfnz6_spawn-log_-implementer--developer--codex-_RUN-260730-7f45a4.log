+    assert stat.S_IMODE(quarantine[0].stat().st_mode) == 0o500
+    assert list((home / cache_posix.STAGING_ROOT_NAME).iterdir()) == []
+    assert store.inspect(
+        CacheExpectation(
+            input=build_input,
+            receipt_sha256=receipt_hash,
+        )
+    ).status is CacheEntryStatus.HIT
+
