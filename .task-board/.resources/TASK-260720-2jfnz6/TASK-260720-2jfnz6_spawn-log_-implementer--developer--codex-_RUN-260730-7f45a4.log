+        monkeypatch
+    )
+    stores = (PosixBuildCache(home), PosixBuildCache(home))
+
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        first_future = executor.submit(
+            stores[0].publish,
+            publication,
+            guard=_HeldGuard(),
+        )
+        reached_seal = first_renamed.wait(timeout=5)
+        if not reached_seal:
