+                immutable=True,
+            ) as selected_entry_fd:
+                selected = _inspect_open_entry(
+                    selected_entry_fd,
+                    CacheExpectation(input=expectation.input),
+                    key,
+                    artifact_name,
+                )
+                if _same_directory_identity(
+                    published_state,
+                    os.fstat(selected_entry_fd),
