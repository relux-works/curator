+def _resolve_atomic_winner(
+    driver_fd: int,
+    entry_name: str,
+    published_entry_fd: int,
+    published: _VerifiedEntry,
+    expectation: CacheExpectation,
+    key: str,
+    artifact_name: str,
+    guard: CacheMutationGuard,
