   704	def _validate_manager_home(descriptor: int) -> None:
   705	    info = os.fstat(descriptor)
   706	    if not stat.S_ISDIR(info.st_mode):
   707	        raise _UntrustedState("manager home is not a directory")
   708	    if info.st_uid != _effective_uid():
   709	        raise _UntrustedState(
   710	            "manager home owner does not match the effective user"
   711	        )
   712	    mode = stat.S_IMODE(info.st_mode)
   713	    if mode & 0o022:
   714	        raise _UntrustedState("manager home is writable by group or other")
   715	    if mode & 0o700 != 0o700:
   716	        raise _UntrustedState("manager home does not grant owner control")
