   537	def _rename_noreplace_available() -> bool:
   538	    library = ctypes.CDLL(None)
   539	    if sys.platform == "darwin":
   540	        return hasattr(library, "renameatx_np")
   541	    if sys.platform.startswith("linux"):
   542	        return hasattr(library, "renameat2")
   543	    return False
