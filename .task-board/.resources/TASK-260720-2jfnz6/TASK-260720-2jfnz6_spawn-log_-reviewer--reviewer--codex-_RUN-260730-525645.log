   389	def verify_receipt(
   390	    raw: bytes,
   391	    *,
   392	    expected_input: GoBuildInput,
   393	    expected_cache_key: str | None = None,
   394	    expected_receipt_sha256: str | None = None,
   395	) -> BuildReceipt:
   396	    """Recanonicalize a stored receipt and bind it to the expected input.
   397	
   398	    This is the portable half of protected-entry validation: stored-byte
   399	    canonicality, the receipt's own key, the entire expected input, the
   400	    manager-derived artifact path, and the receipt hash. Boundary ownership,
   401	    link safety, and artifact bytes belong to the cache owner.
   402	    """
   403	
   404	    receipt = read_receipt(raw)
   405	    expected_key = cache_key(expected_input)
   406	    if expected_cache_key is not None and expected_cache_key != expected_key:
   407	        raise BuildMetadataError(
   408	            "cache_key_mismatch",
   409	            f"looked-up cache key {expected_cache_key} does not equal the key the expected input derives",
   410	        )
   411	    if receipt.input != expected_input:
   412	        raise BuildMetadataError("cache_input_mismatch", "receipt input does not equal the expected build input")
   413	    if receipt.cache_key != expected_key:
   414	        raise BuildMetadataError(
   415	            "cache_key_mismatch",
   416	            f"receipt cache_key {receipt.cache_key} does not equal the expected key {expected_key}",
   417	        )
   418	    if expected_receipt_sha256 is not None:
   419	        _require_sha256(expected_receipt_sha256, "expected receipt_sha256", "receipt_hash_mismatch")
   420	        actual = receipt_sha256(raw)
   421	        if actual != expected_receipt_sha256:
   422	            raise BuildMetadataError(
   423	                "receipt_hash_mismatch",
   424	                f"stored receipt hashes to {actual}, not the recorded {expected_receipt_sha256}",
   425	            )
   426	    return receipt
