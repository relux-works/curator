   900	def _stable_file_state(
   901	    before: os.stat_result,
   902	    after: os.stat_result,
   903	) -> bool:
   904	    return (
   905	        before.st_dev,
   906	        before.st_ino,
   907	        before.st_mode,
   908	        before.st_uid,
   909	        before.st_nlink,
   910	        before.st_size,
   911	        before.st_mtime_ns,
   912	        before.st_ctime_ns,
   913	    ) == (
   914	        after.st_dev,
   915	        after.st_ino,
   916	        after.st_mode,
   917	        after.st_uid,
   918	        after.st_nlink,
   919	        after.st_size,
   920	        after.st_mtime_ns,
   921	        after.st_ctime_ns,
   922	    )
