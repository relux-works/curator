   380	    receipt = parse_receipt(decoded)
   381	    if canonical_receipt_bytes(receipt) != raw:
   382	        raise BuildMetadataError(
   383	            "receipt_not_canonical",
   384	            "stored receipt bytes do not equal the canonical encoding of their own value",
