   377	        decoded = protocol_json.loads_canonical(raw)
   378	    except protocol_json.ProtocolJSONError as exc:
   379	        raise BuildMetadataError("receipt_not_canonical", f"stored receipt is not CCJ-1: {exc}") from exc
