   512	def _protection_supported() -> bool:
   513	    if os.name != "posix":
   514	        return False
   515	    required_flags = all(
   516	        hasattr(os, name)
   517	        for name in (
   518	            "O_CLOEXEC",
   519	            "O_DIRECTORY",
   520	            "O_NOFOLLOW",
   521	        )
   522	    )
   523	    required_calls = (
   524	        os.open in os.supports_dir_fd
   525	        and os.mkdir in os.supports_dir_fd
   526	        and os.rename in os.supports_dir_fd
   527	        and os.listdir in os.supports_fd
   528	    )
   529	    return (
   530	        required_flags
   531	        and required_calls
   532	        and hasattr(os, "geteuid")
   533	        and _rename_noreplace_available()
   534	    )
