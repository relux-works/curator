   564	def _key_component(cache_key: str) -> str:
   565	    prefix = "sha256:"
   566	    if (
   567	        not isinstance(cache_key, str)
   568	        or not cache_key.startswith(prefix)
   569	        or len(cache_key) != len(prefix) + 64
   570	    ):
   571	        raise BuildCacheError("cache_key_invalid", "logical cache key is malformed")
   572	    component = cache_key.removeprefix(prefix)
   573	    if any(character not in "0123456789abcdef" for character in component):
   574	        raise BuildCacheError("cache_key_invalid", "logical cache key is malformed")
   575	    return component
