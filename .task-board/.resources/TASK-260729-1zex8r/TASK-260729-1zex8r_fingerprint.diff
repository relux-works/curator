+// toolchainWalk collects the canonical record set. It reproduces exactly what
+// fs.WalkDir over os.Root.FS() produced — the same entries, the same
+// name-sorted visit order, and therefore the same error precedence — but it
+// descends through a handle scoped to each directory instead of re-resolving
+// every root-relative path one component at a time for the walk and again for
+// the Lstat. Only the symlink checks stay anchored at GOROOT, because a link
+// target is validated against the root, not against its own directory.
+type toolchainWalk struct {
+	root    *os.Root
+	records []treeRecord
+	encoded map[string]struct{}
+}
+
+func (walk *toolchainWalk) descend(ctx context.Context, dir *os.Root, prefix string) error {
+	if err := ctx.Err(); err != nil {
+		return diagnosticErr("toolchain_timeout", err, "toolchain fingerprint deadline exceeded")
+	}
+	entries, readErr := readScopedDir(dir)
+	if readErr != nil {
+		return diagnosticErr("toolchain_unreadable", readErr, "cannot walk GOROOT")
+	}
+	for _, entry := range entries {
+		if err := ctx.Err(); err != nil {
+			return diagnosticErr("toolchain_timeout", err, "toolchain fingerprint deadline exceeded")
+		}
+		name := entry.Name()
+		protocolPath := filepath.ToSlash(name)
+		if prefix != "" {
+			protocolPath = prefix + "/" + protocolPath
+		}
+		if !validToolchainPath(protocolPath) {
+			return diagnostic("invalid_unicode", "toolchain path is not valid protocol UTF-8")
+		}
+		if err := claimEncodedPath(walk.encoded, protocolPath); err != nil {
+			return err
+		}
+
+		info, statErr := dir.Lstat(name)
+		if statErr != nil {
+			return diagnosticErr("toolchain_unreadable", statErr, "cannot inspect toolchain path %q", protocolPath)
+		}
+		record := treeRecord{path: protocolPath, directory: prefix, base: name, info: info}
+		switch {
+		case info.Mode().IsDir():
+			record.kind = 'D'
+		case info.Mode().IsRegular():
+			record.kind = 'F'
+		case info.Mode()&fs.ModeSymlink != 0:
+			record.kind = 'L'
+			target, readErr := dir.Readlink(name)
+			if readErr != nil {
+				return diagnosticErr("toolchain_link_dangling", readErr, "cannot read toolchain link %q", protocolPath)
+			}
+			if !utf8.ValidString(target) || strings.ContainsRune(target, 0) {
+				return diagnostic("invalid_unicode", "toolchain link %q has an invalid target", protocolPath)
+			}
+			// A rooted target is absolute regardless of host path conventions:
+			// Windows treats a leading separator as drive-relative rather than
+			// absolute, so filepath.IsAbs alone would admit "/etc/passwd" there.
+			if filepath.IsAbs(target) || filepath.VolumeName(target) != "" ||
+				strings.HasPrefix(target, "/") || strings.HasPrefix(target, `\`) {
+				return diagnostic("toolchain_link_absolute", "toolchain link %q is absolute", protocolPath)
+			}
+			resolvedName := filepath.Clean(filepath.Join(filepath.Dir(protocolPath), target))
+			if resolvedName == ".." || strings.HasPrefix(resolvedName, ".."+string(filepath.Separator)) || filepath.IsAbs(resolvedName) {
+				return diagnostic("toolchain_link_escape", "toolchain link %q escapes GOROOT", protocolPath)
+			}
+			// Anchored at GOROOT on purpose: a link may legitimately point at a
+			// sibling subtree ("pkg/tool-link" -> "../bin/go"), which resolves
+			// inside the root but outside its own directory.
+			if _, statErr := walk.root.Stat(protocolPath); statErr != nil {
+				return diagnosticErr("toolchain_link_dangling", statErr, "toolchain link %q does not resolve safely", protocolPath)
+			}
+			record.link = target
+		default:
+			return diagnostic("special_file_forbidden", "toolchain path %q is not a directory, regular file, or link", protocolPath)
+		}
+		walk.records = append(walk.records, record)
+
+		// Only real directories are descended, matching fs.WalkDir, which
+		// decides from the lstat-backed directory entry and therefore never
+		// follows a symlinked directory.
+		if record.kind != 'D' {
+			continue
+		}
+		child, openErr := dir.OpenRoot(name)
+		if openErr != nil {
+			return diagnosticErr("toolchain_unreadable", openErr, "cannot walk GOROOT")
+		}
+		descendErr := walk.descend(ctx, child, protocolPath)
+		_ = child.Close()
+		if descendErr != nil {
+			return descendErr
+		}
+	}
+	return nil
+}
+
+// readScopedDir lists one directory through its own handle. os.Root.FS() sorts
+// entries by name before fs.WalkDir sees them; the canonical record set is
+// sorted again later and does not depend on this order, but which offending
+// entry reports the first error does, so the same order is reproduced here.
+func readScopedDir(dir *os.Root) ([]fs.DirEntry, error) {
+	handle, err := dir.Open(".")
+	if err != nil {
+		return nil, err
+	}
+	entries, readErr := handle.ReadDir(-1)
+	closeErr := handle.Close()
+	if readErr != nil {
+		return nil, readErr
+	}
+	if closeErr != nil {
+		return nil, closeErr
+	}
+	sort.Slice(entries, func(left, right int) bool { return entries[left].Name() < entries[right].Name() })
+	return entries, nil
+}
+
+// scopedDirs hands out a handle for the directory a record lives in, keeping
+// the open ancestor chain of the previous lookup. Records are consumed in
+// sorted path order, which keeps a directory adjacent to its own subtree, so
+// each component is opened once per contiguous run rather than once per file.
+// Every hop is a single-component open under the parent handle, so containment
+// is checked per component exactly as a full-path open would.
+type scopedDirs struct {
+	root       *os.Root
+	components []string
+	handles    []*os.Root
+}
+
+func (dirs *scopedDirs) current() *os.Root {
+	if len(dirs.handles) == 0 {
+		return dirs.root
+	}
+	return dirs.handles[len(dirs.handles)-1]
+}
+
+// open resolves a slash-separated root-relative directory, where "" is GOROOT.
+func (dirs *scopedDirs) open(directory string) (*os.Root, error) {
+	var wanted []string
+	if directory != "" {
+		wanted = strings.Split(directory, "/")
+	}
+	shared := 0
+	for shared < len(wanted) && shared < len(dirs.components) && wanted[shared] == dirs.components[shared] {
+		shared++
+	}
+	dirs.unwind(shared)
+	for _, component := range wanted[shared:] {
+		child, err := dirs.current().OpenRoot(component)
+		if err != nil {
+			return nil, err
+		}
+		dirs.components = append(dirs.components, component)
+		dirs.handles = append(dirs.handles, child)
+	}
+	return dirs.current(), nil
+}
+
+func (dirs *scopedDirs) unwind(depth int) {
+	for len(dirs.handles) > depth {
+		last := len(dirs.handles) - 1
+		_ = dirs.handles[last].Close()
+		dirs.handles = dirs.handles[:last]
+		dirs.components = dirs.components[:last]
+	}
+}
+
+func (dirs *scopedDirs) close() { dirs.unwind(0) }
+
