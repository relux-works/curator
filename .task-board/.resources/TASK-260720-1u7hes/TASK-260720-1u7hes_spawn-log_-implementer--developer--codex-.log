+	if _, ok := commands["script-tool"]; !ok {
+		t.Fatal("generated v6 case does not preserve script commands")
+	}
+	if _, ok := commands["system-tool"]; !ok {
+		t.Fatal("generated v6 case does not preserve system commands")
+	}
