import json
from pathlib import Path
root=Path('.')
manifest=json.loads((root/'conformance/v1/manifest.json').read_text())
index=json.loads((root/'conformance/v1/schema-cases/index.json').read_text())
print('manifest protocol',manifest.get('protocol_version'),'entries',len(manifest.get('files',[])))
print('manifest keys',manifest.keys())
