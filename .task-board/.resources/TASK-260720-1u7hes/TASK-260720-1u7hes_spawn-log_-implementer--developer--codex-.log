+def validate_protocol_artifacts(version: str) -> None:
+    if version != PROTOCOL_VERSION:
+        return
+
+    missing = sorted(path for path in RC4_REQUIRED_FILES if not (ROOT / path).is_file())
+    if missing:
+        raise ReleaseFailure(f"{PROTOCOL_VERSION} required artifacts are missing: {missing}")
