+def validate_protocol_artifacts(version: str) -> None:
+    if version != PROTOCOL_VERSION:
+        return
+
+    missing = sorted(path for path in RC4_REQUIRED_FILES if not (ROOT / path).is_file())
+    if missing:
+        raise ReleaseFailure(f"{PROTOCOL_VERSION} required artifacts are missing: {missing}")
+
+    result = subprocess.run(
+        [sys.executable, "-B", str(ROOT / "tools" / "validate.py")],
+        cwd=ROOT,
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode != 0:
+        detail = result.stderr.strip() or result.stdout.strip()
+        raise ReleaseFailure(f"{PROTOCOL_VERSION} specification validation failed: {detail}")
+
+    schemas = ROOT / "schemas" / "v1"
+    actual_schemas = {path.name for path in schemas.glob("*.json")}
+    if actual_schemas != EXPECTED_SCHEMAS:
+        raise ReleaseFailure(f"{PROTOCOL_VERSION} schema inventory is inconsistent")
+
+    schema_expectations = {
+        "agent-skill-v6.schema.json": (6, None),
+        "csk-skill-v6.schema.json": (6, None),
+        "build-receipt-v1.schema.json": (1, None),
+        "install-marker-v2.schema.json": (2, None),
+        "conformance-claim-v2.schema.json": (2, PROTOCOL_VERSION),
+    }
+    for name, (schema_version, protocol_version) in schema_expectations.items():
+        document = load_json(schemas / name)
+        properties = document.get("properties")
+        if not isinstance(properties, dict):
+            raise ReleaseFailure(f"{name} has no properties")
+        if properties.get("schema_version") != {"const": schema_version}:
+            raise ReleaseFailure(f"{name} has the wrong schema_version identity")
+        if protocol_version is not None and properties.get("protocol_version") != {"const": protocol_version}:
+            raise ReleaseFailure(f"{name} has the wrong protocol_version identity")
+
+    marker = load_json(schemas / "install-marker-v2.schema.json")
+    skill_version = marker.get("properties", {}).get("skill_schema_version", {})
+    if skill_version.get("maximum") != 6:
+        raise ReleaseFailure("install-marker-v2.schema.json does not admit manifest schema 6")
+
+    claim_v1 = load_json(schemas / "conformance-claim-v1.schema.json")
+    claim_v1_properties = claim_v1.get("properties", {})
+    if (
+        claim_v1_properties.get("schema_version") != {"const": 1}
+        or claim_v1_properties.get("protocol_version") != {"const": LEGACY_CLAIM_PROTOCOL_VERSION}
+    ):
+        raise ReleaseFailure("conformance claim v1 is not frozen at rc.3")
+    for relative, expected in CLAIM_V1_FROZEN_SHA256.items():
+        actual = sha256_identity(ROOT / relative).removeprefix("sha256:")
+        if actual != expected:
+            raise ReleaseFailure(f"historical claim v1 artifact changed: {relative}")
+
+    manifest = load_json(ROOT / "conformance" / "v1" / "manifest.json")
+    if manifest.get("protocol_version") != PROTOCOL_VERSION:
+        raise ReleaseFailure(f"conformance manifest is not {PROTOCOL_VERSION}")
+    entries = manifest.get("files")
+    if not isinstance(entries, list):
+        raise ReleaseFailure("conformance manifest files must be an array")
+    listed = [entry.get("path") for entry in entries if isinstance(entry, dict)]
+    if listed != sorted(expected_suite_inventory()):
+        raise ReleaseFailure(f"{PROTOCOL_VERSION} conformance manifest inventory is incomplete")
+
+    case_index = load_json(ROOT / "conformance" / "v1" / "schema-cases" / "index.json")
+    indexed_schemas = {
+        entry.get("schema") for entry in case_index if isinstance(entry, dict)
+    } if isinstance(case_index, list) else set()
+    if indexed_schemas != set(expected_schema_cases()):
+        raise ReleaseFailure(f"{PROTOCOL_VERSION} schema-case index is incomplete")
+
+    decision = (ROOT / "decisions" / "0004-compile-only-build-drivers.md").read_text(encoding="utf-8")
+    for required_text in ("# Decision 0004:", "Manifest schema 6", "go-v1", "## Rejected alternatives"):
+        if required_text not in decision:
+            raise ReleaseFailure(f"decision 0004 is stale: missing {required_text!r}")
+
