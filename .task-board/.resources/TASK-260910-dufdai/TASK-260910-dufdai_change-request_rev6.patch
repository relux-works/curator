+				if err := json.Unmarshal(objectBytes(t, object), &doc); err != nil {
+					t.Fatal(err)
+				}
+				delete(doc["package"].(map[string]any), field)
+				forged, err := jsonMarshal(doc)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if _, err := ParseSourceAudit(forged); err == nil ||
+					!strings.Contains(err.Error(), "source_audit") {
