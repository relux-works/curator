+func TestCoverageCandidateDispatch(t *testing.T) {
+	for _, tc := range []struct {
+		name, digest                 string
+		implemented, muse, candidate bool
+	}{
+		{"rc13", defaultSuiteManifestSHA256, false, false, false},
+		{"hash-v2", ContentHashV2CandidateManifestSHA256, true, false, true},
+		{"historical-muse", MuseCandidateManifestSHA256, false, true, true},
+		{"rc14", RC14CandidateManifestSHA256, true, true, true},
+		{"unknown", strings.Repeat("0", 64), false, false, false},
+		{"near-rc14", RC14CandidateManifestSHA256[:63] + "0", false, false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := IsImplementedContentHashV2Suite(tc.digest); got != tc.implemented {
+				t.Errorf("implemented hash-v2 = %v, want %v", got, tc.implemented)
+			}
+			if got := IsMuseCandidate(tc.digest); got != tc.muse {
+				t.Errorf("Muse = %v, want %v", got, tc.muse)
+			}
+			if got := IsContentHashV2Candidate(tc.digest); got != tc.candidate {
+				t.Errorf("hash-v2 candidate = %v, want %v", got, tc.candidate)
+			}
+		})
+	}
+}
