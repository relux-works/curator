+func TestCoverageLoadRejectsUnknownOrChangedManifest(t *testing.T) {
+	root := t.TempDir()
+	t.Setenv("CURATOR_CONFORMANCE_ROOT", root)
+	for _, content := range []string{
+		`{"protocol_version":"1.0.0-rc.14"}`,
+		`{"protocol_version":"1.0.0-rc.14","files":[]}`,
+	} {
