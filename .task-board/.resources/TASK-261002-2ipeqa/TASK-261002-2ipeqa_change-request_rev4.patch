+func TestRC14CoverageSnapshotWriteGapIsExactAndSuiteScoped(t *testing.T) {
+	root, err := repositoryRoot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ledger := filepath.Join(root, ".github", "ci", "conformance-gaps.tsv")
+	want := Gap{
+		Family: "snapshot-acquisition/cases",
+		CaseID: "byte-exact-snapshot",
+		Owner:  "TASK-261002-1foyf3",
+		Reason: "rc.14 expects curator-content-v2 writes; writer enabled at the rc.14 pin cut-over",
+	}
+	for _, digest := range []string{RC14CandidateManifestSHA256, defaultSuiteManifestSHA256, ContentHashV2CandidateManifestSHA256, MuseCandidateManifestSHA256} {
+		gaps, err := readGaps(ledger, digest)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var snapshotGaps []Gap
+		for _, gap := range gaps {
+			if gap.Family == want.Family {
+				snapshotGaps = append(snapshotGaps, gap)
+			}
+		}
+		if digest != RC14CandidateManifestSHA256 {
+			if len(snapshotGaps) != 0 {
+				t.Errorf("rc.14 snapshot-write gap leaked into earlier suite %s: %+v", digest, snapshotGaps)
+			}
+			continue
+		}
+		if !reflect.DeepEqual(snapshotGaps, []Gap{want}) {
+			t.Fatalf("rc.14 snapshot gaps = %+v, want exactly %+v", snapshotGaps, want)
+		}
+		// The production acquisition consumer uses RunOutcomes, which calls
+		// this same Check gate. Neither a passing owed case nor another failing
+		// case may hide behind the snapshot-write gap.
+		ids := []string{want.CaseID}
+		tally, err := Check(want.Family, ids, []Result{{CaseID: want.CaseID, FailureReason: "v1 writer hash differs from rc.14 v2 expectation"}}, gaps, 1)
+		if err != nil || tally != (Tally{KnownGap: 1}) {
+			t.Fatalf("snapshot gap tally = %+v, error = %v; want one known gap", tally, err)
+		}
+		if _, err := Check(want.Family, ids, []Result{{CaseID: want.CaseID}}, gaps, 1); err == nil || !strings.Contains(err.Error(), "now passes") {
+			t.Fatalf("passing snapshot gap error = %v, want stale-gap refusal", err)
+		}
+		ids = append(ids, "another-snapshot")
+		if _, err := Check(want.Family, ids, []Result{
+			{CaseID: want.CaseID, FailureReason: "v1 writer hash differs"},
+			{CaseID: "another-snapshot", FailureReason: "unexpected acquisition failure"},
+		}, gaps, 2); err == nil || !strings.Contains(err.Error(), "is not listed") {
+			t.Fatalf("unlisted snapshot failure error = %v, want exact-case refusal", err)
+		}
+	}
+}
