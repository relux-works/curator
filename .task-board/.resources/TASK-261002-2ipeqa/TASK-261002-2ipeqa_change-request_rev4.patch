+func TestRC14CoveragePolicyRetainsExactCountsAndCurrentGaps(t *testing.T) {
+	root, err := repositoryRoot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	counts, err := readCounts(filepath.Join(root, ".github", "ci", "conformance-case-counts.tsv"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// rc.14 publishes the Muse corpus; the earlier suites retain their pins.
+	for digest, wantFamilies := range map[string]int{
+		defaultSuiteManifestSHA256:           96,
+		ContentHashV2CandidateManifestSHA256: 101,
+		MuseCandidateManifestSHA256:          107,
+		RC14CandidateManifestSHA256:          107,
+	} {
+		if got := len(counts[digest]); got != wantFamilies {
+			t.Errorf("suite %s family pins = %d, want %d", digest, got, wantFamilies)
+		}
+	}
+	rc14 := counts[RC14CandidateManifestSHA256]
+	if !reflect.DeepEqual(rc14, counts[MuseCandidateManifestSHA256]) {
+		t.Fatal("rc.14 count pins differ from the unchanged Muse corpus")
+	}
+	total := 0
+	for _, count := range rc14 {
+		total += count
+	}
+	if total != 1887 {
+		t.Fatalf("rc.14 pinned case entries = %d, want 1887", total)
+	}
+	for family, want := range map[string]int{
+		"agent-environment-marker-v3/schema-cases": 29,
+		"environments-muse/cases":                  16,
+		"launch-env-fragment-v3/schema-cases":      36,
+		"content-hashes-v2/vectors":                5,
+	} {
+		if got := rc14[family]; got != want {
+			t.Errorf("%s count = %d, want %d", family, got, want)
+		}
+	}
+	ledger := filepath.Join(root, ".github", "ci", "conformance-gaps.tsv")
+	gaps, err := readGaps(ledger, RC14CandidateManifestSHA256)
+	if err != nil {
+		t.Fatal(err)
+	}
+	currentGaps, err := readGaps(ledger, ContentHashV2CandidateManifestSHA256)
+	if err != nil {
+		t.Fatal(err)
+	}
+	legacyGaps, err := readGaps(ledger, defaultSuiteManifestSHA256)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(gaps) != 10 {
+		t.Fatalf("rc.14 gap rows = %d, want nine posture/provisioning gaps and one snapshot-write gap", len(gaps))
+	}
+	var postureGaps []Gap
+	for _, gap := range gaps {
+		if isMuseCandidateHistoricalGap(gap) {
+			t.Errorf("historical hash-v2 gap leaked into rc.14: %+v", gap)
+		}
+		if gap.Family == "snapshot-acquisition/cases" {
+			continue // Exact case, owner and reason are asserted separately below.
+		}
+		if !strings.HasPrefix(gap.Family, "environments-codex-seed/") {
+			t.Errorf("non-posture/provisioning gap leaked into rc.14: %+v", gap)
+		}
+		postureGaps = append(postureGaps, gap)
+	}
+	if len(postureGaps) != 9 || !reflect.DeepEqual(postureGaps, currentGaps) || !reflect.DeepEqual(postureGaps, legacyGaps) {
+		t.Fatalf("rc.14 posture/provisioning gaps = %+v, want the nine current rc.13/hash-v2 gaps", postureGaps)
+	}
+}
