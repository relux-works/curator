+func TestCoverageLifecycleCountPinsCoverPublishedInstallCases(t *testing.T) {
+	counts, _, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// These four families are consumed by the production ProjectInstall
+	// entry tests in internal/install/external_lifecycle_conformance_test.go.
+	// Derive their cardinalities from the selected corpus rather than the pins.
+	root := os.Getenv("CURATOR_CONFORMANCE_ROOT")
+	if root == "" {
+		t.Skip("CURATOR_CONFORMANCE_ROOT is not set")
+	}
+	data, err := os.ReadFile(filepath.Join(root, "vectors", "external-repository-lifecycle.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var document map[string]json.RawMessage
+	if err := json.Unmarshal(data, &document); err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range []string{"mixed_build_cases", "path_shim_cases", "signing_cases", "transaction_cases"} {
+		var cases []json.RawMessage
+		if err := json.Unmarshal(document[key], &cases); err != nil {
+			t.Fatalf("decode published %s: %v", key, err)
+		}
+		family := "external-repository-lifecycle/" + key
+		if got, ok := counts[family]; !ok || got != len(cases) {
+			t.Errorf("%s count pin = %d (present=%v), corpus publishes %d", family, got, ok, len(cases))
+		}
+	}
+}
