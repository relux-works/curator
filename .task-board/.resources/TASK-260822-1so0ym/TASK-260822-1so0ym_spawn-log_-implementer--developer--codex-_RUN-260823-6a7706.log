+			"fails_before":              failsBefore,
+			"persistent_state_changed":  false,
+		}
+	}
+
+	writeJSON(filepath.Join(dir, "module-roots.json"), map[string]any{
+		"schema_version":   1,
+		"protocol_version": protocolVersion,
