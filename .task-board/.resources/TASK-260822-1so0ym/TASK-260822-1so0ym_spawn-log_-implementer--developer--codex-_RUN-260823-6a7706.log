+				[]string{"pkg/board"}, []string{"tools/cli"}, []string{"scripts"},
+				[]string{"pkg/board", "scripts", "tools/cli", "tools/cli/vendor"},
+				[]string{"pkg/board/go.mod", "tools/cli/go.mod"},
