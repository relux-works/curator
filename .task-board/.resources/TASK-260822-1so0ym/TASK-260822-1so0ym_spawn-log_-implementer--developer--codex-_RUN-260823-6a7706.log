+				[]string{"pkg/board"}, []string{"tools/cli"}, []string{"pkg"},
+				[]string{"pkg", "pkg/board", "tools/cli", "tools/cli/vendor"},
+				[]string{"pkg/board/go.mod", "tools/cli/go.mod"}, []string{},
+				"build_module_root_containment_invalid", "go-list",
+			),
+			caseFor(
