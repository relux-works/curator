+		t.Fatalf("positive module-root declaration = %#v, want %#v", got, want)
+	}
+	if got := positive["vendor_module_annotations"].([]any); len(got) != 4 {
+		t.Fatalf("positive module-root annotations = %#v, want directive and selection pairs", got)
+	}
