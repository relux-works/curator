   867	type treeFixtureEntry struct {
   868		mode     string
   869		name     string
   870		objectID string
   871	}
   872	
   873	func rawObjectCase(name, objectType, objectFormat string, content []byte, outcome string) map[string]any {
   874		result := map[string]any{
   875			"name": name, "object_type": objectType, "object_format": objectFormat,
   876			"content_base64": base64.StdEncoding.EncodeToString(content),
   877			"object_id":      gitObjectID(objectFormat, objectType, content),
   878		}
   879		if outcome == "valid" {
   880			result["expected"] = "valid"
   881		} else {
   882			result["expected_error"] = outcome
   883		}
   884		return result
   885	}
   886	
   887	func treeObjectCase(name, objectFormat string, entries []treeFixtureEntry, outcome string) map[string]any {
   888		var content bytes.Buffer
   889		for _, entry := range entries {
   890			content.WriteString(entry.mode)
   891			content.WriteByte(' ')
   892			content.WriteString(entry.name)
   893			content.WriteByte(0)
   894			objectID, err := hex.DecodeString(entry.objectID)
   895			must(err)
   896			content.Write(objectID)
   897		}
   898		return rawObjectCase(name, "tree", objectFormat, content.Bytes(), outcome)
   899	}
   900	
   901	func gitObjectID(objectFormat, objectType string, content []byte) string {
   902		header := []byte(objectType + " " + strconv.Itoa(len(content)) + "\x00")
   903		payload := append(header, content...)
   904		if objectFormat == "sha1" {
   905			sum := sha1.Sum(payload)
   906			return hex.EncodeToString(sum[:])
   907		}
   908		sum := sha256.Sum256(payload)
   909		return hex.EncodeToString(sum[:])
   910	}

