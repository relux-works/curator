+func validInstallMarkerV3(markerV1 map[string]any) map[string]any {
+	marker := cloneMap(markerV1)
+	marker["schema_version"] = 3
+	marker["skill_schema_version"] = 7
+	marker["runtime_roots"] = []any{}
+	marker["build_roots"] = []any{"build"}
