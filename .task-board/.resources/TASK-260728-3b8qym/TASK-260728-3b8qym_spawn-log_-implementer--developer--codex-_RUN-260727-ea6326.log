+	familyCase := packCases["reject-pack-hash-family-mismatch"]
+	familyBase := packCases[familyCase["base_case"].(string)]
+	familyMutation := familyCase["mutation"].(map[string]any)
+	if familyMutation["target"] != "repository_object_format" ||
