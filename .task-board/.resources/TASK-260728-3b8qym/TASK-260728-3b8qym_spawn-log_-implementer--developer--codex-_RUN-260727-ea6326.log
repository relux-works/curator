+def materialize_pack_mutation(
+    base: dict[str, Any],
+    mutation: dict[str, Any],
+) -> tuple[bytes, bytes]:
+    pack = bytearray(decode_hex(base.get("pack_hex"), "base pack"))
+    index = bytearray(decode_hex(base.get("index_hex"), "base index"))
