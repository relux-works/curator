+func TestManifestV6CommandUnionIsSeparateAndStrict(t *testing.T) {
+	root := repositoryRoot(t)
+	common := readObject(t, filepath.Join(root, "schemas", "v1", "common.schema.json"))
+	defs := common["$defs"].(map[string]any)
