+        raise ValidationFailure(f"{label} has unsupported object format")
+    pack = decode_hex(case.get("pack_hex"), f"{label} pack")
+    index = decode_hex(case.get("index_hex"), f"{label} index")
+    if len(pack) != 12 + width:
