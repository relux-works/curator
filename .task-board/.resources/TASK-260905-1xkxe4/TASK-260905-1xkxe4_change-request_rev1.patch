+func TestExcludedRangeFormsAreRejected(t *testing.T) {
+	for _, text := range []string{"1.2.3 - 2.3.4", "v1.2.3", "^v1", ">=v1.0.0", "", "||", "^1 ||", "1.2.3.4", "^01.2", ">>1", "1.2.3-", "latest || ^1", "1.2.3+build"} {
