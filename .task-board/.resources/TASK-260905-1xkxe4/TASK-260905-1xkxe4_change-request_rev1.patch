+    for module in manifest.get("context", {}).get("modules", []):
+        if module.get("class") != "system":
+            continue
+        warnings.append({"class": "context-system-module-present", "package": manifest["name"], "path": module["path"], "selector": module.get("environments")})
+    return warnings
