+        case["comparator_sets"] = [[">=1.2.3", "<2.0.0"]]
+        with self.assertRaises(validate.ValidationFailure):
+            validate.validate_context_version_vectors(changed)
+
+    def test_excluded_form_cannot_be_declared_valid(self) -> None:
