+package yarnmodernsource
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+)
+
+// Nested sealed fixture trees are owner-writable before removal, preserving executability and external symlink targets.
+func TestWritableTempDirRestoresNestedTrees(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("POSIX permission fixture is exercised on Linux and macOS")
+	}
+	outside := filepath.Join(t.TempDir(), "outside")
+	if err := os.WriteFile(outside, []byte("outside"), 0o400); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chmod(outside, 0o600) })
+	t.Run("sealed", func(t *testing.T) {
+		_ = t.TempDir() // Register TempDir removal before the audit.
+		var root string
+		t.Cleanup(func() {
+			for _, path := range []string{root, filepath.Join(root, "nested"), filepath.Join(root, "nested", "executable")} {
+				info, err := os.Stat(path)
+				if err != nil || info.Mode().Perm()&0o200 == 0 {
+					t.Errorf("tree not restored: %s: %v", path, err)
+				}
+			}
+			info, err := os.Stat(filepath.Join(root, "nested", "executable"))
+			if err != nil || info.Mode().Perm()&0o100 == 0 {
+				t.Error("executable bit lost")
+			}
+		})
+		root = writableTempDir(t)
+		dir := filepath.Join(root, "nested")
+		if err := os.Mkdir(dir, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "executable"), []byte("x"), 0o500); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Symlink(outside, filepath.Join(dir, "link")); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chmod(dir, 0o500); err != nil {
+			t.Fatal(err)
+		}
+	})
+	if info, err := os.Stat(outside); err != nil || info.Mode().Perm()&0o200 != 0 {
+		t.Errorf("outside target changed: %v", err)
+	}
+}
diff --git a/scripts/restore-runner-tmp.sh b/scripts/restore-runner-tmp.sh
new file mode 100644
index 0000000000000000000000000000000000000000..d60e6f7cfc42e6719ab2846dba0bd3a4ddd67e4c
--- /dev/null
+++ b/scripts/restore-runner-tmp.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+# The Linux runner's job-completed hook removes TMPDIR, not RUNNER_TEMP.
+# Restore permissions only; leave removal to the runner owner.
+set -u
+root=${TMPDIR-}
+if [[ -z "$root" || ! -d "$root" || -L "$root" ]]; then
+  echo 'runner tmp restore: refusing unset, empty, non-directory or symlink TMPDIR'
+  exit 0
+fi
+# Resolve aliases such as /tmp/.. before checking for the filesystem root.
+# A sentinel preserves pathname newlines that command substitution would strip.
+root=$(cd -- "$root" && pwd -P && printf '.') || { echo 'runner tmp restore: cannot resolve TMPDIR'; exit 0; }
+root=${root%$'\n.'}
+if [[ "$root" == / || "$root" -ef / ]]; then
+  echo 'runner tmp restore: refusing filesystem root TMPDIR'
+  exit 0
+fi
+# GNU chmod does not traverse symlinks encountered recursively. No -L and no
+# trailing slash on the resolved root: targets outside TMPDIR stay untouched.
+echo "runner tmp restore: runner=${RUNNER_NAME:-unknown}; restoring owner write permission"
+chmod -R u+w -- "$root" || echo 'runner tmp restore: chmod could not restore every entry'
+exit 0
