+        skills_root,
+        "provider",
+        command_name="provider-tool",
+    )
+    _make_context_consumer(
+        skills_root,
+        "consumer",
+        provider_name="provider",
+        provider_repo=provider,
+    )
+    _write_global_skillfile(
+        csk_home,
+        {
+            "schema_version": 1,
+            "agents": ["codex_cli"],
