+    provider_two = _make_context_provider(
+        skills_root,
+        "provider-two",
+        command_name="tool",
+    )
+    _make_context_consumer(
+        skills_root,
+        "consumer-one",
+        provider_name="provider-one",
+        provider_repo=provider_one,
