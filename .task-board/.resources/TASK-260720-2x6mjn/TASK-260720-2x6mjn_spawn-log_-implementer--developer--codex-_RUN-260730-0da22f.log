+                {"name": "skill-plain", "tag": "v1"},
+            ],
+        },
+    )
+    no_go_bin = tmp_path / "no-go-bin"
+    no_go_bin.mkdir()
+    for tool in ("git", "sh", "env", "uname"):
+        executable = shutil.which(tool)
