+    result = global_install.install(cfg)
+
+    assert not result.errors
+    assert result.builds == []
+    skills = csk_home / "global" / "skills"
+    assert sorted(path.name for path in skills.iterdir()) == [
+        "skill-build",
+        "skill-plain",
+    ]
+
