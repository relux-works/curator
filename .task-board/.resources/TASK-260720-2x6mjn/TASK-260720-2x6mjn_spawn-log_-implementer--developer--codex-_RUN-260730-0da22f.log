+                            "driver": "go-v1",
+                            "source_dir": "build/cmd/tool",
+                        }
+                    },
+                    "capabilities": {},
+                }
+            ),
+            "build/go.mod": "module example.com/tool\n\ngo 1.23\n",
+            "build/cmd/tool/main.go": "package main\n\nfunc main() {}\n",
+        },
+        tag="v1",
+    )
+    make_skill_repo(
+        skills_root,
+        "skill-plain",
+        {"csk-skill.json": json.dumps({"schema_version": 2})},
+        tag="v1",
