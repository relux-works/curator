+		var probe struct {
+			If struct {
+				Properties struct {
+					Package struct {
+						Properties struct {
+							Kind struct {
+								Const string `json:"const"`
+							} `json:"kind"`
+						} `json:"properties"`
+					} `json:"package"`
+				} `json:"properties"`
+			} `json:"if"`
+			Then struct {
+				Not struct {
+					AnyOf []struct {
+						Required []string `json:"required"`
+					} `json:"anyOf"`
+				} `json:"not"`
+			} `json:"then"`
+		}
+		if err := json.Unmarshal(encoded, &probe); err != nil {
+			continue
+		}
+		if probe.If.Properties.Package.Properties.Kind.Const != "local-snapshot" {
+			continue
+		}
