@@ -0,0 +1,526 @@
+package envprofile
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/relux-works/curator/internal/contextlock"
