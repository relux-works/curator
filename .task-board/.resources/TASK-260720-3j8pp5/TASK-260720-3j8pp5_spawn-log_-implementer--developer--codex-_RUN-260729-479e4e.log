    28	class RecordingRunner:
    29	    def __init__(
    30	        self,
    31	        goroot: Path,
    32	        *,
    33	        version: str | None = None,
    34	        environment_overrides: dict[str, str] | None = None,
    35	    ):
    36	        self.goroot = goroot
    37	        self.host = toolchain._native_host()
    38	        self.version = version or (
    39	            f"go version go1.25.5 {self.host.goos}/{self.host.goarch}\n"
    40	        )
    41	        self.environment_overrides = environment_overrides or {}
    42	        self.calls: list[tuple[tuple[str, ...], Path, dict[str, str]]] = []
    43	        self.operation_roots: list[Path] = []
    44	        self.env_payload: bytes | None = None
    45	        self.returncodes: dict[tuple[str, ...], int] = {}
    46	        self.poison_working_directory = False
    47	
    48	    def run(
    49	        self,
    50	        argv: tuple[str, ...],
    51	        *,
    52	        cwd: Path,
    53	        environment: dict[str, str],
    54	        timeout: float,
    55	        output_limit: int,
    56	    ) -> toolchain.ProbeResult:
    57	        del timeout, output_limit
    58	        copied_environment = dict(environment)
    59	        self.calls.append((argv, cwd, copied_environment))
    60	        self.operation_roots.append(cwd.parent)
    61	        arguments = argv[1:]
    62	        returncode = self.returncodes.get(arguments, 0)
    63	        if arguments == ("telemetry", "off"):
    64	            _telemetry_dir(copied_environment, self.host).mkdir(
    65	                parents=True,
    66	                exist_ok=True,
    67	            )
    68	            return toolchain.ProbeResult(returncode=returncode)
    69	        if arguments == ("version",):
    70	            if self.poison_working_directory:
    71	                (cwd / "package-controlled").write_text("poison", encoding="utf-8")
    72	            return toolchain.ProbeResult(
    73	                stdout=self.version.encode("utf-8"),
    74	                returncode=returncode,
    75	            )
    76	        if arguments == ("env", "-json", *toolchain.GO_ENV_FIELDS):
    77	            payload = self.env_payload
    78	            if payload is None:
    79	                values = _probe_environment(
    80	                    self.goroot,
    81	                    copied_environment,
    82	                    self.host,
    83	                )
    84	                values.update(self.environment_overrides)
    85	                payload = json.dumps(values, separators=(",", ":")).encode("utf-8")
    86	            return toolchain.ProbeResult(stdout=payload, returncode=returncode)
    87	        raise AssertionError(f"unexpected Go probe argv: {argv!r}")
    88	
    89	
    90	def _telemetry_dir(environment: dict[str, str], host: toolchain._Host) -> Path:
    91	    if host.windows:
    92	        config = Path(environment["APPDATA"])
    93	    elif host.goos == "darwin":
    94	        config = Path(environment["HOME"]) / "Library" / "Application Support"
    95	    else:
    96	        config = Path(environment["XDG_CONFIG_HOME"])
    97	    return config / "go" / "telemetry"
    98	
    99	
   100	def _probe_environment(
   101	    goroot: Path,
   102	    bootstrap: dict[str, str],
   103	    host: toolchain._Host,
   104	) -> dict[str, str]:
   105	    values = {name: "" for name in toolchain.GO_ENV_FIELDS}
   106	    values.update(_TUNING_VALUES)
   107	    values.update(
   108	        {
   109	            "GOROOT": str(goroot),
   110	            "GOHOSTOS": host.goos,
   111	            "GOHOSTARCH": host.goarch,
   112	            "GOOS": host.goos,
   113	            "GOARCH": host.goarch,
   114	            "GOTELEMETRY": "off",
   115	            "GOTELEMETRYDIR": str(_telemetry_dir(bootstrap, host)),
   116	        }
   117	    )
   118	    return values
   119	
   120	
   121	def _native_header(host: toolchain._Host) -> bytes:
   122	    if host.windows:
   123	        return b"MZ\x90\x00"
   124	    if host.goos == "darwin":
   125	        return b"\xcf\xfa\xed\xfe"
   126	    return b"\x7fELF"
   127	
   128	
   129	def _make_goroot(path: Path) -> Path:
   130	    host = toolchain._native_host()
   131	    executable = path / "bin" / ("go.exe" if host.windows else "go")
   132	    executable.parent.mkdir(parents=True)
   133	    executable.write_bytes(_native_header(host) + b"fake-go")
   134	    executable.chmod(0o755)
   135	    (path / "VERSION").write_text("go1.25.5\n", encoding="utf-8")
   136	    return path
   137	
