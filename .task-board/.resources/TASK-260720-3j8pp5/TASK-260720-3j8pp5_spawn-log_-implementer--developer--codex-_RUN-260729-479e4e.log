+                "operation-private platform configuration path was replaced",
+            )
+    if (
+        not boundary.anchors
+        or boundary.anchors[0].path != boundary.operation_root
+        or boundary.anchors[-1].path != boundary.config_root
+    ):
+        raise ToolchainError(
