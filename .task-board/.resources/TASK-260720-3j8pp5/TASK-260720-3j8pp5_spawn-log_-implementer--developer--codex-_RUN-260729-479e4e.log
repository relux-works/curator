   139	def _setup(
   140	    tmp_path: Path,
   141	    *,
   142	    version: str | None = None,
   143	    environment_overrides: dict[str, str] | None = None,
   144	) -> tuple[toolchain.ToolchainConfig, RecordingRunner, Path, Path]:
   145	    goroot = _make_goroot(tmp_path / "trusted-go")
   146	    forbidden = tmp_path / "repository"
   147	    forbidden.mkdir()
   148	    private_base = tmp_path / "private"
   149	    private_base.mkdir()
   150	    runner = RecordingRunner(
   151	        goroot,
   152	        version=version,
   153	        environment_overrides=environment_overrides,
   154	    )
   155	    config = toolchain.ToolchainConfig(
   156	        private_base=private_base,
   157	        operator_search_path=toolchain.OperatorSearchPath((str(goroot / "bin"),)),
   158	        forbidden_roots=(forbidden,),
   159	        runner=runner,
   160	    )
   161	    return config, runner, goroot, private_base
   162	
