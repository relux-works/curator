   168	def test_establish_uses_only_exact_bootstrap_argv_and_clean_environment(
   169	    tmp_path: Path,
   170	    monkeypatch: pytest.MonkeyPatch,
   171	):
   172	    config, runner, goroot, _ = _setup(tmp_path)
   173	    monkeypatch.setenv("GOROOT", "/attacker/goroot")
   174	    monkeypatch.setenv("GOFLAGS", "-tags=attacker")
   175	    monkeypatch.setenv("CC", "/attacker/cc")
   176	    monkeypatch.setenv("GOTOOLCHAIN", "auto")
   177	
   178	    session = toolchain.establish_toolchain(config)
   179	    operation_root = session.operation_root
   180	    executable = str((goroot / "bin" / ("go.exe" if os.name == "nt" else "go")).resolve())
   181	
   182	    assert [call[0] for call in runner.calls] == [
   183	        (executable, "telemetry", "off"),
   184	        (executable, "version"),
   185	        (executable, "env", "-json", *toolchain.GO_ENV_FIELDS),
   186	    ]
   187	    assert len({call[1] for call in runner.calls}) == 1
   188	    probe_cwd = runner.calls[0][1]
   189	    assert probe_cwd == operation_root / "empty"
   190	    assert not probe_cwd.samefile(goroot)
   191	    for _, _, environment in runner.calls:
   192	        assert "GOROOT" not in environment
   193	        assert "GOOS" not in environment
   194	        assert "GOARCH" not in environment
   195	        assert "GOFLAGS" not in environment
   196	        assert "CC" not in environment
   197	        assert environment["GOTOOLCHAIN"] == "local"
   198	        assert environment["GOENV"] == "off"
   199	        assert environment["PATH"] == str(operation_root / "empty-path")
   200	        assert environment["LC_ALL"] == "C"
   201	        assert environment["LANG"] == "C"
   202	        for key in (
   203	            "GOPATH",
   204	            "GOMODCACHE",
   205	            "GOCACHE",
   206	            "GOTMPDIR",
   207	            "HOME",
   208	            "XDG_CONFIG_HOME",
   209	            "TMPDIR",
   210	        ):
   211	            assert Path(environment[key]).is_relative_to(operation_root)
   212	
   213	    applicable = toolchain.TUNING_VARIABLES[session.target.goarch]
   214	    assert dict(session.target.tuning) == {applicable: _TUNING_VALUES[applicable]}
   215	    frozen = session.environment
   216	    assert frozen["GOROOT"] == str(goroot.resolve())
   217	    assert frozen["GOOS"] == session.target.goos
   218	    assert frozen["GOARCH"] == session.target.goarch
   219	    assert {key for key in toolchain.TUNING_VARIABLES.values() if key in frozen} == {
   220	        applicable
   221	    }
   222	    assert frozen["GOFLAGS"] == ""
   223	    assert frozen["GOPROXY"] == "off"
   224	    assert frozen["GOTOOLCHAIN"] == "local"
   225	    assert frozen["CGO_ENABLED"] == "0"
   226	
   227	    session.close()
   228	    assert not operation_root.exists()
