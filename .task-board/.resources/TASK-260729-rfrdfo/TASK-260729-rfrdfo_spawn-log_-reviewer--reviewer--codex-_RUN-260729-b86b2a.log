#!/bin/zsh
# usage: manifest.sh <tree-root> <output-file>
# Path-sorted SHA-256 manifest of every regular file under <tree-root>,
# excluding the .git administrative directory. Paths are relative ("./x").
set -o pipefail
TREE=$1
OUT=$2
cd "$TREE" || exit 3
find . -type f -not -path './.git/*' -print0 \
  | LC_ALL=C sort -z \
  | xargs -0 shasum -a 256 > "$OUT"
exit $?
#!/bin/bash
# TASK-260729-rfrdfo focused gate driver for the prototype worktree.
#
# Evidence protocol (inherited from the accepted TASK-260720-2284br driver):
#   * every gate is a standalone process: no tee, no pipe chain, no subshell
#     that could swallow the status
#   * the real exit code is written to <name>.exit as the LAST action, so a
#     missing .exit means "killed or still running", never "passed"
#   * <name>.seconds records wall clock, <name>.log records combined output
#   * gates run strictly one at a time, each behind a two-scan process barrier,
#     because focused timings are the whole point of this task
#   * DRIVER-DONE only appears if the driver reached the end
#
# No -timeout token, no ./..., no coverage, no host install, no git command.

ROOT=/Users/iv/Developer/ReluxWorks/curator/.temp/TASK-260729-rfrdfo
WT=$ROOT/worktree
G=$ROOT/gates
CONFORMANCE=/Users/iv/Developer/ReluxWorks/curator/.temp/TASK-260729-3nx97g/worktree/conformance/v1

mkdir -p "$G" || exit 99
