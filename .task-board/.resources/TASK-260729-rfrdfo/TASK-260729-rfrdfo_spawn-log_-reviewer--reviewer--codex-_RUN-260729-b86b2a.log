for p in touched_forbidden:
    print("FORBIDDEN", p)
for p in missing:
    print("ALLOWLISTED_BUT_UNMODIFIED", p)
ok = not unexpected and not touched_forbidden and not missing
print("INTEGRITY_OK" if ok else "INTEGRITY_FAIL")
sys.exit(0 if ok else 1)
