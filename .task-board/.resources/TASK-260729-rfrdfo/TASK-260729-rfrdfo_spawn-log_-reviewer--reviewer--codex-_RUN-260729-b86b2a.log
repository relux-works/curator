#!/usr/bin/env python3
"""Patch A: mark the 88 approved internal/install tests t.Parallel().

Inserts `t.Parallel()` as the first statement of every top-level test that is
not on the derived sequential exclusion list. Only the 11 allowlisted files are
opened; aba_test.go is not among them and is never touched.
"""
import re
import sys

PKG = sys.argv[1]

ALLOWED_FILES = [
    "cache_conformance_test.go",
    "commit_test.go",
    "diagnostics_test.go",
    "dryrun_conformance_test.go",
    "generation_test.go",
    "install_test.go",
    "maintenance_test.go",
    "private_test.go",
    "registry_e2e_test.go",
    "revalidation_test.go",
    "stage_test.go",
]

SEQUENTIAL = {
    # t.Setenv: the variable is process-global and Go panics if it is called
    # after t.Parallel.
    "TestBuildRootExcludedBeforeLocaleRenderingWithoutCompilerExecution",
    "TestRuntimeLauncherCapturesDeclaredSystemDependency",
    "TestGlobalInstall",
    "TestDefaultToolchainProbeRemovesItsProbeRootOnFailure",
    "TestDefaultToolchainProbeRemovesItsProbeRootOnSuccess",
    "TestDefaultToolchainEstablishRemovesItsPrivateRootOnFailure",
    "TestProjectDryRunKeepsEveryEphemeralPathInOneOperationPrivateRoot",
    "TestGlobalDryRunKeepsEveryEphemeralPathInOneOperationPrivateRoot",
    "TestDryRunRemovesItsOperationPrivateRootOnFailure",
    "TestGlobalDryRunRemovesItsOperationPrivateRootOnFailure",
    "TestRealRunKeepsEveryEphemeralPathInOneOperationPrivateRoot",
    # afterDocumentOpen: an unsynchronised production package-level hook.
    "TestProjectManifestABAAroundTheReadRestartsClosure",
    "TestGlobalManifestABAAroundTheReadRestartsClosure",
    "TestSubstitutionsABAAroundTheReadRestartsClosure",
    "TestHybridActivationABAAroundTheReadRestartsClosure",
    "TestByteIdenticalRewriteDuringTheReadDoesNotRestart",
    "TestReadDocumentBindsGenerationToBytesRewrittenInPlace",
    "TestReadDocumentBindsGenerationToBytesReplacedByRename",
    # The child half of the concurrency assertion, re-executed as its own
    # process with -test.run anchored on this name.
    "TestInstallHelperProcess",
}

HEADER = re.compile(r"^func (Test[A-Za-z0-9_]*)\(t \*testing\.T\) \{$")

marked = []
for name in ALLOWED_FILES:
    path = "%s/%s" % (PKG, name)
    lines = open(path, encoding="utf-8").read().split("\n")
    out = []
    for line in lines:
        out.append(line)
        match = HEADER.match(line)
        if match and match.group(1) not in SEQUENTIAL:
            out.append("\tt.Parallel()")
            marked.append(match.group(1))
    open(path, "w", encoding="utf-8").write("\n".join(out))

print("marked=%d" % len(marked))
if len(marked) != 88:
    sys.exit("expected 88 marked tests, got %d" % len(marked))
#!/usr/bin/env python3
"""Derive the sequential-test exclusion set for internal/install from source.

The diagnosis names 19 tests that must stay sequential. This script derives the
set independently instead of trusting the list: it finds every helper that
touches process-global state (t.Setenv, the afterDocumentOpen production hook,
re-execution of the test binary) and then closes over the call graph inside the
package's test files, so a test that reaches a hazard only through a helper is
caught too.
"""
import os
import re
import sys

PKG = sys.argv[1]

FUNC = re.compile(r"^func (?:\([^)]*\) )?([A-Za-z_][A-Za-z0-9_]*)\s*\(")
HAZARDS = (
    ("t.Setenv", re.compile(r"\bt\.Setenv\(")),
    ("os.Setenv", re.compile(r"\bos\.Setenv\(")),
    ("os.Chdir", re.compile(r"\bos\.Chdir\(")),
    ("afterDocumentOpen", re.compile(r"\bafterDocumentOpen\s*=")),
)

# A test re-executed as a child process is named in a -test.run anchor. The
# hazard belongs to the NAMED test, not to the caller: reading os.Args[0] and
# spawning a process mutates nothing in the caller's own process, while the
# named test is the one whose meaning depends on being the binary's only test.
REEXEC = re.compile(r"-test\.run=\^([A-Za-z_][A-Za-z0-9_]*)\$")


def parse(path):
    """Return {func name: (list of body lines)} for one file."""
    bodies, name, buf = {}, None, []
    for line in open(path, encoding="utf-8"):
        match = FUNC.match(line)
        if match:
            if name:
                bodies[name] = buf
            name, buf = match.group(1), []
        elif name:
            buf.append(line)
    if name:
        bodies[name] = buf
    return bodies


bodies = {}
for entry in sorted(os.listdir(PKG)):
    if entry.endswith("_test.go"):
        for key, value in parse(os.path.join(PKG, entry)).items():
            bodies.setdefault(key, []).extend(value)

direct = {}
for name, body in bodies.items():
    hits = sorted({label for label, pattern in HAZARDS
                   if any(pattern.search(line) for line in body)})
    if hits:
        direct[name] = hits

for body in bodies.values():
    for match in REEXEC.finditer("".join(body)):
        direct.setdefault(match.group(1), []).append("re-executed as a child process")

# Close the hazard set over intra-package calls until it stops growing.
tainted = dict(direct)
changed = True
while changed:
    changed = False
    for name, body in bodies.items():
        if name in tainted:
            continue
        text = "".join(body)
        for callee in tainted:
            if callee != name and re.search(r"\b%s\(" % re.escape(callee), text):
                tainted[name] = ["via " + callee]
                changed = True
                break

tests = sorted(n for n in bodies if n.startswith("Test"))
sequential = sorted(n for n in tests if n in tainted)
parallel = sorted(n for n in tests if n not in tainted)

print("tests=%d sequential=%d parallel=%d" % (len(tests), len(sequential), len(parallel)))
print("--- sequential (must NOT get t.Parallel) ---")
for name in sequential:
    print("  %-70s %s" % (name, ",".join(tainted[name])))
