#!/bin/bash
# Emit the focused-gate results table from the driver's per-gate artifacts.
# A gate with no .exit file is reported as NOT-RUN, never as passing.
G=/Users/iv/Developer/ReluxWorks/curator/.temp/TASK-260729-rfrdfo/gates
printf '| gate | real exit | wall s | package line |\n'
printf '| --- | ---: | ---: | --- |\n'
for name in gate-gofmt gate-vet gate-atomicity-structure \
            gate-race-atomicity-1 gate-race-atomicity-2 gate-race-atomicity-3 \
            gate-race-install-1 gate-race-install-2 gate-race-install-3 \
            gate-race-r5 gate-race-revalidation gate-race-concurrency gate-race-activation; do
  if [ ! -e "$G/$name.exit" ]; then
    printf '| `%s` | NOT-RUN | — | — |\n' "$name"
    continue
  fi
  code=$(cat "$G/$name.exit")
  secs=$(cat "$G/$name.seconds" 2>/dev/null)
  line=$(grep -E '^(ok|FAIL|---)' "$G/$name.log" 2>/dev/null | head -1)
  [ -z "$line" ] && line='(no output)'
  printf '| `%s` | %s | %s | `%s` |\n' "$name" "$code" "$secs" "$line"
done
echo
echo "data race markers across every gate log:"
grep -l 'DATA RACE' "$G"/*.log 2>/dev/null || echo "  none"

