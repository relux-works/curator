+				". $env:HOOK\n" +
+				"if ($env:HOSTILE_MARKER) { Write-Output (\"marker1=\" + $env:HOSTILE_MARKER) } else { Write-Output \"marker1=no\" }\n" +
+				"[Console]::Error.WriteLine(\"PROBE-1\")\n" +
