+			command := exec.CommandContext(ctx, powerShell, "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", scriptPath)
+			command.Env = append(os.Environ(),
+				"PROJ="+project, "HOOK="+hookPath, "HOSTILE_CANARY="+canary,
