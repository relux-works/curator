+            "$ref": "common.schema.json#/$defs/nonEmptyString"
+          },
+          "sig": {
+            "$ref": "common.schema.json#/$defs/signature"
+          }
+        },
+        "additionalProperties": false
+      }
+    },
+    "sig": {
+      "$ref": "common.schema.json#/$defs/signature"
+    },
+    "hash_version": {
+      "const": 2
+    }
+  },
+  "additionalProperties": false
+}
