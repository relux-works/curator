+		payload := files[path]
+		_, _ = digest.Write([]byte{'F'})
+		binary.BigEndian.PutUint64(length[:], uint64(len(pathBytes)))
+		_, _ = digest.Write(length[:])
+		_, _ = digest.Write(pathBytes)
+		binary.BigEndian.PutUint64(length[:], uint64(len(payload)))
+		_, _ = digest.Write(length[:])
