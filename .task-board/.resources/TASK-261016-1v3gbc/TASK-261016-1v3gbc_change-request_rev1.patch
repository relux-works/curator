+              "properties": {"type": {"const": "local-path"}},
+              "additionalProperties": false
+            },
+            {
+              "type": "object",
+              "required": ["type", "ref"],
+              "properties": {
+                "type": {"const": "network-git"},
+                "ref": {"$ref": "#/$defs/repositoryStructuredRef"}
