+    "descriptor",
+    "environment",
+    "profile",
+    "precedence",
+    "env",
+    "permissions"
+  ],
+  "properties": {
+    "environment": {
+      "enum": [
+        "claude_code",
+        "codex_cli",
+        "opencode",
+        "pi",
+        "muse"
+      ]
+    },
+    "profile": {
+      "type": "object",
+      "required": [
+        "name",
+        "lock_sha256"
+      ],
+      "properties": {
+        "name": {
+          "$ref": "../v1/common.schema.json#/$defs/identifier"
+        },
+        "lock_sha256": {
+          "$ref": "../v1/common.schema.json#/$defs/hex256"
+        }
+      },
+      "additionalProperties": false
+    },
+    "precedence": {
+      "$ref": "../v1/agent-environment-marker-v1.schema.json#/$defs/precedence"
+    },
+    "env": {
+      "type": "object"
+    },
+    "system_prompt": {
+      "type": "object",
+      "required": [
+        "path",
+        "channels"
+      ],
+      "properties": {
+        "path": {
+          "$ref": "#/$defs/snapshotFilePath"
+        },
+        "channels": {
+          "type": "array",
+          "items": {
+            "$ref": "#/$defs/systemPromptDescriptor"
+          }
+        }
+      },
+      "additionalProperties": false
+    },
+    "mcp": {
+      "type": "object",
+      "required": [
+        "path",
+        "env_names",
+        "channels"
+      ],
+      "properties": {
+        "path": {
+          "$ref": "#/$defs/snapshotFilePath"
+        },
+        "env_names": {
+          "$ref": "../v1/agent-mcp-v1.schema.json#/$defs/envNames"
+        },
+        "channels": {
+          "type": "array",
+          "minItems": 1,
+          "maxItems": 1,
+          "items": {
+            "$ref": "#/$defs/mcpDescriptor"
+          }
+        }
+      },
+      "additionalProperties": false
+    },
+    "permissions": {
+      "type": "object",
+      "required": [
+        "mode",
+        "locked",
+        "source"
+      ],
+      "properties": {
+        "mode": {
+          "enum": [
+            "native",
+            "yolo"
+          ]
+        },
+        "locked": {
+          "type": "boolean"
+        },
+        "source": {
+          "enum": [
+            "profile",
+            "global",
+            "default"
+          ]
+        }
+      },
+      "additionalProperties": false,
+      "allOf": [
+        {
+          "if": {
+            "properties": {
+              "locked": {
+                "const": true
+              }
+            }
+          },
+          "then": {
+            "properties": {
+              "source": {
+                "const": "global"
+              }
+            }
+          }
+        },
+        {
+          "if": {
+            "properties": {
+              "source": {
+                "const": "global"
+              }
+            }
+          },
+          "then": {
+            "properties": {
+              "locked": {
+                "const": true
+              }
+            }
+          }
+        },
+        {
+          "if": {
+            "properties": {
+              "source": {
+                "enum": [
+                  "global",
+                  "default"
+                ]
+              }
+            }
+          },
+          "then": {
+            "properties": {
+              "mode": {
+                "const": "native"
+              }
+            }
+          }
+        }
+      ]
+    },
+    "descriptor": {
+      "const": "snapshot-launch-v1"
+    },
+    "root_context": {
+      "type": "object",
+      "required": [
+        "exclusive"
+      ],
+      "properties": {
+        "exclusive": {
+          "const": true
+        }
+      },
+      "additionalProperties": false
+    }
+  },
+  "allOf": [
+    {
+      "if": {
+        "properties": {
+          "environment": {
+            "const": "claude_code"
+          }
+        }
+      },
+      "then": {
+        "properties": {
+          "env": {
+            "const": {
+              "CLAUDE_CONFIG_DIR": "home"
+            }
+          },
+          "root_context": false
+        }
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "environment": {
+            "const": "codex_cli"
+          }
+        }
+      },
+      "then": {
+        "properties": {
+          "env": {
+            "const": {
+              "CODEX_HOME": "home"
+            }
+          },
+          "root_context": false
+        }
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "environment": {
+            "const": "opencode"
+          }
+        }
+      },
+      "then": {
+        "properties": {
+          "env": {
+            "const": {
+              "XDG_CONFIG_HOME": "home"
+            }
+          },
+          "root_context": false
+        }
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "environment": {
+            "const": "pi"
+          }
+        }
+      },
+      "then": {
+        "properties": {
+          "env": {
+            "const": {
+              "PI_CODING_AGENT_DIR": "home"
+            }
+          },
+          "mcp": false,
+          "root_context": false
+        }
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "environment": {
+            "const": "muse"
+          }
+        }
+      },
+      "then": {
+        "properties": {
+          "env": {
+            "const": {
+              "XDG_CONFIG_HOME": "home/config",
+              "XDG_DATA_HOME": "home/data",
+              "XDG_STATE_HOME": "home/state",
+              "XDG_CACHE_HOME": "home/cache"
+            }
+          },
+          "system_prompt": false,
+          "mcp": false
+        }
+      }
+    }
+  ],
+  "additionalProperties": false,
+  "$defs": {
+    "snapshotFilePath": {
+      "allOf": [
+        {
+          "$ref": "../v1/common.schema.json#/$defs/portablePath"
+        },
+        {
+          "pattern": "^home/"
+        }
+      ]
+    },
+    "flagArgument": {
+      "enum": [
+        "path",
+        "contents",
+        "name"
+      ]
+    },
+    "flagDescriptorCore": {
+      "properties": {
+        "kind": {
+          "const": "flag"
+        },
+        "flag": {
+          "type": "string",
+          "minLength": 2,
+          "maxLength": 128,
+          "pattern": "^-[^\\s]+$"
+        },
+        "argument": {
+          "$ref": "#/$defs/flagArgument"
+        },
+        "name": {
+          "$ref": "../v1/common.schema.json#/$defs/identifier"
+        },
+        "with": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": {
+            "type": "string",
+            "minLength": 2,
+            "maxLength": 128,
+            "pattern": "^-[^\\s]+$"
+          }
+        }
+      },
+      "allOf": [
+        {
+          "if": {
+            "properties": {
+              "argument": {
+                "const": "name"
+              }
+            }
+          },
+          "then": {
+            "required": [
+              "name"
+            ]
+          },
+          "else": {
+            "not": {
+              "required": [
+                "name"
+              ]
+            }
+          }
+        }
+      ]
+    },
+    "systemPromptDescriptor": {
+      "oneOf": [
+        {
+          "type": "object",
+          "required": [
+            "kind",
+            "semantics",
+            "flag",
+            "argument"
+          ],
+          "properties": {
+            "kind": {
+              "const": "flag"
+            },
+            "semantics": {
+              "enum": [
+                "append",
+                "replace"
+              ]
+            },
+            "flag": true,
+            "argument": true,
+            "name": true,
+            "with": true
+          },
+          "additionalProperties": false,
+          "allOf": [
+            {
+              "$ref": "#/$defs/flagDescriptorCore"
+            }
+          ]
+        },
+        {
+          "type": "object",
+          "required": [
+            "kind",
+            "semantics",
+            "key"
+          ],
+          "properties": {
+            "kind": {
+              "const": "config-key"
+            },
+            "semantics": {
+              "enum": [
+                "append",
+                "replace"
+              ]
+            },
+            "key": {
+              "$ref": "../v1/common.schema.json#/$defs/identifier"
+            }
+          },
+          "additionalProperties": false
+        },
+        {
+          "type": "object",
+          "required": [
+            "kind",
+            "semantics",
+            "variable"
+          ],
+          "properties": {
+            "kind": {
+              "const": "variable"
+            },
+            "semantics": {
+              "enum": [
+                "append",
+                "replace"
+              ]
+            },
+            "variable": {
+              "$ref": "../v1/common.schema.json#/$defs/identifier"
+            }
+          },
+          "additionalProperties": false
+        },
+        {
+          "type": "object",
+          "required": [
+            "kind",
+            "semantics",
+            "filename"
+          ],
+          "properties": {
+            "kind": {
+              "const": "file"
+            },
+            "semantics": {
+              "enum": [
+                "append",
+                "replace"
+              ]
+            },
+            "filename": {
+              "$ref": "../v1/common.schema.json#/$defs/portablePath"
+            }
+          },
+          "additionalProperties": false
+        }
+      ]
+    },
+    "mcpDescriptor": {
+      "oneOf": [
+        {
+          "type": "object",
+          "required": [
+            "kind",
+            "flag",
+            "argument"
+          ],
+          "properties": {
+            "kind": {
+              "const": "flag"
+            },
+            "flag": true,
+            "argument": true,
+            "name": true,
+            "with": true
+          },
+          "additionalProperties": false,
+          "allOf": [
+            {
+              "$ref": "#/$defs/flagDescriptorCore"
+            }
+          ]
+        },
+        {
+          "type": "object",
+          "required": [
+            "kind",
+            "key"
+          ],
+          "properties": {
+            "kind": {
+              "const": "config-key"
+            },
+            "key": {
+              "$ref": "../v1/common.schema.json#/$defs/identifier"
+            }
+          },
+          "additionalProperties": false
+        },
+        {
+          "type": "object",
+          "required": [
+            "kind",
+            "variable"
+          ],
+          "properties": {
+            "kind": {
+              "const": "variable"
+            },
+            "variable": {
+              "$ref": "../v1/common.schema.json#/$defs/identifier"
+            }
+          },
+          "additionalProperties": false
+        },
+        {
+          "type": "object",
+          "required": [
+            "kind",
+            "filename"
+          ],
+          "properties": {
+            "kind": {
+              "const": "file"
+            },
+            "filename": {
+              "$ref": "../v1/common.schema.json#/$defs/portablePath"
+            }
+          },
+          "additionalProperties": false
+        }
+      ]
+    }
+  }
+}
diff --git a/internal/envsnapshot/schemas/v1/agent-context-v1.schema.json b/internal/envsnapshot/schemas/v1/agent-context-v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..138dc95e398f30d4f7bcbf2a0e48e5e575d8bd6f
--- /dev/null
+++ b/internal/envsnapshot/schemas/v1/agent-context-v1.schema.json
@@ -0,0 +1,138 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/agent-context-v1.schema.json",
+  "title": "agent-context.json schema 1",
+  "type": "object",
+  "required": ["schema_version", "name", "version"],
+  "properties": {
+    "schema_version": {"const": 1},
+    "name": {"$ref": "common.schema.json#/$defs/identifier"},
+    "version": {"$ref": "#/$defs/packageVersion"},
+    "weight": {"$ref": "#/$defs/weight"},
+    "weights": {
+      "type": "object",
+      "propertyNames": {"$ref": "common.schema.json#/$defs/identifier"},
+      "additionalProperties": {"$ref": "#/$defs/weight"}
+    },
+    "context": {
+      "type": "object",
+      "required": ["modules"],
+      "properties": {
+        "modules": {
+          "type": "array",
+          "items": {"$ref": "#/$defs/module"}
+        }
+      },
+      "additionalProperties": false
+    },
+    "requires": {
+      "type": "object",
+      "properties": {
+        "contexts": {
+          "type": "object",
+          "propertyNames": {"$ref": "common.schema.json#/$defs/identifier"},
+          "additionalProperties": {"$ref": "#/$defs/contextRequirement"}
+        },
+        "skills": {
+          "type": "object",
+          "propertyNames": {"$ref": "common.schema.json#/$defs/identifier"},
+          "additionalProperties": {"$ref": "#/$defs/skillRequirement"}
+        },
+        "mcp": {
+          "type": "object",
+          "propertyNames": {"$ref": "common.schema.json#/$defs/identifier"},
+          "additionalProperties": {"$ref": "#/$defs/mcpRequirement"}
+        }
+      },
+      "additionalProperties": false
+    }
+  },
+  "additionalProperties": false,
+  "$defs": {
+    "packageVersion": {
+      "type": "string",
+      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
+    },
+    "weight": {"type": "integer", "minimum": 0, "maximum": 2147483647},
+    "range": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 1024,
+      "pattern": "^(?:latest|(?:(?:>=|<=|>|<|=|\\^|~)?(?:\\*|x|X|0|[1-9][0-9]*)(?:\\.(?:\\*|x|X|0|[1-9][0-9]*)(?:\\.(?:\\*|x|X|0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)?)?)(?: +(?:>=|<=|>|<|=|\\^|~)?(?:\\*|x|X|0|[1-9][0-9]*)(?:\\.(?:\\*|x|X|0|[1-9][0-9]*)(?:\\.(?:\\*|x|X|0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)?)?)*(?: *\\|\\| *(?:(?:>=|<=|>|<|=|\\^|~)?(?:\\*|x|X|0|[1-9][0-9]*)(?:\\.(?:\\*|x|X|0|[1-9][0-9]*)(?:\\.(?:\\*|x|X|0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)?)?)(?: +(?:>=|<=|>|<|=|\\^|~)?(?:\\*|x|X|0|[1-9][0-9]*)(?:\\.(?:\\*|x|X|0|[1-9][0-9]*)(?:\\.(?:\\*|x|X|0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)?)?)*)*)$"
+    },
+    "module": {
+      "type": "object",
+      "required": ["path"],
+      "properties": {
+        "path": {"$ref": "common.schema.json#/$defs/portablePath"},
+        "environments": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": {"$ref": "common.schema.json#/$defs/identifier"}
+        },
+        "class": {"enum": ["root", "system"]}
+      },
+      "additionalProperties": false
+    },
+    "requirementForm": {
+      "oneOf": [
+        {"required": ["range"], "not": {"anyOf": [{"required": ["tag"]}, {"required": ["revision"]}]}},
+        {"required": ["tag"], "not": {"anyOf": [{"required": ["range"]}, {"required": ["revision"]}]}},
+        {"required": ["revision"], "not": {"anyOf": [{"required": ["range"]}, {"required": ["tag"]}]}}
+      ]
+    },
+    "contextRequirement": {
+      "type": "object",
+      "required": ["git"],
+      "properties": {
+        "git": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
+        "range": {"$ref": "#/$defs/range"},
+        "tag": {"$ref": "common.schema.json#/$defs/gitRefName"},
+        "revision": {"$ref": "common.schema.json#/$defs/commit"},
+        "directory": {"$ref": "common.schema.json#/$defs/portablePath"},
+        "weight": {"$ref": "#/$defs/weight"}
+      },
+      "additionalProperties": false,
+      "allOf": [{"$ref": "#/$defs/requirementForm"}]
+    },
+    "skillRequirement": {
+      "type": "object",
+      "required": ["git"],
+      "properties": {
+        "git": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
+        "range": {"$ref": "#/$defs/range"},
+        "tag": {"$ref": "common.schema.json#/$defs/gitRefName"},
+        "revision": {"$ref": "common.schema.json#/$defs/commit"},
+        "mode": {"enum": ["full", "runtime", "context"]},
+        "commands": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": {"$ref": "common.schema.json#/$defs/identifier"}
+        }
+      },
+      "additionalProperties": false,
+      "allOf": [
+        {"$ref": "#/$defs/requirementForm"},
+        {
+          "if": {"required": ["commands"]},
+          "then": {"properties": {"mode": {"const": "runtime"}}, "required": ["mode"]}
+        }
+      ]
+    },
+    "mcpRequirement": {
+      "type": "object",
+      "required": ["git"],
+      "properties": {
+        "git": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
+        "range": {"$ref": "#/$defs/range"},
+        "tag": {"$ref": "common.schema.json#/$defs/gitRefName"},
+        "revision": {"$ref": "common.schema.json#/$defs/commit"},
+        "directory": {"$ref": "common.schema.json#/$defs/portablePath"}
+      },
+      "additionalProperties": false,
+      "allOf": [{"$ref": "#/$defs/requirementForm"}]
+    }
+  }
+}
diff --git a/internal/envsnapshot/schemas/v1/agent-environment-marker-v1.schema.json b/internal/envsnapshot/schemas/v1/agent-environment-marker-v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..85ca5809ddf3979ba88b3ef68762a9e559d7418c
