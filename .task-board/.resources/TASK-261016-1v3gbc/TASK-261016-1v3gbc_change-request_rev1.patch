+          },
+          "additionalProperties": false
+        },
+        {
+          "type": "object",
+          "required": ["object_format", "hex"],
+          "properties": {
+            "object_format": {"const": "sha256"},
+            "hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
+          },
+          "additionalProperties": false
+        }
+      ]
+    },
+    "buildRepositoryV1": {
+      "type": "object",
+      "required": ["git", "locked_commit"],
+      "properties": {
+        "git": {"$ref": "#/$defs/repositoryGit"},
+        "locked_commit": {"$ref": "#/$defs/lockedCommit"},
+        "tag": {"$ref": "#/$defs/gitRefName"}
+      },
+      "additionalProperties": false
+    },
+    "repositoryBuildCommandV1": {
+      "type": "object",
+      "required": ["type", "driver", "repository", "target"],
+      "properties": {
+        "type": {"const": "build"},
+        "driver": {"const": "go-repository-v1"},
+        "repository": {"$ref": "#/$defs/identifier"},
+        "target": {"$ref": "#/$defs/identifier"}
+      },
+      "additionalProperties": false
+    },
+    "commandV7": {
+      "oneOf": [
+        {"$ref": "#/$defs/scriptCommand"},
+        {"$ref": "#/$defs/systemCommand"},
+        {"$ref": "#/$defs/buildCommandV6"},
+        {"$ref": "#/$defs/repositoryBuildCommandV1"}
+      ]
+    },
+    "scriptExecutionPolicyV1": {"const": "script-worker-v1"},
+    "scriptInterpreterV1": {"enum": ["node-v1", "python3-v1"]},
+    "scriptCommandV8": {
+      "type": "object",
+      "required": ["type"],
+      "properties": {
+        "type": {"const": "script"},
+        "unix_path": {"$ref": "#/$defs/portablePath"},
+        "win_path": {"$ref": "#/$defs/portablePath"},
+        "execution_policy": {"$ref": "#/$defs/scriptExecutionPolicyV1"},
+        "interpreter": {"$ref": "#/$defs/scriptInterpreterV1"}
+      },
+      "anyOf": [{"required": ["unix_path"]}, {"required": ["win_path"]}],
+      "dependentRequired": {
+        "execution_policy": ["interpreter"],
+        "interpreter": ["execution_policy"]
+      },
+      "additionalProperties": false
+    },
+    "buildCommandV8": {
+      "type": "object",
+      "required": ["type", "driver", "source_dir"],
+      "properties": {
+        "type": {"const": "build"},
+        "driver": {"const": "go-v1"},
+        "source_dir": {"$ref": "#/$defs/portablePath"},
+        "modules": {"$ref": "#/$defs/pathSet"}
