+++ b/internal/envsnapshot/schemas/v1/agent-environment-marker-v1.schema.json
@@ -0,0 +1,203 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/agent-environment-marker-v1.schema.json",
+  "title": ".agent-environment.json schema 1",
+  "type": "object",
+  "required": ["version", "profile", "members", "precedence", "mode", "surfaces"],
+  "properties": {
+    "version": {"const": 1},
+    "profile": {
+      "oneOf": [
+        {
+          "type": "object",
+          "required": ["name", "root", "kind", "lock_sha256", "source", "requirement"],
+          "properties": {
+            "name": {"$ref": "common.schema.json#/$defs/identifier"},
+            "root": {"$ref": "common.schema.json#/$defs/identifier"},
+            "kind": {"const": "git"},
+            "lock_sha256": {"$ref": "common.schema.json#/$defs/hex256"},
+            "source": {"$ref": "context-lock-v1.schema.json#/$defs/sourceIdentity"},
+            "requirement": {"$ref": "#/$defs/requirement"},
+            "directory": {"$ref": "common.schema.json#/$defs/portablePath"}
+          },
+          "additionalProperties": false
+        },
+        {
+          "type": "object",
+          "required": ["name", "root", "kind", "lock_sha256"],
+          "properties": {
+            "name": {"$ref": "common.schema.json#/$defs/identifier"},
+            "root": {"$ref": "common.schema.json#/$defs/identifier"},
+            "kind": {"const": "local"},
+            "lock_sha256": {"$ref": "common.schema.json#/$defs/hex256"}
+          },
+          "additionalProperties": false
+        },
+        {
+          "type": "object",
+          "required": ["name", "root", "kind", "lock_sha256", "source_path"],
+          "properties": {
+            "name": {"$ref": "common.schema.json#/$defs/identifier"},
+            "root": {"$ref": "common.schema.json#/$defs/identifier"},
+            "kind": {"const": "path"},
+            "lock_sha256": {"$ref": "common.schema.json#/$defs/hex256"},
+            "source_path": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
+            "imported_from_native": {"const": true}
+          },
+          "additionalProperties": false
+        }
+      ]
+    },
+    "members": {
+      "type": "array",
+      "minItems": 1,
+      "items": {"$ref": "#/$defs/member"}
+    },
+    "precedence": {"$ref": "#/$defs/precedence"},
+    "mode": {"enum": ["managed-home", "linked", "copied"]},
+    "surfaces": {
+      "type": "object",
+      "properties": {
+        "mcp": {"$ref": "#/$defs/surfaceEntry"},
+        "root-context": {"$ref": "#/$defs/rootContextSurfaceEntry"},
+        "skills": {"$ref": "#/$defs/surfaceEntry"},
+        "system-prompt": {"$ref": "#/$defs/surfaceEntry"}
+      },
+      "additionalProperties": false
+    },
+    "passthrough": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["path", "strategy"],
+        "properties": {
+          "path": {"$ref": "common.schema.json#/$defs/portablePath"},
+          "strategy": {"enum": ["per-home-keychain", "file-link", "keyring-preferred", "ambient", "in-place"]}
+        },
+        "additionalProperties": false
+      }
+    },
+    "seeds": {"$ref": "common.schema.json#/$defs/pathSet"},
+    "seeded_projects": {
+      "type": "array",
+      "uniqueItems": true,
+      "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
+    },
+    "seed_links": {"$ref": "common.schema.json#/$defs/pathSet"},
+    "codex_seed_record": {
+      "type": "object",
+      "required": ["revision", "native_mcp_servers"],
+      "properties": {
+        "revision": {"enum": ["A", "B"]},
+        "native_mcp_servers": {
+          "type": "array",
+          "uniqueItems": true,
+          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
+        }
+      },
+      "additionalProperties": false
+    }
+  },
+  "allOf": [
+    {
+      "if": {"properties": {"mode": {"const": "copied"}}, "required": ["mode"]},
+      "then": {
+        "properties": {
+          "surfaces": {"additionalProperties": {"not": {"required": ["copies"]}}}
+        }
+      },
+      "else": {
+        "properties": {
+          "surfaces": {"additionalProperties": {"required": ["copies"]}}
+        }
+      }
+    },
+    {
+      "if": {"properties": {"mode": {"const": "managed-home"}}, "required": ["mode"]},
+      "then": {"required": ["passthrough", "seeds"]},
+      "else": {
+        "properties": {
+          "passthrough": false,
+          "seeds": false,
+          "seeded_projects": false,
+          "seed_links": false,
+          "codex_seed_record": false
+        }
+      }
+    }
+  ],
+  "additionalProperties": false,
+  "$defs": {
+    "requirement": {
+      "type": "object",
+      "properties": {
+        "range": {"$ref": "agent-context-v1.schema.json#/$defs/range"},
+        "tag": {"$ref": "common.schema.json#/$defs/gitRefName"},
+        "revision": {"$ref": "common.schema.json#/$defs/commit"}
+      },
+      "additionalProperties": false,
+      "minProperties": 1,
+      "maxProperties": 1
+    },
+    "precedence": {
+      "type": "object",
+      "required": ["winner", "placement"],
+      "properties": {
+        "winner": {"enum": ["higher-weight", "lower-weight"]},
+        "placement": {"enum": ["winner-last", "winner-first"]}
+      },
+      "additionalProperties": false
+    },
+    "member": {
+      "type": "object",
+      "required": ["name", "version", "weight", "overlay"],
+      "properties": {
+        "name": {"$ref": "common.schema.json#/$defs/identifier"},
+        "version": {"$ref": "agent-context-v1.schema.json#/$defs/packageVersion"},
+        "commit": {"$ref": "common.schema.json#/$defs/commit"},
+        "state_sha256": {"$ref": "common.schema.json#/$defs/hex256"},
+        "weight": {"$ref": "agent-context-v1.schema.json#/$defs/weight"},
+        "overlay": {"type": "boolean"},
+        "source_path": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
+      },
+      "additionalProperties": false,
+      "oneOf": [
+        {"required": ["commit"], "not": {"anyOf": [{"required": ["state_sha256"]}, {"required": ["source_path"]}]}},
+        {"required": ["state_sha256"], "not": {"required": ["commit"]}}
+      ]
+    },
+    "rootContextSurfaceEntry": {
+      "type": "object",
+      "required": ["paths", "form", "content_sha256"],
+      "properties": {
+        "paths": {"$ref": "common.schema.json#/$defs/pathSet"},
+        "form": {"enum": ["monolithic", "referenced"]},
+        "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
+        "copies": {"$ref": "#/$defs/copies"}
+      },
+      "additionalProperties": false
+    },
+    "surfaceEntry": {
+      "type": "object",
+      "required": ["paths", "content_sha256"],
+      "properties": {
+        "paths": {"$ref": "common.schema.json#/$defs/pathSet"},
+        "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
+        "copies": {"$ref": "#/$defs/copies"}
+      },
+      "additionalProperties": false
+    },
+    "copies": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["path", "reason"],
+        "properties": {
+          "path": {"$ref": "common.schema.json#/$defs/portablePath"},
+          "reason": {"enum": ["symlink-fallback", "claude-code-root-context"]}
+        },
+        "additionalProperties": false
+      }
+    }
+  }
+}
diff --git a/internal/envsnapshot/schemas/v1/agent-mcp-v1.schema.json b/internal/envsnapshot/schemas/v1/agent-mcp-v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..e7e6c2f7b86ce04a70fef7dea5be10da84ad994f
--- /dev/null
+++ b/internal/envsnapshot/schemas/v1/agent-mcp-v1.schema.json
@@ -0,0 +1,70 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/agent-mcp-v1.schema.json",
+  "title": "agent-mcp.json schema 1",
+  "type": "object",
+  "required": ["schema_version", "name", "version", "server"],
+  "properties": {
+    "schema_version": {"const": 1},
+    "name": {"$ref": "common.schema.json#/$defs/identifier"},
+    "version": {"$ref": "agent-context-v1.schema.json#/$defs/packageVersion"},
+    "server": {
+      "oneOf": [
+        {
+          "type": "object",
+          "required": ["transport", "command", "args"],
+          "properties": {
+            "transport": {"const": "stdio"},
+            "command": {"$ref": "#/$defs/bareCommand"},
+            "args": {"type": "array", "items": {"type": "string", "maxLength": 8192}},
+            "env_names": {"$ref": "#/$defs/envNames"},
+            "environments": {"$ref": "#/$defs/environments"}
+          },
+          "additionalProperties": false
+        },
+        {
+          "type": "object",
+          "required": ["transport", "url"],
+          "properties": {
+            "transport": {"const": "http"},
+            "url": {"$ref": "#/$defs/httpsUrl"},
+            "env_names": {"$ref": "#/$defs/envNames"},
+            "environments": {"$ref": "#/$defs/environments"}
+          },
+          "additionalProperties": false
+        }
+      ]
+    }
+  },
+  "additionalProperties": false,
+  "$defs": {
+    "bareCommand": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 255,
+      "pattern": "^(?!\\.{1,2}$)[^/\\\\\\s\\u0000-\\u001f\\u007f]+$"
+    },
+    "httpsUrl": {
+      "type": "string",
+      "minLength": 9,
+      "maxLength": 4096,
+      "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]{1,5})?(?:/[^\\s?#@]*)?$"
+    },
+    "envNames": {
+      "type": "array",
+      "uniqueItems": true,
+      "items": {
+        "allOf": [
+          {"$ref": "common.schema.json#/$defs/identifier"},
+          {"not": {"pattern": "^(?:PATH|HOME|TMPDIR|TEMP|TMP|XDG_CONFIG_HOME|XDG_CACHE_HOME|XDG_DATA_HOME|XDG_STATE_HOME|HTTP_PROXY|HTTPS_PROXY|ALL_PROXY|FTP_PROXY|NO_PROXY|http_proxy|https_proxy|all_proxy|ftp_proxy|no_proxy|RES_OPTIONS|HOSTALIASES|LOCALDOMAIN|IFS|CSK_PROJECT_ROOT|USERPROFILE|APPDATA|LOCALAPPDATA|PATHEXT|COMSPEC|WINDIR|SYSTEMROOT|__PYVENV_LAUNCHER__|LD_.*|DYLD_.*|PYTHON.*|NODE_.*|NPM_CONFIG_.*)$"}}
+        ]
+      }
+    },
+    "environments": {
+      "type": "array",
+      "minItems": 1,
+      "uniqueItems": true,
+      "items": {"$ref": "common.schema.json#/$defs/identifier"}
+    }
+  }
+}
diff --git a/internal/envsnapshot/schemas/v1/common.schema.json b/internal/envsnapshot/schemas/v1/common.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..50b0a606d42e1ea502eb57e69f6d335541bce20d
--- /dev/null
+++ b/internal/envsnapshot/schemas/v1/common.schema.json
@@ -0,0 +1,665 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json",
+  "title": "Curator Protocol common definitions",
+  "$defs": {
+    "identifier": {
+      "allOf": [
+        {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$", "maxLength": 128},
+        {"not": {"pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$)"}}
+      ]
+    },
+    "portablePath": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 4096,
+      "pattern": "^[^/\\\\:\\u0000-\\u001f\\u007f-\\u009f](?:[^\\\\:\\u0000-\\u001f\\u007f-\\u009f]*[^/ .\\\\:\\u0000-\\u001f\\u007f-\\u009f])?$",
+      "not": {"pattern": "(?:^|/)(?:\\.{1,2}|[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$)|//"}
+    },
+    "nonEmptyString": {"type": "string", "minLength": 1, "maxLength": 8192},
+    "projectAlias": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},
+    "locale": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,62}[A-Za-z0-9])?$"},
+    "safeInteger": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
+    "nonNegativeSafeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
+    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
+    "hex256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
+    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
+    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
+    "stringSet": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
+    "identifierSet": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
+    "pathSet": {"type": "array", "items": {"$ref": "#/$defs/portablePath"}, "uniqueItems": true},
+    "ref": {
+      "type": "object",
+      "required": ["kind", "value"],
+      "properties": {
+        "kind": {"enum": ["tag", "revision"]},
+        "value": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\s\\^~><*]+$"}
+      },
+      "additionalProperties": false
+    },
+    "devRef": {
+      "type": "object",
+      "required": ["kind", "value"],
+      "properties": {
+        "kind": {"enum": ["tag", "revision", "branch"]},
+        "value": {"type": "string", "minLength": 1, "maxLength": 1024}
+      },
+      "additionalProperties": false
+    },
+    "scriptCommand": {
+      "type": "object",
+      "required": ["type"],
+      "properties": {
+        "type": {"const": "script"},
+        "unix_path": {"$ref": "#/$defs/portablePath"},
+        "win_path": {"$ref": "#/$defs/portablePath"}
+      },
+      "anyOf": [{"required": ["unix_path"]}, {"required": ["win_path"]}],
+      "additionalProperties": false
+    },
+    "systemCommand": {
+      "type": "object",
+      "required": ["type", "command"],
+      "properties": {
+        "type": {"const": "system"},
+        "command": {"$ref": "#/$defs/identifier"},
+        "hint": {"$ref": "#/$defs/nonEmptyString"}
+      },
+      "additionalProperties": false
+    },
+    "command": {"oneOf": [{"$ref": "#/$defs/scriptCommand"}, {"$ref": "#/$defs/systemCommand"}]},
+    "buildCommandV6": {
+      "type": "object",
+      "required": ["type", "driver", "source_dir"],
+      "properties": {
+        "type": {"const": "build"},
+        "driver": {"const": "go-v1"},
+        "source_dir": {"$ref": "#/$defs/portablePath"}
+      },
+      "additionalProperties": false
+    },
+    "commandV6": {"oneOf": [{"$ref": "#/$defs/scriptCommand"}, {"$ref": "#/$defs/systemCommand"}, {"$ref": "#/$defs/buildCommandV6"}]},
+    "rootOrPortablePath": {
+      "oneOf": [
+        {"const": "."},
+        {"$ref": "#/$defs/portablePath"}
+      ]
+    },
+    "repositoryGit": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 4096,
+      "pattern": "^(?:https://[A-Za-z0-9][A-Za-z0-9.-]*/(?!(?:\\.{1,2})(?:/|$))[^\\s%?#\\\\/:\\u0000-\\u001f\\u007f-\\u009f]+(?:/(?!(?:\\.{1,2})(?:/|$))[^\\s%?#\\\\/:\\u0000-\\u001f\\u007f-\\u009f]+)*|ssh://(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}@)?[A-Za-z0-9][A-Za-z0-9.-]*/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*|(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}@)?[A-Za-z0-9][A-Za-z0-9.-]*:(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*)$"
+    },
+    "gitRefName": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 255,
+      "pattern": "^(?!/)(?!.*//)(?!.*\\.\\.)(?!.*@\\{)(?!.*(?:^|/)\\.)(?!.*(?:^|/)[^/]*\\.lock(?:/|$))(?!.*[\\u0000-\\u0020\\u007f~^:?*\\[\\\\])(?!@$).*[^/.]$"
+    },
+    "lockedCommit": {
+      "oneOf": [
+        {
+          "type": "object",
+          "required": ["object_format", "hex"],
