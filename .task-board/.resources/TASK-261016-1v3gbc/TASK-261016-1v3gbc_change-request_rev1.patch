+      "additionalProperties": false
+    },
+    "effectiveRepositorySourceV1": {
+      "type": "object",
+      "required": ["identity", "object_format", "commit", "substituted", "build_source"],
+      "properties": {
+        "identity": {
+          "oneOf": [
+            {"$ref": "#/$defs/networkSourceIdentity"},
+            {"$ref": "#/$defs/localSourceIdentity"}
+          ]
+        },
+        "transport": {"enum": ["https", "ssh"]},
+        "object_format": {"enum": ["sha1", "sha256"]},
+        "commit": {"$ref": "#/$defs/commit"},
+        "substituted": {"type": "boolean"},
