+          "additionalProperties": false
+        }
+      ]
+    },
+    "buildRepositorySubstitution": {
+      "oneOf": [
+        {
+          "type": "object",
+          "required": ["path"],
+          "properties": {"path": {"$ref": "#/$defs/nonEmptyString"}},
