index 0000000000000000000000000000000000000000..f4eaaca99d6296b64cefc36eb15942049912737f
--- /dev/null
+++ b/internal/envsnapshot/codec.go
@@ -0,0 +1,298 @@
+// Package envsnapshot implements the closed snapshot metadata and read-only
+// actual-tree identity boundary. Parsing metadata never verifies a directory.
+package envsnapshot
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"embed"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io/fs"
+	"reflect"
+	"sync"
+	"time"
+	"unicode/utf8"
+
+	"github.com/dlclark/regexp2"
+	"github.com/relux-works/curator/internal/protocoljson"
+	"github.com/santhosh-tekuri/jsonschema/v6"
+)
+
+// Snapshot and descriptor wire versions are independent of launch fragments.
+const (
+	ManifestVersion   = "managed-home-snapshot-v1"
+	DescriptorVersion = "snapshot-launch-v1"
+	// Mismatch is deliberately content-free, including for failed filesystem reads.
+	Mismatch = "environment_materialize_snapshot_mismatch"
+)
+
+// Error exposes a stable refusal code and a bounded reason, never raw input,
+// file contents, local paths, or operating-system error strings.
+type Error struct{ Code, Reason string }
+
+func (e *Error) Error() string   { return e.Code + ": " + e.Reason }
+func refuse(reason string) error { return &Error{Mismatch, reason} }
+
+// Profile binds the selected profile name and verified lock digest.
+type Profile struct {
+	Name       string `json:"name"`
+	LockSHA256 string `json:"lock_sha256"`
+}
+
+// File describes one regular content file below home/.
+type File struct {
+	Path   string `json:"path"`
+	Size   int64  `json:"size"`
+	SHA256 string `json:"sha256"`
+	Mode   string `json:"mode"`
+}
+
+// Manifest is the closed managed-home-snapshot-v1 inventory and provenance.
+type Manifest struct {
+	Snapshot       string  `json:"snapshot"`
+	Adapter        string  `json:"adapter"`
+	Profile        Profile `json:"profile"`
+	CuratorVersion string  `json:"curator_version"`
+	FragmentSHA256 string  `json:"fragment_sha256"`
+	LaunchSHA256   string  `json:"launch_sha256"`
+	Files          []File  `json:"files"`
+}
+
+// Precedence retains the source fragment precedence policy.
+type Precedence struct {
+	Winner    string `json:"winner"`
+	Placement string `json:"placement"`
+}
+
+// Permissions retains the source fragment permission policy.
+type Permissions struct {
+	Mode   string `json:"mode"`
+	Locked bool   `json:"locked"`
+	Source string `json:"source"`
+}
+
+// Channel is one closed adapter-defined launch channel.
+type Channel struct {
+	Kind      string   `json:"kind"`
+	Semantics string   `json:"semantics,omitempty"`
+	Flag      string   `json:"flag,omitempty"`
+	Argument  string   `json:"argument,omitempty"`
+	Name      string   `json:"name,omitempty"`
+	With      []string `json:"with,omitempty"`
+	Key       string   `json:"key,omitempty"`
+	Variable  string   `json:"variable,omitempty"`
+	Filename  string   `json:"filename,omitempty"`
+}
+
+// SystemPrompt references inert prompt content and its available channels.
+type SystemPrompt struct {
+	Path     string    `json:"path"`
+	Channels []Channel `json:"channels"`
+}
+
+// MCP references the portable MCP layer and variable names, never values.
+type MCP struct {
+	Path     string    `json:"path"`
+	EnvNames []string  `json:"env_names"`
+	Channels []Channel `json:"channels"`
+}
+
+// RootContext carries the explicit Muse exclusive-context fact.
+type RootContext struct {
+	Exclusive bool `json:"exclusive"`
+}
+
+// Descriptor is a portable snapshot-launch-v1 object, not a launch fragment.
+type Descriptor struct {
+	Descriptor   string            `json:"descriptor"`
+	Environment  string            `json:"environment"`
+	Profile      Profile           `json:"profile"`
+	Precedence   Precedence        `json:"precedence"`
+	Env          map[string]string `json:"env"`
+	Permissions  Permissions       `json:"permissions"`
+	SystemPrompt *SystemPrompt     `json:"system_prompt,omitempty"`
+	MCP          *MCP              `json:"mcp,omitempty"`
+	RootContext  *RootContext      `json:"root_context,omitempty"`
+}
+
+// The exact published schemas, including their referenced definitions, are
+// embedded: validation never downloads schemas or consults ambient state.
+//
+//go:embed schemas/*/*
+var schemas embed.FS
+var validators = sync.OnceValues(func() (map[string]*jsonschema.Schema, error) {
+	c := jsonschema.NewCompiler()
+	c.UseRegexpEngine(compilePattern)
+	c.UseLoader(closedLoader{})
+	paths, err := fs.Glob(schemas, "schemas/*/*.json")
+	if err != nil {
+		return nil, err
+	}
+	for _, p := range paths {
+		raw, err := schemas.ReadFile(p)
+		if err != nil {
+			return nil, err
+		}
+		var doc map[string]any
+		if err := json.Unmarshal(raw, &doc); err != nil {
+			return nil, err
+		}
+		if err := c.AddResource(doc["$id"].(string), doc); err != nil {
+			return nil, err
+		}
+	}
+	base := "https://relux-works.github.io/curator-spec/schemas/managed-home-snapshot-v1/"
+	m, err := c.Compile(base + "managed-home-snapshot-v1.schema.json")
+	if err != nil {
+		return nil, err
+	}
+	d, err := c.Compile(base + "snapshot-launch-v1.schema.json")
+	return map[string]*jsonschema.Schema{"manifest": m, "descriptor": d}, err
+})
+
+func decode(raw []byte, manifest bool, dst any) error {
+	if len(raw) == 0 || raw[len(raw)-1] != '\n' {
+		return refuse("metadata-canonical")
+	}
+	payload := raw[:len(raw)-1]
+	if err := protocoljson.UnmarshalCanonical(payload, dst); err != nil {
+		return refuse("metadata-canonical")
+	}
+	var value any
+	decoder := json.NewDecoder(bytes.NewReader(payload))
+	decoder.UseNumber()
+	if err := decoder.Decode(&value); err != nil {
+		return refuse("metadata-canonical")
+	}
+	checks, err := validators()
+	if err != nil {
+		return refuse("schema-unavailable")
+	}
+	schema := checks["descriptor"]
+	reason := "launch-schema"
+	if manifest {
+		schema = checks["manifest"]
+		reason = "manifest-schema"
+	}
+	if err := schema.Validate(value); err != nil {
+		return refuse(reason)
+	}
+	return nil
+}
+
+// DecodeManifest validates closed schema and exact CCJ-1 plus one LF framing.
+// Cross-file and actual-tree checks are exclusively the job of Verify.
+func DecodeManifest(raw []byte) (Manifest, error) {
+	var m Manifest
+	err := decode(raw, true, &m)
+	return m, err
+}
+
+// DecodeDescriptor validates the closed descriptor schema and exact wire frame.
+func DecodeDescriptor(raw []byte) (Descriptor, error) {
+	var d Descriptor
+	err := decode(raw, false, &d)
+	return d, err
+}
+
+func encode(value any, manifest bool) ([]byte, error) {
+	if !validStrings(reflect.ValueOf(value)) {
+		return nil, refuse("metadata-canonical")
+	}
+	// Convert typed structs to the JSON domain without losing integer precision.
+	raw, err := json.Marshal(value)
+	if err != nil {
+		return nil, refuse("metadata-schema")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	var object any
+	if err := decoder.Decode(&object); err != nil {
+		return nil, refuse("metadata-schema")
+	}
+	canonical, err := protocoljson.MarshalCanonical(object)
+	if err != nil {
+		return nil, refuse("metadata-canonical")
+	}
+	canonical = append(canonical, '\n')
+	if manifest {
+		_, err = DecodeManifest(canonical)
+	} else {
+		_, err = DecodeDescriptor(canonical)
+	}
+	if err != nil {
+		return nil, err
+	}
+	return canonical, nil
+}
+
+// EncodeManifest emits validated CCJ-1 followed by exactly one LF.
+func EncodeManifest(m Manifest) ([]byte, error) { return encode(m, true) }
+
+// EncodeDescriptor emits validated CCJ-1 followed by exactly one LF.
+func EncodeDescriptor(d Descriptor) ([]byte, error) { return encode(d, false) }
+
+// Digest hashes exact bytes; manifest and descriptor callers include their LF.
+func Digest(raw []byte) string { sum := sha256.Sum256(raw); return hex.EncodeToString(sum[:]) }
+
+// FragmentDigest requires source CCJ-1 WITHOUT its presentation LF. Passing a
+// rendered fragment with LF is refused rather than hashed in the wrong domain.
+func FragmentDigest(canonical []byte) (string, error) {
+	if err := protocoljson.RequireCanonical(canonical); err != nil {
+		return "", refuse("fragment-canonical")
+	}
+	return Digest(canonical), nil
+}
+
+type closedLoader struct{}
+
+func (closedLoader) Load(string) (any, error) { return nil, errors.New("unbundled schema") }
+
+type schemaPattern struct{ re *regexp2.Regexp }
+
+func (p schemaPattern) MatchString(s string) bool {
+	matched, err := p.re.MatchString(s)
+	return err == nil && matched
+}
+func (p schemaPattern) String() string { return p.re.String() }
+func compilePattern(s string) (jsonschema.Regexp, error) {
+	re, err := regexp2.Compile(s, regexp2.ECMAScript)
+	if err != nil {
+		return nil, err
+	}
+	re.MatchTimeout = time.Second
+	return schemaPattern{re}, nil
+}
+
+// encoding/json replaces invalid UTF-8. Refuse it before converting the typed
+// model to the JSON domain so encoding cannot silently change path identity.
+func validStrings(v reflect.Value) bool {
+	switch v.Kind() {
+	case reflect.String:
+		return utf8.ValidString(v.String())
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			if !validStrings(v.Field(i)) {
+				return false
+			}
+		}
+	case reflect.Pointer, reflect.Interface:
+		return v.IsNil() || validStrings(v.Elem())
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			if !validStrings(v.Index(i)) {
+				return false
+			}
+		}
+	case reflect.Map:
+		iter := v.MapRange()
+		for iter.Next() {
+			if !validStrings(iter.Key()) || !validStrings(iter.Value()) {
+				return false
+			}
+		}
+	}
+	return true
+}
diff --git a/internal/envsnapshot/codec_test.go b/internal/envsnapshot/codec_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e08ca72b9bb886ac9b449e21a19e6a0d3fc0edba
--- /dev/null
+++ b/internal/envsnapshot/codec_test.go
@@ -0,0 +1,242 @@
+package envsnapshot
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/relux-works/curator/internal/protocoljson"
+)
+
+const corpus = "../crossconformance/testdata/managed-home-snapshot-v1"
+
+func read(t *testing.T, p string) []byte {
+	t.Helper()
+	b, err := os.ReadFile(filepath.Join(corpus, p))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+func canonical(t *testing.T, b []byte) []byte {
+	t.Helper()
+	var v any
+	dec := json.NewDecoder(bytes.NewReader(b))
+	dec.UseNumber()
+	if err := dec.Decode(&v); err != nil {
+		t.Fatal(err)
+	}
+	out, err := protocoljson.MarshalCanonical(v)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return append(out, '\n')
+}
+func requireReason(t *testing.T, err error, reason string) {
+	t.Helper()
+	var refusal *Error
+	if !errors.As(err, &refusal) || refusal.Code != Mismatch || (reason != "" && refusal.Reason != reason) {
+		t.Fatalf("refusal = %v, want %s/%s", err, Mismatch, reason)
+	}
+}
+func manifest(t *testing.T) Manifest {
+	t.Helper()
+	m, err := DecodeManifest(read(t, "golden/manifest.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+func descriptor(t *testing.T) Descriptor {
+	t.Helper()
+	d, err := DecodeDescriptor(read(t, "golden/launch.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return d
+}
+
+// All indexed fixed schema cases drive the public codecs after canonical wire
+// framing; their original validity expectations are independent of this code.
+func TestPinnedSchemaCases(t *testing.T) {
+	var index []struct {
+		Schema, Instance string
+		Valid            bool
+	}
+	if err := json.Unmarshal(read(t, "index.json"), &index); err != nil {
+		t.Fatal(err)
+	}
+	if len(index) != 58 {
+		t.Fatalf("schema inventory changed: %d", len(index))
+	}
+	for _, c := range index {
+		t.Run(c.Instance, func(t *testing.T) {
+			raw := read(t, c.Instance)
+			var domain any
+			decoder := json.NewDecoder(bytes.NewReader(raw))
+			decoder.UseNumber()
+			if err := decoder.Decode(&domain); err != nil {
+				t.Fatal(err)
+			}
+			wire, ccjErr := protocoljson.MarshalCanonical(domain)
+			if ccjErr != nil {
+				if c.Valid {
+					t.Fatal(ccjErr)
+				}
+				// Invalid numeric schema vectors (e.g. 1.5) are also outside
+				// CCJ-1. Drive the codec with compact JSON and require refusal.
+				var compact bytes.Buffer
+				if err := json.Compact(&compact, raw); err != nil {
+					t.Fatal(err)
+				}
+				wire = compact.Bytes()
+			}
+			b := append(wire, '\n')
+			var err error
+			if c.Schema == "managed-home-snapshot-v1.schema.json" {
+				_, err = DecodeManifest(b)
+			} else {
+				_, err = DecodeDescriptor(b)
+			}
+			if (err == nil) != c.Valid {
+				t.Fatalf("valid=%v error=%v", c.Valid, err)
+			}
+			if !c.Valid {
+				requireReason(t, err, "")
+			}
+		})
+	}
+}
+
+// Exact metadata bytes and LF-inclusive digests match published vectors;
+// malformed frames, duplicates, unknown fields and wrong domains refuse.
+func TestMetadataFramingAndHashDomains(t *testing.T) {
+	var pins map[string]string
+	if err := json.Unmarshal(read(t, "golden/digests.json"), &pins); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"manifest.json", "launch.json"} {
+		t.Run(name, func(t *testing.T) {
+			raw := read(t, "golden/"+name)
+			var encoded []byte
+			var err error
+			decode := func(b []byte) error {
+				if name == "manifest.json" {
+					_, e := DecodeManifest(b)
+					return e
+				}
+				_, e := DecodeDescriptor(b)
+				return e
+			}
+			if name == "manifest.json" {
+				encoded, err = EncodeManifest(manifest(t))
+			} else {
+				encoded, err = EncodeDescriptor(descriptor(t))
+			}
+			if err != nil || !bytes.Equal(encoded, raw) || Digest(raw) != pins[name] {
+				t.Fatalf("pinned encoding/digest mismatch: %v", err)
+			}
+			for label, b := range map[string][]byte{"no LF": raw[:len(raw)-1], "two LF": append(bytes.Clone(raw), '\n'), "CRLF": append(bytes.Clone(raw[:len(raw)-1]), '\r', '\n'), "space": append([]byte(" "), raw...), "BOM": append([]byte{239, 187, 191}, raw...), "duplicate": []byte("{\"descriptor\":\"snapshot-launch-v1\",\"descriptor\":\"snapshot-launch-v1\"}\n"), "unknown": []byte(strings.Replace(string(raw), "{", "{\"_unknown\":true,", 1))} {
+				t.Run(label, func(t *testing.T) {
+					requireReason(t, decode(b), "")
+				})
+			}
+			if Digest(raw) == Digest(raw[:len(raw)-1]) {
+				t.Fatal("LF excluded from metadata digest")
+			}
+		})
+	}
+	fragment := []byte(`{"env":{"CODEX_HOME":"/fixture/a"},"fragment":"launch-env-fragment-v2"}`)
+	got, err := FragmentDigest(fragment)
+	if err != nil || got != Digest(fragment) {
+		t.Fatal(got, err)
+	}
+	_, err = FragmentDigest(append(bytes.Clone(fragment), '\n'))
+	requireReason(t, err, "fragment-canonical")
+}
+
+// Semantic corpus metadata uses public codecs and the same semantic boundary
+// as Verify; tree-byte cases are exercised through Verify in TestPinnedTrees.
+func TestPinnedMetadataSemantics(t *testing.T) {
+	var vectors struct {
+		Cases []struct{ Name, Manifest, Launch, Expected string }
+	}
+	if err := json.Unmarshal(read(t, "vectors.json"), &vectors); err != nil {
+		t.Fatal(err)
+	}
+	for _, v := range vectors.Cases {
+		t.Run(v.Name, func(t *testing.T) {
+			m, err := DecodeManifest(read(t, v.Manifest))
+			if err == nil {
+				var d Descriptor
+				d, err = DecodeDescriptor(read(t, v.Launch))
+				if err == nil {
+					_, err = validateMetadata(m, d, read(t, v.Launch))
+				}
+			}
+			switch v.Expected {
+			case "entry-set", "file-identity", "accept":
+				if err != nil {
+					t.Fatal(err)
+				}
+			default:
+				requireReason(t, err, v.Expected)
+			}
+		})
+	}
+}
+
+// Schema source pins cover the two frozen schemas; all corpus files retain
+// their independent manifest hashes rather than being regenerated locally.
+func TestCorpusPins(t *testing.T) {
+	var pins struct {
+		Files []struct{ Path, SHA256 string }
+	}
+	if err := json.Unmarshal(read(t, "manifest.json"), &pins); err != nil {
+		t.Fatal(err)
+	}
+	count := 0
+	for _, p := range pins.Files {
+		var b []byte
+		var err error
+		switch {
+		case strings.HasPrefix(p.Path, "conformance/managed-home-snapshot-v1/"):
+			b = read(t, strings.TrimPrefix(p.Path, "conformance/managed-home-snapshot-v1/"))
+		case strings.HasPrefix(p.Path, "schemas/managed-home-snapshot-v1/"):
+			b, err = schemas.ReadFile(p.Path)
+			if err != nil {
+				t.Fatal(err)
+			}
+		default:
+			continue
+		}
+		if "sha256:"+Digest(b) != p.SHA256 {
+			t.Fatalf("pin mismatch: %s", p.Path)
+		}
+		count++
+	}
+	if count != 95 {
+		t.Fatalf("pin count = %d", count)
+	}
+}
+
+// Encoding typed models preserves Unicode scalar values and refuses invalid
+// UTF-8 instead of accepting encoding/json's replacement-rune normalization.
+func TestTypedEncodingRejectsInvalidUTF8(t *testing.T) {
+	m := manifest(t)
+	m.Files[0].Path = "home/é.txt"
+	if _, err := EncodeManifest(m); err != nil {
+		t.Fatal(err)
+	}
+	m.Files[0].Path = "home/" + string([]byte{0xff}) + ".txt"
+	_, err := EncodeManifest(m)
+	requireReason(t, err, "metadata-canonical")
+	d := descriptor(t)
+	d.Env[string([]byte{0xff})] = "home"
+	_, err = EncodeDescriptor(d)
+	requireReason(t, err, "metadata-canonical")
+}
diff --git a/internal/envsnapshot/controls_test.go b/internal/envsnapshot/controls_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..5d6dc60913872b262d041727ab33a7928010ceb3
--- /dev/null
+++ b/internal/envsnapshot/controls_test.go
@@ -0,0 +1,110 @@
+//go:build snapshotcontrols && (darwin || linux || freebsd || openbsd || netbsd || dragonfly)
+
+package envsnapshot
+
+import (
+	"bytes"
+	"encoding/json"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// Opt-in bounded controls copy this package into task-local scratch, weaken one
+// production gate, and run the named behavioral test. A compiler/setup failure
+// is NOT a kill; the named test must report Action=fail. Originals are untouched.
+func TestNarrowingControls(t *testing.T) {
+	root, err := filepath.Abs("../..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	corpusPath, err := filepath.Abs(corpus)
+	if err != nil {
+		t.Fatal(err)
+	}
+	mutants := []struct{ name, file, old, new, test string }{
+		{"M11-schema-README-EOL", ".gitattributes", "schemas/** -text", "schemas/** -text\nschemas/**/*.md text", "TestPinnedSchemaCheckoutBytes/protected"},
+		{"M10-UTF8-path-only", "codec.go", "return utf8.ValidString(v.String())", "return strings.HasSuffix(v.String(),\".txt\") || utf8.ValidString(v.String())", "TestTypedEncodingRejectsInvalidUTF8"},
+		{"M1-one-extra-LF", "codec.go", "payload := raw[:len(raw)-1]", "payload := raw[:len(raw)-1]; if bytes.HasSuffix(payload,[]byte{10}) { payload=payload[:len(payload)-1] }", "TestMetadataFramingAndHashDomains"},
+		{"M2-one-unknown-member", "codec.go", "payload := raw[:len(raw)-1]", "payload := raw[:len(raw)-1]; payload=bytes.Replace(payload,[]byte(`\"_unknown\":true,`),nil,1)", "TestMetadataFramingAndHashDomains"},
+		{"M3-launch-hash-without-LF", "metadata.go", "m.LaunchSHA256 != Digest(launch)", "m.LaunchSHA256 != Digest(launch) && m.LaunchSHA256 != Digest(launch[:len(launch)-1])", "TestLaunchHashIncludesLF"},
+		{"M4-component-NFC-alias", "metadata.go", "old != prefix", "old != prefix && !strings.Contains(prefix,\"café\")", "TestMetadataNeighbors/NFD-components"},
+		{"M5-mode", "verify.go", "!modeMatches(before, want.Mode)", "!(want.Mode == \"0700\" || modeMatches(before, want.Mode))", "TestActualTreeRefusals/execute-mode"},
+		{"M5-extra", "verify.go", "if !ok {\n\t\t\treturn refuse(\"entry-set\")", "if !ok && p==\"home/extra\" { continue }; if !ok {\n\t\t\treturn refuse(\"entry-set\")", "TestActualTreeRefusals/extra-file"},
+		{"M6-saved-manifest", "verify.go", "if err := verifyEntries(dir, \"\", dirs, files); err != nil {", "if expected != \"\" { return &Verified{bytes.Clone(manifest),bytes.Clone(launch)},nil }; if err := verifyEntries(dir, \"\", dirs, files); err != nil {", "TestBaselineNeverRecaptured"},
+		{"M7-wrong-fixed-layer", "metadata.go", "d.MCP.Path != \"home/\"+c.Name+\".config.toml\"", "d.MCP.Path != \"home/\"+c.Name+\".config.toml\" && d.MCP.Path != \"home/AGENTS.md\"", "TestMetadataNeighbors/wrong-fixed-layer"},
+		{"M8-portable-version", "verify.go", "am.FragmentSHA256 = \"\"", "am.FragmentSHA256 = \"\"; am.CuratorVersion=bm.CuratorVersion", "TestPortableIdentity/version"},
+		{"M9-two-hardlinks", "fs_unix.go", "stat.Nlink == 1", "(stat.Nlink == 1 || stat.Nlink == 2)", "TestActualTreeRefusals/hardlink-outside"},
+	}
+	for _, m := range mutants {
+		t.Run(m.name, func(t *testing.T) {
+			scratch, err := os.MkdirTemp(filepath.Join(root, ".temp"), "snapshot-control-")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() {
+				if err := os.RemoveAll(scratch); err != nil {
+					t.Error(err)
+				}
+			}()
+			if err := filepath.WalkDir(".", func(p string, d fs.DirEntry, walkErr error) error {
+				if walkErr != nil {
+					return walkErr
+				}
+				if d.IsDir() {
+					if p != "." && strings.HasPrefix(d.Name(), ".") {
+						return filepath.SkipDir
+					}
+					return os.MkdirAll(filepath.Join(scratch, p), 0700)
+				}
+				if p != ".gitattributes" && !strings.HasSuffix(p, ".go") && !strings.HasPrefix(p, "schemas/") {
+					return nil
+				}
+				raw, err := os.ReadFile(p)
+				if err != nil {
+					return err
+				}
+				if p == "codec_test.go" {
+					raw = bytes.ReplaceAll(raw, []byte(strconv.Quote(corpus)), []byte(strconv.Quote(corpusPath)))
+				}
+				if p == m.file {
+					if m.name == "M10-UTF8-path-only" {
+						raw = bytes.Replace(raw, []byte(`"sync"`), []byte("\"sync\"\n\"strings\""), 1)
+					}
+					if bytes.Count(raw, []byte(m.old)) != 1 {
+						t.Fatalf("control target count %d", bytes.Count(raw, []byte(m.old)))
+					}
+					raw = bytes.Replace(raw, []byte(m.old), []byte(m.new), 1)
+					// The mode control keeps all other guards and permits only a 0700 asset
+					// observed as non-executable at both pre- and post-read mode checks.
+					if m.name == "M5-mode" {
+						raw = bytes.Replace(raw, []byte("!modeMatches(after, want.Mode)"), []byte("!(want.Mode == \"0700\" || modeMatches(after, want.Mode))"), 1)
+					}
+				}
+				return os.WriteFile(filepath.Join(scratch, p), raw, 0600)
+			}); err != nil {
+				t.Fatal(err)
+			}
+			cmd := exec.Command("go", "test", "-count=1", "-json", "-run", "^"+m.test+"$", scratch)
+			cmd.Dir = root
+			// The child runs only the killer and cannot recurse into this control suite.
+			output, runErr := cmd.CombinedOutput()
+			killed := false
+			for _, line := range bytes.Split(output, []byte{10}) {
+				var event struct{ Action, Test string }
+				if json.Unmarshal(line, &event) == nil && event.Action == "fail" && (event.Test == m.test || strings.HasPrefix(event.Test, m.test+"/")) {
+					killed = true
+				}
+			}
+			if runErr == nil || !killed {
+				sanitized := strings.ReplaceAll(strings.ReplaceAll(string(output), scratch, "<control>"), root, "<repository>")
+				t.Fatalf("survivor or invalid control: %v\n%s", runErr, sanitized)
+			}
+			t.Logf("%s: killed by %s; child exit 1", m.name, m.test)
+		})
+	}
+}
