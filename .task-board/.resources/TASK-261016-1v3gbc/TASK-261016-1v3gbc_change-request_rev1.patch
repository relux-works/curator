diff --git a/internal/envsnapshot/fs_unix.go b/internal/envsnapshot/fs_unix.go
new file mode 100644
index 0000000000000000000000000000000000000000..25187b5aab3dcd49d72ae14a484456c6446e60e2
--- /dev/null
+++ b/internal/envsnapshot/fs_unix.go
@@ -0,0 +1,72 @@
+//go:build darwin || linux || freebsd || openbsd || netbsd || dragonfly
+
+package envsnapshot
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+// Every component is opened relative to its retained parent, never resolving a
+// link. Nonblocking file opens prevent FIFO/device surprises from hanging reads.
+func openMember(parent *os.File, name string, directory bool) (*os.File, error) {
+	flags := unix.O_RDONLY | unix.O_CLOEXEC | unix.O_NOFOLLOW | unix.O_NONBLOCK
+	if directory {
+		flags |= unix.O_DIRECTORY
+	}
+	fd, err := unix.Openat(int(parent.Fd()), name, flags, 0)
+	if err != nil {
+		return nil, err
+	}
+	return os.NewFile(uintptr(fd), name), nil
+}
+func openDirectory(p string) (*os.File, error) {
+	if p == "" {
+		return nil, os.ErrInvalid
+	}
+	absolute := p
+	if !filepath.IsAbs(p) {
+		cwd, err := os.Getwd()
+		if err != nil {
+			return nil, err
+		}
+		// Preserve every caller component, including links before a parent segment.
+		absolute = cwd + string(filepath.Separator) + p
+	}
+	fd, err := unix.Open("/", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	current := os.NewFile(uintptr(fd), "/")
+	for _, part := range strings.Split(strings.TrimPrefix(absolute, "/"), "/") {
+		if part == "" {
+			continue
+		}
+		next, err := openMember(current, part, true)
+		_ = current.Close()
+		if err != nil {
+			return nil, err
+		}
+		current = next
+	}
+	return current, nil
+}
+func regularIndependent(info os.FileInfo) bool {
+	if info == nil || !info.Mode().IsRegular() {
+		return false
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	return ok && stat.Nlink == 1
+}
+func modeMatches(info os.FileInfo, mode string) bool {
+	want := os.FileMode(0600)
+	if mode == "0700" {
+		want = 0700
+	}
+	return info.Mode() == want
+}
+func directoryMode(info os.FileInfo) bool { return info != nil && info.Mode() == os.ModeDir|0700 }
diff --git a/internal/envsnapshot/metadata.go b/internal/envsnapshot/metadata.go
new file mode 100644
index 0000000000000000000000000000000000000000..ccf2dd7aa4194325c86914b9999ca9b80e073fc2
--- /dev/null
+++ b/internal/envsnapshot/metadata.go
@@ -0,0 +1,115 @@
+package envsnapshot
+
+import (
+	"reflect"
+	"strings"
+
+	"github.com/relux-works/curator/internal/contextpkg"
+	"github.com/relux-works/curator/internal/envregistry"
+	"github.com/relux-works/curator/internal/identifiers"
+	"golang.org/x/text/cases"
+	"golang.org/x/text/unicode/norm"
+)
+
+func collisionKey(s string) string { return cases.Fold().String(norm.NFC.String(s)) }
+
+// validateMetadata returns the exact derived directory inventory. It performs
+// semantic checks beyond the published structural schemas.
+func validateMetadata(m Manifest, d Descriptor, launch []byte) (map[string]bool, error) {
+	if m.Adapter != d.Environment || m.Profile != d.Profile {
+		return nil, refuse("adapter-profile")
+	}
+	if m.LaunchSHA256 != Digest(launch) {
+		return nil, refuse("launch-digest")
+	}
+	files := map[string]bool{}
+	components := map[string]string{}
+	dirs := map[string]bool{"home": true}
+	previous := ""
+	for _, f := range m.Files {
+		if !identifiers.PortablePath(f.Path) {
+			return nil, refuse("path-invalid")
+		}
+		if f.Path < previous {
+			return nil, refuse("path-order")
+		}
+		previous = f.Path
+		if files[f.Path] {
+			return nil, refuse("path-collision")
+		}
+		files[f.Path] = true
+		parts := strings.Split(f.Path, "/")
+		for i := 1; i <= len(parts); i++ {
+			prefix := strings.Join(parts[:i], "/")
+			key := collisionKey(prefix)
+			if old, ok := components[key]; ok && old != prefix {
+				return nil, refuse("path-collision")
+			}
+			components[key] = prefix
+			if i < len(parts) {
+				dirs[prefix] = true
+			}
+		}
+	}
+	for f := range files {
+		if dirs[f] {
+			return nil, refuse("file-ancestor")
+		}
+	}
+	if d.Environment == envregistry.Muse {
+		for _, p := range []string{"config", "data", "state", "cache"} {
+			dirs["home/"+p] = true
+		}
+		if (d.RootContext != nil) != files["home/config/muse/AGENTS.md"] {
+			return nil, refuse("root-context")
+		}
+	}
+	adapter, err := envregistry.ByID(d.Environment)
+	if err != nil {
+		return nil, refuse("adapter-profile")
+	}
+	if d.SystemPrompt != nil {
+		if !files[d.SystemPrompt.Path] {
+			return nil, refuse("channel-reference")
+		}
+		if !channelsEqual(d.SystemPrompt.Channels, adapter.SystemPrompt, true) {
+			return nil, refuse("channel-semantics")
+		}
+	}
+	if d.MCP != nil {
+		if !files[d.MCP.Path] {
+			return nil, refuse("channel-reference")
+		}
+		if adapter.MCP == nil || !channelsEqual(d.MCP.Channels, []envregistry.Channel{*adapter.MCP}, false) {
+			return nil, refuse("channel-semantics")
+		}
+		for i, name := range d.MCP.EnvNames {
+			if (i > 0 && name <= d.MCP.EnvNames[i-1]) || contextpkg.ReservedEnvName(name) {
+				return nil, refuse("channel-semantics")
+			}
+		}
+		// A named config layer must occupy the registered layer's fixed filename.
+		for _, c := range d.MCP.Channels {
+			if c.Kind == envregistry.KindFlag && c.Argument == envregistry.ArgumentName && d.MCP.Path != "home/"+c.Name+".config.toml" {
+				return nil, refuse("channel-reference")
+			}
+		}
+	}
+	return dirs, nil
+}
+
+func channelsEqual(got []Channel, want []envregistry.Channel, semantics bool) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for i, c := range want {
+		expected := Channel{Kind: c.Kind, Flag: c.Flag, Argument: c.Argument, Name: c.Name, With: c.With, Key: c.Key, Variable: c.Variable, Filename: c.Filename}
+		if semantics {
+			expected.Semantics = c.Semantics
+		}
+		if !reflect.DeepEqual(got[i], expected) {
+			return false
+		}
+	}
+	return true
+}
