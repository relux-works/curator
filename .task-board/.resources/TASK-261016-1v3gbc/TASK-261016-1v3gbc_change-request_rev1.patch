+        "driver": {"const": "go-repository-v1"},
+        "build_root": {"$ref": "#/$defs/rootOrPortablePath"},
+        "source_dir": {"$ref": "#/$defs/rootOrPortablePath"}
+      },
+      "additionalProperties": false
+    },
+    "repositoryStructuredRef": {
+      "oneOf": [
+        {
+          "type": "object",
+          "required": ["kind", "value"],
+          "properties": {
+            "kind": {"const": "revision"},
+            "value": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
+          },
+          "additionalProperties": false
+        },
+        {
+          "type": "object",
+          "required": ["kind", "value"],
+          "properties": {
+            "kind": {"enum": ["tag", "branch"]},
+            "value": {"$ref": "#/$defs/gitRefName"}
