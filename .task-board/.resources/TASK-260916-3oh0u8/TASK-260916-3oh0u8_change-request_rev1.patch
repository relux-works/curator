+
+func validProviderDir(dir string) bool {
+	length := utf8.RuneCountInString(dir)
+	if length < 1 || length > maxProviderDir {
+		return false
+	}
+	if strings.HasPrefix(dir, "/") {
+		return true
+	}
+	return providerDriveRE.MatchString(dir)
+}
