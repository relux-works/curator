+			t.Fatalf("state carries %q", key)
+		}
+	}
+	if _, _, err := materializeSSHWrapper(t.TempDir(), "relative/curator", policy); ErrorCode(err) != CodeIdentityInvalid {
+		t.Fatalf("relative wrapper source error = %v, want %s", err, CodeIdentityInvalid)
