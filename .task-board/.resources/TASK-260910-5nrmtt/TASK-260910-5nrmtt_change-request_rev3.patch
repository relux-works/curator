+	want := map[string]bool{"Wrapper": true, "SSH": true, "ExpectedHost": true, "RepositoryPath": true,
+		"EmptyConfig": true, "KnownHosts": true, "EmptyKnownHosts": true, "Identity": true,
+		"AgentSocket": true, "ConnectTimeout": true}
