+		t.Run(testCase.name, func(t *testing.T) {
+			var stdout, stderr bytes.Buffer
+			if code := RunSSHWrapper(testCase.args, getenv, strings.NewReader(""), &stdout, &stderr); code != 1 {
+				t.Fatalf("code = %d, want 1", code)
+			}
+			if stdout.Len() != 0 {
