+def _journal_from_dict(raw: object) -> Journal:
+    if not isinstance(raw, dict) or set(raw) != {
+        "schema",
+        "transaction_id",
+        "project_identity",
+        "phase",
+        "ordered_target_classes",
+        "generation_digests",
+        "targets",
+    }:
