   765	def _digest_file(digest: Any, path: Path, relative: str, info: os.stat_result) -> None:
   766	    _write_digest_entry(
   767	        digest, b"f", relative, stat.S_IMODE(info.st_mode), info.st_size
   768	    )
   769	    with path.open("rb") as handle:
   770	        while chunk := handle.read(1024 * 1024):
   771	            digest.update(chunk)
   772	        after = os.fstat(handle.fileno())
   773	    if (
   774	        not os.path.samestat(info, after)
   775	        or after.st_size != info.st_size
   776	        or stat.S_IMODE(after.st_mode) != stat.S_IMODE(info.st_mode)
   777	    ):
   778	        raise TransactionCorruptionError(
   779	            f"transaction target changed while digesting: {path}"
   780	        )
   781	    current = path.lstat()
   782	    if not os.path.samestat(after, current):
   783	        raise TransactionCorruptionError(
   784	            f"transaction target changed while digesting: {path}"
   785	        )
