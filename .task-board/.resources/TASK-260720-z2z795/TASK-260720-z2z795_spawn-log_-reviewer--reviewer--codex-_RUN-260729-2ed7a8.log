   175	// AcquireBuildKey takes the optional per-key deduplication lock. An operation
   176	// may use at most one key, and must release it before acquiring the home lock.
   177	func (operation *Operation) AcquireBuildKey(ctx context.Context, logicalKey string) error {
   178		if operation == nil || operation.manager == nil {
   179			return fmt.Errorf("manager operation is nil")
   180		}
   181		if operation.dryRun {
   182			return ErrDryRun
   183		}
   184		if logicalKey == "" || !utf8.ValidString(logicalKey) || strings.IndexByte(logicalKey, 0) >= 0 {
   185			return fmt.Errorf("logical build key is empty or invalid UTF-8")
   186		}
   187	
   188		operation.mu.Lock()
   189		defer operation.mu.Unlock()
   190		if operation.closed || len(operation.projects) == 0 || operation.buildKeyUsed || operation.home != nil {
   191			return orderError("build-key lock requires held project locks and may be used once before the home lock")
   192		}
   193		process := operation.manager.processState()
   194		if err := process.reserve(acquireBuildKey); err != nil {
   195			return err
   196		}
   197		acquired := false
   198		defer func() { process.finish(acquireBuildKey, acquired) }()
   199		lock, err := acquireFileLock(ctx, operation.manager.buildKeyLockPath(logicalKey), func() {
   200			process.released(acquireBuildKey)
   201		})
   202		if err != nil {
   203			return err
   204		}
   205		acquired = true
   206		operation.buildKey = lock
   207		operation.buildKeyUsed = true
   208		return nil
   209	}
