   235		if lock == nil {
   236			return ErrNotHeld
   237		}
   238		return lock.lock.AssertHeld()
   239	}
   240	
   241	// Close releases the operating-system lock without deleting its stable file.
   242	func (lock *HomeLock) Close() error {
   243		if lock == nil {
   244			return nil
   245		}
   246		return lock.lock.Close()
   247	}
