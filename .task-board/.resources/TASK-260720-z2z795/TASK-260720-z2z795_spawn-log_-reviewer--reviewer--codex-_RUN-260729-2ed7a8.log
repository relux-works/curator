   119	// AcquireProjects canonicalizes and sorts the complete batch before acquiring
   120	// it. Later batches are permitted only when every new identity follows the
   121	// last held identity, so an inversion fails before waiting on an OS lock.
   122	func (operation *Operation) AcquireProjects(ctx context.Context, projects ...string) ([]ProjectIdentity, error) {
   123		if operation == nil || operation.manager == nil {
   124			return nil, fmt.Errorf("manager operation is nil")
   125		}
   126		if operation.dryRun {
   127			return nil, ErrDryRun
   128		}
   129		identities, err := CanonicalProjects(projects...)
   130		if err != nil {
   131			return nil, err
   132		}
   133		if len(identities) == 0 {
   134			return nil, fmt.Errorf("at least one project lock is required")
   135		}
   136	
   137		operation.mu.Lock()
   138		defer operation.mu.Unlock()
   139		if operation.closed {
   140			return nil, orderError("operation is closed")
   141		}
   142		if operation.buildKeyUsed || operation.home != nil {
   143			return nil, orderError("project lock requested after a later lock class")
   144		}
