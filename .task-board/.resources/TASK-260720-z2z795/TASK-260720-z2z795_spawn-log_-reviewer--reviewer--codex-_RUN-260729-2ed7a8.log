   735	def digest_path(path: Path) -> str:
   736	    try:
   737	        info = path.lstat()
   738	    except FileNotFoundError:
   739	        return ABSENT_DIGEST
   740	    digest = hashlib.sha256(_DIGEST_DOMAIN)
   741	    if stat.S_ISREG(info.st_mode):
   742	        _digest_file(digest, path, "", info)
   743	    elif stat.S_ISDIR(info.st_mode) and not path.is_symlink():
   744	        _write_digest_entry(digest, b"d", "", stat.S_IMODE(info.st_mode), 0)
   745	        entries = sorted(
   746	            (entry for entry in path.rglob("*")),
   747	            key=lambda entry: _utf8_key(entry.relative_to(path).as_posix()),
   748	        )
   749	        for entry in entries:
   750	            entry_info = entry.lstat()
   751	            relative = entry.relative_to(path).as_posix()
   752	            if stat.S_ISDIR(entry_info.st_mode) and not entry.is_symlink():
   753	                _write_digest_entry(
   754	                    digest, b"d", relative, stat.S_IMODE(entry_info.st_mode), 0
   755	                )
   756	            elif stat.S_ISREG(entry_info.st_mode):
   757	                _digest_file(digest, entry, relative, entry_info)
   758	            else:
   759	                raise TransactionError(f"unsafe transaction tree entry: {entry}")
   760	    else:
   761	        raise TransactionError(f"unsafe transaction target: {path}")
   762	    return "sha256:" + digest.hexdigest()
