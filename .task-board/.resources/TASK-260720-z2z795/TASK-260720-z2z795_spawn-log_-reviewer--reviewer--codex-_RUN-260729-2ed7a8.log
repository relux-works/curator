   278		}
   279		acquired = true
   280		operation.home = &HomeLock{lock: fileLock}
   281		return operation.home, nil
   282	}
   283	
   284	// AcquireHomeOnly is the recovery/GC path. It acquires no project or key lock.
   285	// dryRun rejects the request without creating any manager state.
   286	func (manager *Manager) AcquireHomeOnly(ctx context.Context, dryRun bool) (*HomeLock, error) {
   287		if manager == nil {
   288			return nil, fmt.Errorf("manager is nil")
   289		}
   290		if dryRun {
   291			return nil, ErrDryRun
   292		}
   293		if err := manager.prepare(); err != nil {
   294			return nil, err
   295		}
   296		process := manager.processState()
   297		if err := process.reserve(acquireHome); err != nil {
   298			return nil, err
   299		}
   300		acquired := false
   301		defer func() { process.finish(acquireHome, acquired) }()
   302		fileLock, err := acquireFileLock(ctx, manager.homeLockPath(), func() {
   303			process.released(acquireHome)
   304		})
   305		if err != nil {
   306			return nil, err
   307		}
   308		acquired = true
   309		return &HomeLock{lock: fileLock}, nil
   310	}
   311	
   312	// Close releases held locks in reverse class and project order.
   313	func (operation *Operation) Close() error {
   314		if operation == nil {
   315			return nil
   316		}
   317		operation.mu.Lock()
   318		defer operation.mu.Unlock()
   319		if operation.closed {
   320			return nil
   321		}
   322		operation.closed = true
   323		var result error
   324		if operation.home != nil {
   325			result = errors.Join(result, operation.home.Close())
   326			operation.home = nil
   327		}
   328		if operation.buildKey != nil {
   329			result = errors.Join(result, operation.buildKey.Close())
   330			operation.buildKey = nil
   331		}
   332		for index := len(operation.projects) - 1; index >= 0; index-- {
   333			result = errors.Join(result, operation.projects[index].Close())
   334		}
   335		operation.projects = nil
   336		return result
   337	}
   338	
   339	func (manager *Manager) projectLockPath(identity ProjectIdentity) string {
   340		manager.mu.RLock()
   341		defer manager.mu.RUnlock()
   342		return filepath.Join(manager.lockRoot, "projects", lockName("project", string(identity)))
   343	}
   344	
   345	func (manager *Manager) buildKeyLockPath(logicalKey string) string {
   346		manager.mu.RLock()
   347		defer manager.mu.RUnlock()
   348		return filepath.Join(manager.lockRoot, "build", lockName("build-key", logicalKey))
   349	}
   350	
   351	func (manager *Manager) homeLockPath() string {
   352		manager.mu.RLock()
   353		defer manager.mu.RUnlock()
   354		return filepath.Join(manager.lockRoot, lockName("manager-home", manager.home))
   355	}
   356	
   357	func compareProject(left, right ProjectIdentity) int {
   358		leftBytes, rightBytes := []byte(left), []byte(right)
   359		for index := 0; index < len(leftBytes) && index < len(rightBytes); index++ {
   360			if leftBytes[index] < rightBytes[index] {
   361				return -1
   362			}
   363			if leftBytes[index] > rightBytes[index] {
   364				return 1
   365			}
   366		}
   367		switch {
   368		case len(leftBytes) < len(rightBytes):
   369			return -1
   370		case len(leftBytes) > len(rightBytes):
   371			return 1
   372		default:
   373			return 0
   374		}
   375	}
   376	
   377	func orderError(detail string) error {
   378		return fmt.Errorf("%w: %s", ErrLockOrder, detail)
   379	}
   380	
   381	type acquisitionKind uint8
   382	
   383	const (
   384		acquireProject acquisitionKind = iota
   385		acquireBuildKey
   386		acquireHome
   387	)
   388	
   389	type processState struct {
   390		mu             sync.Mutex
   391		projectPending int
   392		keyPending     int
   393		keysHeld       int
   394		homePending    int
   395		homesHeld      int
   396	}
   397	
   398	var processStates = struct {
   399		sync.Mutex
   400		byHome map[string]*processState
   401	}{byHome: map[string]*processState{}}
   402	
   403	func stateForHome(home string) *processState {
   404		processStates.Lock()
   405		defer processStates.Unlock()
   406		if state := processStates.byHome[home]; state != nil {
   407			return state
   408		}
   409		state := new(processState)
   410		processStates.byHome[home] = state
   411		return state
   412	}
   413	
   414	func (state *processState) reserve(kind acquisitionKind) error {
   415		state.mu.Lock()
   416		defer state.mu.Unlock()
   417		switch kind {
   418		case acquireProject:
   419			if state.homesHeld > 0 || state.homePending > 0 {
   420				return orderError("project lock requested while the process holds or is acquiring the home lock")
   421			}
   422			state.projectPending++
   423		case acquireBuildKey:
   424			if state.homesHeld > 0 || state.homePending > 0 {
   425				return orderError("build-key lock requested while the process holds or is acquiring the home lock")
   426			}
   427			state.keyPending++
   428		case acquireHome:
   429			if state.keysHeld > 0 || state.keyPending > 0 || state.projectPending > 0 {
   430				return orderError("home lock requested before an in-process project/key acquisition completed or key release")
   431			}
   432			state.homePending++
   433		}
   434		return nil
   435	}
   436	
   437	func (state *processState) finish(kind acquisitionKind, acquired bool) {
   438		state.mu.Lock()
   439		defer state.mu.Unlock()
   440		switch kind {
   441		case acquireProject:
   442			state.projectPending--
   443		case acquireBuildKey:
   444			state.keyPending--
   445			if acquired {
   446				state.keysHeld++
   447			}
   448		case acquireHome:
   449			state.homePending--
   450			if acquired {
   451				state.homesHeld++
   452			}
   453		}
   454	}
   455	
   456	func (state *processState) released(kind acquisitionKind) {
   457		state.mu.Lock()
   458		defer state.mu.Unlock()
   459		switch kind {
   460		case acquireBuildKey:
   461			if state.keysHeld > 0 {
   462				state.keysHeld--
   463			}
   464		case acquireHome:
   465			if state.homesHeld > 0 {
   466				state.homesHeld--
   467			}
   468		}
   469	}

