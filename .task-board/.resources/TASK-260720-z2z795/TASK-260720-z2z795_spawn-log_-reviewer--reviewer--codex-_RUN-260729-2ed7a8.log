+
+def _path_exists(path: Path) -> bool:
+    try:
+        path.lstat()
+    except FileNotFoundError:
+        return False
+    return True
+
+
+def _ensure_safe_directory(path: Path) -> None:
+    try:
+        info = path.lstat()
+    except FileNotFoundError:
