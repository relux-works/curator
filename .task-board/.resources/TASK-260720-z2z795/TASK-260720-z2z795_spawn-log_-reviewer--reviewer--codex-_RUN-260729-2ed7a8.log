   146			return nil, orderError("project identities are not strictly increasing")
   147		}
   148		if err := operation.manager.prepare(); err != nil {
   149			return nil, err
   150		}
   151		process := operation.manager.processState()
   152		if err := process.reserve(acquireProject); err != nil {
   153			return nil, err
   154		}
   155		acquired := false
   156		defer func() { process.finish(acquireProject, acquired) }()
   157	
   158		batch := make([]*fileLock, 0, len(identities))
   159		for _, identity := range identities {
   160			lock, acquireErr := acquireFileLock(ctx, operation.manager.projectLockPath(identity), nil)
   161			if acquireErr != nil {
