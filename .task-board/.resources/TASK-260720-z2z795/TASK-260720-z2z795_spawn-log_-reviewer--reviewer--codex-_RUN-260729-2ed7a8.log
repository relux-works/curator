   788	def _write_digest_entry(
   789	    digest: Any, kind: bytes, relative: str, mode: int, size: int
   790	) -> None:
   791	    encoded = relative.encode("utf-8", errors="strict")
   792	    digest.update(kind)
   793	    digest.update(struct.pack(">Q", len(encoded)))
   794	    digest.update(encoded)
   795	    digest.update(struct.pack(">IQ", mode, size))
