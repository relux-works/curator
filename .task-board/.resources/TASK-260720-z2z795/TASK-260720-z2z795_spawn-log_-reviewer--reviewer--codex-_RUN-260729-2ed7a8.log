    28	// Manager derives every lock path from one configured Curator home. New is
    29	// read-only; lock state is created lazily by a real acquisition.
    30	type Manager struct {
    31		mu             sync.RWMutex
    32		configuredHome string
    33		home           string
    34		lockRoot       string
    35		process        *processState
    36		prepared       bool
    37	}
    38	
    39	// New constructs a manager without creating filesystem state.
    40	func New(home string) (*Manager, error) {
    41		canonical, err := canonicalAbsolute(home, "manager home")
    42		if err != nil {
    43			return nil, err
    44		}
    45		configuredHome, err := filepath.Abs(home)
    46		if err != nil {
    47			return nil, fmt.Errorf("resolve manager home: %w", err)
    48		}
    49		configuredHome = filepath.Clean(configuredHome)
    50		return &Manager{
    51			configuredHome: configuredHome,
    52			home:           canonical,
    53			lockRoot:       filepath.Join(canonical, "state", "locks", "v1"),
    54			process:        stateForHome(canonical),
    55		}, nil
    56	}
    57	
    58	// Home is the canonical absolute configured Curator home.
    59	func (manager *Manager) Home() string {
    60		if manager == nil {
    61			return ""
    62		}
    63		manager.mu.RLock()
    64		defer manager.mu.RUnlock()
    65		return manager.home
    66	}
    67	
    68	// prepare creates the configured home for a real acquisition, then resolves
    69	// its now-observable physical identity before any process reservation or lock
    70	// path is selected. This closes the first-use gap on Windows, where case
    71	// sensitivity belongs to each directory and cannot be known for a
    72	// multi-component suffix until those directories exist. Dry-run paths never
    73	// call prepare.
    74	func (manager *Manager) prepare() error {
    75		manager.mu.Lock()
    76		defer manager.mu.Unlock()
    77		if manager.prepared {
    78			return nil
    79		}
    80		if err := os.MkdirAll(manager.configuredHome, 0o700); err != nil {
    81			return fmt.Errorf("create manager home: %w", err)
    82		}
    83		canonical, err := canonicalAbsolute(manager.configuredHome, "manager home")
    84		if err != nil {
    85			return err
    86		}
    87		manager.home = canonical
    88		manager.lockRoot = filepath.Join(canonical, "state", "locks", "v1")
    89		manager.process = stateForHome(canonical)
    90		manager.prepared = true
    91		return nil
    92	}
    93	
    94	func (manager *Manager) processState() *processState {
    95		manager.mu.RLock()
    96		defer manager.mu.RUnlock()
    97		return manager.process
    98	}
