    19	// CanonicalProject resolves path to a clean absolute project identity. Existing
    20	// symlinks are evaluated so aliases of one project contend on the same lock.
    21	func CanonicalProject(path string) (ProjectIdentity, error) {
    22		canonical, err := canonicalAbsolute(path, "project path")
    23		if err != nil {
    24			return "", err
    25		}
    26		return ProjectIdentity(canonical), nil
    27	}
