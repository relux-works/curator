    started = threading.Event()
    release = threading.Event()
    errors: list[Exception] = []

    def hold_home() -> None:
        try:
            with ManagerHomeLock(home):
                started.set()
                release.wait(timeout=2)
        except Exception as exc:  # noqa: BLE001 - surface worker failures in the parent test
            errors.append(exc)

