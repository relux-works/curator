from __future__ import annotations

import tempfile
import threading
from pathlib import Path

from csk.locking import LockOrderError, ManagerHomeLock, ProjectLock


def probe_reentrant_cleanup() -> None:
    with tempfile.TemporaryDirectory(prefix=\"csk-review-reentrant-\") as raw:
        root = Path(raw)
        home = root / \"home\"
        held = ManagerHomeLock(home, timeout=1)
        worker_result: list[str] = []
        with held:
            try:
                held.__enter__()
            except LockOrderError as exc:
                print(f\"reentrant_error={type(exc).__name__}:{exc}\")
            else:
                print(\"reentrant_error=MISSING\")

            def acquire_project() -> None:
                try:
                    with ProjectLock(home, root / \"project\", timeout=0.2):
                        worker_result.append(\"PROJECT_ACQUIRED_UNDER_HELD_HOME\")
                except Exception as exc:
                    worker_result.append(f\"PROJECT_REJECTED:{type(exc).__name__}:{exc}\")

            worker = threading.Thread(target=acquire_project)
            worker.start()
            worker.join(timeout=2)
            print(f\"reentrant_worker_alive={worker.is_alive()}\")
            print(f\"reentrant_worker_result={worker_result}\")


def probe_release_handoff() -> None:
    with tempfile.TemporaryDirectory(prefix=\"csk-review-handoff-\") as raw:
        root = Path(raw)
        home = root / \"home\"
        release_registry = threading.Event()
        entered_release = threading.Event()
        first_ready = threading.Event()
        release_first = threading.Event()
        results: list[str] = []

        class GatedReleaseHomeLock(ManagerHomeLock):
            def _record_released(self) -> None:
                entered_release.set()
                if not release_registry.wait(timeout=2):
                    results.append(\"FIRST_RELEASE_GATE_TIMEOUT\")
                super()._record_released()

        def first_consumer() -> None:
            try:
                with GatedReleaseHomeLock(home, timeout=1):
                    first_ready.set()
                    release_first.wait(timeout=2)
            except Exception as exc:
                results.append(f\"FIRST_ERROR:{type(exc).__name__}:{exc}\")

        def second_consumer() -> None:
            try:
                with ManagerHomeLock(home, timeout=1):
                    results.append(\"SECOND_ACQUIRED\")
            except Exception as exc:
                results.append(f\"SECOND_ERROR:{type(exc).__name__}:{exc}\")

        first = threading.Thread(target=first_consumer)
        first.start()
        assert first_ready.wait(timeout=2)
        release_first.set()
        assert entered_release.wait(timeout=2)
        second = threading.Thread(target=second_consumer)
        second.start()
        second.join(timeout=2)
        release_registry.set()
        first.join(timeout=2)
        print(f\"handoff_threads_alive={[first.is_alive(), second.is_alive()]}\")
        print(f\"handoff_results={results}\")


probe_reentrant_cleanup()
probe_release_handoff()
