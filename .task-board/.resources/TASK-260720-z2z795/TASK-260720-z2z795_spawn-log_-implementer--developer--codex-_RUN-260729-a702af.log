   100	def test_windows_journal_state_transitions_use_write_through_moves(
   101	    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
   102	):
   103	    home = tmp_path / "home"
   104	    live = _write(tmp_path / "live", "old")
   105	    desired = _write(tmp_path / "desired", "new")
   106	    engine = TransactionEngine(home)
   107	    journal, _ = engine._build_journal(
   108	        _plan(
   109	            "txn-windows-routing",
   110	            tmp_path / "project",
   111	            _target("10-context", "skill", live, desired),
   112	        )
   113	    )
   114	    moves: list[tuple[Path, Path, int]] = []
   115	    synced_directories: list[Path] = []
   116	
   117	    def move_file(source: Path, destination: Path, flags: int) -> None:
   118	        moves.append((source, destination, flags))
   119	        if flags & transactions._MOVEFILE_REPLACE_EXISTING:
   120	            source.replace(destination)
   121	        else:
   122	            if destination.exists():
   123	                raise FileExistsError(destination)
   124	            source.rename(destination)
   125	
   126	    monkeypatch.setattr(transactions, "_is_windows", lambda: True)
   127	    monkeypatch.setattr(transactions, "_windows_move_file", move_file)
   128	    monkeypatch.setattr(
   129	        transactions,
   130	        "_windows_sync_directory",
   131	        lambda path: synced_directories.append(path),
   132	    )
   133	
   134	    engine._save_journal(journal, create=True)
   135	    journal.phase = "prepared"
   136	    engine._save_journal(journal)
   137	    engine._remove_journal(journal)
   138	
   139	    assert [flags for _, _, flags in moves] == [
   140	        transactions._MOVEFILE_WRITE_THROUGH,
   141	        (
   142	            transactions._MOVEFILE_REPLACE_EXISTING
   143	            | transactions._MOVEFILE_WRITE_THROUGH
   144	        ),
   145	        transactions._MOVEFILE_WRITE_THROUGH,
   146	    ]
   147	    assert all(source.parent == engine.journal_root for source, _, _ in moves)
   148	    assert all(destination.parent == engine.journal_root for _, destination, _ in moves)
   149	    assert synced_directories
   150	    assert engine.journal_root in synced_directories
   151	    assert not (engine.journal_root / "txn-windows-routing.json").exists()
   152	    assert not (engine.journal_root / "txn-windows-routing.json.delete").exists()
