   176	                _target("10-context", "skill", live, desired),
   177	            ),
   178	        )
   179	        with pytest.raises(SimulatedCrash, match="journal_tombed"):
   180	            engine.commit(lock, "txn-journal-tomb")
   181	
   182	    assert live.read_text(encoding="utf-8") == ("old" if rollback else "new")
   183	    assert not (engine.journal_root / "txn-journal-tomb.json").exists()
   184	    assert (engine.journal_root / "txn-journal-tomb.json.delete").exists()
   185	
   186	    with ManagerHomeLock(home) as lock:
   187	        TransactionEngine(home).recover(lock)
   188	
   189	    assert live.read_text(encoding="utf-8") == ("old" if rollback else "new")
   190	    assert not (engine.journal_root / "txn-journal-tomb.json").exists()
   191	    assert not (engine.journal_root / "txn-journal-tomb.json.delete").exists()
   192	    assert not any(live.parent.glob(".csk-txn-*"))
