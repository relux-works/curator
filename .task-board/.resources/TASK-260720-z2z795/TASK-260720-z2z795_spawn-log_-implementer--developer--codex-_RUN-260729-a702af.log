   236	        ] == [
   237	            ("10-context", "z"),
   238	            ("10-context", "é"),
   239	            ("90-consumer", "ledger"),
   240	        ]
   241	        assert raw["transaction_id"] == "txn-order"
   242	        assert raw["project_identity"] == str(project.resolve())
   243	        assert raw["generation_digests"] == {"runtime/default": "sha256:" + "a" * 64}
   244	        assert all(target["backup_path"] for target in raw["targets"])
   245	        assert all(
   246	            target["desired_digest"].startswith("sha256:") for target in raw["targets"]
   247	        )
   248	        assert all(target["state"] == "pending" for target in raw["targets"])
   249	        engine.commit(lock, "txn-order")
   250	
   251	    assert events[-1] == ("90-consumer", "ledger")
   252	    assert backups_present_at_consumer_commit == [True]
   253	    assert live_a.read_text(encoding="utf-8") == "new-a"
   254	    assert live_b.read_text(encoding="utf-8") == "new-b"
   255	    assert ledger.read_text(encoding="utf-8") == '["project"]'
   256	    assert not (engine.journal_root / "txn-order.json").exists()
