    57	@pytest.mark.parametrize("kind", ["file", "directory"])
    58	def test_native_no_replace_preserves_destination_created_at_mutation_boundary(
    59	    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, kind: str
    60	):
    61	    source = tmp_path / "source"
    62	    destination = tmp_path / "destination"
    63	    if kind == "file":
    64	        _write(source, "transaction")
    65	    else:
    66	        _write(source / "payload", "transaction")
    67	    native_rename = transactions._native_rename_no_replace
    68	
    69	    def create_competitor_then_rename(
    70	        current_source: Path, current_destination: Path
    71	    ) -> None:
    72	        assert current_source == source
    73	        assert current_destination == destination
    74	        if kind == "file":
    75	            _write(destination, "competing-success")
    76	        else:
    77	            _write(destination / "payload", "competing-success")
    78	        native_rename(current_source, current_destination)
    79	
    80	    monkeypatch.setattr(
    81	        transactions, "_native_rename_no_replace", create_competitor_then_rename
    82	    )
    83	
    84	    with pytest.raises(
    85	        TransactionCorruptionError, match="transaction destination exists"
    86	    ):
    87	        transactions._rename_no_replace(source, destination)
    88	
    89	    assert source.exists()
    90	    if kind == "file":
    91	        assert source.read_text(encoding="utf-8") == "transaction"
    92	        assert destination.read_text(encoding="utf-8") == "competing-success"
    93	    else:
    94	        assert (source / "payload").read_text(encoding="utf-8") == "transaction"
    95	        assert (destination / "payload").read_text(
    96	            encoding="utf-8"
    97	        ) == "competing-success"
