   731	    def _remove_journal(self, journal: Journal) -> None:
   732	        self._validate_journal_removal_ready(journal)
   733	        path = self._journal_path(journal.transaction_id)
   734	        tomb = self._journal_tomb_path(journal.transaction_id)
   735	        path_exists = _path_exists(path)
   736	        tomb_exists = _path_exists(tomb)
   737	        if path_exists and tomb_exists:
   738	            raise TransactionCorruptionError(
   739	                f"transaction has both journal and removal tomb: {journal.transaction_id}"
   740	            )
   741	        expected = _journal_bytes(journal)
   742	        if path_exists:
   743	            if _read_bounded_regular(path, limit=16 * 1024 * 1024) != expected:
   744	                raise TransactionCorruptionError(
   745	                    f"journal changed before removal: {journal.transaction_id}"
   746	                )
   747	            try:
   748	                _durable_journal_publish_no_replace(path, tomb)
   749	            except FileExistsError as exc:
   750	                raise TransactionCorruptionError(
   751	                    f"transaction removal tomb already exists: {journal.transaction_id}"
   752	                ) from exc
   753	            self._emit("journal_tombed", None)
   754	            tomb_exists = True
   755	        if not tomb_exists:
   756	            raise TransactionCorruptionError(
   757	                f"transaction journal disappeared during removal: {journal.transaction_id}"
   758	            )
   759	        if _read_bounded_regular(tomb, limit=16 * 1024 * 1024) != expected:
   760	            raise TransactionCorruptionError(
   761	                f"journal tomb changed before removal: {journal.transaction_id}"
   762	            )
