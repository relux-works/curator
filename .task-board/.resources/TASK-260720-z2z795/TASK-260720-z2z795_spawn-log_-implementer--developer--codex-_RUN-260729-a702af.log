    28	def _write(path: Path, value: str) -> Path:
    29	    path.parent.mkdir(parents=True, exist_ok=True)
    30	    path.write_text(value, encoding="utf-8")
    31	    return path
    32	
    33	
    34	def _target(
    35	    target_class: str, identifier: str, live: Path, desired: Path | None
    36	) -> MutableTarget:
    37	    return MutableTarget(
    38	        target_class=target_class,
    39	        identifier=identifier,
    40	        live_path=live,
    41	        desired_path=desired,
    42	        expected_preimage_digest=digest_path(live),
    43	    )
    44	
    45	
    46	def _plan(
    47	    transaction_id: str, project: Path, *targets: MutableTarget
    48	) -> TransactionPlan:
    49	    return TransactionPlan(
    50	        transaction_id=transaction_id,
    51	        project_identity=str(project.resolve()),
    52	        targets=tuple(targets),
    53	        generation_digests={"runtime/default": "sha256:" + "a" * 64},
    54	    )
