   202	    backups_present_at_consumer_commit: list[bool] = []
   203	
   204	    def observe(point: str, target: JournalTarget | None) -> None:
   205	        if point == "target_committed" and target is not None:
   206	            events.append((target.target_class, target.identifier))
   207	            if target.target_class == "90-consumer":
   208	                backups_present_at_consumer_commit.append(
