   169	    engine = TransactionEngine(home, fault_hook=crash_after_tomb)
   170	    with ManagerHomeLock(home) as lock:
   171	        engine.prepare(
   172	            lock,
   173	            _plan(
   174	                "txn-journal-tomb",
