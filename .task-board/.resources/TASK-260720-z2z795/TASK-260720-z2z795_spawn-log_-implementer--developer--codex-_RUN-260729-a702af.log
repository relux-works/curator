   770	    def _validate_journal_removal_ready(self, journal: Journal) -> None:
   771	        states = {target.state for target in journal.targets}
   772	        if journal.phase in {"preparing", "prepared"}:
   773	            ready = states == {"pending"}
   774	        elif journal.phase == "cleanup":
   775	            ready = states == {"committed"}
   776	        elif journal.phase == "rolling_back":
   777	            ready = states <= {"pending", "rolled_back"}
   778	        else:
   779	            ready = False
   780	        if not ready:
   781	            raise TransactionCorruptionError(
   782	                f"journal is not ready for durable removal: {journal.transaction_id}"
   783	            )
