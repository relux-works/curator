   496	        path = self._journal_path(journal.transaction_id)
   497	        tomb = self._journal_tomb_path(journal.transaction_id)
   498	        if _path_exists(tomb):
   499	            raise TransactionCorruptionError(
   500	                f"transaction removal is already in progress: {journal.transaction_id}"
   501	            )
