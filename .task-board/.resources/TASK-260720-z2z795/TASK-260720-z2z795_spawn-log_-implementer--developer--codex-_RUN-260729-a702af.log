   155	@pytest.mark.parametrize("rollback", [False, True])
   156	def test_recovery_finishes_interrupted_journal_removal_tomb(
   157	    tmp_path: Path, rollback: bool
   158	):
   159	    home = tmp_path / "home"
   160	    live = _write(tmp_path / "live", "old")
   161	    desired = _write(tmp_path / "desired", "new")
   162	
   163	    def crash_after_tomb(point: str, target: JournalTarget | None) -> None:
   164	        if rollback and point == "target_committed":
   165	            raise RuntimeError("force rollback")
   166	        if point == "journal_tombed":
