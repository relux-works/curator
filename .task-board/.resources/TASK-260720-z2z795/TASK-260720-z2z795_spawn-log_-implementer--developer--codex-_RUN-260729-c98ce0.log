+        release.set()
+        thread.join(timeout=2)
+    assert not errors
+    assert not thread.is_alive()
+
+
+def test_build_lock_requires_project_and_only_one_key(tmp_path: Path):
+    home = tmp_path / "home"
+    with pytest.raises(LockOrderError, match="requires"), BuildLock(home, "first"):
+        pass
+    with ProjectLock(home, tmp_path / "project"), BuildLock(home, "first"):
+        with pytest.raises(LockOrderError, match="at most one"):
+            with BuildLock(home, "second"):
