+    def _journal_ids(self) -> list[str]:
+        if not self.journal_root.exists():
+            return []
+        ids: list[str] = []
+        for path in self.journal_root.iterdir():
+            if path.suffix != ".json" or not path.is_file() or path.is_symlink():
+                continue
+            transaction_id = path.stem
+            if not _TRANSACTION_ID.fullmatch(transaction_id):
+                raise TransactionCorruptionError(f"invalid journal filename: {path.name}")
+            ids.append(transaction_id)
+        return sorted(ids, key=_utf8_key)
