 from __future__ import annotations
 
+import hashlib
 import json
 import os
+import threading
 import time
+import uuid
 from pathlib import Path
 from types import TracebackType
+from typing import Self
 
 
 class LockError(Exception):
     pass
 
 
-class GlobalLock:
