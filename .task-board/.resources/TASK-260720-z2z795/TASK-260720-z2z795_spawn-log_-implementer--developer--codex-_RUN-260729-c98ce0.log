+def test_direct_project_lock_rejects_noncanonical_acquisition_order(tmp_path: Path):
+    home = tmp_path / "home"
+    identities = sorted((tmp_path / "a", tmp_path / "z"), key=lambda path: unsigned_utf8_key(canonical_project_identity(path)))
+
