		{Class: "class", Identifier: "a-create", LivePath: createdLive, StagedSource: createdSource, PreimageDigest: DigestAbsent},
		{Class: "class", Identifier: "b-remove", LivePath: removedLive, PreimageDigest: removedDigest},
	}
