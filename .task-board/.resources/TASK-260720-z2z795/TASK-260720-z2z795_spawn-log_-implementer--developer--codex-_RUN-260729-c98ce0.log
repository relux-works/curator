+    def __init__(self, csk_home: Path, key: str, *, timeout: float | None = None):
+        self.key = unsigned_utf8_key(key)
+        digest = hashlib.sha256(b"csk-build-lock-v1\0" + self.key).hexdigest()
+        super().__init__(
