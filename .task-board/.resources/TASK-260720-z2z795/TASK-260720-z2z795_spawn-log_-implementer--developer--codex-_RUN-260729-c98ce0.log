+    identities = sorted(
+        (tmp_path / "a", tmp_path / "z"),
+        key=lambda path: unsigned_utf8_key(canonical_project_identity(path)),
+    )
+
+    with ProjectLock(home, identities[1]):
+        with pytest.raises(LockOrderError, match="unsigned UTF-8"):
+            with ProjectLock(home, identities[0]):
