+            process_home = _PROCESS_HOME
+        if process_home is not None:
+            raise LockOrderError(
+                "a project lock cannot be acquired while the manager-home lock is held"
+            )
+        if _STATE.home is not None:
+            raise LockOrderError(
+                "a project lock cannot be acquired while the manager-home lock is held"
+            )
+        if _STATE.build is not None:
