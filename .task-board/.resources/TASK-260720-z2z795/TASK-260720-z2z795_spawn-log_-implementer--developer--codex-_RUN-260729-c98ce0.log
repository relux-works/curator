+
+    def _record_released(self) -> None:
+        if _STATE.home is self:
+            _STATE.home = None
+
+    def assert_held(self) -> None:
+        if _STATE.home is not self:
+            raise LockError("manager-home lock is not held by this execution thread")
+        super().assert_held()
