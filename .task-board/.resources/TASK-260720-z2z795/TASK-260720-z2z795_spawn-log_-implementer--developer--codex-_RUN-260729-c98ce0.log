+        temporary = self.journal_root / f".{journal.transaction_id}.{os.getpid()}.tmp"
+        payload = _journal_bytes(journal)
+        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+        fd = os.open(temporary, flags, 0o600)
+        try:
