+def test_commit_failure_rolls_back_in_exact_reverse_commit_order(tmp_path: Path):
+    home = tmp_path / "home"
+    restored: list[str] = []
+
+    def fail_last(point: str, target: JournalTarget | None) -> None:
+        if point == "after_restore" and target is not None:
