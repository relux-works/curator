+def _digest_file(digest: Any, path: Path, relative: str, info: os.stat_result) -> None:
+    _write_digest_entry(digest, b"f", relative, stat.S_IMODE(info.st_mode), info.st_size)
+    with path.open("rb") as handle:
+        while chunk := handle.read(1024 * 1024):
+            digest.update(chunk)
+        after = os.fstat(handle.fileno())
+    if after.st_size != info.st_size or stat.S_IMODE(after.st_mode) != stat.S_IMODE(info.st_mode):
+        raise TransactionCorruptionError(f"transaction target changed while digesting: {path}")
