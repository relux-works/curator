+    def __init__(self, csk_home: Path, projects: list[Path] | tuple[Path, ...], *, timeout: float | None = None):
+        by_identity = {canonical_project_identity(project): project for project in projects}
+        identities = sorted(by_identity, key=unsigned_utf8_key)
+        self.locks = [ProjectLock(csk_home, by_identity[identity], timeout=timeout) for identity in identities]
+
+    def __enter__(self) -> Self:
+        acquired: list[ProjectLock] = []
+        try:
+            for lock in self.locks:
+                lock.__enter__()
+                acquired.append(lock)
+        except BaseException:
+            for lock in reversed(acquired):
+                lock.__exit__(None, None, None)
+            raise
+        return self
+
+    def __exit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc: BaseException | None,
+        tb: TracebackType | None,
+    ) -> None:
+        for lock in reversed(self.locks):
+            lock.__exit__(exc_type, exc, tb)
