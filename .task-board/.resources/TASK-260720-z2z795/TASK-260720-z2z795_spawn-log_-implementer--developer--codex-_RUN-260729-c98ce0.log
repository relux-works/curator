+
+    def _record_acquired(self) -> None:
+        with _PROCESS_STATE_GUARD:
+            if _PROCESS_HOME is not None:
+                raise LockOrderError(
+                    "a cache-build lock cannot be acquired while the manager-home lock is held"
+                )
