   109	type preparationDurabilityCase struct {
   110		name   string
   111		target func(*testing.T, string) Target
   112	}
   113	
   114	func preparationDurabilityCases() []preparationDurabilityCase {
   115		return []preparationDurabilityCase{
   116			{
   117				name: "regular file",
   118				target: func(t *testing.T, root string) Target {
   119					return fileTarget(t, "class", "file", filepath.Join(root, "live", "file"), filepath.Join(root, "stage", "file"), "old", "new")
   120				},
   121			},
   122			{
   123				name: "directory",
   124				target: func(t *testing.T, root string) Target {
   125					live := filepath.Join(root, "live", "directory")
   126					source := filepath.Join(root, "stage", "directory")
   127					mustWrite(t, filepath.Join(live, "bin", "tool"), "old")
   128					mustWrite(t, filepath.Join(source, "bin", "tool"), "new")
   129					preimage, err := DigestPath(live)
   130					if err != nil {
   131						t.Fatal(err)
   132					}
   133					return Target{Class: "class", Identifier: "directory", LivePath: live, StagedSource: source, PreimageDigest: preimage}
   134				},
   135			},
   136		}
   137	}

