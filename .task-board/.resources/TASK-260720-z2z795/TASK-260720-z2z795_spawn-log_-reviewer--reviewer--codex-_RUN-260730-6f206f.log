release_first = threading.Event()
first_call = True
real_record_check = locking._record_allows_stable_takeover

def gated_record_check(fd: int) -> bool:
    global first_call
    if first_call:
        first_call = False
        entered_record_check.set()
        if not resume_record_check.wait(5):
            raise RuntimeError('probe barrier timed out')
