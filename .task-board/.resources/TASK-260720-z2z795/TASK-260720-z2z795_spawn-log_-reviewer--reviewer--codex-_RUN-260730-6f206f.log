    10	func TestPrepareSyncsStagedParentBeforePreparedJournal(t *testing.T) {
    11		for _, testCase := range preparationDurabilityCases() {
    12			t.Run(testCase.name, func(t *testing.T) {
    13				root := t.TempDir()
    14				home := filepath.Join(root, "home")
    15				target := testCase.target(t, root)
    16				engine := mustEngine(t, home)
    17				observed := false
    18				engine.syncStagedParent = func(parent string) error {
    19					observed = true
    20					journal, err := engine.loadJournal("txn-stage-durable")
    21					if err != nil {
    22						t.Fatalf("load journal at staged-parent sync: %v", err)
    23					}
    24					if journal.Phase != PhasePreparing {
    25						t.Fatalf("journal phase at staged-parent sync = %q, want %q", journal.Phase, PhasePreparing)
    26					}
    27					staged := journal.Targets[0].StagedPath
    28					if parent != filepath.Dir(staged) {
    29						t.Fatalf("staged parent sync path = %q, want %q", parent, filepath.Dir(staged))
    30					}
    31					got, err := DigestPath(staged)
    32					if err != nil {
    33						t.Fatalf("digest staged target before parent sync: %v", err)
    34					}
    35					if got != journal.Targets[0].DesiredDigest {
    36						t.Fatalf("staged digest before parent sync = %q, want %q", got, journal.Targets[0].DesiredDigest)
    37					}
    38					return syncDirectory(parent)
    39				}
    40	
    41				journal, err := engine.Prepare(testLock{}, Plan{
    42					TransactionID:   "txn-stage-durable",
    43					ProjectIdentity: "/project",
    44					Targets:         []Target{target},
    45				})
    46				if err != nil {
    47					t.Fatal(err)
    48				}
    49				if !observed {
    50					t.Fatal("staged parent durability primitive was not called")
    51				}
    52				if journal.Phase != PhasePrepared {
    53					t.Fatalf("returned journal phase = %q, want %q", journal.Phase, PhasePrepared)
    54				}
    55			})
    56		}
    57	}
    58	
    59	func TestPrepareStagedParentSyncFailureDoesNotPublishPreparedJournal(t *testing.T) {
    60		for _, testCase := range preparationDurabilityCases() {
    61			t.Run(testCase.name, func(t *testing.T) {
    62				root := t.TempDir()
    63				home := filepath.Join(root, "home")
    64				target := testCase.target(t, root)
    65				preimage, err := DigestPath(target.LivePath)
    66				if err != nil {
    67					t.Fatal(err)
    68				}
    69				engine := mustEngine(t, home)
    70				injected := errors.New("staged parent sync failed")
    71				called := false
    72				engine.syncStagedParent = func(string) error {
    73					called = true
    74					journal, err := engine.loadJournal("txn-stage-sync-failure")
    75					if err != nil {
    76						t.Fatalf("load journal at failed staged-parent sync: %v", err)
    77					}
    78					if journal.Phase != PhasePreparing {
    79						t.Fatalf("journal phase at failed staged-parent sync = %q, want %q", journal.Phase, PhasePreparing)
    80					}
    81					return injected
    82				}
    83	
    84				_, err = engine.Prepare(testLock{}, Plan{
    85					TransactionID:   "txn-stage-sync-failure",
    86					ProjectIdentity: "/project",
    87					Targets:         []Target{target},
    88				})
    89				if !errors.Is(err, injected) {
    90					t.Fatalf("prepare error = %v, want staged parent sync failure", err)
    91				}
    92				if !called {
    93					t.Fatal("staged parent durability primitive was not called")
    94				}
    95				if _, err := os.Lstat(engine.journalPath("txn-stage-sync-failure")); !os.IsNotExist(err) {
    96					t.Fatalf("failed staging exposed a journal: %v", err)
    97				}
    98				if got, err := DigestPath(target.LivePath); err != nil || got != preimage {
    99					t.Fatalf("failed staging changed live target: digest %q, error %v; want %q", got, err, preimage)
   100				}
   101				staged := sidecarPath(target.LivePath, "txn-stage-sync-failure", 0, "desired")
   102				if _, err := os.Lstat(staged); !os.IsNotExist(err) {
   103					t.Fatalf("failed staging left sidecar %q: %v", staged, err)
   104				}
   105			})
   106		}
   107	}
