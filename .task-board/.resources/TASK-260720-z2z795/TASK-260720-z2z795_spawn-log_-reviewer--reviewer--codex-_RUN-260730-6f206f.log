     3	package managerlock
     4	
     5	import (
     6		"errors"
     7		"os"
     8	
     9		"golang.org/x/sys/unix"
    10	)
    11	
    12	func tryFileLock(file *os.File) (bool, error) {
    13		err := unix.Flock(int(file.Fd()), unix.LOCK_EX|unix.LOCK_NB)
    14		if err == nil {
    15			return true, nil
    16		}
    17		if errors.Is(err, unix.EWOULDBLOCK) || errors.Is(err, unix.EAGAIN) {
    18			return false, nil
    19		}
    20		return false, err
    21	}
    22	
    23	func unlockFile(file *os.File) error {
    24		return unix.Flock(int(file.Fd()), unix.LOCK_UN)
    25	}
     1	//go:build windows
     2	
     3	package managerlock
     4	
     5	import (
     6		"errors"
     7		"os"
     8	
     9		"golang.org/x/sys/windows"
    10	)
    11	
    12	func tryFileLock(file *os.File) (bool, error) {
    13		overlapped := new(windows.Overlapped)
    14		err := windows.LockFileEx(
    15			windows.Handle(file.Fd()),
    16			windows.LOCKFILE_EXCLUSIVE_LOCK|windows.LOCKFILE_FAIL_IMMEDIATELY,
    17			0,
    18			1,
    19			0,
    20			overlapped,
    21		)
    22		if err == nil {
    23			return true, nil
    24		}
    25		if errors.Is(err, windows.ERROR_LOCK_VIOLATION) {
    26			return false, nil
    27		}
    28		return false, err
    29	}
    30	
    31	func unlockFile(file *os.File) error {
    32		overlapped := new(windows.Overlapped)
    33		return windows.UnlockFileEx(windows.Handle(file.Fd()), 0, 1, 0, overlapped)
    34	}
     1	package managerlock
     2	
     3	import (
     4		"bytes"
     5		"crypto/sha256"
     6		"encoding/hex"
     7		"fmt"
     8		"os"
     9		"path/filepath"
    10		"sort"
    11		"strings"
    12		"unicode/utf8"
    13	)
    14	
    15	// ProjectIdentity is the canonical absolute identity used to order and name a
    16	// project operation lock. Its UTF-8 bytes are the ordering key.
    17	type ProjectIdentity string
    18	
    19	// CanonicalProject resolves path to a clean absolute project identity. Existing
    20	// symlinks are evaluated so aliases of one project contend on the same lock.
    21	func CanonicalProject(path string) (ProjectIdentity, error) {
    22		canonical, err := canonicalAbsolute(path, "project path")
    23		if err != nil {
    24			return "", err
    25		}
    26		return ProjectIdentity(canonical), nil
    27	}
    28	
    29	// CanonicalProjects returns unique canonical identities in unsigned UTF-8 byte
    30	// order. Duplicate physical or textual project identities are rejected.
    31	func CanonicalProjects(paths ...string) ([]ProjectIdentity, error) {
    32		identities := make([]ProjectIdentity, 0, len(paths))
    33		for _, path := range paths {
    34			identity, err := CanonicalProject(path)
    35			if err != nil {
    36				return nil, err
    37			}
    38			identities = append(identities, identity)
    39		}
    40		sort.Slice(identities, func(i, j int) bool {
    41			return bytes.Compare([]byte(identities[i]), []byte(identities[j])) < 0
    42		})
    43		for index := 1; index < len(identities); index++ {
    44			if identities[index-1] == identities[index] {
    45				return nil, fmt.Errorf("duplicate canonical project identity %q", identities[index])
    46			}
    47		}
    48		return identities, nil
    49	}
    50	
    51	func canonicalAbsolute(path, label string) (string, error) {
    52		if path == "" {
    53			return "", fmt.Errorf("%s is empty", label)
    54		}
    55		if !utf8.ValidString(path) || strings.IndexByte(path, 0) >= 0 {
    56			return "", fmt.Errorf("%s is not valid UTF-8 filesystem text", label)
    57		}
    58		absolute, err := filepath.Abs(path)
    59		if err != nil {
    60			return "", fmt.Errorf("resolve %s: %w", label, err)
    61		}
    62		absolute = filepath.Clean(absolute)
    63		resolved, err := filepath.EvalSymlinks(absolute)
    64		if err == nil {
    65			return canonicalWithExistingPrefix(filepath.Clean(resolved), nil, label)
    66		}
    67		if !os.IsNotExist(err) {
    68			return "", fmt.Errorf("resolve %s symlinks: %w", label, err)
    69		}
    70	
    71		// A first mutation may address a not-yet-created manager home. Resolve the
    72		// longest existing prefix so its identity does not change after the missing
    73		// suffix is created through a symlinked ancestor.
    74		prefix := absolute
    75		suffix := make([]string, 0, 4)
    76		for {
    77			parent := filepath.Dir(prefix)
    78			if parent == prefix {
    79				return "", fmt.Errorf("resolve existing prefix for %s: %w", label, err)
    80			}
    81			suffix = append(suffix, filepath.Base(prefix))
    82			prefix = parent
    83	
    84			resolved, err = filepath.EvalSymlinks(prefix)
    85			if err == nil {
    86				return canonicalWithExistingPrefix(filepath.Clean(resolved), suffix, label)
    87			}
    88			if !os.IsNotExist(err) {
    89				return "", fmt.Errorf("resolve %s symlinks: %w", label, err)
    90			}
    91		}
    92	}
    93	
    94	func lockName(domain, identity string) string {
    95		digest := sha256.Sum256([]byte(domain + "\x00" + identity))
    96		return hex.EncodeToString(digest[:]) + ".lock"
    97	}
     1	//go:build unix
     2	
     3	package managerlock
     4	
     5	import "path/filepath"
     6	
     7	func canonicalWithExistingPrefix(existing string, missing []string, _ string) (string, error) {
     8		canonical := existing
     9		for index := len(missing) - 1; index >= 0; index-- {
    10			canonical = filepath.Join(canonical, missing[index])
    11		}
    12		return filepath.Clean(canonical), nil
    13	}
     1	//go:build windows
     2	
     3	package managerlock
     4	
     5	import (
     6		"errors"
     7		"fmt"
     8		"path/filepath"
     9		"strings"
    10		"unsafe"
    11	
    12		"golang.org/x/sys/windows"
    13	)
    14	
    15	func canonicalWithExistingPrefix(existing string, missing []string, label string) (string, error) {
    16		canonical, caseSensitive, err := canonicalExistingWindowsPath(existing, len(missing) > 0, label)
    17		if err != nil {
    18			return "", err
    19		}
    20		for index := len(missing) - 1; index >= 0; index-- {
    21			component := missing[index]
    22			if !caseSensitive {
    23				component = strings.ToUpper(component)
    24			}
    25			canonical = filepath.Join(canonical, component)
    26	
    27			// A Windows application normally creates an ordinary case-insensitive
    28			// child, so use that deterministic provisional identity for the rest of
    29			// a missing suffix. Manager.prepare canonicalizes again after creation,
    30			// before reserving or opening any lock, and therefore also handles a
    31			// filesystem whose created child actually inherits case sensitivity.
    32			caseSensitive = false
    33		}
    34		return filepath.Clean(canonical), nil
    35	}
    36	
    37	// canonicalExistingWindowsPath normalizes each existing component according
    38	// to the lookup semantics of its containing directory. filepath.EvalSymlinks
    39	// has already resolved links and recovered each component's on-disk spelling,
    40	// but that spelling alone is not a stable identity in a case-insensitive
    41	// parent. Conversely, applying one leaf flag to the complete path would merge
    42	// distinct Foo and foo children of a case-sensitive parent.
    43	func canonicalExistingWindowsPath(existing string, needLeafCase bool, label string) (string, bool, error) {
    44		volume := filepath.VolumeName(existing)
    45		if volume == "" {
    46			return "", false, fmt.Errorf("resolve case sensitivity for %s: path has no volume", label)
    47		}
    48	
    49		separator := string(filepath.Separator)
    50		lookup := volume + separator
    51		canonical := strings.ToUpper(volume) + separator
    52		remainder := strings.TrimLeft(existing[len(volume):], `\/`)
    53		components := strings.FieldsFunc(remainder, func(value rune) bool {
    54			return value == '\\' || value == '/'
    55		})
    56	
    57		caseSensitive, err := directoryCaseSensitive(lookup)
    58		if err != nil {
    59			return "", false, fmt.Errorf("resolve case sensitivity for %s component %q: %w", label, lookup, err)
    60		}
    61		for index, component := range components {
    62			identityComponent := component
    63			if !caseSensitive {
    64				identityComponent = strings.ToUpper(identityComponent)
    65			}
    66			canonical = filepath.Join(canonical, identityComponent)
    67			lookup = filepath.Join(lookup, component)
    68	
    69			if index+1 < len(components) || needLeafCase {
    70				caseSensitive, err = directoryCaseSensitive(lookup)
    71				if err != nil {
    72					return "", false, fmt.Errorf("resolve case sensitivity for %s component %q: %w", label, lookup, err)
    73				}
    74			}
    75		}
    76		return filepath.Clean(canonical), caseSensitive, nil
    77	}
    78	
    79	func directoryCaseSensitive(path string) (bool, error) {
    80		pathUTF16, err := windows.UTF16PtrFromString(path)
    81		if err != nil {
    82			return false, err
    83		}
    84		handle, err := windows.CreateFile(
    85			pathUTF16,
    86			windows.FILE_READ_ATTRIBUTES,
    87			windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE,
    88			nil,
    89			windows.OPEN_EXISTING,
    90			windows.FILE_FLAG_BACKUP_SEMANTICS,
    91			0,
    92		)
    93		if err != nil {
    94			return false, err
    95		}
    96		defer windows.CloseHandle(handle)
    97	
    98		var flags uint32
    99		err = windows.GetFileInformationByHandleEx(
   100			handle,
   101			windows.FileCaseSensitiveInfo,
   102			(*byte)(unsafe.Pointer(&flags)),
   103			uint32(unsafe.Sizeof(flags)),
   104		)
   105		if err == nil {
   106			return flags&windows.FILE_CS_FLAG_CASE_SENSITIVE_DIR != 0, nil
   107		}
   108		if errors.Is(err, windows.ERROR_INVALID_FUNCTION) ||
   109			errors.Is(err, windows.ERROR_NOT_SUPPORTED) ||
   110			errors.Is(err, windows.ERROR_INVALID_PARAMETER) ||
   111			errors.Is(err, windows.ERROR_CALL_NOT_IMPLEMENTED) {
   112			// Filesystems and Windows versions without per-directory case
   113			// sensitivity use traditional case-insensitive path lookup.
   114			return false, nil
   115		}
   116		return false, err
   117	}

