   149	class TransactionEngine:
   150	    """Durable generic replacement transactions under a caller-held home lock."""
   151	
   152	    def __init__(self, csk_home: Path, *, fault_hook: FaultHook | None = None):
   153	        self.home = csk_home.expanduser().resolve(strict=False)
   154	        self.journal_root = self.home / "state" / "transactions" / "v1"
   155	        self._fault_hook = fault_hook
   156	        self._mutex = threading.Lock()
   157	        self._active_witness: HomeLockWitness | None = None
   158	
   159	    def prepare(self, lock: HomeLockWitness, plan: TransactionPlan) -> Journal:
   160	        lock.assert_held()
   161	        with self._mutex, self._witness_scope(lock):
   162	            journal, sources = self._build_journal(plan)
   163	            path = self._journal_path(journal.transaction_id)
   164	            if path.exists():
   165	                raise TransactionError(
   166	                    f"transaction already exists: {journal.transaction_id}"
   167	                )
   168	            self._save_journal(journal, create=True)
   169	            try:
   170	                for target_index, (target, source) in enumerate(
   171	                    zip(journal.targets, sources, strict=True)
   172	                ):
   173	                    if source is None:
   174	                        continue
   175	                    assert target.staged_path is not None
   176	                    self._stage_target(journal, target_index, source)
   177	                    if digest_path(Path(target.staged_path)) != target.desired_digest:
   178	                        raise TransactionCorruptionError(
   179	                            f"staged target changed while preparing: {target.target_class}/{target.identifier}"
   180	                        )
   181	                for target in journal.targets:
   182	                    target.staged_source = None
   183	                    target.staging_entries = []
   184	                    target.staging_index = 0
   185	                    self._clear_staging_progress(target)
   186	                journal.phase = "prepared"
   187	                self._save_journal(journal)
   188	                self._emit("prepared", None)
   189	                return _clone_journal(journal)
   190	            except Exception:
   191	                self._discard_prepared(journal)
   192	                raise
   193	
   194	    def _stage_target(
   195	        self,
   196	        journal: Journal,
   197	        target_index: int,
   198	        source: Path,
   199	    ) -> None:
   200	        target = journal.targets[target_index]
   201	        if target.staged_path is None or target.staged_source != str(source):
   202	            raise TransactionCorruptionError(
   203	                f"staging source is inconsistent: {target.target_class}/{target.identifier}"
   204	            )
   205	        staged = Path(target.staged_path)
   206	        while target.staging_index < len(target.staging_entries):
   207	            entry = target.staging_entries[target.staging_index]
   208	            target.staging_active = True
   209	            target.staging_created = False
   210	            target.staging_bytes = 0
   211	            target.staging_prefix_digest = None
   212	            target.staging_write_bytes = 0
   213	            target.staging_write_digest = None
   214	            self._save_journal(journal)
   215	            self._emit("before_staging_entry_create", target)
   216	            self._create_staging_entry(source, staged, entry)
   217	            target.staging_created = True
   218	            self._save_journal(journal)
   219	            self._emit("staging_entry_created", target)
   220	            if entry.kind == "file":
   221	                self._copy_staging_file(journal, target, source, staged, entry)
   222	            destination = _staging_entry_path(staged, entry.relative_path)
   223	            _validate_staging_entry(destination, entry)
   224	            target.staging_index += 1
   225	            self._clear_staging_progress(target)
   226	            self._save_journal(journal)
   227	            self._emit("staging_entry_completed", target)
   228	
   229	    def _create_staging_entry(
   230	        self,
   231	        source_root: Path,
   232	        staged_root: Path,
   233	        entry: StagingTreeEntry,
   234	    ) -> None:
   235	        self._assert_mutation_witness()
   236	        source = _staging_entry_path(source_root, entry.relative_path)
   237	        destination = _staging_entry_path(staged_root, entry.relative_path)
   238	        _validate_staging_entry(source, entry)
   239	        if _path_exists(destination):
   240	            raise TransactionCorruptionError(
   241	                f"staging entry exists before creation: {destination}"
   242	            )
   243	        _require_safe_staging_parent(destination.parent)
   244	        if entry.kind == "directory":
   245	            destination.mkdir(mode=0o700)
   246	            destination.chmod(entry.mode)
   247	            _sync_directory(destination)
   248	        else:
   249	            fd = os.open(
   250	                destination,
   251	                os.O_WRONLY | os.O_CREAT | os.O_EXCL,
   252	                0o600,
   253	            )
   254	            try:
   255	                destination.chmod(entry.mode)
   256	                os.fsync(fd)
   257	            finally:
   258	                os.close(fd)
   259	        _sync_directory(destination.parent)
   260	        self._assert_mutation_witness()
   261	
   262	    def _copy_staging_file(
   263	        self,
   264	        journal: Journal,
   265	        target: JournalTarget,
   266	        source_root: Path,
   267	        staged_root: Path,
   268	        entry: StagingTreeEntry,
   269	    ) -> None:
   270	        self._assert_mutation_witness()
   271	        source = _staging_entry_path(source_root, entry.relative_path)
   272	        destination = _staging_entry_path(staged_root, entry.relative_path)
   273	        _validate_staging_entry(source, entry)
   274	        prefix = hashlib.sha256(_STAGING_PREFIX_DOMAIN)
   275	        with (
   276	            source.open("rb") as source_handle,
   277	            destination.open("ab", buffering=0) as destination_handle,
   278	        ):
   279	            while True:
   280	                chunk = source_handle.read(_STAGING_COPY_CHUNK_SIZE)
   281	                if not chunk:
   282	                    break
   283	                prefix.update(chunk)
   284	                target.staging_write_bytes = target.staging_bytes + len(chunk)
   285	                target.staging_write_digest = "sha256:" + prefix.hexdigest()
   286	                self._save_journal(journal)
   287	                self._assert_mutation_witness()
   288	                view = memoryview(chunk)
   289	                while view:
   290	                    written = destination_handle.write(view)
   291	                    if written is None or written <= 0:
   292	                        raise OSError("short staging write")
   293	                    view = view[written:]
   294	                os.fsync(destination_handle.fileno())
   295	                self._assert_mutation_witness()
   296	                self._emit("after_staging_chunk_sync", target)
   297	                target.staging_bytes = target.staging_write_bytes
   298	                target.staging_prefix_digest = target.staging_write_digest
   299	                target.staging_write_bytes = 0
   300	                target.staging_write_digest = None
   301	                self._save_journal(journal)
   302	                self._emit("during_staging_copy", target)
   303	        _validate_staging_entry(source, entry)
   304	
   305	    @staticmethod
   306	    def _clear_staging_progress(target: JournalTarget) -> None:
   307	        target.staging_active = False
   308	        target.staging_created = False
   309	        target.staging_bytes = 0
   310	        target.staging_prefix_digest = None
   311	        target.staging_write_bytes = 0
   312	        target.staging_write_digest = None
   313	
   314	    def commit(self, lock: HomeLockWitness, transaction_id: str) -> None:
   315	        lock.assert_held()
   316	        with self._mutex, self._witness_scope(lock):
   317	            journal = self._load_journal(transaction_id)
   318	            self._resume(journal)
   319	
   320	    def recover(self, lock: HomeLockWitness) -> None:
   321	        """Recover every home journal, regardless of the initiating project."""
   322	        lock.assert_held()
   323	        with self._mutex, self._witness_scope(lock):
   324	            for transaction_id in self._journal_ids():
   325	                journal, deleting = self._load_journal_record(transaction_id)
   326	                try:
   327	                    if deleting:
   328	                        self._finish_journal_removal(journal)
   329	                    else:
   330	                        self._resume(journal)
   331	                except Exception as exc:
   332	                    raise TransactionError(
   333	                        f"recover transaction {transaction_id}: {exc}"
   334	                    ) from exc
   335	
   336	    def referenced_generation_digests(self, lock: HomeLockWitness) -> dict[str, str]:
   337	        lock.assert_held()
   338	        with self._mutex, self._witness_scope(lock):
   339	            result: dict[str, str] = {}
   340	            for transaction_id in self._journal_ids():
   341	                journal, deleting = self._load_journal_record(transaction_id)
   342	                if deleting:
   343	                    continue
   344	                for key, digest in journal.generation_digests.items():
   345	                    previous = result.setdefault(key, digest)
   346	                    if previous != digest:
   347	                        raise TransactionCorruptionError(
   348	                            f"generation {key!r} has conflicting journal digests"
   349	                        )
   350	            return dict(sorted(result.items(), key=lambda item: _utf8_key(item[0])))
   351	
   352	    def _resume(self, journal: Journal) -> None:
   353	        if journal.phase == "preparing":
   354	            self._discard_prepared(journal)
   355	        elif journal.phase in {"prepared", "committing"}:
   356	            self._commit_journal(journal)
   357	        elif journal.phase == "cleanup":
   358	            self._cleanup_committed(journal)
   359	        elif journal.phase == "rolling_back":
   360	            self._rollback(journal)
   361	        else:
   362	            raise TransactionCorruptionError(
   363	                f"unsupported journal phase: {journal.phase}"
   364	            )
   365	
   366	    def _commit_journal(self, journal: Journal) -> None:
   367	        if journal.phase == "prepared":
   368	            journal.phase = "committing"
   369	            self._save_journal(journal)
   370	        try:
   371	            for target in journal.targets:
   372	                self._commit_target(journal, target)
   373	        except Exception as cause:
   374	            journal.phase = "rolling_back"
   375	            self._save_journal(journal)
   376	            try:
   377	                self._rollback(journal)
   378	            except Exception as rollback_error:  # noqa: BLE001 - both failures must remain observable
   379	                raise ExceptionGroup(
   380	                    "commit and rollback failed", [cause, rollback_error]

