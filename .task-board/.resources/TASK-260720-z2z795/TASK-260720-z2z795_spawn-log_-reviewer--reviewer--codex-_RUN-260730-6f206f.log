   128		}
   129		identities, err := CanonicalProjects(projects...)
   130		if err != nil {
   131			return nil, err
   132		}
   133		if len(identities) == 0 {
   134			return nil, fmt.Errorf("at least one project lock is required")
   135		}
   136	
   137		operation.mu.Lock()
   138		defer operation.mu.Unlock()
   139		if operation.closed {
   140			return nil, orderError("operation is closed")
   141		}
   142		if operation.buildKeyUsed || operation.home != nil {
   143			return nil, orderError("project lock requested after a later lock class")
   144		}
   145		if len(operation.identities) > 0 && compareProject(operation.identities[len(operation.identities)-1], identities[0]) >= 0 {
   146			return nil, orderError("project identities are not strictly increasing")
   147		}
   148		if err := operation.manager.prepare(); err != nil {
   149			return nil, err
   150		}
   151		process := operation.manager.processState()
   152		if err := process.reserve(acquireProject); err != nil {
   153			return nil, err
   154		}
   155		acquired := false
   156		defer func() { process.finish(acquireProject, acquired) }()
   157	
   158		batch := make([]*fileLock, 0, len(identities))
   159		for _, identity := range identities {
   160			lock, acquireErr := acquireFileLock(ctx, operation.manager.projectLockPath(identity), nil)
   161			if acquireErr != nil {
   162				for index := len(batch) - 1; index >= 0; index-- {
   163					acquireErr = errors.Join(acquireErr, batch[index].Close())
   164				}
   165				return nil, acquireErr
   166			}
   167			batch = append(batch, lock)
   168		}
   169		acquired = true
   170		operation.projects = append(operation.projects, batch...)
   171		operation.identities = append(operation.identities, identities...)
   172		return append([]ProjectIdentity(nil), operation.identities...), nil
   173	}
   174	
   175	// AcquireBuildKey takes the optional per-key deduplication lock. An operation
   176	// may use at most one key, and must release it before acquiring the home lock.
   177	func (operation *Operation) AcquireBuildKey(ctx context.Context, logicalKey string) error {
   178		if operation == nil || operation.manager == nil {
   179			return fmt.Errorf("manager operation is nil")
   180		}
   181		if operation.dryRun {
   182			return ErrDryRun
   183		}
   184		if logicalKey == "" || !utf8.ValidString(logicalKey) || strings.IndexByte(logicalKey, 0) >= 0 {
   185			return fmt.Errorf("logical build key is empty or invalid UTF-8")
   186		}
   187	
   188		operation.mu.Lock()
   189		defer operation.mu.Unlock()
   190		if operation.closed || len(operation.projects) == 0 || operation.buildKeyUsed || operation.home != nil {
   191			return orderError("build-key lock requires held project locks and may be used once before the home lock")
   192		}
   193		process := operation.manager.processState()
   194		if err := process.reserve(acquireBuildKey); err != nil {
   195			return err
   196		}
   197		acquired := false
   198		defer func() { process.finish(acquireBuildKey, acquired) }()
   199		lock, err := acquireFileLock(ctx, operation.manager.buildKeyLockPath(logicalKey), func() {
   200			process.released(acquireBuildKey)
   201		})
   202		if err != nil {
   203			return err
   204		}
   205		acquired = true
   206		operation.buildKey = lock
   207		operation.buildKeyUsed = true
   208		return nil
   209	}
   210	
   211	// ReleaseBuildKey releases the optional key lock before the serialized commit
   212	// phase. The persistent lock file deliberately remains in manager state.
   213	func (operation *Operation) ReleaseBuildKey() error {
   214		if operation == nil {
   215			return nil
   216		}
   217		operation.mu.Lock()
   218		defer operation.mu.Unlock()
   219		if operation.buildKey == nil {
   220			return orderError("build-key lock is not held")
   221		}
   222		err := operation.buildKey.Close()
   223		operation.buildKey = nil
   224		return err
   225	}
   226	
   227	// HomeLock is an exclusive manager-home mutation witness. It satisfies the
   228	// caller-held witness expected by buildcache and future transaction code.
   229	type HomeLock struct {
   230		lock *fileLock
   231	}
   232	
   233	// AssertHeld verifies that the operating-system lock has not been released.
   234	func (lock *HomeLock) AssertHeld() error {
   235		if lock == nil {
   236			return ErrNotHeld
   237		}
   238		return lock.lock.AssertHeld()
   239	}
   240	
   241	// Close releases the operating-system lock without deleting its stable file.
   242	func (lock *HomeLock) Close() error {
   243		if lock == nil {
   244			return nil
   245		}
   246		return lock.lock.Close()
   247	}
   248	
   249	// AcquireHome acquires the mutation lock after project locks and after an
   250	// optional build-key lock has been released.
   251	func (operation *Operation) AcquireHome(ctx context.Context) (*HomeLock, error) {
   252		if operation == nil || operation.manager == nil {
   253			return nil, fmt.Errorf("manager operation is nil")
   254		}
   255		if operation.dryRun {
   256			return nil, ErrDryRun
   257		}
   258		operation.mu.Lock()
   259		defer operation.mu.Unlock()
   260		if operation.closed || len(operation.projects) == 0 || operation.buildKey != nil || operation.home != nil {
   261			return nil, orderError("home lock requires held project locks and no held build-key lock")
   262		}
   263		return operation.acquireHome(ctx)
   264	}
   265	
   266	func (operation *Operation) acquireHome(ctx context.Context) (*HomeLock, error) {
   267		process := operation.manager.processState()
   268		if err := process.reserve(acquireHome); err != nil {
   269			return nil, err
   270		}
   271		acquired := false
   272		defer func() { process.finish(acquireHome, acquired) }()
   273		fileLock, err := acquireFileLock(ctx, operation.manager.homeLockPath(), func() {
   274			process.released(acquireHome)
   275		})
   276		if err != nil {
   277			return nil, err
   278		}
   279		acquired = true
   280		operation.home = &HomeLock{lock: fileLock}
   281		return operation.home, nil
   282	}
   283	
   284	// AcquireHomeOnly is the recovery/GC path. It acquires no project or key lock.
   285	// dryRun rejects the request without creating any manager state.
   286	func (manager *Manager) AcquireHomeOnly(ctx context.Context, dryRun bool) (*HomeLock, error) {
   287		if manager == nil {
   288			return nil, fmt.Errorf("manager is nil")
   289		}
   290		if dryRun {
   291			return nil, ErrDryRun
   292		}
   293		if err := manager.prepare(); err != nil {
   294			return nil, err
   295		}
   296		process := manager.processState()
   297		if err := process.reserve(acquireHome); err != nil {
   298			return nil, err
   299		}
   300		acquired := false
   301		defer func() { process.finish(acquireHome, acquired) }()
   302		fileLock, err := acquireFileLock(ctx, manager.homeLockPath(), func() {
   303			process.released(acquireHome)
   304		})
   305		if err != nil {
   306			return nil, err
   307		}
   308		acquired = true
   309		return &HomeLock{lock: fileLock}, nil
   310	}
   311	
   312	// Close releases held locks in reverse class and project order.
   313	func (operation *Operation) Close() error {
   314		if operation == nil {
   315			return nil
   316		}
   317		operation.mu.Lock()
   318		defer operation.mu.Unlock()
   319		if operation.closed {
   320			return nil
   321		}
   322		operation.closed = true
   323		var result error
   324		if operation.home != nil {
   325			result = errors.Join(result, operation.home.Close())
   326			operation.home = nil
   327		}
   328		if operation.buildKey != nil {
   329			result = errors.Join(result, operation.buildKey.Close())
   330			operation.buildKey = nil
   331		}
   332		for index := len(operation.projects) - 1; index >= 0; index-- {
   333			result = errors.Join(result, operation.projects[index].Close())
   334		}
   335		operation.projects = nil
   336		return result
   337	}
   338	
   339	func (manager *Manager) projectLockPath(identity ProjectIdentity) string {
   340		manager.mu.RLock()
   341		defer manager.mu.RUnlock()
   342		return filepath.Join(manager.lockRoot, "projects", lockName("project", string(identity)))
   343	}
   344	
   345	func (manager *Manager) buildKeyLockPath(logicalKey string) string {
   346		manager.mu.RLock()
   347		defer manager.mu.RUnlock()
   348		return filepath.Join(manager.lockRoot, "build", lockName("build-key", logicalKey))
   349	}
   350	
   351	func (manager *Manager) homeLockPath() string {
   352		manager.mu.RLock()
   353		defer manager.mu.RUnlock()
   354		return filepath.Join(manager.lockRoot, lockName("manager-home", manager.home))
   355	}
   356	
   357	func compareProject(left, right ProjectIdentity) int {
   358		leftBytes, rightBytes := []byte(left), []byte(right)
   359		for index := 0; index < len(leftBytes) && index < len(rightBytes); index++ {
   360			if leftBytes[index] < rightBytes[index] {
   361				return -1
   362			}
   363			if leftBytes[index] > rightBytes[index] {
   364				return 1
   365			}
   366		}
   367		switch {
   368		case len(leftBytes) < len(rightBytes):
   369			return -1
   370		case len(leftBytes) > len(rightBytes):
   371			return 1
   372		default:
   373			return 0
   374		}
   375	}
   376	
   377	func orderError(detail string) error {
   378		return fmt.Errorf("%w: %s", ErrLockOrder, detail)
   379	}
   380	
   381	type acquisitionKind uint8
   382	
   383	const (
   384		acquireProject acquisitionKind = iota
   385		acquireBuildKey
   386		acquireHome
   387	)
   388	
   389	type processState struct {
   390		mu             sync.Mutex
   391		projectPending int
   392		keyPending     int
   393		keysHeld       int
   394		homePending    int
   395		homesHeld      int
   396	}
   397	
   398	var processStates = struct {
   399		sync.Mutex
   400		byHome map[string]*processState
   401	}{byHome: map[string]*processState{}}
   402	
   403	func stateForHome(home string) *processState {
   404		processStates.Lock()
   405		defer processStates.Unlock()
   406		if state := processStates.byHome[home]; state != nil {
   407			return state
   408		}
   409		state := new(processState)
   410		processStates.byHome[home] = state
   411		return state
   412	}
   413	
   414	func (state *processState) reserve(kind acquisitionKind) error {
   415		state.mu.Lock()
   416		defer state.mu.Unlock()
   417		switch kind {
   418		case acquireProject:
   419			if state.homesHeld > 0 || state.homePending > 0 {
   420				return orderError("project lock requested while the process holds or is acquiring the home lock")
   421			}
   422			state.projectPending++
   423		case acquireBuildKey:
   424			if state.homesHeld > 0 || state.homePending > 0 {
   425				return orderError("build-key lock requested while the process holds or is acquiring the home lock")
   426			}
   427			state.keyPending++
   428		case acquireHome:
   429			if state.keysHeld > 0 || state.keyPending > 0 || state.projectPending > 0 {
   430				return orderError("home lock requested before an in-process project/key acquisition completed or key release")
   431			}
   432			state.homePending++
   433		}
   434		return nil
   435	}
   436	
   437	func (state *processState) finish(kind acquisitionKind, acquired bool) {
   438		state.mu.Lock()
   439		defer state.mu.Unlock()
   440		switch kind {
   441		case acquireProject:
   442			state.projectPending--
   443		case acquireBuildKey:
   444			state.keyPending--
   445			if acquired {
   446				state.keysHeld++
   447			}
   448		case acquireHome:
   449			state.homePending--
   450			if acquired {
   451				state.homesHeld++
   452			}
   453		}
   454	}
   455	
   456	func (state *processState) released(kind acquisitionKind) {
   457		state.mu.Lock()
   458		defer state.mu.Unlock()
   459		switch kind {
   460		case acquireBuildKey:
   461			if state.keysHeld > 0 {
   462				state.keysHeld--
   463			}
   464		case acquireHome:
   465			if state.homesHeld > 0 {
   466				state.homesHeld--
   467			}
   468		}
   469	}
     1	package managerlock
     2	
     3	import (
     4		"context"
     5		"errors"
     6		"fmt"
     7		"os"
     8		"path/filepath"
     9		"sync"
    10		"time"
    11	)
    12	
    13	const lockRetryInterval = 10 * time.Millisecond
    14	
    15	type fileLock struct {
    16		mu        sync.Mutex
    17		file      *os.File
    18		held      bool
    19		onRelease func()
    20	}
    21	
    22	func acquireFileLock(ctx context.Context, path string, onRelease func()) (*fileLock, error) {
    23		if ctx == nil {
    24			return nil, fmt.Errorf("lock context is nil")
    25		}
    26		if err := ctx.Err(); err != nil {
    27			return nil, err
    28		}
    29		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
    30			return nil, fmt.Errorf("create manager lock state: %w", err)
    31		}
    32		file, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o600) // #nosec G304 -- path is derived below the canonical manager home
    33		if err != nil {
    34			return nil, fmt.Errorf("open manager lock: %w", err)
    35		}
    36	
    37		for {
    38			locked, lockErr := tryFileLock(file)
    39			if lockErr != nil {
    40				_ = file.Close()
    41				return nil, fmt.Errorf("acquire manager lock: %w", lockErr)
    42			}
    43			if locked {
    44				if err := ctx.Err(); err != nil {
    45					_ = unlockFile(file)
    46					_ = file.Close()
    47					return nil, err
    48				}
    49				return &fileLock{file: file, held: true, onRelease: onRelease}, nil
    50			}
    51	
    52			timer := time.NewTimer(lockRetryInterval)
    53			select {
    54			case <-ctx.Done():
    55				if !timer.Stop() {
    56					select {
    57					case <-timer.C:
    58					default:
    59					}
    60				}
    61				_ = file.Close()
    62				return nil, ctx.Err()
    63			case <-timer.C:
    64			}
    65		}
    66	}
    67	
    68	func (lock *fileLock) AssertHeld() error {
    69		if lock == nil {
    70			return ErrNotHeld
    71		}
    72		lock.mu.Lock()
    73		defer lock.mu.Unlock()
    74		if !lock.held || lock.file == nil {
    75			return ErrNotHeld
    76		}
    77		return nil
    78	}
    79	
    80	func (lock *fileLock) Close() error {
    81		if lock == nil {
    82			return nil
    83		}
    84		lock.mu.Lock()
    85		if !lock.held || lock.file == nil {
    86			lock.mu.Unlock()
    87			return nil
    88		}
    89		file := lock.file
    90		lock.file = nil
    91		lock.held = false
    92		onRelease := lock.onRelease
    93		lock.onRelease = nil
    94		err := errors.Join(unlockFile(file), file.Close())
    95		lock.mu.Unlock()
    96		if onRelease != nil {
    97			onRelease()
    98		}
    99		return err
   100	}
