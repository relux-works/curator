   178	func (engine *Engine) discardPreparing(journal *Journal) error {
   179		if journal.Phase != PhasePreparing {
   180			return journalf("discard preparation in phase %q", journal.Phase)
   181		}
   182		if err := engine.resumeRecordedRemoval(journal); err != nil {
   183			return err
   184		}
   185		for index := len(journal.Targets) - 1; index >= 0; index-- {
   186			target := &journal.Targets[index]
   187			if target.StagedPath == "" {
   188				continue
   189			}
   190			if target.StagingDiscarded {
   191				if digest, err := target.digest(target.StagedPath); err != nil {
   192					return err
   193				} else if digest != DigestAbsent {
   194					return corruptionf("discarded preparation staging reappeared: %s", target.StagedPath)
   195				}
   196				continue
   197			}
   198			if err := validatePreparingTarget(target); err != nil {
   199				return err
   200			}
   201			digest, err := target.digest(target.StagedPath)
   202			if err != nil {
   203				return err
   204			}
   205			if digest == DigestAbsent {
   206				continue
   207			}
   208			entries, err := captureRemovalEntries(target.Kind, target.StagedPath, digest)
   209			if err != nil {
   210				return err
   211			}
   212			if err := validatePreparingTarget(target); err != nil {
   213				return err
   214			}
   215			journal.RemovalPath = target.StagedPath
   216			journal.RemovalDigest = digest
   217			journal.RemovalEntries = entries
   218			if err := engine.saveJournal(journal); err != nil {
   219				journal.RemovalPath = ""
   220				journal.RemovalDigest = ""
   221				journal.RemovalEntries = nil
   222				return err
   223			}
   224			if err := engine.finishRecordedRemoval(journal, removalCandidate{
   225				targetIndex: index, kind: target.Kind, path: target.StagedPath, digest: digest,
   226			}); err != nil {
   227				return err
   228			}
   229		}
   230		for index := range journal.Targets {
   231			target := &journal.Targets[index]
   232			target.StagedSource = ""
   233			target.StagingEntries = nil
   234			target.StagingIndex = 0
   235			target.StagingActive = false
   236			target.StagingCreated = false
   237			target.StagingBytes = 0
   238			target.StagingPrefixDigest = ""
   239			target.StagingWriteBytes = 0
   240			target.StagingWriteDigest = ""
   241			target.StagingDiscarded = false
   242		}
   243		journal.Phase = PhaseRollbackCleanup
   244		if err := engine.saveJournal(journal); err != nil {
   245			return err
   246		}
   247		return engine.rollback(journal)
   248	}
   249	
   250	func validatePreparingTarget(target *TargetRecord) error {
   251		if target.StagedPath == "" {
   252			return nil
   253		}
   254		if target.StagingIndex < 0 || target.StagingIndex > len(target.StagingEntries) || (target.StagingActive && target.StagingIndex == len(target.StagingEntries)) {
   255			return journalf("staging progress for %s/%s is invalid", target.Class, target.Identifier)
   256		}
   257		positions := make(map[string]int, len(target.StagingEntries))
   258		for index, entry := range target.StagingEntries {
   259			positions[entry.RelativePath] = index
   260		}
   261		seen := make(map[int]struct{}, target.StagingIndex+1)
   262		_, rootErr := os.Lstat(target.StagedPath)
   263		if os.IsNotExist(rootErr) {
   264			if target.StagingIndex != 0 || target.StagingCreated || target.StagingBytes != 0 || target.StagingPrefixDigest != "" || target.StagingWriteBytes != 0 || target.StagingWriteDigest != "" {
   265				return corruptionf("preparing target %s/%s lost recorded staging", target.Class, target.Identifier)
   266			}
   267			return nil
   268		}
   269		if rootErr != nil {
   270			return rootErr
   271		}
   272		err := filepath.Walk(target.StagedPath, func(current string, info os.FileInfo, walkErr error) error {
   273			if walkErr != nil {
   274				return walkErr
   275			}
   276			relative, err := filepath.Rel(target.StagedPath, current)
   277			if err != nil {
   278				return err
   279			}
   280			if relative == "." {
   281				relative = ""
   282			} else {
   283				relative = filepath.ToSlash(relative)
   284			}
   285			position, found := positions[relative]
   286			if !found {
   287				return corruptionf("preparing target %s/%s contains unrecorded staging entry %s", target.Class, target.Identifier, current)
   288			}
   289			entry := target.StagingEntries[position]
   290			switch {
   291			case position < target.StagingIndex:
   292				if err := verifyRemovalEntry(current, info, entry); err != nil {
   293					return err
   294				}
   295			case position == target.StagingIndex && target.StagingActive:
   296				if err := validateActiveStagingEntry(target, current, info, entry); err != nil {
   297					return err
   298				}
   299			default:
   300				return corruptionf("preparing target %s/%s contains staging beyond durable progress: %s", target.Class, target.Identifier, current)
   301			}
   302			seen[position] = struct{}{}
   303			return nil
   304		})
   305		if err != nil {
   306			return err
   307		}
   308		for index := 0; index < target.StagingIndex; index++ {
   309			if _, found := seen[index]; !found {
   310				return corruptionf("preparing target %s/%s is missing completed staging entry %q", target.Class, target.Identifier, target.StagingEntries[index].RelativePath)
   311			}
   312		}
   313		if target.StagingActive && target.StagingCreated {
   314			if _, found := seen[target.StagingIndex]; !found {
   315				return corruptionf("preparing target %s/%s is missing active staging entry", target.Class, target.Identifier)
   316			}
   317		}
   318		return nil
   319	}
