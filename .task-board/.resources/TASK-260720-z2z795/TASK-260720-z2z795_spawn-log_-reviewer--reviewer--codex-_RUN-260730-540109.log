	buildKeyUsed bool
	home         *HomeLock
}

// NewOperation creates an operation state machine. It performs no I/O.
func (manager *Manager) NewOperation(dryRun bool) *Operation {
	return &Operation{manager: manager, dryRun: dryRun}
