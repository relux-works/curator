+            os.strerror(errno.EEXIST),
+            str(destination),
+        )
+    if error_number == 0:
+        error_number = errno.EIO
+    raise OSError(
+        error_number,
+        f"{os.strerror(error_number)}: {source} -> {destination}",
+    )
