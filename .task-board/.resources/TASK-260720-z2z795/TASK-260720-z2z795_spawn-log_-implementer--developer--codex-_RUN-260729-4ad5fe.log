+    except AttributeError as exc:
+        raise TransactionError(
+            "atomic no-replace rename is unavailable on macOS"
+        ) from exc
+    renamex_np.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
+    renamex_np.restype = ctypes.c_int
