+def _native_rename_no_replace(source: Path, destination: Path) -> None:
+    """Atomically rename without replacing a competing destination."""
+    if os.name == "nt":
+        _windows_rename_no_replace(source, destination)
+        return
+    if sys.platform == "darwin":
