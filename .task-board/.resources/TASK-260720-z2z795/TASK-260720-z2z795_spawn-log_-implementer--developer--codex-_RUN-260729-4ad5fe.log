+        injected = False
+
+        def create_competitor_then_rename(source: Path, destination: Path) -> None:
+            nonlocal injected
+            if not injected and source == staged and destination == live:
+                _write(destination, "competing-success")
+                injected = True
+            native_rename(source, destination)
