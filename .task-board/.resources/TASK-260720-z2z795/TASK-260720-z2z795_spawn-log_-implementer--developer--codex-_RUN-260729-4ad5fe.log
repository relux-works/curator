+        _windows_rename_no_replace(source, destination)
+        return
+    if sys.platform == "darwin":
+        _darwin_rename_no_replace(source, destination)
+        return
+    if sys.platform.startswith("linux"):
+        _linux_rename_no_replace(source, destination)
