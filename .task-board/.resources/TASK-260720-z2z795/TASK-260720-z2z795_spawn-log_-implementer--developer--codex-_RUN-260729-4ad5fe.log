            json.dumps(raw, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
            + "\n",
            encoding="utf-8",
        )
        with pytest.raises(TransactionCorruptionError, match="sidecar path"):
            engine.commit(lock, "txn-corrupt-path")

