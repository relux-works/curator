+        first_thread.join(timeout=3)
+        restore.write_text("restore", encoding="utf-8")
+        stdout, stderr = legacy_breaker.communicate(timeout=5)
+        assert legacy_breaker.returncode == 0, (stdout, stderr)
+
+    assert not first_thread.is_alive()
