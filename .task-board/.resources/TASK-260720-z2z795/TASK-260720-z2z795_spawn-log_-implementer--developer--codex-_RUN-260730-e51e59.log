+            sys.executable,
+            "-c",
+            _LEGACY_STALE_BREAKER,
+            str(lock_path),
+            str(ready),
+            str(move),
+            str(moved),
+            str(restore),
+        ],
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        env=_lock_subprocess_env(),
+    )
