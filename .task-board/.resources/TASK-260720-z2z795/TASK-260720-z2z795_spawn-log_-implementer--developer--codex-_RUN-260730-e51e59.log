+def _is_legacy_home_lock_breaker_namespace(
+    manager_home: Path,
+    path: Path,
+) -> bool:
+    home_parts = _namespace_parts(manager_home)
+    path_parts = _namespace_parts(path)
+    return (
+        len(path_parts) > len(home_parts)
+        and path_parts[: len(home_parts)] == home_parts
