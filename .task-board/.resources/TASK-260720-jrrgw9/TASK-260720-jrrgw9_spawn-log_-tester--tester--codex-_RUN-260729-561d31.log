// TestCorruptCacheEntryIsRebuiltAndNeverReused pins the repair path for a
// protected entry that cannot be interpreted. Curator has no repair command, so
// an entry that is unusable but replaceable must be rebuilt by install and
// upgrade themselves; publication quarantines the unusable entry rather than
// adopting or permission-repairing it.
func TestCorruptCacheEntryIsRebuiltAndNeverReused(t *testing.T) {
	e := newEnv(t)
	e.buildSkill("build-skill", "alpha")
	e.declare("build-skill")
	deps, _, cache, builder := newFakeDeps(t)
	cache.byCommand["alpha"] = buildcache.Result{
		Status:       buildcache.Corrupt,
		Reason:       "receipt is not canonical",
		ArtifactPath: "/protected/bin/alpha",
	}

	result := e.install(Options{Build: deps})
	if result.Status != "ok" {
		t.Fatalf("install failed: %+v", result)
	}
	if len(result.Builds) != 1 || result.Builds[0].Outcome() != BuildCorrupt {
		t.Fatalf("plan did not report the corrupt outcome: %+v", result.Builds)
	}
	if result.Builds[0].ArtifactPath() != "" {
		t.Fatalf("corrupt entry exposed a reusable artifact path %q", result.Builds[0].ArtifactPath())
	}
	if len(builder.calls) != 1 || builder.calls[0] != "alpha" {
		t.Fatalf("corrupt entry was not rebuilt: %v", builder.calls)
	}
}

// TestUnsupportedCacheProtectionFailsClosed covers the one refusal a rebuild
// cannot resolve: without a provable protected boundary there is nowhere safe
// to publish a replacement either.
//
// It also pins the data path a read-only currentness check depends on. That
// path is otherwise unreachable from a test on a host whose platform can prove
// protected cache state, because protection support is a compile-time property
// of the host: the plan must still carry the refused command out through
// Result.Builds, with its reason, so a caller can classify and report it
// instead of seeing nothing at all about compiled state.
func TestUnsupportedCacheProtectionFailsClosed(t *testing.T) {
	e := newEnv(t)
	e.buildSkill("build-skill", "alpha")
	e.declare("build-skill")
	deps, _, cache, builder := newFakeDeps(t)
	cache.byCommand["alpha"] = buildcache.Result{
		Status: buildcache.Unsupported, Reason: "platform protection is unavailable",
	}

	for _, dryRun := range []bool{false, true} {
		result := e.install(Options{Build: deps, DryRun: dryRun})
		if result.Status != "failed" {
			t.Fatalf("install status = %q, want failed (dry run %v)", result.Status, dryRun)
		}
		if len(builder.calls) != 0 {
			t.Fatalf("builder ran without protected cache support: %v", builder.calls)
		}
		if len(result.Builds) != 1 || result.Builds[0].Outcome() != BuildUnsupported {
			t.Fatalf("plan did not carry the refused command out: %+v", result.Builds)
		}
		if result.Builds[0].Reason() == "" {
			t.Fatal("the refused command carries no reason for an operator")
		}
		if result.Builds[0].Skill() != "build-skill" || result.Builds[0].Command() != "alpha" {
			t.Fatalf("refused row does not name the command: %+v", result.Builds[0])
		}
		if !result.BuildsComplete {
			t.Fatal("a plan that described every refused command reported an incomplete diagnostic")
		}
	}
	requireAbsent(t, e.persistentPaths())
}

// TestIncompletePlansNeverClaimACompleteDiagnostic pins the other half of the
// completeness contract: a scope with no compiled command, and a plan that
// failed before it could describe one, both report an incomplete diagnostic, so
// a read-only reporting caller falls back to reporting the failure itself.
func TestIncompletePlansNeverClaimACompleteDiagnostic(t *testing.T) {
	t.Run("no compiled command at all", func(t *testing.T) {
		e := newEnv(t)
		e.skill("skill-a")
		e.declare("skill-a")
		deps, _, _, _ := newFakeDeps(t)

		result := e.install(Options{Build: deps, DryRun: true})
		if result.Status != "ok" {
			t.Fatalf("dry-run status = %q: %+v", result.Status, result)
		}
		if len(result.Builds) != 0 || result.BuildsComplete {
			t.Fatalf("a script-only scope claimed a compiled diagnostic: %+v %v",
				result.Builds, result.BuildsComplete)
		}
	})

	t.Run("planning failed before any command was described", func(t *testing.T) {
		e := newEnv(t)
		e.buildSkill("build-skill", "alpha")
		e.declare("build-skill")
		deps, toolchain, _, _ := newFakeDeps(t)
		// A toolchain that answers but reports a target no valid build input
		// admits fails inside per-command planning, after the toolchain boundary
		// and before any command is described.
		toolchain.target = buildmeta.Target{GOOS: "", GOARCH: "", Tuning: map[string]string{}}

		result := e.install(Options{Build: deps, DryRun: true})
		if result.Status != "failed" {
			t.Fatalf("dry-run status = %q, want failed: %+v", result.Status, result)
		}
		if len(result.Builds) != 0 || result.BuildsComplete {
			t.Fatalf("a plan that described no command claimed a complete diagnostic: %+v %v",
				result.Builds, result.BuildsComplete)
		}
	})
}

// TestToolchainFailurePlansAnInventoryOfEveryActiveCommand pins the other
// failure that must still describe compiled state: when the trusted toolchain
// boundary refuses, no logical identity exists for any command, but every
// active command is still reported — with the stable boundary code and without
// inventing a target, key, or cache verdict it never derived.
func TestToolchainFailurePlansAnInventoryOfEveryActiveCommand(t *testing.T) {
	e := newEnv(t)
	e.buildSkill("build-skill", "alpha")
	e.declare("build-skill")
	deps, toolchain, cache, builder := newFakeDeps(t)
	toolchain.probeErr = &godriver.Diagnostic{
		Code: "go_toolchain_missing", Detail: "trusted GOROOT is unusable",
	}

	result := e.install(Options{Build: deps, DryRun: true})
	if result.Status != "failed" {
		t.Fatalf("dry-run status = %q, want failed", result.Status)
	}
	if len(cache.inspected) != 0 || len(builder.calls) != 0 {
		t.Fatalf("a refused toolchain still touched the cache or builder: %v %v", cache.inspected, builder.calls)
	}
	if len(result.Builds) != 1 {
		t.Fatalf("plan did not inventory the active command: %+v", result.Builds)
	}
	row := result.Builds[0]
	if row.Outcome() != BuildToolchainUnavailable || row.DiagnosticCode() != "go_toolchain_missing" {
		t.Fatalf("inventory row = %q / %q", row.Outcome(), row.DiagnosticCode())
	}
	if row.Skill() != "build-skill" || row.Command() != "alpha" || row.SourceDir() == "" {
		t.Fatalf("inventory row does not name the active command: %+v", row)
	}
	// Every identity that existed before the toolchain was consulted is carried:
	// the closed driver the parser admitted, the declared build root and package
	// directory, and the build-source digest, which is validated first.
	if row.Driver() != buildmeta.DriverGoV1 || row.BuildRoot() != "src" {
		t.Fatalf("inventory row dropped the identity it already had: driver=%q root=%q",
			row.Driver(), row.BuildRoot())
	}
	if row.Source().Algorithm == "" || row.Source().ContentSHA256 == "" {
		t.Fatalf("inventory row dropped the validated build-source identity: %+v", row.Source())
	}
	if !strings.Contains(row.Describe(), "source="+row.Source().Algorithm+":"+row.Source().ContentSHA256) {
		t.Fatalf("inventory line does not report the build source: %s", row.Describe())
	}
	// Only what genuinely depends on the toolchain stays empty.
	if row.CacheKey() != "" || row.Target().GOOS != "" || row.ArtifactPath() != "" {
		t.Fatalf("inventory row published an identity the plan never derived: %+v", row)
	}
	if row.Expectation().Input.Driver != "" {
		t.Fatalf("inventory row published a cache lookup it never took: %+v", row.Expectation())
	}
	if result.BuildDiagnostic != "go_toolchain_missing" {
		t.Fatalf("result diagnostic = %q", result.BuildDiagnostic)
	}
	if !result.BuildsComplete {
		t.Fatal("the inventory covers every active command but reported an incomplete diagnostic")
	}
}

func TestUntrustedCacheEntryIsRebuiltAndNeverReused(t *testing.T) {
	e := newEnv(t)
	e.buildSkill("build-skill", "alpha")
	e.declare("build-skill")
	deps, _, cache, builder := newFakeDeps(t)
	cache.byCommand["alpha"] = buildcache.Result{
		Status:       buildcache.UntrustedProvenance,
		Reason:       "cache entry is group-writable",
		ArtifactPath: "/protected/bin/alpha",
	}

	result := e.install(Options{Build: deps})
	if result.Status != "ok" {
		t.Fatalf("install failed: %+v", result)
	}
	if result.Builds[0].Outcome() != BuildWouldRebuildUntrustedCache {
		t.Fatalf("outcome = %q, want %q", result.Builds[0].Outcome(), BuildWouldRebuildUntrustedCache)
	}
	if result.Builds[0].ArtifactPath() != "" {
		t.Fatalf("untrusted entry exposed a reusable artifact path %q", result.Builds[0].ArtifactPath())
	}
	if len(builder.calls) != 1 || builder.calls[0] != "alpha" {
		t.Fatalf("untrusted entry was not rebuilt: %v", builder.calls)
	}
}

func TestScriptOnlyInstallPerformsNoToolchainOrCacheWork(t *testing.T) {
