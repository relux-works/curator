		Platform: "unix",
	})
	if err != nil {
		t.Fatal(err)
	}
	if plan.Desired == nil || plan.Replacement || plan.Commands["tool"].RuntimeDir() != Dir(home, "skill-a", "commit-a") ||
		plan.Commands["tool"].ExecutablePath() != filepath.Join(Dir(home, "skill-a", "commit-a"), "bin", "tool") {
